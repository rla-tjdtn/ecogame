        <Item class="ModuleScript" referent="250">
          <Properties>
            <string name="Name">Stage5</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 5 — 심층 미로 (47x43칸, tools/places/maze.js 로 생성, 소품은 ChapterProps/Maze.luau)
-- 버려진 지하 채석장 납골당(카타콤). 지층을 따라 비스듬히 뻗고 휘고 갈라지는 갱도 — 세 단이 갈지자로 내려간다.
-- 1단 입구층: 나선 계단(I) 바닥(시작) → 북쪽 접근 갱도·채석공 작업실·고양이 구멍 / 우물 갱도·채석공 우물실(Y)·붕락(F) 우회 → 방주식 채석장(바위 기둥, B·K·W·광차).
-- 2단 납골층: 납골당 문틀 H 둘 → 납골 회랑(뼈 벽면 u, 납골 십자로 U·Q) / 지하 예배당(신도석 P, 제단 J) → 해골 원형실(해골 원통 Q, 무덤 등불 l).
-- 3단 아래 채석층: 석관 회랑·채석공 조각실(M)·석관실(V) / 붕괴 갱(구덩이 p, 나무 다리 b, 돌계단 s)·석재 하치장·운반 갱도(레일 r) → 수직갱 바닥(권양탑 G, 펌프 m).
-- 출구(케이지 승강기)는 남서 끝 수직갱 바닥 서쪽 벽. 출구 방 입구는 서로 다른 갈래 둘(북쪽 석관실 갱도, 동쪽 운반 갱도).
-- 막다른 굴(무너진 옛 갱도·유골 정리 굴·환기 수직갱)에는 숨는 곳(L)만, 뒤지는 곳(Z)은 갈래 벽과 입구 둘 이상인 방에만.
-- 출구까지 최단 약 128칸, 뒤지는 곳 23곳.
local Props = require(script.Parent.Parent.Props)
local CP = require(script.Parent.Parent.ChapterProps.Maze) -- 카타콤 전용 소품(석조 기둥·뼈 벽·해골 원통·권양기·광차·예배당·권양탑·납골당 문틀·붕락·무덤 등불·요새 부조 …)

return {
	Seed = 53,
	PipeChance = 0.1, -- (석회암 갱도라 벽 배관은 드물게)
	HideStyle = "closet", -- 숨는 곳(L): 낡은 벽장
	SearchStyle = "chest", -- 뒤지는 곳(Z): 궤짝, 그중 한 곳에 열쇠
	Props = {
		B = CP.Pillar, U = CP.BoneStack, u = CP.BoneFacing, Q = CP.SkullBarrel, K = CP.StoneBlocks, W = CP.Winch,
		R = CP.MineCart, r = CP.Rail, N = CP.Plaque, P = CP.Pew, J = CP.Altar, Y = CP.Well, G = CP.Headframe,
		I = CP.SpiralStair, V = CP.Sarcophagus, H = CP.OssuaryGate, F = CP.Rubble, l = CP.Lamp, M = CP.Sculpture,
	},
	Walkable = { r = true, u = true, N = true, H = true },
	Rows = {
		"###############################################",
		"#######################....W########N##.I..SS.#",
		"############Z#########..K....#####.........SS.#",
		"##F...##.......................##.............#",
		"##L............N#..###....K.........###......L#",
		"#####.....#######..####Z....#..Z...####......##",
		"#####...#########..###########.########...#####",
		"#####..######..##..###########.#######....#####",
		"####..............###########Z....#......######",
		"###....W...........N#####F..............#######",
		"##...##......K.#.....#######...Y.....##########",
		"##...##...##...##.....##...........############",
		"##.K......##...####..............L#############",
		"##......B......#####..Z...#################L###",
		"##Z...........Z############################.###",
		"##...##..#.....########....################.###",
		"##...##..#..B..#####u......Z######u.u...###.###",
		"##L............H.u.u....UU..##uu.u...u..###.###",
		"###rrRrrr......Hu.u.uu..U...u...uLu.##.u.u..###",
		"####.......Z.#########Z......u.u#####u......###",
		"#########HH############....#########..U...U..##",
		"#########...#############..#########Z...Q....##",
		"###L.U......#......L#####..Zu.u.u.##........Z##",
		"###....U.#....PP.PP..u.u.......u...uu........##",
		"############........J.u.u.u.u.N#u.u.....l...u##",
		"############..PP.PP..###############u.U...U..##",
		"############........Z################......Z###",
