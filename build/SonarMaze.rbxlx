-- 자동 생성(art/creatures/source/game/sprite.js): 만석 시안 그림 시트. 손으로 고치지 말 것
-- 칸 i = 방향 * 9 + 자세(0~3 걷기, 4~7 추격, 8 덮침), 방향 0 = 정면부터 45°씩. 시트 = i // 12 + 1, 칸 안 = i % 12
return {
	id = "k10s2", name = "만석",
