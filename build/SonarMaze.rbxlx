            <string name="Name">Stage2</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 2 — 물류 창고(물류 센터) (47x43칸 2층 건물: Rows 1층 + 같은 크기 Rows2 2층, tools/places/warehouse.js 로 생성, 설계 문서 docs/levels/stage2.md)
-- 한가운데 큰 랙 홀(격자 통로: 가로 통로 사이 등을 맞댄 랙 두 줄, 세로 통로 넷) + 둘레 구역. 북쪽 띠: 경비실(시작)·포장·분류장(분류 컨베이어)·입고 검수장·냉동 전실,
-- 서쪽 띠: 냉장실·냉동실(세로 랙, 증발기), 동쪽 띠: 지게차 충전실·정비실·출하 사무실, 남쪽: 하역 도크(실내)·도크 문 여섯(탑차 셋)·트럭 마당·남서쪽 정문(출구).
-- 물류 흐름을 따라간다: 경비실 → 포장장 → 검수장 / 냉동 전실 → 냉장·냉동실 / 2층 → 랙 홀 서쪽 입구 → 격자 통로로 홀을 가로질러 남동쪽 출고 대기장 →
-- 도크 셔터 둘 / 출하 사무실 → 하역 도크 / 트럭 마당 → 정문. 홀 북쪽 벽과 남쪽 벽 서쪽은 화재 셔터(x)가 내려와 닫혔다.
-- 2층: 관리동(사무실·회의실·전산실·탈의실 + 복도) — 냉동기 기계실·응축기실 — 피킹 메자닌(박스 흐름 선반 k·출고 컨베이어, 홀 서쪽 위, 계단 둘).
-- 괴물 하나가 어디 서도 돌아가는 길이 있다(목 0, tools/level-graph.js). 출구까지 최단 약 133칸.
-- 장비(ChapterProps/Warehouse): 랙 H·h(줄 하나가 한 덩어리)·지게차 F·팔레트 J·컨베이어 u·포장대 Y·랩 기계 W·충전기 g·증발기 e·서버 랙 R·도크 문 d·화재 셔터 x·탑차 K·작업대 B·선반 k·초소 G.
local Props = require(script.Parent.Parent.Props)
local WP = require(script.Parent.Parent.ChapterProps.Warehouse) -- 창고 전용 장비(지게차·팔레트·컨베이어·충전기·증발기·서버 랙)
return {
	Seed = 23,
	PipeChance = 0.2, -- (벽 배관은 볼트까지 부품이 많다: 줄 수를 줄인다)
	HideStyle = "tool", -- 숨는 곳(L): 공구 캐비닛
	SearchStyle = "crate", -- 뒤지는 곳(Z): 나무 상자, 그중 한 곳에 열쇠
	Props = { H = WP.RackRunX, h = WP.RackRunZ, K = WP.BoxTruck, T = Props.Desk, F = WP.Forklift, J = WP.PalletStack, u = WP.ConveyorRun, g = WP.Charger, e = WP.Evaporator, R = WP.ServerRack, d = WP.DockDoor, x = WP.FireShutter, W = WP.StretchWrapper, Y = WP.PackStation, k = WP.CartonFlow, B = WP.Workbench, G = WP.GuardBooth },
	Walkable = { e = true, d = true }, -- (증발기는 천장 쪽 벽걸이, 도크 문은 열린 셔터 문틀이라 바닥은 지나갈 수 있다)
	Rows = {
		"###############################################",
		"#Z...e..#Z.......F.#L.Y..Y..Y..Y..c...#.T..SS.#",
		"#.......#..........#..................#....SS.#",
		"#.......D..........#..................D......##",
		"#..JJJ..#..JJYYJJ..#uuuuuuuuuuuuuuu...#.....#2#",
