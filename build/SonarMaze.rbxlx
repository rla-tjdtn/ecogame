        <Item class="ModuleScript" referent="249">
          <Properties>
            <string name="Name">Stage4</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 4 — 폐병원 (47x43칸, tools/places/hospital.js 로 생성, 2층 = Rows2 겹쳐 쌓기)
-- ㄷ자 병원: 북쪽 외래·진료동과 남쪽 병동·수술동이 서쪽 본관 중앙 홀(엘리베이터·계단)에서만 이어진다(두 동 사이는 동쪽 끝까지 벽).
-- 1층 북쪽: 채혈 검사실─응급실(침대·커튼 줄)─외래 진료실 2곳(샛문)─영상의학과(엑스선)─원무과─정문 로비(출구) | 외래 복도 |
--   두 층이 트인 외래 대기 홀(접수대·의자 줄)─약국(조제 창구·약장)─화장실─외래 처치실.
-- 1층 남쪽: 관찰실 A·B─복도로 트인 간호 스테이션─처치실─관찰실 C─린넨실 | 병동 복도 | 영안실(냉장고 벽)─부검실─수술 준비실─수술실─회복실─공급실─당직실(시작).
-- 2층: 북쪽 회의실·원장실·의무기록실·직원 휴게실·로비 회랑 | 행정 복도 | 중환자실(중앙 감시 스테이션)·격리실, 남쪽 입원 병동(병실 줄 둘 + 간호 스테이션), 서쪽 엘리베이터 홀.
-- 계단 네 곳: 당직실 직원 계단, 중앙 홀 북·남 계단, 정문 로비 계단. 무너진 복도(외래 x24, 병동 x28, 2층 x11·x30)는 방을 가로질러 비켜 간다.
-- 출구까지 최단 약 121칸.
local Props = require(script.Parent.Parent.Props)
local HP = require(script.Parent.Parent.ChapterProps.Hospital)
return {
	Seed = 41,
	PipeChance = 0.25,
	HideStyle = "wardrobe", -- 숨는 곳(L): 병실 옷장
	SearchStyle = "nightstand", -- 뒤지는 곳(Z): 협탁, 그중 한 곳에 열쇠
	Props = { R = Props.Bed, T = Props.Desk, X = Props.Surgery, k = Props.Cabinet, N = HP.Counter, w = HP.Bench, C = HP.Curtain, I = HP.IVStand, G = HP.Gurney, W = HP.Wheelchair, u = HP.Sink, Y = HP.XRay, F = HP.MorgueFridge, H = HP.MedShelf, j = HP.ToiletStall, e = HP.Elevator, M = HP.Monitor },
	Walkable = { k = true, C = true, e = true }, -- (캐비닛은 벽에 붙어 칸 반이 비고, 커튼·엘리베이터 문은 벽면 장식: 지나갈 수 있다. 침대·카운터·의자 줄 등은 막힌 칸)
	Rows = {
		"###############################################",
		"#Z....u#.RCRCRCRC.#u...R#u...R#L...Z#k.ZN...#E#",
