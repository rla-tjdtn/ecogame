		"#..L..D..R.R#####.....###.D.........#.....#.#",
		"#.....#.....#####..X..###.#########.#.....#.#",
		"#R.R.R#.....#..k#...Z.###.#.Z..R#.#.#.....#.#",
		"#######.....#Z..#D###A###.#.....D.#.A.....#.#",
		"###k..D.....#...#.#R....#.#.....#...#R.R.R#.#",
		"###...###D####D##.#.....#.D.....######A####.#",
		"###...###.........#R....###.....###.L...D.#D#",
		"####.#########.#######.######D#####.....#.#.#",
		"#.........................###.....D....Z#.#.#",
		"####D#####D######.###########.....#.....#.#.#",
