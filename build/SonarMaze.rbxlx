        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Stage5</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 5 — 심층 미로 (47x43칸, tools/gen-stages.js 로 생성, 방 안 구성·갈림길은 tools/redecorate.js)
-- 막다른 길이 많은 미로 통로, 큰 구덩이 3곳을 건너는 다리(b)와 괴물이 건널 수 없는 좁은 다리(n), 계단(s)으로 오르내리는 아래층,
-- 대형 기둥(B) 열주실, 독방. 괴물 4마리가 여러 방향에서 접근한다. 출구까지 최단 약 150칸(걸어서 약 2분).
local Props = require(script.Parent.Parent.Props)

local function bigPillar(ctx, i, j)
	local Kit = ctx.Kit
	local p = ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
	local h = ctx.H - ctx.floorY(i, j)
	Kit.box(ctx.geo, CFrame.new(p + Vector3.new(0, h / 2, 0)), Vector3.new(4.4, h, 4.4), { name = "BigPillar" })
	Kit.box(ctx.geo, CFrame.new(p + Vector3.new(0, 0.6, 0)), Vector3.new(6, 1.2, 6))
	Kit.box(ctx.geo, CFrame.new(p + Vector3.new(0, 1.6, 0)), Vector3.new(5.2, 0.8, 5.2))
	Kit.box(ctx.geo, CFrame.new(p + Vector3.new(0, h - 1.2, 0)), Vector3.new(6, 2.4, 6))
	for _, s in { -1, 1 } do
		Kit.box(ctx.geo, CFrame.new(p + Vector3.new(s * 2.4, h / 2, 0)), Vector3.new(0.5, h - 4, 1.4), { blocks = false })
		Kit.box(ctx.geo, CFrame.new(p + Vector3.new(0, h / 2, s * 2.4)), Vector3.new(1.4, h - 4, 0.5), { blocks = false })
	end
end

return {
	Seed = 53,
	PipeChance = 0.5,
	HideStyle = "closet", -- 숨는 곳(L): 낡은 벽장
	SearchStyle = "chest", -- 뒤지는 곳(Z): 궤짝, 그중 한 곳에 열쇠
	Props = { B = bigPillar, P = Props.BigPipe },
	Walkable = { P = true },
	Rows = {
		"###############################################",
		"#SS...A...D.L.###.............................#",
		"#.....###A#...###############.###.............#",
		"#SS...#...#.....#...........#.###ppsppbppppppp#",
		"#.....#L..#####.#.B.B...B.B.#.###pppppbppppppp#",
		"#.....#m.Z#.#...#..........Z#...#ppppsbppspppp#",
		"###A#A#####.#.###...B.B.B...###.#.............#",
		"#...#...#.......#....Z......#...#.............#",
		"#.#.#...#.##############.####.###########D#####",
		"#A#.#.m.#.###..Z###..v#..##...#########.......#",
		"#.#####A#.###L.m#.A..L#.###.#.#########.#.###.#",
		"#.#Z.L#.#.###...A.#...#.....#...#######.#...#.#",
		"#.#..m#.#.#######.#########.###.#######.###.###",
		"#.#...#.........A.....A...#.###...........#...#",
		"#.###.###.###############.#.#######.#####A###.#",
		"#.#...............#.......#.#...............#.#",
		"#.#pspppbppspppppp#.#######.................#.#",
		"#.#pppppbppppppppp#...#.#...#...............#.#",
		"#.#ppsppbppppppppp###.#.#.###ppppsppbppspppp#.#",
		"#.#...............###.#...###pppppppbppppppp#.#",
		"#.#...............###.#.#####ppppppsbppppppp#.#",
		"#.#...............###.#A#...#...............#.#",
		"#.###########D#######A#.#A#.############A####.#",
		"#.#######.............#.#.#.......#...#...###.#",
		"#.#######.#############.#######.#A#.#.#.#.###.#",
		"#.....A...#########...#.........#...#...#...#.#",
		"#.#################.#.#######.#D#####A#####.#.#",
		"#.#############.....#.......#.#.......#...A.#.#",
		"#.#############.#########.#.#.#Z....B.A.####E.#",
		"#.............#.#..L#.....#.#.#.......#.#...#.#",
		"#############.#.#...#.#######.#.B.B.B.#.A..L#.#",
		"#.............#...Z.#.........#.......###.....#",
		"#.#############A#####.#########.B.B...#######.#",
		"#.#...............###.#.A..A..#.....Z.###...#.#",
		"#.#########.#####.###.#######A#####A#####.#.#A#",
		"#.#.........#.#...###...A.........#.#.....#.#.#",
		"#.#.#########.#A######A##########.#.#A#####.#.#",
		"#.#.#..L#.....#...A.............A...#.#####.#.#",
		"#A#.#...#A###.#.###############.#####.#####.#.#",
		"#...#mZ...#...#.....#.....A.A.#.#####.#####...#",
		"#########.#####.#..m#.###.#####.#####.#########",
		"#.........A.....#L..#...#.............#########",
		"###############################################",
	},
}
]]></string>
