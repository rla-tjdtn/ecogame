        <Item class="ModuleScript" referent="254">
          <Properties>
            <string name="Name">Stage9</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 9 — 지하 주차장 (47x43칸, tools/places/parking.js 로 생성)
-- 지하 1층 북쪽: 엘리베이터 홀(시작)·방재실·주차 구역 A/B(차 Q, 빈 칸 l, 굵은 기둥 B, 칸막이 아치).
-- 동쪽 3칸 폭 차량 램프와 비상계단 둘(s)로 지하 2층(구덩이 높이: 차 K, 빈 칸 y, 기둥 X)으로 내려간다. 지하 2층 주차 줄 사이에는
-- 침수 대비로 한 단 올린 비상 발전기실·소화펌프실이 있어 지나갈 수도 있다(문마다 계단). 서쪽 끝은 좁은 배관 통로.
-- 서쪽 3칸 폭 램프와 비상계단 둘로 지하 1층 남쪽(기계실·전기실·하역장)으로 올라와, 급배기 팬룸 또는 네 칸 폭 트럭 차로로
-- 정산 구역, 차단기(g)가 달린 차량 출구 게이트(E)로. 맞댄 주차 줄의 한 줄은 굵은 콘크리트 벽 기둥(#)이라 넓은 구역이 음파 크기로 끊긴다.
-- 전용 소품은 ChapterProps/Parking. 숨는 곳(L)은 사물함, 뒤지는 곳(Z)은 공구함(지하 2층은 올린 방에만). 출구까지 최단 약 122칸.
local Props = require(script.Parent.Parent.Props)
local CP = require(script.Parent.Parent.ChapterProps.Parking)
return {
	Seed = 91,
	PipeChance = 0.3,
	HideStyle = "locker", -- 숨는 곳(L): 철제 사물함
	SearchStyle = "toolbox", -- 뒤지는 곳(Z): 공구함, 그중 한 곳에 열쇠
	Props = { Q = CP.Car, K = CP.Car, l = CP.EmptyStall, y = CP.EmptyStall, B = CP.Pillar, X = CP.Pillar, u = CP.Cart, h = CP.Hydrant, e = CP.Elevator, x = CP.Shutter, g = CP.Barrier, J = CP.PayMachine, s = CP.Ramp, T = Props.Desk, k = Props.Cabinet, C = CP.CctvDesk, t = CP.EvCharger, N = CP.HangSign, q = CP.HangSign, j = CP.JetFan, a = CP.JetFan, d = CP.Duct, i = CP.Cone, w = CP.SpeedBump, G = CP.Generator, R = CP.Switchgear, P = CP.FirePump, H = CP.WaterTank, V = CP.FanUnit, U = CP.Truck, z = CP.PalletJack, Y = CP.RecycleBin },
	PitTiles = { K = true, X = true, y = true, a = true, q = true },
	Walkable = { l = true, y = true, u = true, h = true, e = true, x = true, g = true, k = true, N = true, q = true, j = true, a = true, d = true, i = true, w = true, K = false, X = false },
	Rows = {
		"###############################################",
		"#.e.e.e.J#Z.lQQQBQlllBQQQQB#QQQBQQQQBlQQQBQQ.Z#",
		"#........#.................A..................#",
		"#.SS.....D.N..............u#..................#",
		"#........#..#QQl#Q.Q#QlQ#Q.#.#llQ#lQ.#lQl#QQ.Z#",
		"#L......h#h.BllQBQ.QBlllBQ.#.BllQBQQ.BQQlBll..#",
		"#####D####..........j.....Z#Z.....j..........h#",
		"#..Z....k#t................AN...............i.#",
		"#C......k#t.lQ.QQQBQlQ.lQQ.#.QQB.QlBlQQB.QQB..#",
		"#C..T....#..QQ.QQQ#lQQ.QQQ.#.QQ#.QQ#QlQ#.lQ#.L#",
		"#.....T..D.................#u.........i.......#",
		"#L.......#.................A............N.....#",
		"#..L..Z.L#Z.QQBQQlQBQQlQBQl#QQBllll...........#",
		"####################################s##sss##s##",
		"#ppKXKKKKXyKKyXKKKyXyKKppppppppppppppppppppppp#",
		"#p#ppppppppppppppppppppp#ppppppppppppppppppppp#",
		"#p#pppapppppppppppqppppp#pppppppppppppppappppp#",
		"#p#KKypKK#######pyKpyKKp#pK#yp#######pKKKpKypp#",
		"#p#KKKpKK#Z.G.R#pKKpKKKp#pKXKp#Z.PP.#pKKKpKKpp#",
		"#p#pppppp#.....#pppppppp#ppppp#.....#ppppppppp#",
		"#pppppppsA.....AspppppqppppppsA.....Aspppppppp#",
		"#p#pppppp#.....#pppppppppppppp#.....#ppppppppp#",
		"#p#KXpKKX#L.G.Z#pXKypXyp#pKKKp#L.H.Z#pKXpKKXpp#",
		"#p#K#pKK########p#KKp#Kp#pyKyp#######pK#pyK#pp#",
		"#p#ppppppppppppppppppppp#ppppppppppppppppppppp#",
		"#p#pppppppppppppppppapppppqpppppppappppppppppp#",
		"#ppppppppppppppppppppppppppppppppppppppppppppp#",
		"#pppppppppppppXKKKKXKKKp#pKyKXKKyKXyKyyXKKyyXp#",
		"##sss###s####s#################################",
		"#.....h............h......L#.YYY..#L######...L#",
		"#Z..............u..........#......D.#####J....#",
		"######D#####...........U...#L.....#.D..Z#....h#",
		"#Z........L#Z..........U...#..Y..L#.#C..D.....#",
		"#.m.m......#........z.....c########.#####....Z#",
		"#..........D.....#####.....#..V.V.#...........#",
		"#.....f....#.....#####.....D...d..D......B..###",
		"#v......V..#.c....z.......Z#Z....L#.....N...gE#",
		"####D#######............u..########.........###",
		"#.........Z#..................w.......B..ii...#",
		"#k.........#..U.............N.w...............#",
		"#..........D..U...............w...............#",
		"#L.Z..RRR..#Z.x..x..x..x......w........Z...QQ.#",
		"###############################################",
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="255">
        <Properties>
          <string name="Name">TestHarness</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- 자동 플레이 테스트. Studio 가 StudioTestService 로 플레이를 시작했을 때만 동작한다(tools/studio-test.js).
-- 일반 플레이·게시된 게임에서는 아무것도 하지 않는다. 모든 테스트 플레이어는 음소거(TestMute).
--   core  : 1인 — 어둠, 음파 퍼짐·유지·소멸, 벽/닫힌 문 가림, 발사 간격, 이동 속도, 괴물 청각·경로·추격·사망, 출구
--   multi : 여러 클라이언트 — 동시 음파, 서로의 음파 수신, 프레임 시간

local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
if not RunService:IsStudio() then
	return
end
local StudioTestService = game:GetService("StudioTestService")
local okArgs, args = pcall(function()
	return StudioTestService:GetTestArgs()
end)
if not okArgs or type(args) ~= "table" or not args.Test then
	return
end

local Players = game:GetService("Players")
local LogService = game:GetService("LogService")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Round = require(script.Parent.Round)
local Doors = require(script.Parent.Doors)
local SoundBus = require(script.Parent.SoundBus)
local Hiding = require(script.Parent.Hiding)
local Search = require(script.Parent.Search)

local R = { test = args.Test, finished = false, checks = {}, log = {}, errors = {}, info = {} }
local t0 = os.clock()
local function log(s)
	table.insert(R.log, string.format("%6.1f %s", os.clock() - t0, s))
end
local function check(name, ok, info)
	table.insert(R.checks, { name = name, ok = ok == true, info = if info ~= nil then tostring(info) else nil })
	log((if ok then "PASS " else "FAIL ") .. name .. (if info ~= nil then " (" .. tostring(info) .. ")" else ""))
end
LogService.MessageOut:Connect(function(msg, kind)
	if kind == Enum.MessageType.MessageError or (kind == Enum.MessageType.MessageWarning and (msg:find("%[Monster%]") or msg:find("%[SoundBus%]"))) then
		if #R.errors < 30 then
			table.insert(R.errors, msg:sub(1, 300))
		end
	end
end)

-- 테스트 설정: 괴물은 시험할 때만 움직이고, 결과 화면은 짧게
-- 로비 테스트만 로비로, 나머지는 바로 게임으로 시작(Lobby.boot 가 읽는다)
ReplicatedStorage:SetAttribute("ForceMode", if args.Test == "lobby" then "Lobby" else "Game")
Config.Monster.StartDelay = 1e6
Config.Lives.PerStage = 1 -- (예전 테스트는 한 번 잡히면 죽는 것을 전제: lives 테스트에서만 3개)
Config.SafeZone.Enabled = false -- (예전 테스트는 시작 방에서 괴물을 시험한다: lives 테스트에서만 켠다)
Config.Flower.StartDelay = 1e6 -- (꽃괴물도 멈춰 둔다)
Config.Doppel.StartDelay = 1e6 -- (도플갱어도 멈춰 둔다: doppel 테스트에서만 움직인다)
Config.Key.Required = false -- (열쇠 시험은 core 에서 따로 켠다)
Config.Key.Count = 1 -- (예전 열쇠 시험은 열쇠 하나를 전제)
Config.Round.ResultSeconds = 2
Config.Round.FirstStartDelay = 1

for _, p in Players:GetPlayers() do
	p:SetAttribute("TestMute", true)
end
Players.PlayerAdded:Connect(function(p)
	p:SetAttribute("TestMute", true)
end)
local probe = Instance.new("RemoteFunction")
probe.Name = "TestProbe"
probe.Parent = ReplicatedStorage

local function ask(p, cmd, arg)
	-- (클라이언트가 응답하지 않아도 10초 뒤 nil)
	local done, ok, res = false, false, nil
	task.spawn(function()
		ok, res = pcall(function()
			return probe:InvokeClient(p, cmd, arg)
		end)
		done = true
	end)
	local t = os.clock()
	while not done and os.clock() - t < 10 do
		task.wait()
	end
	if not done then
		log("probe timeout " .. cmd)
		return nil
	end
	if not ok then
		log("probe error " .. cmd .. ": " .. tostring(res))
		return nil
	end
	return res
end

local function waitFor(fn, timeout)
	local t = os.clock()
	while os.clock() - t < timeout do
		local v = fn()
		if v then
			return v
		end
		task.wait(0.1)
	end
	return nil
end

local function root(p)
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end

local function place(p, pos, look)
	local char = p.Character
	if char then
		char:PivotTo(CFrame.lookAt(pos, look or (pos + Vector3.new(1, 0, 0))))
		local r = root(p)
		if r then
			r.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

local function tile(i, j, y)
	return Vector3.new((i - 1) * 8 + 4, y or 3, (j - 1) * 8 + 4)
end

-- 시작 → 출구를 실제로 걸을 수 있는가. 괴물과 같은 방식: 바로 계산이 안 되면 타일 경로를 LegTiles 칸씩 나눠 계산
-- (from·to 를 주면 그 두 곳 사이: 맵 길찾기 검사 mapnav)
local function routeWalkable(agent, monster: boolean, fromPos: Vector3?, toPos: Vector3?): (string, number)
	local path = PathfindingService:CreatePath({ AgentRadius = agent.r, AgentHeight = agent.h, AgentCanJump = false })
	local from = fromPos or Round.info.spawns[1].Position - Vector3.new(0, 2.5, 0)
	local to = toPos or Round.info.exitCFrame.Position - Vector3.new(0, 3.5, 0)
	local function compute(a, b)
		local ok = pcall(function()
			path:ComputeAsync(a, b)
		end)
		return ok and path.Status == Enum.PathStatus.Success
	end
	if compute(from, to) then
		return "Success", 1
	end
	local r = Round.info.route(from, to, monster)
	if not r then
		return "NoRoute", 0
	end
	local pos, idx, legs = from, 1, 0
	while idx < #r do
		local step = Config.Monster.LegTiles
		local moved = false
		for _, n in { math.min(#r, idx + step), math.min(#r, idx + math.ceil(step / 2)), idx + 1 } do
			if compute(pos, r[n]) then
				pos, idx, legs, moved = r[n], n, legs + 1, true
				break
			end
		end
		if not moved then
			return string.format("LegFail@c%d,r%d", math.floor(r[idx].X / 8), math.floor(r[idx].Z / 8)), legs
		end
	end
	return "Success", legs
end

local function readyPlayers(n)
	return waitFor(function()
		local ps = Players:GetPlayers()
		if #ps < n or Round.state ~= "Playing" then
			return nil
		end
		for _, p in ps do
			if p:GetAttribute("Status") ~= "Alive" or not root(p) then
				return nil
			end
			local st = ask(p, "stats")
			local stage = workspace:FindFirstChild("Stage")
			if not st or not st.ready or not stage or st.buildId ~= stage:GetAttribute("BuildId") then
				return nil
			end
		end
		return ps
	end, if n > 1 then 240 else 90)
end

local function stageFolder()
	return workspace:FindFirstChild("Stage")
end

-- ─────────────────────────────── 문 끼임 ───────────────────────────────
-- 문 바로 앞(예전에 문짝이 휘두르던 자리)에 서서 열고 지나간다 — 양쪽에서. 문짝은 여는 사람 반대쪽으로 열려야 한다
local function doorTests(p)
	local door = nil
	for _, d in Doors.all() do
		if (d.panel.Position - tile(5, 3, 4.5)).Magnitude < 4 then
			door = d
		end
	end
	if not door then
		check("door for the stuck test", false)
		return
	end
	local x0 = door.panel.Position.X
	for _, side in { -1, 1 } do
		if door.open then
			Doors.toggle(door)
			task.wait(1)
		end
		local from = Vector3.new(x0 + side * 2.2, 3, tile(5, 3).Z)
		local to = Vector3.new(x0 - side * 9, 3, tile(5, 3).Z)
		place(p, from, to)
		task.wait(0.4)
		Doors.toggle(door, p)
		task.wait(0.8)
		ask(p, "move", to)
		local crossed = waitFor(function()
			local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			return r and (r.Position.X - x0) * -side > 2.5
		end, 4)
		check(string.format("open a door standing right at it and walk through (%s side)", if side < 0 then "west" else "east"), crossed ~= nil)
	end
	if door.open then
		Doors.toggle(door)
	end
end

-- ─────────────────────────────── 괴물 모습·등장 ───────────────────────────────
local function monsterTests(p)
	local m = Round.monsters[1]
	if not m then
		check("monster exists for look tests", false)
		return
	end
	-- 막대는 한 획(Line), 얇은 원판은 원 하나(Disc): 음파에 여러 겹 선으로 보이지 않게
	local cyl, ok = 0, 0
	for _, d in m.model:GetDescendants() do
		if d:IsA("Part") and d.Shape == Enum.PartType.Cylinder then
			cyl += 1
			local sh = d:GetAttribute("SonarShape")
			if sh == "Line" or sh == "Disc" then
				ok += 1
			end
		end
	end
	if m.model:GetAttribute("Rig") == 4 then
		-- 3D 시안 괴물: 선 막대 대신 뼈 메시(시안 선 정점 색) + 음파에 드러날 때 흰 윤곽선. 메시·뼈·스킨이 붙어 있는가
		local meshes, bones, skinned = 0, 0, 0
		for _, d in m.model:GetDescendants() do
			if d:IsA("MeshPart") then
				meshes += 1
				if d.HasSkinnedMesh then
					skinned += 1
				end
			elseif d:IsA("Bone") then
				bones += 1
			end
		end
		check("monster body is a skinned 3D mesh (chapter creature)", meshes > 0 and bones > 10 and skinned > 0, string.format("%s meshes %d bones %d skinned %d", tostring(m.model:GetAttribute("Creature")), meshes, bones, skinned))
	else
		check("monster strokes draw as single lines (Line/Disc)", cyl > 10 and ok == cyl, ok .. "/" .. cyl)
	end
	local visible = 0
	for _, d in m.model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 then
			visible += 1
		end
	end
	check("monster body is invisible (only sonar reveals it)", visible == 0, visible)
	-- 음파가 닿으면 괴물 모습이 선으로 나타난다
	m.startAt = 1e9
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		place(p, tile(3, 10, 3), tile(7, 10, 3))
		task.wait(0.3)
		local mpos = tile(6, 10, 5.2)
		m.model:PivotTo(CFrame.lookAt(mpos, tile(3, 10, 5.2)))
		m.waypoints = {}
		task.wait(0.3)
		ask(p, "resetCooldown")
		ask(p, "fire")
		task.wait(1.0)
		local n = ask(p, "linesNear", { mpos, 4.5 }) or 0
		-- (음파에 맞은 괴물은 굳은 선 대신 지금 모습 그대로 보인다: Reveal)
		local shown = ask(p, "reveal") or 0
		check("monster appears in the sonar as lines", n >= 15 or shown >= 1, string.format("lines %d, shown %d", n, shown))
	end
	-- 배회하다가 가끔 플레이어 근처로 온다
	m.model:PivotTo(CFrame.new(Round.info.exitCFrame.Position + Vector3.new(0, 1.2, 0)))
	m.waypoints = {}
	m.legGoal = nil
	m.target = nil
	m:setState("Wander")
	m.lastHunt = -1e9
	m.startAt = 0
	m.goal = nil
	waitFor(function()
		return m.lastHunt > 0
	end, 4)
	task.wait(2) -- (먼 길은 경로 계산이 걸린다)
	local goal = m.goal
	local pr = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local gd = if goal and pr then (goal - pr.Position).Magnitude else -1
	-- (구역을 맡은 괴물은 자기 구역 안의 플레이어에게만 다가간다: 플레이어가 구역 밖이면 다가가지 않는 게 맞다)
	local inZone = pr == nil or (m :: any).territory == nil or m:inTerritory(pr.Position)
	if inZone then
		check("wandering monster drifts toward a player now and then", goal ~= nil and gd >= 0 and gd <= Config.Monster.HuntRadius + 8, string.format("%.0f studs", gd))
	else
		check("wandering monster stays in its own zone (player is outside it)", goal == nil or m:inTerritory(goal), string.format("goal %s", tostring(goal)))
	end
	m.startAt = 1e9
	m.waypoints = {}
end

-- ─────────────────────────────── 숨는 곳 ───────────────────────────────
-- 들어가기(E) → 음파 못 쏨 → 바로 앞 괴물도 못 찾음 → 나오기(E) → 쫓던 괴물이 숨는 걸 보면 끌어냄(사망)
local function hideTests(p)
	local spots = Hiding.all()
	check("hide spots built (cabinets/wardrobes)", #spots >= 5, #spots)
	local spot = spots[1]
	local m = Round.monsters[1]
	if not spot or not m then
		return
	end
	m.startAt = 1e9
	place(p, spot.front + Vector3.new(0, 3, 0), spot.center + Vector3.new(0, 3, 0))
	-- 1인칭 카메라 방향은 클라이언트가 정한다: 사물함을 바라보게(안내는 화면 안에 있을 때만 뜬다)
	local ui0 = nil
	waitFor(function()
		-- (순간이동 직후엔 카메라가 아직 옛 자리라, 자리를 잡을 때까지 다시 바라보게 한다)
		ask(p, "lookTarget", spot.center + Vector3.new(0, 3, 0))
		ui0 = ask(p, "stats")
		return ui0 ~= nil and ui0.ui.prompt == "E   숨기"
	end, 3)
	local nearDoor = math.huge
	for _, d in Doors.all() do
		nearDoor = math.min(nearDoor, ((d.prompt.Parent :: BasePart).Position - spot.front).Magnitude)
	end
	local pinfo = if not (ui0 and ui0.ui.prompt == "E   숨기") then ask(p, "prompts") else ""
	check("hide prompt shown near the cabinet", ui0 and ui0.ui.prompt == "E   숨기", string.format("%s | %s | tile %d,%d door %.1f enabled %s", ui0 and tostring(ui0.ui.prompt) or "no ui", tostring(pinfo), math.floor(spot.center.X / 8), math.floor(spot.center.Z / 8), nearDoor, tostring(spot.prompt.Enabled)))
	local ok = Hiding.enter(p, spot)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local inside = root and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(spot.center.X, 0, spot.center.Z)).Magnitude
	check("E: hide inside (anchored, inside the cabinet)", ok and p:GetAttribute("Hidden") == true and root ~= nil and root.Anchored and inside ~= nil and inside < 1.5, string.format("ok=%s inside=%.2f", tostring(ok), inside or -1))
	local ui1 = nil
	waitFor(function()
		ui1 = ask(p, "stats")
		return ui1 and ui1.ui.prompt == "E   나가기"
	end, 3)
	check("prompt says get out while hidden", ui1 and ui1.ui.prompt == "E   나가기", ui1 and tostring(ui1.ui.prompt))
	local Main = _G.SonarMaze
	local before = Main.Sonar.accepted[p] or 0
	ask(p, "resetCooldown")
	local fired = ask(p, "fire")
	ask(p, "rawFire")
	task.wait(0.6)
	check("no sonar while hidden", not fired and (Main.Sonar.accepted[p] or 0) == before, tostring(fired))
	local mpos = spot.front + spot.facing * 2 + Vector3.new(0, 5.2, 0)
	m.model:PivotTo(CFrame.lookAt(mpos, spot.center + Vector3.new(0, 5.2, 0)))
	m.waypoints = {}
	m.legGoal = nil
	m.target = nil
	m.pullSpot = nil
	m:setState("Wander")
	m.startAt = 0
	task.wait(3)
	check("monster right outside does not find a hidden player", p:GetAttribute("Status") == "Alive" and m.state ~= "Chase", m.state)
	m.startAt = 1e9
	Hiding.exit(p)
	task.wait(0.2)
	check("E: get out in front of the cabinet", p:GetAttribute("Hidden") == false and root ~= nil and not root.Anchored and (root.Position - spot.front).Magnitude < 4.5, root and string.format("%.1f", (root.Position - spot.front).Magnitude))
	-- 쫓기다가 보는 앞에서 숨기
	local cpos = spot.front + spot.facing * 10 + Vector3.new(0, 5.2, 0)
	m.model:PivotTo(CFrame.lookAt(cpos, spot.front + Vector3.new(0, 5.2, 0)))
	m.waypoints = {}
	m.legGoal = nil
	m.startAt = 0
	m:startChase(p, root and root.Position or spot.front)
	task.wait(0.2)
	Hiding.enter(p, spot)
	local dead = waitFor(function()
		return p:GetAttribute("Status") == "Dead"
	end, 10)
	check("monster that saw you hide pulls you out", dead ~= nil, m.state .. " " .. table.concat(m.log, " | "):sub(-160))
end

-- ─────────────────────────────── core ───────────────────────────────
local function core()
	local ps = readyPlayers(1)
	check("player spawned and sonar world built", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local stage = stageFolder()
	local st = ask(p, "stats")
	R.info.world = st and { segs = st.segs, culled = st.culled, unattached = st.unattached, viewParts = st.viewParts, grid = st.grid }
	check("outline segments generated", st and st.segs > 1000, st and st.segs)
	check("almost every segment can receive the wave", st and st.unattached < st.segs * 0.08, st and (st.unattached .. "/" .. st.segs))
	check("seams removed (coplanar/buried edges culled)", st and st.culled > 0, st and st.culled)

	-- 1. 어둠
	local L = game:GetService("Lighting")
	local lights = 0
	for _, d in workspace:GetDescendants() do
		if d:IsA("Light") then
			lights += 1
		end
	end
	local bright = 0
	local neon = 0
	for _, d in stage:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Transparency < 1 and (d.Color.R + d.Color.G + d.Color.B) > 0.001 then
				bright += 1
			end
			if d.Material == Enum.Material.Neon then
				neon += 1
			end
		end
	end
	check("darkness: no ambient/brightness, no lights", L.Brightness == 0 and L.Ambient == Color3.new() and L.OutdoorAmbient == Color3.new() and lights == 0, "lights=" .. lights)
	check("darkness: every structure is black and unlit", bright == 0 and neon == 0, "nonblack=" .. bright .. " neon=" .. neon)
	check("client lighting is dark too", st and st.lighting.brightness == 0, st and st.lighting.brightness)
	task.wait(3)
	local idle = ask(p, "stats")
	check("nothing visible before a pulse", idle and idle.lines.lit == 0, idle and (idle.lines.lit .. " lit, pulses started " .. tostring(idle.pulsesStarted)))

	-- 계단 경사로 방향(쐐기 방향 확인)
	local stairs = stage:FindFirstChild("Props") and stage.Props:FindFirstChild("Stairs")
	if stairs then
		local ramp = stairs:FindFirstChildWhichIsA("WedgePart")
		local f = ramp.CFrame.ZVector
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = { ramp }
		local function h(off)
			local o = ramp.Position + f * off + Vector3.new(0, 10, 0)
			local hit = workspace:Raycast(o, Vector3.new(0, -30, 0), rp)
			return hit and hit.Position.Y
		end
		local hi, lo = h(2.5), h(-2.5)
		check("stairs ramp rises toward the upper floor", hi and lo and hi > lo + 2, tostring(hi) .. " vs " .. tostring(lo))
	end

	-- 걸을 수 있는 미로: 시작 → 출구 경로
	for _, agent in { { name = "player", r = 1.2, h = 5.5 }, { name = "monster", r = Config.Monster.AgentRadius, h = Config.Monster.AgentHeight } } do
		local status, legs = routeWalkable(agent, agent.name == "monster")
		check("path start -> exit exists (" .. agent.name .. " size)", status == "Success", status .. " legs=" .. legs)
	end

	-- 2~4. 음파: 가까운 곳부터, 유지, 소멸
	place(p, tile(3, 3, 3), tile(3, 6, 3))
	task.wait(0.5)
	ask(p, "resetCooldown")
	local fired = ask(p, "fire")
	check("left-click pulse fires", fired == true)
	local samples = {}
	for _, t in { 0.1, 0.35, 0.7, 1.2 } do
		task.wait(t - (samples.t or 0))
		samples.t = t
		local s = ask(p, "stats")
		table.insert(samples, s and s.lines.lit or -1)
	end
	log("lit over time: " .. table.concat(samples, ", "))
	check("outline appears progressively (grows over time)", samples[1] < samples[2] and samples[2] <= samples[3] and samples[3] > 0, table.concat(samples, ","))
	local tr = ask(p, "trace")
	if tr and tr.trace and #tr.trace > 20 then
		local n = #tr.trace
		local early, late = 0, 0
		local k = math.max(1, n // 10)
		for i = 1, k do
			early += tr.trace[i][2]
			late += tr.trace[n - k + i][2]
		end
		early /= k
		late /= k
		local lastT = tr.trace[n][1]
		check("near structures revealed first, far last", early < late - 8, string.format("first10%%=%.1f last10%%=%.1f studs", early, late))
		check("wave reaches the far edge in ~R/speed", lastT > 0.5 and lastT < 1.4, string.format("%.2fs", lastT))
		-- 시간과 거리의 관계: 늦게 나타난 선일수록 멀다
		local monotone = 0
		for i = 2, n do
			if tr.trace[i][2] + 1.5 >= tr.trace[i - 1][2] then
				monotone += 1
			end
		end
		check("reveal order follows distance", monotone / (n - 1) > 0.97, string.format("%.3f", monotone / (n - 1)))
		R.info.pulse = { revealed = n, lastT = lastT }
	else
		check("pulse trace recorded", false, tr and #tr.trace)
	end
	task.wait(0.6) -- t≈1.8
	local mid = ask(p, "stats")
	check("outline still visible ~1.8s after the pulse", mid and mid.lines.lit > 0, mid and mid.lines.lit)
	task.wait(Config.Sonar.Hold - 0.4) -- t≈Hold+1.4 (가장 먼 선은 0.9초에 나타나 Hold초 뒤 사라짐)
	-- (Studio 창이 뒤에 있으면 화면 갱신이 느려져 선이 늦게 꺼질 수 있다: 최대 4초 더 기다린다)
	local after = ask(p, "stats")
	waitFor(function()
		after = ask(p, "stats")
		return after and after.lines.lit == 0 and after.lines.active == 0
	end, 4)
	check("outline gone again (~Hold s after reveal)", after and after.lines.lit == 0 and after.lines.active == 0, after and (after.lines.lit .. "/" .. after.lines.active))
	-- 방 안쪽 모서리까지 바닥 선이 끊기지 않고 닿는다(시작 방 오른쪽 위 모서리: 북쪽 벽과 동쪽 벽이 만나는 곳)
	local corner = Vector3.new(32, 0, 8)
	local ends = ask(p, "floorEndsNear", { corner, 0.3 }) or 0
	check("floor lines reach the inner corner (no gap)", ends >= 2, ends)
	-- 지도(Q): 내 음파가 닿은 곳은 선이 사라진 뒤에도 지도에 남는다
	local mp = ask(p, "map")
	check("map records where my sonar reached", mp and mp.explored > 5 and mp.lines > 5, mp and (mp.explored .. " tiles, " .. mp.lines .. " lines"))
	local opened = ask(p, "toggleMap")
	task.wait(0.3)
	local mp2 = ask(p, "map")
	check("Q opens the map with my position", opened and opened.open and mp2 and mp2.meShown, mp2 and tostring(mp2.meShown))
	local closed = ask(p, "toggleMap")
	check("Q closes the map", closed and not closed.open)

	-- 5. 벽·닫힌 문 너머는 보이지 않는다
	local pillar = tile(8, 3, 0)
	local pillarSegs = ask(p, "segsNear", { pillar + Vector3.new(0, 6, 0), 3.5 }) or {}
	check("pillar behind the door has outline segments", #pillarSegs > 4, #pillarSegs)
	local door
	for _, d in Doors.all() do
		if (d.panel.Position - tile(5, 3, 4.5)).Magnitude < 4 then
			door = d
		end
	end
	check("test door found", door ~= nil)
	local function revealedFrom(pos)
		ask(p, "resetCooldown")
		place(p, pos, pillar + Vector3.new(0, 3, 0))
		task.wait(0.4)
		ask(p, "fire")
		task.wait(1.3)
		local t = ask(p, "trace")
		local set = {}
		for _, e in (t and t.trace) or {} do
			set[e[3]] = true
		end
		local hits = 0
		for _, id in pillarSegs do
			if set[id] then
				hits += 1
			end
		end
		return hits, (t and #t.trace) or 0
	end
	if door then
		if door.open then
			Doors.toggle(door)
			task.wait(0.8)
		end
		local hits, total = revealedFrom(Vector3.new(29, 3, 20))
		check("closed door: structures behind it are NOT revealed", hits == 0 and total > 50, "pillar hits=" .. hits .. " total=" .. total)
		Doors.toggle(door)
		task.wait(0.9)
		local hits2, total2 = revealedFrom(Vector3.new(29, 3, 20))
		check("open door: the wave passes through the doorway", hits2 > 0, "pillar hits=" .. hits2 .. " total=" .. total2)
		Doors.toggle(door)
		task.wait(0.8)
	end
	-- 두꺼운 벽 너머(옆방)도 보이지 않는다: 시작 방 동쪽 8스터드 벽 너머 방의 북쪽 벽면(직선 거리 32, 문을 돌아가면 36 이상)
	do
		local crate = Vector3.new(44, 12.5, 9.5) -- (북쪽 벽-천장 모서리와 경사)
		local segs = ask(p, "segsNear", { crate, 3.5 }) or {}
		ask(p, "resetCooldown")
		place(p, tile(2, 2, 3), crate)
		task.wait(0.4)
		ask(p, "fire")
		task.wait(1.3)
		local t = ask(p, "trace")
		local set = {}
		for _, e in (t and t.trace) or {} do
			set[e[3]] = true
		end
		local hits = 0
		for _, id in segs do
			if set[id] then
				hits += 1
			end
		end
				check("room behind a wall is not revealed", #segs > 0 and hits == 0, "segs=" .. #segs .. " hits=" .. hits)
	end

	-- 6. 서버의 발사 간격 검증
	task.wait(1.6)
	local Main = _G.SonarMaze
	local before = Main.Sonar.accepted[p] or 0
	ask(p, "rawFire")
	task.wait(0.15)
	ask(p, "rawFire")
	task.wait(0.15)
	ask(p, "rawFire")
	task.wait(1.0) -- (서버에 도착할 여유. 첫 발사 후 1.3초: 아직 간격 안)
	local mid1 = Main.Sonar.accepted[p] or 0
	task.wait(0.5)
	ask(p, "rawFire")
	task.wait(1.0)
	local mid2 = Main.Sonar.accepted[p] or 0
	check("server enforces the 1.5s pulse interval", mid1 - before == 1 and mid2 - mid1 == 1, string.format("burst accepted %d, after 1.8s %d", mid1 - before, mid2 - mid1))

	-- 13. 반복 발사해도 쌓이지 않는다
	task.wait(2.5)
	local function burst()
		for _ = 1, 12 do
			ask(p, "pulseAt", root(p).Position + Vector3.new(0, 1.5, 0))
			task.wait(0.25)
		end
	end
	burst()
	local s1 = ask(p, "stats")
	task.wait(Config.Sonar.Hold + 1)
	local s1b = ask(p, "stats")
	waitFor(function() s1b = ask(p, "stats") return s1b and s1b.lines.active == 0 end, 5) -- (Studio 창이 뒤에 있으면 선이 늦게 꺼진다)
	burst()
	local s2 = ask(p, "stats")
	task.wait(Config.Sonar.Hold + 1)
	local s3 = ask(p, "stats")
	waitFor(function() s3 = ask(p, "stats") return s3 and s3.lines.active == 0 end, 5)
	log(string.format("burst lines: active %d created %d / after %d / burst2 active %d created %d / after %d", s1.lines.active, s1.lines.created, s1b.lines.active, s2.lines.active, s2.lines.created, s3.lines.active))
	check("repeated pulses reuse lines (no pile-up)", s2.lines.created <= s1.lines.created * 1.15 + 20 and s2.lines.active < Config.Sonar.PoolSize, string.format("created %d -> %d, active %d", s1.lines.created, s2.lines.created, s2.lines.active))
	check("all lines released after the burst", s1b.lines.active == 0 and s3.lines.active == 0, s3.lines.active)

	-- 7. 걷기·달리기·웅크리기
	local speeds = {}
	for _, m in { "Run", "Crouch", "Walk" } do
		ask(p, "setMode", m)
		task.wait(0.5)
		local s = ask(p, "stats")
		local hum = p.Character:FindFirstChildOfClass("Humanoid")
		speeds[m] = { s and s.walkSpeed, p.Character:GetAttribute("MoveMode"), hum.WalkSpeed }
	end
	ask(p, "setMode", nil)
	check("run speed 18 (client+server)", speeds.Run[1] == 18 and speeds.Run[2] == "Run" and speeds.Run[3] == 18, table.concat({ tostring(speeds.Run[1]), tostring(speeds.Run[2]) }, " "))
	check("crouch speed 5", speeds.Crouch[1] == 5 and speeds.Crouch[2] == "Crouch", tostring(speeds.Crouch[1]))
	check("walk speed 10", speeds.Walk[1] == 10 and speeds.Walk[2] == "Walk", tostring(speeds.Walk[1]))
	-- 실제로 걸어서 발소리 소음이 나는가(서버가 속도로 판정)
	place(p, tile(2, 6, 3), tile(2, 8, 3))
	task.wait(0.3)
	local n0 = #SoundBus.recent
	ask(p, "setMode", "Run")
	ask(p, "move", tile(2, 8, 3))
	task.wait(1.0)
	local kinds = {}
	for i = n0 + 1, #SoundBus.recent do
		kinds[SoundBus.recent[i].kind] = true
	end
	ask(p, "setMode", nil)
	check("running makes loud footstep noise (server-measured)", kinds.StepRun == true, (function()
		local t = {}
		for k in kinds do
			table.insert(t, k)
		end
		return table.concat(t, ",")
	end)())

	-- 발소리는 한 발짝씩: 걷기(10/초)로 16스터드 → 약 3발(파일 하나에 여러 발짝이 들어 있어 잘라서 한 발만)
	place(p, tile(2, 6, 3), tile(2, 8, 3))
	task.wait(0.4)
	local st0 = ask(p, "stats")
	ask(p, "move", tile(2, 8, 3))
	task.wait(2.2)
	local st1 = ask(p, "stats")
	local steps = (st1 and st0) and (st1.steps - st0.steps) or -1
	check("footsteps: about one sound per step while walking (~2 per second)", steps >= 2 and steps <= 5, steps)

	-- 실제 녹음 소리가 이 게임에서 불러와진다(라이선스 효과음)
	local sc = ask(p, "soundCheck")
	local zero = 0
	for _, l in (sc and sc.lengths) or {} do
		if l <= 0 then
			zero += 1
		end
	end
	check("licensed sounds load (screams + monster steps)", sc and #sc.bad == 0 and zero == 0, sc and (table.concat(sc.bad, ", ") .. " lengths " .. table.concat(sc.lengths, "/")))

	-- 점프: 뛰어오르고, 착지 소리를 괴물이 들을 수 있다
	do
		place(p, tile(2, 6, 3), tile(2, 8, 3))
		task.wait(0.6)
		local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local y0 = r and r.Position.Y or 0
		local n0 = #SoundBus.recent
		ask(p, "jump")
		local peak = y0
		local t0 = os.clock()
		while os.clock() - t0 < 1.4 do
			if r then
				peak = math.max(peak, r.Position.Y)
			end
			task.wait()
		end
		local landed = false
		for i = n0 + 1, #SoundBus.recent do
			if SoundBus.recent[i].kind == "StepLand" then
				landed = true
			end
		end
		check("players can jump", peak - y0 > 1.5, string.format("%.1f studs", peak - y0))
		check("landing makes a noise monsters can hear", landed)
	end

	-- 소리 감쇠
	local a, b = tile(2, 3, 3), tile(2, 5, 3) -- 시작 방과 그 아래(벽 사이)
	local walls = SoundBus.wallsBetween(a, b)
	check("sound attenuation counts walls between", walls >= 1, walls)
	check("hearing ranges: crouch 4 < walk 10 < run 25 < sonar 45", Config.Noise.Crouch == 4 and Config.Noise.Walk == 10 and Config.Noise.Run == 25 and Config.Noise.Sonar == 45)

	-- 8~9. 괴물: 소리 감지 → 이동(벽 통과 없음)
	local m = Round.monsters[1]
	check("monster exists", m ~= nil)
	if not m then
		return
	end
	-- 플레이어는 멀리(출구 쪽 반대 구석)
	place(p, tile(2, 3, 3))
	local geo = stage:FindFirstChild("Geometry")
	local wallParams = RaycastParams.new()
	wallParams.FilterType = Enum.RaycastFilterType.Include
	wallParams.FilterDescendantsInstances = { geo }
	wallParams.RespectCanCollide = true
	local startNode = tile(10, 16, 5.2)
	local soundAt = tile(15, 16, 4.5)
	m.model:PivotTo(CFrame.new(startNode))
	m.waypoints = {}
	m:setState("Wander")
	m.startAt = 0
	task.wait(0.5)
	-- (큰 맵에서는 경로 계산이 길어 순간이동 전에 시작한 계산이 끝나며 움직일 수 있다: 한 번 더 제자리에 세운다)
	m.model:PivotTo(CFrame.new(startNode))
	m.waypoints = {}
	m.legGoal = nil
	m.hum:MoveTo(startNode)
	SoundBus.emit(soundAt, Config.Noise.Sonar, nil, "Sonar")
	local heard = waitFor(function()
		return m.state == "Alert" or m.state == "Investigate"
	end, 2)
	check("monster reacts to a sonar pulse 40 studs away", heard ~= nil, m.state)
	local prev = m.root.Position
	local through = 0
	local maxStep = 0
	local reached = waitFor(function()
		local cur = m.root.Position
		local d = cur - prev
		if d.Magnitude > 0.05 then
			maxStep = math.max(maxStep, d.Magnitude)
			local hit = workspace:Raycast(prev, d, wallParams)
			if hit then
				through += 1
			end
		end
		prev = cur
		return (cur - soundAt).Magnitude < 7 or m.state == "Search"
	end, 25)
	check("monster walks to the sound position", reached ~= nil, string.format("dist=%.1f state=%s", (m.root.Position - soundAt).Magnitude, m.state))
	check("monster never passes through walls", through == 0, "crossings=" .. through .. " maxStep=" .. string.format("%.2f", maxStep))
	-- 수색 → 배회 복귀
	local searching = waitFor(function()
		return m.state == "Search"
	end, 5)
	check("monster searches around the sound", searching ~= nil, m.state)
	R.info.monsterLog = m.log

	-- 걷는 소리는 가까이에서만 들린다
	m:setState("Wander")
	m.waypoints = {}
	local mp = m.root.Position
	local far = mp + Vector3.new(30, 0, 0)
	check("monster does not hear walking 30 studs away", not SoundBus.canHear(far, mp, Config.Noise.Walk))

	-- 큰 맵: 멀리 돌아가야 하는 곳도 타일 경로를 구간으로 나눠 실제로 찾아간다
	do
		local goal = Round.info.exitCFrame.Position - Vector3.new(0, 3.5, 0)
		local startN, startLen = nil, 0
		for _, n in Round.info.nodes do
			local r = Round.info.route(n - Vector3.new(0, 3, 0), goal, true)
			if r and #r >= 30 and #r <= 60 and (n - goal).Magnitude < #r * 8 * 0.6 then
				startN, startLen = n, #r
				break
			end
		end
		if startN then
			m.model:PivotTo(CFrame.new(startN + Vector3.new(0, 2.2, 0)))
			m.waypoints = {}
			m.legGoal = nil
			m:setState("Investigate")
			m.goal = goal
			m.searchCenter = goal
			task.wait(20) -- (조사 속도 5.5: 20초면 약 13칸)
			local r = Round.info.route(m.root.Position - Vector3.new(0, 4.5, 0), goal, true)
			local left = if r then #r else startLen
			check("monster follows a long winding route (route legs)", left <= startLen - 8, string.format("route %d -> %d tiles, state %s", startLen, left, m.state))
		else
			check("monster follows a long winding route (route legs)", false, "no suitable start node")
		end
		m.waypoints = {}
		m.legGoal = nil
		m:setState("Wander")
	end

	-- 12. 열쇠: 상자·서랍 중 한 곳에 있고, 없으면 출구가 잠겨 있다
	m.startAt = 1e9
	m:setState("Wander")
	Config.Key.Required = true
	local spotsZ = Search.all()
	check("searchable boxes/drawers built", #spotsZ >= 5, #spotsZ)
	local ks, ki = Search.keySpot()
	check("exactly one of them holds the key", ks ~= nil and ki ~= nil)
	place(p, Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
	task.wait(1.2)
	check("exit is locked without the key", p:GetAttribute("Status") == "Alive" and ReplicatedStorage:GetAttribute("HasKey") ~= true, p:GetAttribute("Status"))
	local kh0 = ask(p, "keyHud")
	check("key indicator shows no key", kh0 and kh0.visible and kh0.text:find("0/", 1, true) ~= nil, kh0 and kh0.text)
	local empty = nil
	for _, sp in spotsZ do
		if not sp.hasKey then
			empty = sp
			break
		end
	end
	if empty then
		place(p, empty.front + Vector3.new(0, 3, 0), empty.center + Vector3.new(0, 3, 0))
		task.wait(0.3)
		-- 서랍(뚜껑)마다 따로 열고 닫는다: 처음 열면 뒤짐(비어 있음), 닫고 다시 열 수 있다
		local r1 = Search.toggle(p, empty, 1)
		local r2 = Search.toggle(p, empty, 1)
		local r3 = Search.toggle(p, empty, 1)
		check("a drawer opens (empty), closes, and opens again", r1 == "empty" and r2 == "closed" and r3 == "opened", r1 .. "/" .. r2 .. "/" .. r3)
		local allOpen = true
		for i = 2, #empty.comps do
			Search.toggle(p, empty, i)
		end
		for _, c in empty.comps do
			allOpen = allOpen and c.open
		end
		check("every drawer of a cabinet can be opened", allOpen, #empty.comps)
		local fwd = (empty.front - empty.center).Unit
		local c1 = empty.comps[1]
		local moved = c1.model:GetPivot().Position - c1.closedPivot.Position
		check("an opened drawer/lid moves toward the player, not sideways", (moved:Dot(fwd) > 0.4 or moved.Y > 0.4) and math.abs(moved:Dot(Vector3.new(fwd.Z, 0, -fwd.X))) < 0.2, string.format("fwd %.2f side %.2f up %.2f", moved:Dot(fwd), moved:Dot(Vector3.new(fwd.Z, 0, -fwd.X)), moved.Y))
		for i = 1, #empty.comps do
			Search.toggle(p, empty, i)
		end
		local allClosed = true
		for _, c in empty.comps do
			allClosed = allClosed and not c.open
		end
		check("every drawer closes again", allClosed)
		-- 조준점으로 보고 E(클라이언트 경로)
		local c1pos = c1.model:GetPivot().Position
		place(p, c1pos + fwd * 3.2 + Vector3.new(0, 1.2, 0), c1pos)
		task.wait(0.6)
		local tgt = ask(p, "lookTarget", c1pos)
		check("crosshair on a drawer targets it", tgt ~= nil and tgt.spot == empty.id, tgt and (tgt.spot .. ":" .. tgt.comp))
		local wasOpen = tgt and empty.comps[tgt.comp].open
		ask(p, "useLook", c1pos)
		local toggled = waitFor(function()
			return tgt and empty.comps[tgt.comp].open ~= wasOpen
		end, 3)
		check("E while looking opens/closes that drawer", toggled ~= nil)
	end
	if ks and ki then
		place(p, ks.front + Vector3.new(0, 3, 0))
		task.wait(0.3)
		local r3 = Search.toggle(p, ks, ki)
		check("searching the right one finds the key (whole team)", r3 == "key" and ReplicatedStorage:GetAttribute("HasKey") == true, r3)
		task.wait(0.4)
		local kh1 = ask(p, "keyHud")
		check("key indicator shows the key", kh1 and kh1.text:find("출구로", 1, true) ~= nil, kh1 and kh1.text)
	end

	-- 13. 출구 → 탈출 → STAGE CLEAR
	place(p, Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
	local esc = waitFor(function()
		return p:GetAttribute("Status") == "Escaped"
	end, 3)
	check("reaching the exit escapes", esc ~= nil, p:GetAttribute("Status"))
	Config.Key.Required = false
	local cleared = waitFor(function()
		return Round.lastOutcome == "Clear"
	end, 4)
	check("stage clear when all survivors escaped", cleared ~= nil, Round.lastOutcome)
	check("clear advances to the next stage", Round.stageIndex == 2 or (Round.stageIndex == 1 and #Config.Stages >= 1), Round.stageIndex)
	Round.stageIndex = 1 -- (사망 시험은 스테이지 1 좌표로)
	task.wait(0.8)
	local ui = ask(p, "stats")
	check("STAGE CLEAR screen shown", ui and ui.ui.overlayTitle == "STAGE CLEAR", ui and ui.ui.overlayTitle)

	-- 10. 다음 라운드에서 잡히기 → 사망 → (혼자) 재시작
	Round.lastOutcome = ""
	local again = readyPlayers(1)
	check("next round starts and player respawns", again ~= nil, ReplicatedStorage:GetAttribute("StageName"))
	if not again then
		return
	end
	local m2 = Round.monsters[1]
	-- 직선 통로에서 12스터드 떨어져 마주 본다
	place(p, tile(3, 10, 3), tile(6, 10, 3))
	m2.model:PivotTo(CFrame.lookAt(tile(5, 10, 5.2) - Vector3.new(4, 0, 0), tile(3, 10, 5.2)))
	m2.waypoints = {}
	m2.startAt = 0
	local chased = waitFor(function()
		return m2.state == "Chase"
	end, 3)
	check("monster spots a nearby player and chases", chased ~= nil, m2.state)
	local died = waitFor(function()
		return p:GetAttribute("Status") == "Dead"
	end, 8)
	check("caught by the monster -> death", died ~= nil, p:GetAttribute("Status"))
	local js = waitFor(function()
		local x = ask(p, "jumpscare")
		return x and x.count > 0 and x
	end, 2)
	check("jump scare: the monster face pops up when caught", js ~= nil, js and js.count)
	task.wait(1.8)
	local dui = ask(p, "stats")
	check("YOU DIED screen shown", dui and dui.ui.overlayTitle == "YOU DIED", dui and dui.ui.overlayTitle)
	local failed = waitFor(function()
		return Round.lastOutcome == "Failed"
	end, 4)
	check("solo death restarts the stage", failed ~= nil, Round.lastOutcome)
	local back = readyPlayers(1)
	check("respawned after restart", back ~= nil)
	local fs = ask(p, "stats")
	R.info.frame = fs and { avg = fs.avgFrame, worst = fs.worstFrame }
	if back then
		doorTests(p)
		monsterTests(p)
		hideTests(p)
	end
end

-- ─────────────────────────────── multi ───────────────────────────────
local function multi()
	local want = tonumber(args.Players) or 2
	local ps = readyPlayers(want)
	check("all " .. want .. " players spawned with sonar ready", ps ~= nil, #Players:GetPlayers())
	if not ps then
		return
	end
	-- 모두 시작 방 근처에 모은다
	for k, p in ps do
		place(p, tile(2 + (k - 1) % 3, 2 + (k - 1) // 3 * 2, 3))
	end
	task.wait(1)
	local base = {}
	for _, p in ps do
		base[p] = ask(p, "stats").pulsesStarted
		ask(p, "resetPerf")
	end
	local rounds = 6
	for _ = 1, rounds do
		for _, p in ps do
			task.spawn(ask, p, "fire")
		end
		task.wait(1.7)
	end
	task.wait(Config.Sonar.Hold + 1)
	local worst, sumAvg = 0, 0
	local luaAvg, luaWorst = 0, 0
	local at60 = 0
	for _, p in ps do
		local s = ask(p, "stats")
		local got = s.pulsesStarted - base[p]
		check(p.Name .. " saw own + others' pulses", got >= rounds * #ps * 0.9, got .. "/" .. rounds * #ps)
		check(p.Name .. " lines released afterwards", s.lines.active == 0, s.lines.active)
		worst = math.max(worst, s.worstFrame)
		sumAvg += s.avgFrame
		luaAvg += s.lua.avg
		luaWorst = math.max(luaWorst, s.lua.worst)
		-- 60fps 기준 추정: 파동 전파는 경과 시간만큼 일하므로 프레임 시간 비율로 줄이고, 선 갱신은 프레임마다 그대로
		at60 += s.prof.pulsesMs * math.min(1, (1 / 60) / math.max(s.avgFrame, 1e-3)) + s.prof.linesMs
		R.info[p.Name] = { avgFrame = s.avgFrame, worstFrame = s.worstFrame, created = s.lines.created }
	end
	-- (Studio 테스트 창은 모두 비활성 창이라 15fps 로 묶인다: 화면 프레임 대신 음파 스크립트 비용을 본다)
	-- (Studio 비활성 창은 약 15fps: 한 프레임에 60fps 네 프레임 분량의 파동을 처리하므로 60fps 기준으로 환산해 본다)
	check("sonar script cost with " .. #ps .. " players pulsing together < 4ms/frame at 60fps", at60 / #ps < 4, string.format("~%.2fms at 60fps (measured %.2fms avg, worst %.2fms, at %.1fms frames)", at60 / #ps, luaAvg / #ps * 1000, luaWorst * 1000, sumAvg / #ps * 1000))
	-- 한 명이 죽으면 관전, 나머지는 계속
	local victim = ps[1]
	Round.kill(victim, "test")
	task.wait(3)
	local s = ask(victim, "stats")
	check("dead player spectates a teammate", s and s.ui.spectate ~= nil and s.ui.spectate:find("관전 중") ~= nil, s and s.ui.spectate)
	check("round continues while others live", Round.state == "Playing")
	-- 남은 사람 탈출 → 클리어
	for k = 2, #ps do
		place(ps[k], Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
		task.wait(0.4)
	end
	local cleared = waitFor(function()
		return Round.lastOutcome == "Clear"
	end, 5)
	check("survivors escape -> stage clear (with one dead)", cleared ~= nil, Round.lastOutcome)
end

-- ─────────────────────────────── perf ───────────────────────────────
local function perf()
	local ps = readyPlayers(tonumber(args.Players) or 1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	place(p, tile(3, 3, 3), tile(3, 6, 3))
	task.wait(2)
	ask(p, "resetPerf")
	task.wait(3)
	local idle = ask(p, "stats")
	ask(p, "resetPerf")
	for _ = 1, 4 do
		for _, q in ps do
			ask(q, "resetCooldown")
			task.spawn(ask, q, "fire")
		end
		task.wait(1.55)
	end
	local busy = ask(p, "stats")
	R.info.perf = {
		idleFrameMs = idle.avgFrame * 1000, idleWorstMs = idle.worstFrame * 1000, idleLuaMs = idle.lua.avg * 1000,
		busyFrameMs = busy.avgFrame * 1000, busyWorstMs = busy.worstFrame * 1000, busyLuaMs = busy.lua.avg * 1000, busyLuaWorstMs = busy.lua.worst * 1000,
		lines = busy.lines,
	}
	check("sonar script cost per frame (avg) < 4ms", busy.lua.avg < 0.004, string.format("%.2fms avg, %.2fms worst", busy.lua.avg * 1000, busy.lua.worst * 1000))
end

-- ─────────────────────────────── load ───────────────────────────────
-- 스테이지마다: 서버 빌드 시간, 클라이언트 음파 월드 빌드 시간, 괴물이 움직이는 20초 동안 서버 프레임·경로 계산·클라이언트 음파 비용
local Monster = require(script.Parent.Monster)
local function load()
	local ps = readyPlayers(1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	local all = {}
	for i = 1, #Config.Stages do
		Round.startStage(i)
		local t0 = os.clock()
		readyPlayers(1)
		local built = waitFor(function()
			local st = ask(p, "stats")
			return st and st.buildId == stageFolder():GetAttribute("BuildId") and st.build.seconds > 0 and st
		end, 30)
		local readyIn = os.clock() - t0
		-- 몬스터가 움직이는 동안(플레이어는 시작 방, 음파를 주기적으로)
		local hb = {}
		local conn = RunService.Heartbeat:Connect(function(dt)
			table.insert(hb, dt)
		end)
		local s0 = { calls = Monster.stats.pathCalls, wall = Monster.stats.pathWall, ticks = Monster.stats.ticks }
		ask(p, "resetPerf")
		local mpos0 = {}
		for k, m in Round.monsters do
			mpos0[k] = m.root.Position
			m.startAt = 0 -- (테스트는 괴물을 멈춰 두므로 여기서는 실제처럼 움직이게)
			m.lastHunt = os.clock() - Config.Monster.HuntEvery + 5
		end
		for _, d in Round.doppels do
			d.startAt = 0 -- (도플갱어도 사람 모습으로 돌아다니게)
		end
		for _ = 1, 10 do
			ask(p, "resetCooldown")
			ask(p, "fire")
			task.wait(2)
		end
		conn:Disconnect()
		local st = ask(p, "stats")
		local sum, worst = 0, 0
		for _, d in hb do
			sum += d
			worst = math.max(worst, d)
		end
		local calls = Monster.stats.pathCalls - s0.calls
		local moved, states = {}, {}
		for k, m in Round.monsters do
			table.insert(moved, math.floor((m.root.Position - (mpos0[k] or m.root.Position)).Magnitude))
			table.insert(states, m.state .. (if m.startAt > os.clock() then "(waiting)" else ""))
		end
		local r = {
			stage = i,
			serverBuildMs = math.floor(Round.lastBuildMs),
			readySec = math.floor(readyIn * 10) / 10,
			clientBuildSec = built and math.floor(built.build.seconds * 100) / 100,
			clientBuildCpuSec = built and math.floor(built.build.cpu * 100) / 100,
			segs = built and built.build.segs,
			serverFrameMs = math.floor(sum / math.max(1, #hb) * 10000) / 10,
			serverWorstMs = math.floor(worst * 10000) / 10,
			pathCallsPerSec = math.floor(calls / 20 * 10) / 10,
			pathAvgMs = if calls > 0 then math.floor((Monster.stats.pathWall - s0.wall) / calls * 10000) / 10 else 0,
			clientLuaMs = st and math.floor(st.lua.avg * 100000) / 100,
			clientLuaWorstMs = st and math.floor(st.lua.worst * 100000) / 100,
			pulsesMs = st and math.floor(st.prof.pulsesMs * 100) / 100,
			linesMs = st and math.floor(st.prof.linesMs * 100) / 100,
			alive = p:GetAttribute("Status"),
			ticksPerSec = math.floor((Monster.stats.ticks - s0.ticks) / 20),
			monsterMoved = table.concat(moved, ","),
			monsterStates = table.concat(states, ","),
			monsterLog = Round.monsters[1] and table.concat(Round.monsters[1].log, " | "):sub(-300) or "",
		}
		table.insert(all, r)
		log(HttpService:JSONEncode(r))
		check(string.format("stage %d: client sonar world ready", i), built ~= nil, r.clientBuildSec)
	end
	R.info.load = all
end

-- ─────────────────────────────── aibench (괴물 AI·몸 움직임 비용) ───────────────────────────────
-- env STAGE=n(없으면 6~10). 챕터마다 두 구간을 잰다:
--   wander: 플레이어는 시작 방(안전 구역), 괴물은 배회·사냥 / chase: 3초마다 플레이어를 괴물 10~18스터드 앞 배회 지점으로 옮긴다(추격·문·계단)
-- 서버: 괴물 tick CPU(경로 계산 대기 제외), 경로 계산 수·평균, 프레임마다 잡기·animate, 시야 레이 수, 서버 Heartbeat 시간
-- 클라이언트: MonsterAnim(Perf "monsterAnim") 프레임당 ms, 프레임 시간. 잡혀도 측정이 끊기지 않게 onCatch 는 세기만 한다
local function aibench()
	local Stats = game:GetService("Stats")
	local function r2(v)
		return math.floor((v or 0) * 100 + 0.5) / 100
	end
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local only = tonumber(args.Stage) or 0
	local secs = if args.Quick then 10 else 20
	local acc = { tick = 0, ticks = 0, catch = 0, anim = 0, hbN = 0, los = 0, hbMs = 0 }
	local origTick, origCatch, origAnim, origLos = Monster.tick, Monster.checkCatch, Monster.animate, Monster.lineOfSight
	Monster.tick = function(self)
		local t = os.clock()
		local w0 = Monster.stats.pathWall
		origTick(self)
		acc.tick += (os.clock() - t) - (Monster.stats.pathWall - w0)
		acc.ticks += 1
	end
	Monster.checkCatch = function(self)
		local t = os.clock()
		origCatch(self)
		acc.catch += os.clock() - t
	end
	Monster.animate = function(self, dt)
		local t = os.clock()
		origAnim(self, dt)
		acc.anim += os.clock() - t
	end
	Monster.lineOfSight = function(self, pos)
		acc.los += 1
		return origLos(self, pos)
	end
	local hbConn = RunService.Heartbeat:Connect(function()
		acc.hbN += 1
		acc.hbMs += Stats.HeartbeatTimeMs
	end)
	local rows = {}
	for i = 6, #Config.Stages do
		if only > 0 and i ~= only then
			continue
		end
		Round.startStage(i)
		task.wait(1)
		ps = readyPlayers(1)
		if not ps then
			check("stage " .. i .. " ready", false)
			continue
		end
		local all = {}
		local catches = 0
		for _, list in { Round.monsters, Round.doppels, Round.flowers } do
			for _, m in list do
				m.startAt = 0
				m.onCatch = function()
					catches += 1
				end
				table.insert(all, m)
			end
		end
		local function phase(name, chase)
			if not chase then
				place(p, Round.info.spawns[1].Position)
			end
			task.wait(2)
			for k in acc do
				acc[k] = 0
			end
			catches = 0
			local s0 = { calls = Monster.stats.pathCalls, wall = Monster.stats.pathWall }
			local pos0, stuck0 = {}, {}
			for k, m in all do
				pos0[k] = m.root.Position
				stuck0[k] = 0
				m.log = {}
			end
			ask(p, "perfx", "reset")
			local t0 = os.clock()
			local chases, moved = 0, 0
			local lastMove = 0
			local travel = {}
			for k in all do
				travel[k] = 0
			end
			local prev = table.clone(pos0)
			while os.clock() - t0 < secs do
				if chase and os.clock() - lastMove >= 3 then
					lastMove = os.clock()
					-- 한 괴물(돌아가며) 앞 10~18스터드의 배회 지점(같은 층)으로
					local m = all[(moved % #all) + 1]
					moved += 1
					if m and m.root then
						local mp = m.root.Position
						for _, n in Round.info.nodes do
							local d = (n - mp).Magnitude
							if d > 10 and d < 18 and math.abs(n.Y - mp.Y) < 4 and not Round.inSafe(n) then
								place(p, n + Vector3.new(0, 0.5, 0))
								break
							end
						end
					end
				end
				task.wait(0.5)
				for k, m in all do
					if m.state == "Chase" then
						chases += 1
					end
					travel[k] += (m.root.Position - prev[k]).Magnitude
					prev[k] = m.root.Position
				end
			end
			local dur = os.clock() - t0
			local x = ask(p, "perfx", "reset") or {}
			local sys = x.sys or {}
			local ma = sys.monsterAnim or {}
			local calls = Monster.stats.pathCalls - s0.calls
			local stuckN, trav, states = 0, {}, {}
			for k, m in all do
				for _, l in m.log do
					if l:find("stuck") then
						stuckN += 1
					end
				end
				table.insert(trav, math.floor(travel[k]))
				table.insert(states, m.state)
			end
			local row = {
				stage = i,
				phase = name,
				monsters = #all,
				tickMsPerSec = r2(acc.tick / dur * 1000),
				tickAvgUs = r2(acc.tick / math.max(1, acc.ticks) * 1e6),
				ticksPerSec = r2(acc.ticks / dur),
				pathPerSec = r2(calls / dur),
				pathAvgMs = if calls > 0 then r2((Monster.stats.pathWall - s0.wall) / calls * 1000) else 0,
				catchUsPerFrame = r2(acc.catch / math.max(1, acc.hbN) * 1e6),
				animUsPerFrame = r2(acc.anim / math.max(1, acc.hbN) * 1e6),
				losPerSec = r2(acc.los / dur),
				serverHbMs = r2(acc.hbMs / math.max(1, acc.hbN)),
				clientAnimMsPerFrame = math.floor((ma.perFrameMs or 0) * 1000 + 0.5) / 1000,
				clientAnimWorstMs = r2(ma.worstMs or 0),
				clientFrameMs = r2(x.avgMs),
				clientP99Ms = r2(x.p99Ms),
				chaseSamples = chases,
				stuckEvents = stuckN,
				catches = catches,
				travel = table.concat(trav, ","),
				states = table.concat(states, ","),
			}
			table.insert(rows, row)
			log(HttpService:JSONEncode(row))
		end
		phase("wander", false)
		phase("chase", true)
	end
	hbConn:Disconnect()
	Monster.tick, Monster.checkCatch, Monster.animate, Monster.lineOfSight = origTick, origCatch, origAnim, origLos
	check("aibench rows", #rows > 0, #rows)
	R.info.aibench = rows
end

-- ─────────────────────────────── lobby (2인) ───────────────────────────────
-- 로비에서 시작 → 음파로 로비가 보인다 → P1 방 만들기(버튼) → P2 참가(버튼)·나가기·재참가 → 방장만 시작 →
-- 두 사람 모두 1스테이지 → 함께 탈출해 2스테이지 → 마지막 스테이지를 깨면 로비로 돌아온다
local function lobbyTest()
	local LobbyMod = require(script.Parent.Lobby)
	local want = tonumber(args.Players) or 2
	local ps = waitFor(function()
		local all = Players:GetPlayers()
		if #all < want or Round.state ~= "Lobby" then
			return nil
		end
		for _, q in all do
			if q:GetAttribute("Status") ~= "Alive" or not (q.Character and q.Character:FindFirstChild("HumanoidRootPart")) then
				return nil
			end
		end
		return all
	end, 60)
	check("server starts in the lobby with everyone inside", ps ~= nil, Round.state .. " " .. #Players:GetPlayers())
	if not ps then
		return
	end
	local p1, p2 = ps[1], ps[2]
	local function built(p)
		return waitFor(function()
			local st = ask(p, "stats")
			return st and st.buildId == stageFolder():GetAttribute("BuildId") and st.build.segs > 0 and st
		end, 25)
	end
	local b1, b2 = built(p1), built(p2)
	check("both clients see the lobby through sonar (outlines built)", b1 ~= nil and b2 ~= nil and b1.build.segs > 100, b1 and b1.build.segs)
	check("no monsters in the lobby", #Round.monsters == 0, #Round.monsters)
	task.wait(0.5)
	ask(p1, "resetCooldown")
	ask(p1, "fire")
	task.wait(1.2)
	local lit = ask(p1, "stats")
	check("sonar lights up the lobby", lit and lit.lines.lit > 50, lit and lit.lines.lit)
	-- 작은 로비: 음파 한 번으로 방 거의 전부(벽 아닌 칸의 90% 이상)가 닿아야 한다(지도에 기록된 칸으로 잰다)
	do
		local rows = string.split(stageFolder():GetAttribute("Rows"), "/")
		local open = 0
		for _, row in rows do
			for k = 1, #row do
				if string.sub(row, k, k) ~= "#" then
					open += 1
				end
			end
		end
		local mp = nil
		waitFor(function()
			mp = ask(p1, "map")
			return mp ~= nil and mp.explored >= open * 0.9
		end, 6)
		check("one sonar pulse shows almost the whole lobby (>= 90% of tiles)", mp ~= nil and mp.explored >= open * 0.9, string.format("%s/%d tiles", tostring(mp and mp.explored), open))
	end
	local u = ask(p1, "lobby")
	check("room panel shown in the lobby", u and u.visible and table.find(u.buttons, "방 만들기") ~= nil, u and table.concat(u.buttons, ","))
	local c0 = ask(p1, "cursor")
	check("cursor hidden while looking around", c0 == false, tostring(c0))
	local m = ask(p1, "lobbyMenu", true)
	check("Tab menu frees the mouse", m and m.mouseFree == true)
	task.wait(0.2)
	local c1 = ask(p1, "cursor")
	check("cursor shown only while the menu is open", c1 == true, tostring(c1))
	ask(p1, "lobbyClick", "방 만들기")
	local id = waitFor(function()
		return p1:GetAttribute("RoomId")
	end, 5)
	check("P1 creates a room (button)", id ~= nil, tostring(id))
	local joinText = "참가 " .. tostring(id)
	-- 친구만: 방장이 켜면 친구가 아닌 P2 는 못 들어오고, 끄면 들어온다
	ask(p1, "lobbyClick", "친구만 켜기")
	waitFor(function()
		local x = ask(p1, "lobby")
		return x and table.find(x.buttons, "친구만 끄기") ~= nil
	end, 5)
	waitFor(function()
		local x = ask(p2, "lobby")
		return x and table.find(x.buttons, joinText) ~= nil
	end, 5)
	ask(p2, "lobbyClick", joinText)
	task.wait(1)
	local fm = ask(p2, "lobby")
	check("friends-only room keeps non-friends out", p2:GetAttribute("RoomId") == nil and fm and fm.message:find("친구", 1, true) ~= nil, fm and fm.message)
	ask(p1, "lobbyClick", "친구만 끄기")
	waitFor(function()
		local x = ask(p1, "lobby")
		return x and table.find(x.buttons, "친구만 켜기") ~= nil
	end, 5)
	local inv = ask(p1, "lobby")
	check("invite-friends button in the lobby", inv and table.find(inv.buttons, "친구 초대") ~= nil, inv and table.concat(inv.buttons, ","))
	local seen = waitFor(function()
		local x = ask(p2, "lobby")
		return x and x.rooms == 1 and table.find(x.buttons, joinText) ~= nil and x
	end, 5)
	check("P2 sees the room with a join button", seen ~= nil, seen and table.concat(seen.buttons, ","))
	ask(p2, "lobbyClick", joinText)
	check("P2 joins the room (button)", waitFor(function()
		return p2:GetAttribute("RoomId") == id
	end, 5) ~= nil)
	local u1 = waitFor(function()
		local x = ask(p1, "lobby")
		return x and x.title:find(p2.DisplayName, 1, true) and x
	end, 5)
	check("P1 sees P2 in the room", u1 ~= nil, u1 and u1.title)
	local u2 = ask(p2, "lobby")
	check("only the host has a start button", u1 and table.find(u1.buttons, "시작") ~= nil and u2 and table.find(u2.buttons, "시작") == nil, u2 and table.concat(u2.buttons, ","))
	ask(p2, "lobbyClick", "나가기")
	check("P2 can leave the room", waitFor(function()
		return p2:GetAttribute("RoomId") == nil
	end, 5) ~= nil)
	waitFor(function()
		local x = ask(p2, "lobby")
		return x and table.find(x.buttons, joinText) ~= nil
	end, 5)
	ask(p2, "lobbyClick", joinText)
	check("P2 joins again", waitFor(function()
		return p2:GetAttribute("RoomId") == id
	end, 5) ~= nil)
	LobbyMod.act(p2, "start")
	task.wait(0.8)
	check("a non-host cannot start", Round.state == "Lobby", Round.state)
	-- 방장이 시작
	task.wait(0.5)
	ask(p1, "lobbyClick", "시작")
	local started = waitFor(function()
		return Round.state == "Playing" and Round.stageIndex == 1
	end, 20)
	check("host presses start: stage 1 begins", started ~= nil, Round.state)
	local both = waitFor(function()
		for _, q in { p1, p2 } do
			if q:GetAttribute("Status") ~= "Alive" or not (q.Character and q.Character:FindFirstChild("HumanoidRootPart")) then
				return nil
			end
		end
		return true
	end, 15)
	check("both players are in stage 1", both ~= nil, tostring(p1:GetAttribute("Status")) .. "/" .. tostring(p2:GetAttribute("Status")))
	check("stage 1 has its monsters", #Round.monsters == Config.Stages[1].Monsters, #Round.monsters)
	local g1, g2 = built(p1), built(p2)
	check("both clients rebuilt sonar for stage 1", g1 ~= nil and g2 ~= nil and g1.build.segs > 20000, g1 and g1.build.segs)
	local lu = ask(p1, "lobby")
	check("room panel hidden during the game", lu and not lu.visible)
	task.wait(0.5)
	ask(p2, "resetCooldown")
	ask(p2, "fire")
	task.wait(1.2)
	local lit2 = ask(p2, "stats")
	check("P2's sonar works in the game", lit2 and lit2.lines.lit > 50, lit2 and lit2.lines.lit)
	-- 팀원은 음파 없이도 실제 아바타 윤곽선으로 보인다
	local mt1 = waitFor(function()
		local n = ask(p1, "mates")
		return n == 1 and n
	end, 5)
	local mt2 = ask(p2, "mates")
	check("teammates always shown as an outline of their avatar", mt1 == 1 and mt2 == 1, tostring(mt1) .. "/" .. tostring(mt2))
	-- 시야 공유: P2 의 음파가 P1 의 지도에도 남고, 지도에 팀원이 보인다
	local mp1 = nil
	waitFor(function()
		mp1 = ask(p1, "map")
		return mp1 ~= nil and mp1.explored > 5
	end, 8)
	check("teammate's echo is recorded on my map", mp1 and mp1.explored > 5, mp1 and mp1.explored)
	ask(p1, "toggleMap")
	task.wait(0.4)
	local mp1b = ask(p1, "map")
	check("teammate shown on my map", mp1b and mp1b.matesShown == 1, mp1b and mp1b.matesShown)
	ask(p1, "toggleMap")
	-- 함께 탈출 → 2스테이지
	for _, q in { p1, p2 } do
		place(q, Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
	end
	local next2 = waitFor(function()
		return Round.state == "Playing" and Round.stageIndex == 2 and p1:GetAttribute("Status") == "Alive" and p2:GetAttribute("Status") == "Alive"
	end, 20)
	check("both escape stage 1 together and play stage 2", next2 ~= nil, Round.state .. " " .. Round.stageIndex)
	-- 마지막 스테이지를 깬 것으로 하고 탈출 → 로비로(시작 지점에 세워지기를 기다린 뒤)
	task.wait(2)
	Round.stageIndex = #Config.Stages
	for _, q in { p1, p2 } do
		place(q, Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
	end
	local back = waitFor(function()
		return Round.state == "Lobby" and p1:GetAttribute("Status") == "Alive" and p2:GetAttribute("Status") == "Alive"
	end, 20)
	check("after the last stage both return to the lobby", back ~= nil, Round.state)
	check("rooms are cleared after the game", next(LobbyMod.rooms) == nil and p1:GetAttribute("RoomId") == nil)
	local lu2 = waitFor(function()
		local x = ask(p1, "lobby")
		return x and x.visible and x
	end, 5)
	check("room panel is back in the lobby", lu2 ~= nil)
end

-- ─────────────────────────────── dense ───────────────────────────────
-- 음파로 보여 줄 게 가장 많은 곳(스테이지마다 반경 안 파트가 가장 많은 바닥 칸)에서 음파를 계속 쏴 최악의 프레임을 잰다
local function dense()
	local ps = readyPlayers(1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	local out = {}
	local only = tonumber(args.Stage) or 0
	for i = 1, #Config.Stages do
		if only == 0 or only == i then
			Round.startStage(i)
			readyPlayers(1)
			waitFor(function()
				local st = ask(p, "stats")
				return st and st.buildId == stageFolder():GetAttribute("BuildId") and st.build.segs > 0
			end, 30)
			-- 가장 빽빽한 곳
			local best, bn = nil, -1
			local params = OverlapParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { stageFolder() }
			for k, n in Round.info.nodes do
				if k % 3 == 0 then
					local c = #workspace:GetPartBoundsInRadius(n, 30, params)
					if c > bn then
						best, bn = n, c
					end
				end
			end
			place(p, best + Vector3.new(0, 0, 0), best + Vector3.new(1, 0, 0))
			task.wait(1)
			ask(p, "resetPerf")
			for _ = 1, 8 do
				ask(p, "resetCooldown")
				ask(p, "fire")
				task.wait(Config.Sonar.Cooldown + 0.05)
			end
			task.wait(1)
			local st = ask(p, "stats")
			local r = { stage = i, parts = bn, luaAvg = math.floor(st.lua.avg * 100000) / 100, luaWorst = math.floor(st.lua.worst * 100000) / 100, frameWorst = math.floor(st.worstFrame * 10000) / 10, created = st.lines.created, stolen = st.lines.stolen, active = st.lines.active, pulsesMs = st.prof.pulsesMs, linesMs = st.prof.linesMs, segs = st.build.segs, maxColor = st.lines.maxColor, maxPlace = st.lines.maxPlace, dropped = st.lines.dropped }
			table.insert(out, r)
			log(HttpService:JSONEncode(r))
			check(string.format("stage %d dense spot: sonar worst frame cost < 8ms", i), r.luaWorst < 8, string.format("avg %.2f worst %.2f ms, created %d stolen %d dropped %d", r.luaAvg, r.luaWorst, r.created, r.stolen, st.lines.dropped or 0))
		end
	end
	R.info.dense = out
end

-- ─────────────────────────────── chase ───────────────────────────────
-- 스테이지마다: 메인 괴물이 쫓아올 때 그 스테이지 동작(팔 자세·튀어나가기)으로 실제로 다가오는가
local function chaseMotion()
	local ps = readyPlayers(1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	-- 쫓아올 때 팔 각도가 이만큼은 돼야 그 동작이다(1 머리 위로 휘젓기, 2 원으로 휘두르기, 3·5 앞으로 짚기, 4 팔 늘어짐 + 무릎 높이)
	local armMin = { 1.8, 1.5, 0.6, 0, 0.5 }
	for i = 1, 5 do
		-- (앞 스테이지에서 잡혔으면 되살아날 때까지 기다린 뒤 다음 스테이지)
		waitFor(function()
			return Round.state == "Playing" and p:GetAttribute("Status") == "Alive"
		end, 20)
		Round.startStage(i)
		readyPlayers(1)
		waitFor(function()
			return p:GetAttribute("Status") == "Alive"
		end, 15)
		task.wait(1)
		ask(p, "anim", "all")
		waitFor(function()
			local s = ask(p, "anim")
			return s and (s.bodies or 0) >= #Round.monsters
		end, 8)
		local m = Round.monsters[1]
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not m or not root then
			check(string.format("stage %d: monster and player ready", i), false)
			continue
		end
		-- 안전 구역 밖에서 20~35스터드 떨어진 두 지점
		local pPos, mPos
		for _, a in m.nodes do
			if not Monster.isSafe(a) then
				for _, b in m.nodes do
					local d = (a - b).Magnitude
					if d > 20 and d < 35 and not Monster.isSafe(b) then
						pPos, mPos = a, b
						break
					end
				end
			end
			if pPos then
				break
			end
		end
		if not pPos or not mPos then
			check(string.format("stage %d: found a spot to test the chase", i), false)
			continue
		end
		place(p, pPos + Vector3.new(0, 3, 0), mPos)
		m.model:PivotTo(CFrame.lookAt(mPos + Vector3.new(0, 5, 0), pPos + Vector3.new(0, 5, 0)))
		m.waypoints = {}
		m.startAt = 0
		task.wait(0.3)
		ask(p, "anim", "all")
		local rig4 = m.model:GetAttribute("Rig") == 4
		local cid = m.model:GetAttribute("Creature")
		if rig4 then
			-- 3D 시안 괴물은 음파에 드러난 동안만 뼈를 움직인다: 쫓기 직전에 음파
			ask(p, "creature", "reset")
			ask(p, "pulseAt", root.Position + Vector3.new(0, 1.5, 0))
		end
		m:startChase(p, root.Position)
		local d0 = (m.root.Position - root.Position).Magnitude
		local armMax, legMax, sMin, sMax = 0, 0, math.huge, 0
		local caught = false
		for _ = 1, 35 do
			task.wait(0.1)
			for _, j in m.joints do
				local _, ang = (j.base:Inverse() * j.motor.C0):ToAxisAngle()
				if j.amp > 0.4 then
					legMax = math.max(legMax, math.abs(ang))
				else
					armMax = math.max(armMax, math.abs(ang))
				end
			end
			sMin, sMax = math.min(sMin, m.hum.WalkSpeed), math.max(sMax, m.hum.WalkSpeed)
			if p:GetAttribute("Status") ~= "Alive" then
				caught = true
				break
			end
		end
		local r2 = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local d1 = if r2 then (m.root.Position - r2.Position).Magnitude else 0
		check(string.format("stage %d: chasing monster closes in (%s)", i, m.state), caught or d1 < d0 - 6, string.format("%.0f -> %.0f studs%s", d0, d1, if caught then ", caught" else ""))
		if rig4 then
			-- 3D 시안 괴물: 디자인의 추격 자세로 뼈가 움직이고(추격 비율), 실제 이동 거리로 걸음이 나며, 디자인별 추격 속도로 꾸준히 쫓는다
			local st = ask(p, "creature", cid) or {}
			check(string.format("stage %d: %s chases with its own 3D chase pose", i, tostring(cid)), (st.frames or 0) > 10 and (st.chaseMax or 0) > 0.5 and (st.steps or 0) >= 2, string.format("frames %s chaseW %.2f steps %s bones %s", tostring(st.frames), st.chaseMax or 0, tostring(st.steps), tostring(st.bones)))
			local cs = m.cfg.ChaseSpeed
			check(string.format("stage %d: %s chase speed steady at its own %.0f", i, tostring(cid), cs), math.abs(sMax - cs) < 0.01, string.format("%.1f ~ %.1f", sMin, sMax))
			continue
		end
		-- 전신 동작(클라이언트 측정): 1 팔을 머리 위로, 2 줄에 당겨지듯 몸이 크게 오르내림, 3·5 상체를 숙이고 손으로 땅을 짚음, 4 무릎을 높이 듦
		local a = ask(p, "anim") or {}
		local own = if i == 1 then (a.arm or 0) > 1.6
			elseif i == 2 then (a.pelvisRange or 0) > 0.12
			elseif i == 4 then (a.lift or 0) > 0.3
			else (a.lean or 0) > 0.7 and (a.handSteps or 0) > 0
		check(string.format("stage %d: chase uses its own full-body motion", i), own and (a.steps or 0) >= 2, string.format("arm %.2f lean %.2f lift %.2f pelvis %.2f handSteps %s steps %s", a.arm or 0, a.lean or 0, a.lift or 0, a.pelvisRange or 0, tostring(a.handSteps), tostring(a.steps)))
		check(string.format("stage %d: feet stay planted while chasing", i), (a.slip or 99) < 0.25, string.format("max %.3f studs", a.slip or -1))
		local _ = armMin[i] + armMax + legMax
		local lunge = i == 1 or i == 3 or i == 4
		check(string.format("stage %d: chase speed %s", i, if lunge then "lunges and pauses" else "steady"), if lunge then (sMax > Config.Monster.ChaseSpeed * 1.2 and sMin < Config.Monster.ChaseSpeed * 0.7) else math.abs(sMax - Config.Monster.ChaseSpeed) < 0.01, string.format("%.1f ~ %.1f", sMin, sMax))
	end
end

-- ─────────────────────────────── walk ───────────────────────────────
-- 괴물이 실제로 돌아다니는가: 60초 동안 1초마다 위치를 재서 이동 거리·멈춰 있던 시간을 본다(플레이어는 숨겨 둔다)
local function walk()
	local ps = readyPlayers(1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	local si = tonumber(args.Stage) or 1
	if si ~= Round.stageIndex then
		Round.startStage(si)
		readyPlayers(1)
	end
	local spot = Hiding.all()[1]
	if spot then
		Hiding.enter(p, spot)
	end
	local seconds = tonumber(args.Seconds) or 60
	for _, m in Round.monsters do
		m.startAt = 0
	end
	local track = {}
	for k, m in Round.monsters do
		track[k] = { last = m.root.Position, dist = 0, still = 0, states = {}, swing = 0 }
	end
	ask(p, "anim", "all")
	for _ = 1, seconds do
		task.wait(1)
		for k, m in Round.monsters do
			local t = track[k]
			local pos = m.root.Position
			local d = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(t.last.X, 0, t.last.Z)).Magnitude
			t.dist += d
			if d < 0.5 and m.state ~= "Alert" then
				t.still += 1
			end
			t.last = pos
			t.states[m.state] = (t.states[m.state] or 0) + 1
			local j = m.joints[1]
			if j then
				local _, ang = (j.base:Inverse() * j.motor.C0):ToAxisAngle()
				t.swing = math.max(t.swing, math.abs(ang))
			end
		end
	end
	local out = {}
	for k, m in Round.monsters do
		local t = track[k]
		local st = {}
		for name, n in t.states do
			table.insert(st, name .. "=" .. n)
		end
		table.insert(out, { dist = math.floor(t.dist), still = t.still, states = table.concat(st, " "), log = table.concat(m.log, " | "):sub(-400) })
		check(string.format("monster %d keeps moving (%ds)", k, seconds), t.dist > seconds * Config.Monster.WanderSpeed * 0.4 and t.still < seconds * 0.35, string.format("%d studs, still %ds", math.floor(t.dist), t.still))
	end
	-- 전신 움직임(클라이언트): 발을 디디고 걷는다(디딘 발은 미끄러지지 않는다), 골반이 오르내리고 척추가 비틀린다, 발소리는 발이 닿을 때
	local a = ask(p, "anim") or {}
	local n = #Round.monsters
	check("monsters are animated with the full-body rig", (a.bodies or 0) >= n, tostring(a.bodies))
	check("monsters take real steps (feet lift and land)", (a.steps or 0) >= n * seconds * 0.6, string.format("%s steps", tostring(a.steps)))
	check("planted feet do not slide", (a.slip or 99) < 0.2, string.format("max %.3f studs", a.slip or -1))
	check("pelvis rises and falls with each step (weight)", (a.pelvisRange or 0) > 0.08, string.format("%.2f studs", a.pelvisRange or 0))
	check("spine twists against the pelvis while walking", (a.chestYaw or 0) > 0.02, string.format("%.3f rad", a.chestYaw or 0))
	check("monster footstep sounds play when a foot lands", (a.footSounds or 0) > 0, tostring(a.footSounds))
	R.info.anim = a
	R.info.walk = out
end

-- ─────────────────────────────── stages ───────────────────────────────
-- 스테이지 1~5 를 차례로 지어: 오류 없이 지어지는가, 시작→출구 경로, 괴물 수, 음파 선이 나오는가
local function stages()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	for i = 1, #Config.Stages do
		local errBefore = #R.errors
		Round.startStage(i)
		local ok = readyPlayers(1)
		-- (아바타 애니메이션 로드 실패는 도플갱어가 친구 아바타를 입을 때 나는 로블록스 쪽 오류: 빌드 실패로 세지 않는다)
		local buildErrs = {}
		for k = errBefore + 1, #R.errors do
			if not string.find(R.errors[k], "animation", 1, true) then
				table.insert(buildErrs, R.errors[k])
			end
		end
		check(string.format("stage %d built and player spawned", i), ok ~= nil and #buildErrs == 0, Config.Stages[i].Name .. (if #buildErrs > 0 then " | " .. buildErrs[1] else ""))
		if ok then
			local st = ask(p, "stats")
			local paths = {}
			for _, agent in { { r = 1.2, h = 5.5, monster = false }, { r = Config.Monster.AgentRadius, h = Config.Monster.AgentHeight, monster = true } } do
				local status = routeWalkable(agent, agent.monster)
				table.insert(paths, status)
			end
			check(string.format("stage %d: start -> exit walkable (player, monster)", i), paths[1] == "Success" and paths[2] == "Success", table.concat(paths, ","))
			-- 시안 괴물 챕터는 메인 + 서브 전부, 아니면 예전 메인 괴물 수
			local cl = Round.chapterCreatures()
			local wantM = if cl then #cl else Config.Stages[i].Monsters
			check(string.format("stage %d: %d monster(s)%s", i, wantM, if cl then " (chapter creatures)" else ""), #Round.monsters == wantM, #Round.monsters)
			ask(p, "resetCooldown")
			ask(p, "fire")
			task.wait(1.2)
			local s2 = ask(p, "stats")
			check(string.format("stage %d: sonar reveals outlines", i), s2 and s2.lines.lit > 100, s2 and string.format("segs=%d lit=%d unattached=%d", st.segs, s2.lines.lit, st.unattached))
			R.info["stage" .. i] = st and { segs = st.segs, culled = st.culled, unattached = st.unattached, parts = workspace.Stage:GetAttribute("PartCount") }
			task.wait(2.2)
		end
	end
end

-- 맵 길찾기(레벨 디자인 검사): 스테이지마다 실제 길찾기(PathfindingService + 타일 경로 구간)로
-- 시작 → 모든 뒤지는 곳(Z) 앞(플레이어), 출구 → 모든 Z 앞(괴물: 어디든 쫓아올 수 있는가), 괴물 배회 지점 아무 곳 12쌍(괴물, 2층 포함)
local function mapNav()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local only = tonumber(args.Stage) or 0
	for i = 1, #Config.Stages do
		if only ~= 0 and i ~= only then
			continue
		end
		local errBefore = #R.errors
		Round.startStage(i)
		if not readyPlayers(1) then
			check("stage " .. i .. " ready", false)
			continue
		end
		-- 짓는 동안 난 오류(괴물 애니메이션 에셋 로드 실패는 맵과 상관없어서 뺀다)
		local errs = {}
		for k = errBefore + 1, #R.errors do
			if not string.find(R.errors[k], "animation", 1, true) then
				table.insert(errs, R.errors[k])
			end
		end
		local stage = workspace:FindFirstChild("Stage")
		check(string.format("stage %d built without map errors (parts %s)", i, tostring(stage and stage:GetAttribute("PartCount"))), #errs == 0, table.concat(errs, " | "))
		local player = { r = 1.2, h = 5.5 }
		local monster = { r = Config.Monster.AgentRadius, h = Config.Monster.AgentHeight }
		local exitPos = Round.info.exitCFrame.Position - Vector3.new(0, 3.5, 0)
		local fails, mfails, n = {}, {}, 0
		local upperSpots = 0
		for _, spot in Search.all() do
			n += 1
			local to = spot.front + Vector3.new(0, 0.5, 0)
			if to.Y > 9 then
				upperSpots += 1
			end
			local st = routeWalkable(player, false, nil, to)
			if st ~= "Success" then
				table.insert(fails, string.format("Z(%d,%d,%s):%s", math.floor(to.X / 8), math.floor(to.Z / 8), if to.Y > 9 then "2F" else "1F", st))
			end
			local ms = routeWalkable(monster, true, exitPos, to)
			if ms ~= "Success" then
				table.insert(mfails, string.format("Z(%d,%d):%s", math.floor(to.X / 8), math.floor(to.Z / 8), ms))
			end
			task.wait()
		end
		check(string.format("stage %d: player can walk start -> every search spot (%d, 2F %d)", i, n, upperSpots), #fails == 0 and n > 0, table.concat(fails, " "))
		check(string.format("stage %d: monster can walk exit -> every search spot", i), #mfails == 0, table.concat(mfails, " "))
		local nodes = Round.info.nodes
		local bad, upper = {}, 0
		for k = 1, 12 do
			local a = nodes[((k * 7919) % #nodes) + 1] - Vector3.new(0, 3, 0)
			local b = nodes[((k * 104729 + 13) % #nodes) + 1] - Vector3.new(0, 3, 0)
			if a.Y > 9 or b.Y > 9 then
				upper += 1
			end
			local ms = routeWalkable(monster, true, a, b)
			if ms ~= "Success" then
				table.insert(bad, string.format("(%d,%d)->(%d,%d):%s", math.floor(a.X / 8), math.floor(a.Z / 8), math.floor(b.X / 8), math.floor(b.Z / 8), ms))
			end
			task.wait()
		end
		check(string.format("stage %d: monster roams between 12 random node pairs (%d touch 2F)", i, upper), #bad == 0, table.concat(bad, " "))
	end
end

-- 스테이지마다 아무 곳 12군데에서 음파를 쏴 본다(실패하면 이유·위치)
local function sonarAll()
	local ps = readyPlayers(1)
	if not ps then
		check("player ready", false)
		return
	end
	local p = ps[1]
	for i = 1, #Config.Stages do
		Round.startStage(i)
		if not readyPlayers(1) then
			check("stage " .. i .. " ready", false)
			continue
		end
		waitFor(function()
			local s = ask(p, "lastFail")
			return s and s.ready
		end, 20)
		local m = Round.monsters[1]
		local fails, lowLit = {}, {}
		for k = 1, 12 do
			local pos = if m then m:randomNode(nil) else Round.info.spawns[1].Position
			place(p, pos + Vector3.new(0, 3, 0))
			task.wait(0.35)
			ask(p, "resetCooldown")
			local ok = ask(p, "fire")
			if not ok then
				local why = ask(p, "lastFail")
				table.insert(fails, string.format("(%.0f,%.0f,%.0f):%s", pos.X, pos.Y, pos.Z, why and tostring(why.fail or ("ready=" .. tostring(why.ready) .. " st=" .. tostring(why.status))) or "?"))
			else
				task.wait(1.0)
				local s2 = ask(p, "stats")
				if not s2 or s2.lines.lit < 30 then
					table.insert(lowLit, string.format("(%.0f,%.0f,%.0f):lit=%s", pos.X, pos.Y, pos.Z, s2 and tostring(s2.lines.lit) or "?"))
				end
			end
		end
		check(string.format("stage %d: sonar fires at 12 random spots", i), #fails == 0, table.concat(fails, " "))
		check(string.format("stage %d: sonar shows lines at those spots", i), #lowLit == 0, table.concat(lowLit, " "))
	end
end

-- ─────────────────────────────── doppel ───────────────────────────────
-- 도플갱어: 스테이지마다 한 마리(사람 모습) → 음파·가까이서 보면 들킴 → 5~10초 뒤 터지며 괴물 → 추격·잡기(도플갱어 점프스케어)
local function doppelTest()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local D = Config.Doppel
	-- 스테이지마다 한 마리, 사람 모습, 메인 괴물 수는 그대로
	for i = 1, #Config.Stages do
		Round.startStage(i)
		readyPlayers(1)
		local d = Round.doppels[1]
		local boxes = 0
		if d then
			for _, c in d.model:GetDescendants() do
				if c:IsA("BasePart") and CollectionService:HasTag(c, Config.Tags.Renderable) and (c:FindFirstAncestor("Disguise") or c:GetAttribute("DisguisePart") or (c.Parent and c.Parent:GetAttribute("DisguisePart"))) then
					boxes += 1
				end
			end
		end
		local dist = d and (d.root.Position - Round.info.spawns[1].Position).Magnitude or -1
		-- (괴물 수: 시안 괴물 챕터는 메인 + 서브 전부, 아니면 예전 메인 괴물 수)
		local cl = Round.chapterCreatures()
		local wantM = if cl then #cl else Config.Stages[i].Monsters
		check(string.format("stage %d: one doppelganger in player form (other monsters still %d)", i, wantM), #Round.doppels == D.PerStage and d ~= nil and d.form == "Disguise" and boxes >= 6 and #Round.monsters == wantM and CollectionService:HasTag(d.model, Config.Tags.Doppel), string.format("doppels=%d form=%s boxes=%d monsters=%d", #Round.doppels, d and d.form or "-", boxes, #Round.monsters))
		check(string.format("stage %d: doppelganger spawns %d~%d studs from the start", i, D.SpawnDistance[1], D.SpawnDistance[2]), dist >= D.SpawnDistance[1] - 6 and dist <= D.SpawnDistance[2] + 6, string.format("%.0f", dist))
	end
	-- 진짜 사람(친구 또는 플레이어)의 아바타로 갈아입는다
	do
		local dd = Round.doppels[1]
		local dressed = dd and waitFor(function()
			return dd.model:GetAttribute("AvatarOf") ~= nil
		end, 12)
		check("doppelganger wears a real avatar (a friend, or a player)", dressed ~= nil and dd.tracks ~= nil, dd and tostring(dd.model:GetAttribute("AvatarOf")))		-- 들키기 전에도 몸이 보인다(투명하지 않은 아바타 파트)
		local shown, total = 0, 0
		if dd then
			for _, c in dd.model:GetChildren() do
				if c:GetAttribute("DisguisePart") and c:IsA("BasePart") then
					total += 1
					if c.Transparency < 1 then
						shown += 1
					end
				end
			end
		end
		check("disguise avatar is visible before any sonar", total > 0 and shown == total, string.format("%d/%d", shown, total))
		-- 가짜 음파: 진짜 음파처럼 클라이언트에 SonarPulse 로 간다
		local before = dd and dd.model:GetAttribute("FakePing")
		if dd then
			dd:fakeSonar()
		end
		check("doppelganger fires a fake sonar pulse", dd ~= nil and dd.model:GetAttribute("FakePing") ~= before)
	end
	-- 1스테이지 시작 방에서: 플레이어 tile(2,2), 도플갱어 tile(4,4) (약 23스터드: 보이는 거리 밖, 음파 거리 안)
	Round.startStage(1)
	readyPlayers(1)
	local d = Round.doppels[1]
	if not d then
		return
	end
	d.startAt = 0
	local pPos = tile(2, 2, 3)
	place(p, pPos, tile(4, 4, 3))
	local function putDoppel(pos: Vector3)
		d.model:PivotTo(CFrame.lookAt(pos, Vector3.new(pPos.X, pos.Y, pPos.Z)))
		d.waypoints = {}
		d.pauseUntil = os.clock() + 30 -- (제자리에 서 있게)
	end
	putDoppel(tile(4, 4, 3))
	task.wait(1.5)
	check("doppelganger far away (out of sight range) is not discovered yet", d.discoveredBy == nil and d.form == "Disguise", tostring(d.discoveredBy))
	-- 사람 모습도 음파에 윤곽선으로 보인다 + 음파를 쏘면 들킨다
	ask(p, "resetCooldown")
	ask(p, "fire")
	local found = waitFor(function()
		return d.discoveredBy ~= nil
	end, 3)
	local wait0 = d.transformAt - os.clock()
	check("sonar reveals the doppelganger: discovered", found ~= nil and d.discoveredBy == p, tostring(d.discoveredBy))
	check(string.format("transforms %d~%d s after being discovered", D.TransformDelay[1], D.TransformDelay[2]), wait0 > D.TransformDelay[1] - 1.5 and wait0 <= D.TransformDelay[2] + 0.1, string.format("%.1f s", wait0))
	task.wait(1.2)
	local shownNow = ask(p, "reveal")
	-- (진짜 친구 아바타를 입은 도플갱어는 팀원처럼 늘 윤곽선으로 보인다(Reveal.disguised): 음파 목록 대신 몸이 실제로 보이는지)
	local rv = ask(p, "revealedModel", d.model)
	local avatar = d.model:GetAttribute("AvatarOf") ~= nil
	check("sonar hit: the player-shaped doppelganger stays visible as it is (no frozen afterimage)", (shownNow and shownNow >= 1) or (avatar and rv ~= nil and rv.visible > 0), string.format("shown %s avatar %s visibleParts %s", tostring(shownNow), tostring(avatar), tostring(rv and rv.visible)))
	local fx0 = ask(p, "doppelFx")
	-- 변신: 사람 모습이 터지고(조각) 괴물 몸으로
	local turned = waitFor(function()
		return d.form == "Beast"
	end, D.TransformDelay[2] + 3)
	task.wait(0.4)
	local fx1 = ask(p, "doppelFx")
	local beast = d.model:FindFirstChild("Beast")
	local eyes, lineParts = 0, 0
	if beast then
		for _, c in beast:GetChildren() do
			if c:IsA("BasePart") then
				if c.Name == "Eye" then
					eyes += 1
				end
				if CollectionService:HasTag(c, Config.Tags.Renderable) then
					lineParts += 1
				end
			end
		end
	end
	check("transforms into the monster (player body gone, beast body with 2 eyes)", turned ~= nil and d.model:FindFirstChild("Disguise") == nil and beast ~= nil and eyes == 2, string.format("form=%s eyes=%d lines=%d", d.form, eyes, lineParts))
	check("the player body bursts into flying pieces on screen", fx1 and fx0 and fx1.bursts == fx0.bursts + 1 and fx1.shards >= 50, fx1 and string.format("bursts %d->%d shards=%d", fx0 and fx0.bursts or -1, fx1.bursts, fx1.shards))
	check("bursting plays the doppelganger's own burst sound (flesh rip + bone crack)", fx1 and fx0 and fx1.sounds == fx0.sounds + 1, fx1 and string.format("sounds %s->%s", tostring(fx0 and fx0.sounds), tostring(fx1.sounds)))
	do
		local near = false
		for _, e in Players:GetPlayers() do
			local r = e.Character and e.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r and (r.Position - d.root.Position).Magnitude <= D.TransformNear + 3 then
				near = true
			end
		end
		check(string.format("transforms only with a player within %d studs", D.TransformNear), turned ~= nil and near, tostring(near))
	end
	check("monster body is drawn with single strokes (lines and discs)", lineParts > 60 and lineParts < 160, lineParts)
	local chasing = waitFor(function()
		return d.state == "Chase" and d.target == p
	end, D.BurstPause + 2)
	check("after bursting it chases the player who found it", chasing ~= nil, d.state)
	check("doppelganger monster is smaller than the main monster", d.hum.HipHeight < 4 and d.cfg.ChaseSpeed == Config.Doppel.ChaseSpeed, string.format("hip %.1f speed %.1f", d.hum.HipHeight, d.cfg.ChaseSpeed))
	-- 음파에 맞으면 눈이 빛난다(선보다 조금 더 오래)
	putDoppel(tile(4, 4, 3))
	d.startAt = os.clock() + 4 -- (잠깐 세워 둔다)
	ask(p, "resetCooldown")
	ask(p, "fire")
	local lit = waitFor(function()
		local f = ask(p, "doppelFx")
		return f and f.eyes >= 2 and f
	end, 3)
	check("sonar makes its eyes glow", lit ~= nil, lit and lit.eyes)
	-- 덮칠 때 세로 입이 벌어지고, 잡히면 도플갱어 점프스케어
	d.startAt = 0
	d:startChase(p, pPos)
	local opened = waitFor(function()
		return d.model:GetAttribute("MawOpen") == true
	end, 8)
	check("its head-to-belly split opens into a mouth when it lunges", opened ~= nil, tostring(d.model:GetAttribute("MawOpen")))
	local dead = waitFor(function()
		return p:GetAttribute("Status") == "Dead"
	end, 8)
	local js = ask(p, "jumpscare")
	check("caught by the doppelganger -> death with its own jump scare", dead ~= nil and js and js.kind == "doppel", js and tostring(js.kind))
	-- 가까이서 보면(음파 없이) 들킨다
	waitFor(function()
		return Round.state == "Playing" and p:GetAttribute("Status") == "Alive" and Round.doppels[1] ~= nil and Round.doppels[1] ~= d
	end, 20)
	readyPlayers(1)
	local d2 = Round.doppels[1]
	if d2 then
		d2.startAt = 0
		place(p, pPos, tile(3, 3, 3))
		d2.model:PivotTo(CFrame.lookAt(tile(3, 3, 3), pPos))
		d2.waypoints = {}
		d2.pauseUntil = os.clock() + 30
		local seen = waitFor(function()
			return d2.discoveredBy == p
		end, 3)
		check("seeing it up close (no sonar) also gives it away", seen ~= nil, tostring(d2.discoveredBy))
	end
	-- 사람 모습일 때는 플레이어를 잡지 않는다
	Round.startStage(1)
	readyPlayers(1)
	local d3 = Round.doppels[1]
	if d3 then
		d3.startAt = 0
		place(p, pPos, tile(3, 3, 3))
		d3.model:PivotTo(CFrame.lookAt(pPos + Vector3.new(2, 0, 0), pPos))
		task.wait(1.5)
		check("in player form it never kills", p:GetAttribute("Status") == "Alive" and d3.form == "Disguise", p:GetAttribute("Status") .. " " .. d3.form)
	end
end

-- ─────────────────────────────── lives ───────────────────────────────
-- 목숨 3개(스테이지마다) + 시작 방 안전 구역
local function livesTest()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	Config.Lives.PerStage = 3
	Config.SafeZone.Enabled = true
	Round.startStage(1)
	readyPlayers(1)
	local stage = stageFolder()
	local safeCount = #string.split((stage:GetAttribute("SafeTiles") :: string?) or "", ";")
	check("start room is a safe zone (stage 1: 3x3 room)", safeCount == 9 and stage:FindFirstChild("SafeZone") ~= nil, safeCount)
	check("3 lives at the start of a stage", p:GetAttribute("Lives") == 3, p:GetAttribute("Lives"))
	local hud = ask(p, "keyHud")
	check("lives shown on screen (3 hearts)", hud and hud.lives and select(2, string.gsub(hud.lives, "♥", "")) == 3, hud and hud.lives)
	-- 안전 구역 안: 화면에 표시, 괴물이 바로 옆에 와도 잡지 않고 밖으로 나간다
	local inside = tile(2, 2, 3)
	place(p, inside, tile(4, 4, 3))
	local safeShown = waitFor(function()
		local h = ask(p, "keyHud")
		return h and h.safe
	end, 3)
	check("'safe zone' shown while in the start room", safeShown ~= nil)
	local m = Round.monsters[1]
	m.model:PivotTo(CFrame.new(tile(3, 3, 5.2)))
	m.waypoints = {}
	m.startAt = 0
	task.wait(2.5)
	check("monster in the safe zone does not catch or chase the player", p:GetAttribute("Status") == "Alive" and not (m.state == "Chase" and m.target == p), p:GetAttribute("Status") .. " " .. m.state)
	local left = waitFor(function()
		return not Round.inSafe(m.root.Position)
	end, 8)
	check("monster leaves the safe zone on its own", left ~= nil, tostring(m.root.Position))
	-- 쫓기다 안전 구역으로 들어가면 추격을 멈춘다
	local outside = tile(7, 3, 3)
	place(p, outside, tile(9, 3, 3))
	m.model:PivotTo(CFrame.new(tile(10, 3, 5.2)))
	m.waypoints = {}
	m:startChase(p, outside)
	task.wait(0.3)
	place(p, inside, tile(4, 4, 3))
	local dropped = waitFor(function()
		return m.target ~= p and m.state ~= "Chase"
	end, 3)
	check("chase stops when the player reaches the safe zone", dropped ~= nil, m.state)
	m.startAt = 1e9
	-- 잡히면 목숨 하나 잃고 시작 방에서 다시(점프스케어)
	local js0 = ask(p, "jumpscare")
	place(p, outside, tile(9, 3, 3))
	m.model:PivotTo(CFrame.new(outside + Vector3.new(1.5, 2.2, 0)))
	m.startAt = 0
	m:startChase(p, outside)
	local lost = waitFor(function()
		return p:GetAttribute("Status") == "Respawning"
	end, 6)
	m.startAt = 1e9
	m.model:PivotTo(CFrame.new(tile(20, 20, 5.2)))
	check("caught with lives left -> lose one life (not dead)", lost ~= nil and p:GetAttribute("Lives") == 2, tostring(p:GetAttribute("Status")) .. " lives=" .. tostring(p:GetAttribute("Lives")))
	local js1 = ask(p, "jumpscare")
	check("jump scare still plays when a life is lost", js1 and js0 and js1.count == js0.count + 1, js1 and js1.count)
	local back = waitFor(function()
		local r = root(p)
		return p:GetAttribute("Status") == "Alive" and r and Round.inSafe(r.Position)
	end, Config.Lives.RespawnDelay + 6)
	check("respawns in the start room after a moment", back ~= nil, tostring(p:GetAttribute("Status")))
	check("the stage keeps going (not restarted)", Round.state == "Playing" and Round.stageIndex == 1, Round.state)
	local hud2 = ask(p, "keyHud")
	check("hearts drop to 2", hud2 and hud2.lives and select(2, string.gsub(hud2.lives, "♥", "")) == 2, hud2 and hud2.lives)
	-- 두 번 더 잡히면 아웃(마지막 목숨)
	Round.kill(p, "monster")
	waitFor(function()
		return p:GetAttribute("Status") == "Alive"
	end, Config.Lives.RespawnDelay + 6)
	check("second catch: 1 life left", p:GetAttribute("Lives") == 1, p:GetAttribute("Lives"))
	Round.kill(p, "monster")
	check("last life lost -> dead", p:GetAttribute("Status") == "Dead" and p:GetAttribute("Lives") == 0, tostring(p:GetAttribute("Status")))
	-- (혼자면 스테이지 다시 시작) 다시 시작하면 목숨이 다시 3개
	local again = waitFor(function()
		return Round.state == "Playing" and p:GetAttribute("Status") == "Alive"
	end, 25)
	check("new attempt / stage refills lives to 3", again ~= nil and p:GetAttribute("Lives") == 3, p:GetAttribute("Lives"))
	Config.Lives.PerStage = 1
	Config.SafeZone.Enabled = false
end

-- ─────────────────────────────── reveal ───────────────────────────────
-- 음파에 맞은 괴물은 어그로가 풀릴 때까지(다시 배회할 때까지) 계속 보인다
local function revealTest()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	Round.startStage(1)
	readyPlayers(1)
	local catch0 = Config.Monster.CatchDistance
	Config.Monster.CatchDistance = -1 -- (이 테스트에서는 잡지 않게)
	local m = Round.monsters[1]
	local pPos = tile(2, 2, 3)
	place(p, pPos, tile(4, 4, 3))
	m.model:PivotTo(CFrame.new(tile(4, 4, 5.2)))
	m.waypoints = {}
	m.startAt = 0
	task.wait(0.5)
	check("monster not shown before any sonar", ask(p, "reveal") == 0, ask(p, "reveal"))
	ask(p, "resetCooldown")
	ask(p, "fire")
	m:startChase(p, pPos)
	local shown = waitFor(function()
		return (ask(p, "reveal") or 0) >= 1
	end, 3)
	check("sonar hit: the monster becomes visible", shown ~= nil, ask(p, "reveal"))
	-- 음파 선이 사라진 뒤에도(배회해도) 10초 동안은 지금 모습 그대로 보인다
	m.startAt = 1e9
	m.target = nil
	m:setState("Wander")
	task.wait(Config.Sonar.Hold + 2.5)
	check("still visible (live) after the sonar lines fade, within 10 s", (ask(p, "reveal") or 0) >= 1, ask(p, "reveal"))
	local hidden = waitFor(function()
		return ask(p, "reveal") == 0
	end, Config.Sonar.MonsterRevealSeconds)
	check("invisible again about 10 s after the hit", hidden ~= nil, ask(p, "reveal"))
	-- 음파 범위 밖의 괴물은 드러나지 않는다
	m.model:PivotTo(CFrame.new(tile(30, 30, 5.2)))
	m.startAt = 0
	m:startChase(p, pPos)
	ask(p, "resetCooldown")
	ask(p, "fire")
	task.wait(1.5)
	check("a monster out of sonar range is not revealed", ask(p, "reveal") == 0, ask(p, "reveal"))
	m.startAt = 1e9
	m:setState("Wander")
	-- 도플갱어: 음파에 들키면(사람 모습) 계속 보인다
	local d = Round.doppels[1]
	if d then
		d.startAt = 0
		d.model:PivotTo(CFrame.lookAt(tile(4, 4, 3), pPos))
		d.waypoints = {}
		d.pauseUntil = os.clock() + 30
		task.wait(0.3)
		ask(p, "resetCooldown")
		ask(p, "fire")
		local dshown = waitFor(function()
			return d.discoveredBy ~= nil and (ask(p, "reveal") or 0) >= 1
		end, 3)
		task.wait(Config.Sonar.Hold + 0.5)
		check("discovered doppelganger stays visible (player form)", dshown ~= nil and (ask(p, "reveal") or 0) >= 1 and d.form == "Disguise", string.format("%s %s", tostring(ask(p, "reveal")), d.form))
		d.startAt = 1e9
	end
	Config.Monster.CatchDistance = catch0
end

-- ─────────────────────────────── mobile ───────────────────────────────
-- 휴대폰 화면 버튼: 휴대폰 모드에서 로비·스테이지에 맞는 버튼이 보이는가
local function mobileTest()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local pc = ask(p, "mobile")
	check("PC: no phone buttons", pc and pc.enabled == false, pc and tostring(pc.enabled))
	local st = ask(p, "mobile", true)
	local b = st and table.concat(st.buttons, ",") or ""
	check("phone in a stage: sonar, run, crouch, map buttons", st and st.enabled and b:find("Sonar") and b:find("Run") and b:find("Crouch") and b:find("Map") ~= nil, b)
	Round.enterLobby()
	readyPlayers(1)
	task.wait(1)
	local lb = ask(p, "mobile", true)
	local lbs = lb and table.concat(lb.buttons, ",") or ""
	check("phone in the lobby: sonar and room menu buttons", lb and lbs:find("Sonar") and lbs:find("Menu") ~= nil, lbs)
	ask(p, "mobile", false)
end

-- ─────────────────────────────── seal ───────────────────────────────
-- 스테이지 1~5 를 지어, 실제로 만들어진 벽·바닥에 구멍이 없는지 광선으로 확인한다:
--   바닥 칸마다 아래로(바닥이 있나), 벽 칸 쪽으로(그 벽이 실제로 막고 있나),
--   두 벽이 만나는 모서리 너머가 바닥이면 대각선으로(모서리 틈으로 빠져나갈 수 없나)
local function seal()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local FLOOR = { ["."] = true, S = true, E = true, D = true, A = true, p = true, w = true, b = true, n = true, s = true }
	for i = 1, #Config.Stages do
		Round.startStage(i)
		readyPlayers(1)
		task.wait(1)
		local s = workspace.Stage:GetAttribute("Rows")
		local rows = string.split(s, "/")
		local H, W = #rows, #rows[1]
		local function at(x, y)
			if y < 1 or y > H or x < 1 or x > W then
				return "#"
			end
			return string.sub(rows[y], x, x)
		end
		local params = RaycastParams.new()
		local chars = {}
		for _, pl in Players:GetPlayers() do
			if pl.Character then
				table.insert(chars, pl.Character)
			end
		end
		for _, m in Round.monsters do
			if m.model then
				table.insert(chars, m.model)
			end
		end
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = chars
		params.RespectCanCollide = true
		local noFloor, gaps, corner, tiles = {}, {}, {}, 0
		for y = 1, H do
			for x = 1, W do
				local c = at(x, y)
				if FLOOR[c] then
					tiles += 1
					local o = Vector3.new((x - 1) * 8 + 4, 3, (y - 1) * 8 + 4)
					if not workspace:Raycast(o, Vector3.new(0, -40, 0), params) then
						table.insert(noFloor, string.format("r%dc%d%s", y - 1, x - 1, c))
					end
					for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
						if at(x + d[1], y + d[2]) == "#" then
							for _, h in { 1, 3, 6 } do
								local o2 = Vector3.new(o.X, h, o.Z)
								if not workspace:Raycast(o2, Vector3.new(d[1], 0, d[2]) * 6, params) then
									table.insert(gaps, string.format("r%dc%d->(%d,%d)@%d", y - 1, x - 1, d[1], d[2], h))
									break
								end
							end
						end
					end
					for _, d in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
						if at(x + d[1], y) == "#" and at(x, y + d[2]) == "#" and at(x + d[1], y + d[2]) ~= "#" then
							-- (선 하나는 두 벽 블록이 맞닿은 모서리 선을 정확히 지나갈 수 있어, 몸 크기쯤 되는 공으로 굴려 본다)
							if not workspace:Spherecast(o, 0.6, Vector3.new(d[1], 0, d[2]) * 8, params) then
								table.insert(corner, string.format("r%dc%d->(%d,%d)", y - 1, x - 1, d[1], d[2]))
							end
						end
					end
				end
			end
		end
		local function first(t)
			return table.concat(t, " ", 1, math.min(#t, 8))
		end
		check(string.format("stage %d: every floor tile has a floor under it (%d tiles)", i, tiles), #noFloor == 0, first(noFloor))
		check(string.format("stage %d: walls really block (no gaps beside floor)", i), #gaps == 0, first(gaps))
		check(string.format("stage %d: no leaks through wall corners", i), #corner == 0, first(corner))
	end
end

-- ─────────────────────────────── probe ───────────────────────────────
-- 한 스테이지(args.Stage)에서 시작 → 모든 바닥 칸으로 경로를 계산해, 길이 끊기는 경계(갈 수 있는 칸 ↔ 못 가는 칸)를 보고한다.
local function probe()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local si = tonumber(args.Stage) or 1
	Round.startStage(si)
	readyPlayers(1)
	for _, m in Round.monsters do
		m.alive = false
	end
	local from = Round.info.spawns[1].Position - Vector3.new(0, 2.5, 0)
	do
		local ex = Round.info.exitCFrame
		local parts = {}
		for _, part in workspace:GetPartBoundsInBox(CFrame.new(ex.Position - ex.LookVector * 4.8), Vector3.new(7.8, 9, 3.6)) do
			if part.CanCollide then
				table.insert(parts, string.format("%s %s @%s", part.Name, tostring(part.Size), tostring(part.Position - ex.Position)))
			end
		end
		local down = workspace:Raycast(ex.Position, Vector3.new(0, -10, 0))
		R.info.exitTile = { pos = tostring(ex.Position), look = tostring(ex.LookVector), floor = down and (down.Instance.Name .. " y=" .. down.Position.Y) or "none", parts = parts }
	end
	local function key(pos)
		return math.floor(pos.X / 8) + 1, math.floor(pos.Z / 8) + 1
	end
	for _, agent in { { name = "player", r = 1.2, h = 5.5 }, { name = "monster", r = Config.Monster.AgentRadius, h = Config.Monster.AgentHeight } } do
		local path = PathfindingService:CreatePath({ AgentRadius = agent.r, AgentHeight = agent.h, AgentCanJump = false })
		local okSet, bad = {}, {}
		for _, n in (if args.Quick then {} else Round.info.nodes) do
			local i, j = key(n)
			pcall(function()
				path:ComputeAsync(from, n - Vector3.new(0, 3, 0))
			end)
			if path.Status == Enum.PathStatus.Success then
				okSet[i .. "," .. j] = true
			else
				table.insert(bad, { i, j })
			end
		end
		local edge = {}
		for _, b in bad do
			for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
				if okSet[(b[1] + d[1]) .. "," .. (b[2] + d[2])] then
					-- 원인 찾기: 바로 옆 칸에서 가까이 다시 계산(먼 거리 탐색 한계인지), 그 칸 안의 부딪히는 파트
					local c0 = Vector3.new((b[1] - 1) * 8 + 4, 0, (b[2] - 1) * 8 + 4)
					local c1 = Vector3.new((b[1] + d[1] - 1) * 8 + 4, 0, (b[2] + d[2] - 1) * 8 + 4)
					pcall(function()
						path:ComputeAsync(c1 + Vector3.new(0, 0.5, 0), c0 + Vector3.new(0, 0.5, 0))
					end)
					local near = path.Status.Name
					local parts = {}
					for _, part in workspace:GetPartBoundsInBox(CFrame.new(c0 + Vector3.new(0, 3, 0)), Vector3.new(7.6, 5, 7.6)) do
						if part.CanCollide and not part:IsDescendantOf(Players) and #parts < 4 then
							table.insert(parts, part.Name)
						end
					end
					table.insert(edge, string.format("c%d r%d <- c%d r%d near:%s [%s]", b[1] - 1, b[2] - 1, b[1] + d[1] - 1, b[2] + d[2] - 1, near, table.concat(parts, ",")))
					break
				end
			end
		end
		-- 출구 칸 안쪽 몇 곳
		local ex = Round.info.exitCFrame
		local exitTries = {}
		for _, off in { 0, 1.5, 3, 4.5 } do
			local goal = ex.Position - Vector3.new(0, 3.5, 0) - ex.LookVector * off
			pcall(function()
				path:ComputeAsync(from, goal)
			end)
			table.insert(exitTries, string.format("%.1f:%s", off, path.Status.Name))
		end
		-- 바로 앞 칸에서 출구 안으로 / 시작에서 바로 앞 칸까지
		local front = ex.Position - Vector3.new(0, 3.5, 0) - ex.LookVector * 8.8
		pcall(function()
			path:ComputeAsync(front, ex.Position - Vector3.new(0, 3.5, 0))
		end)
		table.insert(exitTries, "front->in:" .. path.Status.Name)
		pcall(function()
			path:ComputeAsync(from, front)
		end)
		table.insert(exitTries, "start->front:" .. path.Status.Name)
		local t0 = os.clock()
		local okc, errc = pcall(function()
			path:ComputeAsync(from, ex.Position - Vector3.new(0, 3.5, 0))
		end)
		table.insert(exitTries, string.format("t%.0f:%s err=%s", os.clock() - t0, path.Status.Name, tostring(okc and "" or errc)))
		R.info[agent.name] = { bad = #bad, total = #Round.info.nodes, edge = edge, exit = table.concat(exitTries, " ") }
		check(agent.name .. " reaches every floor tile", #bad == 0, #bad .. "/" .. #Round.info.nodes)
	end
end

local function flowerSpot()
	-- 꽃괴물은 Config.Flower.Stages(하수도)에만, 그 스테이지에선 맵 한가운데쯤(시작점에서 떨어진 곳)에 나오는지
	for i = 1, #Config.Stages do
		local want = table.find(Config.Flower.Stages, Config.Stages[i].Id) ~= nil
		for _ = 1, (if want then 3 else 1) do
			Round.startStage(i)
			task.wait(0.5)
			if not want then
				check("stage " .. i .. " has no flower", #Round.flowers == 0, tostring(#Round.flowers))
				break
			end
			local info = Round.info
			local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
			for _, n in info.nodes do
				x0, x1 = math.min(x0, n.X), math.max(x1, n.X)
				z0, z1 = math.min(z0, n.Z), math.max(z1, n.Z)
			end
			local size = math.max(x1 - x0, z1 - z0)
			local f = Round.flowers[1]
			if not f then
				check("stage " .. i .. " flower exists", false)
				break
			end
			local fp = f.root.Position
			local mid = math.sqrt((fp.X - (x0 + x1) / 2) ^ 2 + (fp.Z - (z0 + z1) / 2) ^ 2)
			local fromStart = (fp - info.spawns[1].Position).Magnitude
			check("stage " .. i .. " flower near map middle", mid <= size * 0.2 and fromStart >= 90,
				string.format("toMid %.0f (map %.0f) fromStart %.0f", mid, size, fromStart))
		end
	end
end

-- 챕터 시안 괴물(env CREATURE=챕터 번호): 전원 생성 · 구역 나눔 · 음파에 그림이 보임 · 움직임/걸음 · 서브 기믹
local function creatureTest()
	local chapter = tonumber(args.Creature)
	local def = chapter and Config.Creatures.Chapters[chapter]
	check("chapter given", def ~= nil, tostring(args.Creature))
	if not def or not chapter then
		return
	end
	local Monster = require(script.Parent.Monster)
	for _, id in def.main do
		check("module " .. id, Monster.creatureModule(id) ~= nil)
	end
	for _, id in def.sub do
		check("module " .. id, Monster.creatureModule(id) ~= nil)
	end
	local stageIdx = nil
	for i, st in Config.Stages do
		if st.Id == chapter then
			stageIdx = i
		end
	end
	local ps = readyPlayers(1)
	if not ps then
		check("player ready", false)
		return
	end
	local p = ps[1]
	Round.startStage(stageIdx)
	readyPlayers(1)
	local ready = Round.chapterCreatures()
	check("chapter has ready (uploaded) creatures", ready ~= nil, if ready then #ready .. " ready" else "none ready (fallback to old monsters)")
	if not ready then
		return
	end
	local want = #ready
	local found: { [string]: any } = {}
	waitFor(function()
		table.clear(found)
		local n = 0
		for _, mm in Round.monsters do
			-- (개체 이름: 같은 디자인 여러 마리(10장 뜬눈 3마리)도 따로 센다)
			local id = mm.model:GetAttribute("CreatureId") or mm.model:GetAttribute("Creature")
			if typeof(id) == "string" then
				found[id] = mm
				n += 1
			end
		end
		return n >= want
	end, 20)
	local n = 0
	local zones: { [number]: boolean } = {}
	local zoneDup = false
	for id, mm in found do
		n += 1
		local z = mm.model:GetAttribute("Zone")
		if zones[z] then
			zoneDup = true
		end
		zones[z] = true
		check(id .. " Rig 4 + starts in own zone", mm.model:GetAttribute("Rig") == 4 and mm:inTerritory(mm.root.Position), tostring(mm.root.Position))
	end
	check("all chapter creatures spawned", n == want, n .. "/" .. want)
	check("one zone each", not zoneDup)
	-- 각 괴물 앞에서 음파 → 그 괴물 그림이 보이고 걷는다
	ask(p, "creature", "reset")
	local results = {}
	for id, mm in found do
		mm.startAt = os.clock() + 1e6 -- (테스트 동안 스스로 생각하지 않게: 아래에서 직접 걷게 한다)
		local at = mm.root.Position
		-- 플레이어 자리: 괴물에서 6~16 스터드, 벽에 가리지 않는 이동 지점(벽 속·벽 너머에 세우지 않는다)
		local spot, walkTo = nil, nil
		local info = Round.info :: any
		for _, n in info.nodes do
			local d = (n - at).Magnitude
			if d >= 6 and d <= 16 and math.abs(n.Y - at.Y) < 6 and mm:lineOfSight(n + Vector3.new(0, 1, 0)) then
				if not spot then
					spot = n
				elseif not walkTo and (n - spot).Magnitude > 8 then
					walkTo = n
				end
			end
		end
		place(p, (spot or (at + mm.root.CFrame.LookVector * 8)) + Vector3.new(0, 3, 0))
		task.wait(0.6)
		ask(p, "pulseAt", root(p).Position + Vector3.new(0, 1.5, 0))
		-- 괴물을 길찾기로 근처 다른 지점까지 걷게 한다
		mm.hum.WalkSpeed = 8
		local goal = walkTo or spot or (at - mm.root.CFrame.LookVector * 8)
		local okPath = mm:pathTo(goal)
		local t1 = os.clock()
		while os.clock() - t1 < 3.5 do
			if okPath then
				mm:follow()
			else
				mm.hum:MoveTo(goal)
			end
			task.wait(0.1)
		end
		local st = ask(p, "creature", mm.model:GetAttribute("Creature"))
		local rv = ask(p, "revealedModel", mm.model)
		local ok = st ~= nil and st.frames > 10 and rv ~= nil and rv.active and rv.visible > 0
		table.insert(results, id .. (if ok then " ok" else " FAIL"))
		check(id .. " 3D body shown on sonar and animated", ok, string.format("frames %s bones %s visible parts %s err %s", st and st.frames or "-", st and st.bones or "-", rv and rv.visible or "-", st and st.err or "-"))
		check(id .. " walks with footsteps", st ~= nil and st.steps > 0, if st then "steps " .. st.steps else "")
		mm.hum:MoveTo(mm.root.Position)
	end
	-- 점프스케어만 내는 서브 괴물: 잡혀도 목숨이 그대로
	for _, id in def.sub do
		local mm = found[id]
		if mm and mm.model:GetAttribute("Gimmick") == "scare" then
			local lives = p:GetAttribute("Lives")
			mm.onCatch(p, mm)
			task.wait(1)
			check(id .. " scare-only catch keeps the player alive", p:GetAttribute("Status") == "Alive" and p:GetAttribute("Lives") == lives, tostring(p:GetAttribute("Status")) .. " lives " .. tostring(p:GetAttribute("Lives")))
		end
	end
	for _, mm in found do
		check("stays in map", mm.root.Position.Y > -50)
	end
end

-- 모든 챕터: 괴물마다 바로 앞에서 음파 → 그 괴물이 실제로 보이는가(보이는 몸이 있고 Reveal 이 켜짐)
local function revealAll()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local catch0 = Config.Monster.CatchDistance
	Config.Monster.CatchDistance = -1
	for i = 1, #Config.Stages do
		Round.startStage(i)
		readyPlayers(1)
		task.wait(1)
		local shown, total, bodyless = 0, 0, {}
		for _, m in Round.monsters do
			if m.alive and m.model.Parent then
				total += 1
				m.startAt = os.clock() + 1e6 -- (테스트 동안 가만히)
				-- 보일 몸: 예전 괴물 = 음파 대상 파트, 시안 괴물 = 3D 메시
				local body = 0
				for _, d in m.model:GetDescendants() do
					if d:IsA("BasePart") and (CollectionService:HasTag(d, Config.Tags.Renderable) or d:IsA("MeshPart")) then
						body += 1
					end
				end
				if body == 0 then
					table.insert(bodyless, m.model.Name)
				end
				place(p, m.root.Position + m.root.CFrame.LookVector * 8 + Vector3.new(0, 3, 0))
				task.wait(0.5)
				ask(p, "pulseAt", root(p).Position + Vector3.new(0, 1.5, 0))
				local ok = waitFor(function()
					local r = ask(p, "revealedModel", m.model)
					return r ~= nil and r.active and r.visible > 0
				end, 3)
				if ok then
					shown += 1
				end
			end
		end
		check(string.format("stage %d: every monster has a visible body", i), #bodyless == 0, table.concat(bodyless, ","))
		check(string.format("stage %d: every monster revealed by sonar (%d)", i, total), total > 0 and shown == total, shown .. "/" .. total)
	end
	Config.Monster.CatchDistance = catch0
end

-- ─────────────────────────────── 성능: stress / census ───────────────────────────────
--   stress (env STAGE=n, QUICK=1 이면 짧게): 한 클라이언트에서 음파 부하를 단계별로 만들고 구간마다 수치를 잰다.
--     팀원 음파는 서버가 실제 팀원 음파와 똑같은 SonarPulse 이벤트로 보낸다(음파·소리·지도·괴물 드러남 경로가 모두 실제와 같다).
--   census (env STAGE=n 이면 그 챕터만, 아니면 전부): 부품 수·속성 집계, 서버·클라이언트 빌드 시간, 챕터를 이어서 바꿀 때 남는 인스턴스·메모리
local Stats = game:GetService("Stats")
local function r2(x)
	return math.floor((x or 0) * 100 + 0.5) / 100
end
-- 주변에 윤곽선 부품이 가장 많은 배회 지점(가장 무거운 곳)과 그 수
local function heaviestNode()
	local cells: { [number]: number } = {}
	local function key(x, z)
		return x * 4096 + z
	end
	for _, inst in CollectionService:GetTagged(Config.Tags.Renderable) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(stageFolder()) then
			local k = key(inst.Position.X // 8, inst.Position.Z // 8)
			cells[k] = (cells[k] or 0) + 1
		end
	end
	local best, bestN = Round.info.nodes[1], -1
	for _, n in Round.info.nodes do
		local cx, cz = n.X // 8, n.Z // 8
		local sum = 0
		for dx = -4, 4 do
			for dz = -4, 4 do
				if dx * dx + dz * dz <= 18 then
					sum += cells[key(cx + dx, cz + dz)] or 0
				end
			end
		end
		if sum > bestN then
			best, bestN = n, sum
		end
	end
	return best, bestN
end

local function stress()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local stageNo = tonumber(args.Stage) or 0
	if stageNo > 0 and stageNo ~= Round.stageIndex then
		Round.startStage(stageNo)
		task.wait(1)
		ps = readyPlayers(1)
		check("stage ready", ps ~= nil)
		if not ps then
			return
		end
	end
	local seconds = if args.Quick then 5 else 9
	local SonarPulse = ReplicatedStorage.Remotes.SonarPulse
	local spot, spotParts = heaviestNode()
	place(p, spot + Vector3.new(0, 0.5, 0))
	task.wait(3)
	-- 괴물은 잡지 않게(측정이 끊기지 않게)
	local all = {}
	for _, list in { Round.monsters, Round.doppels, Round.flowers } do
		for _, m in list do
			rawset(m, "checkCatch", function() end)
			table.insert(all, m)
		end
	end
	-- 팀원 세 명이 서 있을 자리: 가까운 배회 지점 중 서로 다른 세 곳(8~28스터드)
	local near = {}
	for _, n in Round.info.nodes do
		local d = (n - spot).Magnitude
		if d > 7 and d < 30 and math.abs(n.Y - spot.Y) < 6 then
			table.insert(near, n)
		end
	end
	table.sort(near, function(a, b)
		return (a - spot).Magnitude < (b - spot).Magnitude
	end)
	local mates = {}
	for k = 1, 3 do
		mates[k] = (near[math.max(1, math.floor(#near * k / 3.2))] or spot) + Vector3.new(0, 1.5, 0)
	end
	local out = {}
	-- 한 구간: shooters 명이 gap 초마다 동시에 쏜다(0명이면 가만히)
	local function phase(name, shooters, gap, opts)
		opts = opts or {}
		task.wait(Config.Sonar.Hold + 0.5) -- 앞 구간의 선이 다 사라진 뒤
		ask(p, "perfx", "reset")
		local hb, hbN, hbMax, hbTime, physT, physMax = 0, 0, 0, 0, 0, 0
		local conn = RunService.Heartbeat:Connect(function(dt)
			hb += dt
			hbN += 1
			hbMax = math.max(hbMax, dt)
			hbTime += Stats.HeartbeatTimeMs
			local ph = Stats.PhysicsStepTimeMs
			physT += ph
			physMax = math.max(physMax, ph)
		end)
		local t = os.clock()
		local emitCpu, emits, fired, calls = 0, 0, 0, 0
		while os.clock() - t < seconds do
			local tick0 = os.clock()
			if opts.monsters then
				local pos = root(p) and root(p).Position
				for i, m in all do
					if pos and m.alive and m.kind ~= "flower" and m.form == "Beast" then
						if (m.root.Position - pos).Magnitude > 45 and i <= 5 and #near > 0 then
							m.model:PivotTo(CFrame.new(near[(i * 7) % #near + 1] + Vector3.new(0, 2, 0)))
						end
						m.startAt = 0
						m:startChase(p, pos)
					end
				end
			end
			if shooters > 0 then
				for s = 1, shooters do
					if s == 1 then
						ask(p, "resetCooldown")
						calls += 1
						if ask(p, "fire") then
							fired += 1
						end
					else
						local at = if opts.overlap then spot + Vector3.new(s * 0.6, 1.5, 0) else mates[(s - 2) % 3 + 1]
						SonarPulse:FireClient(p, 900000 + s, at)
						fired += 1
						local e0 = os.clock()
						SoundBus.emit(at, Config.Noise.Sonar, nil, "Sonar")
						emitCpu += os.clock() - e0
						emits += 1
					end
				end
				local rest = gap - (os.clock() - tick0)
				if rest > 0 then
					task.wait(rest)
				end
			else
				task.wait(0.5)
			end
		end
		conn:Disconnect()
		local dur = os.clock() - t
		local x = ask(p, "perfx", "reset")
		if not x then
			check(name .. ": perfx", false)
			return
		end
		local sys = {}
		for n, v in x.sys do
			sys[n] = string.format("%.2f ms/s, avg %.3f, worst %.2f ms, calls %d", v.avgMs * v.calls / dur, v.avgMs, v.worstMs, v.calls)
		end
		local row = {
			phase = name,
			fired = fired,
			sec = r2(dur),
			fps = r2(x.fps),
			low1 = r2(x.low1Fps),
			avgMs = r2(x.avgMs),
			p95 = r2(x.p95Ms),
			p99 = r2(x.p99Ms),
			worst = r2(x.worstMs),
			luaAvg = r2(x.luaAvgMs),
			luaP95 = r2(x.luaP95Ms),
			luaP99 = r2(x.luaP99Ms),
			luaWorst = r2(x.luaWorstMs),
			pulseAvg = r2(x.pulseCost.avgMs),
			pulseMax = r2(x.pulseCost.maxMs),
			startAvg = r2(x.pulseCost.startAvgMs),
			startMax = r2(x.pulseCost.startMaxMs),
			cut = x.pulseCost.cut,
			maxActive = x.pulseMaxActive,
			finished = x.pulseCost.finished,
			linesActive = x.lineStats.active,
			created = x.lineStats.created,
			dropped = x.lineStats.dropped,
			stolen = x.lineStats.stolen,
			shown = x.lineStats.shown,
			sounds = x.sounds,
			soundsPeak = x.soundsPeak,
			memMb = r2(x.memMb),
			instances = x.instances,
			recvKbps = r2(x.recvKbps),
			sendKbps = r2(x.sendKbps),
			srvFrame = r2(hb / math.max(1, hbN) * 1000),
			srvWorst = r2(hbMax * 1000),
			srvHeartbeatMs = r2(hbTime / math.max(1, hbN)),
			emitMs = if emits > 0 then math.floor(emitCpu / emits * 1e5) / 100 else 0,
			physMs = r2(physT / math.max(1, hbN)),
			physMax = r2(physMax),
			contacts = Stats.ContactsCount,
			counters = x.counters,
			sys = sys,
		}
		out[#out + 1] = row
		log(HttpService:JSONEncode(row))
	end
	phase("idle", 0, 0)
	phase("solo", 1, Config.Sonar.Cooldown)
	phase("two", 2, Config.Sonar.Cooldown)
	phase("four", 4, Config.Sonar.Cooldown)
	phase("four-overlap", 4, Config.Sonar.Cooldown, { overlap = true })
	phase("four-chase", 4, Config.Sonar.Cooldown, { monsters = true })
	phase("flood-12", 12, Config.Sonar.Cooldown)
	-- 다 끝난 뒤 남는 것(누수)
	task.wait(8)
	local z = ask(p, "perfx", "reset")
	check("all sonar lines released after stress", z and z.lineStats.active == 0, z and z.lineStats.active)
	check("no pulse left running", z and z.pulses == 0, z and z.pulses)
	check("no sound left over", z and z.sounds <= 3, z and z.sounds)
	R.info.stress = out
	R.info.spot = { parts = spotParts, at = tostring(spot), monsters = #all, after = z and { instances = z.instances, memMb = r2(z.memMb), sounds = z.sounds, lines = z.lineStats } }
	-- 서버 괴물 움직임 비용(한 프레임, 괴물 전부)
	local c0 = os.clock()
	for _ = 1, 100 do
		for _, m in all do
			m:animate(0.016)
		end
	end
	R.info.animateMsPerFrame = math.floor((os.clock() - c0) / 100 * 1e6) / 1000
end

-- soak (env STAGE, WATCH_SECONDS): 4명 분량 음파를 걸으며(자리 옮김) 계속 → 20초마다 Lua 메모리·인스턴스·선 큐·소리(누수·오래 할수록 느려지는지)
local function soak()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local stageNo = tonumber(args.Stage) or 0
	if stageNo > 0 and stageNo ~= Round.stageIndex then
		Round.startStage(stageNo)
		task.wait(1)
		readyPlayers(1)
	end
	for _, list in { Round.monsters, Round.doppels, Round.flowers } do
		for _, m in list do
			rawset(m, "checkCatch", function() end)
		end
	end
	local nodes = Round.info.nodes
	local rows = {}
	local t = os.clock()
	local nextAt, i = 0, 0
	ask(p, "perfx", "reset")
	while os.clock() - t < (tonumber(args.Seconds) or 150) do
		local c = os.clock()
		i += 1
		local n = nodes[(i * 37) % #nodes + 1]
		place(p, n + Vector3.new(0, 0.5, 0))
		task.wait(0.05)
		ask(p, "resetCooldown")
		ask(p, "fire")
		for k = 1, 3 do
			ReplicatedStorage.Remotes.SonarPulse:FireClient(p, 900000 + k, n + Vector3.new(k * 2, 1.5, k))
		end
		if os.clock() - t >= nextAt then
			nextAt += 20
			local x = ask(p, "perfx", "reset")
			if x then
				local row = { t = math.floor(os.clock() - t), luaMb = r2((x.luaKb or 0) / 1024), order = x.lineStats.order, instances = x.instances, sounds = x.sounds, fps = r2(x.fps), luaAvg = r2(x.luaAvgMs), luaWorst = r2(x.luaWorstMs), worst = r2(x.worstMs), active = x.lineStats.active, memMb = r2(x.memMb) }
				rows[#rows + 1] = row
				log(HttpService:JSONEncode(row))
			end
		end
		task.wait(math.max(0, Config.Sonar.Cooldown - (os.clock() - c)))
	end
	task.wait(8)
	local z = ask(p, "perfx", "reset")
	check("soak: everything released", z and z.lineStats.active == 0 and z.pulses == 0 and z.sounds <= 3, z and (z.lineStats.active .. " lines, " .. z.pulses .. " pulses, " .. z.sounds .. " sounds"))
	R.info.soak = rows
	R.info.soakEnd = z and { luaMb = r2((z.luaKb or 0) / 1024), order = z.lineStats.order, instances = z.instances, sounds = z.sounds }
end

-- pbench (env STAGE=n, 없으면 전부): 음파 1·4개의 비용을 가짜 시계로 여러 번 재서 최소·중앙값(그 챕터에서 가장 무거운 곳)
local function pbench()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local only = tonumber(args.Stage) or 0
	local rows = {}
	for i = 1, #Config.Stages do
		if only > 0 and i ~= only then
			continue
		end
		Round.startStage(i)
		task.wait(1)
		readyPlayers(1)
		local spot = heaviestNode()
		place(p, spot + Vector3.new(0, 0.5, 0))
		for _, list in { Round.monsters, Round.doppels, Round.flowers } do
			for _, m in list do
				rawset(m, "checkCatch", function() end)
			end
		end
		task.wait(2)
		local at = { spot + Vector3.new(0, 1.5, 0) }
		for _, n in Round.info.nodes do
			local d = (n - spot).Magnitude
			if #at < 4 and d > 14 * #at - 6 and d < 30 and math.abs(n.Y - spot.Y) < 6 then
				table.insert(at, n + Vector3.new(0, 1.5, 0))
			end
		end
		for _, n in { 1, 4 } do
			local res
			task.spawn(function()
				res = ReplicatedStorage.TestProbe:InvokeClient(p, "pulseBench", { at = at, n = n, reps = if args.Quick then 5 else 9 })
			end)
			waitFor(function()
				return res
			end, 90)
			if res then
				local row = { stage = i, n = n, shown = res.shown }
				for _, k in { "start", "wave", "total", "peak" } do
					row[k .. "Min"] = r2(res[k].min)
					row[k .. "Med"] = r2(res[k].med)
				end
				rows[#rows + 1] = row
				log(HttpService:JSONEncode(row))
			end
		end
	end
	check("bench rows", #rows > 0, #rows)
	R.info.pbench = rows
end

local function census()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local only = tonumber(args.Stage) or 0
	local rows = {}
	local list = {}
	if only > 0 then
		list = { only }
	else
		for i = 1, #Config.Stages do
			list[i] = i
		end
		table.insert(list, 1) -- (처음 챕터로 돌아왔을 때 처음과 같은가 = 누수 확인)
	end
	for _, i in list do
		local okBuild, err = pcall(Round.startStage, i)
		check("stage " .. i .. " builds", okBuild, err)
		if not okBuild then
			continue
		end
		readyPlayers(1)
		local st = waitFor(function()
			local s = ask(p, "stats")
			return s and s.ready and s.buildId == stageFolder():GetAttribute("BuildId") and s
		end, 40)
		check("stage " .. i .. " client ready", st ~= nil)
		task.wait(2)
		local c = { stage = i, parts = 0, mesh = 0, invisible = 0, collide = 0, query = 0, touch = 0, shadow = 0, tagged = 0, decorQuery = 0, unanchored = 0, models = 0, inst = 0, prompts = 0, sounds = 0, lights = 0, cyl = 0 }
		for _, d in stageFolder():GetDescendants() do
			c.inst += 1
			if d:IsA("BasePart") then
				c.parts += 1
				if d:IsA("MeshPart") then
					c.mesh += 1
				elseif d:IsA("Part") and d.Shape == Enum.PartType.Cylinder then
					c.cyl += 1
				end
				if d.Transparency >= 1 then
					c.invisible += 1
				end
				if d.CanCollide then
					c.collide += 1
				elseif d.CanQuery then
					c.decorQuery += 1
				end
				if d.CanQuery then
					c.query += 1
				end
				if d.CanTouch then
					c.touch += 1
				end
				if d.CastShadow then
					c.shadow += 1
				end
				if not d.Anchored then
					c.unanchored += 1
				end
				if CollectionService:HasTag(d, Config.Tags.Renderable) then
					c.tagged += 1
				end
			elseif d:IsA("Model") then
				c.models += 1
			elseif d:IsA("ProximityPrompt") then
				c.prompts += 1
			elseif d:IsA("Sound") then
				c.sounds += 1
			elseif d:IsA("Light") then
				c.lights += 1
			end
		end
		c.serverBuildMs = math.floor(Round.lastBuildMs)
		c.segs = st and st.segs
		c.clientBuildSec = st and r2(st.build.seconds)
		c.clientBuildCpu = st and r2(st.build.cpu)
		c.grid = st and table.concat(st.grid, "x")
		local mp, mb, mm = 0, 0, 0
		for _, l in { Round.monsters, Round.doppels, Round.flowers } do
			for _, m in l do
				mm += 1
				for _, d in m.model:GetDescendants() do
					if d:IsA("BasePart") then
						mp += 1
					elseif d:IsA("Bone") then
						mb += 1
					end
				end
			end
		end
		c.monsters, c.monsterParts, c.monsterBones = mm, mp, mb
		local x = ask(p, "perfx", "reset")
		if x then
			c.clientInst, c.memMb, c.lines, c.recvKbps = x.instances, r2(x.memMb), x.lineStats.created, r2(x.recvKbps)
		end
		-- 이름별 파트 수 상위 12개(과분할 찾기: Haunch·Pipe·Pilaster·볼트 등), 1스터드보다 작은 장식, 부딪히는 장식(음파 윤곽 대상인데 충돌)
		local byName: { [string]: number } = {}
		local small, smallCollide = 0, 0
		for _, d in stageFolder():GetDescendants() do
			if d:IsA("BasePart") then
				local k = d.Name .. (if d:IsA("Part") and d.Shape == Enum.PartType.Cylinder then "(cyl)" else "")
				byName[k] = (byName[k] or 0) + 1
				local sz = d.Size
				if math.max(sz.X, sz.Y, sz.Z) < 1 then
					small += 1
					if d.CanCollide then
						smallCollide += 1
					end
				end
			end
		end
		local top = {}
		for k, v in byName do
			table.insert(top, { k, v })
		end
		table.sort(top, function(a, b)
			return a[2] > b[2]
		end)
		local s = {}
		for n = 1, math.min(12, #top) do
			s[n] = top[n][1] .. "=" .. top[n][2]
		end
		c.topNames = table.concat(s, " ")
		c.small, c.smallCollide = small, smallCollide
		-- 서버 물리(Studio 플레이는 서버·클라이언트가 한 프로세스)
		c.physMs = r2(Stats.PhysicsStepTimeMs)
		c.primitives = Stats.PrimitivesCount
		c.contacts = Stats.ContactsCount
		-- 지난 챕터에서 남은 것: Stage 폴더 밖 workspace 인스턴스(캐릭터·카메라·지형 제외)
		local loose = 0
		for _, ch in workspace:GetChildren() do
			if ch ~= stageFolder() and not ch:IsA("Terrain") and not ch:IsA("Camera") and not Players:GetPlayerFromCharacter(ch) then
				loose += 1 + #ch:GetDescendants()
			end
		end
		c.wsOutsideStage = loose
		c.serverInst, c.serverMemMb = Stats.InstanceCount, r2(Stats:GetTotalMemoryUsageMb())
		rows[#rows + 1] = c
		log(HttpService:JSONEncode(c))
	end
	R.info.census = rows
end

task.spawn(function()
	local ok, err = pcall(function()
		if args.Test == "stress" then
			stress()
		elseif args.Test == "soak" then
			soak()
		elseif args.Test == "pbench" then
			pbench()
		elseif args.Test == "census" then
			census()
		elseif args.Test == "dense" then
			dense()
		elseif args.Test == "lobby" then
			lobbyTest()
		elseif args.Test == "walk" then
			walk()
		elseif args.Test == "load" then
			load()
		elseif args.Test == "aibench" then
			aibench()
		elseif args.Test == "probe" then
			probe()
		elseif args.Test == "multi" then
			multi()
		elseif args.Test == "perf" then
			perf()
		elseif args.Test == "sonarall" then
			sonarAll()
		elseif args.Test == "stages" then
			stages()
		elseif args.Test == "mapnav" then
			mapNav()
		elseif args.Test == "seal" then
			seal()
		elseif args.Test == "doppel" then
			doppelTest()
		elseif args.Test == "creature" then
			creatureTest()
		elseif args.Test == "flowerspot" then
			flowerSpot()
		elseif args.Test == "chase" then
			chaseMotion()
		elseif args.Test == "lives" then
			livesTest()
		elseif args.Test == "meshcheck" then
			-- 올린 3D 메시 에셋 구조 확인(env CREATURE=에셋 번호)
			local ok, asset = pcall(function()
				return game:GetService("InsertService"):LoadAsset(tonumber(args.Creature) :: number)
			end)
			check("mesh asset loads", ok and asset ~= nil, tostring(asset))
			if ok and asset then
				local meshes, bones, skinned, verts = 0, 0, 0, ""
				for _, d in asset:GetDescendants() do
					if d:IsA("MeshPart") then
						meshes += 1
						if d.HasSkinnedMesh then
							skinned += 1
						end
						verts ..= string.format("%s size=%s ", d.Name, tostring(d.Size))
					elseif d:IsA("Bone") then
						bones += 1
					end
				end
				check("has mesh part", meshes > 0, meshes .. " " .. verts)
				check("has bones", bones > 10, tostring(bones))
				check("skinned", skinned > 0, tostring(skinned))
			end
		elseif args.Test == "revealall" then
			revealAll()
		elseif args.Test == "reveal" then
			revealTest()
		elseif args.Test == "netaudio" or args.Test == "netflood" then
			require(script.Parent.TestNetAudio)({ ask = ask, check = check, log = log, place = place, readyPlayers = readyPlayers, R = R, args = args })
		elseif args.Test == "mobile" then
			mobileTest()
		else
			core()
		end
	end)
	if not ok then
		check("test script ran", false, err)
	end
	R.finished = true
	R.events = Round.events
	log("done")
	StudioTestService:EndTest(R)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="256">
        <Properties>
          <string name="Name">TestNetAudio</string>
          <string name="Source"><![CDATA[--!nonstrict
-- (자동 테스트 전용) netaudio: 여러 클라이언트(PLAYERS=4)로 리모트 송수신 수·속성 복제 수·소리 생성 수·메모리를 단계별로 잰다.
--   idle(가만히) → look(카메라만 돌림) → action(모두 음파 + 걷기 + 괴물 추격) → spectate(한 명 사망·관전) → leave(한 명 퇴장, 음파 중)
-- TestHarness 가 ctx(ask·check·log·place·readyPlayers·R·args)를 넘겨 부른다. 게임 중에는 아무도 부르지 않는다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Stats = game:GetService("Stats")
local Config = require(ReplicatedStorage.Shared.Config)
local Round = require(script.Parent.Round)

-- netflood (PLAYERS=2): 한 사람이 리모트를 한꺼번에 많이 보낸다 → 서버가 처리한 수·다른 사람에게 퍼진 속성 변화·서버 프레임,
-- 그 뒤 정상 입력(음파·이동 모드·시선)이 막히지 않는가
local function flood(ctx)
	local ask, check, log, R = ctx.ask, ctx.check, ctx.log, ctx.R
	local ps = ctx.readyPlayers(2)
	check("2 players ready", ps ~= nil, #Players:GetPlayers())
	if not ps then
		return
	end
	local a, b = ps[1], ps[2]
	-- 관전자가 있어야 시선 공유가 켜진다: b 를 관전 상태로
	Round.kill(b, "test")
	task.wait(2)
	local handled = {}
	local conns = {}
	for _, ev in ReplicatedStorage.Remotes:GetChildren() do
		if ev:IsA("RemoteEvent") then
			table.insert(conns, ev.OnServerEvent:Connect(function()
				handled[ev.Name] = (handled[ev.Name] or 0) + 1
			end))
		end
	end
	local rows = {}
	for _, job in { { "LookShare", 600 }, { "MapShare", 200 }, { "SetMoveMode", 600 }, { "KeyHint", 300 } } do
		ask(a, "netaudio", "reset")
		ask(b, "netaudio", "reset")
		table.clear(handled)
		local attrs = 0
		local c1 = a.AttributeChanged:Connect(function()
			attrs += 1
		end)
		local hbMax, hbSum, hbN = 0, 0, 0
		local c2 = game:GetService("RunService").Heartbeat:Connect(function(dt)
			hbMax = math.max(hbMax, dt)
			hbSum += Stats.HeartbeatTimeMs
			hbN += 1
		end)
		ask(a, "flood", { remote = job[1], n = job[2] })
		task.wait(3)
		c1:Disconnect()
		c2:Disconnect()
		local xa = ask(a, "netaudio", "reset")
		local xb = ask(b, "netaudio", "reset")
		local row = {
			remote = job[1],
			sent = job[2],
			serverReceived = handled[job[1]] or 0,
			serverAttrWrites = attrs,
			observerAttrChanges = xb and ((xb.counts["attr.other.LookYaw"] or 0) + (xb.counts["attr.other.LookPitch"] or 0)) or -1,
			senderMapShareReplies = xa and (xa.counts["recv.MapShare"] or 0) or -1,
			senderMapShareTiles = xa and (xa.counts["recv.MapShare.tiles"] or 0) or -1,
			senderRecvKbps = xa and xa.recvKbps,
			serverWorstFrameMs = math.floor(hbMax * 100000) / 100,
			serverHeartbeatMs = math.floor(hbSum / math.max(1, hbN) * 100) / 100,
		}
		rows[#rows + 1] = row
		log(HttpService:JSONEncode(row))
	end
	-- 정상 입력은 막히지 않는다(폭주 뒤 2초)
	task.wait(2)
	local SM = _G.SonarMaze
	local before = SM.Sonar.accepted[a] or 0
	ask(a, "resetCooldown")
	ask(a, "fire")
	task.wait(0.5)
	check("sonar still accepted after flood", (SM.Sonar.accepted[a] or 0) == before + 1, (SM.Sonar.accepted[a] or 0) - before)
	ask(a, "setMode", "Run")
	task.wait(0.6)
	check("move mode still applied after flood", a.Character and a.Character:GetAttribute("MoveMode") == "Run", a.Character and a.Character:GetAttribute("MoveMode"))
	ask(a, "setMode", nil)
	local y0 = a:GetAttribute("LookYaw")
	ask(a, "spin", 3)
	task.wait(1)
	ask(a, "spin", 0)
	check("look still shared after flood", a:GetAttribute("LookYaw") ~= y0, tostring(y0) .. " -> " .. tostring(a:GetAttribute("LookYaw")))
	for _, c in conns do
		c:Disconnect()
	end
	R.info.netflood = rows
end

return function(ctx)
	local ask, check, log, place, R, args = ctx.ask, ctx.check, ctx.log, ctx.place, ctx.R, ctx.args
	if args.Test == "netflood" then
		return flood(ctx)
	end
	local want = tonumber(args.Players) or 4
	local ps = ctx.readyPlayers(want)
	check("all " .. want .. " players ready", ps ~= nil, #Players:GetPlayers())
	if not ps then
		return
	end
	local function r2(x)
		return math.floor((x or 0) * 100 + 0.5) / 100
	end
	-- 괴물은 잡지 않게
	local all = {}
	for _, list in { Round.monsters, Round.doppels, Round.flowers } do
		for _, m in list do
			rawset(m, "checkCatch", function() end)
			table.insert(all, m)
		end
	end
	-- 서버가 받은 리모트 수
	local srv = {}
	local conns = {}
	for _, ev in ReplicatedStorage.Remotes:GetChildren() do
		if ev:IsA("RemoteEvent") then
			table.insert(conns, ev.OnServerEvent:Connect(function()
				srv[ev.Name] = (srv[ev.Name] or 0) + 1
			end))
		end
	end
	local nodes = Round.info.nodes
	local start = Round.info.spawns and Round.info.spawns[1] or nodes[1]
	for k, p in ps do
		place(p, (if typeof(start) == "CFrame" then start.Position else start) + Vector3.new(k * 2.5, 0.5, 0))
	end
	task.wait(2)
	local out = {}
	local function phase(name, seconds, body)
		for _, p in ps do
			if p.Parent then
				ask(p, "netaudio", "reset")
			end
		end
		table.clear(srv)
		local hbN, hbT = 0, 0
		local c = game:GetService("RunService").Heartbeat:Connect(function()
			hbN += 1
			hbT += Stats.HeartbeatTimeMs
		end)
		local t = os.clock()
		body(seconds)
		local dur = os.clock() - t
		c:Disconnect()
		local row = { phase = name, sec = r2(dur), server = { remotesIn = table.clone(srv), instances = Stats.InstanceCount, memMb = r2(Stats:GetTotalMemoryUsageMb()), heartbeatMs = r2(hbT / math.max(1, hbN)), sendKbps = r2(Stats.DataSendKbps), recvKbps = r2(Stats.DataReceiveKbps) }, clients = {} }
		for i, p in ps do
			if p.Parent then
				local x = ask(p, "netaudio", "reset")
				if x then
					local cnt = x.counts
					local perSec = {}
					for k, v in cnt do
						if not string.find(k, "^snd:") then
							perSec[k] = r2(v / dur)
						end
					end
					local top = {}
					for k, v in cnt do
						if string.find(k, "^snd:") then
							table.insert(top, { k, v })
						end
					end
					table.sort(top, function(a, b)
						return a[2] > b[2]
					end)
					local names = {}
					for j = 1, math.min(8, #top) do
						names[j] = top[j][1] .. "=" .. top[j][2]
					end
					row.clients[i] = {
						perSec = perSec,
						topSounds = table.concat(names, " "),
						livePeak = x.livePeak,
						live = x.live,
						sndCpuUsPerPlay = r2((cnt["snd.cpuUs"] or 0) / math.max(1, cnt["snd.play"] or 0)),
						uiUsPerFrame = r2((cnt["ui.frameUs"] or 0) / math.max(1, cnt["ui.frames"] or 0)),
						soundsInWorkspace = x.soundsInWorkspace,
						soundsInSoundService = x.soundsInSoundService,
						instances = x.instances,
						memMb = r2(x.memMb),
						luaMb = r2(x.luaKb / 1024),
						recvKbps = r2(x.recvKbps),
						sendKbps = r2(x.sendKbps),
					}
				end
			end
		end
		out[#out + 1] = row
		log(HttpService:JSONEncode(row))
		return row
	end

	phase("idle", 15, function(s)
		task.wait(s)
	end)
	phase("look", 15, function(s)
		for _, p in ps do
			task.spawn(ask, p, "spin", 2)
		end
		task.wait(s)
		for _, p in ps do
			task.spawn(ask, p, "spin", 0)
		end
	end)
	local function action(s, who)
		local t = os.clock()
		local i = 0
		while os.clock() - t < s do
			i += 1
			for k, p in who do
				if p.Parent and p:GetAttribute("Status") == "Alive" then
					task.spawn(ask, p, "resetCooldown")
					task.spawn(ask, p, "fire")
					local n = nodes[(i * 13 + k * 31) % #nodes + 1]
					task.spawn(ask, p, "setMode", if k % 2 == 0 then "Run" else nil)
					task.spawn(ask, p, "move", n)
				end
			end
			local target = who[1]
			local rp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
			if rp then
				for _, m in all do
					if m.alive and m.kind ~= "flower" and m.form == "Beast" and m.startChase then
						m.startAt = 0
						pcall(m.startChase, m, target, rp.Position)
					end
				end
			end
			task.wait(Config.Sonar.Cooldown)
		end
	end
	phase("action", 30, function(s)
		for _, p in ps do
			task.spawn(ask, p, "spin", 1)
		end
		action(s, ps)
	end)
	-- 한 명 사망 → 관전(나머지는 계속 움직이며 음파)
	local victim = ps[1]
	phase("spectate", 20, function(s)
		Round.kill(victim, "test")
		task.wait(2)
		local rest = {}
		for k = 2, #ps do
			rest[#rest + 1] = ps[k]
		end
		action(s - 2, rest)
	end)
	local st = ask(victim, "stats")
	check("dead player spectates a teammate", st and st.ui.spectate ~= nil and st.ui.spectate:find("관전 중") ~= nil, st and st.ui.spectate)
	-- 음파·추격 중에 한 명이 나간다
	local leaver = ps[#ps]
	local leaverName = leaver.Name
	phase("leave", 15, function(s)
		local rest = {}
		for k = 2, #ps - 1 do
			rest[#rest + 1] = ps[k]
		end
		task.spawn(function()
			task.wait(3)
			leaver:Kick("netaudio test: leave mid-round")
		end)
		action(s, rest)
	end)
	local SM = _G.SonarMaze
	check("left player's sonar table cleared", SM and SM.Sonar.accepted[leaver] == nil)
	check("round still playing after leave", Round.state == "Playing", Round.state)
	task.wait(8)
	for _, p in ps do
		if p.Parent then
			local z = ask(p, "netaudio", "reset")
			check(p.Name .. ": sounds released afterwards", z and z.live <= 3, z and z.live)
		end
	end
	for _, c in conns do
		c:Disconnect()
	end
	R.info.netaudio = out
	R.info.leaver = leaverName
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="257">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">11</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="258">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">0.5</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpPower">40</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">10</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="259">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="ModuleScript" referent="260">
        <Properties>
          <string name="Name">Audio</string>
          <string name="Source"><![CDATA[--!strict
-- 클라이언트 사운드: 발소리(모든 캐릭터, 3D), 음파, 문, 괴물 발소리·반응음, 환경음.
-- 네트워크를 쓰지 않는다: 각 클라이언트가 복제된 위치·속성(MoveMode, State, Open)을 보고 스스로 재생한다.
-- 소리는 Config.Sounds 에서 교체한다. Id 가 "" 이면 재생하지 않는다.
-- 플레이어 속성 TestMute 가 켜지면(자동 테스트) 전체 음소거.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Config = require(ReplicatedStorage.Shared.Config)
local NetStat = require(script.Parent:WaitForChild("NetStat"))

local Audio = {}
local SND = Config.Sounds :: { [string]: { Id: string, Volume: number, Pitch: number, Range: number, Cut: number?, Fx: { { any } }?, Steps: { { number } }?, Thump: number?, Claw: string? } }
local player = Players.LocalPlayer

local master = Instance.new("SoundGroup")
master.Name = "SonarMaster"
master.Volume = 1
master.Parent = SoundService

local function applyMute()
	master.Volume = if player:GetAttribute("TestMute") then 0 else 1
end
applyMute()
player:GetAttributeChangedSignal("TestMute"):Connect(applyMute)

local function makeSound(name: string, parent: Instance, looped: boolean?): Sound?
	local def = SND[name]
	if not def or def.Id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	NetStat.count("snd.new")
	s.Name = name
	s.SoundId = def.Id
	s.Volume = def.Volume
	s.PlaybackSpeed = def.Pitch
	s.Looped = looped == true
	s.SoundGroup = master
	-- 챕터 소리 묶음(한 파일에 여러 괴물 소리): 이 소리 구간만 재생
	local region = (def :: any).Region
	if region then
		s.PlaybackRegionsEnabled = true
		s.PlaybackRegion = NumberRange.new(region[1], region[2])
	end
	if def.Range > 0 then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = (def :: any).Near or 5 -- (이 거리 안에서는 소리가 줄지 않는다)
		s.RollOffMaxDistance = def.Range
	end
	-- Fx = { { "SoundEffect 클래스", { 속성 = 값 } }, ... }: 소리 효과(왜곡·울림·떨림·에코·플랜저 등).
	-- 클래스·속성 이름이 틀려도 소리 전체가 죽지 않게 pcall 로 하나씩 적용한다.
	if def.Fx then
		for _, fx in def.Fx do
			local ok, eff = pcall(function()
				return Instance.new(fx[1] :: string)
			end)
			if ok and eff then
				for k, v in fx[2] :: { [string]: any } do
					pcall(function()
						(eff :: any)[k] = v
					end)
				end
				eff.Parent = s
				NetStat.count("snd.fx")
			end
		end
	end
	s.Parent = parent
	return s
end

local CULL_MARGIN = 20 -- (스터드) 짧은 소리가 재생되는 동안 소리 난 곳이 다가올 수 있는 거리
-- 한 번 재생하고 지운다. at 이 Vector3 이면 그 위치에서(3D), Instance 면 거기 붙여서, nil 이면 2D.
Audio.steps = 0 -- (테스트) 지금까지 재생한 플레이어 발소리 수
Audio.live = 0 -- (측정) Audio.play 로 만든, 아직 지우지 않은 소리 수
Audio.livePeak = 0

-- opts.gate = { 켜짐초, 꺼짐초 }: 그 박자로 소리를 끊어 켰다 껐다 한다(끊기는 괴성). opts.sweep = { { 정규화 시간 0~1, 피치 배율 }, ... }, opts.dur = 전체 길이(초): 소리를 반복 재생하면서 피치를 시간에 따라 바꾼다(사이렌·오르내리는 괴성)
function Audio.play(name: string, at: (Vector3 | Instance)?, pitchJitter: number?, volumeScale: number?, pitchScale: number?, startAt: number?, cutOverride: number?, opts: { sweep: { { number } }?, dur: number?, gate: { number }? }?)
	NetStat.count("snd.play")
	NetStat.count("snd:" .. name)
	local cpu0 = os.clock()
	if string.sub(name, 1, 13) == "Voice_Doppel_" then
		volumeScale = (volumeScale or 1) * ((Config :: any).Doppel.VoiceVolume or 1)
	end
	-- 들리는 거리(RollOffMaxDistance = Range) 밖의 소리는 만들지 않는다(InverseTapered 라 그 밖에서는 소리 크기 0).
	-- 위치가 고정된 소리는 Range 그대로, 움직이는 것(캐릭터·괴물)에 붙는 소리는 재생 중에 다가올 수 있어
	-- 짧은 소리(Cut ≤ 1.2초)만 Range + 여유로 거른다(괴성·특수음 같은 긴 소리는 그대로 만든다)
	local def0 = SND[name]
	if def0 and def0.Range > 0 and at ~= nil then
		local cam = workspace.CurrentCamera
		if cam then
			local far = -1
			if typeof(at) == "Vector3" then
				far = def0.Range
			elseif (at :: Instance):IsA("BasePart") then
				local cut0 = cutOverride or def0.Cut
				if cut0 and cut0 <= 1.2 and not (opts and (opts.sweep or opts.gate)) then
					far = def0.Range + CULL_MARGIN
				end
			end
			if far > 0 then
				local pos = if typeof(at) == "Vector3" then at :: Vector3 else ((at :: Instance) :: BasePart).Position
				if (cam.CFrame.Position - pos).Magnitude > far then
					NetStat.count("snd.culled")
					return
				end
			end
		end
	end
	local parent: Instance
	local holder: Attachment? = nil
	if typeof(at) == "Vector3" then
		local a = Instance.new("Attachment")
		a.WorldPosition = at :: Vector3
		a.Parent = workspace.Terrain
		holder = a
		parent = a
	elseif typeof(at) == "Instance" then
		parent = at :: Instance
	else
		parent = SoundService
	end
	local s = makeSound(name, parent)
	if not s then
		if holder then
			holder:Destroy()
		end
		return
	end
	Audio.live += 1
	if Audio.live > Audio.livePeak then
		Audio.livePeak = Audio.live
	end
	if pitchJitter then
		s.PlaybackSpeed *= 1 + (math.random() * 2 - 1) * pitchJitter
	end
	if pitchScale then
		s.PlaybackSpeed *= pitchScale
	end
	if volumeScale then
		s.Volume *= volumeScale
	end
	if startAt then
		s.TimePosition = startAt
	end
	local sweep = opts and opts.sweep
	local gate = opts and opts.gate
	if gate and not sweep then
		sweep = { { 0, 1 }, { 1, 1 } } -- 음 높이 일정
	end
	if sweep then
		local pts = sweep :: { { number } } -- (reassigned 변수라 클로저 안에서 nil 검사가 풀리므로 복사해 둔다)
		local base, v0, dur = s.PlaybackSpeed, s.Volume, (opts and opts.dur) or 1
		s.Looped = true
		s.Volume = 0
		task.spawn(function()
			local t0 = os.clock()
			while s.Parent do
				local x = (os.clock() - t0) / dur
				if x >= 1 then
					break
				end
				local m = pts[#pts][2]
				for i = 2, #pts do
					if x <= pts[i][1] then
						local a, b = pts[i - 1], pts[i]
						m = a[2] + (b[2] - a[2]) * (x - a[1]) / math.max(b[1] - a[1], 1e-4)
						break
					end
				end
				s.PlaybackSpeed = base * m
				-- 시작 0.05초 페이드인, 끝 0.15초 페이드아웃
				local g = 1
				if gate then
					local ph = (x * dur) % (gate[1] + gate[2])
					g = if ph < gate[1] then math.min(1, ph / 0.015, (gate[1] - ph) / 0.015) else 0
				end
				s.Volume = v0 * g * math.min(1, x * dur / 0.05, (1 - x) * dur / 0.15)
				task.wait()
			end
			if s.Parent then
				s:Stop()
			end
		end)
	end
	s:Play()
	-- Cut: 그 시간(초)만 재생하고 짧게 줄여 끈다(여러 발짝이 든 발소리 파일에서 한 발짝만)
	local cut = cutOverride or (SND[name] and SND[name].Cut)
	if cut then
		local v0 = s.Volume
		task.delay(cut, function()
			for k = 1, 4 do
				if not s.Parent then
					return
				end
				s.Volume = v0 * (1 - k / 4)
				task.wait(0.015)
			end
			s:Stop()
		end)
	end
	-- 다 재생됐거나 멈췄으면 바로 지운다(늦어도 6초: 불러오지 못한 소리). 반복 소리(sweep)는 멈출 때
	local gone = false
	local function remove()
		if gone then
			return
		end
		gone = true
		Audio.live -= 1
		s:Destroy()
		if holder then
			holder:Destroy()
		end
	end
	s.Ended:Once(remove)
	s.Stopped:Once(remove)
	task.delay(6, remove)
	NetStat.count("snd.cpuUs", (os.clock() - cpu0) * 1e6)
end

-- 괴성: Config.Screams[kind] 의 목소리들을 시간차로 겹쳐 길게 지른다
function Audio.scream(kind: string, at: Instance)
	local seq = (Config :: any).Screams[kind]
	if not seq then
		return
	end
	for _, layer in seq do
		task.delay(layer.t, function()
			if at.Parent then
				Audio.play(layer.s, at, 0.05, layer.v, layer.p, layer.start, nil, if layer.sweep or layer.gate then { sweep = layer.sweep, dur = layer.dur, gate = layer.gate } else nil)
			end
		end)
	end
end

function Audio.sonar(localShot: boolean, origin: Vector3)
	if localShot then
		Audio.play("Sonar", nil, 0.03)
		task.delay(0.35, Audio.play, "SonarEcho", nil, 0.03)
	else
		Audio.play("Sonar", origin, 0.03)
		task.delay(0.35, Audio.play, "SonarEcho", origin, 0.03)
	end
end

-- 한 걸음: Steps 가 있으면 녹음된 여러 걸음 중 하나를(직전과 다른 것으로) 골라 재생 + Thump(낮은 툭) / Claw(괴물 발톱) 겹침
local lastStep: { [string]: number } = {}
function Audio.footstep(name: string, at: Instance, jitter: number, pitchScale: number?)
	local def = SND[name]
	if not def then
		return
	end
	local steps = def.Steps
	if steps then
		local k = math.random(1, #steps)
		if k == lastStep[name] then
			k = k % #steps + 1
		end
		lastStep[name] = k
		Audio.play(name, at, jitter, nil, pitchScale, steps[k][1], steps[k][2])
	else
		Audio.play(name, at, jitter, nil, pitchScale)
	end
	if def.Thump then
		Audio.play("FootThump", at, 0.06, def.Thump, pitchScale)
	end
	if def.Claw then
		local claw = def.Claw
		task.delay(0.07, function()
			if at.Parent then
				Audio.footstep(claw, at, 0.06)
			end
		end)
	end
end

-- ── 발소리(캐릭터마다 이동 거리 누적) ──
type Tracker = { last: Vector3, acc: number, root: BasePart, foot: number }
-- ── 괴물마다 자기 소리(Config.MonsterVoices) ──
-- voice: "1"~"5"(메인 괴물 머리 모양) / "Doppel". kind: Scream / Steps / Special / Burst. 없으면 nil
local lastVoicePick: { [string]: number } = {}
function Audio.voiceName(voice: string?, kind: string): string?
	if not voice then
		return nil
	end
	local def = (Config :: any).MonsterVoices and (Config :: any).MonsterVoices[voice]
	local ids = def and def[kind]
	if not ids or #ids == 0 then
		return nil
	end
	local key = voice .. kind
	local k = math.random(1, #ids)
	if #ids > 1 and k == lastVoicePick[key] then
		k = k % #ids + 1
	end
	lastVoicePick[key] = k
	return "Voice_" .. voice .. "_" .. kind .. "_" .. k
end
local function voiceOf(m: Model, kind: string): string?
	return Audio.voiceName(m:GetAttribute("Voice") :: string?, kind)
end
-- 괴물 발이 땅에 닿는 순간(MonsterAnim): 그 괴물 자기 걸음 소리. hit = 착지 세기(무게·속도, 약 0.3~1.6)
Audio.monsterSteps = 0 -- (테스트)
-- 괴물 발소리는 음파에 걸린 동안만 들린다(Main 이 Reveal.active 로 채운다). 그 전에는 조용히 다가온다
Audio.stepAudible = function(_m: Model): boolean
	return true
end
function Audio.monsterFoot(model: Model, at: Vector3, hit: number)
	Audio.monsterSteps += 1
	if not Audio.stepAudible(model) then
		return
	end
	local chase = model:GetAttribute("State") == "Chase"
	local vol = (if chase then 1 else Config.Monster.StepWanderVolume) * math.clamp(0.6 + hit * 0.35, 0.6, 1.3)
	local own = Audio.voiceName(model:GetAttribute("Voice") :: string?, "Steps")
	if own then
		Audio.play(own, at, 0.06, vol, if model:GetAttribute("Voice") == "Flower" then 0.75 else nil)
	else
		Audio.play("MonsterStep", at, 0.08, vol)
	end
end

-- 도플갱어의 사람 모습이 터질 때(서버 RoundEvent "DoppelBurst"): 살 찢어짐 + 뼈 우두둑(없으면 낮게 꺾이는 소리)
Audio.bursts = 0 -- (테스트) 터지는 소리를 낸 횟수
function Audio.doppelBurst(at: Vector3)
	Audio.bursts += 1
	local def = (Config :: any).MonsterVoices and (Config :: any).MonsterVoices.Doppel
	if def and def.Burst then
		for k = 1, #def.Burst do
			Audio.play("Voice_Doppel_Burst_" .. k, at, 0.03)
		end
	else
		Audio.play("Door", at, 0.04, 1.4, 0.45)
		Audio.play("FootRun", at, 0.1, 1.2, 0.5)
	end
end

-- 쫓아올 때 괴성: 그 괴물 자기 괴성(없으면 공통 괴성)
local function chaseScream(m: Model, root: BasePart)
	local n = voiceOf(m, "Scream")
	if n then
		Audio.play(n, root, 0.03)
	else
		Audio.scream("Chase", root)
	end
end

local trackers: { [Model]: Tracker } = {}
-- 한 발짝 거리(스터드): 걷기 10/초면 초당 약 2발, 달리기 18/초면 약 2.8발, 웅크리기 5/초면 약 1.7발
local STRIDE = { Walk = 4.8, Run = 6.5, Crouch = 3.0 }

local function stepFor(model: Model, root: BasePart, isMonster: boolean)
	local tr = trackers[model]
	if not tr or tr.root ~= root then
		tr = { last = root.Position, acc = 0, root = root, foot = 1 }
		trackers[model] = tr
	end
	local p = root.Position
	local d = Vector3.new(p.X - tr.last.X, 0, p.Z - tr.last.Z).Magnitude
	tr.last = p
	if d > 6 then
		return -- 순간 이동
	end
	tr.acc += d
	local form = model:GetAttribute("Form")
	if isMonster and not Audio.stepAudible(model) then
		-- (음파에 걸리기 전: 괴물 발소리 없음)
		if tr.acc >= 4.6 then
			tr.acc = 0
		end
		return
	end
	if isMonster and form == "Disguise" then
		-- 도플갱어(사람 모습): 플레이어와 똑같은 발소리
		if tr.acc >= STRIDE.Walk then
			tr.acc = 0
			Audio.footstep("FootWalk", root, 0)
		end
	elseif isMonster and (model:GetAttribute("Rig") == 2 or model:GetAttribute("Rig") == 3 or model:GetAttribute("Rig") == 4) then
		-- 전신 뼈대 괴물: 발이 실제로 땅에 닿는 순간 MonsterAnim 이 Audio.monsterFoot 을 부른다
		tr.acc = 0
	elseif isMonster then
		if tr.acc >= 4.6 then -- 사람(4.8)과 비슷한 거리지만 괴물은 느려서 쿵… 쿵… 간격이 더 길다
			tr.acc = 0
			-- 배회할 때는 조금 작게, 쫓아올 때는 크게. 도플갱어(작은 괴물)는 조금 높고 가벼운 발소리
			local chase = model:GetAttribute("State") == "Chase"
			local vol = if chase then 1 else Config.Monster.StepWanderVolume
			local own = voiceOf(model, "Steps")
			if own then
				-- 그 괴물 자기 걸음 소리(발 끌기·나무 딱딱·손톱 톡톡·쿵·곤충 걸음)
				Audio.play(own, root, 0.06, vol, if model:GetAttribute("Voice") == "Flower" then 0.75 else nil)
			else
				local small = model:GetAttribute("Form") ~= nil
				Audio.play("MonsterStep", root, 0.08, vol * (if small then 0.85 else 1), if small then 1.25 else nil)
			end
		end
	else
		local mode = (model:GetAttribute("MoveMode") :: string?) or "Walk"
		local stride = STRIDE[mode] or 3.6
		if tr.acc >= stride then
			tr.acc = 0
			tr.foot = -tr.foot
			local name = if mode == "Run" then "FootRun" elseif mode == "Crouch" then "FootCrouch" else "FootWalk"
			-- 매 걸음 똑같은 깔끔한 한 번의 소리(피치 흔들림·왼발/오른발 차이 없음)
			Audio.footstep(name, root, 0)
			Audio.steps += 1
		end
	end
end

-- ── 괴물 상태 반응음 ──
local monsterConns: { [Model]: { RBXScriptConnection } } = {}
local screamAt: { [Model]: number } = {} -- 추격 중 다음 괴성 시각
local CHASE_SCREAM_GAP = { 10, 15 } -- 추격 중 괴성 사이 간격(초, 범위). 쫓기 시작할 때 한 번 지르고, 그 뒤로는 10~15초에 한 번(너무 자주 지르지 않게)
local function watchMonster(m: Instance)
	if not m:IsA("Model") or monsterConns[m] then
		return
	end
	local model = m :: Model
	local conns = {}
	table.insert(conns, model:GetAttributeChangedSignal("State"):Connect(function()
		local st = model:GetAttribute("State")
		local root = model.PrimaryPart
		if not root then
			return
		end
		-- 괴성은 플레이어를 발견해 쫓기 시작할 때만(배회·조사·수색·경계에는 지르지 않는다). 발소리는 평소에도 난다
			if st == "Chase" then
				chaseScream(model, root)
				screamAt[model] = os.clock() + CHASE_SCREAM_GAP[1] + math.random() * (CHASE_SCREAM_GAP[2] - CHASE_SCREAM_GAP[1])
			elseif st == "Alert" then
				-- 소리를 듣고 멈칫: 그 괴물의 특수 소리(머리 돌리는 뼈 소리, 상체 꺾이는 와르르, 씹는 소리)
				local sp = voiceOf(model, "Special")
				if sp then
					Audio.play(sp, root, 0.04)
				end
			end
	end))
	-- 도플갱어: 가짜 음파 소리, 사람 모습이 터질 때 소리
	-- (가짜 음파 소리는 SonarPulse 로 진짜 음파처럼 난다)
	table.insert(conns, model:GetAttributeChangedSignal("Form"):Connect(function()
		local root = model.PrimaryPart
		local form = model:GetAttribute("Form")
		if root and model:GetAttribute("Voice") == "Flower" then
			-- 꽃괴물: 꽃잎이 펼쳐질 때 뼈·살 소리 → 다 펼치면 질척, 닫을 때는 낮은 질척
			if form == "Open" then
				local n = Audio.voiceName("Flower", "Unfold")
				if n then
					Audio.play(n, root, 0.03)
				end
				task.delay((Config :: any).Flower.WakeTime, function()
					local q = Audio.voiceName("Flower", "Squelch")
					if q and root.Parent then
						Audio.play(q, root, 0.03)
					end
				end)
			elseif form == "Bud" then
				local q = Audio.voiceName("Flower", "Squelch")
				if q then
					Audio.play(q, root, 0.03, 0.7, 0.75)
				end
			end
		end
		-- (도플갱어가 터지는 소리는 Form 속성이 아니라 DoppelBurst 이벤트에서 낸다: 서버가 Bursting → Beast 를
		-- 같은 프레임에 바꿔서 클라이언트에는 Bursting 이 도착하지 않는다. Audio.doppelBurst 참고)
	end))
	monsterConns[model] = conns
	
	model.Destroying:Connect(function()
		for _, c in conns do
			c:Disconnect()
		end
		monsterConns[model] = nil
		screamAt[model] = nil
		trackers[model] = nil
	end)
end
CollectionService:GetInstanceAddedSignal(Config.Tags.Monster):Connect(watchMonster)
-- (복제된 괴물이 지워질 때 Destroying 이 오지 않는 경우에도 표가 남지 않게)
CollectionService:GetInstanceRemovedSignal(Config.Tags.Monster):Connect(function(m: Instance)
	local conns = monsterConns[m :: Model]
	if conns then
		for _, c in conns do
			c:Disconnect()
		end
		monsterConns[m :: Model] = nil
		screamAt[m :: Model] = nil
		trackers[m :: Model] = nil
	end
end)
for _, m in CollectionService:GetTagged(Config.Tags.Monster) do
	watchMonster(m)
end

-- ── 문 ──
local function watchDoor(m: Instance)
	if not m:IsA("Model") then
		return
	end
	m:GetAttributeChangedSignal("Open"):Connect(function()
		local panel = m:FindFirstChild("Panel")
		if panel then
			Audio.play("Door", (panel :: BasePart).Position, 0.08)
		end
	end)
end
CollectionService:GetInstanceAddedSignal(Config.Tags.Door):Connect(watchDoor)
for _, m in CollectionService:GetTagged(Config.Tags.Door) do
	watchDoor(m)
end

-- ── 환경음 ──
local hum: Sound? = makeSound("AmbientHum", SoundService, true)
if hum then
	hum:Play()
end
local emitters: { [Instance]: Sound } = {}
local function addEmitter(e: Instance)
	if emitters[e] or not e:IsA("BasePart") then
		return
	end
	local name = (e:GetAttribute("Sound") :: string?) or "AmbientFan"
	local s = makeSound(name, e, true)
	if s then
		s.TimePosition = math.random() * 2
		s:Play()
		emitters[e] = s
	end
	e.Destroying:Connect(function()
		emitters[e] = nil
	end)
end
CollectionService:GetInstanceAddedSignal(Config.Tags.AmbientEmitter):Connect(addEmitter)
for _, e in CollectionService:GetTagged(Config.Tags.AmbientEmitter) do
	addEmitter(e)
end

local nextAmbient = os.clock() + 4
local nextSweep = 0
local ONE_SHOTS = { "AmbientCreak" } -- 물방울·폭발음 같은 금속음은 뺐다

function Audio.update()
	-- 발소리
	for _, plr in Players:GetPlayers() do
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if char and root and plr:GetAttribute("Status") == "Alive" then
			stepFor(char, root, false)
		end
	end
	local now = os.clock()
	for m in monsterConns do
		if m.PrimaryPart and m.Parent then
			-- 발소리는 늘 난다(움직일 때). 괴성은 쫓아올 때만
			stepFor(m, m.PrimaryPart, true)
			if m:GetAttribute("State") == "Chase" then
				local at = screamAt[m]
				if at and now > at then
					screamAt[m] = now + CHASE_SCREAM_GAP[1] + math.random() * (CHASE_SCREAM_GAP[2] - CHASE_SCREAM_GAP[1])
					chaseScream(m, m.PrimaryPart)
				end
			end
		end
	end
	-- 먼 곳의 물방울·금속음·구조물 삐걱임(무작위 위치)
	if now > nextAmbient then
		nextAmbient = now + 4 + math.random() * 8
		local cam = workspace.CurrentCamera
		if cam then
			local ang = math.random() * math.pi * 2
			local r = 15 + math.random() * 35
			local p = cam.CFrame.Position + Vector3.new(math.cos(ang) * r, math.random() * 6 - 2, math.sin(ang) * r)
			Audio.play(ONE_SHOTS[math.random(1, #ONE_SHOTS)], p, 0.15)
		end
	end
	if now > nextSweep then
		nextSweep = now + 1
		for model, _ in trackers do
			if not model.Parent then
				trackers[model] = nil
			end
		end
	end
end

-- ── (Studio 전용) 괴물 소리 미리 듣기: Play 중 숫자키 1~4 = 목록 9~12번(4번 웅웅 + 비명) ──
-- 게시된 게임에서는 동작하지 않는다.
local function playClip(id: number, start: number, dur: number, vol: number)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Volume = vol
	s.SoundGroup = master
	s.Parent = SoundService
	s.TimePosition = start
	s:Play()
	task.delay(dur, function()
		for k = 1, 5 do
			s.Volume = vol * (1 - k / 5)
			task.wait(0.03)
		end
		s:Destroy()
	end)
end
function Audio.previewScream(index: number)
	local r = (Config :: any).RealScreams[index]
	if not r then
		return
	end
	local k = (Config :: any).MonsterLoudness or 1 -- (게임 속 가까이에서 듣는 크기와 같게)
	playClip(r.Id, r.Start, r.Dur, r.Volume * k)
	if r.Layer then
		task.delay(r.Layer.Delay, playClip, r.Layer.Id, r.Layer.Start, r.Layer.Dur, r.Layer.Volume * k)
	end
end
if game:GetService("RunService"):IsStudio() then
	local keys = { [Enum.KeyCode.One] = 9, [Enum.KeyCode.Two] = 10, [Enum.KeyCode.Three] = 11, [Enum.KeyCode.Four] = 12 }
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		local idx = keys[input.KeyCode]
		if idx and not processed then
			Audio.previewScream(idx)
		end
	end)
end

return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="261">
        <Properties>
          <string name="Name">CreatureAnim</string>
          <string name="Source"><![CDATA[--!strict
-- 챕터 괴물(Rig = 3) 전용 애니메이션 구동기. 괴물마다 뼈 구조와 이동 방식이 달라서,
-- 모델 속성 Creature(예 "c1h")에 맞는 모듈 Creatures/<id>.luau 의 step(body, dt) 이 뼈(Motor6D)를 직접 움직인다.
-- 공용 두 팔·두 다리 MonsterAnim(Rig = 2)과는 따로 돈다.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local SpriteAnim = require(script.Parent:WaitForChild("SpriteAnim"))
local RigAnim = require(script.Parent:WaitForChild("RigAnim"))

local CreatureAnim = {}
CreatureAnim.range = 170
CreatureAnim.onStep = nil :: ((Model, Vector3, number) -> ())?
CreatureAnim.stats = {} :: { [string]: { frames: number, steps: number, maxAngle: number } }

export type Body = {
	model: Model,
	root: BasePart,
	id: string,
	m: { [string]: Motor6D }, -- 뼈 이름 → 모터
	rest: { [string]: CFrame }, -- 모터 C0(쉬는 자세)
	tip: { [string]: Vector3 }, -- 뼈 길이 벡터(Tip 속성)
	t: number, -- 누적 시간
	phase: number, -- 보행 위상(괴물 모듈이 쓴다)
	speed: number, -- 수평 속도(부드럽게)
	vel: Vector3, -- 루트 기준 속도(부드럽게)
	state: string,
	data: { [string]: any }, -- 괴물 모듈 마음대로
	step: (at: Vector3, hit: number) -> (), -- 착지 소리
}

local mods: { [string]: any } = {}
local function modFor(id: string): any
	if mods[id] == nil then
		local folder = script.Parent:FindFirstChild("Creatures")
		local ms = folder and folder:FindFirstChild(id)
		mods[id] = if ms and ms:IsA("ModuleScript") then require(ms) :: any else false
	end
	return mods[id] or nil
end

local bodies: { [Model]: Body } = {}
local function build(model: Model, id: string): Body?
	local root = model.PrimaryPart
	if not root then
		return nil
	end
	local m: { [string]: Motor6D } = {}
	local rest: { [string]: CFrame } = {}
	local tip: { [string]: Vector3 } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and string.sub(d.Name, 1, 2) == "B_" then
			local name = string.sub(d.Name, 3)
			m[name] = d
			rest[name] = d.C0
			local t = d.Part1 and d.Part1:GetAttribute("Tip")
			tip[name] = if typeof(t) == "Vector3" then t else Vector3.zero
		end
	end
	local b: Body
	b = {
		model = model,
		root = root,
		id = id,
		m = m,
		rest = rest,
		tip = tip,
		t = math.random() * 10,
		phase = math.random(),
		speed = 0,
		vel = Vector3.zero,
		state = "Wander",
		data = {},
		step = function(at: Vector3, hit: number)
			local st = CreatureAnim.stats[id]
			if st then
				st.steps += 1
			end
			if CreatureAnim.onStep then
				CreatureAnim.onStep(model, at, hit)
			end
		end,
	}
	CreatureAnim.stats[id] = CreatureAnim.stats[id] or { frames = 0, steps = 0, maxAngle = 0 }
	return b
end

-- 공용 도구 ------------------------------------------------------------
-- 뼈 하나를 쉬는 자세 기준으로 회전(라디안, 뼈 로컬 축 X=끄덕, Y=좌우, Z=기울기)
function CreatureAnim.pose(b: Body, name: string, rx: number, ry: number, rz: number, offset: Vector3?)
	local mo = b.m[name]
	if not mo then
		return
	end
	mo.Transform = (if offset then CFrame.new(offset) else CFrame.identity) * CFrame.fromEulerAnglesYXZ(rx, ry, rz)
	local st = CreatureAnim.stats[b.id]
	if st then
		st.maxAngle = math.max(st.maxAngle, math.abs(rx), math.abs(ry), math.abs(rz))
	end
end
-- 0~1 위상에서 부드러운 파형
function CreatureAnim.wave(p: number): number
	return math.sin(p * math.pi * 2)
end
-- 발 들기 곡선(0~1 → 0 → 1 → 0, duty 비율만큼만 들림)
function CreatureAnim.lift(p: number, duty: number): number
	local q = (p % 1) / duty
	return if q < 1 then math.sin(q * math.pi) else 0
end
function CreatureAnim.approach(cur: number, target: number, rate: number, dt: number): number
	return cur + (target - cur) * (1 - math.exp(-rate * dt))
end

local Perf = require(script.Parent:WaitForChild("Perf"))
RunService.RenderStepped:Connect(function(dt)
	local perf0 = os.clock()
	dt = math.min(dt, 1 / 20)
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	for _, inst in CollectionService:GetTagged(Config.Tags.Monster) do
		local model = inst :: Model
		if model:IsA("Model") and model.Parent and model:GetAttribute("Rig") == 4 then
			-- 시안 챕터 괴물: 3D 뼈 메시가 있으면 뼈를 움직이고, 아직 메시가 없으면 시안 그림(8방향 × 9자세)
			local root4 = model.PrimaryPart
			if root4 and (root4.Position - camPos).Magnitude > CreatureAnim.range then
				-- (아주 멀다: 뼈·그림 둘 다 건너뛴다. 걸음 소리도 들리지 않는 거리)
			elseif RigAnim.has(model) then
				RigAnim.step(model, dt)
			else
				SpriteAnim.step(model, dt, camPos)
			end
		elseif model:IsA("Model") and model.Parent and model:GetAttribute("Rig") == 3 then
			local id = model:GetAttribute("Creature")
			local root = model.PrimaryPart
			if typeof(id) == "string" and root and (root.Position - camPos).Magnitude < CreatureAnim.range then
				local mod = modFor(id)
				if mod then
					local b = bodies[model]
					if not b or b.root ~= root then
						b = build(model, id)
						if b then
							bodies[model] = b
							if mod.init then
								mod.init(b)
							end
						end
					end
					if b then
						local v = root.AssemblyLinearVelocity
						local flat = Vector3.new(v.X, 0, v.Z)
						b.speed = CreatureAnim.approach(b.speed, flat.Magnitude, 8, dt)
						b.vel = b.vel:Lerp(root.CFrame:VectorToObjectSpace(flat), math.min(1, dt * 8))
						b.state = (model:GetAttribute("State") :: string?) or "Wander"
						b.t += dt
						mod.step(b, dt)
						local st = CreatureAnim.stats[id]
						if st then
							st.frames += 1
						end
					end
				end
			end
		end
	end
	for model in bodies do
		if not model.Parent then
			bodies[model] = nil
		end
	end
	SpriteAnim.cleanup()
	RigAnim.cleanup()
	Perf.add("creatureAnim", os.clock() - perf0)
end)

function CreatureAnim.reset()
	for _, st in CreatureAnim.stats do
		st.frames, st.steps, st.maxAngle = 0, 0, 0
	end
end

return CreatureAnim
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="262">
        <Properties>
          <string name="Name">Creatures</string>
        </Properties>
        <Item class="ModuleScript" referent="263">
          <Properties>
            <string name="Name">c10h</string>
            <string name="Source"><![CDATA[--!strict
-- c10h 안내원: 다리만 사람처럼 걷고 등은 늘 수평(골반 출렁임을 상체가 되돌려 등 높이 고정).
-- 머리는 깃에서 매달린 진자(걸음마다 앞뒤 ±6°, 늦게 따라옴), 연미복 꼬리도 흔들림. 추격은 등을 편 채 종종걸음.
-- 서버 Aim(도) = 상체·빔 yaw(훑기·소리 쪽). Rise = 들킨 순간 일어서기(허리 펴짐 0.4초, 머리가 뒤로 꺾여 매달림).
local Players = game:GetService("Players")
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local DUTY = 0.6
local REF = 3.5

local function angOf(z: number, y: number): number
	return math.atan2(-z, -y)
end

local function legIK(b: A.Body, thigh: string, shin: string, hip: Vector3, target: Vector3, parentRx: number): (number, number)
	local T0, S0 = b.tip[thigh], b.tip[shin]
	local l1 = math.sqrt(T0.Y * T0.Y + T0.Z * T0.Z)
	local l2 = math.sqrt(S0.Y * S0.Y + S0.Z * S0.Z)
	local dy, dz = target.Y - hip.Y, target.Z - hip.Z
	local dist = math.clamp(math.sqrt(dy * dy + dz * dz), math.abs(l1 - l2) + 0.01, l1 + l2 - 0.002)
	local phi = angOf(dz, dy)
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local a2 = math.acos(math.clamp((l2 * l2 + dist * dist - l1 * l1) / (2 * l2 * dist), -1, 1))
	local thighRx = (phi + a1) - angOf(T0.Z, T0.Y) - parentRx
	local shinRx = (phi - a2) - angOf(S0.Z, S0.Y) - thighRx - parentRx
	return thighRx, shinRx
end

local function footCurve(phase: number, prev: number, o: number, stride: number, lift: number): (number, number, number, boolean)
	local q, qp = (phase + o) % 1, (prev + o) % 1
	local half = DUTY * stride / 2
	local z, h, pitch
	if q < DUTY then
		local s = q / DUTY
		z = -half + 2 * half * s
		h = 0
		pitch = if s < 0.2 then 0.25 * (1 - s / 0.2) elseif s > 0.75 then -0.35 * (s - 0.75) / 0.25 else 0
	else
		local s = (q - DUTY) / (1 - DUTY)
		z = half - 2 * half * (0.5 - 0.5 * math.cos(s * math.pi))
		h = lift * math.sin(s * math.pi)
		pitch = if s < 0.35 then -0.35 * (1 - s / 0.35) else 0.25 * (s - 0.35) / 0.65
	end
	if pitch < 0 then
		h += -pitch * 0.6
	end
	return z, h, pitch, qp > q
end

local function nearestDist(pos: Vector3): number
	local best = math.huge
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r then
			best = math.min(best, (r.Position - pos).Magnitude)
		end
	end
	return best
end

function M.init(b: A.Body)
	b.data.amp = 0
	b.data.yaw = 0
	b.data.head = 0
	b.data.tail = 0
	b.data.lastRise = b.model:GetAttribute("Rise")
	b.data.rise = -1
	b.data.stand = 0
	b.data.check = 0
	b.data.close = false
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	d.amp = A.approach(d.amp, math.clamp(b.speed / REF, 0, 1.6), 7, dt)
	local amp = math.min(d.amp, 1)
	local trot = math.clamp((b.speed - 6) / 3, 0, 1) -- 추격 종종걸음: 보폭은 조금만 늘고 박자가 빨라진다
	local stride = 3.6 + 0.6 * trot
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / stride) % 1
	local ph = b.phase
	local dir = if b.vel.Z > 0.5 then -1 else 1
	-- 골반: 좌우 0.15 · 위아래(다리가 거의 펴져 있어 보폭에 맞춰 내려감)
	local l = b.tip.kneeL.Magnitude + b.tip.ankleL.Magnitude
	local half = DUTY * stride / 2 * amp
	local dip = l - math.sqrt(math.max(0.1, l * l - half * half))
	local bob = (-dip - 0.04 - 0.1 * math.cos(ph * math.pi * 4)) * amp
	local sway = -0.15 * math.cos((ph - DUTY / 2) * math.pi * 2) * amp
	local pOff = Vector3.new(sway, bob, 0)
	A.pose(b, "pelvis", 0, 0, 0, pOff)
	local pelvisPos = b.rest.pelvis.Position + pOff
	for i, n in { "L", "R" } do
		local hip = pelvisPos + b.rest["hip" .. n].Position + b.rest["knee" .. n].Position
		local ankle = b.rest.pelvis.Position + b.rest["hip" .. n].Position + b.rest["knee" .. n].Position + b.tip["knee" .. n] + b.tip["ankle" .. n]
		local z, h, pitch, contact = footCurve(ph, prev, if i == 1 then 0 else 0.5, stride, 0.35 - 0.1 * trot)
		local target = ankle + Vector3.new(0, h * amp, z * amp * dir)
		local tRx, sRx = legIK(b, "knee" .. n, "ankle" .. n, hip, target, 0)
		A.pose(b, "knee" .. n, tRx, 0, 0)
		A.pose(b, "ankle" .. n, sRx, 0, 0)
		A.pose(b, "toe" .. n, pitch * amp - tRx - sRx, 0, 0)
		if contact and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), math.clamp(b.speed / 8, 0.4, 1.2)) -- 딱딱한 구두
		end
	end
	-- 일어서기: 들킨 순간(Rise) 0.4초 + 추격 중 아주 가까우면 허리가 펴진다
	local rs = b.model:GetAttribute("Rise")
	if rs ~= d.lastRise then
		d.lastRise = rs
		d.rise = 0
	end
	local standT = 0
	if d.rise >= 0 then
		d.rise += dt
		standT = if d.rise < 0.9 then 1 else 0
		if d.rise >= 0.9 then
			d.rise = -1
		end
	end
	d.check -= dt
	if d.check <= 0 then
		d.check = 0.15
		d.close = b.state == "Chase" and nearestDist(b.root.Position) < 4
	end
	if d.close then
		standT = 1
	end
	d.stand = A.approach(d.stand, standT, if standT > d.stand then 9 else 4, dt)
	-- 상체 yaw(서버 Aim, 도): 빔이 함께 돈다
	local aim = b.model:GetAttribute("Aim")
	local yawT = if typeof(aim) == "number" then math.rad(aim) else 0
	d.yaw = A.approach(d.yaw, yawT, 6, dt)
	-- 등은 수평 유지: 골반 출렁임을 spine1 이 되돌린다. 일어서면 허리가 84° 펴짐
	A.pose(b, "spine1", math.rad(84) * d.stand, d.yaw, -sway * 0.2, Vector3.new(-sway, -bob, 0))
	-- 매달린 머리: 진자(걸음마다 앞뒤 ±6°, 늦게), 일어서면 뒤로 꺾여 매달림
	local headT = math.rad(6) * math.sin((ph - 0.15) * math.pi * 4) * amp + 0.03 * math.sin(b.t * 0.8)
	d.head = A.approach(d.head, headT, 5, dt)
	A.pose(b, "neck", d.head - math.rad(90) * d.stand, 0, d.head * 0.4)
	A.pose(b, "head", d.head * 0.5, 0, 0)
	-- 연미복 꼬리: 걸음·종종걸음에 펄럭
	local tailT = 0.2 * math.sin(ph * math.pi * 4 - 1) * amp + 0.35 * trot
	d.tail = A.approach(d.tail, tailT, 6, dt)
	A.pose(b, "tailL", -d.tail, 0, 0)
	A.pose(b, "tailR", -d.tail * 0.85, 0, 0)
	-- 손전등 팔: 걸을 때도 빔이 등받이 높이에서 흔들리지 않게 거의 고정, 미세한 떨림만
	A.pose(b, "wristR", 0.01 * math.sin(b.t * 3.3), 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="264">
          <Properties>
            <string name="Name">c10n</string>
            <string name="Source"><![CDATA[--!strict
-- c10n 앞줄 손님: 앉은 L 자 덩어리 그대로 움직인다(다리 관절 없음).
-- 서버 Vault = 한 줄 넘기: 잡기 0.3(두 팔을 뒤로 꺾어 팔꿈치가 머리 위로 솟고 손이 제 등받이 꼭대기를 쥠) →
--   넘기 0.4(덩어리째 등받이 축으로 −105° 통째 회전, 몸을 굽히지 않음) → 앉기 0.2(제자리로 떨어지며 '탕' = b.step 크게).
-- 평지 끌기: 손목을 바닥 쪽으로 뻗어 번갈아 당기고 덩어리가 앞뒤로 흔들림(당길 때마다 b.step 작게).
-- 긴 목은 스프링처럼 늦게 따라 흔들리고 머리는 늘 화면 쪽(+Z).
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local GRIP, FLIP, LAND = 0.3, 0.4, 0.2
local PULL = 1.2 -- 한 번 당길 때 나아가는 거리

local function rotTo(a: Vector3, b: Vector3): CFrame
	local au, bu = a.Unit, b.Unit
	local c = au:Cross(bu)
	local s = c.Magnitude
	if s < 1e-5 then
		return CFrame.identity
	end
	return CFrame.fromAxisAngle(c / s, math.atan2(s, au:Dot(bu)))
end

local function setRot(b: A.Body, name: string, cf: CFrame)
	local rx, ry, rz = cf:ToEulerAnglesYXZ()
	A.pose(b, name, rx, ry, rz)
end

-- 2마디 IK(Mass 기준 쉬는 자세 좌표 — 팔의 부모 뼈들은 돌리지 않는다)
local function ik2(b: A.Body, upper: string, lower: string, j: Vector3, t: Vector3, pole: Vector3)
	local T0, S0 = b.tip[upper], b.tip[lower]
	local l1, l2 = T0.Magnitude, S0.Magnitude
	local dv = t - j
	local dist = math.clamp(dv.Magnitude, math.abs(l1 - l2) + 0.02, l1 + l2 - 0.01)
	local u = dv.Unit
	local w = pole - u * pole:Dot(u)
	w = if w.Magnitude > 1e-4 then w.Unit else Vector3.yAxis
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local elbow = j + u * (l1 * math.cos(a1)) + w * (l1 * math.sin(a1))
	local r1 = rotTo(T0, elbow - j)
	setRot(b, upper, r1)
	setRot(b, lower, rotTo(S0, r1:VectorToObjectSpace(j + u * dist - elbow)))
end

local function restAbs(b: A.Body): { [string]: Vector3 }
	local out: { [string]: Vector3 } = {}
	local function get(n: string): Vector3
		local v = out[n]
		if v then
			return v
		end
		local mo = b.m[n]
		local p = mo and mo.Part0
		v = b.rest[n].Position
		if p and string.sub(p.Name, 1, 5) == "Bone_" then
			v += get(string.sub(p.Name, 6))
		end
		out[n] = v
		return v
	end
	for n in b.m do
		get(n)
	end
	return out
end

function M.init(b: A.Body)
	local d = b.data
	d.abs = restAbs(b)
	d.vault = -1
	d.lastVault = b.model:GetAttribute("Vault")
	d.amp = 0
	d.n1, d.n1v = 0, 0
	d.landed = false
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	local va = b.model:GetAttribute("Vault")
	if va ~= d.lastVault then
		d.lastVault = va
		d.vault = 0
		d.landed = false
	end
	local massRx, massOff = 0, Vector3.zero
	local grip = 0 -- 0 = 대기 팔, 1 = 등받이 잡기
	if d.vault >= 0 then
		d.vault += dt
		local t = d.vault
		if t < GRIP then
			grip = t / GRIP
		elseif t < GRIP + FLIP then
			grip = 1
			local k = (t - GRIP) / FLIP
			massRx = -math.rad(105) * (k * k * (3 - 2 * k))
		elseif t < GRIP + FLIP + LAND then
			grip = 1
			local k = (t - GRIP - FLIP) / LAND
			massRx = -math.rad(105) * (1 - k)
			massOff = Vector3.new(0, 0.8 * (1 - k * k), 0)
		else
			if not d.landed then
				d.landed = true
				b.step(b.root.Position + Vector3.new(0, -2.4, 0), 1.6) -- 탕!
				d.n1v += 4
			end
			grip = math.max(0, 1 - (t - GRIP - FLIP - LAND) / 0.4)
			if t > GRIP + FLIP + LAND + 0.4 then
				d.vault = -1
			end
		end
	end
	-- 평지 끌기(넘는 중이 아닐 때): 덩어리가 당길 때마다 앞뒤로 흔들림
	local dragging = d.vault < 0
	d.amp = A.approach(d.amp, if dragging then math.clamp(b.speed / 2, 0, 1.2) else 0, 5, dt)
	local prev = b.phase
	if dragging then
		b.phase = (b.phase + b.speed * dt / PULL) % 1
	end
	local ph = b.phase
	local rock = math.sin(ph * math.pi * 2) * d.amp
	A.pose(b, "Mass", massRx + 0.06 * rock, 0, 0, massOff)
	if dragging and d.amp > 0.3 and (prev % 0.5) > (ph % 0.5) then
		b.step(b.root.Position + Vector3.new(0, -2.4, 0), 0.5) -- 손바닥 끌기
	end
	-- 팔: 대기(손목이 무릎 사이로 처짐) / 끌기(진행 쪽 −Z 바닥으로 번갈아 뻗음) / 잡기(팔꿈치가 머리 위로, 손은 등받이 꼭대기)
	for i, n in { "L", "R" } do
		local s = if i == 1 then -1 else 1
		local j = d.abs["UpperArm" .. n]
		local idle = d.abs["UpperArm" .. n] + b.tip["UpperArm" .. n] + b.tip["Forearm" .. n] + Vector3.new(0, 0.05 * math.sin(b.t * 1.3 + i), 0)
		local reach = math.max(0, math.sin(ph * math.pi * 2 + (if i == 1 then 0 else math.pi)))
		local drag = Vector3.new(1.1 * s, 1.0 + 0.6 * (1 - reach), -0.6 - 1.2 * reach)
		local t = idle:Lerp(Vector3.new(drag.X, d.abs.Mass.Y - 3.45 + drag.Y, drag.Z), math.min(d.amp, 1))
		local gp = Vector3.new(0.55 * s, d.abs.Mass.Y, d.abs.Mass.Z) -- 제 등받이 꼭대기(= 넘기 축)
		t = t:Lerp(gp, grip)
		local pole = Vector3.new(0.4 * s, 0, 1):Lerp(Vector3.new(0.3 * s, 1, -0.2), grip)
		ik2(b, "UpperArm" .. n, "Forearm" .. n, j, t, pole)
	end
	-- 긴 목: 스프링(덩어리 흔들림·착지에 늦게 따라옴), 머리는 화면 쪽으로 되돌아감
	local force = -18 * d.n1 - 3 * d.n1v - 1.5 * rock
	d.n1v += force * dt
	d.n1 += d.n1v * dt
	A.pose(b, "NeckTop", d.n1 * 0.25 + 0.03 * math.sin(b.t * 0.9), 0.05 * math.sin(b.t * 0.4), 0)
	A.pose(b, "Head", -d.n1 * 0.15 - massRx * 0.1, 0.08 * math.sin(b.t * 0.37), 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="265">
          <Properties>
            <string name="Name">c1h</string>
            <string name="Source"><![CDATA[--!strict
-- c1h 발맞춤: 사람 두 발 보행(뒤꿈치 → 발바닥 → 발끝). 골반 띠가 디딤발 쪽으로 3° 기울고 좌우 0.12 흔들리며 디딤 가운데서 솟음.
-- 보행 위상은 루트의 실제 이동 거리에 묶여 있어(관성 없음) 서버가 속도 0 을 주는 순간 그 자세 그대로 굳는다 — 한 발 든 채.
-- 멈춘 뒤 0.6초에 딱 한 번 발소리(마지막 걸음). 달리면 보폭이 1.5배. 아래팔은 다리 반대 위상 진자(±20°).
-- 추격 중 3 안이면 쐐기 받침째 머리가 앞으로 84° 꺾여 얼굴이 처음 보인다. 붉은 케이블은 늦게 따라 흔들리는 사슬.
local Players = game:GetService("Players")
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local DUTY = 0.6
local STRIDE = 2.2

local function rotTo(a: Vector3, b: Vector3): CFrame
	local au, bu = a.Unit, b.Unit
	local c = au:Cross(bu)
	local s = c.Magnitude
	if s < 1e-5 then
		return CFrame.identity
	end
	return CFrame.fromAxisAngle(c / s, math.atan2(s, au:Dot(bu)))
end

local function setRot(b: A.Body, name: string, cf: CFrame, offset: Vector3?)
	local rx, ry, rz = cf:ToEulerAnglesYXZ()
	A.pose(b, name, rx, ry, rz, offset)
end

local function ik2(b: A.Body, upper: string, lower: string, j: Vector3, t: Vector3, pole: Vector3, pr: CFrame): CFrame
	local T0, S0 = b.tip[upper], b.tip[lower]
	local l1, l2 = T0.Magnitude, S0.Magnitude
	local dv = t - j
	local dist = math.clamp(dv.Magnitude, math.abs(l1 - l2) + 0.02, l1 + l2 - 0.01)
	local u = dv.Unit
	local w = pole - u * pole:Dot(u)
	w = if w.Magnitude > 1e-4 then w.Unit else -Vector3.zAxis
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local elbow = j + u * (l1 * math.cos(a1)) + w * (l1 * math.sin(a1))
	local r1 = rotTo(T0, pr:VectorToObjectSpace(elbow - j))
	local r2 = rotTo(S0, (pr * r1):VectorToObjectSpace(j + u * dist - elbow))
	setRot(b, upper, r1)
	setRot(b, lower, r2)
	return pr * r1 * r2
end

local function restAbs(b: A.Body): { [string]: Vector3 }
	local out: { [string]: Vector3 } = {}
	local function get(n: string): Vector3
		local v = out[n]
		if v then
			return v
		end
		local mo = b.m[n]
		local p = mo and mo.Part0
		v = b.rest[n].Position
		if p and string.sub(p.Name, 1, 5) == "Bone_" then
			v += get(string.sub(p.Name, 6))
		end
		out[n] = v
		return v
	end
	for n in b.m do
		get(n)
	end
	return out
end

local function nearestDist(pos: Vector3): number
	local best = math.huge
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r then
			best = math.min(best, (r.Position - pos).Magnitude)
		end
	end
	return best
end

function M.init(b: A.Body)
	local d = b.data
	d.abs = restAbs(b)
	d.amp = 0
	d.still = 0
	d.moving = false
	d.extraAt = -1
	d.snap = 0
	d.check = 0
	d.close = false
	d.freeze = 0
	d.c1, d.c1v, d.c2, d.c2v = 0, 0, 0, 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	-- 관성 없는 실제 속도(부드럽게 하지 않음): 멈추면 그 프레임에 위상이 선다
	local v = b.root.AssemblyLinearVelocity
	local raw = Vector3.new(v.X, 0, v.Z).Magnitude
	if raw > 0.4 then
		d.still = 0
		d.amp = A.approach(d.amp, 1, 8, dt)
		d.moving = raw > 1
	else
		d.still += dt
		if d.moving then
			d.moving = false
			d.extraAt = b.t + 0.6 -- 멈춘 뒤 한 걸음 더
		end
		if d.still > 6 then
			d.amp = A.approach(d.amp, 0, 0.5, dt) -- 오래 서 있으면 아주 천천히 두 발로 내려선다
		end
	end
	if d.extraAt > 0 and b.t >= d.extraAt then
		d.extraAt = -1
		b.step(b.root.CFrame:PointToWorldSpace(d.abs.FootL), 0.7)
	end
	local amp = d.amp
	local stride = STRIDE * (1 + 0.5 * math.clamp((raw - 10) / 8, 0, 1))
	local prev = b.phase
	b.phase = (b.phase + raw * dt / stride) % 1
	local ph = b.phase
	-- 골반 띠(몸 전체의 부모): 디딤발 쪽 3° · 좌우 0.12 · 디딤 가운데서 +0.15
	local sway = math.sin(ph * math.pi * 2)
	local bob = (0.15 * math.abs(math.cos(ph * math.pi * 2)) - 0.08) * amp
	local rOff = Vector3.new(0.12 * sway * amp, bob, 0)
	-- 멈춤: 들고 있던 발을 무릎 높이까지 들고 상체를 앞으로 숙인 채 굳는다(사람이면 넘어질 자세)
	d.freeze = A.approach(d.freeze, if raw <= 0.4 and d.still < 6 and amp > 0.2 then 1 else 0, if raw <= 0.4 then 4 else 10, dt)
	local fz: number = d.freeze
	local rRot = CFrame.fromEulerAnglesYXZ(-math.rad(14) * fz, 0, math.rad(3) * sway * amp)
	setRot(b, "HipRing", rRot, rOff)
	local ringCF = CFrame.new(d.abs.HipRing + rOff) * rRot
	for i, n in { "L", "R" } do
		local o = if i == 1 then 0 else 0.5
		local q, qp = (ph + o) % 1, (prev + o) % 1
		local half = DUTY * stride / 2 * amp
		local z, h, pitch
		if q < DUTY then
			local k = q / DUTY
			z = -half + 2 * half * k
			h = 0
			-- 뒤꿈치(발끝 들림, +) → 발바닥 → 발끝(뒤꿈치 들림, −)
			pitch = if k < 0.15 then 0.25 * (1 - k / 0.15) elseif k > 0.75 then -0.35 * (k - 0.75) / 0.25 else 0
		else
			local k = (q - DUTY) / (1 - DUTY)
			z = half - 2 * half * (0.5 - 0.5 * math.cos(k * math.pi))
			h = 0.45 * math.sin(k * math.pi)
			pitch = -0.35 * (1 - k) + 0.25 * k
		end
		local ankle = d.abs["Foot" .. n]
		if (i == 1) == (ph >= 0.5) then -- 이 발이 들리는 쪽
			h += 1.2 * fz * (1 - h)
			z -= 1.6 * fz
		end
		local target = ankle + Vector3.new(0, h * amp + math.max(0, -pitch) * 0.3 * amp, z)
		local hip = ringCF:PointToWorldSpace(d.abs["Thigh" .. n] - d.abs.HipRing)
		local legRot = ik2(b, "Thigh" .. n, "Shin" .. n, hip, target, Vector3.new(0, 0, -1), rRot)
		setRot(b, "Foot" .. n, legRot:Inverse() * CFrame.Angles(pitch * amp, 0, 0))
		if qp >= DUTY and q < DUTY and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), math.clamp(raw / 10, 0.4, 1.4)) -- 맨발 + 경첩 찰칵
		end
	end
	-- 아래팔 진자(다리 반대 위상 ±20°), 왼팔은 끈에 매달려 더 늘어짐
	A.pose(b, "ForearmL", math.rad(20) * sway * amp, 0, 0)
	A.pose(b, "ForearmR", -math.rad(20) * sway * amp, 0, 0)
	A.pose(b, "UpperArmL", 0.08 * sway * amp, 0, 0.05 * math.sin(b.t * 0.8))
	A.pose(b, "Yoke", 0, 0, math.rad(6) * math.sin(ph * math.pi * 2 + 0.6) * amp) -- 버팀대 흔들림
	-- 살 척추는 틀 사이에서 처졌다 당겨짐
	A.pose(b, "Lumbar", 0.04 * math.sin(b.t * 1.2), 0, 0)
	A.pose(b, "Thorax", -0.05 * sway * amp - math.rad(8) * fz, 0, 0.03 * sway * amp)
	-- 고리 꺾임(공격): 쐐기 받침째 머리가 앞으로 84°
	d.check -= dt
	if d.check <= 0 then
		d.check = 0.15
		d.close = b.state == "Chase" and nearestDist(b.root.Position) < 3.4
	end
	d.snap = A.approach(d.snap, if d.close then 1 else 0, if d.close then 14 else 3, dt)
	A.pose(b, "Clamp", -math.rad(84) * d.snap, 0, 0)
	-- 케이블: 두 마디 스프링(걸음 흔들림을 늦게 따라감)
	local push = -sway * amp * 0.6
	d.c1v += (-30 * d.c1 - 4 * d.c1v + push) * dt
	d.c1 += d.c1v * dt
	d.c2v += (-22 * d.c2 - 3 * d.c2v - d.c1 * 10) * dt
	d.c2 += d.c2v * dt
	A.pose(b, "Cable1", 0.05 * d.c1 + math.rad(14) * fz, 0, 0.12 * d.c1)
	A.pose(b, "Cable2", 0.04 * d.c2, 0, 0.15 * d.c2)
	A.pose(b, "Cable3", 0, 0.1 * d.c2, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="266">
          <Properties>
            <string name="Name">c1n</string>
            <string name="Source"><![CDATA[--!strict
-- c1n 청음체: 회전 삼각 보행. 손 둘로 체중을 받치고 셋째 팔을 들어 바깥으로 120° 크게 돌려 딛는 동안 몸통(Hub)이 40° 돈다.
-- 짚은 두 손은 세상에 붙어 있게(몸통이 도는 만큼 반대로 돌림) — 한 순간 최소 2점 접지. 딛을 때마다 손바닥 '탁'(b.step).
-- 목뼈 3마디가 몸통 회전을 반대로 상쇄해 접시는 늘 겨눈 쪽(앞, 또는 서버 AimAt)을 본다 — 몸은 돌며 오는데 접시는 너를 본다.
-- 서버 Listening = 겨눔 0.8초 → 갈비 깔때기가 활짝(듣기). 추격 중 3 안이면 갈비가 닫힌다(촤악).
local Players = game:GetService("Players")
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local LEGS = { B = -60, A = 60, C = 180 } -- (서버와 같은 다리 방향)
local ORDER = { "B", "A", "C" } -- 도는 방향 순서로 하나씩 든다
local TURN = math.rad(40) -- 한 걸음에 몸통이 도는 각
local STEP = 1.5 -- 한 걸음에 나아가는 거리

local function nearestDist(pos: Vector3): number
	local best = math.huge
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r then
			best = math.min(best, (r.Position - pos).Magnitude)
		end
	end
	return best
end

local function smooth(x: number): number
	return x * x * (3 - 2 * x)
end

function M.init(b: A.Body)
	local d = b.data
	d.n = math.random(0, 2)
	d.p = 0
	d.aim = 0
	d.pitch = 0
	d.flare = 0
	d.check = 0
	d.close = false
	d.axis = {}
	for name, deg in LEGS do
		local t = math.rad(deg)
		local u = Vector3.new(math.sin(t), 0, -math.cos(t))
		d.axis[name] = Vector3.yAxis:Cross(u).Unit
	end
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	local moving = math.clamp(b.speed / 3, 0, 1)
	d.p += b.speed * dt / STEP
	local landed: string? = nil
	if d.p >= 1 then
		landed = ORDER[d.n % 3 + 1]
		d.n += 1
		d.p -= 1
	end
	local p = d.p
	local psi = TURN * (d.n + p)
	A.pose(b, "Hub", 0.03 * math.sin(p * math.pi * 2) * moving, -psi, 0, Vector3.new(0, -0.08 * math.sin(p * math.pi) * moving, 0))
	-- 다리: 움직이는 다리는 −40° → +40°(공중에서 120°), 짚은 다리는 몸통 회전을 상쇄
	local m = d.n % 3 + 1
	for k, name in ORDER do
		local rel = (k - m) % 3 -- 0 = 지금 드는 다리, 2 = 바로 전에 딛은 다리, 1 = 두 걸음 전
		local off, lift = 0, 0
		if rel == 0 then
			off = -TURN + 2 * TURN * smooth(p)
			lift = math.sin(p * math.pi) * moving
		elseif rel == 2 then
			off = TURN * (1 - p)
		else
			off = -TURN * p
		end
		A.pose(b, "Hip" .. name, 0, -off, 0)
		local ax: Vector3 = d.axis[name]
		local up = CFrame.fromAxisAngle(ax, -0.55 * lift)
		local rx, ry, rz = up:ToEulerAnglesYXZ()
		A.pose(b, "Arm" .. name, rx, ry, rz)
		local bend = CFrame.fromAxisAngle(ax, 0.35 * lift) -- 팔꿈치가 더 꺾이며 손이 들림
		rx, ry, rz = bend:ToEulerAnglesYXZ()
		A.pose(b, "Fore" .. name, rx, ry, rz)
		local wrist = CFrame.fromAxisAngle(ax, 0.4 * lift) -- 손목을 젖혀 딛기 직전 손바닥을 편다
		rx, ry, rz = wrist:ToEulerAnglesYXZ()
		A.pose(b, "Hand" .. name, rx, ry, rz)
	end
	if landed and moving > 0.3 then
		local t = math.rad(LEGS[landed])
		local at = Vector3.new(math.sin(t) * 2.2, -2.5, -math.cos(t) * 2.2)
		b.step(b.root.CFrame:PointToWorldSpace(at), math.clamp(b.speed / 8, 0.4, 1.3)) -- 탁
	end
	-- 접시 겨눔: 듣는 중이면 AimAt 쪽, 아니면 앞. 몸통 회전(psi)을 목이 상쇄
	local listening = b.model:GetAttribute("Listening") == true
	local aimYaw, aimPitch = 0, 0
	local at = b.model:GetAttribute("AimAt")
	if listening and typeof(at) == "Vector3" then
		local lp = b.root.CFrame:PointToObjectSpace(at)
		aimYaw = math.atan2(-lp.X, -lp.Z)
		aimPitch = math.clamp(math.atan2(lp.Y - 3, math.sqrt(lp.X * lp.X + lp.Z * lp.Z)), -0.4, 0.4)
	end
	d.aim = A.approach(d.aim, aimYaw, if listening then 5 else 3, dt) -- (0.8초 안에 겨눔)
	d.pitch = A.approach(d.pitch, aimPitch, 5, dt)
	A.pose(b, "Neck1", 0, psi + d.aim, 0)
	A.pose(b, "Neck2", 0.04 * math.sin(b.t * 1.1), 0, 0.03 * math.sin(b.t * 0.8))
	A.pose(b, "Neck3", d.pitch + 0.03 * math.sin(b.t * 1.3), 0, 0)
	-- 갈비 깔때기: 평소 0, 듣기 활짝(+), 닫힘(−)
	d.check -= dt
	if d.check <= 0 then
		d.check = 0.15
		d.close = b.state == "Chase" and nearestDist(b.root.Position) < 3.5
	end
	local want = if d.close then -0.7 elseif listening then 0.3 else 0.04 * math.sin(b.t * 1.5)
	d.flare = A.approach(d.flare, want, if d.close then 12 else 4, dt)
	A.pose(b, "RibL", 0, d.flare, 0)
	A.pose(b, "RibR", 0, -d.flare, 0)
	A.pose(b, "Ear", 0, 0, if listening then 0.05 * math.sin(b.t * 40) else 0) -- 고막 떨림
	A.pose(b, "VestFore", 0.06 * math.sin(b.t * 2.3), 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="267">
          <Properties>
            <string name="Name">c2h</string>
            <string name="Source"><![CDATA[--!strict
-- c2h 틈사람: 두 발 무게 이동(뒤꿈치 → 발볼 → 발끝). 위팔은 묶여 고정(팔 흔들기 없음), 머리는 돌지 않는다.
-- 납작한 판 몸이라 걸음마다 Chest 가 옆으로 ±4° 휘청이고, 머리판은 늘 옆(얼굴 쪽)으로 기울어 있다.
-- 서버 속성: Echo(플레이어 발소리 0.15초 뒤 같은 발소리) · Slide(칼날로 서서 틈을 넘어옴: 옆 기울기 22°, 0.6초).
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local STRIDE = 3.0 -- 한 주기(두 걸음)에 몸이 가는 거리
local DUTY = 0.6
local LIFT = 0.45
local REF = 6

local function angOf(z: number, y: number): number
	return math.atan2(-z, -y) -- 아래 = 0, 앞(-Z)으로 +
end

-- 옆 평면(Y,Z) 2마디 IK: 무릎은 앞으로 굽는다
local function legIK(b: A.Body, thigh: string, shin: string, hip: Vector3, target: Vector3, parentRx: number): (number, number)
	local T0, S0 = b.tip[thigh], b.tip[shin]
	local l1 = math.sqrt(T0.Y * T0.Y + T0.Z * T0.Z)
	local l2 = math.sqrt(S0.Y * S0.Y + S0.Z * S0.Z)
	local dy, dz = target.Y - hip.Y, target.Z - hip.Z
	local dist = math.clamp(math.sqrt(dy * dy + dz * dz), math.abs(l1 - l2) + 0.01, l1 + l2 - 0.002)
	local phi = angOf(dz, dy)
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local a2 = math.acos(math.clamp((l2 * l2 + dist * dist - l1 * l1) / (2 * l2 * dist), -1, 1))
	local thighRx = (phi + a1) - angOf(T0.Z, T0.Y) - parentRx
	local shinRx = (phi - a2) - angOf(S0.Z, S0.Y) - thighRx - parentRx
	return thighRx, shinRx
end

-- 한 발의 보행 곡선: 디딤(앞 → 뒤, 바닥) / 들기(뒤 → 앞, 들어 올림). contact = 이번 프레임에 착지
local function footCurve(phase: number, prev: number, o: number): (number, number, number, boolean)
	local q, qp = (phase + o) % 1, (prev + o) % 1
	local half = DUTY * STRIDE / 2
	local z, h, pitch
	if q < DUTY then
		local s = q / DUTY
		z = -half + 2 * half * s
		h = 0
		pitch = if s < 0.25 then 0.3 * (1 - s / 0.25) elseif s > 0.7 then -0.55 * (s - 0.7) / 0.3 else 0
	else
		local s = (q - DUTY) / (1 - DUTY)
		z = half - 2 * half * (0.5 - 0.5 * math.cos(s * math.pi))
		h = LIFT * math.sin(s * math.pi)
		pitch = if s < 0.4 then -0.55 * (1 - s / 0.4) else 0.3 * (s - 0.4) / 0.6
	end
	if pitch < 0 then
		h += -pitch * 0.5 -- 발끝으로 밀 때 발목이 들린다
	end
	return z, h, pitch, qp > q
end

function M.init(b: A.Body)
	b.data.amp = 0
	b.data.lastEcho = b.model:GetAttribute("Echo")
	b.data.lastSlide = b.model:GetAttribute("Slide")
	b.data.echoAt = -1
	b.data.slide = -1
	b.data.lean = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	d.amp = A.approach(d.amp, math.clamp(b.speed / REF, 0, 1.3), 6, dt)
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / STRIDE) % 1
	local amp = math.min(d.amp, 1)
	local dir = if b.vel.Z > 0.5 then -1 else 1 -- 뒷걸음질이면 같은 주기를 거꾸로
	-- 골반: 착지 때 낮고 넘김 때 높다(+0.15), 디딤발 쪽으로 옆 이동
	local ph = b.phase
	local bob = -0.15 * math.cos(ph * math.pi * 4) * amp + 0.02 * math.sin(b.t * 1.7)
	local sway = -0.07 * math.cos((ph - DUTY / 2) * math.pi * 2) * amp
	local pOff = Vector3.new(sway, bob, 0)
	local pRx = 0.05 * amp -- 걸을 때 살짝 앞으로
	A.pose(b, "Pelvis", pRx, 0, sway * 0.6, pOff)
	-- 다리
	local pelvisPos = b.rest.Pelvis.Position + pOff
	for i, n in { "L", "R" } do
		local hip = pelvisPos + b.rest["Thigh" .. n].Position
		local ankle = b.rest.Pelvis.Position + b.rest["Thigh" .. n].Position + b.tip["Thigh" .. n] + b.tip["Shin" .. n]
		local z, h, pitch, contact = footCurve(ph, prev, if i == 1 then 0 else 0.5)
		local target = ankle + Vector3.new(0, h * amp, z * amp * dir)
		local tRx, sRx = legIK(b, "Thigh" .. n, "Shin" .. n, hip, target, pRx)
		A.pose(b, "Thigh" .. n, tRx, 0, 0)
		A.pose(b, "Shin" .. n, sRx, 0, 0)
		A.pose(b, "Foot" .. n, pitch * amp - tRx - sRx - pRx, 0, 0)
		if contact and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), math.clamp(b.speed / 10, 0.3, 1.3))
		end
	end
	-- 메아리 발소리(서버 Echo): 0.15초 뒤
	local echo = b.model:GetAttribute("Echo")
	if echo ~= d.lastEcho then
		d.lastEcho = echo
		d.echoAt = b.t + 0.15
	end
	if d.echoAt > 0 and b.t >= d.echoAt then
		d.echoAt = -1
		b.step(b.root.Position + Vector3.new(0, -3, 0), 0.6)
	end
	-- 틈 넘어오기(서버 Slide): 칼날로 서서 옆으로 22° 기울었다 돌아옴
	local sl = b.model:GetAttribute("Slide")
	if sl ~= d.lastSlide then
		d.lastSlide = sl
		d.slide = 0
	end
	local leanT = 0
	if d.slide >= 0 then
		d.slide += dt
		leanT = math.rad(22) * math.sin(math.clamp(d.slide / 0.6, 0, 1) * math.pi)
		if d.slide > 0.6 then
			d.slide = -1
		end
	end
	d.lean = A.approach(d.lean, leanT, 12, dt)
	-- 상체: 판이 걸음마다 옆으로 휘청(±4°), 팔은 고정. 쉬는 동안 아주 느린 숨
	local wob = math.rad(4) * math.sin(ph * math.pi * 2) * amp
	A.pose(b, "Spine", 0.03 * math.sin(b.t * 1.1), 0, -sway * 0.4)
	A.pose(b, "Chest", 0, 0, wob + d.lean)
	-- 머리판: 늘 얼굴(+X) 쪽으로 기울어 옆을 본다, 걸음에 늦게 따라 흔들림
	A.pose(b, "Neck", -0.06, 0, math.rad(-12) - wob * 0.6)
	A.pose(b, "HeadPlate", 0.04 * math.sin(b.t * 0.7), 0, math.rad(-6) - wob * 0.4)
	-- 출입증: 진자
	A.pose(b, "Badge", 0.25 * math.sin(ph * math.pi * 4) * amp + 0.05 * math.sin(b.t * 2), 0, 0)
	-- 손: 손끝이 걸음에 따라 엉덩이 옆을 쓸어내린다(아래팔만 살짝)
	A.pose(b, "ForearmL", 0.08 * math.sin(ph * math.pi * 2) * amp, 0, 0)
	A.pose(b, "ForearmR", -0.08 * math.sin(ph * math.pi * 2) * amp, 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="268">
          <Properties>
            <string name="Name">c2n</string>
            <string name="Source"><![CDATA[--!strict
-- c2n 짐걸이: 빔 밑 매달림 이동. 갈고리 하나씩(앞왼 → 앞오른 → 뒤왼 → 뒤오른) 풀어 앞에 다시 건다.
-- 걸린 갈고리는 빔(세상)에 붙어 있고 몸만 지나가게: 위상 = 이동 거리 / 주기 길이. 다시 걸 때 딸깍(b.step).
-- 풀 때마다 몸이 반대쪽으로 흔들린다(Hang 진자). 쫓을 땐 '던지기': 앞 둘·뒤 둘을 한꺼번에 옮긴다.
-- 위장(서버 Wrap 속성): 네 갈고리를 한 점으로 모으고 몸을 말아 올린다(0.4초), 풀 땐 0.8초. 붉은 가닥만 흔들린다.
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}

local SPAN = 2.1 -- 뿌리(견갑·골반)에서 빔까지 대략의 높이: 갈고리 앞뒤 거리 → 각도
local BEAM_Y = 10.2 -- 루트 기준 빔 높이(소리 위치)

type Limb = { key: string, upper: string, lower: string, hook: string, z: number }
local LIMBS: { Limb } = {
	{ key = "FL", upper = "UpperArmFL", lower = "ForearmFL", hook = "HookFL", z = -1.9 },
	{ key = "FR", upper = "UpperArmFR", lower = "ForearmFR", hook = "HookFR", z = -0.9 },
	{ key = "BL", upper = "ThighBL", lower = "ShinBL", hook = "HookBL", z = 1.55 },
	{ key = "BR", upper = "ThighBR", lower = "ShinBR", hook = "HookBR", z = 2.35 },
}
-- 걸음 방식: 다리마다 위상 시작점, 풀려 있는 비율, 한 주기 길이(스터드)
local CRAWL = { off = { FL = 0, FR = 0.25, BL = 0.5, BR = 0.75 }, swing = 0.25, len = 2.4 }
local THROW = { off = { FL = 0, FR = 0, BL = 0.5, BR = 0.5 }, swing = 0.35, len = 3.0 }

function M.init(b: A.Body)
	b.data.p = math.random()
	b.data.wrap = 0
	b.data.roll = 0
	b.data.pitch = 0
	b.data.s1 = 0
	b.data.s2 = 0
	b.data.sv1 = 0
	b.data.sv2 = 0
	b.data.mode = 0 -- 0 기어가기 ↔ 1 던지기(부드럽게 섞음)
	b.data.down = {} :: { [string]: boolean }
end

-- 한 다리: 위상 q(0~1, 0부터 swing 까지 풀려서 앞으로) → 앞쪽 거리 f(스터드), 들림 0~1
local function limbAt(q: number, swing: number, len: number): (number, number)
	local a = (1 - swing) * len / 2 -- 걸린 동안 몸이 지나가는 거리의 절반(세상에 고정)
	if q < swing then
		local u = q / swing
		local s = u * u * (3 - 2 * u)
		return -a + 2 * a * s, math.sin(u * math.pi)
	end
	local u = (q - swing) / (1 - swing)
	return a - 2 * a * u, 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	local wrapped = b.model:GetAttribute("Wrap") == true
	d.wrap = A.approach(d.wrap, if wrapped then 1 else 0, if wrapped then 9 else 4.5, dt)
	local w = d.wrap
	local chasing = b.state == "Chase"
	d.mode = A.approach(d.mode, if chasing then 1 else 0, 3, dt)
	local g = if d.mode > 0.5 then THROW else CRAWL
	-- 위상은 이동 거리에 묶는다(앞 = -Z)
	local fwd = -b.vel.Z
	if w < 0.5 then
		d.p = (d.p + fwd * dt / g.len) % 1
	end
	local p = d.p
	-- 몸 흔들림(진자): 기어갈 땐 갈고리를 풀 때마다 좌우로, 던질 땐 앞뒤로 크게
	local moving = math.clamp(b.speed / 3, 0, 1) * (1 - w)
	local rollT = 0.2 * A.wave(p * 2) * moving * (1 - d.mode) + 0.03 * math.sin(b.t * 0.9)
	local pitchT = 0.16 * A.wave(p * 2 + 0.25) * moving * d.mode
	d.roll = A.approach(d.roll, rollT, 6, dt)
	d.pitch = A.approach(d.pitch, pitchT, 6, dt)
	-- 위장 자세: 몸을 빔 쪽으로 끌어올리고(진자 점 기준) 가슴·골반 끝을 말아 올린다
	local hangRx = d.pitch - 0.25 * w
	local spine1Rx = 0.35 * w
	local spine2Rx = 0.75 * w + 0.04 * math.sin(b.t * 1.3)
	A.pose(b, "Hang", hangRx, 0, d.roll, Vector3.new(0, 0.7 * w, 0))
	A.pose(b, "Pelvis", -0.3 * w, 0, 0)
	A.pose(b, "Spine1", spine1Rx, 0, 0)
	A.pose(b, "Spine2", spine2Rx, 0, 0)
	A.pose(b, "NeckStump", 0.5 * w + 0.08 * math.sin(b.t * 1.7), 0.1 * math.sin(b.t * 0.6), 0)
	A.pose(b, "Band1", 0, 0.05 * math.sin(b.t * 2.1), 0)
	A.pose(b, "Band2", 0, -0.05 * math.sin(b.t * 1.9), 0)
	for _, lb in LIMBS do
		local isArm = lb.key:sub(1, 1) == "F"
		local q = (p - g.off[lb.key]) % 1
		local f, lift = limbAt(q, g.swing, g.len)
		f *= 1 - w
		lift *= 1 - w
		-- 위장: 갈고리를 몸 가운데(진자 점) 위로 모은다
		f += lb.z * w * 0.85
		-- 몸이 기운 만큼은 되돌려 갈고리가 빔 위에 남게
		local parentRx = hangRx + (if isArm then -0.3 * w + spine1Rx + spine2Rx else -0.3 * w)
		local rx = -math.atan(f / SPAN) - parentRx
		A.pose(b, lb.upper, rx, 0, -d.roll * 0.8)
		-- 풀린 동안: 팔꿈치·무릎을 굽혀 갈고리를 빔에서 내리고 손가락을 연다
		local bend = lift * 0.55 + 0.4 * w
		A.pose(b, lb.lower, if isArm then bend else -bend, 0, 0)
		A.pose(b, lb.hook, -lift * 1.3 - 0.3 * w, 0, 0)
		-- 다시 걸리는 순간 = 딸깍(빔에 갈고리)
		local down = q >= g.swing
		if down and d.down[lb.key] == false and w < 0.5 and b.speed > 0.3 then
			local at = b.root.CFrame:PointToWorldSpace(Vector3.new(0, BEAM_Y, lb.z))
			b.step(at, math.clamp(b.speed / 8, 0.3, 1.2))
		end
		d.down[lb.key] = down
	end
	-- 붉은 가닥: 2마디 감쇠 진자(움직임 반대로 끌림 + 몸 흔들림을 늦게 따라감)
	local t1 = math.clamp(b.vel.Z * 0.06, -0.6, 0.6) - d.pitch * 0.8
	local t2 = d.s1 * 0.6
	d.sv1 += ((t1 - d.s1) * 30 - d.sv1 * 4) * dt
	d.s1 += d.sv1 * dt
	d.sv2 += ((t2 - d.s2) * 22 - d.sv2 * 3) * dt
	d.s2 += d.sv2 * dt
	local sway = 0.06 * math.sin(b.t * 1.4)
	A.pose(b, "Strand1", d.s1, 0, -d.roll * 0.7 + sway)
	A.pose(b, "Strand2", d.s2, 0, sway * 0.8)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="269">
          <Properties>
            <string name="Name">c3h</string>
            <string name="Source"><![CDATA[--!strict
-- c3h 마개: 짐꾼 보행(무릎 늘 굽힘, 뒤꿈치 → 발바닥). 무게 이동은 해치 기울기(roll ±8°, 디딤발 쪽)로 보인다.
-- 팔은 테를 쥔 채 고정, 쉬는 동안 손이 번갈아 테를 고쳐 쥔다. 서버 Brace = 멈칫(해치 아랫테를 내리꽂듯 웅크림) → 돌진 자세.
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local STRIDE = 3.0
local DUTY = 0.62
local LIFT = 0.3
local REF = 4

local function angOf(z: number, y: number): number
	return math.atan2(-z, -y)
end

local function legIK(b: A.Body, thigh: string, shin: string, hip: Vector3, target: Vector3, parentRx: number): (number, number)
	local T0, S0 = b.tip[thigh], b.tip[shin]
	local l1 = math.sqrt(T0.Y * T0.Y + T0.Z * T0.Z)
	local l2 = math.sqrt(S0.Y * S0.Y + S0.Z * S0.Z)
	local dy, dz = target.Y - hip.Y, target.Z - hip.Z
	local dist = math.clamp(math.sqrt(dy * dy + dz * dz), math.abs(l1 - l2) + 0.01, l1 + l2 - 0.002)
	local phi = angOf(dz, dy)
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local a2 = math.acos(math.clamp((l2 * l2 + dist * dist - l1 * l1) / (2 * l2 * dist), -1, 1))
	local thighRx = (phi + a1) - angOf(T0.Z, T0.Y) - parentRx
	local shinRx = (phi - a2) - angOf(S0.Z, S0.Y) - thighRx - parentRx
	return thighRx, shinRx
end

local function footCurve(phase: number, prev: number, o: number): (number, number, number, boolean)
	local q, qp = (phase + o) % 1, (prev + o) % 1
	local half = DUTY * STRIDE / 2
	local z, h, pitch
	if q < DUTY then
		local s = q / DUTY
		z = -half + 2 * half * s
		h = 0
		pitch = if s < 0.2 then 0.25 * (1 - s / 0.2) elseif s > 0.8 then -0.3 * (s - 0.8) / 0.2 else 0
	else
		local s = (q - DUTY) / (1 - DUTY)
		z = half - 2 * half * (0.5 - 0.5 * math.cos(s * math.pi))
		h = LIFT * math.sin(s * math.pi)
		pitch = if s < 0.35 then -0.3 * (1 - s / 0.35) else 0.25 * (s - 0.35) / 0.65
	end
	if pitch < 0 then
		h += -pitch * 0.4
	end
	return z, h, pitch, qp > q
end

function M.init(b: A.Body)
	b.data.amp = 0
	b.data.lastBrace = b.model:GetAttribute("Brace")
	b.data.brace = -1
	b.data.crouch = 0
	b.data.lean = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	d.amp = A.approach(d.amp, math.clamp(b.speed / REF, 0, 1.4), 6, dt)
	local amp = math.min(d.amp, 1)
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / STRIDE) % 1
	local ph = b.phase
	local dir = if b.vel.Z > 0.5 then -1 else 1
	-- 멈칫(Brace): 0.4초 동안 웅크려 해치 아랫테를 내림 → 돌진 중엔 앞으로 숙임
	local br = b.model:GetAttribute("Brace")
	if br ~= d.lastBrace then
		d.lastBrace = br
		d.brace = 0
	end
	local crouchT, leanT = 0, 0
	if d.brace >= 0 then
		d.brace += dt
		if d.brace < 0.45 then
			crouchT = 0.45
			leanT = 0.18
		elseif b.speed > 6 then
			leanT = 0.22 -- 돌진: 해치를 세워 앞으로
		elseif d.brace > 1.2 then
			d.brace = -1
		end
	end
	d.crouch = A.approach(d.crouch, crouchT, 14, dt)
	d.lean = A.approach(d.lean, leanT, 8, dt)
	-- 골반: 무거운 짐 — 착지 때 푹 꺼지고(−0.11) 디딤발 쪽으로
	local bob = -0.11 * math.cos(ph * math.pi * 4) * amp - d.crouch + 0.03 * math.sin(b.t * 1.3)
	local sway = -0.12 * math.cos((ph - DUTY / 2) * math.pi * 2) * amp
	local pOff = Vector3.new(sway, bob, 0)
	A.pose(b, "Pelvis", 0, 0, 0, pOff)
	local pelvisPos = b.rest.Pelvis.Position + pOff
	for i, n in { "L", "R" } do
		local hip = pelvisPos + b.rest["Thigh" .. n].Position
		local ankle = b.rest.Pelvis.Position + b.rest["Thigh" .. n].Position + b.tip["Thigh" .. n] + b.tip["Shin" .. n]
		local z, h, pitch, contact = footCurve(ph, prev, if i == 1 then 0 else 0.5)
		local target = ankle + Vector3.new(0, h * amp, z * amp * dir)
		local tRx, sRx = legIK(b, "Thigh" .. n, "Shin" .. n, hip, target, 0)
		A.pose(b, "Thigh" .. n, tRx, 0, 0)
		A.pose(b, "Shin" .. n, sRx, 0, 0)
		A.pose(b, "Foot" .. n, pitch * amp - tRx - sRx, 0, 0)
		A.pose(b, "Toe" .. n, math.max(0, -pitch) * amp * 1.2, 0, 0) -- 밀 때 발가락이 꺾인다
		if contact and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), math.clamp(b.speed / 7, 0.4, 1.4))
		end
	end
	-- 상체 + 해치: 한 덩어리. 디딤발 쪽으로 roll ±8°, 숨 쉴 때 아주 살짝 들썩
	local roll = math.rad(8) * math.cos((ph - DUTY / 2) * math.pi * 2) * amp
	A.pose(b, "Spine", d.lean + 0.02 * math.sin(b.t * 1.3), 0, roll)
	A.pose(b, "Hatch", 0, 0, -roll * 0.25)
	-- 금 틈 속 눈: 천천히 두리번
	A.pose(b, "EyeSlit", 0, 0, 0, Vector3.new(0.05 * math.sin(b.t * 0.6), 0.03 * math.sin(b.t * 0.9), 0))
	-- 손: 쉬는 동안 0.5초마다 번갈아 테를 고쳐 쥔다
	local idle = 1 - amp
	local g = b.t % 1
	A.pose(b, "RimGripL", if g < 0.25 then 0.35 * math.sin(g / 0.25 * math.pi) * idle else 0, 0, 0)
	A.pose(b, "RimGripR", if g >= 0.5 and g < 0.75 then 0.35 * math.sin((g - 0.5) / 0.25 * math.pi) * idle else 0, 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="270">
          <Properties>
            <string name="Name">c3n</string>
            <string name="Source"><![CDATA[--!strict
-- c3n 홍예: 벽-벽 버팀 걸음. 한 손이 벽을 짚고 있는 동안 다른 손이 떨어져 앞 벽을 짚는다(아치가 짚은 손을 축으로 돈다).
-- 짚은 손은 벽(세상)에 붙어 있게: 위상 = 이동 거리 / 주기 길이(3스터드, 손 짚기 두 번). 짚을 때마다 철썩(b.step).
-- 쫓을 땐 아치가 벽을 타고 내려와(손목 높이 7 → 4.8) 매달린 손이 머리 높이 가까이 온다.
-- 서버 속성: Mimic(테처럼 굳음 — 완전히 멈추고 손가락만 4초마다 꺾임), Reveal(음파 — 매달린 손 움찔), Grab(밑을 지남 — 목이 늘어나 손이 내려옴)
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}

local CYCLE = 3.0 -- 한 주기(왼손·오른손 한 번씩) 동안 나아가는 거리
local HALF = 0.75 -- 짚은 손이 몸 기준으로 앞→뒤로 지나가는 거리의 절반(= CYCLE / 4)
local SPAN = 7.0 -- 손목 사이
local WRIST_Y = 4.9 -- 루트 기준 손목 높이(벽 짚는 곳)

function M.init(b: A.Body)
	local d = b.data
	d.p = math.random()
	d.lower = 0
	d.tilt = 0
	d.half = if d.p < 0.5 then 0 else 1
	d.n1 = 0
	d.n1v = 0
	d.nz = 0
	d.nzv = 0
	d.drop = 0
	d.grabT = -1
	d.lastGrab = b.model:GetAttribute("Grab")
	d.lastReveal = b.model:GetAttribute("Reveal")
	d.twitch = 0
	d.mimic = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	local mimic = b.model:GetAttribute("Mimic") == true
	d.mimic = A.approach(d.mimic, if mimic then 1 else 0, 3, dt)
	-- 붙잡기: 목뼈가 늘어나며 매달린 손이 0.6초에 내려왔다가 천천히 올라간다
	local g = b.model:GetAttribute("Grab")
	if g ~= d.lastGrab then
		d.lastGrab = g
		d.grabT = 0
	end
	if d.grabT >= 0 then
		d.grabT += dt
		local t = d.grabT
		d.drop = if t < 0.6 then t / 0.6 elseif t < 1.4 then 1 elseif t < 2.6 then 1 - (t - 1.4) / 1.2 else 0
		if t >= 2.6 then
			d.grabT = -1
		end
	end
	-- 음파에 드러남: 매달린 손이 움찔(진자에 충격)
	local rv = b.model:GetAttribute("Reveal")
	if rv ~= d.lastReveal then
		d.lastReveal = rv
		d.n1v += 3
		d.nzv -= 2
	end

	local fwd = -b.vel.Z
	local moving = math.clamp(b.speed / 2, 0, 1) * (1 - d.mimic)
	d.p = (d.p + fwd * dt / CYCLE) % 1
	local half = if d.p < 0.5 then 0 else 1
	local u = (d.p % 0.5) * 2
	-- 손 짚기: 반 주기가 바뀔 때 = 떨어져 있던 손이 벽을 짚음
	if half ~= d.half then
		d.half = half
		if moving > 0.3 then
			local side = if half == 0 then -1 else 1 -- 이번에 짚은 손: half 0 이 시작되면 왼손(A)이 막 짚은 것
			local at = b.root.CFrame:PointToWorldSpace(Vector3.new(side * 4.0, WRIST_Y - 0.6 - d.lower, -HALF))
			b.step(at, math.clamp(b.speed / 6, 0.4, 1.3))
		end
	end
	-- 짚은 손: 몸 기준 앞(-HALF)에서 뒤(+HALF)로(세상에 고정), 떨어진 손: 뒤에서 앞으로 크게 뻗음
	local planted = -HALF + 2 * HALF * u
	local s = u * u * (3 - 2 * u)
	local swinging = HALF - 2 * HALF * s
	local zA = (if half == 0 then planted else swinging) * moving
	local zB = (if half == 0 then swinging else planted) * moving
	local lift = math.sin(u * math.pi) * moving
	-- 아치 전체: 두 손의 가운데로 옮기고, 두 손 앞뒤 차이만큼 돌고, 손을 뻗을 때 앞으로 10° 기운다
	local yaw = math.asin(math.clamp((zA - zB) / SPAN, -0.5, 0.5))
	local lowerT = if b.state == "Chase" and not mimic then 2.1 else 0
	d.lower = A.approach(d.lower, lowerT, 2, dt)
	d.tilt = A.approach(d.tilt, -0.17 * lift, 10, dt)
	local roll = (if half == 0 then 1 else -1) * 0.05 * lift -- 떨어진 손 쪽이 살짝 들림
	A.pose(b, "Root", d.tilt, yaw, roll, Vector3.new(0, -d.lower, (zA + zB) / 2))
	-- 척추는 거의 강체(±6°): 걸을 때만 아주 작은 물결
	for i = 1, 11 do
		local name = string.format("Vert%02d", i)
		A.pose(b, name, 0, 0, 0.012 * moving * math.sin(b.t * 7 + i * 0.6))
	end
	-- 두 손: 떨어진 손은 손바닥이 벽에서 안쪽으로 떨어지고 앞으로 뻗는다
	local liftA = if half == 1 then lift else 0
	local liftB = if half == 0 then lift else 0
	A.pose(b, "HandA_Wrist", -0.5 * liftA, 0, 0.7 * liftA)
	A.pose(b, "HandB_Wrist", -0.5 * liftB, 0, -0.7 * liftB)
	-- 매달린 손: 목뼈 3마디 감쇠 진자(아치가 흔들리는 반대로 늦게) + 붙잡기 때 늘어남
	local t1 = math.clamp(b.vel.Z * 0.05, -0.5, 0.5) - d.tilt * 0.8
	d.n1v += ((t1 - d.n1) * 25 - d.n1v * 3.5) * dt
	d.n1 += d.n1v * dt
	local tz = -roll * 1.5 - yaw * 0.5
	d.nzv += ((tz - d.nz) * 20 - d.nzv * 3) * dt
	d.nz += d.nzv * dt
	local stretch = d.drop * 0.55 -- 마디마다 늘어나는 길이(세 마디 = 1.65)
	A.pose(b, "Neck1", d.n1 * 0.5, 0, d.nz * 0.5, Vector3.new(0, -stretch, 0))
	A.pose(b, "Neck2", d.n1 * 0.3, 0.15 * math.sin(b.t * 0.7) * (1 - d.mimic), d.nz * 0.3, Vector3.new(0, -stretch, 0))
	A.pose(b, "Neck3", d.n1 * 0.2, 0, d.nz * 0.2, Vector3.new(0, -stretch, 0))
	-- 손가락 꺾기: 굳어 있을 땐 4초마다 한 번 천천히, 붙잡을 땐 손이 확 펴졌다 쥔다
	d.twitch = (d.twitch + dt) % 4
	local crack = if d.twitch < 0.5 then math.sin(d.twitch / 0.5 * math.pi) * 0.25 else 0
	A.pose(b, "CrownHand", -0.6 * d.drop + crack, 0.35 * d.drop, 0.1 * math.sin(b.t * 1.1) * (1 - d.mimic))
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="271">
          <Properties>
            <string name="Name">c4h</string>
            <string name="Source"><![CDATA[--!strict
-- c4h 견인 환자: 줄에 들린 발끝 걸음(뒤꿈치 안 닿음). 오른발은 곧게 딛고, 고정틀 찬 왼다리는 골반을 들어 바깥으로 휘돌린다.
-- 상체는 거의 고정, 긴 목 3마디가 걸음에 늦게 흔들리고 헤일로·줄이 2차로 떨린다.
-- 서버 Ring = 헤일로 울림(고리 떨림 1.2초, 몸이 굳음) → 돌진(빠를 때) 두 손이 번갈아 줄을 감는다.
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local STRIDE = 3.6
local DUTY = 0.6
local LIFT = 0.32
local REF = 4.5

local function angOf(z: number, y: number): number
	return math.atan2(-z, -y)
end

local function legIK(b: A.Body, thigh: string, shin: string, hip: Vector3, target: Vector3, parentRx: number): (number, number)
	local T0, S0 = b.tip[thigh], b.tip[shin]
	local l1 = math.sqrt(T0.Y * T0.Y + T0.Z * T0.Z)
	local l2 = math.sqrt(S0.Y * S0.Y + S0.Z * S0.Z)
	local dy, dz = target.Y - hip.Y, target.Z - hip.Z
	local dist = math.clamp(math.sqrt(dy * dy + dz * dz), math.abs(l1 - l2) + 0.01, l1 + l2 - 0.002)
	local phi = angOf(dz, dy)
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local a2 = math.acos(math.clamp((l2 * l2 + dist * dist - l1 * l1) / (2 * l2 * dist), -1, 1))
	local thighRx = (phi + a1) - angOf(T0.Z, T0.Y) - parentRx
	local shinRx = (phi - a2) - angOf(S0.Z, S0.Y) - thighRx - parentRx
	return thighRx, shinRx
end

-- 발끝 걸음: 디딤 동안 발끝이 바닥, 발 각도는 거의 고정(들린 뒤꿈치)
local function footCurve(phase: number, prev: number, o: number): (number, number, number, number, boolean)
	local q, qp = (phase + o) % 1, (prev + o) % 1
	local half = DUTY * STRIDE / 2
	local z, h, pitch, swing
	if q < DUTY then
		local s = q / DUTY
		z = -half + 2 * half * s
		h = 0
		pitch = -0.12 * s
		swing = 0
	else
		local s = (q - DUTY) / (1 - DUTY)
		z = half - 2 * half * (0.5 - 0.5 * math.cos(s * math.pi))
		h = LIFT * math.sin(s * math.pi)
		pitch = -0.25 * math.sin(s * math.pi) -- 발끝이 늘어진 채 끌려 나간다
		swing = math.sin(s * math.pi)
	end
	return z, h, pitch, swing, qp > q
end

function M.init(b: A.Body)
	b.data.amp = 0
	b.data.lastRing = b.model:GetAttribute("Ring")
	b.data.ring = -1
	b.data.n1 = 0
	b.data.n2 = 0
	b.data.reach = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	d.amp = A.approach(d.amp, math.clamp(b.speed / REF, 0, 1.6), 6, dt)
	local amp = math.min(d.amp, 1)
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / STRIDE) % 1
	local ph = b.phase
	local dir = if b.vel.Z > 0.5 then -1 else 1
	-- 골반: 오른발 디딤 때 왼쪽 골반을 들어 휘돌림(hike), 위아래 출렁
	local _, _, _, swingL = footCurve(ph, prev, 0)
	local bob = (-0.1 - 0.08 * math.cos(ph * math.pi * 4)) * amp + 0.02 * math.sin(b.t * 1.2) -- (다리가 거의 펴져 있어 아래로만)
	local sway = -0.1 * math.cos((ph - DUTY / 2) * math.pi * 2) * amp
	local hike = math.rad(6) * swingL * amp
	local pOff = Vector3.new(sway, bob, 0)
	A.pose(b, "pelvis", 0, 0, -hike, pOff)
	local pelvisPos = b.rest.pelvis.Position + pOff
	for i, n in { "L", "R" } do
		local hip = pelvisPos + b.rest["hip" .. n].Position
		local ankle = b.rest.pelvis.Position + b.rest["hip" .. n].Position + b.tip["hip" .. n] + b.tip["knee" .. n]
		local z, h, pitch, swing, contact = footCurve(ph, prev, if i == 1 then 0 else 0.5)
		local lift = if i == 1 then h * 0.6 else h -- 왼다리는 들기보다 휘돌림
		local target = ankle + Vector3.new(0, lift * amp, z * amp * dir)
		local tRx, sRx = legIK(b, "hip" .. n, "knee" .. n, hip, target, 0)
		local out = if i == 1 then -math.rad(14) * swing * amp + hike else 0 -- 왼다리 바깥 휘돌림(−X)
		A.pose(b, "hip" .. n, tRx, 0, out)
		A.pose(b, "knee" .. n, sRx, 0, if i == 1 then -out * 0.7 else 0)
		A.pose(b, "ankle" .. n, pitch * amp - tRx - sRx, 0, 0)
		if contact and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), if i == 1 then 0.6 else 0.9) -- 툭(맨발) — 딸깍(고정틀)
		end
	end
	-- 헤일로 울림
	local rg = b.model:GetAttribute("Ring")
	if rg ~= d.lastRing then
		d.lastRing = rg
		d.ring = 0
	end
	local buzz = Vector3.zero
	local freeze = 0
	if d.ring >= 0 then
		d.ring += dt
		if d.ring < 1.2 then
			local k = 1 - d.ring / 1.2
			buzz = Vector3.new(math.sin(b.t * 251) * 0.03 * k, 0, math.cos(b.t * 233) * 0.03 * k)
			freeze = 1
		else
			d.ring = -1
		end
	end
	-- 긴 목: 걸음에 늦게 따라 흔들림(마디마다 더 늦게), 고개는 못 돌림
	local nk = math.sin((ph - 0.12) * math.pi * 4) * 0.05 * amp
	d.n1 = A.approach(d.n1, nk + sway * 0.5, 6, dt)
	d.n2 = A.approach(d.n2, d.n1, 4, dt)
	A.pose(b, "chest", -0.03 * amp, 0, 0)
	A.pose(b, "neck1", d.n1 * 0.6, 0, -sway * 0.3)
	A.pose(b, "neck2", d.n2, 0, d.n1 * 0.8)
	A.pose(b, "neck3", d.n2 * 0.6 + 0.04 * math.sin(b.t * 0.8), 0, d.n2 * 0.6)
	A.pose(b, "haloRing", 0, 0, 0, buzz)
	-- 견인줄: 움직일수록 뒤로 당겨 펴지고, 천천히 출렁
	A.pose(b, "cord0", 0, 0, 0)
	A.pose(b, "cord1", -0.08 * amp + 0.05 * math.sin(b.t * 1.3), 0.06 * math.sin(b.t * 0.9), 0)
	A.pose(b, "cord2", 0.12 * math.sin(b.t * 1.7 + 0.5) - 0.2 * math.clamp(b.speed / 16, 0, 1), 0, 0)
	-- 팔: 평소 왼손은 기둥을 쥐고 오른팔은 늘어져 흔들림. 울림 땐 굳고, 돌진 땐 두 손이 번갈아 줄을 감아 올린다
	local dash = if b.speed > 10 then 1 else 0
	d.reach = A.approach(d.reach, dash, 6, dt)
	local wind = math.sin(b.t * 12.5) * d.reach
	A.pose(b, "shoulderL", d.reach * (1.2 + 0.4 * wind), 0, 0)
	A.pose(b, "elbowL", -d.reach * 0.6, 0, 0)
	local hang = (0.12 * math.sin(ph * math.pi * 2) * amp) * (1 - freeze)
	A.pose(b, "shoulderR", hang + d.reach * (2.2 - 0.4 * wind), 0, 0.05)
	A.pose(b, "elbowR", d.reach * -0.5 + 0.05 * math.sin(b.t * 1.1), 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="272">
          <Properties>
            <string name="Name">c4n</string>
            <string name="Source"><![CDATA[--!strict
-- c4n 운구대: 바퀴 + 노 젓기. 여섯 손이 바닥을 짚고 뒤로 밀어 카트째 굴러간다(손 IK: 어깨 → 팔꿈치 → 손목).
-- 평소(물결 젓기): 앞 → 가운데 → 뒤 쌍 순서로 위상 1/3씩, 짚은 손은 바닥(세상)에 고정 = 위상을 이동 거리에 묶음.
-- 돌진(서버 Charging): 여섯 손이 한꺼번에 뻗었다 민다. 예고(Slap): 여섯 손이 동시에 바닥을 두 번 친다.
-- 충돌(Crash): 쟁반이 앞으로 숙였다 돌아오고 이름표·발이 흔들린다. 바퀴는 거리 / 반지름만큼 구른다.
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}

local FLOOR = -2
local BY = 2.55 -- 엎드린 가슴 높이(바닥 기준)
local WR = 0.36
local Z3 = { -1.75, 0, 1.75 } -- 시안 z(앞 +): 뒤 몸 · 가운데 몸 · 앞 몸
local ORDER = { 0.66, 0.33, 0 } -- 물결 젓기 위상(앞 몸이 먼저)
local CASTERS = { "casterFL", "casterFR", "casterRL", "casterRR" }

local function ik(a: Vector3, c: Vector3, l1: number, l2: number, pole: Vector3): (Vector3, Vector3)
	local d = c - a
	local dist = math.clamp(d.Magnitude, 0.05, l1 + l2 - 0.01)
	local dir = d.Unit
	local x = (l1 * l1 - l2 * l2 + dist * dist) / (2 * dist)
	local h = math.sqrt(math.max(0, l1 * l1 - x * x))
	local side = pole - a
	side = side - dir * side:Dot(dir)
	if side.Magnitude < 1e-3 then
		side = Vector3.new(0, 1, 0)
	end
	local el = a + dir * x + side.Unit * h
	return el, el + (c - el).Unit * l2
end

-- 뼈를 쉬는 방향(rest) → 원하는 방향(want)으로 돌리는 회전(부모 기준)
local function aim(b: A.Body, name: string, rest: Vector3, want: Vector3, extra: CFrame?): CFrame
	local r = CFrame.fromRotationBetweenVectors(rest.Unit, want.Unit)
	local full = if extra then extra * r else r
	local rx, ry, rz = full:ToEulerAnglesYXZ()
	A.pose(b, name, rx, ry, rz)
	return r
end

function M.init(b: A.Body)
	local d = b.data
	d.p = math.random()
	d.roll = 0
	d.sync = 0
	d.pitch = 0
	d.pitchV = 0
	d.tag = 0
	d.tagV = 0
	d.head = 0
	d.slapT = -1
	d.lastSlap = b.model:GetAttribute("Slap")
	d.lastCrash = b.model:GetAttribute("Crash")
	d.down = {} :: { [string]: boolean }
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	local charging = b.model:GetAttribute("Charging") == true
	local s = b.model:GetAttribute("Slap")
	if s ~= d.lastSlap then
		d.lastSlap = s
		d.slapT = 0
	end
	local cr = b.model:GetAttribute("Crash")
	if cr ~= d.lastCrash then
		d.lastCrash = cr
		d.pitchV -= 2.2 -- 쟁반이 앞으로 숙여짐
		d.tagV += 9
	end
	d.sync = A.approach(d.sync, if charging then 1 else 0, 6, dt)
	local fwd = -b.vel.Z
	-- 젓기 방식: 물결(주기 3, 짚는 비율 0.6) ↔ 일제(주기 7, 짧게 밀고 길게 미끄러짐)
	local len = 3 + 4 * d.sync
	local swing = 0.4 + 0.25 * d.sync
	d.p = (d.p + fwd * dt / len) % 1
	local moving = math.clamp(b.speed / 1.5, 0, 1)
	-- 예고: 0.6초 동안 여섯 손이 함께 바닥을 두 번 친다
	local slapLift = -1
	if d.slapT >= 0 then
		local t0 = d.slapT
		d.slapT += dt
		local t = d.slapT
		slapLift = math.abs(math.sin(math.min(t, 0.6) / 0.3 * math.pi))
		for _, hit in { 0.3, 0.6 } do
			if t0 < hit and t >= hit then
				b.step(b.root.CFrame:PointToWorldSpace(Vector3.new(0, FLOOR, -1)), 1.3)
			end
		end
		if t >= 0.7 then
			d.slapT = -1
		end
	end
	-- 쟁반(몸 전체): 충돌 때 숙였다 스프링으로 복귀, 밀 때마다 아주 작게 출렁
	d.pitchV += ((0 - d.pitch) * 40 - d.pitchV * 7) * dt
	d.pitch += d.pitchV * dt
	local bob = 0.03 * A.wave(d.p * 3) * moving * (1 - d.sync)
	A.pose(b, "tray", d.pitch * 0.12 + 0.04 * d.sync, 0, 0, Vector3.new(0, bob, 0))
	-- 세 몸의 등이 물결처럼(아주 작게)
	A.pose(b, "spine0", 0, 0, 0)
	for k = 1, 3 do
		A.pose(b, "spine" .. k, 0.02 * math.sin(b.t * 2 + k) * (1 - d.sync), 0, 0.02 * A.wave(d.p + k / 3) * moving)
	end
	-- 머리: 바닥을 향해 늘어져 흔들리다가, 돌진·예고 때 들린다
	local headT = if charging or d.slapT >= 0 then 1 else 0
	d.head = A.approach(d.head, headT, 5, dt)
	A.pose(b, "neck", -0.5 * d.head, 0, 0.05 * math.sin(b.t * 1.3))
	A.pose(b, "head", -0.6 * d.head + 0.08 * A.wave(d.p * 2) * moving, 0.1 * math.sin(b.t * 0.8), 0)
	-- 여섯 팔
	for k = 1, 3 do
		local zc = Z3[k]
		for _, sd in { 1, -1 } do
			local side = if sd > 0 then "L" else "R"
			local shN, elN, wrN = "sh" .. k .. side, "el" .. k .. side, "wr" .. k .. side
			local restUp, restFore = b.tip[shN], b.tip[elN]
			if restUp and restFore and restUp.Magnitude > 0 then
				local off = ORDER[k] * (1 - d.sync)
				local q = (d.p - off) % 1
				local a = (1 - swing) * len / 2
				local f, lift
				if q < swing then
					local u = q / swing
					local sm = u * u * (3 - 2 * u)
					f, lift = -a + 2 * a * sm, math.sin(u * math.pi)
				else
					f, lift = a - 2 * a * (q - swing) / (1 - swing), 0
				end
				f = math.clamp(f, -1.3, 1.3) * moving
				lift *= moving
				if slapLift >= 0 then
					f, lift = 0.6, slapLift
				end
				local shp = Vector3.new(sd * 0.92, FLOOR + BY + 0.02, -(zc + 0.1))
				local hand = Vector3.new(sd * 2.05, FLOOR + 0.1 + lift * 0.75, -(zc + 0.15) - f)
				local el, wr = ik(shp, hand, restUp.Magnitude, restFore.Magnitude, shp + Vector3.new(sd * 0.6, 1, -0.5))
				local r1 = aim(b, shN, restUp, el - shp)
				local r2 = aim(b, elN, restFore, r1:VectorToObjectSpace(wr - el))
				-- 손바닥은 바닥과 평평하게(위 두 회전을 되돌림), 들린 동안은 손끝이 처진다
				local flatten = (r1 * r2):Inverse()
				local rx, ry, rz = (flatten * CFrame.Angles(0.6 * lift, 0, 0)):ToEulerAnglesYXZ()
				A.pose(b, wrN, rx, ry, rz)
				-- 짚는 순간 = 손바닥 소리
				local down = q >= swing
				if down and d.down[shN] == false and moving > 0.3 and slapLift < 0 then
					b.step(b.root.CFrame:PointToWorldSpace(hand), math.clamp(b.speed / 10, 0.3, 1.4))
				end
				d.down[shN] = down
			end
		end
	end
	-- 바퀴: 이동 거리 / 반지름만큼 구름. 앞바퀴만 회전축 유격으로 흔들림
	d.roll = (d.roll + fwd * dt / WR) % (math.pi * 2)
	for i, name in CASTERS do
		local wob = if i <= 2 then 0.15 * math.sin(b.t * 9 + i) * moving else 0
		A.pose(b, name, -d.roll, wob, 0)
	end
	-- 들린 발·이름표: 속도에 끌려 뒤로 젖혀지고 펄럭임(감쇠 진자)
	local tagT = -math.clamp(b.speed * 0.045, 0, 0.9) + 0.12 * math.sin(b.t * (3 + b.speed * 0.6)) * math.clamp(b.speed / 6, 0, 1)
	d.tagV += ((tagT - d.tag) * 30 - d.tagV * 3) * dt
	d.tag += d.tagV * dt
	A.pose(b, "tag", d.tag, 0, 0.1 * math.sin(b.t * 2.3))
	local footSway = 0.06 * math.sin(b.t * 1.7) + 0.04 * A.wave(d.p) * moving
	A.pose(b, "shinL", footSway, 0, 0)
	A.pose(b, "shinR", -footSway * 0.8, 0, 0)
	A.pose(b, "footL", -d.tag * 0.15, 0, 0)
	A.pose(b, "footR", 0.05 * math.sin(b.t * 2.1), 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="273">
          <Properties>
            <string name="Name">c5h</string>
            <string name="Source"><![CDATA[--!strict
-- c5h 모서리: 한 평면 안의 두 발 보행. 두 다리(N·F)가 같은 평면에서 가위처럼 엇갈리고, 옆 흔들림은 0 — 위아래로만 출렁인다.
-- 모든 회전은 X 축 하나(평면이 깨지지 않음). 팔은 다리와 반대로, 머리는 늘 숙인 채 고정.
-- 추격(빠를 때)은 달리지 않고 보폭만 커진다(출렁임이 커짐). 서버 Align = 칼날 맞추기 순간 판이 한 번 떨린다.
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local DUTY = 0.58
local REF = 7

local function angOf(z: number, y: number): number
	return math.atan2(-z, -y)
end

local function legIK(b: A.Body, thigh: string, shin: string, hip: Vector3, target: Vector3, parentRx: number): (number, number)
	local T0, S0 = b.tip[thigh], b.tip[shin]
	local l1 = math.sqrt(T0.Y * T0.Y + T0.Z * T0.Z)
	local l2 = math.sqrt(S0.Y * S0.Y + S0.Z * S0.Z)
	local dy, dz = target.Y - hip.Y, target.Z - hip.Z
	local dist = math.clamp(math.sqrt(dy * dy + dz * dz), math.abs(l1 - l2) + 0.01, l1 + l2 - 0.002)
	local phi = angOf(dz, dy)
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local a2 = math.acos(math.clamp((l2 * l2 + dist * dist - l1 * l1) / (2 * l2 * dist), -1, 1))
	local thighRx = (phi + a1) - angOf(T0.Z, T0.Y) - parentRx
	local shinRx = (phi - a2) - angOf(S0.Z, S0.Y) - thighRx - parentRx
	return thighRx, shinRx
end

local function footCurve(phase: number, prev: number, o: number, stride: number, lift: number): (number, number, number, boolean)
	local q, qp = (phase + o) % 1, (prev + o) % 1
	local half = DUTY * stride / 2
	local z, h, pitch
	if q < DUTY then
		local s = q / DUTY
		z = -half + 2 * half * s
		h = 0
		pitch = if s < 0.2 then 0.22 * (1 - s / 0.2) elseif s > 0.75 then -0.4 * (s - 0.75) / 0.25 else 0
	else
		local s = (q - DUTY) / (1 - DUTY)
		z = half - 2 * half * (0.5 - 0.5 * math.cos(s * math.pi))
		h = lift * math.sin(s * math.pi)
		pitch = if s < 0.35 then -0.4 * (1 - s / 0.35) else 0.22 * (s - 0.35) / 0.65
	end
	if pitch < 0 then
		h += -pitch * 0.9
	end
	return z, h, pitch, qp > q
end

function M.init(b: A.Body)
	b.data.amp = 0
	b.data.stride = 5.2
	b.data.lastAlign = b.model:GetAttribute("Align")
	b.data.align = -1
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	d.amp = A.approach(d.amp, math.clamp(b.speed / REF, 0, 1.5), 6, dt)
	local amp = math.min(d.amp, 1)
	local chase = math.clamp((b.speed - 8) / 3, 0, 1)
	d.stride = A.approach(d.stride, 5.2 + 1.6 * chase, 3, dt) -- 보폭 2.6 → 3.4(걸음 하나)
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / d.stride) % 1
	local ph = b.phase
	local dir = if b.vel.Z > 0.5 then -1 else 1
	-- 골반: 위아래만(접지 −0.2, 넘김 +0.3), 좌우 0
	local bobAmp = 0.25 + 0.12 * chase
	-- (다리가 거의 펴져 있어서 위로는 조금만: 접지 때 가장 낮고 보폭이 커지면 더 낮다)
	local bob = (-0.1 - 0.3 * chase - bobAmp * 0.55 * math.cos(ph * math.pi * 4)) * amp + 0.02 * math.sin(b.t * 1.1)
	local pOff = Vector3.new(0, bob, 0)
	A.pose(b, "pelvis", 0, 0, 0, pOff)
	local pelvisPos = b.rest.pelvis.Position + pOff
	local swingN = 0
	for i, n in { "N", "F" } do
		local hip = pelvisPos + b.rest["knee" .. n].Position
		local ankle = b.rest.pelvis.Position + b.rest["knee" .. n].Position + b.tip["knee" .. n] + b.tip["ankle" .. n]
		local z, h, pitch, contact = footCurve(ph, prev, if i == 1 then 0 else 0.5, d.stride, 0.5 + 0.2 * chase)
		if i == 1 then
			swingN = z
		end
		local target = ankle + Vector3.new(0, h * amp, z * amp * dir)
		local tRx, sRx = legIK(b, "knee" .. n, "ankle" .. n, hip, target, 0)
		A.pose(b, "knee" .. n, tRx, 0, 0)
		A.pose(b, "ankle" .. n, sRx, 0, 0)
		A.pose(b, "toe" .. n, pitch * amp - tRx - sRx, 0, 0)
		if contact and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), math.clamp(b.speed / 12, 0.25, 1.0)) -- 아주 작은 스침
		end
	end
	-- 칼날 맞추기 순간: 판이 한 번 떨림(0.25초)
	local al = b.model:GetAttribute("Align")
	if al ~= d.lastAlign then
		d.lastAlign = al
		d.align = 0
	end
	local shiver = 0
	if d.align >= 0 then
		d.align += dt
		shiver = math.sin(d.align * 70) * 0.06 * math.max(0, 1 - d.align / 0.25)
		if d.align > 0.25 then
			d.align = -1
		end
	end
	-- 상체: 걸음마다 앞뒤로만 살짝(X 축), 머리는 숙인 채 고정
	A.pose(b, "spine1", 0.03 * math.sin(ph * math.pi * 4) * amp + shiver, 0, 0)
	A.pose(b, "spine2", 0.02 * math.sin(b.t * 0.9) - shiver, 0, 0)
	A.pose(b, "neck", -0.02 * math.sin(ph * math.pi * 4) * amp, 0, 0)
	-- 팔: 다리와 반대로(N 팔 ↔ N 다리 반대), 손은 고정
	local sw = math.clamp(swingN / 1.6, -1, 1) * 0.28 * amp
	A.pose(b, "elbowN", -sw, 0, 0)
	A.pose(b, "wristN", -sw * 0.4 - 0.05, 0, 0)
	A.pose(b, "elbowF", sw, 0, 0)
	A.pose(b, "wristF", sw * 0.4, 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="274">
          <Properties>
            <string name="Name">c5n</string>
            <string name="Source"><![CDATA[--!strict
-- c5n 지움: 굴뚝 걸음. 네 손발 중 하나만 떼어 앞으로 다시 짚는다(늘 3점 지지, 순서 왼손 → 오른발 → 오른손 → 왼발).
-- 손은 양벽, 왼발은 벽, 오른발은 바닥 모서리. 벽까지 거리는 레이캐스트로 재서 손발이 실제 벽에 닿게(2마디 IK).
-- 몸통은 짚은 손발 사이에서 미끄러지듯(출렁임 0.1), 갈비는 숨처럼 벌어졌다 오므라든다.
-- 「두 번째 음파」: 서버 SonarVeil = true 인 동안 몸의 모든 선을 이 클라이언트에서 지운다(LocalTransparencyModifier = 1) —
--   음파에 맞아 Reveal 이 켜도 안 보이고, 걸음 소리도 내지 않는다. 두 번째 음파(Exposed)에 갈비가 확 벌어지며 드러남.
-- 추격 중 2.6 안이면 두 손이 벽을 놓고 앞 한 점으로 모이며 갈비가 닫힌다(닫기).
local Players = game:GetService("Players")
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local CYCLE = 3.2 -- 한 주기(네 손발 한 번씩) 동안 나아가는 거리
local DUTY = 0.75
local ORDER = { HandL = 0, FootR = 0.25, HandR = 0.5, FootL = 0.75 }
local CHAIN = {
	HandL = { "UpperArmL", "ForearmL", -1 },
	HandR = { "UpperArmR", "ForearmR", 1 },
	FootL = { "ThighL", "ShinL", -1 },
	FootR = { "ThighR", "ShinR", 1 },
}

local function rotTo(a: Vector3, b: Vector3): CFrame
	local au, bu = a.Unit, b.Unit
	local c = au:Cross(bu)
	local s = c.Magnitude
	if s < 1e-5 then
		return CFrame.identity
	end
	return CFrame.fromAxisAngle(c / s, math.atan2(s, au:Dot(bu)))
end

local function setRot(b: A.Body, name: string, cf: CFrame, offset: Vector3?)
	local rx, ry, rz = cf:ToEulerAnglesYXZ()
	A.pose(b, name, rx, ry, rz, offset)
end

-- 2마디 IK(부모 회전 없음): j 관절 → t 목표, pole 쪽으로 굽힘. 두 뼈의 회전과 끝 회전 합을 돌려준다
local function ik2(b: A.Body, upper: string, lower: string, j: Vector3, t: Vector3, pole: Vector3): CFrame
	local T0, S0 = b.tip[upper], b.tip[lower]
	local l1, l2 = T0.Magnitude, S0.Magnitude
	local dv = t - j
	local dist = math.clamp(dv.Magnitude, math.abs(l1 - l2) + 0.02, l1 + l2 - 0.01)
	local u = dv.Unit
	local w = pole - u * pole:Dot(u)
	w = if w.Magnitude > 1e-4 then w.Unit else Vector3.yAxis
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local elbow = j + u * (l1 * math.cos(a1)) + w * (l1 * math.sin(a1))
	local r1 = rotTo(T0, elbow - j)
	local r2 = rotTo(S0, r1:VectorToObjectSpace(j + u * dist - elbow))
	setRot(b, upper, r1)
	setRot(b, lower, r2)
	return r1 * r2
end

local function restAbs(b: A.Body): { [string]: Vector3 }
	local out: { [string]: Vector3 } = {}
	local function get(n: string): Vector3
		local v = out[n]
		if v then
			return v
		end
		local mo = b.m[n]
		local p = mo and mo.Part0
		v = b.rest[n].Position
		if p and string.sub(p.Name, 1, 5) == "Bone_" then
			v += get(string.sub(p.Name, 6))
		end
		out[n] = v
		return v
	end
	for n in b.m do
		get(n)
	end
	return out
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function nearestDist(pos: Vector3): number
	local best = math.huge
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r then
			best = math.min(best, (r.Position - pos).Magnitude)
		end
	end
	return best
end

function M.init(b: A.Body)
	local d = b.data
	d.abs = restAbs(b)
	d.parts = {}
	for _, p in b.model:GetDescendants() do
		if p:IsA("BasePart") and (p.Name == "Line" or p.Name == "Ball") then
			table.insert(d.parts, p)
		end
	end
	d.veiled = nil
	d.wall = { [-1] = 3.95, [1] = 3.95 }
	d.rayT = 0
	d.amp = 0
	d.flare = 0
	d.flinch = 0
	d.close = 0
	d.check = 0
	d.near = false
	d.lastVeil = b.model:GetAttribute("Veil")
	d.lastExp = b.model:GetAttribute("Exposed")
end

local function applyVeil(b: A.Body, veiled: boolean)
	local want = if veiled then 1 else 0
	for _, p in b.data.parts do
		if p.LocalTransparencyModifier ~= want then
			p.LocalTransparencyModifier = want
		end
	end
	b.data.veiled = veiled
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	local veiled = b.model:GetAttribute("SonarVeil") ~= false
	applyVeil(b, veiled) -- (매 프레임: Reveal 이 투명도를 바꿔도 이 값이 이긴다)
	-- 첫 음파: 몸을 트는 움찔 / 두 번째 음파: 갈비가 확 벌어짐
	local v = b.model:GetAttribute("Veil")
	if v ~= d.lastVeil then
		d.lastVeil = v
		d.flinch = 1
	end
	local e = b.model:GetAttribute("Exposed")
	if e ~= d.lastExp then
		d.lastExp = e
		d.flare = 1
	end
	d.flinch = math.max(0, d.flinch - dt * 2.5)
	d.flare = math.max(0, d.flare - dt * 0.8)
	-- 벽까지 거리(0.3초마다)
	d.rayT -= dt
	if d.rayT <= 0 then
		d.rayT = 0.3
		local stage = workspace:FindFirstChild("Stage")
		if stage then
			rayParams.FilterDescendantsInstances = { stage }
			local cf = b.root.CFrame
			for _, s in { -1, 1 } do
				local from = cf:PointToWorldSpace(Vector3.new(0, 2, 0))
				local hit = workspace:Raycast(from, cf.RightVector * (6 * s), rayParams)
				d.wall[s] = if hit then math.clamp((hit.Position - from).Magnitude - 0.05, 3.0, 4.25) else 3.95
			end
		end
	end
	d.check -= dt
	if d.check <= 0 then
		d.check = 0.15
		d.near = b.state == "Chase" and nearestDist(b.root.Position) < 2.6
	end
	d.close = A.approach(d.close, if d.near then 1 else 0, 7, dt)
	d.amp = A.approach(d.amp, math.clamp(b.speed / 2.7, 0, 1.3), 5, dt)
	local amp = math.min(d.amp, 1.2)
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / CYCLE) % 1
	local ph = b.phase
	local half = DUTY * CYCLE / 2 * math.min(amp, 1)
	-- 몸통: 짚은 손발 사이에서 미끄러지듯, 출렁임 0.1(한 손발 짚을 때마다)
	local bob = 0.1 * math.sin(ph * math.pi * 8) * amp + 0.05 * math.sin(b.t * 1.3)
	local off = Vector3.new(0, bob, 0)
	A.pose(b, "Sacrum", 0, 0, 0, off)
	A.pose(b, "NeckStump", 0.15 * d.flinch * math.sin(b.t * 40), 0.4 * d.flinch, 0)
	-- 갈비 숨(open 0.95~1.08) + 노출 때 활짝 + 닫기
	local open = 0.07 * math.sin(b.t * 1.7) + 0.35 * d.flare - 0.45 * d.close
	A.pose(b, "RibL", 0, open, 0)
	A.pose(b, "RibR", 0, -open, 0)
	for name, o in ORDER do
		local ch = CHAIN[name]
		local up, lo, s = ch[1] :: string, ch[2] :: string, ch[3] :: number
		local isHand = string.sub(name, 1, 4) == "Hand"
		local rest = d.abs[name]
		local q, qp = (ph + o) % 1, (prev + o) % 1
		local z, lift
		if q < DUTY then
			local k = q / DUTY
			z = -half + 2 * half * k
			lift = 0
		else
			local k = (q - DUTY) / (1 - DUTY)
			z = half - 2 * half * (0.5 - 0.5 * math.cos(k * math.pi))
			lift = math.sin(k * math.pi) * math.min(amp, 1)
		end
		local t
		local onWall = isHand or name == "FootL"
		if onWall then
			local wx = d.wall[s]
			t = Vector3.new(wx * s, rest.Y, rest.Z + z) - Vector3.new(0.7 * s * lift, -0.25 * lift, 0)
		else
			t = Vector3.new(rest.X, rest.Y + 0.6 * lift, rest.Z + z)
		end
		if isHand and d.close > 0.01 then
			t = t:Lerp(Vector3.new(0.25 * s, rest.Y - 1.6, -2.2), d.close) -- 두 손이 앞 한 점으로
		end
		local j = d.abs[up] + off -- (모든 팔다리는 Sacrum 아래: 출렁임만큼 관절이 같이 움직임)
		local pole = if isHand then Vector3.new(0.3 * s, 0.3, -1) else Vector3.new(0.8 * s, 0, -0.6)
		local r = ik2(b, up, lo, j, t, pole)
		setRot(b, name, r:Inverse() * (if isHand and d.close > 0.5 then CFrame.Angles(0.6, 0, 0) else CFrame.identity))
		if qp >= DUTY and q < DUTY and amp > 0.25 and not veiled then
			b.step(b.root.CFrame:PointToWorldSpace(t), math.clamp(b.speed / 4, 0.4, 1.2)) -- 손바닥·발바닥 짚기
		end
	end
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="275">
          <Properties>
            <string name="Name">c6h</string>
            <string name="Source"><![CDATA[--!strict
-- c6h 등맞댄 손님: 3박 절뚝 보행 "쿵 — 스윽 — (멈칫)".
-- 앞장선 몸의 다리가 뒤꿈치로 '쿵' 딛고(체중 전부, 골반이 그쪽으로 3° 기욺), 뒤 몸의 다리는 무릎이 반대라 발끝을 바닥에 끌며
-- 앞으로 당겨 옴('스윽', 골반 −5° 롤), 두 발이 다 닿은 채 잠깐 멈칫. 진행 방향이 바뀌면(돌아서지 않음) 같은 주기를 B 가 거울처럼.
-- 앞장 얼굴이 바뀌는 순간 두 머리가 움찔(0.15초). 두 머리는 서로 반대 위상으로 흔들리고, 앞장 팔은 허리 높이로 더듬고
-- 뒤 팔은 진자처럼 늘어진다. 추격 중 3.5 안이면 앞장 상체가 덮치듯 숙여진다.
local Players = game:GetService("Players")
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local DUTY = 0.55
local STRIDE = 2.4
local START = { lead = 0, drag = 0.85 } -- 디딤 시작 위상

local function rotTo(a: Vector3, b: Vector3): CFrame
	local au, bu = a.Unit, b.Unit
	local c = au:Cross(bu)
	local s = c.Magnitude
	if s < 1e-5 then
		return CFrame.identity
	end
	return CFrame.fromAxisAngle(c / s, math.atan2(s, au:Dot(bu)))
end

local function setRot(b: A.Body, name: string, cf: CFrame, offset: Vector3?)
	local rx, ry, rz = cf:ToEulerAnglesYXZ()
	A.pose(b, name, rx, ry, rz, offset)
end

local function ik2(b: A.Body, upper: string, lower: string, j: Vector3, t: Vector3, pole: Vector3, pr: CFrame): CFrame
	local T0, S0 = b.tip[upper], b.tip[lower]
	local l1, l2 = T0.Magnitude, S0.Magnitude
	local dv = t - j
	local dist = math.clamp(dv.Magnitude, math.abs(l1 - l2) + 0.02, l1 + l2 - 0.01)
	local u = dv.Unit
	local w = pole - u * pole:Dot(u)
	w = if w.Magnitude > 1e-4 then w.Unit else pole.Unit
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local elbow = j + u * (l1 * math.cos(a1)) + w * (l1 * math.sin(a1))
	local r1 = rotTo(T0, pr:VectorToObjectSpace(elbow - j))
	local r2 = rotTo(S0, (pr * r1):VectorToObjectSpace(j + u * dist - elbow))
	setRot(b, upper, r1)
	setRot(b, lower, r2)
	return pr * r1 * r2
end

local function restAbs(b: A.Body): { [string]: Vector3 }
	local out: { [string]: Vector3 } = {}
	local function get(n: string): Vector3
		local v = out[n]
		if v then
			return v
		end
		local mo = b.m[n]
		local p = mo and mo.Part0
		v = b.rest[n].Position
		if p and string.sub(p.Name, 1, 5) == "Bone_" then
			v += get(string.sub(p.Name, 6))
		end
		out[n] = v
		return v
	end
	for n in b.m do
		get(n)
	end
	return out
end

local function nearestDist(pos: Vector3): number
	local best = math.huge
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r then
			best = math.min(best, (r.Position - pos).Magnitude)
		end
	end
	return best
end

-- 발 하나: 디딤 시작 위상 s0. u = 진행 방향 앞(+) 거리, h = 높이, pitch = 발끝 내림(+), contact = 이번 프레임에 딛음
local function foot(ph: number, prev: number, s0: number, half: number, drag: boolean): (number, number, number, boolean)
	local q, qp = (ph - s0) % 1, (prev - s0) % 1
	local u, h, pitch
	if q < DUTY then
		local k = q / DUTY
		u = half - 2 * half * k
		h = 0
		pitch = 0
	else
		local k = (q - DUTY) / (1 - DUTY)
		u = -half + 2 * half * (0.5 - 0.5 * math.cos(k * math.pi))
		if drag then
			h = 0.03 + 0.3 * math.sin(k * math.pi) -- (발끝이 바닥 아래로 파고들지 않게 발목을 같이 든다)
			pitch = 0.5 * math.sin(k * math.pi) -- 발끝을 바닥에 끌며
		else
			h = 0.4 * math.sin(k * math.pi)
			pitch = -0.2 * k
		end
	end
	return u, h, pitch, qp > q
end

function M.init(b: A.Body)
	local d = b.data
	d.abs = restAbs(b)
	d.amp = 0
	d.dir = -1 -- −1 = −Z 로 감(A 앞장), +1 = +Z(B 앞장)
	d.rev = 0
	d.lunge = 0
	d.check = 0
	d.close = false
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	-- 앞장 판단(돌아서지 않으니 진행 방향의 부호만)
	if math.abs(b.vel.Z) > 0.6 then
		local nd = if b.vel.Z < 0 then -1 else 1
		if nd ~= d.dir then
			d.dir = nd
			d.rev = 0.15 -- 반전: 눈 뜨는 순간 두 머리가 움찔
		end
	end
	d.rev = math.max(0, d.rev - dt)
	local leadN = if d.dir < 0 then "A" else "B"
	d.amp = A.approach(d.amp, math.clamp(b.speed / 5.5, 0, 1.3), 6, dt)
	local amp = math.min(d.amp, 1)
	local stride = STRIDE + 0.12 * math.max(0, b.speed - 5.5)
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / stride) % 1
	local ph = b.phase
	local half = DUTY * stride / 2 * amp
	-- 골반: 쿵(앞장 디딤) 쪽으로 3°, 스윽(끌기) 동안 −5°, 디딤 가운데서 솟음 0.1
	local leadSide = if leadN == "A" then -1 else 1
	local roll
	if ph < 0.4 then
		roll = math.rad(3) * math.sin(ph / 0.4 * math.pi)
	elseif ph < 0.85 then
		roll = -math.rad(5) * math.sin((ph - 0.4) / 0.45 * math.pi)
	else
		roll = 0
	end
	local bob = (0.1 * math.sin(math.min(ph / DUTY, 1) * math.pi) - 0.08) * amp
	local pOff = Vector3.new(0.08 * leadSide * math.sin(ph * math.pi * 2) * amp, bob, 0)
	local pRot = CFrame.fromEulerAnglesYXZ(0, 0, -roll * leadSide * amp)
	setRot(b, "Pelvis", pRot, pOff)
	local pelvisCF = CFrame.new(d.abs.Pelvis + pOff) * pRot
	for _, n in { "A", "B" } do
		local isLead = n == leadN
		local u, h, pitch, contact = foot(ph, prev, if isLead then START.lead else START.drag, half, not isLead)
		local z = u * d.dir -- (앞 = 진행 방향: −Z 로 갈 땐 z = −u)
		local ankle = d.abs["Foot" .. n]
		local target = ankle + Vector3.new(0, h * amp, z)
		local hip = pelvisCF:PointToWorldSpace(d.abs["Thigh" .. n] - d.abs.Pelvis)
		local kz = if n == "A" then -1 else 1 -- 무릎 방향(A 앞, B 뒤)
		local legRot = ik2(b, "Thigh" .. n, "Shin" .. n, hip, target, Vector3.new(0, 0.05, kz), pRot)
		local ps = if n == "A" then -1 else 1 -- 발끝 방향(A −Z, B +Z)
		setRot(b, "Foot" .. n, legRot:Inverse() * CFrame.Angles(ps * pitch * amp, 0, 0))
		if contact and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), if isLead then math.clamp(b.speed / 7, 0.6, 1.5) else 0.35) -- 쿵 / 스윽
		end
	end
	-- 상체 둘: 서로 반대 위상으로 흔들림, 앞장은 숙여 더듬고 추격 3.5 안이면 덮치듯
	d.check -= dt
	if d.check <= 0 then
		d.check = 0.15
		d.close = b.state == "Chase" and nearestDist(b.root.Position) < 3.5
	end
	d.lunge = A.approach(d.lunge, if d.close then 1 else 0, 8, dt)
	local jolt = math.sin(d.rev * 120) * 0.12 * (d.rev / 0.15)
	for _, n in { "A", "B" } do
		local f = if n == "A" then -1 else 1 -- 얼굴 쪽
		local lead = n == leadN
		local w = math.sin(ph * math.pi * 2 + (if n == "A" then 0 else math.pi))
		local lean = (if lead then 0.12 * amp + 0.45 * d.lunge else -0.04 * amp) -- 앞장 상체는 진행 쪽으로
		A.pose(b, "Spine" .. n, f * lean, 0, 0.03 * w * amp) -- (+rx = 위쪽이 +Z 로: 얼굴 쪽으로 숙임 = f 부호)
		A.pose(b, "Chest" .. n, -f * 0.05 * w * amp, 0, 0)
		A.pose(b, "Head" .. n, -f * (0.08 * w * amp + jolt), jolt * 2, 0)
		for _, s in { "L", "R" } do
			local sw = if s == "L" then 1 else -1
			if lead then
				-- 허리 높이로 더듬기(손가락 벌림)
				A.pose(b, "UpperArm" .. n .. s, -f * (0.25 + 0.1 * math.sin(b.t * 2 + sw) + 0.6 * d.lunge), 0, 0)
				A.pose(b, "Forearm" .. n .. s, -f * (0.15 * math.sin(b.t * 2.6 + sw)), 0, 0)
			else
				A.pose(b, "UpperArm" .. n .. s, f * 0.15 * sw * w * amp, 0, 0) -- 늘어진 진자
				A.pose(b, "Forearm" .. n .. s, f * 0.1 * sw * w * amp, 0, 0)
			end
		end
	end
	-- 등 사이 살 막: 두 상체 벌어짐에 따라 늘어남, 허리띠 끈 흔들림
	A.pose(b, "Web", 0, 0, 0, Vector3.new(0, 0.05 * math.sin(b.t * 1.4), 0))
	A.pose(b, "Belt", 0, 0, 0.12 * math.sin(ph * math.pi * 2 - 0.8) * amp)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="276">
          <Properties>
            <string name="Name">c6n</string>
            <string name="Source"><![CDATA[--!strict
-- c6n 도배된 것: 걷지 않는다 — 벽지 면(Sheet)째 가까운 벽에 붙어 미끄러진다.
-- 0.25초마다 좌우로 레이캐스트해 더 가까운 벽을 찾고, Sheet 를 그 벽 면으로 옮긴다(왼쪽 벽이면 Y 축 180° 뒤집기).
-- 이동: 머리 쪽이 먼저 솟고 뒤가 끌리며 따라오는 물결(줄무늬 면이 0.9초 주기로 부풀었다 가라앉음). 이동 거리마다 종이 쓸림(b.step 약하게).
-- 잠듦: 4초 주기로 아주 얕게 숨쉼. 서버 Emerge = 얼굴 1.5·손 1.05·무릎 0.75 밀려 나옴 + 붉은 틈 속 눈이 열림,
-- Burst = 팔이 벽 밖으로 2.6 튀어나왔다 들어감(0.25초 / 1.2초 뒤 되돌림). Ripple(음파) = 면 전체가 움찔.
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local W0 = 4
local CYCLE = 3.6 -- 물결 한 번에 나아가는 거리(0.9초 × 4/초)

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

function M.init(b: A.Body)
	local d = b.data
	d.side = 1
	d.dist = W0
	d.rayT = 0
	d.emerge = 0
	d.burst = -1
	d.lastBurst = b.model:GetAttribute("Burst")
	d.lastRipple = b.model:GetAttribute("Ripple")
	d.ripple = 0
	d.travel = 0
	d.flip = 0
	d.lay = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	-- 가까운 벽 찾기
	d.rayT -= dt
	if d.rayT <= 0 then
		d.rayT = 0.25
		local stage = workspace:FindFirstChild("Stage")
		if stage then
			rayParams.FilterDescendantsInstances = { stage }
			local cf = b.root.CFrame
			local from = cf:PointToWorldSpace(Vector3.new(0, 1, 0))
			local bestS, bestD = nil :: number?, math.huge
			for _, s in { -1, 1 } do
				local hit = workspace:Raycast(from, cf.RightVector * (7 * s), rayParams)
				if hit and hit.Distance < bestD then
					bestS, bestD = s, hit.Distance
				end
			end
			if bestS then
				d.side = bestS
				d.dist = bestD
			end
		end
	end
	d.flip = A.approach(d.flip, if d.side > 0 then 0 else math.pi, 10, dt)
	-- 서버 신호
	local bu = b.model:GetAttribute("Burst")
	if bu ~= d.lastBurst then
		d.lastBurst = bu
		d.burst = 0
		b.step(b.root.Position, 1.4) -- (찢김)
	end
	local rp = b.model:GetAttribute("Ripple")
	if rp ~= d.lastRipple then
		d.lastRipple = rp
		d.ripple = 1
	end
	d.ripple = math.max(0, d.ripple - dt * 2)
	local emerging = b.model:GetAttribute("Emerge") == true
	d.emerge = A.approach(d.emerge, if emerging then 1 else 0, if emerging then 1.6 else 2.5, dt) -- (1.2초에 밀려 나옴)
	local burst = 0
	if d.burst >= 0 then
		d.burst += dt
		local t = d.burst
		burst = if t < 0.25 then t / 0.25 elseif t < 1.2 then 1 elseif t < 1.7 then 1 - (t - 1.2) / 0.5 else 0
		if t >= 1.7 then
			d.burst = -1
		end
	end
	-- 물결(이동) + 숨(잠듦) + 움찔(음파): 면 전체의 깊이
	local moving = math.clamp(b.speed / 3, 0, 1)
	b.phase = (b.phase + b.speed * dt / CYCLE) % 1
	d.travel += b.speed * dt
	if d.travel > 1.5 then
		d.travel -= 1.5
		b.step(b.root.Position, 0.25) -- 사각사각
	end
	local wave = math.sin(b.phase * math.pi * 2) * 0.12 * moving
	local breathe = 0.04 * math.sin(b.t * math.pi * 2 / 4)
	local depth = breathe + wave + 0.18 * d.ripple * math.sin(b.t * 30) + 0.15 * d.emerge
	-- Sheet: 루트 기준 오른쪽 벽(x = +W0)에 만든 몸을 실제 벽 면(x = side × dist)으로. 깊이는 복도 쪽(벽 법선)
	local xs = d.dist - W0 - depth
	A.pose(b, "Sheet", 0, d.flip, 0, Vector3.new(xs * d.side, 0, 0))
	-- 머리 쪽이 먼저(앞, −Z 쪽) 솟는 물결: 척추를 진행 쪽으로 살짝 끌고 감
	-- 움직일 땐 몸을 눕혀 머리가 진행 쪽(−Z, 뒤집힌 벽이면 반대)으로 앞장선다. 멈추면 다시 머리를 아래로
	d.lay = A.approach(d.lay, moving * (1 - d.emerge), 3, dt)
	local lay = d.lay * 1.15 * math.cos(d.flip)
	A.pose(b, "Spine", lay, 0, 0, Vector3.new(-0.1 * math.max(0, math.sin(b.phase * math.pi * 2 + 1)) * moving, -1.2 * d.lay, 0))
	-- 밀려 나옴(뼈 로컬 −X = 복도 쪽; 뒤집힌 쪽도 Sheet 를 따라 자동으로)
	local e = d.emerge
	A.pose(b, "Head", 0.06 * math.sin(b.t * 1.3) * (0.3 + e), 0, 0, Vector3.new(-0.95 * e, 0, 0))
	A.pose(b, "Eye", 0, 0, 0, Vector3.new(-0.15 * e, 0, 0))
	A.pose(b, "HandB", 0, 0, 0, Vector3.new(-0.7 * e, 0, 0))
	A.pose(b, "KneeA", 0, 0, 0, Vector3.new(-0.4 * e, 0, 0))
	A.pose(b, "KneeB", 0, 0, 0, Vector3.new(-0.35 * e, 0, 0))
	-- 팔 A: 잠듦엔 납작, 드러나면 손가락이 종이를 찢고 나옴, Burst 땐 팔째 복도 쪽으로 2.6
	A.pose(b, "UpperArmA", 0, 0, 0, Vector3.new(-0.3 * e - 1.2 * burst, 0.4 * burst, 0))
	A.pose(b, "ForearmA", 0, 0, 0, Vector3.new(-0.2 * e - 1.0 * burst, 0.3 * burst, 0))
	A.pose(b, "HandA", 0, 0, 0.25 * math.sin(b.t * 7) * e * (1 - burst), Vector3.new(-0.45 * e - 0.4 * burst, 0, 0))
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="277">
          <Properties>
            <string name="Name">c7h</string>
            <string name="Source"><![CDATA[--!strict
-- c7h 손든 아이: 뻣뻣한 행진(무릎 거의 안 굽힘, 뒤꿈치 찰싹 → 발바닥 전체, 발끝 밀기 거의 없음).
-- 팔·머리·상체는 한 덩어리로 고정 — 골반만 위아래로, 위의 11.9 기둥이 미끄러지듯 다가온다.
-- 서버 Turn = 돌아서는 순간 관절이 한꺼번에 우두둑(몸 떨림). 추격 중 가까우면 굳은 팔이 처음으로 앞으로 떨어져 내려친다.
local Players = game:GetService("Players")
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local DUTY = 0.6
local REF = 7

local function angOf(z: number, y: number): number
	return math.atan2(-z, -y)
end

local function legIK(b: A.Body, thigh: string, shin: string, hip: Vector3, target: Vector3, parentRx: number): (number, number)
	local T0, S0 = b.tip[thigh], b.tip[shin]
	local l1 = math.sqrt(T0.Y * T0.Y + T0.Z * T0.Z)
	local l2 = math.sqrt(S0.Y * S0.Y + S0.Z * S0.Z)
	local dy, dz = target.Y - hip.Y, target.Z - hip.Z
	local dist = math.clamp(math.sqrt(dy * dy + dz * dz), math.abs(l1 - l2) + 0.01, l1 + l2 - 0.002)
	local phi = angOf(dz, dy)
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local a2 = math.acos(math.clamp((l2 * l2 + dist * dist - l1 * l1) / (2 * l2 * dist), -1, 1))
	local thighRx = (phi + a1) - angOf(T0.Z, T0.Y) - parentRx
	local shinRx = (phi - a2) - angOf(S0.Z, S0.Y) - thighRx - parentRx
	return thighRx, shinRx
end

-- 행진 곡선: 발을 낮게 끌듯 넘기고, 뒤꿈치로 찰싹 착지
local function footCurve(phase: number, prev: number, o: number, stride: number): (number, number, number, boolean)
	local q, qp = (phase + o) % 1, (prev + o) % 1
	local half = DUTY * stride / 2
	local z, h, pitch
	if q < DUTY then
		local s = q / DUTY
		z = -half + 2 * half * s
		h = 0
		pitch = if s < 0.12 then 0.2 * (1 - s / 0.12) else 0
	else
		local s = (q - DUTY) / (1 - DUTY)
		z = half - 2 * half * (0.5 - 0.5 * math.cos(s * math.pi))
		h = 0.22 * math.sin(s * math.pi)
		pitch = 0.2 * s
	end
	return z, h, pitch, qp > q
end

local function nearestDist(pos: Vector3): number
	local best = math.huge
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r then
			best = math.min(best, (r.Position - pos).Magnitude)
		end
	end
	return best
end

function M.init(b: A.Body)
	b.data.amp = 0
	b.data.lastTurn = b.model:GetAttribute("Turn")
	b.data.turn = -1
	b.data.strike = 0
	b.data.strikeT = 0
	b.data.check = 0
	b.data.close = false
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	d.amp = A.approach(d.amp, math.clamp(b.speed / REF, 0, 1.5), 6, dt)
	local amp = math.min(d.amp, 1)
	local stride = 3.0 + 0.1 * math.max(0, b.speed - 7) -- 짧은 아이 다리: 추격 땐 보폭을 늘려 겨우 따라간다
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / stride) % 1
	local ph = b.phase
	local dir = if b.vel.Z > 0.5 then -1 else 1
	-- 무릎을 펴고 걸으니 다리를 벌릴수록 골반이 내려가야 한다: 디딤 보폭에서 필요한 높이를 계산
	local l = b.tip.ThighL.Magnitude + b.tip.ShinL.Magnitude
	local half = DUTY * stride / 2 * amp
	local dip = l - math.sqrt(math.max(0.1, l * l - half * half))
	local bob = (-dip - 0.03 - 0.06 * math.cos(ph * math.pi * 4)) * amp - 0.04 * amp
	-- 돌아서기 떨림
	local tn = b.model:GetAttribute("Turn")
	if tn ~= d.lastTurn then
		d.lastTurn = tn
		d.turn = 0
	end
	local jolt = 0
	if d.turn >= 0 then
		d.turn += dt
		jolt = math.sin(d.turn * 60) * 0.05 * math.max(0, 1 - d.turn / 0.35)
		if d.turn > 0.35 then
			d.turn = -1
		end
	end
	local pOff = Vector3.new(0, bob, 0)
	A.pose(b, "Pelvis", 0, 0, jolt, pOff)
	local pelvisPos = b.rest.Pelvis.Position + pOff
	for i, n in { "L", "R" } do
		local hip = pelvisPos + b.rest["Thigh" .. n].Position
		local ankle = b.rest.Pelvis.Position + b.rest["Thigh" .. n].Position + b.tip["Thigh" .. n] + b.tip["Shin" .. n]
		local z, h, pitch, contact = footCurve(ph, prev, if i == 1 then 0 else 0.5, stride)
		local target = ankle + Vector3.new(0, h * amp, z * amp * dir)
		local tRx, sRx = legIK(b, "Thigh" .. n, "Shin" .. n, hip, target, 0)
		sRx = math.max(sRx, -math.rad(12) - 0.05) -- 무릎 굽힘 상한 12°
		A.pose(b, "Thigh" .. n, tRx, 0, 0)
		A.pose(b, "Shin" .. n, sRx, 0, 0)
		A.pose(b, "Foot" .. n, pitch * amp - tRx - sRx, 0, 0)
		local q = (ph + (if i == 1 then 0 else 0.5)) % 1
		A.pose(b, "Slipper" .. n, if q >= DUTY then -0.25 * math.sin((q - DUTY) / (1 - DUTY) * math.pi) * amp else 0, 0, 0) -- 뒤축 펄럭
		if contact and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), math.clamp(b.speed / 10, 0.4, 1.4)) -- 찰싹
		end
	end
	-- 상체는 고정. 재킷 밑단만 진자
	A.pose(b, "Jacket", 0.12 * math.sin(ph * math.pi * 4 - 0.6) * amp, 0, 0)
	-- 내려치기: 추격 중 4.5 안이면 팔이 앞으로 떨어짐(62°) → 내려침(122°), 머리 +30° 들림
	d.check -= dt
	if d.check <= 0 then
		d.check = 0.15
		d.close = b.state == "Chase" and nearestDist(b.root.Position) < 4.5
	end
	if d.close then
		d.strikeT += dt
	else
		d.strikeT = math.max(0, d.strikeT - dt * 2)
	end
	local s = d.strikeT
	local target = if s <= 0 then 0 elseif s < 0.6 then math.rad(62) * (s / 0.6) elseif s < 1.0 then math.rad(62 + 60 * (s - 0.6) / 0.4) else math.rad(122)
	if s > 1.4 then
		d.strikeT = 0 -- 한 번 내려친 뒤 다시 든다
	end
	d.strike = A.approach(d.strike, target, 18, dt)
	A.pose(b, "UpperArmL", -d.strike, 0, 0)
	A.pose(b, "UpperArmR", -d.strike, 0, 0)
	A.pose(b, "NeckDrop", -math.rad(30) * math.clamp(d.strike / math.rad(62), 0, 1), 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="278">
          <Properties>
            <string name="Name">c7n</string>
            <string name="Source"><![CDATA[--!strict
-- c7n 굴렁쇠: 고리 전체(Hoop 뼈)를 굴린다. 구름 각 = 이동 거리 / 반지름(미끄러짐 없음).
-- 방향 전환(서버 Spin 속성) 땐 동전처럼 쓰러져 돌았다가 다시 일어선다. 한 바퀴마다 머리가 바닥을 스치는 소리.
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local RADIUS = 1.98

function M.init(b: A.Body)
	b.data.roll = 0
	b.data.spin = -1
	b.data.lastSpin = b.model:GetAttribute("Spin")
	b.data.nextThump = math.pi * 2
	b.data.tilt = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	local sp = b.model:GetAttribute("Spin")
	if sp ~= d.lastSpin then
		d.lastSpin = sp
		d.spin = 0 -- 쓰러져 돌기 시작
	end
	local tiltT, yaw = 0, 0
	if d.spin >= 0 then
		d.spin += dt
		local t = d.spin
		-- 0~0.5 쓰러짐, 0.5~1.3 웅웅 돌기, 1.3~1.8 일어섬
		if t < 0.5 then
			tiltT = math.rad(68) * (t / 0.5)
		elseif t < 1.3 then
			tiltT = math.rad(68)
			yaw = (t - 0.5) * 9
		elseif t < 1.8 then
			tiltT = math.rad(68) * (1 - (t - 1.3) / 0.5)
		else
			d.spin = -1
		end
	elseif b.state == "Wander" and b.speed < 0.5 then
		tiltT = math.rad(13) -- 서 있을 땐 훌라후프처럼 비스듬히 기대 있음
	end
	d.tilt = A.approach(d.tilt, tiltT, 10, dt)
	-- 구르기: 앞(-Z)으로 가면 고리 윗부분이 앞으로(X 축 음의 회전)
	local fwd = -b.vel.Z
	d.roll -= fwd * dt / RADIUS
	if math.abs(d.roll) >= d.nextThump then
		d.nextThump += math.pi * 2
		b.step(b.root.Position + Vector3.new(0, -1.9, 0), math.clamp(b.speed / 14, 0.3, 1.4))
	end
	A.pose(b, "Hoop", d.roll, yaw, d.tilt)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="279">
          <Properties>
            <string name="Name">c8h</string>
            <string name="Source"><![CDATA[--!strict
-- c8h 눈높이: 무릎 걸음. 접지 목표는 발이 아니라 무릎(KneeContact) — 한쪽 무릎을 들어 앞으로 짚고(b.step),
-- 골반이 좌우로 ±8° 기울며 반대쪽 정강이는 바닥을 쓸며 끌려온다(정강이는 늘 바닥과 나란하게).
-- 얼굴(FaceAim)만 가까운 플레이어 머리 쪽을 올려다본다. 쉴 때 가끔 왼손 검지를 입 앞에 대는 '쉿'.
local Players = game:GetService("Players")
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local STRIDE = 1.5 -- 한 주기(무릎 두 번)에 가는 거리
local DUTY = 0.62
local REF = 2.5

local function angOf(z: number, y: number): number
	return math.atan2(-z, -y)
end

-- 무릎 걸음 곡선: 디딤 동안 무릎이 바닥에서 뒤로, 들 때 0.15 들려 앞으로
local function kneeCurve(phase: number, prev: number, o: number): (number, number, boolean, boolean)
	local q, qp = (phase + o) % 1, (prev + o) % 1
	local half = DUTY * STRIDE / 2
	if q < DUTY then
		return -half + 2 * half * (q / DUTY), 0, true, qp > q
	end
	local s = (q - DUTY) / (1 - DUTY)
	return half - 2 * half * (0.5 - 0.5 * math.cos(s * math.pi)), 0.15 * math.sin(s * math.pi), false, false
end

function M.init(b: A.Body)
	b.data.amp = 0
	b.data.aimX = 0
	b.data.aimY = 0
	b.data.look = 0
	b.data.lookAt = nil
	b.data.shh = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	d.amp = A.approach(d.amp, math.clamp(b.speed / REF, 0, 1.4), 6, dt)
	local amp = math.min(d.amp, 1)
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / STRIDE) % 1
	local ph = b.phase
	local dir = if b.vel.Z > 0.5 then -1 else 1
	local restP = b.rest.Pelvis.Position
	-- 무릎 목표와, 디딤 무릎이 바닥에 닿도록 필요한 골반 높이
	local zs, hs, stance, contact = {}, {}, {}, {}
	local need = math.huge
	for i, n in { "L", "R" } do
		local z, h, st, c = kneeCurve(ph, prev, if i == 1 then 0 else 0.5)
		zs[i], hs[i], stance[i], contact[i] = z * amp * dir, h * amp, st, c
		if st then
			local T0 = b.tip["Thigh" .. n]
			local l = math.sqrt(T0.Y * T0.Y + T0.Z * T0.Z)
			local dz = T0.Z + zs[i]
			need = math.min(need, math.sqrt(math.max(0.05, l * l - dz * dz)) - (-T0.Y))
		end
	end
	if need == math.huge then
		need = 0
	end
	local tiltSide = math.cos((ph - DUTY / 2) * math.pi * 2) -- +1 = 왼무릎 디딤
	local roll = math.rad(8) * tiltSide * amp
	local bob = need + 0.02 * math.sin(b.t * 1.4)
	local pOff = Vector3.new(-0.08 * tiltSide * amp, bob, 0)
	A.pose(b, "Pelvis", 0, 0, roll, pOff)
	for i, n in { "L", "R" } do
		local T0 = b.tip["Thigh" .. n]
		local hip = restP + pOff + b.rest["Thigh" .. n].Position
		local knee = restP + b.rest["Thigh" .. n].Position + T0
		local target = knee + Vector3.new(0, hs[i], zs[i])
		local rx = angOf(target.Z - hip.Z, target.Y - hip.Y) - angOf(T0.Z, T0.Y)
		A.pose(b, "Thigh" .. n, rx, 0, -roll)
		A.pose(b, "ShinSkid" .. n, -rx, 0, 0) -- 정강이는 바닥에 눕힌 채 끌림
		A.pose(b, "FootUp" .. n, 0.1 * math.sin(ph * math.pi * 2 + i) * amp, 0, 0)
		if contact[i] and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), math.clamp(b.speed / 4, 0.4, 1.2)) -- 무릎이 바닥을 짚는 둔탁한 소리
		end
	end
	-- 상체: 무릎 디딤에 따라 비틀림만 조금, 숨
	A.pose(b, "Spine", 0.03 * math.sin(b.t * 1.4), 0.05 * tiltSide * amp, -roll * 0.6)
	-- 얼굴 조준: 가까운 플레이어 머리를 올려다봄(0.2초마다 다시 찾음), 없으면 천천히 헤맴
	d.look -= dt
	if d.look <= 0 then
		d.look = 0.2
		d.lookAt = nil
		local best = 30
		for _, p in Players:GetPlayers() do
			local char = p.Character
			local head = char and char:FindFirstChild("Head") :: BasePart?
			if head then
				local dist = (head.Position - b.root.Position).Magnitude
				if dist < best then
					best = dist
					d.lookAt = head.Position
				end
			end
		end
	end
	local ax, ay = 0.15 * math.sin(b.t * 0.37), 0.5 * math.sin(b.t * 0.23)
	if d.lookAt then
		local face = b.root.CFrame:PointToWorldSpace(b.rest.Pelvis.Position + Vector3.new(0, 0.9, -1.1))
		local v = b.root.CFrame:VectorToObjectSpace(d.lookAt - face)
		ay = math.clamp(math.atan2(-v.X, -v.Z), -1.1, 1.1)
		ax = math.clamp(math.atan2(v.Y, math.sqrt(v.X * v.X + v.Z * v.Z)), -0.3, 1.2)
	end
	d.aimX = A.approach(d.aimX, ax, 5, dt)
	d.aimY = A.approach(d.aimY, ay, 5, dt)
	A.pose(b, "NeckBend2", 0, d.aimY * 0.3, 0)
	A.pose(b, "FaceAim", d.aimX * 0.7, d.aimY * 0.7, 0)
	-- 오른손: 내민 채 살짝 떨림. 왼손: 바닥을 끄는데, 쉴 땐 9초마다 2초 '쉿'
	local idle = 1 - amp
	local shhT = if (b.t % 9) < 2 and idle > 0.7 then 1 else 0
	d.shh = A.approach(d.shh, shhT, 5, dt)
	A.pose(b, "UpperArmR", 0.03 * math.sin(b.t * 2.3), 0, 0)
	A.pose(b, "HandR", 0.04 * math.sin(b.t * 3.1), 0, 0)
	A.pose(b, "UpperArmL", -1.1 * d.shh + 0.12 * math.sin(ph * math.pi * 2) * amp, 0, 0.3 * d.shh)
	A.pose(b, "ForearmL", -1.6 * d.shh, 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="280">
          <Properties>
            <string name="Name">c8n</string>
            <string name="Source"><![CDATA[--!strict
-- c8n 둥글게: 고리 회전 미끄러짐. RingRoot 가 서버 시계로 초당 25° 돌고(서버가 빈자리 방향을 같은 값으로 계산),
-- 맞잡은 손 매듭 1·3·5 와 2·4 가 번갈아 0.6 들렸다 딛는다(위상 = (이동 + 회전) 거리 / 0.9 주기 길이).
-- 요크는 디딤에 따라 물결처럼 오르내리고, 팔은 어깨 끝 → 매듭 두 마디 IK. 서버 RingR(4 → 2.5)로 고리가 좁혀지면
-- 요크가 안쪽으로 6° → 24° 기운다. 빈 손 둘은 바깥으로 열린 채 2초마다 천천히 쥐었다 편다.
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}

local FLOOR = -2
local R0 = 4
local R_MIN = 2.5
local SPIN = math.rad(25)
local SH_Y = 2.35
local GAP = math.rad(-90)
local STRIDE = 2.0
local UP = Vector3.new(0, 1, 0)

local function dir(a: number): Vector3
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

local function ik(a: Vector3, c: Vector3, l1: number, l2: number, pole: Vector3): Vector3
	local d = c - a
	local dist = math.clamp(d.Magnitude, 0.05, l1 + l2 - 0.01)
	local dd = d.Unit
	local x = (l1 * l1 - l2 * l2 + dist * dist) / (2 * dist)
	local h = math.sqrt(math.max(0, l1 * l1 - x * x))
	local side = pole - a
	side = side - dd * side:Dot(dd)
	if side.Magnitude < 1e-3 then
		side = UP
	end
	return a + dd * x + side.Unit * h
end

local function poseCF(b: A.Body, name: string, cf: CFrame, offset: Vector3?)
	local rx, ry, rz = cf:ToEulerAnglesYXZ()
	A.pose(b, name, rx, ry, rz, offset)
end

function M.init(b: A.Body)
	local d = b.data
	d.p = math.random()
	d.r = R0
	d.group = -1
	d.stepIdx = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	local rr = b.model:GetAttribute("RingR")
	d.r = A.approach(d.r, if typeof(rr) == "number" then rr else R0, 4, dt)
	local R = d.r
	local close = math.clamp((R0 - R) / (R0 - R_MIN), 0, 1)
	local sigma = (workspace:GetServerTimeNow() * SPIN) % (math.pi * 2)
	A.pose(b, "RingRoot", 0, sigma, 0)
	-- 디딤 위상: 미끄러짐 + 회전(둘레 속도) 거리에 묶는다
	d.p = (d.p + (b.speed + SPIN * R) * dt / STRIDE) % 1
	local function liftOf(k: number): number
		return A.lift(d.p + (k % 2) * 0.5, 0.45) * 0.6
	end
	-- 매듭 착지 소리: 한 무리(1·3·5 / 2·4)가 디딜 때 그중 하나에서
	local group = if (d.p % 1) < 0.45 then 0 elseif (d.p % 1) >= 0.5 and (d.p % 1) < 0.95 then 1 else -1
	if group == -1 and d.group ~= -1 then
		d.stepIdx = d.stepIdx % 5 + 1
		local a = GAP + math.rad(60 * d.stepIdx) - sigma
		b.step(b.root.CFrame:PointToWorldSpace(dir(a) * R + Vector3.new(0, FLOOR, 0)), math.clamp(0.4 + b.speed / 10, 0.4, 1.2))
	end
	d.group = group
	-- 매듭(디딤)
	local clasp: { Vector3 } = {}
	local lifts: { number } = {}
	for k = 1, 5 do
		local a = GAP + math.rad(60 * k)
		local l = liftOf(k)
		lifts[k] = l
		local off = dir(a) * (R - R0) + UP * l
		clasp[k] = dir(a) * R0 + Vector3.new(0, FLOOR + 0.18 + 0.05, 0) + off
		A.pose(b, "Clasp" .. k, 0.25 * l, 0, 0, off)
	end
	-- 요크와 팔
	local y0 = FLOOR + SH_Y
	for i = 1, 6 do
		local a = GAP + math.rad(30 + 60 * (i - 1))
		local u, t = dir(a), Vector3.new(-math.sin(a), 0, math.cos(a))
		local yc = u * R0 + Vector3.new(0, y0, 0)
		local lp = if i >= 2 then lifts[i - 1] else 0
		local ln = if i <= 5 then lifts[i] else 0
		local bob = 0.3 * (lp + ln) - 0.06
		local tilt = math.rad(6 + 18 * close)
		local rot = CFrame.fromAxisAngle(t, tilt)
		local off = u * (R - R0) + UP * bob
		poseCF(b, "Yoke" .. i, rot, off)
		for _, s in { { "P", 1 }, { "M", -1 } } do
			local tag, sg = s[1] :: string, s[2] :: number
			local empty = (i == 6 and tag == "P") or (i == 1 and tag == "M")
			local upN, foreN = "Arm" .. i .. tag .. "_Up", "Arm" .. i .. tag .. "_Fore"
			local restUp, restFore = b.tip[upN], b.tip[foreN]
			if restUp and restFore and restUp.Magnitude > 0 then
				local tipRest = yc + t * (0.78 * sg) - UP * 0.08
				local S = yc + off + rot * (tipRest - yc)
				local H: Vector3
				if empty then
					-- 빈 손: 플레이어를 부르듯 바깥으로 뻗었다 당겼다(2초)
					local reach = 0.15 * math.sin(b.t * math.pi)
					local out = dir(GAP - sg * math.rad(13))
					H = out * (R + 0.9 + reach) + Vector3.new(0, FLOOR + 1.35 + 0.1 * math.sin(b.t * 1.3 + i), 0)
				else
					H = clasp[if tag == "P" then i else i - 1]
				end
				local el = ik(S, H, restUp.Magnitude, restFore.Magnitude, S + u * 0.5 + UP * 1.2)
				local r1 = CFrame.fromRotationBetweenVectors(restUp.Unit, rot:VectorToObjectSpace(el - S).Unit)
				poseCF(b, upN, r1)
				local r2 = CFrame.fromRotationBetweenVectors(restFore.Unit, (rot * r1):VectorToObjectSpace(H - el).Unit)
				poseCF(b, foreN, r2)
				if empty then
					-- 쥐었다 펴기: 손 전체가 손가락 쪽으로 접혔다 펴짐(옆 축)
					local out = dir(GAP - sg * math.rad(13))
					local side = Vector3.new(-out.Z, 0, out.X)
					local grip = 0.55 * (0.5 - 0.5 * math.cos(b.t * math.pi))
					local parent = rot * r1 * r2
					local want = CFrame.fromAxisAngle(side, -grip)
					poseCF(b, "Arm" .. i .. tag .. "_Hand", parent:Inverse() * want)
				end
			end
		end
	end
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="281">
          <Properties>
            <string name="Name">c9h</string>
            <string name="Source"><![CDATA[--!strict
-- c9h 후방감지: 뒤로 걷는 두 발 보행(몸은 +Z 를 보고 루트는 -Z 로 간다).
-- 뒤로 뻗은 발이 발끝부터 닿고(발목 +24°) 뒤꿈치까지 내려 무게를 옮긴다 — 접지 순간 b.step.
-- 골반은 디딤발 쪽으로 기울고(±3°) 디딤 가운데서 솟는다. 무릎은 얼굴 쪽으로 꺾임(극 = +Z).
-- 손은 진행 쪽으로 더듬고, 거꾸로 매달린 머리는 목 2마디만 흔들린다. Band(센서 단계)가 높을수록 입이 벌어지고 손가락이 오므라듦.
-- 서버 Turn = 음파 뒤 1.8초 돌아서기: 골반을 30° 틀었다가 반대로 틀어 정렬(핸들 꺾기).
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}
local DUTY = 0.5 -- 주기 1.2초: 발끝 닿음 0.3 + 무게 이동 0.3 + 들어 넘김 0.6 (디딤 = 반)
local STRIDE = 3.0

local function rotTo(a: Vector3, b: Vector3): CFrame
	local au, bu = a.Unit, b.Unit
	local c = au:Cross(bu)
	local s = c.Magnitude
	if s < 1e-5 then
		return CFrame.identity
	end
	return CFrame.fromAxisAngle(c / s, math.atan2(s, au:Dot(bu)))
end

local function setRot(b: A.Body, name: string, cf: CFrame, offset: Vector3?)
	local rx, ry, rz = cf:ToEulerAnglesYXZ()
	A.pose(b, name, rx, ry, rz, offset)
end

-- 2마디 IK(부모 회전 pr): 끝 뼈의 루트 기준 회전을 돌려준다
local function ik2(b: A.Body, upper: string, lower: string, j: Vector3, t: Vector3, pole: Vector3, pr: CFrame): CFrame
	local T0, S0 = b.tip[upper], b.tip[lower]
	local l1, l2 = T0.Magnitude, S0.Magnitude
	local dv = t - j
	local dist = math.clamp(dv.Magnitude, math.abs(l1 - l2) + 0.02, l1 + l2 - 0.01)
	local u = dv.Unit
	local w = pole - u * pole:Dot(u)
	w = if w.Magnitude > 1e-4 then w.Unit else Vector3.zAxis
	local a1 = math.acos(math.clamp((l1 * l1 + dist * dist - l2 * l2) / (2 * l1 * dist), -1, 1))
	local elbow = j + u * (l1 * math.cos(a1)) + w * (l1 * math.sin(a1))
	local r1 = rotTo(T0, pr:VectorToObjectSpace(elbow - j))
	local r2 = rotTo(S0, (pr * r1):VectorToObjectSpace(j + u * dist - elbow))
	setRot(b, upper, r1)
	setRot(b, lower, r2)
	return pr * r1 * r2
end

local function restAbs(b: A.Body): { [string]: Vector3 }
	local out: { [string]: Vector3 } = {}
	local function get(n: string): Vector3
		local v = out[n]
		if v then
			return v
		end
		local mo = b.m[n]
		local p = mo and mo.Part0
		v = b.rest[n].Position
		if p and string.sub(p.Name, 1, 5) == "Bone_" then
			v += get(string.sub(p.Name, 6))
		end
		out[n] = v
		return v
	end
	for n in b.m do
		get(n)
	end
	return out
end

function M.init(b: A.Body)
	local d = b.data
	d.abs = restAbs(b)
	d.amp = 0
	d.turn = -1
	d.lastTurn = b.model:GetAttribute("Turn")
	d.jaw = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	d.amp = A.approach(d.amp, math.clamp(b.speed / 5, 0, 1.4), 6, dt)
	local amp = math.min(d.amp, 1)
	local stride = STRIDE + 0.12 * math.max(0, b.speed - 5)
	local prev = b.phase
	b.phase = (b.phase + b.speed * dt / stride) % 1
	local ph = b.phase
	-- 돌아서기(핸들 꺾기): 골반 +30° → -10° → 0
	local tn = b.model:GetAttribute("Turn")
	if tn ~= d.lastTurn then
		d.lastTurn = tn
		d.turn = 0
	end
	local twist = 0
	if d.turn >= 0 then
		d.turn += dt
		local t = d.turn
		twist = if t < 0.7 then math.rad(30) * math.sin(t / 0.7 * math.pi / 2) elseif t < 1.4 then math.rad(30 - 40 * (t - 0.7) / 0.7) else math.rad(-10) * (1 - (t - 1.4) / 0.4)
		if t > 1.8 then
			d.turn = -1
			twist = 0
		end
	end
	-- 골반: 디딤발 쪽 기울기 + 디딤 가운데서 솟음(두 번/주기)
	local sway = math.sin(ph * math.pi * 2)
	local bob = (0.08 * math.cos(ph * math.pi * 4) - 0.06) * amp
	local pOff = Vector3.new(0.1 * sway * amp, bob, 0)
	local pRot = CFrame.fromEulerAnglesYXZ(0, twist, math.rad(3) * sway * amp)
	setRot(b, "Pelvis", pRot, pOff)
	local pelvis = d.abs.Pelvis + pOff
	local pelvisCF = CFrame.new(pelvis) * pRot
	for i, n in { "L", "R" } do
		local o = if i == 1 then 0 else 0.5
		local q, qp = (ph + o) % 1, (prev + o) % 1
		local z, h, pitch
		local half = DUTY * stride / 2 * amp
		if q < DUTY then
			-- 디딤: 발끝 닿음(발목 +24°) → 뒤꿈치까지 내려옴 → 발바닥이 몸 앞(+Z)쪽으로 지나감
			local k = q / DUTY
			z = -half + 2 * half * k
			h = 0
			pitch = if k < 0.5 then math.rad(24) * (1 - k / 0.5) else 0
		else
			-- 들어 넘김: 몸 뒤(-Z, 진행 쪽)로 뻗음, 끝에서 발끝을 내림
			local k = (q - DUTY) / (1 - DUTY)
			z = half - 2 * half * (0.5 - 0.5 * math.cos(k * math.pi))
			h = 0.35 * math.sin(k * math.pi)
			pitch = math.rad(24) * math.clamp((k - 0.5) / 0.5, 0, 1)
		end
		local ankle = d.abs["Foot" .. n]
		local target = ankle + Vector3.new(0, (h + pitch * 0.35) * amp, z)
		local hip = pelvisCF:PointToWorldSpace(d.abs["Thigh" .. n] - d.abs.Pelvis)
		local legRot = ik2(b, "Thigh" .. n, "Shin" .. n, hip, target, Vector3.new(0, 0.1, 1), pRot)
		setRot(b, "Foot" .. n, legRot:Inverse() * CFrame.Angles(pitch * amp, 0, 0))
		if qp >= DUTY and q < DUTY and amp > 0.3 then
			b.step(b.root.CFrame:PointToWorldSpace(target), math.clamp(b.speed / 9, 0.4, 1.4)) -- 끽 — 툭
		end
	end
	-- 더듬는 손: 진행 쪽으로 번갈아 뻗음
	local band = (b.model:GetAttribute("Band") :: number?) or 0
	for i, n in { "L", "R" } do
		local s = if i == 1 then 1 else -1
		A.pose(b, "UpperArm" .. n, (-0.12 + 0.18 * s * sway) * amp - 0.05 * band, 0, 0)
		A.pose(b, "Forearm" .. n, 0.1 * math.sin(b.t * 2 + i) - 0.06 * band, 0, 0)
		A.pose(b, "Hand" .. n, 0.25 * math.sin(b.t * 5 + i * 2) * 0.4 + 0.12 * band, 0, 0)
	end
	-- 척추: 숨(등의 활이 조금 더 휘었다 풀림), 거꾸로 매달린 머리는 목 2마디만 흔들림
	local br = math.sin(b.t * 1.4)
	A.pose(b, "Spine1", 0.02 * br, 0, 0)
	A.pose(b, "Spine2", 0.025 * br, 0, 0)
	A.pose(b, "Neck1", 0.06 * math.sin(b.t * 1.1) + 0.05 * sway * amp, 0, 0.04 * sway * amp)
	A.pose(b, "Neck2", 0.08 * math.sin(b.t * 1.1 + 1), 0.06 * math.sin(b.t * 0.7), 0)
	d.jaw = A.approach(d.jaw, 0.1 + 0.12 * band + (if b.state == "Chase" then 0.2 else 0), 4, dt)
	A.pose(b, "Jaw", -d.jaw, 0, 0)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="282">
          <Properties>
            <string name="Name">c9n</string>
            <string name="Source"><![CDATA[--!strict
-- c9n 깔린 것: 가장자리 물결 활공(가오리식). 걷지도 기지도 않는다.
-- 옆 지느러미 사슬(fin*1→2→3)이 바깥으로 갈수록 늦게 접혔다 펴지고, 등뼈 네 마디엔 앞 → 뒤로 흐르는 작은 물결.
-- 위상 = 이동 거리 / 5(주기 길이) + 아주 느린 숨. 쫓을 땐 두 손이 번갈아 바닥을 짚고 끌어당긴다(그때만 젖은 소리 b.step).
-- 서버 속성: Flat(음파 — 납작: 물결 멈춤, 몸 내려앉고 팔다리 벌어짐, 입술 닫힘), Lurk(매복 — 손가락만 톡…톡),
--           Grab(발목 낚아채기 — 붉은 입술이 60° 들리며 두 손이 앞으로 뻗음)
local A = require(script.Parent.Parent.CreatureAnim)

local M = {}

local STRIDE = 5.0
local PULL = 2.2 -- 쫓을 때 손 한 번 당기는 거리

function M.init(b: A.Body)
	local d = b.data
	d.p = math.random()
	d.pull = 0
	d.flat = 0
	d.lip = 0
	d.reach = 0
	d.grabT = -1
	d.lastGrab = b.model:GetAttribute("Grab")
	d.side = 0
end

function M.step(b: A.Body, dt: number)
	local d = b.data
	local flatOn = b.model:GetAttribute("Flat") == true
	local lurk = b.model:GetAttribute("Lurk") == true
	d.flat = A.approach(d.flat, if flatOn then 1 else 0, if flatOn then 15 else 3, dt) -- 납작해지는 건 0.2초, 펴지는 건 천천히
	local g = b.model:GetAttribute("Grab")
	if g ~= d.lastGrab then
		d.lastGrab = g
		d.grabT = 0
	end
	local grab = 0
	if d.grabT >= 0 then
		d.grabT += dt
		grab = if d.grabT < 0.25 then d.grabT / 0.25 elseif d.grabT < 1.2 then 1 else math.max(0, 1 - (d.grabT - 1.2) / 0.6)
		if d.grabT > 1.8 then
			d.grabT = -1
		end
	end
	local fwd = -b.vel.Z
	local moving = math.clamp(b.speed / 3, 0, 1)
	d.p = (d.p + math.abs(fwd) * dt / STRIDE + dt * 0.08) % 1
	local live = 1 - d.flat
	local amp = (0.12 + 0.2 * moving) * live
	local ph = d.p * math.pi * 2
	-- 옆 가장자리 물결: 바깥 마디일수록 늦고 크다(양쪽 같은 위상 = 가오리 날갯짓)
	for i = 1, 3 do
		local w = amp * (0.6 + 0.25 * i) * math.sin(ph - i * 0.9)
		A.pose(b, "finL" .. i, 0, 0, -w)
		A.pose(b, "finR" .. i, 0, 0, w)
	end
	-- 등뼈: 앞 → 뒤로 흐르는 작은 물결, 납작해지면 몸이 바닥에 내려앉는다. 돌 때는 몸통이 옆으로 살짝 휜다
	d.side = A.approach(d.side, math.clamp(b.vel.X * 0.03, -0.25, 0.25), 4, dt)
	local sw = 0.035 * live * (0.4 + moving)
	A.pose(b, "spine0", sw * math.sin(ph + 1.5) * 0.5, 0, 0, Vector3.new(0, -0.12 * d.flat, 0))
	A.pose(b, "spine1", sw * math.sin(ph + 1.0), -d.side * 0.5, 0)
	A.pose(b, "spine2", sw * math.sin(ph + 0.5), -d.side * 0.5, 0)
	A.pose(b, "spine3", sw * math.sin(ph) + 0.05 * moving * live, 0, 0)
	-- 두개골·입술: 평소 아주 조금 들썩, 쫓을 땐 앞끝이 들리고, 낚아챌 땐 60°
	local lipT = (0.06 + 0.06 * math.sin(b.t * 1.3)) * live
	if b.state == "Chase" then
		lipT = 0.4 * live
	end
	lipT = math.max(lipT, 1.05 * grab)
	d.lip = A.approach(d.lip, lipT, 10, dt)
	A.pose(b, "skull", 0.12 * d.lip, 0, 0)
	A.pose(b, "lip", d.lip, 0, 0)
	-- 팔: 쫓을 땐 번갈아 앞으로 짚고 끌어당김(위상 = 거리 / PULL), 납작하면 옆으로 벌어짐, 낚아챌 땐 둘 다 앞으로
	local chasing = b.state == "Chase" and d.flat < 0.5
	local pullOld = d.pull
	if chasing then
		d.pull = (d.pull + math.max(0, fwd) * dt / PULL) % 1
		-- 한 손이 바닥을 짚는 순간(반 주기마다): 젖은 천 끄는 소리(작게)
		if math.floor(pullOld * 2) ~= math.floor(d.pull * 2) and b.speed > 2 then
			local side = if d.pull < 0.5 then -1.8 else 1.8
			b.step(b.root.CFrame:PointToWorldSpace(Vector3.new(side, -1.2, -4.3)), 0.25)
		end
	end
	d.reach = A.approach(d.reach, grab, 12, dt)
	local tap = if lurk then math.max(0, math.sin(b.t * 2.4)) ^ 8 * 0.35 else 0
	for _, s in { { "L", -1, 0 }, { "R", 1, 0.5 } } do
		local n, sg, off = s[1] :: string, s[2] :: number, s[3] :: number
		local swing = if chasing then A.wave(d.pull + off) * 0.35 else 0.05 * math.sin(b.t * 0.7 + off * 6)
		local spread = 0.3 * d.flat
		-- 팔 뿌리는 y(좌우 휘두름)로 앞뒤를, 손은 x 로 손끝을 바닥에 박았다 뗀다
		A.pose(b, "arm" .. n, 0, sg * (swing * 0.6 - spread) - sg * 0.25 * d.reach, 0)
		local lift = if chasing then math.max(0, A.wave(d.pull + off + 0.25)) * 0.25 else 0
		A.pose(b, "hand" .. n, -lift - tap * (if n == "L" then 1 else 0.6) + 0.2 * d.reach, sg * (swing * 0.4 - spread * 0.5) - sg * 0.3 * d.reach, 0)
		-- 다리: 끌리며 살짝 흔들림, 납작하면 벌어짐
		local drag = 0.08 * math.sin(ph + off * 6) * moving * live
		A.pose(b, "leg" .. n, 0, sg * (drag + 0.2 * d.flat), 0)
		A.pose(b, "foot" .. n, 0, sg * drag * 0.8, 0)
	end
end

return M
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="283">
        <Properties>
          <string name="Name">DoppelFx</string>
          <string name="Source"><![CDATA[--!strict
-- 도플갱어 연출(클라이언트):
--  1) 변신: 사람 모습(상자 6개)의 윤곽선이 조각나 사방으로 터져 흩날리다 사라진다(음파와 상관없이 보인다).
--  2) 눈: 음파가 괴물 모습의 도플갱어에 닿으면, 두 눈(이름 Eye)이 음파 선보다 조금 더 오래 하얗게 빛나다 꺼진다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)

local DoppelFx = {}
DoppelFx.bursts = 0 -- (테스트) 터진 횟수
DoppelFx.lastShards = 0 -- (테스트) 마지막으로 터질 때 만든 조각 수

local WHITE = Color3.new(1, 1, 1)
local folder: Folder? = nil
local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "DoppelFx"
	f.Parent = workspace
	folder = f
	return f
end

type Shard = { part: Part, pos: Vector3, vel: Vector3, rot: CFrame, spin: Vector3, born: number, life: number }
local shards: { Shard } = {}

local function newShard(cf: CFrame, len: number, vel: Vector3, life: number, now: number)
	local p = Instance.new("Part")
	p.Name = "Shard"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = WHITE
	p.Size = Vector3.new(0.07, 0.07, math.max(0.1, len))
	p.CFrame = cf
	p.Parent = getFolder()
	local spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 14
	table.insert(shards, { part = p, pos = cf.Position, vel = vel, rot = cf.Rotation, spin = spin, born = now, life = life })
end

-- 상자 하나의 12 모서리를 조각으로
local EDGES = {
	{ Vector3.new(-1, -1, -1), Vector3.new(1, -1, -1) },
	{ Vector3.new(-1, 1, -1), Vector3.new(1, 1, -1) },
	{ Vector3.new(-1, -1, 1), Vector3.new(1, -1, 1) },
	{ Vector3.new(-1, 1, 1), Vector3.new(1, 1, 1) },
	{ Vector3.new(-1, -1, -1), Vector3.new(-1, 1, -1) },
	{ Vector3.new(1, -1, -1), Vector3.new(1, 1, -1) },
	{ Vector3.new(-1, -1, 1), Vector3.new(-1, 1, 1) },
	{ Vector3.new(1, -1, 1), Vector3.new(1, 1, 1) },
	{ Vector3.new(-1, -1, -1), Vector3.new(-1, -1, 1) },
	{ Vector3.new(1, -1, -1), Vector3.new(1, -1, 1) },
	{ Vector3.new(-1, 1, -1), Vector3.new(-1, 1, 1) },
	{ Vector3.new(1, 1, -1), Vector3.new(1, 1, 1) },
}

function DoppelFx.burst(data: { at: Vector3, boxes: { { cf: CFrame, size: Vector3 } } })
	local cam = workspace.CurrentCamera
	if not data or not data.at or (cam and (cam.CFrame.Position - data.at).Magnitude > 160) then
		return
	end
	local now = os.clock()
	local made = 0
	local center = data.at
	for _, b in data.boxes or {} do
		local half = b.size / 2
		for _, e in EDGES do
			-- 모서리를 두 토막으로 나눠 더 잘게 부서지게
			local a = b.cf:PointToWorldSpace(e[1] * half)
			local c = b.cf:PointToWorldSpace(e[2] * half)
			for k = 0, 1 do
				local p0 = a:Lerp(c, k * 0.5)
				local p1 = a:Lerp(c, k * 0.5 + 0.5)
				local mid = (p0 + p1) / 2
				local out = mid - center
				out = if out.Magnitude > 0.01 then out.Unit else Vector3.yAxis
				local vel = out * (10 + math.random() * 18) + Vector3.new(0, 6 + math.random() * 10, 0)
				newShard(CFrame.lookAt(mid, p1), (p1 - p0).Magnitude, vel, 1.1 + math.random() * 0.7, now)
				made += 1
			end
		end
	end
	-- 몸 안쪽에서 튀어나오는 잔조각
	for _ = 1, 24 do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5)
		dir = if dir.Magnitude > 0.01 then dir.Unit else Vector3.yAxis
		local p = center + Vector3.new(0, math.random() * 2 - 0.5, 0)
		newShard(CFrame.lookAt(p, p + dir), 0.2 + math.random() * 0.5, dir * (14 + math.random() * 16), 0.8 + math.random() * 0.6, now)
		made += 1
	end
	DoppelFx.bursts += 1
	DoppelFx.lastShards = made
end

-- ── 눈 ──
local eyeUntil: { [Model]: { from: number, to: number } } = setmetatable({}, { __mode = "k" }) :: any
local litEyes: { [BasePart]: boolean } = {}

function DoppelFx.onPulse(origin: Vector3)
	local S = Config.Sonar
	local now = os.clock()
	for _, m in CollectionService:GetTagged(Config.Tags.Doppel) do
		if m:IsA("Model") and m.PrimaryPart and m:GetAttribute("Form") == "Beast" then
			local d = (m.PrimaryPart.Position - origin).Magnitude
			if d <= S.Radius + 2 then
				local from = now + math.min(1, d / 60)
				-- (몸이 보이는 10초 동안 눈도 빛난다)
				eyeUntil[m] = { from = from, to = from + ((S :: any).MonsterRevealSeconds or (S.Hold + Config.Doppel.EyeLinger)) }
			end
		end
	end
end

local function setEye(p: BasePart, on: boolean)
	if on then
		p.Transparency = 0
		p.Material = Enum.Material.Neon
		p.Color = WHITE
		litEyes[p] = true
	else
		p.Transparency = 1
		litEyes[p] = nil
	end
end

-- (테스트) 지금 빛나는 눈 수
function DoppelFx.litEyeCount(): number
	local n = 0
	for p in litEyes do
		if p.Parent then
			n += 1
		end
	end
	return n
end

local moveParts: { BasePart } = {}
local moveCFs: { CFrame } = {}
RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	-- 조각: 날아가며 돌고 떨어지다 검게(보이지 않게) 사라진다
	local i = 1
	while i <= #shards do
		local s = shards[i]
		local age = now - s.born
		if age >= s.life or not s.part.Parent then
			s.part:Destroy()
			shards[i] = shards[#shards]
			shards[#shards] = nil
		else
			s.vel += Vector3.new(0, -45 * dt, 0)
			s.vel *= (1 - math.min(0.9, dt * 1.2))
			s.pos += s.vel * dt
			s.rot = s.rot * CFrame.Angles(s.spin.X * dt, s.spin.Y * dt, s.spin.Z * dt)
			table.insert(moveParts, s.part)
			table.insert(moveCFs, CFrame.new(s.pos) * s.rot)
			local fade = math.clamp((age - s.life * 0.35) / (s.life * 0.65), 0, 1)
			local v = 1 - fade
			s.part.Color = Color3.new(v, v, v)
			i += 1
		end
	end
	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveCFs, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(moveParts)
		table.clear(moveCFs)
	end
	-- 눈
	for m, w in eyeUntil do
		local on = now >= w.from and now <= w.to and m.Parent ~= nil and m:GetAttribute("Form") == "Beast"
		local beast = m:FindFirstChild("Beast")
		if beast then
			for _, p in beast:GetChildren() do
				if p:IsA("BasePart") and p.Name == "Eye" then
					if on ~= (litEyes[p] == true) then
						setEye(p, on)
					end
				end
			end
		end
		if now > w.to then
			eyeUntil[m] = nil
		end
	end
end)

function DoppelFx.clear()
	for _, s in shards do
		s.part:Destroy()
	end
	table.clear(shards)
	table.clear(litEyes)
end

return DoppelFx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="284">
        <Properties>
          <string name="Name">JumpScare</string>
          <string name="Source"><![CDATA[--!strict
-- 괴물에게 잡혔을 때: 그 스테이지 괴물의 얼굴(흰 선)이 화면 가득 확 튀어나오며 흔들린다(점프스케어). 약 0.9초 뒤 YOU DIED.
-- 메인 괴물 얼굴은 괴물 머리와 같은 공용 모양(Shared/MonsterFaces, 3차 시안): 1 삼각 · 2 사각 · 3 원 · 4 별 · 5 육각.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Faces = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MonsterFaces"))

local JumpScare = {}
JumpScare.count = 0
JumpScare.Duration = 0.9
JumpScare.lastKind = "monster"

local player = Players.LocalPlayer


local gui = Instance.new("ScreenGui")
gui.Name = "JumpScare"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 50
gui.Enabled = false

local back = Instance.new("Frame")
back.Size = UDim2.fromScale(1, 1)
back.BackgroundColor3 = Color3.new(0, 0, 0)
back.BorderSizePixel = 0
back.Parent = gui

local face = Instance.new("Frame")
face.Name = "Face"
face.AnchorPoint = Vector2.new(0.5, 0.5)
face.Position = UDim2.fromScale(0.5, 0.5)
face.Size = UDim2.fromScale(0.95, 0.95)
face.BackgroundTransparency = 1
face.Parent = back
local aspect = Instance.new("UIAspectRatioConstraint")
aspect.AspectRatio = 1
aspect.Parent = face
local scale = Instance.new("UIScale")
scale.Parent = face
-- 시안 그림 챕터 괴물: 그 괴물의 덮침 그림(정면)을 화면 가득
local creatureImg = Instance.new("ImageLabel")
creatureImg.Name = "Creature"
creatureImg.BackgroundTransparency = 1
creatureImg.AnchorPoint = Vector2.new(0.5, 0.5)
creatureImg.Position = UDim2.fromScale(0.5, 0.58)
creatureImg.Size = UDim2.fromScale(1.6, 1.6)
creatureImg.ScaleType = Enum.ScaleType.Fit
creatureImg.Visible = false
creatureImg.ZIndex = 5
creatureImg.Parent = face

gui.Parent = player:WaitForChild("PlayerGui")

local WHITE = Color3.new(1, 1, 1)

-- 메인 괴물: 괴물 머리와 똑같은 얼굴(공용 MonsterFaces). 기울어진 그대로 화면을 거의 채운다
local function draw(shape: number)
	for _, c in face:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local size = face.AbsoluteSize.X
	if size < 10 then
		size = math.min(back.AbsoluteSize.X, back.AbsoluteSize.Y) * 0.95
	end
	local f = Faces.build(shape)
	local c, s = math.cos(math.rad(f.deg)), math.sin(math.rad(f.deg))
	local function rot(u: number, v: number): (number, number)
		u, v = u * f.scale, v * f.scale
		return u * c - v * s, u * s + v * c
	end
	-- 얼굴 전체가 들어가는 크기(혀·침까지)
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, l in f.lines do
		for _, q in l.pts do
			local x, y = rot(q[1], q[2])
			minX, minY, maxX, maxY = math.min(minX, x), math.min(minY, y), math.max(maxX, x), math.max(maxY, y)
		end
	end
	local cx, cy = (minX + maxX) / 2, (minY + maxY) / 2
	local k = 0.9 / math.max(maxX - minX, maxY - minY)
	local thick = math.max(4, size * 0.012)
	local function px(x: number, y: number): Vector2
		return Vector2.new((0.5 + (x - cx) * k) * size, (0.5 + (y - cy) * k) * size)
	end
	local function line(a: Vector2, b: Vector2, w: number, color: Color3?)
		local d = b - a
		local fr = Instance.new("Frame")
		fr.BackgroundColor3 = color or WHITE
		fr.BorderSizePixel = 0
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		fr.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
		fr.Size = UDim2.fromOffset(d.Magnitude + w, w)
		fr.Rotation = math.deg(math.atan2(d.Y, d.X))
		fr.Parent = face
	end
	for _, l in f.lines do
		local w = thick * math.clamp(l.r / 0.03, 0.4, 1)
		local n = #l.pts
		for i = 1, (if l.closed then n else n - 1) do
			local a, b = l.pts[i], l.pts[i % n + 1]
			local ax, ay = rot(a[1], a[2])
			local bx, by = rot(b[1], b[2])
			line(px(ax, ay), px(bx, by), w, l.tint) -- 이빨은 붉은색
		end
	end
	for _, e in f.circles do
		local x, y = rot(e.u, e.v)
		local p = px(x, y)
		local d = math.max(e.rad * f.scale * k * size * 2, thick * 1.5)
		local fr = Instance.new("Frame")
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		fr.Position = UDim2.fromOffset(p.X, p.Y)
		fr.Size = UDim2.fromOffset(d, d)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = fr
		if e.pupil then
			-- 눈동자: 꽉 찬 점
			fr.BackgroundColor3 = WHITE
			fr.BorderSizePixel = 0
		else
			fr.BackgroundTransparency = 1
			local st = Instance.new("UIStroke")
			st.Color = WHITE
			st.Thickness = thick * 0.8
			st.Parent = fr
		end
		fr.Parent = face
	end
end

-- 도플갱어: 둥근 머리의 빛나는 두 눈 + 머리에서 배까지 세로로 벌어진 입(양쪽 이빨), 솟은 어깨
-- (좌표는 Monster.luau 도플갱어 시안과 같은 그림에서 가져와, 머리~가슴이 화면을 채우게 맞춘다)
local function drawDoppel()
	for _, c in face:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local size = face.AbsoluteSize.X
	if size < 10 then
		size = math.min(back.AbsoluteSize.X, back.AbsoluteSize.Y) * 0.95
	end
	local thick = math.max(4, size * 0.011)
	local function px(x: number, y: number): Vector2
		-- 시안 픽셀(가운데 x=130, 화면 가운데 y=234) → 화면
		return Vector2.new((0.5 + (x - 130) / 190) * size, (0.5 + (y - 234) / 190) * size)
	end
	local function line(ax: number, ay: number, bx: number, by: number, w: number?)
		local a, b = px(ax, ay), px(bx, by)
		local d = b - a
		local f = Instance.new("Frame")
		f.BackgroundColor3 = WHITE
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
		f.Size = UDim2.fromOffset(d.Magnitude + (w or thick), w or thick)
		f.Rotation = math.deg(math.atan2(d.Y, d.X))
		f.Parent = face
	end
	local function bez(x0: number, y0: number, x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, n: number, w: number?)
		local px0, py0 = x0, y0
		for i = 1, n do
			local t = i / n
			local u = 1 - t
			local x = u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3
			local y = u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3
			line(px0, py0, x, y, w)
			px0, py0 = x, y
		end
	end
	local function dot(x: number, y: number, r: number)
		local c = px(x, y)
		local f = Instance.new("Frame")
		f.BackgroundColor3 = WHITE
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset(c.X, c.Y)
		f.Size = UDim2.fromOffset(r * 2 * size / 190, r * 2 * size / 190)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = f
		f.Parent = face
	end
	-- 머리
	bez(112, 186, 108, 160, 116, 146, 130, 146, 8)
	bez(130, 146, 144, 146, 152, 160, 148, 186, 8)
	bez(148, 186, 146, 198, 140, 206, 135, 207, 4)
	bez(112, 186, 114, 198, 120, 206, 125, 207, 4)
	-- 빛나는 두 눈(벌어진 입 양옆으로 밀려남)
	dot(118, 166, 4.2)
	dot(142, 166, 4.2)
	-- 어깨·목
	line(118, 204, 112, 218)
	line(142, 204, 148, 218)
	bez(112, 218, 98, 220, 86, 226, 78, 240, 4)
	bez(148, 218, 162, 220, 174, 226, 182, 240, 4)
	-- 세로로 벌어진 입(머리~배)
	bez(130, 160, 112, 192, 106, 236, 108, 270, 10)
	bez(108, 270, 110, 300, 118, 318, 130, 334, 6)
	bez(130, 334, 142, 318, 150, 300, 152, 270, 6)
	bez(152, 270, 154, 236, 148, 192, 130, 160, 10)
	-- 이빨(양쪽 가장자리에서 안쪽으로)
	local rows = { { 120, 176 }, { 116, 190 }, { 113, 204 }, { 110, 218 }, { 109, 232 }, { 108, 246 }, { 108, 260 }, { 109, 274 }, { 111, 288 }, { 115, 302 }, { 120, 316 } }
	for k, t in rows do
		local len = 7 + (k % 2) * 3
		line(t[1], t[2], t[1] + len, t[2] + 2, thick * 0.7)
		line(260 - t[1], t[2], 260 - t[1] - len, t[2] + 2, thick * 0.7)
	end
end

-- 꽃괴물: 뾰족한 꽃잎 6장(바깥 가시)이 화면 가득 펼쳐지고 가운데 작은 눈 7개
local function drawFlower()
	for _, c in face:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local size = face.AbsoluteSize.X
	if size < 10 then
		size = math.min(back.AbsoluteSize.X, back.AbsoluteSize.Y) * 0.95
	end
	local thick = math.max(4, size * 0.011)
	local function px(x: number, y: number): Vector2
		-- 꽃 가운데가 화면 가운데, 꽃잎 길이 62 가 화면 반쯤
		return Vector2.new((0.5 + x / 140) * size, (0.5 + y / 140) * size)
	end
	local function line(ax: number, ay: number, bx: number, by: number, w: number?)
		local a, b = px(ax, ay), px(bx, by)
		local d = b - a
		local fr = Instance.new("Frame")
		fr.BackgroundColor3 = WHITE
		fr.BorderSizePixel = 0
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		fr.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
		fr.Size = UDim2.fromOffset(d.Magnitude + (w or thick), w or thick)
		fr.Rotation = math.deg(math.atan2(d.Y, d.X))
		fr.Parent = face
	end
	local function bez(p0: { number }, p1: { number }, p2: { number }, p3: { number }, n: number, w: number?)
		local ax, ay = p0[1], p0[2]
		for i = 1, n do
			local t = i / n
			local u = 1 - t
			local x = u * u * u * p0[1] + 3 * u * u * t * p1[1] + 3 * u * t * t * p2[1] + t * t * t * p3[1]
			local y = u * u * u * p0[2] + 3 * u * u * t * p1[2] + 3 * u * t * t * p2[2] + t * t * t * p3[2]
			line(ax, ay, x, y, w)
			ax, ay = x, y
		end
	end
	local function dot(x: number, y: number, r: number)
		local c = px(x, y)
		local fr = Instance.new("Frame")
		fr.BackgroundColor3 = WHITE
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		fr.Position = UDim2.fromOffset(c.X, c.Y)
		fr.Size = UDim2.fromOffset(r * 2 * size / 140, r * 2 * size / 140)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = fr
		fr.Parent = face
	end
	for k = 0, 5 do
		local a = math.rad(k * 60 + 30)
		local function R(x: number, y: number): { number }
			return { x * math.cos(a) - y * math.sin(a), x * math.sin(a) + y * math.cos(a) }
		end
		bez(R(-4, -6), R(-10, -24), R(-8, -46), R(0, -62), 8)
		bez(R(0, -62), R(8, -46), R(10, -24), R(4, -6), 8)
		local m0, m1 = R(0, -14), R(0, -52)
		line(m0[1], m0[2], m1[1], m1[2], thick * 0.6)
		for _, t in { { 6, -30, 11, -32 }, { 6, -40, 11, -43 }, { -6, -30, -11, -32 }, { -6, -40, -11, -43 } } do
			local q0, q1 = R(t[1], t[2]), R(t[3], t[4])
			line(q0[1], q0[2], q1[1], q1[2], thick * 0.7)
		end
	end
	for _, e in { { 0, 0, 3.4 }, { -8, -6, 2.3 }, { 8, -6, 2.3 }, { -10, 4, 2.1 }, { 10, 4, 2.1 }, { -3, 10, 1.8 }, { 3, 10, 1.8 } } do
		dot(e[1], e[2], e[3])
	end
end

-- 얼굴을 띄운다(이미 떠 있으면 무시). kind = "doppel" 이면 도플갱어 얼굴, "flower" 면 꽃괴물
local busy = false
export type Sprite = { url: string, offset: Vector2, size: Vector2 }
function JumpScare.play(scream: (() -> ())?, kind: string?, sprite: Sprite?)
	if busy then
		return
	end
	busy = true
	JumpScare.count += 1

	gui.Enabled = true
	creatureImg.Visible = sprite ~= nil
	if sprite then
		for _, c in face:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		creatureImg.Image = sprite.url
		creatureImg.ImageRectOffset = sprite.offset
		creatureImg.ImageRectSize = sprite.size
	elseif kind == "doppel" then
		drawDoppel()
	elseif kind == "flower" then
		drawFlower()
	else
		draw(Faces.BONE)
	end
	JumpScare.lastKind = kind or "monster"
	if scream then
		task.spawn(scream)
	end
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		-- 확 다가온다(0.12초) → 세게 흔들림 → 살짝 커지며 사라진다
		local s = if t < 0.12 then 0.35 + (t / 0.12) * 0.9 else 1.25 + t * 0.15
		scale.Scale = s
		local shake = if t < JumpScare.Duration * 0.8 then 0.025 else 0.008
		face.Position = UDim2.fromScale(0.5 + (math.random() - 0.5) * shake, 0.5 + (math.random() - 0.5) * shake)
		back.BackgroundColor3 = if t < 0.05 or (t > 0.25 and t < 0.29) then Color3.fromRGB(60, 60, 60) else Color3.new(0, 0, 0)
		if t >= JumpScare.Duration then
			conn:Disconnect()
			gui.Enabled = false
			face.Position = UDim2.fromScale(0.5, 0.5)
			busy = false
		end
	end)
end

function JumpScare.state()
	return { count = JumpScare.count, showing = gui.Enabled, kind = JumpScare.lastKind }
end

return JumpScare
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="285">
        <Properties>
          <string name="Name">KeyHUD</string>
          <string name="Source"><![CDATA[--!strict
-- 오른쪽 위 표시(게임 중에만): 열쇠(팀이 찾았는가, ReplicatedStorage 속성 HasKey), 목숨(내 Lives, 스테이지마다 3개).
-- 위쪽 가운데: 안전 구역(시작 방) 안에 있으면 "안전 구역" 표시.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage.Shared.Config)

local KeyHUD = {}
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KeyHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 5

local function makeLabel(y: number, size: number): TextLabel
	local l = Instance.new("TextLabel")
	l.AnchorPoint = Vector2.new(1, 0)
	l.Position = UDim2.new(1, -24, 0, y)
	l.Size = UDim2.fromOffset(240, size + 10)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamMedium
	l.TextSize = size
	l.TextXAlignment = Enum.TextXAlignment.Right
	l.Parent = gui
	return l
end
local label = makeLabel(18, 18)
local livesLabel = makeLabel(46, 18)
local hintLabel = makeLabel(74, 15) -- (마지막 열쇠 힌트 안내)
hintLabel.TextColor3 = Color3.fromRGB(239, 200, 110)
hintLabel.Visible = false

local safeLabel = Instance.new("TextLabel")
safeLabel.AnchorPoint = Vector2.new(0.5, 0)
safeLabel.Position = UDim2.new(0.5, 0, 0, 18)
safeLabel.Size = UDim2.fromOffset(420, 26)
safeLabel.BackgroundTransparency = 1
safeLabel.Font = Enum.Font.GothamMedium
safeLabel.TextSize = 16
safeLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
safeLabel.TextTransparency = 0.15
safeLabel.Text = "안전 구역  —  괴물이 들어오지 못한다"
safeLabel.Visible = false
safeLabel.Parent = gui
gui.Parent = player:WaitForChild("PlayerGui")

local function playing(): boolean
	return ReplicatedStorage:GetAttribute("Mode") == "Game" and ReplicatedStorage:GetAttribute("RoundState") == "Playing"
end

local function refresh()
	gui.Enabled = playing()
	label.Visible = Config.Key.Required
	local has = ReplicatedStorage:GetAttribute("HasKey") == true
	local found = (ReplicatedStorage:GetAttribute("Keys") :: number?) or 0
	local need = (ReplicatedStorage:GetAttribute("KeysNeeded") :: number?) or 1
	-- (팀 공유: 누가 찾든 같은 수)
	label.Text = if has then string.format("열쇠  %d/%d — 출구로", found, need) else string.format("열쇠  %d/%d", found, need)
	label.TextColor3 = if has then Color3.fromRGB(235, 235, 235) else Color3.fromRGB(140, 140, 140)
	-- 목숨: 남은 것은 ♥, 잃은 것은 ♡
	local lives = (player:GetAttribute("Lives") :: number?) or Config.Lives.PerStage
	local hearts = {}
	for i = 1, Config.Lives.PerStage do
		table.insert(hearts, if i <= lives then "♥" else "♡")
	end
	livesLabel.Text = "목숨  " .. table.concat(hearts, " ")
	livesLabel.TextColor3 = if lives <= 1 then Color3.fromRGB(230, 120, 120) else Color3.fromRGB(220, 220, 220)
end

-- 안전 구역 칸(스테이지 폴더 속성 SafeTiles: "x,y;x,y;…")
local safeSet: { [string]: boolean } = {}
local safeSrc: string? = nil
local function inSafe(pos: Vector3): boolean
	local stage = workspace:FindFirstChild("Stage")
	local s = stage and stage:GetAttribute("SafeTiles")
	if type(s) ~= "string" then
		return false
	end
	if s ~= safeSrc then
		safeSrc = s
		table.clear(safeSet)
		for _, k in string.split(s, ";") do
			safeSet[k] = true
		end
	end
	return safeSet[math.floor(pos.X / 8) .. "," .. math.floor(pos.Z / 8)] == true
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.2 then
		return
	end
	acc = 0
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	safeLabel.Visible = Config.SafeZone.Enabled and playing() and root ~= nil and player:GetAttribute("Status") == "Alive" and inSafe(root.Position)
end)

-- 마지막 열쇠 힌트: 준비되면(서버 KeyHintReady) H(휴대폰은 힌트 버튼)로 그 상자 위치를 팀 지도에 표시
local KeyHint = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("KeyHint") :: RemoteEvent
function KeyHUD.hintAvailable(): boolean
	return playing()
		and ReplicatedStorage:GetAttribute("KeyHintReady") == true
		and ReplicatedStorage:GetAttribute("HasKey") ~= true
		and ReplicatedStorage:GetAttribute("KeyHintPos") == nil
		and player:GetAttribute("Status") == "Alive"
end
function KeyHUD.requestHint()
	if KeyHUD.hintAvailable() then
		KeyHint:FireServer()
	end
end
local function refreshHint()
	local shown = ReplicatedStorage:GetAttribute("KeyHintPos") ~= nil and ReplicatedStorage:GetAttribute("HasKey") ~= true
	if KeyHUD.hintAvailable() then
		hintLabel.Text = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "힌트 버튼 — 목숨 1개로 마지막 열쇠 위치 보기" else "H — 목숨 1개로 마지막 열쇠 힌트 보기"
		hintLabel.Visible = true
	elseif shown and playing() then
		hintLabel.Text = "마지막 열쇠 위치가 지도(Q)에 표시됨"
		hintLabel.Visible = true
	else
		hintLabel.Visible = false
	end
end
for _, a in { "KeyHintReady", "KeyHintPos" } do
	ReplicatedStorage:GetAttributeChangedSignal(a):Connect(refreshHint)
end
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.H then
		KeyHUD.requestHint()
	end
end)

function KeyHUD.state()
	return { visible = gui.Enabled, text = label.Text, lives = livesLabel.Text, safe = safeLabel.Visible, hint = hintLabel.Visible and hintLabel.Text or nil }
end

for _, a in { "HasKey", "Keys", "KeysNeeded", "Mode", "RoundState" } do
	ReplicatedStorage:GetAttributeChangedSignal(a):Connect(refresh)
	ReplicatedStorage:GetAttributeChangedSignal(a):Connect(refreshHint)
end
player:GetAttributeChangedSignal("Status"):Connect(refreshHint)
player:GetAttributeChangedSignal("Lives"):Connect(refreshHint)
refreshHint()
player:GetAttributeChangedSignal("Lives"):Connect(refresh)
refresh()

return KeyHUD
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="286">
        <Properties>
          <string name="Name">LobbyUI</string>
          <string name="Source"><![CDATA[--!strict
-- 로비 화면: 방 목록, 방 만들기 / 참가 / 나가기 / 시작(방장).
-- 1인칭이라 마우스가 가운데 묶여 있으므로 Tab 으로 메뉴를 열면 마우스가 풀린다(다시 Tab 이면 둘러보기).
-- 방 목록은 서버가 ReplicatedStorage 속성 "Rooms"(JSON)로, 내 방은 Player 속성 "RoomId" 로 알려 준다.

local HttpService = game:GetService("HttpService")
local SocialService = game:GetService("SocialService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local LobbyUI = {}

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RoomAction = Remotes:WaitForChild("RoomAction") :: RemoteEvent

local WHITE = Color3.fromRGB(235, 235, 235)
local GREY = Color3.fromRGB(140, 140, 140)

local gui = Instance.new("ScreenGui")
gui.Name = "Lobby"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 10
gui.Enabled = false

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(1, 0.5)
panel.Position = UDim2.new(1, -24, 0.5, 0)
panel.Size = UDim2.fromOffset(460, 420)
panel.BackgroundColor3 = Color3.new(0, 0, 0)
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
panel.Parent = gui
local stroke = Instance.new("UIStroke")
stroke.Color = GREY
stroke.Thickness = 1
stroke.Parent = panel

local function label(text: string, y: number, size: number, color: Color3, h: number?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Position = UDim2.fromOffset(16, y)
	l.Size = UDim2.new(1, -32, 0, h or (size + 6))
	l.Font = Enum.Font.GothamMedium
	l.TextSize = size
	l.TextColor3 = color
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Text = text
	l.Parent = panel
	return l
end

local title = label("로비 — 방", 14, 20, WHITE)
-- (방 사람이 많으면(최대 6명) 이름이 다 들어가게 글자를 줄인다)
title.TextScaled = true
do
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = 20
	c.MinTextSize = 11
	c.Parent = title
end
local hint = label("Tab: 메뉴 열기 (마우스)", 42, 14, GREY)
local msg = label("", 380, 14, Color3.fromRGB(226, 75, 74), 30)

local list = Instance.new("Frame")
list.BackgroundTransparency = 1
list.Position = UDim2.fromOffset(16, 70)
list.Size = UDim2.new(1, -32, 0, 230)
list.Parent = panel
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list

local bar = Instance.new("Frame")
bar.BackgroundTransparency = 1
bar.Position = UDim2.fromOffset(16, 316)
bar.Size = UDim2.new(1, -32, 0, 44)
bar.Parent = panel
local barLayout = Instance.new("UIListLayout")
barLayout.FillDirection = Enum.FillDirection.Horizontal
barLayout.Padding = UDim.new(0, 8)
barLayout.Parent = bar

-- 메뉴가 열려 있을 때 마우스를 풀어 주는 버튼(Modal)
local modal = Instance.new("TextButton")
modal.Name = "MouseFree"
modal.Modal = true
modal.BackgroundTransparency = 1
modal.Text = ""
modal.Size = UDim2.fromOffset(0, 0)
modal.Visible = false
modal.Parent = gui

gui.Parent = player:WaitForChild("PlayerGui")

type Btn = { button: TextButton, run: () -> () }
local buttons: { [string]: Btn } = {}

local function button(parent: Instance, text: string, width: number, run: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(width, 36)
	b.BackgroundColor3 = Color3.new(0, 0, 0)
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 15
	b.TextColor3 = WHITE
	b.Text = text
	b.AutoButtonColor = true
	local s = Instance.new("UIStroke")
	s.Color = WHITE
	s.Thickness = 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = b
	b.Activated:Connect(run)
	b.Parent = parent
	buttons[text] = { button = b, run = run }
	return b
end

local menuOpen = false
local message = ""
local msgUntil = 0

function LobbyUI.act(action: string, arg: any?)
	RoomAction:FireServer(action, arg)
end

local function rooms(): { any }
	local s = ReplicatedStorage:GetAttribute("Rooms")
	if type(s) ~= "string" then
		return {}
	end
	local ok, v = pcall(HttpService.JSONDecode, HttpService, s)
	return if ok and type(v) == "table" then v else {}
end

local function render()
	table.clear(buttons)
	for _, c in list:GetChildren() do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	for _, c in bar:GetChildren() do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	local myId = player:GetAttribute("RoomId")
	local mine = nil
	local all = rooms()
	for i, r in all do
		if r.id == myId then
			mine = r
		end
		local row = Instance.new("Frame")
		row.LayoutOrder = i
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 36)
		row.Parent = list
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, -86, 1, 0)
		t.Font = Enum.Font.Gotham
		t.TextSize = 14
		t.TextColor3 = if r.id == myId then WHITE else GREY
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.TextTruncate = Enum.TextTruncate.AtEnd
		t.Text = string.format("방 %d · %s · %d/%d%s%s", r.id, r.host, #r.names, r.max, if r.friendsOnly then " · 친구만" else "", if r.started then " · 시작 중" else "")
		t.Parent = row
		if r.id ~= myId and not r.started and #r.names < r.max then
			local b = button(row, "참가 " .. r.id, 78, function()
				LobbyUI.act("join", r.id)
			end)
			b.Position = UDim2.new(1, -78, 0, 0)
			b.Size = UDim2.fromOffset(78, 34)
		end
	end
	if #all == 0 then
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, 30)
		t.Font = Enum.Font.Gotham
		t.TextSize = 14
		t.TextColor3 = GREY
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.Text = "열린 방이 없습니다. 방을 만들어 보세요."
		t.Parent = list
	end
	if mine then
		title.Text = string.format("방 %d — %s", mine.id, table.concat(mine.names, ", "))
		button(bar, "나가기", 100, function()
			LobbyUI.act("leave")
		end)
		if mine.hostId == player.UserId then
			button(bar, "시작", 70, function()
				LobbyUI.act("start")
			end)
			local fo = mine.friendsOnly == true
			button(bar, if fo then "친구만 끄기" else "친구만 켜기", 110, function()
				LobbyUI.act("friendsOnly", not fo)
			end)
		else
			local w = Instance.new("TextLabel")
			w.BackgroundTransparency = 1
			w.Size = UDim2.fromOffset(160, 36)
			w.Font = Enum.Font.Gotham
			w.TextSize = 14
			w.TextColor3 = GREY
			w.Text = "방장이 시작하기를 기다리는 중"
			w.Parent = bar
		end
	else
		title.Text = "로비 — 방"
		button(bar, "방 만들기", 140, function()
			LobbyUI.act("create")
		end)
	end
	-- 친구 초대(Roblox 초대 창): 초대받은 친구는 이 로비 서버로 들어온다
	button(bar, "친구 초대", 100, function()
		task.spawn(function()
			local ok, can = pcall(SocialService.CanSendGameInviteAsync, SocialService, player)
			if ok and can then
				pcall(SocialService.PromptGameInvite, SocialService, player)
			else
				LobbyUI.message("지금은 초대 창을 열 수 없습니다(Studio 에서는 열리지 않습니다)")
			end
		end)
	end)
	msg.Text = if os.clock() < msgUntil then message else ""
	hint.Text = if menuOpen then "Tab: 메뉴 닫기 (둘러보기)" else "Tab: 메뉴 열기 (마우스)"
end

local function inLobby(): boolean
	return ReplicatedStorage:GetAttribute("RoundState") == "Lobby"
end

local function refresh()
	local show = inLobby()
	gui.Enabled = show
	if not show then
		menuOpen = false
	end
	modal.Visible = show and menuOpen
	if show then
		render()
	end
end

function LobbyUI.setMenu(open: boolean)
	menuOpen = open and inLobby()
	refresh()
end

function LobbyUI.message(text: string, seconds: number?)
	message = text
	msgUntil = os.clock() + (seconds or 4)
	refresh()
	task.delay((seconds or 4) + 0.05, refresh)
end

-- (테스트) 지금 보이는 버튼을 누른 것과 같게
function LobbyUI.click(text: string): boolean
	local b = buttons[text]
	if b and b.button.Visible and gui.Enabled then
		b.run()
		return true
	end
	return false
end

-- 메뉴가 열려 마우스가 풀려 있는가(커서 표시 여부)
function LobbyUI.mouseFree(): boolean
	return modal.Visible
end

function LobbyUI.state()
	local names = {}
	for t in buttons do
		table.insert(names, t)
	end
	table.sort(names)
	return { visible = gui.Enabled, menuOpen = menuOpen, mouseFree = modal.Visible, rooms = #rooms(), myRoom = player:GetAttribute("RoomId"), buttons = names, title = title.Text, message = msg.Text }
end

UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.Tab and inLobby() then
		LobbyUI.setMenu(not menuOpen)
	end
end)
ReplicatedStorage:GetAttributeChangedSignal("Rooms"):Connect(refresh)
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(refresh)
player:GetAttributeChangedSignal("RoomId"):Connect(refresh)
refresh()

return LobbyUI
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="287">
        <Properties>
          <string name="Name">Main</string>
          <string name="Source"><![CDATA[--!strict
-- 클라이언트 진입점(StarterPlayerScripts.Main)
--   좌클릭 → 음파(즉시 로컬 표시 + 서버에 알림), 다른 플레이어 음파 표시, 스테이지 로드 대기 → 음파 월드 빌드,
--   사망·탈출 후 관전, 결과 화면, 상호작용 안내.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage.Shared.Config)
-- 휴대폰·태블릿 가벼운 모드: 메모리·처리량이 작아 부하가 크면 연결이 먼저 끊긴다(오류 277).
-- 음파 선 파트 수와 한 프레임에 새로 보이는 선 수를 줄인다(보이는 범위·시간은 같고, 아주 빽빽한 곳에서 먼 선이 조금 덜 그려진다)
if UserInputService.TouchEnabled and (not UserInputService.MouseEnabled or not UserInputService.KeyboardEnabled) then
	local S = Config.Sonar :: any
	S.PoolSize = math.min(S.PoolSize, 2000)
	S.RevealPerFrame = math.min(S.RevealPerFrame, 220)
	S.MaxRemotePulses = 3
end
local World = require(script.Parent:WaitForChild("SonarWorld"))
local Lines = require(script.Parent:WaitForChild("SonarLines"))
local Pulses = require(script.Parent:WaitForChild("SonarPulses"))
local Movement = require(script.Parent:WaitForChild("Movement"))
local Audio = require(script.Parent:WaitForChild("Audio"))
local UI = require(script.Parent:WaitForChild("UI"))
local MapView = require(script.Parent:WaitForChild("MapView"))
local LobbyUI = require(script.Parent:WaitForChild("LobbyUI"))
local Mates = require(script.Parent:WaitForChild("Mates"))
local KeyHUD = require(script.Parent:WaitForChild("KeyHUD"))
local JumpScare = require(script.Parent:WaitForChild("JumpScare"))
local SearchLook = require(script.Parent:WaitForChild("SearchLook"))
local DoppelFx = require(script.Parent:WaitForChild("DoppelFx"))
-- 괴물 전신 움직임(발 고정 IK·무게중심·관성). 발이 땅에 닿는 순간 발소리
local MonsterAnim = require(script.Parent:WaitForChild("MonsterAnim"))
MonsterAnim.onStep = function(model: Model, at: Vector3, hit: number)
	Audio.monsterFoot(model, at, hit)
end
-- 챕터 괴물(괴물마다 다른 뼈대) 움직임
local CreatureAnim = require(script.Parent:WaitForChild("CreatureAnim"))
CreatureAnim.onStep = function(model: Model, at: Vector3, hit: number)
	Audio.monsterFoot(model, at, hit)
end
require(script.Parent:WaitForChild("SpriteAnim")).onStep = function(model: Model, at: Vector3, hit: number)
	Audio.monsterFoot(model, at, hit)
end
local Reveal = require(script.Parent:WaitForChild("Reveal"))
local MobileUI = require(script.Parent:WaitForChild("MobileUI"))
local Perf = require(script.Parent:WaitForChild("Perf"))
local NetStat = require(script.Parent:WaitForChild("NetStat"))
Pulses.onReach = Perf.wrap("map.onReach", MapView.onReach)
-- 음파가 시작될 때(내 것·팀원 것): 도플갱어 눈 빛 + 맞은 괴물은 10초 동안 지금 모습 그대로 보이게(굳은 잔상 선은 그리지 않는다)
-- (사람 모습 도플갱어는 팀원처럼 윤곽선으로 늘 보이므로 음파 선을 그리지 않는다)
World.skipMonster = function(m: Model): boolean
	return Reveal.has(m) or Reveal.disguised(m) or m:GetAttribute("SonarVeil") == true -- (5장 지움: 첫 음파엔 잔상도 남기지 않음)
end
Audio.stepAudible = Reveal.active -- (괴물 발소리는 음파에 걸린 동안만)
local SpriteAnim = require(script.Parent:WaitForChild("SpriteAnim"))
SpriteAnim.visible = Reveal.active -- (시안 그림 괴물은 음파에 드러난 동안만 보인다)
local RigAnim = require(script.Parent:WaitForChild("RigAnim"))
RigAnim.visible = Reveal.active
RigAnim.onStep = function(model: Model, at: Vector3, hit: number)
	Audio.monsterFoot(model, at, hit)
end
-- 점프스케어: 잡은 괴물의 자기 괴성 + (시안 그림 괴물이면) 그 괴물의 덮침 그림
local function playScare(data: any)
	local sprite = nil
	if typeof(data.creature) == "string" then
		local url, off, size = SpriteAnim.attackFrame(data.creature)
		if url and off and size then
			sprite = { url = url, offset = off, size = size }
		end
	end
	JumpScare.play(function()
		local si = (ReplicatedStorage:GetAttribute("StageIndex") :: number?) or 1
		local voice = if typeof(data.voice) == "string" then data.voice
			elseif data.why == "doppel" then "Doppel"
			elseif data.why == "flower" then "Flower"
			else tostring((math.max(1, si) - 1) % 5 + 1)
		Audio.play(Audio.voiceName(voice, "Scream") or "MonsterAlert", nil, 0.03, 0.8)
	end, data.why, sprite)
end
Pulses.onStart = Perf.wrap("pulse.onStart", function(origin: Vector3)
	local t0 = os.clock()
	DoppelFx.onPulse(origin)
	local t1 = os.clock()
	Reveal.onPulse(origin)
	Perf.add("pulse.onStart.doppel", t1 - t0)
	Perf.add("pulse.onStart.reveal", os.clock() - t1)
end)

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SonarFire = Remotes:WaitForChild("SonarFire") :: RemoteEvent
local SonarPulse = Remotes:WaitForChild("SonarPulse") :: RemoteEvent
local RoundEvent = Remotes:WaitForChild("RoundEvent") :: RemoteEvent

local lastFire = -math.huge
local spectateIndex = 1
local building = false
local frameTimes: { number } = {}
local luaTimes: { number } = {}
local prof = { pulses = 0, lines = 0, frames = 0 } -- (테스트용) 프레임당 음파 연산 시간 나눠 보기

-- ── 스테이지 로드 → 음파 월드 ──
local function tryBuild()
	local stage = workspace:FindFirstChild("Stage") :: Folder?
	if not stage or building then
		return
	end
	local id = stage:GetAttribute("BuildId")
	if not id or (World.ready and World.buildId == id and World.stage == stage) then
		return
	end
	building = true
	task.spawn(function()
		-- 모든 파트가 복제될 때까지
		local want = (stage:GetAttribute("PartCount") :: number?) or 0
		local t0 = os.clock()
		while os.clock() - t0 < 20 do
			local n = 0
			for _, d in stage:GetDescendants() do
				if d:IsA("BasePart") then
					n += 1
				end
			end
			if n >= want then
				break
			end
			task.wait(0.2)
		end
		Pulses.clear()
		Lines.clear()
		DoppelFx.clear()
		Reveal.clear()
		World.build(stage)
		MapView.load(stage)
		task.spawn(Lines.prewarm, 2500) -- 선 파트 미리 만들기(음파 도중 끊김 방지)
		building = false
		if stage:GetAttribute("BuildId") ~= World.buildId then
			tryBuild()
		end
	end)
end
workspace.ChildAdded:Connect(function(c)
	if c.Name == "Stage" then
		c:GetAttributeChangedSignal("BuildId"):Connect(tryBuild)
		task.defer(tryBuild)
	end
end)
local existing = workspace:FindFirstChild("Stage")
if existing then
	existing:GetAttributeChangedSignal("BuildId"):Connect(tryBuild)
	tryBuild()
end

-- ── 음파 발사 ──
local function alive(): boolean
	return player:GetAttribute("Status") == "Alive"
end

local function fire(): boolean
	if not alive() or not World.ready or player:GetAttribute("Hidden") then
		return false
	end
	local now = os.clock()
	if now - lastFire < Config.Sonar.Cooldown then
		return false
	end
	local char = player.Character
	local head = char and char:FindFirstChild("Head") :: BasePart?
	if not head then
		return false
	end
	lastFire = now
	Pulses.start(head.Position, char, true)
	SonarFire:FireServer()
	NetStat.count("send.SonarFire")
	Audio.sonar(true, head.Position)
	return true
end

local function charOf(userId: number): Model?
	local p = Players:GetPlayerByUserId(userId)
	return p and p.Character
end

SonarPulse.OnClientEvent:Connect(function(userId: number, origin: Vector3, fromModel: Model?)
	Perf.count("net.SonarPulse")
	NetStat.count("recv.SonarPulse")
	if typeof(origin) ~= "Vector3" then
		return
	end
	if userId == 0 then
		-- 도플갱어의 가짜 음파: 팀원 음파와 똑같이 보이고 들린다(그 몸은 파동에서 뺀다)
		local cam = workspace.CurrentCamera
		if cam and (cam.CFrame.Position - origin).Magnitude > Config.Sonar.RemoteViewDistance then
			return
		end
		Pulses.start(origin, if typeof(fromModel) == "Instance" then fromModel else nil, false)
		Audio.sonar(false, origin)
		return
	end
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - origin).Magnitude > Config.Sonar.RemoteViewDistance then
		return
	end
	Pulses.start(origin, charOf(userId), false)
	Audio.sonar(false, origin)
end)

-- ── 관전 ──
local function spectateTargets(): { Player }
	local out = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("Status") == "Alive" and p.Character and p.Character:FindFirstChild("Head") then
			table.insert(out, p)
		end
	end
	return out
end

local function spectating(): boolean
	local st = player:GetAttribute("Status")
	return (st == "Dead" or st == "Escaped") and ReplicatedStorage:GetAttribute("RoundState") == "Playing"
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if spectating() then
			spectateIndex += 1
		else
			fire()
		end
	end
end)

-- ── 상호작용 안내(문, 숨는 곳) ──
local function promptText(prompt: ProximityPrompt): string
	if prompt:GetAttribute("HideSpot") and player:GetAttribute("Hidden") then
		return "E   나가기"
	end
	return "E   " .. prompt.ActionText
end
-- 지금 안내 중인 것: 다른 안내가 사라지는 신호가 늦게 와도(문 → 사물함으로 바로 옮길 때) 지금 것을 지우지 않는다
local shownPrompt: ProximityPrompt? = nil
ProximityPromptService.PromptShown:Connect(function(prompt)
	if prompt.Style == Enum.ProximityPromptStyle.Custom then
		shownPrompt = prompt
		UI.setPrompt(promptText(prompt))
		local function refresh()
			if shownPrompt == prompt then
				UI.setPrompt(promptText(prompt))
			end
		end
		local conn = prompt:GetPropertyChangedSignal("ActionText"):Connect(refresh)
		local conn2 = player:GetAttributeChangedSignal("Hidden"):Connect(refresh)
		local conn3: RBXScriptConnection? = nil
		local hiddenConn: RBXScriptConnection? = nil
		local function gone()
			conn:Disconnect()
			conn2:Disconnect()
			if conn3 then
				conn3:Disconnect()
			end
			if hiddenConn then
				hiddenConn:Disconnect()
			end
			if shownPrompt == prompt then
				shownPrompt = nil
				UI.setPrompt(nil)
			end
		end
		hiddenConn = prompt.PromptHidden:Once(gone)
		-- (안내가 떠 있는 채로 스테이지가 지워지면 PromptHidden 이 오지 않는다: 연결이 남지 않게)
		conn3 = prompt.AncestryChanged:Connect(function()
			if not prompt:IsDescendantOf(workspace) then
				gone()
			end
		end)
	end
end)

-- ── 휴대폰 화면 버튼(MobileUI) 연결: 키보드·마우스와 같은 동작 ──
MobileUI.spectating = spectating
MobileUI.onSonar = function()
	if spectating() then
		spectateIndex += 1
	else
		fire()
	end
end
MobileUI.canInteract = function(): boolean
	return SearchLook.target() ~= nil or shownPrompt ~= nil
end
MobileUI.onInteract = function()
	-- 조준한 서랍·뚜껑이 먼저(E 와 같다), 아니면 지금 안내 중인 문·숨는 곳
	if SearchLook.target() then
		SearchLook.use()
		return
	end
	local pr = shownPrompt
	if pr then
		pr:InputHoldBegin()
		task.delay(0.1, function()
			pr:InputHoldEnd()
		end)
	end
end
MobileUI.onMap = function()
	MapView.toggle()
end
MobileUI.onHint = KeyHUD.requestHint
MobileUI.hintAvailable = KeyHUD.hintAvailable
MobileUI.onMenu = function()
	LobbyUI.setMenu(not LobbyUI.state().menuOpen)
end

-- ── 라운드 이벤트 ──
local function resetCamera()
	local cam = workspace.CurrentCamera
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		if hum then
			cam.CameraSubject = hum
		end
	end
	UI.setSpectate(nil)
end

player.CharacterAdded:Connect(function()
	Movement.reset()
	task.defer(resetCamera)
	UI.hideOverlay(true)
end)

RoundEvent.OnClientEvent:Connect(function(kind: string, data: any)
	NetStat.count("recv.RoundEvent")
	NetStat.count("recv.RoundEvent." .. tostring(kind))
	if kind == "Start" then
		UI.hideOverlay(false)
		UI.setStage(data.name)
		if data.stage == 1 then
			task.delay(2.5, UI.hint, if MobileUI.state().enabled then "음파 버튼 — 음파      달리기 · 웅크리기 버튼은 눌러서 켜고 끄기" else "좌클릭 — 음파      Shift — 달리기      Ctrl — 웅크리기", 7)
		end
		task.delay(if data.stage == 1 then 10 else 2.5, UI.hint, if MobileUI.state().enabled then "상자와 서랍(상호작용 버튼)을 뒤져 열쇠를 찾아야 출구가 열린다" else "상자와 서랍(E)을 뒤져 열쇠를 찾아야 출구가 열린다", 6)
	elseif kind == "DoppelBurst" then
		-- 도플갱어의 사람 모습이 터진다(조각이 흩날림)
		DoppelFx.burst(data)
		Audio.doppelBurst(data.at)
	elseif kind == "Scare" then
		-- 서브 괴물(잡혀도 죽지 않는 기믹): 점프스케어만
		playScare({ why = "monster", creature = data.creature, voice = data.voice })
		UI.hint("…놓아줬다. 아직 살아 있다", 3)
	elseif kind == "LifeLost" then
		-- 잡혔지만 목숨이 남았다: 점프스케어 → 잠깐 검은 화면 → 시작 방에서 다시(캐릭터가 생기면 화면이 걷힌다)
		if data.userId == player.UserId then
			if data.why == "monster" or data.why == "doppel" or data.why == "flower" then
				playScare(data)
				task.wait(JumpScare.Duration)
			end
			if player:GetAttribute("Status") == "Respawning" then
				UI.overlay("잡혔다", string.format("남은 목숨 %d — 시작 방에서 다시 시작합니다", data.lives), true)
			end
		else
			local who = Players:GetPlayerByUserId(data.userId)
			UI.hint(string.format("%s 님이 잡혔다 — 남은 목숨 %d", if who then who.DisplayName else "팀원", data.lives), 4)
		end
	elseif kind == "Died" then
		if data.userId == player.UserId and (data.why == "monster" or data.why == "doppel" or data.why == "flower") then
			-- 점프스케어: 괴물 얼굴이 확 뜬 뒤 YOU DIED (도플갱어는 머리~배가 세로로 벌어진 입)
			playScare(data)
			task.wait(JumpScare.Duration)
		end
		if data.userId == player.UserId then
			if data.othersAlive > 0 then
				UI.overlay("YOU DIED", "목숨을 모두 잃었다 — 관전으로 전환합니다", true)
				task.delay(2.5, function()
					if spectating() then
						UI.liftOverlay()
					end
				end)
			else
				UI.overlay("YOU DIED", "스테이지를 다시 시작합니다", true)
			end
		end
	elseif kind == "Escaped" then
		if data.userId == player.UserId then
			UI.overlay("ESCAPED", if data.othersAlive > 0 then "다른 생존자를 기다립니다" else "", true)
			task.delay(2.5, function()
				if spectating() then
					UI.liftOverlay()
				end
			end)
		end
	elseif kind == "Lobby" then
		UI.hideOverlay(false)
		UI.setSpectate(nil)
		UI.setStage("로비")
		task.delay(1.5, UI.hint, if MobileUI.state().enabled then "방 메뉴 버튼 — 방 만들기·참가      음파 버튼 — 음파" else "Tab — 방 메뉴      좌클릭 — 음파      Q — 지도", 7)
	elseif kind == "KeyFound" then
		local who = if data.userId == player.UserId then "열쇠를 찾았다" else (data.by .. " 님이 열쇠를 찾았다")
		local found, need = data.found or 1, data.need or 1
		UI.hint(string.format("%s (%d/%d)", who, found, need) .. (if found >= need then " — 이제 출구가 열린다" else string.format(" — 남은 열쇠 %d개", need - found)), 5)
	elseif kind == "SearchResult" then
		local t = if data.result == "searching" then "뒤지는 중…" elseif data.result == "empty" then "비어 있다" else "이미 뒤진 곳이다"
		UI.hint(t, if data.result == "searching" then 1 else 2)
	elseif kind == "KeyHintShown" then
		UI.hint((if data.userId == player.UserId then string.format("목숨 1개를 써서 힌트를 봤다(남은 목숨 %d)", data.lives or 0) else (data.by .. " 님이 목숨 1개를 써서 힌트를 봤다")) .. " — 마지막 열쇠 위치가 지도(Q)에 표시됨", 5)
	elseif kind == "KeyHintDenied" then
		UI.hint("목숨이 1개뿐이라 힌트를 볼 수 없다(목숨 1개를 쓴다)", 3)
	elseif kind == "ExitFound" then
		-- 누가 출구를 찾았다(팀 공유, 지도 Q 에도 표시된다)
		UI.hint((if data.userId == player.UserId then "출구를 찾았다" else (data.by .. " 님이 출구를 찾았다")) .. " — 지도(Q)에 표시됨", 5)
	elseif kind == "ExitLocked" then
		local found = (ReplicatedStorage:GetAttribute("Keys") :: number?) or 0
		local need = (ReplicatedStorage:GetAttribute("KeysNeeded") :: number?) or 1
		UI.hint(string.format("출구가 잠겨 있다 — 열쇠 %d/%d, 상자나 서랍에서 %d개 더 찾아야 한다", found, need, need - found), 3)
	elseif kind == "RoomMsg" then
		LobbyUI.message(data.text)
	elseif kind == "RoomStarting" then
		LobbyUI.message("게임을 시작합니다…", 6)
	elseif kind == "Clear" then
		local sub = if data.allClear then (if data.toLobby then "모든 스테이지를 탈출했습니다 — 로비로 돌아갑니다" else "모든 스테이지를 탈출했습니다 — 처음부터 다시 시작합니다") else ("다음: " .. data.nextName)
		UI.overlay("STAGE CLEAR", sub, true)
		UI.setSpectate(nil)
	elseif kind == "Failed" then
		local solo = #Players:GetPlayers() == 1
		UI.overlay("YOU DIED", if solo then "스테이지를 다시 시작합니다" else "모두 사망했습니다 — 스테이지를 다시 시작합니다", true)
		UI.setSpectate(nil)
	end
end)

-- ── 매 프레임 ──
-- 관전 카메라 보간 상태
local specCF: CFrame? = nil
local specTarget: Player? = nil
-- 내 시선(카메라 방향)을 초당 최대 10번, 바뀌었을 때만 서버로 보낸다(관전하는 사람이 내 시점 그대로 본다).
-- 관전 중인 사람(죽었거나 탈출한 다른 플레이어)이 있을 때만 보낸다: 아무도 관전하지 않으면 보낼 이유가 없다.
-- (관전이 시작되면 마지막으로 보낸 값과 다르면 바로 다시 보낸다)
local LookShare = Remotes:WaitForChild("LookShare") :: RemoteEvent
local lookSentAt, lookYaw, lookPitch = 0, 99, 99
local watchers = 0 -- 관전 중인 다른 플레이어 수(Status 속성 변화로 센다)
local function countWatchers()
	local n = 0
	for _, p in Players:GetPlayers() do
		local st = p:GetAttribute("Status")
		if p ~= player and (st == "Dead" or st == "Escaped") then
			n += 1
		end
	end
	watchers = n
end
local function watchStatus(p: Player)
	if p ~= player then
		p:GetAttributeChangedSignal("Status"):Connect(countWatchers)
	end
end
for _, p in Players:GetPlayers() do
	watchStatus(p)
end
Players.PlayerAdded:Connect(function(p)
	watchStatus(p)
	countWatchers()
end)
Players.PlayerRemoving:Connect(function()
	task.defer(countWatchers)
end)
countWatchers()
local function shareLook(now: number)
	local cam = workspace.CurrentCamera
	if watchers == 0 or not cam or now - lookSentAt < 0.1 or player:GetAttribute("Status") ~= "Alive" then
		return
	end
	local lv = cam.CFrame.LookVector
	local yaw = math.atan2(-lv.X, -lv.Z)
	local pitch = math.asin(math.clamp(lv.Y, -1, 1))
	local dy = math.abs((yaw - lookYaw + math.pi) % (2 * math.pi) - math.pi)
	if dy < 0.03 and math.abs(pitch - lookPitch) < 0.03 then
		return
	end
	lookSentAt, lookYaw, lookPitch = now, yaw, pitch
	LookShare:FireServer(yaw, pitch)
	NetStat.count("send.LookShare")
end
-- (측정) 복제되어 들어오는 속성 변경 수(플레이어·ReplicatedStorage)
local function watchAttrs(inst: Instance, prefix: string)
	inst.AttributeChanged:Connect(function(name)
		NetStat.count(prefix .. name)
	end)
end
watchAttrs(ReplicatedStorage, "attr.RS.")
for _, p in Players:GetPlayers() do
	watchAttrs(p, if p == player then "attr.me." else "attr.other.")
end
Players.PlayerAdded:Connect(function(p)
	watchAttrs(p, "attr.other.")
end)
RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	-- 마우스 커서: 1인칭에서는 숨긴다(조준점만). 로비 메뉴(Tab)를 열었을 때만 보인다
	local free = LobbyUI.mouseFree()
	if UserInputService.MouseIconEnabled ~= free then
		UserInputService.MouseIconEnabled = free
	end
	table.insert(frameTimes, dt)
	if #frameTimes > 240 then
		table.remove(frameTimes, 1)
	end
	Movement.update(dt)
	local tp = os.clock()
	debug.profilebegin("sonar.pulses")
	Pulses.update(now)
	debug.profileend()
	local tl = os.clock()
	debug.profilebegin("sonar.lines")
	Lines.update(now)
	debug.profileend()
	local te = os.clock()
	prof.pulses += tl - now
	prof.lines += te - tl
	prof.frames += 1
	Perf.add("move.update", tp - now)
	Perf.add("pulses.update", tl - tp)
	Perf.add("lines.update", te - tl)
	Perf.frame(dt, te - now)
	table.insert(luaTimes, te - now)
	if #luaTimes > 240 then
		table.remove(luaTimes, 1)
	end
	local tu = os.clock()
	UI.setCooldown((now - lastFire) / Config.Sonar.Cooldown)
	shareLook(now)
	-- 관전 카메라: 살아 있는 동료의 1인칭 시점
	local cam = workspace.CurrentCamera
	if spectating() and cam then
		local targets = spectateTargets()
		if #targets > 0 then
			local t = targets[((spectateIndex - 1) % #targets) + 1]
			-- (머리는 걷는 애니메이션으로 흔들리고 네트워크로 계단처럼 움직여 떨렸다:
			--  몸 가운데(루트)의 눈높이를 따라가며 부드럽게 보간한다. 대상이 바뀌면 바로 그 자리로)
			local troot = t.Character and t.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local head = troot
			if head then
				cam.CameraType = Enum.CameraType.Scriptable
				-- 그 사람의 실제 카메라 방향(공유된 좌우·위아래 시선). 아직 없으면 몸이 향한 방향
				local eye = head.Position + Vector3.new(0, 1.6, 0)
				local yaw = t:GetAttribute("LookYaw") :: number?
				local pitch = (t:GetAttribute("LookPitch") :: number?) or 0
				local want = if yaw then CFrame.new(eye) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) else head.CFrame * CFrame.new(0, 1.6, 0)
				if specTarget ~= t or not specCF or (specCF.Position - want.Position).Magnitude > 12 then
					specCF = want
					specTarget = t
				else
					specCF = (specCF :: CFrame):Lerp(want, 1 - math.exp(-dt * 10))
				end
				cam.CFrame = specCF :: CFrame
				UI.setSpectate("관전 중: " .. t.DisplayName .. "   (좌클릭: 대상 변경)")
			end
		else
			UI.setSpectate("관전할 생존자가 없습니다")
		end
	end
	NetStat.count("ui.frameUs", (os.clock() - tu) * 1e6)
	NetStat.count("ui.frames")
end)
RunService.Heartbeat:Connect(function()
	debug.profilebegin("audio.update")
	local t = os.clock()
	Audio.update()
	Perf.add("audio.update", os.clock() - t)
	debug.profileend()
end)

-- ── 자동 테스트 응답(Studio 테스트 하네스가 만든 TestProbe 가 있을 때만) ──
task.spawn(function()
	local probe = ReplicatedStorage:WaitForChild("TestProbe", 30) :: RemoteFunction?
	if not probe then
		return
	end
	probe.OnClientInvoke = function(cmd: string, arg: any)
		if cmd == "stats" then
			local sum, worst = 0, 0
			for _, t in frameTimes do
				sum += t
				worst = math.max(worst, t)
			end
			local ls = Lines.stats()
			return {
				ready = World.ready,
				buildId = World.buildId,
				steps = Audio.steps,
				build = { seconds = World.buildSeconds, cpu = World.buildCpu, segs = World.segCount },
				prof = { pulsesMs = if prof.frames > 0 then prof.pulses / prof.frames * 1000 else 0, linesMs = if prof.frames > 0 then prof.lines / prof.frames * 1000 else 0 },
				segs = World.segCount,
				culled = World.culled,
				unattached = World.unattached,
				viewParts = #World.viewParts,
				grid = { World.nx, World.ny, World.nz },
				lines = ls,
				pulses = Pulses.active(),
				pulsesStarted = Pulses.started,
				avgFrame = if #frameTimes > 0 then sum / #frameTimes else 0,
				lua = (function()
					local s2, w2 = 0, 0
					for _, t in luaTimes do
						s2 += t
						w2 = math.max(w2, t)
					end
					return { avg = if #luaTimes > 0 then s2 / #luaTimes else 0, worst = w2 }
				end)(),
				worstFrame = worst,
				ui = UI.state(),
				mode = Movement.mode,
				walkSpeed = (function()
					local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					return h and h.WalkSpeed or 0
				end)(),
				lighting = {
					brightness = game:GetService("Lighting").Brightness,
					ambient = game:GetService("Lighting").Ambient,
					outdoor = game:GetService("Lighting").OutdoorAmbient,
				},
			}
		elseif cmd == "perfx" then
			-- (성능 측정) 프레임 분포·시스템별 비용·메모리·네트워크·선·음파·소리. arg == "reset" 이면 읽은 뒤 비운다
			local Stats = game:GetService("Stats")
			local out = Perf.summary()
			out.lineStats = Lines.stats()
			out.pulses = Pulses.active()
			out.pulsesStarted = Pulses.started
			out.pulseMaxActive = Pulses.maxActive
			out.pulseCost = Pulses.costStats()
			out.memMb = Stats:GetTotalMemoryUsageMb()
			out.luaKb = gcinfo()
			out.instances = Stats.InstanceCount
			out.sounds = Audio.live
			out.soundsPeak = Audio.livePeak
			out.recvKbps = Stats.DataReceiveKbps
			out.sendKbps = Stats.DataSendKbps
			if arg == "reset" then
				Perf.reset()
				Pulses.resetCost()
				Audio.livePeak = Audio.live
				Lines.maxColor, Lines.maxPlace = 0, 0
			end
			return out
		elseif cmd == "pulseBench" then
			-- (성능 측정) 가짜 시계로 음파 n 개를 동시에 끝까지 돌린 비용(ms): 여러 번 되풀이해 최소·중앙값 → 다른 프로그램 부하에 덜 흔들린다
			local at, n, reps = arg.at, arg.n, arg.reps
			local starts, totals, peaks, waves, shown = {}, {}, {}, {}, 0
			for _ = 1, reps do
				Pulses.clear()
				Lines.clear()
				task.wait(0.15)
				local s0 = Lines.shownTotal
				local c0 = os.clock()
				for k = 1, n do
					Pulses.start(at[(k - 1) % #at + 1], player.Character, k == 1)
				end
				local c1 = os.clock()
				local now, peak, wave = c1, 0, 0
				for f = 1, 300 do
					now += 1 / 60
					local a = os.clock()
					Pulses.update(now)
					Lines.update(now)
					local d = os.clock() - a
					peak = math.max(peak, if f == 1 then d + (c1 - c0) else d)
					if Pulses.active() > 0 then
						wave += d
					end
					if Pulses.active() == 0 and Lines.stats().active == 0 then
						break
					end
				end
				table.insert(starts, (c1 - c0) * 1000)
				table.insert(waves, wave * 1000)
				table.insert(totals, (os.clock() - c0) * 1000)
				table.insert(peaks, peak * 1000)
				shown = Lines.shownTotal - s0
			end
			Pulses.clear()
			Lines.clear()
			local function mm(t)
				table.sort(t)
				return { min = t[1], med = t[(#t + 1) // 2] }
			end
			return { start = mm(starts), wave = mm(waves), total = mm(totals), peak = mm(peaks), shown = shown }
		elseif cmd == "netaudio" then
			-- (측정) 리모트·속성·소리 통계. arg == "reset" 이면 읽은 뒤 비운다
			local Stats = game:GetService("Stats")
			local snap = NetStat.snapshot(arg == "reset")
			snap.live = Audio.live
			snap.livePeak = Audio.livePeak
			snap.memMb = Stats:GetTotalMemoryUsageMb()
			snap.luaKb = gcinfo()
			snap.instances = Stats.InstanceCount
			snap.recvKbps = Stats.DataReceiveKbps
			snap.sendKbps = Stats.DataSendKbps
			local n = 0
			for _, d in workspace:GetDescendants() do
				if d:IsA("Sound") then
					n += 1
				end
			end
			snap.soundsInWorkspace = n
			snap.soundsInSoundService = #game:GetService("SoundService"):GetChildren()
			if arg == "reset" then
				Audio.livePeak = Audio.live
			end
			return snap
		elseif cmd == "flood" then
			-- (측정) 리모트를 한 번에 많이 보낸다(서버 과부하 방어 시험). arg = { remote = 이름, n = 횟수 }
			local ev = Remotes:FindFirstChild(arg.remote) :: RemoteEvent?
			if not ev then
				return false
			end
			for k = 1, arg.n do
				if arg.remote == "LookShare" then
					ev:FireServer(math.random() * 6 - 3, math.random() - 0.5)
				elseif arg.remote == "MapShare" then
					ev:FireServer("sync")
				elseif arg.remote == "SetMoveMode" then
					ev:FireServer(if k % 2 == 0 then "Run" else "Walk")
				elseif arg.remote == "RoomAction" then
					ev:FireServer(if k % 2 == 0 then "leave" else "create")
				else
					ev:FireServer()
				end
			end
			return true
		elseif cmd == "spin" then
			-- (측정) 카메라를 계속 돌린다(시선 공유 송신량 측정). arg = 초당 라디안, 0 이면 멈춤
			local rate = tonumber(arg) or 0
			RunService:UnbindFromRenderStep("SonarTestSpin")
			if rate ~= 0 then
				RunService:BindToRenderStep("SonarTestSpin", Enum.RenderPriority.Camera.Value + 1, function(dt)
					local cam = workspace.CurrentCamera
					if cam then
						cam.CFrame = cam.CFrame * CFrame.Angles(0, rate * dt, 0)
					end
				end)
			end
			return true
		elseif cmd == "fire" then
			return fire()
		elseif cmd == "lastFail" then
			return { fail = Pulses.lastFail, ready = World.ready, hidden = player:GetAttribute("Hidden"), status = player:GetAttribute("Status") }
		elseif cmd == "rawFire" then
			-- 로컬 대기시간을 무시하고 서버에 바로 요청(서버 검증 시험)
			SonarFire:FireServer()
			return true
		elseif cmd == "move" then
			local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if h then
				h:MoveTo(arg :: Vector3)
			end
			return h ~= nil
		elseif cmd == "resetPerf" then
			table.clear(frameTimes)
			table.clear(luaTimes)
			prof.pulses, prof.lines, prof.frames = 0, 0, 0
			Lines.maxColor, Lines.maxPlace = 0, 0
			return true
		elseif cmd == "resetCooldown" then
			lastFire = -math.huge
			return true
		elseif cmd == "pulseAt" then
			-- 시각 효과만(서버에 알리지 않음): 지정 지점에서 음파
			return Pulses.start(arg :: Vector3, player.Character, true)
		elseif cmd == "floorEndsNear" then
			-- 바닥 높이 수평 선분 중 끝점이 p 에서 r 안에 있는 것의 수(모서리까지 선이 닿는가)
			local t = arg :: { any }
			local p, r = t[1] :: Vector3, t[2] :: number
			local n = 0
			for i = 1, World.segCount do
				local sa, sb = World.SA[i], World.SB[i]
				if math.abs(sa.Y - sb.Y) < 0.05 and math.abs(sa.Y - p.Y) < 0.3 and ((sa - p).Magnitude < r or (sb - p).Magnitude < r) then
					n += 1
				end
			end
			return n
		elseif cmd == "linesNear" then
			local t = arg :: { any }
			return Lines.countNear(t[1], t[2])
		elseif cmd == "lookTarget" or cmd == "useLook" then
			-- (테스트) arg 위치를 바라보게 한 뒤
			if typeof(arg) == "Vector3" then
				local cam = workspace.CurrentCamera
				cam.CFrame = CFrame.lookAt(cam.CFrame.Position, arg :: Vector3)
			end
			return if cmd == "lookTarget" then SearchLook.target() else SearchLook.use()
		elseif cmd == "soundCheck" then
			-- 실제 녹음 소리(괴성 후보 전부 + 괴물 발소리)가 이 게임에서 불러와지는가
			local ids = {}
			for _, r in (Config :: any).RealScreams do
				table.insert(ids, "rbxassetid://" .. r.Id)
				if r.Layer then
					table.insert(ids, "rbxassetid://" .. r.Layer.Id)
				end
			end
			table.insert(ids, (Config.Sounds :: any).MonsterStep.Id)
			local sounds = {}
			for _, id in ids do
				local snd = Instance.new("Sound")
				snd.SoundId = id
				snd.Volume = 0
				snd.Parent = workspace
				table.insert(sounds, snd)
			end
			local bad = {}
			pcall(function()
				game:GetService("ContentProvider"):PreloadAsync(sounds, function(contentId, status)
					if status ~= Enum.AssetFetchStatus.Success then
						table.insert(bad, contentId .. "=" .. status.Name)
					end
				end)
			end)
			local lengths = {}
			for _, snd in sounds do
				table.insert(lengths, math.floor(snd.TimeLength * 10) / 10)
				snd:Destroy()
			end
			return { total = #ids, bad = bad, lengths = lengths }
		elseif cmd == "prompts" then
			-- 주변 ProximityPrompt(거리·켜짐·이름) — 안내가 안 뜰 때 원인 찾기
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local out = {}
			for _, d in workspace:GetDescendants() do
				if d:IsA("ProximityPrompt") and d.Parent and d.Parent:IsA("BasePart") and root then
					local dist = ((d.Parent :: BasePart).Position - root.Position).Magnitude
					if dist < 12 then
						table.insert(out, string.format("%s %.1f/%d en=%s %s", d.ActionText, dist, d.MaxActivationDistance, tostring(d.Enabled), d.Parent:GetFullName()))
					end
				end
			end
			table.insert(out, "svc=" .. tostring(game:GetService("ProximityPromptService").Enabled))
			return table.concat(out, " ; ")
		elseif cmd == "mobile" then
			if arg ~= nil then
				player:SetAttribute("ForceMobileUI", arg == true)
			end
			task.wait(0.4)
			return MobileUI.state()
		elseif cmd == "reveal" then
			return Reveal.count()
		elseif cmd == "revealedModel" then
			-- (테스트) 이 괴물이 지금 음파에 드러나 보이는가 + 보이는 부품 수
			local mdl = arg :: Model
			local vis = 0
			for _, d in mdl:GetDescendants() do
				if d:IsA("BasePart") and d.Transparency < 1 and d.Name ~= "HumanoidRootPart" then
					vis += 1
				end
			end
			return { active = Reveal.active(mdl), visible = vis }
		elseif cmd == "creature" then
			-- (테스트) 챕터 괴물 애니메이션 측정: 프레임 수, 최대 관절 각, 착지(소리) 수
			if arg == "reset" then
				CreatureAnim.range = 1e9
				CreatureAnim.reset()
				RigAnim.reset()
				return true
			end
			return CreatureAnim.stats[arg] or RigAnim.stats[arg] or require(script.Parent:WaitForChild("SpriteAnim")).stats[arg]
		elseif cmd == "anim" then
			-- (테스트) 괴물 몸 움직임 측정: 디딘 발 미끄러짐, 걸음 수, 골반 오르내림, 척추 비틀림, 머리 지연, 실제 발소리 수
			local s = MonsterAnim.summary()
			s.footSounds = Audio.monsterSteps
			if arg == "reset" or arg == "all" then
				if arg == "all" then
					MonsterAnim.range = 1e9 -- (테스트) 멀리 있는 괴물도 계산
				end
				MonsterAnim.reset()
				Audio.monsterSteps = 0
			end
			return s
		elseif cmd == "doppelFx" then
			return { bursts = DoppelFx.bursts, shards = DoppelFx.lastShards, eyes = DoppelFx.litEyeCount(), sounds = Audio.bursts }
		elseif cmd == "jump" then
			local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if h then
				h.Jump = true
			end
			return h ~= nil
		elseif cmd == "cursor" then
			return UserInputService.MouseIconEnabled
		elseif cmd == "jumpscare" then
			return JumpScare.state()
		elseif cmd == "keyHud" then
			return KeyHUD.state()
		elseif cmd == "mates" then
			return Mates.count()
		elseif cmd == "lobby" then
			return LobbyUI.state()
		elseif cmd == "lobbyClick" then
			return LobbyUI.click(arg :: string)
		elseif cmd == "lobbyMenu" then
			LobbyUI.setMenu(arg == true)
			return LobbyUI.state()
		elseif cmd == "map" then
			return MapView.state()
		elseif cmd == "toggleMap" then
			MapView.toggle()
			return MapView.state()
		elseif cmd == "trace" then
			local p = Pulses.last
			if not p or not p.trace then
				return nil
			end
			return { trace = p.trace, revealed = p.revealed, origin = p.origin }
		elseif cmd == "lit" then
			return Lines.litMidpoints()
		elseif cmd == "segInfo" then
			-- 지정 선분 id 의 가운데 점
			return World.SM[arg :: number]
		elseif cmd == "segsNear" then
			-- arg = {pos, radius}: 그 근처 정적 선분 id
			local out = {}
			for i = 1, World.segCount do
				if (World.SM[i] - arg[1]).Magnitude <= arg[2] then
					table.insert(out, i)
				end
			end
			return out
		elseif cmd == "setMode" then
			Movement.forced = arg
			return true
		elseif cmd == "cell" then
			local x, y, z = World.cellOf(arg :: Vector3)
			if not x then
				return "out"
			end
			return if World.free(World.index(x :: number, y :: number, z :: number)) then "free" else "blocked"
		end
		return nil
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="288">
        <Properties>
          <string name="Name">MapView</string>
          <string name="Source"><![CDATA[--!strict
-- 지도(Q): 나와 팀원의 음파가 닿은 곳이 그려지고, 그 스테이지가 끝날 때까지 남는다(게임 화면의 선은 그대로 사라진다).
-- 검은 바탕에 벽 윤곽을 흰 선으로, 내 위치는 빨간 칸, 팀원은 흰 테두리 칸. 출구는 음파가 닿았을 때만 표시.
-- 2층 건물(스테이지 속성 Rows2, 1층과 같은 크기)은 1층·2층 지도를 따로 그린다: 지금 서 있는 층이 보이고, 위쪽 "1층 / 2층" 버튼으로 바꿔 본다.
-- 칸 번호: 행*1024 + 열, 2층 칸은 +100000(서버 팀 공유도 같은 번호).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local World = require(script.Parent:WaitForChild("SonarWorld"))
local NetStat = require(script.Parent:WaitForChild("NetStat"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
-- 팀 지도 공유: 내가 새로 밝힌 칸을 서버에 보내고, 서버가 모은 팀 전체 기록을 받는다(멀리 있는 팀원·다시 살아남·재접속도 같은 지도)
local MapShare = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("MapShare") :: RemoteEvent
local currentBuild: number? = nil

local Map = {}

local player = Players.LocalPlayer
local T = 8 -- 맵 한 칸(스터드), StageBuilder 와 같다
local LINE = 2 -- 선 굵기(픽셀)

local rows: { string } = {}
local floorRows: { { string } } = { {}, {} } -- [1] 1층, [2] 2층(없으면 빈 표)
local hasUpper = false
local viewFloor = 1 -- 지금 보여 주는 층
local manualFloor = false -- 버튼으로 층을 골랐는가(지도를 다시 열면 내 층으로)
local exitFloor = 1
local W, H = 0, 0
local UPPER_Y = 9 -- 이 높이(스터드)보다 위면 2층(2층 바닥 12)
local explored: { [number]: boolean } = {}
local drawn: { [number]: boolean } = {}
local lineCount = 0
local exploredCount = 0
local isOpen = false

-- ── 화면 ──
local gui = Instance.new("ScreenGui")
gui.Name = "SonarMap"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 20
gui.Enabled = false

local back = Instance.new("Frame")
back.Name = "Back"
back.Size = UDim2.fromScale(1, 1)
back.BackgroundColor3 = Color3.new(0, 0, 0)
back.BackgroundTransparency = 0.04
back.BorderSizePixel = 0
back.Parent = gui

local canvas = Instance.new("Frame")
canvas.Name = "Canvas"
canvas.AnchorPoint = Vector2.new(0.5, 0.5)
canvas.Position = UDim2.fromScale(0.5, 0.52)
canvas.Size = UDim2.fromScale(0.9, 0.86)
canvas.BackgroundTransparency = 1
canvas.Parent = back
local aspect = Instance.new("UIAspectRatioConstraint")
aspect.AspectRatio = 1
aspect.Parent = canvas

local floorLines: { Folder } = {}
for f = 1, 2 do
	local fo = Instance.new("Folder")
	fo.Name = "Lines" .. f
	fo.Parent = canvas
	floorLines[f] = fo
end

local function square(color: Color3, px: number, z: number): Frame
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = UDim2.fromOffset(px, px)
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.Visible = false
	f.Parent = canvas
	return f
end
local me = square(Color3.fromRGB(226, 75, 74), 10, 3)
-- 내가 바라보는 방향: 내 칸 가운데에서 앞쪽으로 퍼지는 반투명 원뿔(시야, 약 70°). 멀어질수록 흐려진다.
-- 가운데를 축으로 도는 투명 틀(look) 안에, 가운데에서 뻗는 가는 빛줄기를 부채꼴로 겹쳐 그린다
local look = Instance.new("Frame")
look.Name = "Look"
look.AnchorPoint = Vector2.new(0.5, 0.5)
look.Size = UDim2.fromOffset(110, 110)
look.BackgroundTransparency = 1
look.ZIndex = 2
look.Visible = false
look.Parent = canvas
do
	local CONE = Color3.fromRGB(226, 75, 74)
	local HALF = 35 -- 원뿔 반각(도)
	local RAYS = 15
	for k = 0, RAYS - 1 do
		local ang = -HALF + (2 * HALF) * k / (RAYS - 1)
		local holder = Instance.new("Frame")
		holder.AnchorPoint = Vector2.new(0.5, 0.5)
		holder.Position = UDim2.fromScale(0.5, 0.5)
		holder.Size = UDim2.fromScale(1, 1)
		holder.BackgroundTransparency = 1
		holder.Rotation = ang
		holder.ZIndex = 2
		holder.Parent = look
		local ray = Instance.new("Frame")
		ray.AnchorPoint = Vector2.new(0, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = UDim2.new(0.5, 0, 0, 5)
		ray.BackgroundColor3 = CONE
		ray.BorderSizePixel = 0
		ray.ZIndex = 2
		ray.Parent = holder
		-- 가까울수록 진하고 멀수록 사라진다(빛줄기가 겹쳐 가운데가 더 진해 보이게 한 줄은 꽤 투명하게)
		local g = Instance.new("UIGradient")
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.72), NumberSequenceKeypoint.new(0.6, 0.85), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = ray
	end
end
-- 팀원 표시(흰 테두리 칸), 필요한 만큼 만든다
local mates: { Frame } = {}
local function mateMark(i: number): Frame
	local f = mates[i]
	if not f then
		f = square(Color3.new(0, 0, 0), 10, 3)
		local st = Instance.new("UIStroke")
		st.Color = Color3.new(1, 1, 1)
		st.Thickness = 2
		st.Parent = f
		mates[i] = f
	end
	return f
end
local exitMark = square(Color3.new(1, 1, 1), 8, 2)
-- 마지막 열쇠 힌트(노란 마름모): ReplicatedStorage 속성 KeyHintPos(팀 공유)
local keyMark = square(Color3.fromRGB(239, 190, 70), 11, 4)
keyMark.Rotation = 45

local title = Instance.new("TextLabel")
title.BackgroundTransparency = 1
title.Position = UDim2.new(0, 24, 0, 16)
title.Size = UDim2.new(0.6, 0, 0, 24)
title.Font = Enum.Font.GothamMedium
title.TextSize = 16
title.TextXAlignment = Enum.TextXAlignment.Left
title.TextColor3 = Color3.fromRGB(150, 150, 150)
title.Text = "지도  ·  나와 팀원의 음파가 닿은 곳이 기록됩니다  ·  Q 닫기"
title.Parent = back

-- 층 버튼(2층 건물일 때만)
local floorButtons: { TextButton } = {}
local function setView(f: number)
	viewFloor = f
	for k = 1, 2 do
		floorLines[k].Parent = if k == f then canvas else nil
		local b = floorButtons[k]
		if b then
			b.BackgroundColor3 = if k == f then Color3.fromRGB(230, 230, 230) else Color3.fromRGB(30, 30, 30)
			b.TextColor3 = if k == f then Color3.new(0, 0, 0) else Color3.fromRGB(170, 170, 170)
		end
	end
end
for f = 1, 2 do
	local b = Instance.new("TextButton")
	b.Name = "Floor" .. f
	b.AnchorPoint = Vector2.new(1, 0)
	b.Position = UDim2.new(1, -24 - (2 - f) * 76, 0, 12)
	b.Size = UDim2.fromOffset(68, 30)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 16
	b.Text = f .. "층"
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.Visible = false
	b.Parent = back
	local cr = Instance.new("UICorner")
	cr.CornerRadius = UDim.new(0, 6)
	cr.Parent = b
	b.Activated:Connect(function()
		manualFloor = true
		setView(f)
	end)
	floorButtons[f] = b
end
local floorLabel = Instance.new("TextLabel")
floorLabel.BackgroundTransparency = 1
floorLabel.AnchorPoint = Vector2.new(0.5, 0)
floorLabel.Position = UDim2.new(0.5, 0, 0, 14)
floorLabel.Size = UDim2.fromOffset(200, 28)
floorLabel.Font = Enum.Font.GothamBold
floorLabel.TextSize = 22
floorLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
floorLabel.Text = ""
floorLabel.Parent = back
local function myFloor(y: number): number
	return if hasUpper and y > UPPER_Y then 2 else 1
end

gui.Parent = player:WaitForChild("PlayerGui")

-- ── 격자 ──
local function at(i: number, j: number, f: number?): string
	local rs = floorRows[f or 1]
	if j < 1 or j > H or i < 1 or i > W or not rs[j] then
		return "#"
	end
	return rs[j]:sub(i, i)
end
-- (2층의 계단 구멍 o 도 지도에서는 벽처럼 윤곽을 친다)
local function isWall(i: number, j: number, f: number?): boolean
	local c = at(i, j, f)
	return c == "#" or c == "o"
end

-- 격자 꼭짓점 (x1,y1)-(x2,y2) 사이 선(가로 또는 세로 한 칸)
local function line(x1: number, y1: number, x2: number, y2: number, fl: number)
	local key = ((y1 * 1024 + x1) * 2) + (if y1 == y2 then 0 else 1) + (fl - 1) * 1000000
	if drawn[key] then
		return
	end
	drawn[key] = true
	lineCount += 1
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BorderSizePixel = 0
	if y1 == y2 then
		f.Position = UDim2.new(x1 / W, -LINE / 2, y1 / H, -LINE / 2)
		f.Size = UDim2.new((x2 - x1) / W, LINE, 0, LINE)
	else
		f.Position = UDim2.new(x1 / W, -LINE / 2, y1 / H, -LINE / 2)
		f.Size = UDim2.new(0, LINE, (y2 - y1) / H, LINE)
	end
	f.Parent = floorLines[fl]
end

local function markTile(i: number, j: number, f: number?): boolean
	local fl = f or 1
	if fl == 2 and not hasUpper then
		return false
	end
	local k = j * 1024 + i + (fl - 1) * 100000
	if explored[k] or isWall(i, j, fl) or i < 1 or j < 1 or i > W or j > H then
		return false
	end
	explored[k] = true
	exploredCount += 1
	if isWall(i, j - 1, fl) then
		line(i - 1, j - 1, i, j - 1, fl)
	end
	if isWall(i, j + 1, fl) then
		line(i - 1, j, i, j, fl)
	end
	if isWall(i - 1, j, fl) then
		line(i - 1, j - 1, i - 1, j, fl)
	end
	if isWall(i + 1, j, fl) then
		line(i, j - 1, i, j, fl)
	end
	if at(i, j, fl) == "E" then
		exitMark.Position = UDim2.fromScale((i - 0.5) / W, (j - 0.5) / H)
		exitMark.Visible = true
		exitFloor = fl
	end
	return true
end
-- 칸 번호(서버 팀 공유) → 칸 표시
local function markKey(k: number): boolean
	local fl = if k >= 100000 then 2 else 1
	local r = k % 100000
	return markTile(r % 1024, r // 1024, fl)
end

-- 새 스테이지: 기록을 지운다
function Map.load(stage: Instance)
	local s = stage:GetAttribute("Rows")
	rows = if type(s) == "string" then string.split(s, "/") else {}
	local s2 = stage:GetAttribute("Rows2")
	hasUpper = type(s2) == "string"
	floorRows = { rows, if type(s2) == "string" then string.split(s2, "/") else {} }
	H = #rows
	W = if H > 0 then #rows[1] else 0
	table.clear(explored)
	table.clear(drawn)
	for f = 1, 2 do
		floorLines[f]:ClearAllChildren()
		floorButtons[f].Visible = hasUpper
	end
	floorLabel.Text = ""
	exitFloor = 1
	manualFloor = false
	setView(1)
	lineCount = 0
	exploredCount = 0
	exitMark.Visible = false
	aspect.AspectRatio = if H > 0 then W / H else 1
	-- 팀이 이미 밝힌 칸을 서버에서 받아 온다(다시 살아나거나 다시 들어와도 지도가 이어진다)
	currentBuild = stage:GetAttribute("BuildId") :: number?
	MapShare:FireServer("sync")
	NetStat.count("send.MapShare")
end

-- 서버가 보낸 팀원 기록(같은 스테이지일 때만)
MapShare.OnClientEvent:Connect(function(data: any)
	NetStat.count("recv.MapShare")
	NetStat.count("recv.MapShare.tiles", if type(data) == "table" and type(data.tiles) == "table" then #data.tiles else 0)
	if type(data) ~= "table" or data.build ~= currentBuild or type(data.tiles) ~= "table" or W == 0 then
		return
	end
	for _, k in data.tiles do
		if type(k) == "number" then
			markKey(k)
		end
	end
end)

-- 내 음파가 끝났다: 닿은 복셀의 칸을 기록
-- cells: 음파가 닿은 복셀 번호(World.index) 목록. 복셀 여러 개가 한 칸(8스터드)이므로 칸마다 한 번만 판정한다
local reachSeen: { [number]: boolean } = {}
function Map.onReach(cells: { number })
	if W == 0 then
		return
	end
	local fresh = {}
	local o, cs = World.origin, World.cs
	local ox, oy, oz = o.X + cs / 2, o.Y + cs / 2, o.Z + cs / 2
	local nx, ny = World.nx, World.ny
	table.clear(reachSeen)
	for _, idx in cells do
		local c = idx - 1
		local t = c // nx
		local i = (ox + (c % nx) * cs) // T + 1
		local j = (oz + (t // ny) * cs) // T + 1
		local fl = if hasUpper and oy + (t % ny) * cs > UPPER_Y then 2 else 1
		local k = j * 1024 + i + (fl - 1) * 100000
		if not reachSeen[k] then
			reachSeen[k] = true
			if markTile(i, j, fl) then
				table.insert(fresh, k)
			end
		end
	end
	-- 새로 밝힌 칸을 팀에 알린다
	if #fresh > 0 and currentBuild then
		MapShare:FireServer({ build = currentBuild, tiles = fresh })
		NetStat.count("send.MapShare")
		NetStat.count("send.MapShare.tiles", #fresh)
	end
end

function Map.setOpen(v: boolean)
	isOpen = v
	gui.Enabled = v
	if v then
		manualFloor = false -- 열 때는 내가 서 있는 층부터
	end
end

function Map.toggle()
	Map.setOpen(not isOpen)
end

function Map.state()
	local shown = 0
	for _, f in mates do
		if f.Visible then
			shown += 1
		end
	end
	return { open = isOpen, explored = exploredCount, lines = lineCount, exitShown = exitMark.Visible, meShown = me.Visible, matesShown = shown, floors = if hasUpper then 2 else 1, viewFloor = viewFloor }
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q then
		Map.toggle()
	end
end)

RunService.RenderStepped:Connect(function()
	if not isOpen or W == 0 then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	-- 보여 줄 층: 버튼으로 고르지 않았으면 내가 서 있는 층
	if hasUpper and root and not manualFloor then
		local f = myFloor(root.Position.Y)
		if f ~= viewFloor then
			setView(f)
		end
	end
	floorLabel.Text = if hasUpper then viewFloor .. "층" else ""
	exitMark.BackgroundTransparency = if exitFloor == viewFloor then 0 else 1
	local kp = ReplicatedStorage:GetAttribute("KeyHintPos")
	if typeof(kp) == "Vector3" and ReplicatedStorage:GetAttribute("HasKey") ~= true and myFloor(kp.Y) == viewFloor then
		keyMark.Position = UDim2.fromScale(kp.X / (W * T), kp.Z / (H * T))
		keyMark.Visible = true
	else
		keyMark.Visible = false
	end
	if root and myFloor(root.Position.Y) == viewFloor then
		me.Position = UDim2.fromScale(root.Position.X / (W * T), root.Position.Z / (H * T))
		me.Visible = true
		-- 바라보는 방향(카메라가 보는 쪽, 지도는 X → 오른쪽, Z → 아래)
		local cam = workspace.CurrentCamera
		local lv = if cam then cam.CFrame.LookVector else root.CFrame.LookVector
		local flat = Vector2.new(lv.X, lv.Z)
		if flat.Magnitude > 0.05 then
			look.Position = me.Position
			look.Rotation = math.deg(math.atan2(flat.Y, flat.X))
			look.Visible = true
		end
	else
		me.Visible = false
		look.Visible = false
	end
	-- 살아 있는 팀원(같은 게임의 다른 플레이어)
	local n = 0
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("Status") == "Alive" then
			local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r and myFloor(r.Position.Y) == viewFloor then
				n += 1
				local f = mateMark(n)
				f.Position = UDim2.fromScale(r.Position.X / (W * T), r.Position.Z / (H * T))
				f.Visible = true
			end
		end
	end
	for i = n + 1, #mates do
		mates[i].Visible = false
	end
end)

return Map
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="289">
        <Properties>
          <string name="Name">Mates</string>
          <string name="Source"><![CDATA[--!strict
-- 함께 하는 플레이어(팀원)는 음파와 상관없이 늘 흰 윤곽선으로 보인다(실제 아바타 모양, Highlight).
-- 벽 너머는 가려진다(DepthMode Occluded). 살아 있는(Status "Alive") 다른 플레이어만, 내 캐릭터는 제외.
-- Highlight 는 이 클라이언트에만 만들어진다(복제되지 않음).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Mates = {}
local player = Players.LocalPlayer
local NAME = "MateOutline"

local function wanted(p: Player): Model?
	if p == player or p:GetAttribute("Status") ~= "Alive" then
		return nil
	end
	return p.Character
end

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TAG = require(ReplicatedStorage.Shared.Config).Tags.Monster

local function outline(target: Model): Highlight
	local hl = Instance.new("Highlight")
	hl.Name = NAME
	hl.Adornee = target
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.new(1, 1, 1)
	hl.OutlineTransparency = 0.3
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = target
	return hl
end

local function sync()
	-- 사람 모습 도플갱어(진짜 아바타)도 팀원과 똑같이 늘 윤곽선으로 보인다. 터지면 지운다
	for _, inst in CollectionService:GetTagged(TAG) do
		if inst:IsA("Model") then
			local m = inst :: Model
			local want = m:GetAttribute("Form") == "Disguise" and m:GetAttribute("AvatarOf") ~= nil
			local h = m:FindFirstChild(NAME)
			if want and not h then
				outline(m)
			elseif h and not want then
				h:Destroy()
			end
		end
	end
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local want = wanted(p)
		local h = char and char:FindFirstChild(NAME) :: Highlight?
		if want and not h then
			outline(want)
		elseif h and not want then
			h:Destroy()
		end
	end
end

-- (테스트) 윤곽선이 켜진 팀원 수
function Mates.count(): number
	local n = 0
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local h = char and char:FindFirstChild(NAME) :: Highlight?
		if h and h.Enabled and p ~= player then
			n += 1
		end
	end
	return n
end

local Perf = require(script.Parent:WaitForChild("Perf"))
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc >= 0.25 then
		acc = 0
		local t0 = os.clock()
		sync()
		Perf.add("mates", os.clock() - t0)
	end
end)

return Mates
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="290">
        <Properties>
          <string name="Name">MobileUI</string>
          <string name="Source"><![CDATA[--!strict
-- 휴대폰·태블릿용 화면 버튼(터치 기기에서만 보인다. PC 조작은 그대로).
-- 이동·점프·시점은 로블록스 기본 터치 조작(왼쪽 조이스틱·점프 버튼·화면 끌기)을 그대로 쓴다.
--   음파(좌클릭)        → 크게 "음파" (관전 중이면 "다음 사람")
--   달리기(Shift)·웅크리기(Ctrl) → 눌러서 켜고 끄기(둘 중 하나만)
--   상호작용(E)        → 서랍·상자·문·숨는 곳을 볼 때만 나타난다
--   지도(Q)            → 지도 열기/닫기
--   방 메뉴(Tab)       → 로비에서만
-- 실제 동작은 Main 이 콜백(onSonar 등)으로 연결한다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local MobileUI = {}
MobileUI.run = false
MobileUI.crouch = false
MobileUI.onSonar = nil :: (() -> ())?
MobileUI.onInteract = nil :: (() -> ())?
MobileUI.canInteract = nil :: (() -> boolean)?
MobileUI.onMap = nil :: (() -> ())?
MobileUI.onMenu = nil :: (() -> ())?
MobileUI.spectating = nil :: (() -> boolean)?

local player = Players.LocalPlayer

-- 터치 기기인가. 휴대폰·태블릿은 기기마다 키보드·마우스가 있다고 보고되기도 해서 넉넉하게 본다:
--   터치가 되고 (마우스가 없거나, 키보드가 없거나, 마지막 입력이 터치) 이거나, 화면을 한 번이라도 터치했으면 켠다.
--   속성 ForceMobileUI 로 PC 에서도 켜 볼 수 있다(테스트)
local sawTouch = false
UserInputService.TouchStarted:Connect(function()
	sawTouch = true
end)
UserInputService.LastInputTypeChanged:Connect(function(t)
	if t == Enum.UserInputType.Touch then
		sawTouch = true
	end
end)
local function isTouch(): boolean
	if player:GetAttribute("ForceMobileUI") or sawTouch then
		return true
	end
	if not UserInputService.TouchEnabled then
		return false
	end
	return not UserInputService.MouseEnabled or not UserInputService.KeyboardEnabled or UserInputService:GetLastInputType() == Enum.UserInputType.Touch
end

local gui = Instance.new("ScreenGui")
gui.Name = "MobileUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 25 -- (지도(20)·방 메뉴(10) 위: 지도를 연 채로도 닫을 수 있게. 점프스케어(50) 아래)
gui.Enabled = false

local WHITE = Color3.fromRGB(235, 235, 235)
local DIM = Color3.fromRGB(20, 20, 20)

local function button(name: string, text: string, size: number, pos: UDim2, textSize: number): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = text
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Position = pos
	b.Size = UDim2.fromOffset(size, size)
	b.BackgroundColor3 = DIM
	b.BackgroundTransparency = 0.35
	b.TextColor3 = WHITE
	b.Font = Enum.Font.GothamMedium
	b.TextSize = textSize
	b.AutoButtonColor = true
	b.Active = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Color = WHITE
	stroke.Transparency = 0.4
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	b.Parent = gui
	return b
end

local sonarBtn = button("Sonar", "음파", 100, UDim2.new(), 22)
local runBtn = button("Run", "달리기", 64, UDim2.new(), 15)
local crouchBtn = button("Crouch", "웅크리기", 64, UDim2.new(), 14)
local useBtn = button("Use", "E\n상호작용", 70, UDim2.new(), 14)
local mapBtn = button("Map", "지도", 56, UDim2.new(), 15)
local menuBtn = button("Menu", "방 메뉴", 62, UDim2.new(), 13)
local hintBtn = button("Hint", "힌트", 52, UDim2.new(), 13) -- (마지막 열쇠 힌트가 준비됐을 때만)
MobileUI.onHint = nil :: (() -> ())?
MobileUI.hintAvailable = nil :: (() -> boolean)?
hintBtn.Activated:Connect(function()
	if MobileUI.onHint then
		MobileUI.onHint()
	end
end)

-- ── 배치: 오른손 엄지가 닿는 부채꼴(음파 가운데, 달리기·웅크리기·상호작용이 둘레), 버튼 사이 간격 약 25px ──
-- 좌표는 작은 휴대폰(짧은 변 약 390) 기준 "버튼 가운데" 위치(화면 오른쪽 아래 / 오른쪽 위 모서리에서의 거리), 지름.
-- 휴대폰에서는 로블록스 점프 버튼을 없앴으므로(이 게임에서는 점프가 거의 필요 없다) 음파를 엄지가 쉬는 오른쪽 아래에 둔다.
type Slot = { b: TextButton, x: number, y: number, d: number, text: number, top: boolean? }
local LAYOUT: { Slot } = {
	{ b = sonarBtn, x = -110, y = -95, d = 100, text = 22 }, -- 음파: 오른쪽 아래 엄지 자리, 가장 크게
	{ b = runBtn, x = -215, y = -55, d = 64, text = 15 }, -- 달리기: 음파 왼쪽 아래(엄지를 왼쪽으로)
	{ b = crouchBtn, x = -210, y = -150, d = 64, text = 14 }, -- 웅크리기: 달리기 위
	{ b = useBtn, x = -105, y = -200, d = 70, text = 14 }, -- 상호작용: 음파 바로 위
	{ b = mapBtn, x = -52, y = 118, d = 56, text = 15, top = true }, -- 지도(게임 중): 오른쪽 위, 목숨 표시 아래
	{ b = menuBtn, x = -56, y = 122, d = 62, text = 13, top = true }, -- 방 메뉴(로비): 지도와 같은 자리
	{ b = hintBtn, x = -52, y = 182, d = 52, text = 13, top = true }, -- 힌트(마지막 열쇠): 지도 아래
}
local hookedJump: Instance? = nil -- (로블록스 점프 버튼: 다시 켜지는 순간 바로 숨긴다)
local lastVP = Vector2.zero
local function layout()
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(812, 375)
	if vp == lastVP then
		return
	end
	lastVP = vp
	local short = math.min(vp.X, vp.Y)
	-- 작은 휴대폰은 조금 작게, 태블릿은 크게
	local s = math.clamp(short / 390, 0.85, 1.3)
	local shift = 0
	for _, slot in LAYOUT do
		local d = math.floor(slot.d * s)
		slot.b.Size = UDim2.fromOffset(d, d)
		slot.b.TextSize = math.floor(slot.text * s)
		if slot.top then
			slot.b.Position = UDim2.new(1, slot.x * s, 0, slot.y * s)
		else
			slot.b.Position = UDim2.new(1, slot.x * s + shift, 1, slot.y * s)
		end
	end
end
layout()

local function paintToggle(b: TextButton, on: boolean)
	b.BackgroundColor3 = if on then Color3.fromRGB(230, 230, 230) else DIM
	b.TextColor3 = if on then Color3.fromRGB(10, 10, 10) else WHITE
end

sonarBtn.Activated:Connect(function()
	if MobileUI.onSonar then
		MobileUI.onSonar()
	end
end)
runBtn.Activated:Connect(function()
	MobileUI.run = not MobileUI.run
	if MobileUI.run then
		MobileUI.crouch = false
	end
	paintToggle(runBtn, MobileUI.run)
	paintToggle(crouchBtn, MobileUI.crouch)
end)
crouchBtn.Activated:Connect(function()
	MobileUI.crouch = not MobileUI.crouch
	if MobileUI.crouch then
		MobileUI.run = false
	end
	paintToggle(runBtn, MobileUI.run)
	paintToggle(crouchBtn, MobileUI.crouch)
end)
useBtn.Activated:Connect(function()
	if MobileUI.onInteract then
		MobileUI.onInteract()
	end
end)
mapBtn.Activated:Connect(function()
	if MobileUI.onMap then
		MobileUI.onMap()
	end
end)
menuBtn.Activated:Connect(function()
	if MobileUI.onMenu then
		MobileUI.onMenu()
	end
end)

gui.Parent = player:WaitForChild("PlayerGui")

-- 상황에 맞게 보이기(0.15초마다)
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.15 then
		return
	end
	acc = 0
	local on = isTouch()
	gui.Enabled = on
	if not on then
		return
	end
	layout() -- (화면을 돌리거나 크기가 바뀌면 다시 배치)
	-- 로블록스 기본 점프 버튼 숨기기(휴대폰에서만. 로블록스가 상태에 따라 다시 켜므로 계속 확인)
	local pg = player:FindFirstChildOfClass("PlayerGui")
	local touchGui = pg and pg:FindFirstChild("TouchGui")
	local frame = touchGui and touchGui:FindFirstChild("TouchControlFrame")
	local jump = frame and frame:FindFirstChild("JumpButton")
	if jump and jump:IsA("GuiObject") then
		if jump.Visible then
			jump.Visible = false
		end
		if hookedJump ~= jump then
			hookedJump = jump
			local j = jump :: GuiObject
			j:GetPropertyChangedSignal("Visible"):Connect(function()
				if j.Visible and gui.Enabled then
					j.Visible = false
				end
			end)
		end
	end
	local mode = ReplicatedStorage:GetAttribute("Mode")
	local lobby = mode == "Lobby"
	local playing = mode == "Game" and ReplicatedStorage:GetAttribute("RoundState") == "Playing"
	local alive = player:GetAttribute("Status") == "Alive"
	local spect = MobileUI.spectating ~= nil and MobileUI.spectating()
	sonarBtn.Visible = lobby or playing
	sonarBtn.Text = if spect then "다음\n사람" else "음파"
	runBtn.Visible = alive and (lobby or playing)
	crouchBtn.Visible = alive and (lobby or playing)
	useBtn.Visible = alive and MobileUI.canInteract ~= nil and MobileUI.canInteract()
	mapBtn.Visible = playing
	menuBtn.Visible = lobby
	hintBtn.Visible = playing and alive and MobileUI.hintAvailable ~= nil and MobileUI.hintAvailable()
	-- 죽거나 스테이지가 바뀌면 달리기·웅크리기 해제
	if not alive and (MobileUI.run or MobileUI.crouch) then
		MobileUI.run = false
		MobileUI.crouch = false
		paintToggle(runBtn, false)
		paintToggle(crouchBtn, false)
	end
end)

-- (테스트) 보이는 버튼 이름
function MobileUI.state()
	local shown = {}
	for _, c in gui:GetChildren() do
		if c:IsA("TextButton") and c.Visible then
			table.insert(shown, c.Name)
		end
	end
	table.sort(shown)
	return { enabled = gui.Enabled, buttons = shown, run = MobileUI.run, crouch = MobileUI.crouch }
end

return MobileUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="291">
        <Properties>
          <string name="Name">MonsterAnim</string>
          <string name="Source"><![CDATA[--!strict
-- 괴물 전신 움직임(클라이언트). 서버는 위치·상태만 정하고, 몸은 여기서 매 프레임 만든다(Rig 2 뼈대의 Motor6D.Transform).
--
-- 원리(관절을 그냥 흔들지 않는다):
--  · 발 고정(Foot Planting): 디딘 발은 월드 위치에 못 박힌다. 몸이 앞으로 가서 발이 "제자리(엉덩이 아래 + 진행 방향)"에서
--    보폭 절반 이상 벗어나면 그 발을 들어 다음 착지점으로 옮긴다(한 번에 한 발, 기어갈 때는 대각선 두 발).
--    다리는 2관절 IK 로 그 발 위치에 맞춘다 → 미끄러짐 없음, 보폭·속도가 저절로 맞는다.
--  · 무게중심: 골반 높이는 디딘 다리가 닿을 수 있는 높이로 정해져(다리를 벌리면 내려간다) 걸음마다 오르내리고,
--    체중을 받는 발 쪽으로 좌우 이동한다. 착지하는 순간 질량만큼 아래로 충격(스프링)을 받는다.
--  · 관성: 몸통·머리·팔은 모두 스프링-감쇠로 목표를 따라가 시간차가 생긴다. 가속하면 상체가 먼저 앞으로 쏠리고,
--    멈추면 뒤로 젖혀졌다가 돌아온다. 회전하면 머리 → 가슴 → 골반 순으로 먼저 돌고 안쪽으로 기운다.
--  · 팔: 진자(길이에 맞는 고유 진동수)로 다리 반대 박자에 흔들리고, 몸의 가속에 늦게 따라온다. 아래 마디는 한 박자 더 늦다.
--  · 머리: 몸통 흔들림을 상쇄하며 바라볼 곳(소리 난 곳, 쫓는 대상, 두리번)을 지연을 두고 본다.
--  · 상태별 자세: 대기(호흡·체중 재분배·미세한 떨림·두리번), 경계(낮은 자세, 움찔), 추격(괴물마다 다른 체형별 동작),
--    덮치기 직전(몸을 낮추고 팔을 뒤로 모았다가 앞으로 뻗음).
--
-- 서버 Monster.luau 의 skeleton() 이 만든 뼈 이름을 쓴다: B_Pelvis, B_Chest, B_Neck, B_Head, B_Thigh±1, B_Shin±1, B_Foot±1,
-- B_Upper±1, (B_Mid±1), B_Fore±1, B_Hand±1. 모델 속성 Rig = 2, FloorY, Mass, Voice(머리 모양 번호), State, Form.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Anim = {}
-- 발이 땅에 닿는 순간(발소리): (모델, 발 위치, 세기 0~1.5)
Anim.onStep = nil :: ((Model, Vector3, number) -> ())?
-- (테스트) 모델별 측정값
Anim.stats = {} :: { [Model]: { [string]: number } }

local TWO_PI = math.pi * 2
local GRAVITY = workspace.Gravity

type Spring = { x: number, v: number }
type VSpring = { x: Vector3, v: Vector3 }
local function sp(x: number?): Spring
	return { x = x or 0, v = 0 }
end
-- 스프링-감쇠(freq: 초당 진동수, damp: 1 = 임계 감쇠)
-- 한 번에 적분하는 시간은 SUB 이하로 나눈다: 가장 단단한 스프링(머리 ~10Hz)은 1/60초 근처가 안정 한계라
-- 프레임이 늘어지거나(저사양) 멀리 있는 괴물을 몇 프레임에 한 번 계산해도(LOD) 몸이 튀지 않는다. 60fps 에서는 1번 그대로
local SUB = 1 / 55
local function step(s: Spring, target: number, freq: number, damp: number, dt: number)
	local w = TWO_PI * freq
	local n = if dt > SUB then math.ceil(dt / SUB) else 1
	local h = dt / n
	for _ = 1, n do
		local a = w * w * (target - s.x) - 2 * damp * w * s.v
		s.v += a * h
		s.x += s.v * h
	end
end
local function vstep(s: VSpring, target: Vector3, freq: number, damp: number, dt: number)
	local w = TWO_PI * freq
	local n = if dt > SUB then math.ceil(dt / SUB) else 1
	local h = dt / n
	for _ = 1, n do
		local a = (target - s.x) * (w * w) - s.v * (2 * damp * w)
		s.v += a * h
		s.x += s.v * h
	end
end
-- 벡터 a 를 b 로 돌리는 회전
local function fromTo(a: Vector3, b: Vector3): CFrame
	local axis = a:Cross(b)
	local s = axis.Magnitude
	local c = a:Dot(b)
	if s < 1e-6 then
		if c > 0 then
			return CFrame.identity
		end
		local perp = if math.abs(a.X) < 0.9 then Vector3.xAxis else Vector3.yAxis
		return CFrame.fromAxisAngle(a:Cross(perp).Unit, math.pi)
	end
	return CFrame.fromAxisAngle(axis / s, math.atan2(s, c))
end
local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end
local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- ── 몸 스타일(상태·괴물마다). 숫자는 매 프레임 부드럽게 섞여 전환된다 ──
-- crouch: 골반을 낮추는 정도(다리 길이 비율), lean: 상체 앞 숙임(rad), stride: 보폭 기준(다리 길이 비율),
-- lift: 발 드는 높이(다리 길이 비율), armBase/armSwing: 팔 기본 각도·흔들림, quad: 손도 땅을 짚는다(0~1),
-- wave: 척추 꿈틀(rad), jerk: 꼭두각시처럼 몸 목표를 끊어서 갱신(0~1), limp: 오른 다리 절뚝(0~1),
-- tension: 몸 스프링 진동수 배율(긴장할수록 빠르고 날카롭다), flail: 팔이 몸 반동에 휘둘리는 정도
type Style = { crouch: number, lean: number, stride: number, lift: number, armBase: number, armSwing: number, armSpread: number, quad: number, wave: number, jerk: number, limp: number, tension: number, flail: number, headDrop: number }
local KEYS = { "crouch", "lean", "stride", "lift", "armBase", "armSwing", "armSpread", "quad", "wave", "jerk", "limp", "tension", "flail", "headDrop" }
local function style(t: { [string]: number }): Style
	local base: { [string]: number } = { crouch = 0.08, lean = 0.12, stride = 0.34, lift = 0.16, armBase = 0.12, armSwing = 0.3, armSpread = 0.12, quad = 0, wave = 0, jerk = 0, limp = 0, tension = 1, flail = 0, headDrop = 0 }
	for k, v in t do
		base[k] = v
	end
	return (base :: any) :: Style
end
local WALK = style({})
local ALERT = style({ crouch = 0.2, lean = 0.3, stride = 0.3, armBase = 0.45, armSwing = 0.15, armSpread = 0.25, tension = 1.5 })
-- 쫓아올 때(메인 괴물 머리 모양 번호별): 체형·성격에 맞춘 변형
local CHASE: { [number]: Style } = {
	-- 1 삼각: 무겁게 절뚝이며 앞으로 쏠리고, 긴 팔을 머리 위로 치켜든 채 몸 반동에 휘둘린다
	[1] = style({ crouch = 0.16, lean = 0.5, stride = 0.48, lift = 0.24, armBase = 2.3, armSwing = 0.35, armSpread = 0.35, limp = 0.7, tension = 1.2, flail = 1 }),
	-- 2 사각: 줄 끊긴 꼭두각시. 무릎을 거의 안 굽히고 키를 세운 채, 몸이 줄에 당겨지듯 끊겨 움직이고 팔이 크게 휘둘린다
	[2] = style({ crouch = 0.0, lean = 0.05, stride = 0.42, lift = 0.12, armBase = 0.2, armSwing = 1.1, armSpread = 0.45, jerk = 1, tension = 1.6, flail = 0.6 }),
	-- 3 원: 상체를 땅으로 숙이고 긴 팔로 앞을 짚으며 네 발로 기어온다. 척추가 꿈틀거리며 상체가 끌고 하체가 따라온다
	[3] = style({ crouch = 0.42, lean = 1.25, stride = 0.36, lift = 0.14, armBase = 1.2, armSwing = 0.2, armSpread = 0.2, quad = 1, wave = 0.3, tension = 1.3 }),
	-- 4 별: 키를 세우고 무릎을 높이 들어 크게 성큼 내딛는다. 착지마다 무거운 충격, 팔은 늘어져 출렁인다
	[4] = style({ crouch = -0.02, lean = 0.18, stride = 0.62, lift = 0.6, armBase = 0.05, armSwing = 0.12, armSpread = 0.08, tension = 0.9, flail = 0.5 }),
	-- 5 육각: 몸을 낮추고 팔과 다리로 곤충처럼 잰걸음. 짧고 빠른 보폭
	[5] = style({ crouch = 0.34, lean = 1.0, stride = 0.26, lift = 0.12, armBase = 1.0, armSwing = 0.2, armSpread = 0.35, quad = 1, wave = 0.12, tension = 1.7 }),
}
local DOPPEL_CHASE = style({ crouch = 0.2, lean = 0.55, stride = 0.46, lift = 0.2, armBase = 0.9, armSwing = 0.45, armSpread = 0.3, tension = 1.5, flail = 0.4 })
local FLOWER_RUSH = style({ crouch = 0.12, lean = 0.6, stride = 0.55, lift = 0.22, armBase = -0.35, armSwing = 0.35, armSpread = 0.1, tension = 1.2, flail = 0.8 })
local FLOWER_STILL = style({ crouch = 0.04, lean = 0.06, armBase = 0.02, armSwing = 0.05, headDrop = 0.55, tension = 0.6 })

-- ── 괴물 하나의 몸 ──
type LimbRest = { m1: Motor6D, m2: Motor6D, m3: Motor6D?, mEnd: Motor6D, mToe: Motor6D?, v1: Vector3, v2: Vector3?, v3: Vector3, tip: Vector3, pole: Vector3 }
type Foot = { pos: Vector3, lifted: boolean, from: Vector3, to: Vector3, t: number, dur: number, planted: boolean }
type Arm = { pitch: Spring, roll: Spring, c1: Spring, c2: Spring, c3: Spring }
type Body = {
	model: Model,
	root: BasePart,
	pelvisM: Motor6D,
	chestM: Motor6D,
	neckM: Motor6D,
	headM: Motor6D,
	pelvisRest: Vector3,
	legs: { [number]: LimbRest },
	arms: { [number]: LimbRest },
	floorY: number,
	mass: number,
	legLen: number,
	armLen: number,
	feet: { [number]: Foot },
	hands: { [number]: Foot },
	st: Style,
	pel: VSpring,
	pelRot: VSpring, -- (pitch, yaw, roll)
	chest: VSpring,
	head: VSpring, -- 머리 월드 방향(yaw, pitch) 기준 몸 회전과 별개
	armS: { [number]: Arm },
	vel: VSpring,
	lastPos: Vector3,
	lastYaw: number,
	yawRate: Spring,
	accel: Vector3, -- 로컬 가속(부드럽게)
	t: number,
	gait: number, -- 걸은 거리 누적(척추 꿈틀 박자)
	idleShift: number,
	nextShift: number,
	look: Vector2, -- 두리번 목표(yaw, pitch)
	nextLook: number,
	lookFreq: number,
	held: { [string]: number }, -- 꼭두각시: 끊어서 갱신한 목표
	nextHold: number,
	freezeUntil: number,
	seed: number,
	lastHeard: any,
	lastState: string,
	stats: { [string]: number },
	lodAcc: number, -- (LOD) 건너뛴 프레임의 시간 누적
	lodSkip: number, -- (LOD) 건너뛴 프레임 수
}

local bodies: { [Model]: Body } = {}

local function motor(model: Model, name: string): Motor6D?
	local m = model:FindFirstChild("B_" .. name, true)
	return if m and m:IsA("Motor6D") then m else nil
end
local function tipOf(m: Motor6D): Vector3
	local p = m.Part1
	local t = p and p:GetAttribute("Tip")
	return if typeof(t) == "Vector3" then t else Vector3.new(0, -0.5, 0)
end
-- 극(무릎·팔꿈치가 굽는 쪽): 뼈 두 마디의 꺾인 방향(없으면 기본)
local function poleOf(v1: Vector3, v2: Vector3, default: Vector3): Vector3
	local u = (v1 + v2).Unit
	local p = v1 - u * v1:Dot(u)
	if p.Magnitude < 0.05 then
		return default
	end
	return p.Unit
end

local function build(model: Model): Body?
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local pelvisM, chestM, neckM, headM = motor(model, "Pelvis"), motor(model, "Chest"), motor(model, "Neck"), motor(model, "Head")
	if not (root and pelvisM and chestM and neckM and headM) then
		return nil
	end
	local legs: { [number]: LimbRest } = {}
	local arms: { [number]: LimbRest } = {}
	for _, s in { -1, 1 } do
		local th, sh, ft = motor(model, "Thigh" .. s), motor(model, "Shin" .. s), motor(model, "Foot" .. s)
		local up, mid, fo, ha = motor(model, "Upper" .. s), motor(model, "Mid" .. s), motor(model, "Fore" .. s), motor(model, "Hand" .. s)
		if not (th and sh and ft and up and fo and ha) then
			return nil
		end
		local v1, v2 = sh.C0.Position, ft.C0.Position
		-- (무릎은 앞쪽으로 굽는 경향: 그림의 꺾인 방향 + 앞)
		local kp = poleOf(v1, v2, -Vector3.zAxis)
		legs[s] = { m1 = th, m2 = sh, mEnd = ft, mToe = motor(model, "Toe" .. s), v1 = v1, v3 = v2, tip = tipOf(ft), pole = (kp + Vector3.new(0, 0, -0.8)).Unit }
		if mid then
			local a1, a2, a3 = mid.C0.Position, fo.C0.Position, ha.C0.Position
			arms[s] = { m1 = up, m2 = mid, m3 = fo, mEnd = ha, v1 = a1, v2 = a2, v3 = a3, tip = tipOf(ha), pole = poleOf(a1 + a2, a3, Vector3.zAxis) }
		else
			local a1, a3 = fo.C0.Position, ha.C0.Position
			arms[s] = { m1 = up, m2 = fo, mEnd = ha, v1 = a1, v3 = a3, tip = tipOf(ha), pole = poleOf(a1, a3, Vector3.zAxis) }
		end
	end
	local legLen = (legs[-1].v1.Magnitude + legs[-1].v3.Magnitude + legs[1].v1.Magnitude + legs[1].v3.Magnitude) / 2
	local a = arms[-1]
	local armLen = a.v1.Magnitude + (if a.v2 then a.v2.Magnitude else 0) + a.v3.Magnitude
	local rcf = root.CFrame
	local function footAt(s: number): Foot
		local L = legs[s]
		local ankleLocal = pelvisM.C0.Position + L.m1.C0.Position + L.v1 + L.v3
		local p = rcf:PointToWorldSpace(ankleLocal)
		return { pos = p, lifted = false, from = p, to = p, t = 0, dur = 0.3, planted = true }
	end
	local function handAt(s: number): Foot
		local A = arms[s]
		local p = rcf:PointToWorldSpace(pelvisM.C0.Position + chestM.C0.Position + A.m1.C0.Position + Vector3.new(0, -armLen * 0.8, -0.5))
		return { pos = p, lifted = false, from = p, to = p, t = 0, dur = 0.3, planted = false }
	end
	local function arm(): Arm
		return { pitch = sp(), roll = sp(), c1 = sp(), c2 = sp(), c3 = sp() }
	end
	local _, yaw = rcf:ToEulerAnglesYXZ()
	local b: Body = {
		model = model,
		root = root,
		pelvisM = pelvisM,
		chestM = chestM,
		neckM = neckM,
		headM = headM,
		pelvisRest = pelvisM.C0.Position,
		legs = legs,
		arms = arms,
		floorY = (model:GetAttribute("FloorY") :: number?) or -5,
		mass = (model:GetAttribute("Mass") :: number?) or 1,
		legLen = legLen,
		armLen = armLen,
		feet = { [-1] = footAt(-1), [1] = footAt(1) },
		hands = { [-1] = handAt(-1), [1] = handAt(1) },
		st = style({}),
		pel = { x = Vector3.zero, v = Vector3.zero },
		pelRot = { x = Vector3.zero, v = Vector3.zero },
		chest = { x = Vector3.zero, v = Vector3.zero },
		head = { x = Vector3.zero, v = Vector3.zero },
		armS = { [-1] = arm(), [1] = arm() },
		vel = { x = Vector3.zero, v = Vector3.zero },
		lastPos = rcf.Position,
		lastYaw = yaw,
		yawRate = sp(),
		accel = Vector3.zero,
		t = math.random() * 10,
		gait = 0,
		idleShift = 0,
		nextShift = 0,
		look = Vector2.zero,
		nextLook = 0,
		lookFreq = 2,
		held = {},
		nextHold = 0,
		freezeUntil = 0,
		seed = math.random() * 1000,
		lastHeard = model:GetAttribute("Heard"),
		lastState = (model:GetAttribute("State") :: string?) or "Wander",
		stats = { steps = 0, slip = 0, pelvisMin = math.huge, pelvisMax = -math.huge, chestYawMax = 0, headLag = 0, frames = 0, leanMax = 0, armMax = 0, liftMax = 0, freezes = 0, handSteps = 0 },
		lodAcc = 0,
		lodSkip = math.random(0, 3), -- (괴물마다 다른 프레임에 계산되게 흩뿌린다)
	}
	Anim.stats[model] = b.stats
	return b
end

-- 지금 상태에 맞는 목표 스타일
local function targetStyle(b: Body, speed: number): Style
	local m = b.model
	local state = (m:GetAttribute("State") :: string?) or "Wander"
	local voice = m:GetAttribute("Voice")
	if voice == "Flower" then
		return if speed > 3 then FLOWER_RUSH else FLOWER_STILL
	end
	if state == "Chase" then
		if voice == "Doppel" then
			return DOPPEL_CHASE
		end
		return CHASE[tonumber(voice) or 1] or WALK
	elseif state == "Alert" or state == "Investigate" or state == "Search" or state == "Look" then
		return ALERT
	end
	return WALK
end

-- 가장 가까운 살아 있는 플레이어(덮치기 자세)
local function nearestPlayer(pos: Vector3): (Vector3?, number)
	local best: Vector3?, bestD = nil, math.huge
	for _, p in Players:GetPlayers() do
		local c = p.Character
		local r = c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r and p:GetAttribute("Status") ~= "Dead" then
			local d = (r.Position - pos).Magnitude
			if d < bestD then
				best, bestD = r.Position, d
			end
		end
	end
	return best, bestD
end

-- 2관절 IK: 시작점 H 에서 길이 l1, l2 두 마디로 목표 A 에 닿는 무릎(팔꿈치) 위치
local function solve2(H: Vector3, A: Vector3, l1: number, l2: number, pole: Vector3): (Vector3, Vector3)
	local d = A - H
	local dist = math.clamp(d.Magnitude, math.abs(l1 - l2) + 0.02, (l1 + l2) * 0.999)
	local u = if d.Magnitude > 1e-4 then d.Unit else Vector3.new(0, -1, 0)
	local a = (l1 * l1 - l2 * l2 + dist * dist) / (2 * dist)
	local h = math.sqrt(math.max(l1 * l1 - a * a, 0))
	local p = pole - u * pole:Dot(u)
	p = if p.Magnitude > 1e-4 then p.Unit else Vector3.new(0, 0, -1)
	return H + u * a + p * h, H + u * dist
end

local function update(b: Body, dt: number)
	local root = b.root
	local rcf = root.CFrame
	local rrot = rcf.Rotation
	b.t += dt
	local now = b.t
	local m = b.model

	-- ── 이동량: 속도·가속·회전 속도(부드럽게) ──
	local pos = rcf.Position
	local rawVel = (pos - b.lastPos) / math.max(dt, 1e-3)
	local teleported = (pos - b.lastPos).Magnitude > 6
	b.lastPos = pos
	if teleported then
		-- 순간 이동(되살아남·테스트 배치): 몸 상태를 놓고 발을 새 자리 밑에 다시 딛는다
		rawVel = Vector3.zero
		b.vel.x, b.vel.v = Vector3.zero, Vector3.zero
		b.pel.x, b.pel.v = Vector3.zero, Vector3.zero
		b.chest.v = Vector3.zero
	end
	local prevVel = b.vel.x
	vstep(b.vel, flat(rawVel), 4, 1, dt)
	local vel = b.vel.x
	local speed = vel.Magnitude
	local accW = (vel - prevVel) / math.max(dt, 1e-3)
	local accL = rrot:VectorToObjectSpace(accW)
	b.accel = b.accel:Lerp(accL, math.min(1, dt * 6))
	local _, yaw = rcf:ToEulerAnglesYXZ()
	local dyaw = (yaw - b.lastYaw + math.pi) % TWO_PI - math.pi
	b.lastYaw = yaw
	step(b.yawRate, dyaw / math.max(dt, 1e-3), 1.5, 1, dt)
	local yawRate = math.clamp(b.yawRate.x, -3, 3)

	-- ── 스타일 섞기 ──
	local tgt = targetStyle(b, speed)
	local k = math.min(1, dt * 3)
	local st = b.st :: any
	for _, key in KEYS do
		st[key] = lerp(st[key], (tgt :: any)[key], k)
	end
	local S = b.st
	local legLen = b.legLen
	local tension = S.tension * (if b.mass < 0.8 then 1.25 else 1)

	-- 상태 변화·소리: 움찔(골반이 내려앉고 상체가 뒤로 젖혀졌다 돌아온다)
	local state = (m:GetAttribute("State") :: string?) or "Wander"
	local heard = m:GetAttribute("Heard")
	if heard ~= b.lastHeard or (state ~= b.lastState and (state == "Alert" or state == "Chase")) then
		b.pel.v += Vector3.new(0, -2.2 * legLen / 4, 0.6)
		b.chest.v += Vector3.new(-2.5, 0, 0)
		b.lookFreq = 7
		b.nextLook = now + 1.5
	end
	b.lastHeard = heard
	b.lastState = state

	-- 꼭두각시: 몸 목표를 끊어서 갱신(가끔 완전히 굳는다)
	local jerk = S.jerk > 0.5
	if jerk and now >= b.nextHold then
		b.nextHold = now + 1 / 6
		if math.noise(now * 0.7, b.seed) > 0.42 and now > b.freezeUntil + 1 then
			b.freezeUntil = now + 0.45
			b.stats.freezes += 1
		end
	end

	-- ── 발 고정·걸음 ──
	local quad = S.quad > 0.5
	local stride = legLen * S.stride
	local threshold = stride * 0.5
	local stepDur = math.clamp(0.85 * threshold / math.max(speed, 0.6), 0.14, 0.5) * (if S.lift > 0.4 then 1.35 else 1)
	local dir = if speed > 0.2 then vel.Unit else Vector3.zero
	local groundY = rcf:PointToWorldSpace(Vector3.new(0, b.floorY, 0)).Y
	local function home(s: number): Vector3
		local L = b.legs[s]
		local hipL = b.pelvisRest + L.m1.C0.Position
		local p = rcf:PointToWorldSpace(Vector3.new(hipL.X * 1.1, 0, hipL.Z + (if quad then legLen * 0.15 else 0)))
		local ankleH = L.v1.Y + L.v3.Y + b.pelvisRest.Y + L.m1.C0.Position.Y - b.floorY
		return Vector3.new(p.X, groundY + ankleH, p.Z)
	end
	local idle = speed < 0.4
	if idle and now > b.nextShift then
		b.nextShift = now + 2.5 + math.noise(now, b.seed + 3) * 2 + 1.5
		b.idleShift = if b.idleShift >= 0 then -1 else 1
	end
	type LimbStep = { f: Foot, home: Vector3, side: number, isHand: boolean }
	local limbs: { LimbStep } = {}
	for _, s in { -1, 1 } do
		table.insert(limbs, { f = b.feet[s], home = home(s), side = s, isHand = false })
	end
	if quad then
		for _, s in { -1, 1 } do
			local A = b.arms[s]
			local sh = rcf:PointToWorldSpace(b.pelvisRest + b.chestM.C0.Position + A.m1.C0.Position)
			local fw = rcf.LookVector * (b.armLen * 0.45 + legLen * 0.2)
			local hh = Vector3.new(sh.X + fw.X, groundY + 0.1, sh.Z + fw.Z)
			local hand = b.hands[s]
			if not hand.planted then
				hand.planted, hand.pos, hand.lifted = true, hh, false
			end
			table.insert(limbs, { f = hand, home = hh, side = s, isHand = true })
		end
	else
		for _, s in { -1, 1 } do
			b.hands[s].planted = false
			b.hands[s].lifted = false
		end
	end
	-- 순간 이동했거나 발이 몸에서 너무 멀어졌으면(끊김·지연) 그 발을 제자리에 다시 딛는다
	for _, l in limbs do
		if teleported or flat(l.f.pos - l.home).Magnitude > legLen * 1.6 then
			l.f.pos, l.f.from, l.f.to, l.f.lifted, l.f.t = l.home, l.home, l.home, false, 0
		end
	end
	local function liftedCount(): number
		local n = 0
		for _, l in limbs do
			if l.f.lifted then
				n += 1
			end
		end
		return n
	end
	-- 떠 있는 발 옮기기(포물선 궤적, 착지하면 충격)
	for _, l in limbs do
		local f = l.f
		if f.lifted then
			f.t += dt / f.dur
			if f.t >= 1 then
				f.lifted = false
				f.pos = f.to
				-- 착지: 질량만큼 골반이 내려앉고(무게), 발소리
				local hit = b.mass * math.clamp(speed / 6, 0.35, 1.6) * (if S.lift > 0.4 then 1.6 else 1)
				if not l.isHand then
					b.pel.v += Vector3.new(0, -1.4 * hit, 0)
					b.chest.v += Vector3.new(0.6 * hit, 0, 0)
					if Anim.onStep then
						Anim.onStep(m, f.pos, hit)
					end
					b.stats.steps += 1
				else
					b.stats.handSteps += 1
				end
			else
				local e = f.t * f.t * (3 - 2 * f.t)
				local p = f.from:Lerp(f.to, e)
				local h = (if l.isHand then legLen * 0.12 else legLen * S.lift) * math.sin(math.pi * f.t)
				f.pos = p + Vector3.new(0, h, 0)
				if not l.isHand then
					b.stats.liftMax = math.max(b.stats.liftMax, h / legLen)
				end
			end
		end
	end
	-- 새로 들 발 고르기: 제자리에서 가장 많이 벗어난 발(두 발을 한꺼번에 들지 않는다. 기어갈 때는 대각선 둘까지)
	if not (jerk and now < b.freezeUntil) then
		local maxLift = if quad then 2 else 1
		local best: LimbStep?, bestErr = nil, 0
		for _, l in limbs do
			if not l.f.lifted then
				local want = l.home + dir * threshold * 0.9
				local err = flat(l.f.pos - want).Magnitude
				local need = if idle then 0.18 * legLen else threshold
				if err > need and err > bestErr then
					-- 같은 쪽(기어갈 때: 같은 쪽 손발)이나 반대 다리가 떠 있으면 기다린다 → 대각선 박자
					local ok = true
					for _, o in limbs do
						if o ~= l and o.f.lifted then
							if quad then
								if (o.isHand == l.isHand) or (o.side == l.side) then
									ok = false
								end
							elseif not o.isHand then
								ok = false
							end
						end
					end
					if ok then
						best, bestErr = l, err
					end
				end
			end
		end
		if best and liftedCount() < maxLift then
			local f = best.f
			local predicted = best.home + vel * stepDur
			local to = if idle then best.home else predicted + dir * threshold * 0.85
			-- 절뚝: 오른 다리는 보폭이 짧다
			if not best.isHand and best.side == 1 and S.limp > 0 then
				to = to:Lerp(best.home + vel * stepDur, S.limp * 0.5)
			end
			f.from, f.to, f.t, f.dur, f.lifted = f.pos, to, 0, stepDur * (if best.isHand then 0.85 else 1), true
		end
	end
	b.gait += speed * dt

	-- ── 골반: 높이(디딘 다리가 닿는 만큼) · 체중 이동 · 회전 ──
	local restH = b.pelvisRest.Y - b.floorY
	local wantH = restH - legLen * S.crouch
	local hipW = b.legs[1].m1.C0.Position.X
	local reachLimit = math.huge
	local planted = 0
	local lateral = 0
	local fwdDiff = 0
	for _, s in { -1, 1 } do
		local f = b.feet[s]
		local fl = rcf:PointToObjectSpace(f.pos)
		fwdDiff += -fl.Z * s
		if not f.lifted then
			planted += 1
			local L = b.legs[s]
			local reach = (L.v1.Magnitude + L.v3.Magnitude) * 0.95
			local hip = b.pelvisRest + L.m1.C0.Position
			local horiz = Vector2.new(fl.X - hip.X, fl.Z - hip.Z).Magnitude
			local maxDrop = math.sqrt(math.max(reach * reach - horiz * horiz, 0.01))
			-- 엉덩이 높이 = 발목 높이 + 닿을 수 있는 수직 거리 → 골반 높이로
			local pelvisH = (f.pos.Y - groundY) + maxDrop + (b.pelvisRest.Y - hip.Y)
			reachLimit = math.min(reachLimit, pelvisH)
			lateral += fl.X
		end
	end
	if planted > 0 then
		lateral /= planted
	end
	if idle then
		lateral = b.idleShift * math.abs(hipW) * 0.6
	end
	local height = math.min(wantH, reachLimit) - restH
	-- 꼭두각시: 줄에 매달린 듯 걸음마다 위로 당겨진다
	if jerk then
		height += legLen * 0.06 * math.abs(math.sin(b.gait / math.max(stride, 0.1) * math.pi))
	end
	local pelTarget = Vector3.new(lateral * 0.55, height, if quad then -legLen * 0.1 else 0)
	if jerk then
		local hk = "pel"
		if now >= (b.held[hk .. "t"] or 0) then
			b.held[hk .. "x"], b.held[hk .. "y"] = pelTarget.X, pelTarget.Y
			b.held[hk .. "t"] = now + 1 / 6
		end
		pelTarget = Vector3.new(b.held[hk .. "x"], b.held[hk .. "y"], pelTarget.Z)
	end
	if jerk and now < b.freezeUntil then
		pelTarget = b.pel.x
	end
	local bodyFreq = 2.2 * tension / math.sqrt(b.mass)
	vstep(b.pel, pelTarget, bodyFreq, 0.45, dt)
	-- 골반 회전: 앞으로 나간 다리 쪽으로 비틀고(yaw), 떠 있는 다리 쪽이 처지고(roll), 숙인 만큼 앞으로(pitch)
	local swingSide = 0
	for _, s in { -1, 1 } do
		if b.feet[s].lifted then
			swingSide = s
		end
	end
	local pelRotT = Vector3.new(S.lean * 0.3 + (if quad then 0.25 else 0), math.clamp(fwdDiff * 0.12, -0.35, 0.35) + yawRate * 0.05, -swingSide * 0.06 * math.clamp(speed / 4, 0, 1))
	vstep(b.pelRot, pelRotT, 2.5 * tension, 0.6, dt)

	-- ── 가슴(척추): 숙임 + 가속에 쏠림 + 골반 반대로 비틂 + 회전 방향으로 먼저 돌고 안쪽으로 기움 + 호흡 + 꿈틀 ──
	local breathe = math.sin(now * TWO_PI * 0.27) * (if idle then 0.035 else 0.012)
	local wave = S.wave * math.sin(b.gait / math.max(stride, 0.1) * math.pi)
	local chestT = Vector3.new(
		S.lean - b.pelRot.x.X + math.clamp(b.accel.Z * -0.025, -0.35, 0.35) + breathe + speed * 0.012,
		math.clamp(-b.pelRot.x.Y * 0.75 + yawRate * 0.05 + wave, -0.35, 0.35),
		-yawRate * math.clamp(speed, 0, 10) * 0.012 + wave * 0.4
	)
	if jerk and now < b.freezeUntil then
		chestT = b.chest.x
	end
	vstep(b.chest, chestT, 1.8 * tension / math.sqrt(b.mass), 0.5, dt)

	-- ── 머리: 바라볼 곳을 늦게 따라가며 몸 흔들림을 상쇄 ──
	local focusP: Vector3? = nil
	local near, nearD = nearestPlayer(pos)
	if state == "Chase" and near then
		focusP = near
	else
		local f = m:GetAttribute("Focus")
		if typeof(f) == "Vector3" and now < b.nextLook then
			focusP = f
		end
	end
	if not focusP and now >= b.nextLook then
		-- 두리번: 가끔 홱 돌리고, 가끔 천천히
		b.nextLook = now + 1.5 + (math.noise(now * 0.3, b.seed) + 0.5) * 3
		b.look = Vector2.new((math.noise(now, b.seed + 9) * 2) * 0.9, math.noise(now, b.seed + 17) * 0.4)
		b.lookFreq = if math.noise(now * 2, b.seed) > 0.2 then 6 else 1.6
	end
	local lookYaw, lookPitch = b.look.X, b.look.Y
	if focusP then
		local d = rrot:VectorToObjectSpace(focusP - (pos + Vector3.new(0, restH * 0.8, 0)))
		lookYaw = math.clamp(math.atan2(-d.X, -d.Z), -1.3, 1.3)
		lookPitch = math.clamp(math.atan2(d.Y, Vector2.new(d.X, d.Z).Magnitude), -0.8, 0.6)
	end
	if not idle and not focusP then
		lookYaw *= 0.3
		lookPitch *= 0.3
	end
	-- 머리 떨림(연속 노이즈: 무작위로 튀지 않는다)
	local tremor = (if state == "Alert" or state == "Chase" then 0.04 else 0.015)
	lookYaw += math.noise(now * 2.3, b.seed + 41) * tremor + yawRate * 0.06
	lookPitch += math.noise(now * 2.1, b.seed + 53) * tremor - S.headDrop
	vstep(b.head, Vector3.new(lookPitch, lookYaw, 0), b.lookFreq * (if jerk then 1.4 else 1), 0.7, dt)
	b.lookFreq = lerp(b.lookFreq, 2.5, math.min(1, dt * 0.5))

	-- ── 덮치기: 쫓다가 가까우면 몸을 낮추고 팔을 뒤로 모았다가(선동작) 붙으면 앞으로 뻗으며 상체를 던진다 ──
	local pounce = 0
	local wind = 0
	if state == "Chase" and near then
		wind = math.clamp((8 - nearD) / 3, 0, 1)
		pounce = math.clamp((5 - nearD) / 1.6, 0, 1)
	end

	-- ── 뼈에 적용 ──
	local pelvisCF = CFrame.new(b.pel.x + Vector3.new(0, -wind * legLen * 0.12 * (1 - pounce), 0)) * CFrame.fromEulerAnglesYXZ(b.pelRot.x.X + pounce * 0.3, b.pelRot.x.Y, b.pelRot.x.Z)
	-- 디딘 다리가 발에 닿지 않으면(돌진·숙임으로 골반이 높을 때) 골반을 그만큼 바로 내린다 → 발은 끝까지 그 자리
	do
		local wp = rcf * CFrame.new(b.pelvisRest) * pelvisCF
		local drop = 0
		for _, s in { -1, 1 } do
			local f = b.feet[s]
			if not f.lifted then
				local L = b.legs[s]
				local H = (wp * CFrame.new(L.m1.C0.Position)).Position
				local R = (L.v1.Magnitude + L.v3.Magnitude) * 0.995
				local horiz = flat(H - f.pos).Magnitude
				if horiz < R then
					drop = math.max(drop, (H.Y - f.pos.Y) - math.sqrt(R * R - horiz * horiz))
				end
			end
		end
		if drop > 0 then
			pelvisCF = CFrame.new(0, -drop, 0) * pelvisCF
			b.pel.x -= Vector3.new(0, drop, 0)
		end
	end
	b.pelvisM.Transform = pelvisCF
	local chestRot = CFrame.fromEulerAnglesYXZ(b.chest.x.X + pounce * 0.5 - wind * 0.2 * (1 - pounce), b.chest.x.Y, b.chest.x.Z)
	b.chestM.Transform = chestRot
	local wPelvis = rcf * CFrame.new(b.pelvisRest) * pelvisCF
	local wChest = wPelvis * CFrame.new(b.chestM.C0.Position) * chestRot
	-- 목·머리: 원하는 머리 월드 방향 = 몸 방향 + 바라봄. 가슴 회전을 빼서 목과 머리가 반씩 나눈다
	local headWorld = rrot * CFrame.fromEulerAnglesYXZ(b.head.x.X + pounce * -0.3, b.head.x.Y, 0)
	local rel = wChest.Rotation:Inverse() * headWorld
	local rx, ry, rz = rel:ToEulerAnglesYXZ()
	rx, ry, rz = math.clamp(rx, -1.1, 0.9), math.clamp(ry, -1.4, 1.4), math.clamp(rz, -0.5, 0.5)
	local half = CFrame.fromEulerAnglesYXZ(rx * 0.5, ry * 0.5, rz * 0.5)
	b.neckM.Transform = half
	b.headM.Transform = half
	b.stats.headLag = math.max(b.stats.headLag, math.abs(b.head.v.Y))

	-- 다리 IK(발은 월드에 고정)
	local function solveLeg(s: number)
		local L = b.legs[s]
		local f = b.feet[s]
		local H = (wPelvis * CFrame.new(L.m1.C0.Position)).Position
		local l1, l2 = L.v1.Magnitude, L.v3.Magnitude
		local pole = wPelvis.Rotation * L.pole
		local K, A = solve2(H, f.pos, l1, l2, pole)
		local pr = wPelvis.Rotation
		local t1 = fromTo(L.v1.Unit, pr:VectorToObjectSpace((K - H).Unit))
		L.m1.Transform = t1
		local r1 = pr * t1
		local t2 = fromTo(L.v3.Unit, r1:VectorToObjectSpace((A - K).Unit))
		L.m2.Transform = t2
		local r2 = r1 * t2
		-- 발: 땅에 평평하게(들 때는 발끝이 아래로)
		local footPitch = if f.lifted then -0.5 * math.sin(math.pi * f.t) else 0
		L.mEnd.Transform = r2:Inverse() * rrot * CFrame.Angles(footPitch, 0, 0)
		-- 발가락(발볼 관절): 디딜 땐 바닥에 평평, 발을 떼면 밑으로 접히고, 내딛기 직전엔 살짝 들렸다가 펴지며 닿는다
		if L.mToe then
			local toe = 0
			if f.lifted then
				local t = f.t
				toe = if t < 0.7 then -0.7 * math.sin(math.pi * 0.5 * math.min(t / 0.35, 1)) * (1 - math.max(0, t - 0.35) / 0.35) else 0.3 * math.sin(math.pi * (t - 0.7) / 0.3)
			end
			L.mToe.Transform = CFrame.Angles(toe, 0, 0)
		end
		-- (테스트) 디딘 발이 목표에서 얼마나 떨어졌나(미끄러짐)
		if not f.lifted then
			b.stats.slip = math.max(b.stats.slip, (A - f.pos).Magnitude)
		end
	end
	solveLeg(-1)
	solveLeg(1)

	-- 팔
	for _, s in { -1, 1 } do
		local A = b.arms[s]
		local st2 = b.armS[s]
		local shoulderW = wChest * CFrame.new(A.m1.C0.Position)
		local hand = b.hands[s]
		if quad and hand.planted then
			-- 기어갈 때: 손을 땅에 짚는다(위팔+가운데 마디를 한 마디로, 아래팔을 한 마디로 IK)
			local v12 = A.v1 + (A.v2 or Vector3.zero)
			local l1, l2 = v12.Magnitude, A.v3.Magnitude
			local H = shoulderW.Position
			local K, P = solve2(H, hand.pos, l1, l2, wChest.Rotation * (Vector3.zAxis * 0.6 + Vector3.xAxis * s * 0.4))
			local cr = wChest.Rotation
			local t1 = fromTo(v12.Unit, cr:VectorToObjectSpace((K - H).Unit))
			A.m1.Transform = t1
			local r = cr * t1
			if A.m3 then
				A.m2.Transform = CFrame.identity
				local t3 = fromTo(A.v3.Unit, r:VectorToObjectSpace((P - K).Unit))
				A.m3.Transform = t3
				r = r * t3
			else
				local t3 = fromTo(A.v3.Unit, r:VectorToObjectSpace((P - K).Unit))
				A.m2.Transform = t3
				r = r * t3
			end
			A.mEnd.Transform = r:Inverse() * rrot * CFrame.Angles(-0.3, 0, 0)
			-- 진자 상태를 지금 자세에 맞춰 둔다(손을 뗄 때 튀지 않게)
			st2.pitch.x, st2.pitch.v = lerp(st2.pitch.x, S.armBase, 0.1), 0
		else
			-- 진자: 다리 반대 박자로 흔들리고(반대쪽 발이 앞이면 앞으로), 몸 가속에 늦게 따라오고, 길수록 느리다
			local f1 = rcf:PointToObjectSpace(b.feet[-s].pos)
			local f2 = rcf:PointToObjectSpace(b.feet[s].pos)
			local legSwing = math.clamp((f2.Z - f1.Z) / math.max(stride, 0.5), -1, 1)
			local target = S.armBase + S.armSwing * legSwing * math.clamp(speed / 3, 0, 1)
			target += wind * -0.9 * (1 - pounce) + pounce * 1.6
			local freq = math.sqrt(GRAVITY / math.max(b.armLen, 0.5)) / TWO_PI * 0.55 * tension
			local pd = st2.pitch
			step(pd, target, freq, 0.32, dt)
			-- 관성: 몸이 앞으로 가속하면 팔은 뒤로 처진다. 골반이 오르내리면 휘둘린다
			pd.v += (b.accel.Z * 0.04 - b.pel.v.Y * 0.25 * S.flail) * dt * 6 / math.max(b.armLen / 3, 0.5)
			local rd = st2.roll
			step(rd, S.armSpread + wind * 0.25 + math.abs(yawRate) * 0.05 * s * (if yawRate * s > 0 then 1 else -0.5), freq * 1.1, 0.4, dt)
			rd.v += b.accel.X * 0.03 * s * dt * 6
			local up = CFrame.fromEulerAnglesYXZ(pd.x, 0, rd.x * s)
			A.m1.Transform = up
			-- 아래 마디: 위 마디가 움직이는 속도의 반대로 한 박자 늦게(채찍처럼) + 들어 올린 팔의 아래 마디는 중력으로 처짐
			local droop = -math.max(pd.x - 1.2, 0) * 0.35
			step(st2.c1, -pd.v * 0.06 + droop + pounce * -0.3, freq * 1.6, 0.35, dt)
			step(st2.c2, -st2.c1.v * 0.05 + droop * 0.6 + 0.08, freq * 2.2, 0.35, dt)
			step(st2.c3, -st2.c2.v * 0.04 + 0.1 + math.noise(now * 3, b.seed + s) * 0.06, freq * 3, 0.4, dt)
			if A.m3 then
				A.m2.Transform = CFrame.Angles(st2.c1.x, 0, 0)
				A.m3.Transform = CFrame.Angles(st2.c2.x, 0, 0)
			else
				A.m2.Transform = CFrame.Angles(st2.c1.x + st2.c2.x, 0, 0)
			end
			A.mEnd.Transform = CFrame.Angles(st2.c3.x, 0, 0)
		end
	end

	-- (테스트) 측정
	local st3 = b.stats
	st3.frames += 1
	st3.pelvisMin = math.min(st3.pelvisMin, b.pel.x.Y)
	st3.pelvisMax = math.max(st3.pelvisMax, b.pel.x.Y)
	st3.chestYawMax = math.max(st3.chestYawMax, math.abs(b.chest.x.Y))
	st3.leanMax = math.max(st3.leanMax, b.chest.x.X + b.pelRot.x.X)
	st3.armMax = math.max(st3.armMax, b.armS[-1].pitch.x, b.armS[1].pitch.x)
end

Anim.range = 170 -- 이 거리 안의 괴물만 움직임을 계산한다(테스트는 전부)
local function animated(m: Model): boolean
	if m:GetAttribute("Rig") ~= 2 then
		return false
	end
	local f = m:GetAttribute("Form")
	return f ~= "Disguise" and f ~= "Bursting"
end

-- LOD: 음파에 드러난(또는 곧 드러날) 괴물과 가까운 괴물은 매 프레임, 드러나지 않은(투명한) 먼 괴물은 2·4프레임에 한 번
-- (건너뛴 시간을 모아서 계산하므로 걸음·속도·발 위치는 그대로. 발소리는 드러난 동안만 들리므로 그때는 늘 매 프레임)
Anim.lodNear = 40 -- 이 거리 안은 매 프레임
Anim.lodMid = 90 -- 이 거리 안은 2프레임에 한 번, 그 밖(~range)은 4프레임에 한 번
Anim.lod = true
local Reveal = require(script.Parent:WaitForChild("Reveal"))
-- 괴물 목록(태그 신호로 유지: 매 프레임 GetTagged 배열을 새로 만들지 않는다)
local tagged: { [Model]: boolean } = {}
for _, inst in CollectionService:GetTagged(Config.Tags.Monster) do
	if inst:IsA("Model") then
		tagged[inst] = true
	end
end
CollectionService:GetInstanceAddedSignal(Config.Tags.Monster):Connect(function(inst)
	if inst:IsA("Model") then
		tagged[inst] = true
	end
end)
CollectionService:GetInstanceRemovedSignal(Config.Tags.Monster):Connect(function(inst)
	tagged[inst :: Model] = nil
end)
local Perf = require(script.Parent:WaitForChild("Perf"))
RunService.RenderStepped:Connect(function(dt)
	local t0 = os.clock()
	dt = math.min(dt, 1 / 20)
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	local nUpd = 0
	for m in tagged do
		if m.Parent and animated(m) then
			local b = bodies[m]
			local root = m.PrimaryPart
			local d = if root then (root.Position - camPos).Magnitude else math.huge
			if root and d < Anim.range then
				if not b or b.root ~= root or not b.pelvisM.Parent then
					b = build(m)
					bodies[m] = b
				end
				if b then
					local every = if not Anim.lod or d < Anim.lodNear or Reveal.has(m) then 1 elseif d < Anim.lodMid then 2 else 4
					b.lodAcc += dt
					b.lodSkip += 1
					if b.lodSkip >= every then
						update(b, math.min(b.lodAcc, 0.1))
						b.lodAcc = 0
						b.lodSkip = 0
						nUpd += 1
					end
				end
			end
		end
	end
	Perf.count("monsterAnimUpdates", nUpd)
	for m in bodies do
		if not m.Parent then
			bodies[m] = nil
			Anim.stats[m] = nil
		end
	end
	Perf.add("monsterAnim", os.clock() - t0)
end)

-- (테스트) 측정값 요약: 움직인 괴물들 중 최대 미끄러짐, 걸음 수, 골반 오르내림 폭 등
function Anim.summary(): { [string]: number }
	local out = { bodies = 0, steps = 0, slip = 0, pelvisRange = 0, chestYaw = 0, headLag = 0, lean = 0, arm = 0, lift = 0, freezes = 0, handSteps = 0 }
	for _, st in Anim.stats do
		out.bodies += 1
		out.steps += st.steps
		out.slip = math.max(out.slip, st.slip)
		if st.pelvisMax > st.pelvisMin then
			out.pelvisRange = math.max(out.pelvisRange, st.pelvisMax - st.pelvisMin)
		end
		out.chestYaw = math.max(out.chestYaw, st.chestYawMax)
		out.headLag = math.max(out.headLag, st.headLag)
		out.lean = math.max(out.lean, st.leanMax)
		out.arm = math.max(out.arm, st.armMax)
		out.lift = math.max(out.lift, st.liftMax)
		out.freezes += st.freezes
		out.handSteps += st.handSteps
	end
	return out
end
function Anim.reset()
	for _, st in Anim.stats do
		st.steps, st.slip, st.pelvisMin, st.pelvisMax, st.chestYawMax, st.headLag, st.frames = 0, 0, math.huge, -math.huge, 0, 0, 0
		st.leanMax, st.armMax, st.liftMax, st.freezes, st.handSteps = 0, -math.huge, 0, 0, 0
	end
end

return Anim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="292">
        <Properties>
          <string name="Name">Movement</string>
          <string name="Source"><![CDATA[--!strict
-- 이동(걷기/달리기/웅크리기)과 1인칭 카메라 효과(아주 약한 헤드밥, 웅크릴 때 시점 낮춤, 추격 중 미세한 긴장감).
-- Shift = 달리기, Ctrl = 웅크리기(누르고 있는 동안). 둘을 동시에 누르면 웅크리기.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage.Shared.Config)
local MobileUI = require(script.Parent:WaitForChild("MobileUI")) -- (휴대폰 화면 버튼: 달리기·웅크리기)

local MV = Config.Move
local SetMoveMode = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SetMoveMode") :: RemoteEvent

local Movement = {}
Movement.mode = "Walk"
Movement.forced = nil :: string?
local sentMode = ""
local bobPhase = 0
local crouchDrop = 0
local tension = 0

local SPEED = { Walk = MV.Walk, Run = MV.Run, Crouch = MV.Crouch }

local function wantedMode(): string
	if Movement.forced then
		return Movement.forced
	end
	if UserInputService:GetFocusedTextBox() then
		return "Walk"
	end
	local crouch = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) or MobileUI.crouch
	if crouch then
		return "Crouch"
	end
	local run = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) or MobileUI.run
	if run then
		return "Run"
	end
	return "Walk"
end

function Movement.update(dt: number)
	local player = Players.LocalPlayer
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local cam = workspace.CurrentCamera
	if not hum or not root or player:GetAttribute("Status") ~= "Alive" then
		if cam and cam.FieldOfView ~= 70 then
			cam.FieldOfView = 70
		end
		return
	end
	local mode = wantedMode()
	Movement.mode = mode
	hum.WalkSpeed = SPEED[mode]
	if mode ~= sentMode then
		sentMode = mode
		SetMoveMode:FireServer(mode)
	end

	-- 시점: 웅크리기 높이 + 헤드밥
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local targetDrop = if mode == "Crouch" then MV.CrouchCameraDrop else 0
	crouchDrop += (targetDrop - crouchDrop) * math.min(1, dt * 10)
	local amp = if mode == "Run" then MV.BobRun elseif mode == "Crouch" then MV.BobCrouch else MV.BobWalk
	local moving = math.clamp(speed / math.max(1, SPEED[mode]), 0, 1)
	bobPhase += dt * (speed * 0.75 + 0.01)
	local bobY = math.sin(bobPhase * 2) * amp * moving
	local bobX = math.cos(bobPhase) * amp * 0.5 * moving
	hum.CameraOffset = Vector3.new(bobX, bobY - crouchDrop, 0)

	-- 추격 긴장감: 가까운 괴물이 추격 상태면 시야각이 아주 조금 좁아졌다 넓어졌다 한다(위치는 알려 주지 않음)
	local chased = false
	for _, m in CollectionService:GetTagged(Config.Tags.Monster) do
		if m:IsA("Model") and m:GetAttribute("State") == "Chase" and m.PrimaryPart then
			if (m.PrimaryPart.Position - root.Position).Magnitude < 40 then
				chased = true
			end
		end
	end
	tension += ((if chased then 1 else 0) - tension) * math.min(1, dt * 2)
	if cam then
		cam.FieldOfView = 70 - tension * (2 + math.sin(os.clock() * 7) * 0.6)
	end
end

function Movement.reset()
	sentMode = ""
	crouchDrop = 0
	tension = 0
end

return Movement
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="293">
        <Properties>
          <string name="Name">NetStat</string>
          <string name="Source"><![CDATA[--!strict
-- (측정) 리모트 송수신·속성 복제 횟수와 소리 통계. 비용은 표 덧셈 한 번. 자동 테스트(TestProbe "netaudio")가 읽고 비운다.

local NetStat = {}

NetStat.counts = {} :: { [string]: number }
NetStat.t0 = os.clock()

function NetStat.count(name: string, n: number?)
	NetStat.counts[name] = (NetStat.counts[name] or 0) + (n or 1)
end

function NetStat.snapshot(reset: boolean?): { [string]: any }
	local out = { seconds = os.clock() - NetStat.t0, counts = table.clone(NetStat.counts) }
	if reset then
		table.clear(NetStat.counts)
		NetStat.t0 = os.clock()
	end
	return out
end

return NetStat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="294">
        <Properties>
          <string name="Name">Perf</string>
          <string name="Source"><![CDATA[--!strict
-- 성능 측정(클라이언트). 시스템마다 걸린 CPU 시간(os.clock)을 모으고, 프레임 시간 표본을 남긴다.
-- 비용: 한 번에 os.clock 두 번 + 표 덧셈 — 게임에는 영향이 없을 만큼 작다. 자동 테스트(TestProbe "perfx")가 읽는다.
-- MicroProfiler 에서도 같은 이름으로 보이게 debug.profilebegin/profileend 를 함께 건다.

local Perf = {}

local acc: { [string]: number } = {} -- 이름 → 누적 초
local cnt: { [string]: number } = {} -- 이름 → 호출 수
local worst: { [string]: number } = {} -- 이름 → 한 번에 가장 오래 걸린 초
Perf.frames = {} :: { number } -- 프레임 시간(dt) 표본
Perf.lua = {} :: { number } -- 프레임마다 음파·이동 스크립트 시간
Perf.counters = {} :: { [string]: number } -- 받은 이벤트 수 등
local MAX = 6000

function Perf.add(name: string, dt: number)
	acc[name] = (acc[name] or 0) + dt
	cnt[name] = (cnt[name] or 0) + 1
	if dt > (worst[name] or 0) then
		worst[name] = dt
	end
end

function Perf.count(name: string, n: number?)
	Perf.counters[name] = (Perf.counters[name] or 0) + (n or 1)
end

-- f 를 재면서 부른다(MicroProfiler 이름 = name)
function Perf.wrap<A..., R...>(name: string, f: (A...) -> R...): (A...) -> R...
	return function(...: A...): R...
		debug.profilebegin(name)
		local t = os.clock()
		local function finish(...: R...): R...
			Perf.add(name, os.clock() - t)
			debug.profileend()
			return ...
		end
		return finish(f(...))
	end
end

function Perf.frame(dt: number, luaSec: number)
	local f = Perf.frames
	if #f < MAX then
		table.insert(f, dt)
		table.insert(Perf.lua, luaSec)
	end
end

function Perf.reset()
	table.clear(acc)
	table.clear(cnt)
	table.clear(worst)
	table.clear(Perf.frames)
	table.clear(Perf.lua)
	table.clear(Perf.counters)
end

local function pct(sorted: { number }, q: number): number
	if #sorted == 0 then
		return 0
	end
	return sorted[math.clamp(math.ceil(#sorted * q), 1, #sorted)]
end

-- 요약: 프레임 시간 분포(ms), FPS 평균·1% low, 시스템별 프레임당 평균 ms·최악 ms
function Perf.summary(): { [string]: any }
	local f = table.clone(Perf.frames)
	table.sort(f)
	local sum = 0
	for _, v in f do
		sum += v
	end
	local n = #f
	local avg = if n > 0 then sum / n else 0
	-- 1% low = 가장 느린 1% 프레임의 평균 FPS
	local k = math.max(1, math.floor(n * 0.01))
	local slow = 0
	for i = math.max(1, n - k + 1), n do
		slow += f[i]
	end
	local l = table.clone(Perf.lua)
	table.sort(l)
	local lsum = 0
	for _, v in l do
		lsum += v
	end
	local sys = {}
	for name, a in acc do
		sys[name] = {
			perFrameMs = if n > 0 then a / n * 1000 else 0,
			calls = cnt[name],
			avgMs = a / math.max(1, cnt[name]) * 1000,
			worstMs = (worst[name] or 0) * 1000,
		}
	end
	return {
		frames = n,
		avgMs = avg * 1000,
		fps = if avg > 0 then 1 / avg else 0,
		low1Fps = if n > 0 and slow > 0 then 1 / (slow / math.min(k, n)) else 0,
		p95Ms = pct(f, 0.95) * 1000,
		p99Ms = pct(f, 0.99) * 1000,
		worstMs = (f[n] or 0) * 1000,
		luaAvgMs = if #l > 0 then lsum / #l * 1000 else 0,
		luaP95Ms = pct(l, 0.95) * 1000,
		luaP99Ms = pct(l, 0.99) * 1000,
		luaWorstMs = (l[#l] or 0) * 1000,
		sys = sys,
		counters = table.clone(Perf.counters),
	}
end

return Perf
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="295">
        <Properties>
          <string name="Name">RbxCharacterSounds</string>
          <string name="Source"><![CDATA[-- 기본 캐릭터 소리(RbxCharacterSounds)를 대체한다: 같은 이름의 빈 스크립트를 두면 Roblox 기본 발소리가 꺼진다.
-- 발소리는 Audio 모듈이 이동 모드(걷기/달리기/웅크리기)에 맞춰 직접 재생한다.
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="296">
        <Properties>
          <string name="Name">Reveal</string>
          <string name="Source"><![CDATA[--!strict
-- 음파에 맞은 괴물은 10초 동안(Config.Sonar.MonsterRevealSeconds) 지금 모습 그대로(움직이는 그대로) 보인다.
-- 잔상(그 순간 모습으로 굳은 음파 선)이 아니라 실제 몸을 켜 둔다. 이 클라이언트에서만, 팀원 음파도 포함. 다시 맞으면 10초가 다시 시작.
--  · 음파 반경 안, 벽 1장 이하면 맞은 것(괴물 소리 판정과 같은 기준)
--  · 메인 괴물·도플갱어 괴물: 몸의 선(원통)을 흰 네온으로
--  · 도플갱어 사람 모습: 진짜 아바타면 팀원처럼 윤곽선(Highlight), 상자 몸이면 상자 윤곽선(SelectionBox)
--  · 보이는 동안 음파는 그 괴물의 굳은 선(잔상)을 따로 그리지 않는다(SonarWorld.skipMonster)

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)

local Reveal = {}
local S = Config.Sonar
local TAGS = Config.Tags
local SECONDS = (S :: any).MonsterRevealSeconds or 10

type Entry = { from: number, to: number, parts: { BasePart }, boxes: { SelectionBox }, hl: Highlight?, ver: number, on: boolean, dark: boolean? }
local revealed: { [Model]: Entry } = {}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.RespectCanCollide = true -- (서버 괴물 소리 판정과 같게: 부딪히지 않는 장식은 벽으로 세지 않는다)
local function wallsBetween(a: Vector3, b: Vector3): number
	local stage = workspace:FindFirstChild("Stage")
	if not stage then
		return 0
	end
	rayParams.FilterDescendantsInstances = { stage }
	local n = 0
	local from = a
	for _ = 1, 3 do
		local dir = b - from
		if dir.Magnitude < 0.5 then
			break
		end
		local hit = workspace:Raycast(from, dir, rayParams)
		if not hit then
			break
		end
		n += 1
		from = hit.Position + dir.Unit * 0.6
		if (b - from):Dot(b - a) <= 0 then
			break
		end
	end
	return n
end

-- 진짜 아바타를 입은 사람 모습 도플갱어: 늘 보인다(Mates 가 팀원처럼 윤곽선). 음파로 따로 드러낼 필요가 없다
function Reveal.disguised(m: Model): boolean
	return m:GetAttribute("Form") == "Disguise" and m:GetAttribute("AvatarOf") ~= nil
end

function Reveal.onPulse(origin: Vector3)
	local now = os.clock()
	for _, inst in CollectionService:GetTagged(TAGS.Monster) do
		local m = inst :: Model
		if m:IsA("Model") and m.PrimaryPart and not Reveal.disguised(m) then
			local p = m.PrimaryPart.Position
			local d = (p - origin).Magnitude
			if d <= S.Radius + 3 and wallsBetween(origin, p) <= 1 then
				local from = now + math.min(1, d / 60) -- 파동이 닿을 즈음부터
				local e = revealed[m]
				if e then
					e.from = math.min(e.from, from)
					e.to = math.max(e.to, from + SECONDS)
				else
					revealed[m] = { from = from, to = from + SECONDS, parts = {}, boxes = {}, hl = nil, ver = -1, on = false }
				end
			end
		end
	end
end

-- 음파가 이 괴물의 굳은 선(잔상)을 그리지 않아도 되는가(지금 보이는 중이거나 곧 보일 것)
-- 지금 음파에 걸려 있는가(파동이 닿은 뒤 ~ 10초): 이 동안만 그 괴물 발소리가 들린다
function Reveal.active(m: Model): boolean
	local e = revealed[m]
	if not e then
		return false
	end
	local now = os.clock()
	return now >= e.from and now <= e.to
end

function Reveal.has(m: Model): boolean
	return revealed[m] ~= nil
end

local LINE = Color3.new(S.LineColor.R * S.BaseLevel, S.LineColor.G * S.BaseLevel, S.LineColor.B * S.BaseLevel)

local function show(e: Entry, on: boolean)
	if e.on == on then
		return
	end
	e.on = on
	for _, p in e.parts do
		if p.Parent and p.Name ~= "Eye" then -- (도플갱어 눈은 DoppelFx 가 따로 빛나게 한다)
			if on and e.dark then
				-- 3D 시안 괴물: 메시 정점 색(검은 몸 + 시안 흰 선)을 괴물 몸에 붙은 빛으로 비추고 + 흰 윤곽선(Highlight)
				p.Material = Enum.Material.SmoothPlastic
				p.Color = Color3.new(1, 1, 1)
				p.Transparency = 0
			elseif on then
				p.Material = Enum.Material.Neon
				p.Color = LINE
				p.Transparency = 0
			else
				p.Transparency = 1
			end
		end
	end
	for _, b in e.boxes do
		b.Visible = on
	end
	if e.hl then
		e.hl.Enabled = on
		local adorn = e.hl.Adornee
		local root = if adorn and adorn:IsA("Model") then adorn.PrimaryPart else nil
		local light = root and root:FindFirstChild("RevealLight") :: PointLight?
		if light then
			light.Enabled = on
		end
	end
end

local function release(e: Entry)
	show(e, false)
	for _, b in e.boxes do
		b:Destroy()
	end
	if e.hl then
		e.hl:Destroy()
	end
	table.clear(e.parts)
	table.clear(e.boxes)
	e.hl = nil
end

local function collect(m: Model, e: Entry)
	local wasOn = e.on
	release(e)
	local avatar = m:GetAttribute("Form") == "Disguise" and m:GetAttribute("AvatarOf") ~= nil
	if avatar then
		-- 진짜 아바타 모습: 몸을 보이게 하고 팀원과 같은 흰 윤곽선
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
				local top: Instance? = d
				while top and top.Parent ~= m do
					top = top.Parent
				end
				if top and top:GetAttribute("DisguisePart") then
					table.insert(e.parts, d)
				end
			end
		end
		local hl = Instance.new("Highlight")
		hl.Name = "RevealOutline"
		hl.Adornee = m
		hl.FillTransparency = 1
		hl.OutlineColor = Color3.new(1, 1, 1)
		hl.OutlineTransparency = 0.3
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Enabled = false
		hl.Parent = m
		e.hl = hl
	elseif m:GetAttribute("Rig") == 4 and m:FindFirstChild("Mesh") then
		e.dark = true
		for _, d in (m:FindFirstChild("Mesh") :: Instance):GetDescendants() do
			if d:IsA("MeshPart") then
				table.insert(e.parts, d)
			end
		end
		local hl = Instance.new("Highlight")
		hl.Name = "RevealOutline"
		hl.Adornee = m
		hl.FillTransparency = 1
		hl.OutlineColor = Color3.new(1, 1, 1)
		hl.OutlineTransparency = 0.05
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Enabled = false
		hl.Parent = m
		e.hl = hl
		-- 맵은 캄캄하다(Lighting 0): 괴물 몸만 비추는 빛(맵 벽은 투명이라 비춰지지 않는다)
		local root = m.PrimaryPart
		if root and not root:FindFirstChild("RevealLight") then
			local size = m:GetExtentsSize()
			local light = Instance.new("PointLight")
			light.Name = "RevealLight"
			light.Range = math.clamp(math.max(size.X, size.Y, size.Z) * 1.2, 8, 30)
			light.Brightness = 3
			light.Shadows = false
			light.Enabled = false
			light.Parent = root
		end
	else
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") and CollectionService:HasTag(d, TAGS.Renderable) then
				if d.Shape == Enum.PartType.Cylinder then
					table.insert(e.parts, d)
				else
					local sb = Instance.new("SelectionBox")
					sb.Name = "RevealBox"
					sb.Adornee = d
					sb.Color3 = Color3.new(1, 1, 1)
					sb.LineThickness = 0.04
					sb.SurfaceTransparency = 1
					sb.Transparency = 1 - S.BaseLevel
					sb.Visible = false
					sb.Parent = d
					table.insert(e.boxes, sb)
				end
			end
		end
	end
	e.ver = (m:GetAttribute("BodyVersion") :: number?) or 0
	e.on = false
	if wasOn then
		show(e, true)
	end
end

-- (테스트) 지금 보이는 괴물 수
function Reveal.count(): number
	local n = 0
	for m, e in revealed do
		if e.on and m.Parent then
			n += 1
		end
	end
	return n
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.05 then
		return
	end
	acc = 0
	local now = os.clock()
	for m, e in revealed do
		if not m.Parent or now > e.to then
			release(e)
			revealed[m] = nil
			continue
		end
		local ver = (m:GetAttribute("BodyVersion") :: number?) or 0
		if ver ~= e.ver then
			collect(m, e) -- (도플갱어가 옷을 갈아입거나 변신하거나 입을 벌리면 다시 모은다)
		end
		if now >= e.from then
			show(e, true)
		end
	end
end)

function Reveal.clear()
	for m, e in revealed do
		release(e)
		revealed[m] = nil
	end
end

return Reveal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="297">
        <Properties>
          <string name="Name">RigAnim</string>
          <string name="Source"><![CDATA[--!strict
-- 3D 챕터 괴물(Rig = 4, 메시 있음): 시안 조각 몸을 그대로 옮긴 뼈 메시의 뼈(B1..Bn)를 디자인 자세 프레임으로 움직인다.
--  · 걷기 8장 / 추격 8장(실제 이동 거리로 위상 → 미끄러지지 않음), 서 있으면 걷기 0, 쫓다가 바로 앞이면 덮침
--  · 프레임 사이·자세 사이는 부드럽게 섞는다(사원수 nlerp + 이동 lerp). 반 주기마다 걸음 소리(onStep)
-- 데이터: Shared/CreatureRigs/<id> (art/creatures/source/game/rig.js 가 만든다)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RigAnim = {}
RigAnim.onStep = nil :: ((Model, Vector3, number) -> ())?
RigAnim.stats = {} :: { [string]: { frames: number, steps: number, bones: number, err: string?, chaseMax: number? } }

-- 지금 음파에 드러나 있는가(Main 이 Reveal.active 로 채운다). 보이지 않는 동안에는 걸음 박자만 세고 뼈는 움직이지 않는다
RigAnim.visible = nil :: ((Model) -> boolean)?

type Body = {
	model: Model,
	root: BasePart,
	R: any,
	bones: { Bone },
	hip: number,
	phase: number,
	moveW: number,
	tick: number?,
	chaseW: number,
	attackW: number,
	stat: { frames: number, steps: number, bones: number, err: string?, chaseMax: number? },
}
local bodies: { [Model]: Body } = {}

local function rigData(id: string): any
	local folder = ReplicatedStorage.Shared:FindFirstChild("CreatureRigs")
	local ms = folder and folder:FindFirstChild(id)
	return if ms and ms:IsA("ModuleScript") then require(ms) :: any else nil
end

local function build(model: Model): Body?
	local root = model.PrimaryPart
	local id = model:GetAttribute("Creature")
	if not root or typeof(id) ~= "string" then
		return nil
	end
	local R = rigData(id)
	if not R then
		return nil
	end
	local bones: { Bone } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Bone") then
			local k = tonumber(string.match(d.Name, "^B(%d+)$"))
			if k then
				bones[k] = d
			end
		end
	end
	-- (웨이트가 없는 뼈는 로블록스가 가져올 때 빼므로 개수가 적을 수 있다: 있는 뼈만 움직인다)
	local n = 0
	for _ in bones do
		n += 1
	end
	if n == 0 then
		return nil -- (아직 복제되지 않음)
	end
	RigAnim.stats[id] = RigAnim.stats[id] or { frames = 0, steps = 0, bones = n }
	return {
		model = model,
		root = root,
		R = R,
		bones = bones,
		hip = (model:GetAttribute("Hip") :: number?) or 2,
		phase = math.random(),
		moveW = 0,
		chaseW = 0,
		attackW = 0,
		stat = RigAnim.stats[id],
	}
end

local function approach(cur: number, target: number, rate: number, dt: number): number
	return cur + (target - cur) * (1 - math.exp(-rate * dt))
end

-- 두 프레임(뼈 하나: qx,qy,qz,qw,tx,ty,tz)을 t 로 섞는다
local function mix(a: { number }, b: { number }, t: number, out: { number })
	local d = a[1] * b[1] + a[2] * b[2] + a[3] * b[3] + a[4] * b[4]
	local s = if d < 0 then -1 else 1
	for k = 1, 4 do
		out[k] = a[k] + (b[k] * s - a[k]) * t
	end
	for k = 5, 7 do
		out[k] = a[k] + (b[k] - a[k]) * t
	end
end
local REST = { 0, 0, 0, 1, 0, 0, 0 }
local A, B, C, D = table.create(7, 0), table.create(7, 0), table.create(7, 0), table.create(7, 0)

local function update(b: Body, dt: number)
	local R = b.R
	local v = b.root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local state = b.model:GetAttribute("State")
	local chasing = state == "Chase"
	local frozen = b.model:GetAttribute("Frozen") == true
	local near = math.huge
	local me = Players.LocalPlayer.Character
	local hrp = me and me:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		near = (hrp.Position - b.root.Position).Magnitude
	end
	b.moveW = approach(b.moveW, if frozen then 0 else math.clamp(speed / 2.5, 0, 1), 8, dt)
	b.chaseW = approach(b.chaseW, if chasing then 1 else 0, 3, dt)
	b.attackW = approach(b.attackW, if chasing and near < 6 then 1 else 0, 6, dt)
	b.stat.chaseMax = math.max(b.stat.chaseMax or 0, b.chaseW)
	local before = b.phase
	if not frozen then
		b.phase = (b.phase + speed * dt / (R.stride * 2)) % 1
	end
	if speed > 0.5 and not frozen and ((before < 0.5 and b.phase >= 0.5) or b.phase < before) then
		b.stat.steps += 1
		if RigAnim.onStep then
			RigAnim.onStep(b.model, b.root.Position + Vector3.new(0, -(b.hip + 1), 0), math.clamp(speed / 10, 0.3, 1.4))
		end
	end
	local vis = RigAnim.visible
	if vis and not vis(b.model) then
		return -- (몸이 투명하다: 걸음 소리 박자와 섞기 비율만 이어 간다 → 드러나는 순간 자세가 튀지 않는다)
	end
	-- 거리별 갱신 간격(멀면 뼈를 덜 자주): 가까이 매 프레임, 35 스터드 밖 2프레임, 70 밖 3프레임, 140 밖 멈춤
	local cam = workspace.CurrentCamera
	local dist = if cam then (cam.CFrame.Position - b.root.Position).Magnitude else 0
	local every = if dist > 140 then 0 elseif dist > 70 then 3 elseif dist > 35 then 2 else 1
	if every == 0 then
		return
	end
	b.tick = ((b.tick or 0) + 1) % every
	if b.tick ~= 0 then
		return
	end
	local n = #R.walk
	local f = b.phase * n
	local i0 = math.floor(f) % n + 1
	local i1 = i0 % n + 1
	local t = f - math.floor(f)
	local mw, cw, aw = b.moveW, b.chaseW, b.attackW
	-- 섞는 비율이 0·1 에 가까우면 그 섞기는 건너뛴다(대부분의 프레임: 걷기만, 또는 추격만)
	local E = 0.01
	local useW, useC = cw < 1 - E, cw > E
	local still = mw < 1 - E
	local WC, CC, WS, CS = R.walk, R.chase, R.walk[1], R.chase[1]
	for k, bone in pairs(b.bones) do
		local P: { number }
		if useW and useC then
			mix(WC[i0][k], WC[i1][k], t, A)
			mix(CC[i0][k], CC[i1][k], t, B)
			mix(A, B, cw, C)
			P = C
		elseif useC then
			mix(CC[i0][k], CC[i1][k], t, C)
			P = C
		else
			mix(WC[i0][k], WC[i1][k], t, C)
			P = C
		end
		if still then
			if useW and useC then
				mix(WS[k], CS[k], cw, D)
				mix(D, P, mw, A)
			else
				mix(if useC then CS[k] else WS[k], P, mw, A)
			end
			P = A
		end
		if aw > E then
			mix(P, R.attack[k] or REST, aw, B)
			P = B
		end
		local l = math.sqrt(P[1] * P[1] + P[2] * P[2] + P[3] * P[3] + P[4] * P[4])
		if l < 1e-6 then
			l = 1
		end
		bone.Transform = CFrame.new(P[5], P[6], P[7], P[1] / l, P[2] / l, P[3] / l, P[4] / l)
	end
	b.stat.frames += 1
end

local hasCache: { [Model]: { t: number, v: boolean } } = {}
function RigAnim.has(model: Model): boolean
	local b = bodies[model]
	if b and b.root == model.PrimaryPart then
		return true -- (매 프레임 자손을 훑지 않는다)
	end
	-- (메시가 없다는 답도 1초 기억: 시안 그림 괴물마다 매 프레임 재귀 검색하지 않게)
	local c = hasCache[model]
	local now = os.clock()
	if c and now - c.t < 1 then
		return c.v
	end
	local v = model:FindFirstChild("Mesh", true) ~= nil
	hasCache[model] = { t = now, v = v }
	return v
end

local failedAt: { [Model]: number } = {} -- (몸 만들기 실패: 1초 동안 다시 훑지 않는다)
function RigAnim.step(model: Model, dt: number)
	local b = bodies[model]
	if not b or b.root ~= model.PrimaryPart then
		local f = failedAt[model]
		if f and os.clock() - f < 1 then
			return
		end
		local nb = build(model)
		if not nb then
			failedAt[model] = os.clock()
			return
		end
		failedAt[model] = nil
		bodies[model] = nb
		b = nb
	end
	local ok, err = pcall(update, b :: Body, dt)
	if not ok then
		(b :: Body).stat.err = tostring(err)
	end
end

function RigAnim.cleanup()
	for m in failedAt do
		if not m.Parent then
			failedAt[m] = nil
		end
	end
	for m in hasCache do
		if not m.Parent then
			hasCache[m] = nil
		end
	end
	for m in bodies do
		if not m.Parent then
			bodies[m] = nil
		end
	end
end

function RigAnim.reset()
	for _, st in RigAnim.stats do
		st.frames, st.steps, st.chaseMax = 0, 0, 0
	end
end

return RigAnim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="298">
        <Properties>
          <string name="Name">SearchLook</string>
          <string name="Source"><![CDATA[--!strict
-- 상자·서랍 조작: 조준점(화면 가운데)으로 서랍이나 뚜껑을 보고 E → 열기/닫기(서버 Search 가 판정).
-- 서랍마다 따로 열고 닫을 수 있다. 안내 문구는 UI.setLookPrompt 로 보여 준다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local UI = require(script.Parent:WaitForChild("UI"))

local SearchLook = {}

local player = Players.LocalPlayer
local SearchAction = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SearchAction") :: RemoteEvent
local RANGE = 8

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

type Target = { spot: number, comp: number, model: Model, label: string }
local current: Target? = nil
local shown = false

local function find(): Target?
	if player:GetAttribute("Status") ~= "Alive" or player:GetAttribute("Hidden") then
		return nil
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	params.FilterDescendantsInstances = if player.Character then { player.Character } else {}
	local hit = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * RANGE, params)
	local inst: Instance? = hit and hit.Instance
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("Comp") then
			local spotModel = inst.Parent
			local label = (spotModel and spotModel:GetAttribute("Label") :: string?) or "상자"
			return { spot = inst:GetAttribute("SpotId") :: number, comp = inst:GetAttribute("Comp") :: number, model = inst, label = label }
		end
		inst = inst.Parent
	end
	return nil
end

function SearchLook.target(): { spot: number, comp: number }?
	local t = find()
	return if t then { spot = t.spot, comp = t.comp } else nil
end

-- 보고 있는 서랍/뚜껑을 연다/닫는다(E)
function SearchLook.use(): boolean
	local t = find()
	if not t then
		return false
	end
	SearchAction:FireServer(t.spot, t.comp)
	return true
end

UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.E and current then
		SearchLook.use()
	end
end)

local Perf = require(script.Parent:WaitForChild("Perf"))
local acc = 0
RunService.RenderStepped:Connect(function(dt)
	acc += dt
	if acc < 0.08 then
		return
	end
	acc = 0
	local t0 = os.clock()
	current = find()
	Perf.add("searchLook", os.clock() - t0)
	if current then
		local open = current.model:GetAttribute("Open") == true
		local what = if current.label == "서랍장" or current.label == "협탁" then "서랍" else current.label
		UI.setLookPrompt(if open then ("E   " .. what .. " 닫기") else ("E   " .. what .. " 열기"))
		shown = true
	elseif shown then
		UI.setLookPrompt(nil)
		shown = false
	end
end)

return SearchLook
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="299">
        <Properties>
          <string name="Name">SonarLines</string>
          <string name="Source"><![CDATA[--!strict
-- 윤곽선 파트 풀. 얇은 Neon 파트를 미리 만들어 두고 재사용한다(이펙트를 매번 새로 만들지 않음).
-- 선은 투명도 대신 색으로 사라진다: 흰색 → 검정. 화면이 전부 검정이라 검정 Neon 은 보이지 않고,
-- 불투명 파트라서 투명 파트보다 렌더링이 훨씬 가볍다(인스턴싱).
-- 같은 선분(키)이 다시 음파를 받으면 새로 만들지 않고 타이머만 갱신 → 반복 발사해도 쌓이지 않는다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Perf = require(script.Parent:WaitForChild("Perf"))

local S = Config.Sonar
local Lines = {}

local HIDDEN = CFrame.new(0, -10000, 0)
local LR, LG, LB = S.LineColor.R, S.LineColor.G, S.LineColor.B
local QUANT = 16 -- 밝기 단계 수(색을 바꾸는 횟수를 줄인다: 검은 바탕에서는 16단계로도 부드럽다)

local LEVELS: { [number]: Color3 } = {} -- 밝기 단계별 기본 흰색(같은 색 값을 매번 만들지 않는다)
for q = 0, QUANT do
	local v = q / QUANT
	LEVELS[q] = Color3.new(LR * v, LG * v, LB * v)
end

-- 선 하나(파트와 함께 계속 재사용한다: 음파마다 표를 새로 만들지 않는다)
type Rec = {
	part: Part,
	sk: number, -- 지금 파트 크기 번호(길이·굵기 단계)
	on: boolean,
	t0: number,
	peak: number,
	key: number?,
	q: number,
	slot: number,
	wake: number, -- 밝기가 일정한 구간에서는 이 시각까지 계산을 건너뛴다(0 = 바로)
	tint: Color3?, -- 이 선만의 색(괴물 이빨 등, 파트 속성 SonarColor). 없으면 Config.Sonar.LineColor
	a: Vector3,
	b: Vector3,
}

local folder: Folder? = nil
-- 쉬는 선: 크기가 같은 것끼리 모아 둔다. 크기 바꾸기가 가장 비싼 일이라(선 하나 일의 절반) 같은 크기를 먼저 다시 쓴다
local freeBy: { [number]: { Rec } } = {}
local freeCount = 0
local freeCursor = 0
local created = 0
local active: { Rec } = {}
local byKey: { [number]: Rec } = {}
-- 켜진 순서(가장 오래된 것부터). 풀이 가득 찼을 때 가장 오래된 선을 O(1)로 찾는다
-- (예전에는 선 하나마다 켜진 선 전부를 훑어서, 빽빽한 곳에서 한 프레임이 1초 가까이 걸렸다)
-- 이미 꺼졌거나 다시 켜진 항목은 매 프레임 앞에서부터 치운다(예전에는 풀이 가득 찰 때만 치워서 오래 하면 끝없이 쌓였다)
local orderRec: { Rec } = {}
local orderT: { number } = {}
local head, tail = 1, 0
local function pushOrder(rec: Rec, t: number)
	tail += 1
	orderRec[tail] = rec
	orderT[tail] = t
end
local function pruneOrder()
	local n = 0
	while head <= tail and n < 4000 do
		local r = orderRec[head]
		if r.on and r.t0 == orderT[head] then
			break
		end
		orderRec[head] = nil :: any
		orderT[head] = nil :: any
		head += 1
		n += 1
	end
	if head > 8192 or head > tail then
		local count = tail - head + 1
		if count > 0 then
			table.move(orderRec, head, tail, 1)
			table.move(orderT, head, tail, 1)
		end
		for i = math.max(count + 1, 1), tail do
			orderRec[i] = nil :: any
			orderT[i] = nil :: any
		end
		head, tail = 1, math.max(count, 0)
	end
end
local moveParts: { BasePart } = {}
local moveCFs: { CFrame } = {}
Lines.stolen = 0
Lines.shownTotal = 0

local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "SonarLines"
	f.Parent = workspace
	folder = f
	return f
end

-- 크기 단계: 길이 0.02스터드, 굵기 16단계(눈으로 구별되지 않는 차이). 번호 = 길이 단계 * 32 + 굵기 단계
local LEN_STEP = 0.02
local W_STEP = (S.LineMaxWidth - S.LineMinWidth) / 16
local FIRST_SK = math.floor(1 / LEN_STEP + 0.5) * 32

local function newRec(): Rec
	local p = Instance.new("Part")
	p.Name = "L"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.new(0, 0, 0)
	p.Size = Vector3.new(S.LineMinWidth, S.LineMinWidth, 1)
	p.CFrame = HIDDEN
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = getFolder()
	created += 1
	return { part = p, sk = FIRST_SK, on = false, t0 = 0, peak = 0, key = nil, q = -1, slot = 0, wake = 0, tint = nil, a = Vector3.zero, b = Vector3.zero }
end

local function giveFree(rec: Rec)
	local l = freeBy[rec.sk]
	if l then
		table.insert(l, rec)
	else
		freeBy[rec.sk] = { rec }
	end
	freeCount += 1
end

-- 쉬는 선 하나: 크기가 같은 것이 있으면 그것, 없으면 아무거나
local function popFree(sk: number): Rec?
	if freeCount == 0 then
		return nil
	end
	local k: number? = sk
	local l = freeBy[sk]
	if not l then
		k = freeCursor
		l = freeBy[freeCursor]
		if not l then
			k, l = next(freeBy)
			freeCursor = k :: number
		end
	end
	local rec = table.remove(l :: { Rec }) :: Rec
	if #(l :: { Rec }) == 0 then
		freeBy[k :: number] = nil
	end
	freeCount -= 1
	return rec
end

local frameRelease = 0 -- (측정) 이 프레임에 끈 선 수
local function release(i: number)
	local rec = active[i]
	local last = active[#active]
	active[i] = last
	last.slot = i
	active[#active] = nil
	if rec.key then
		byKey[rec.key] = nil
		rec.key = nil
	end
	rec.on = false
	frameRelease += 1
	-- (색은 그대로 두고 화면 밖으로만 옮긴다: 다시 쓸 때 첫 갱신에서 색을 정한다)
	table.insert(moveParts, rec.part)
	table.insert(moveCFs, HIDDEN)
	giveFree(rec)
end

Lines.dropped = 0
Lines.force = false -- (SonarPulses 가 내 음파를 그릴 때 켠다)
-- (테스트) 한 프레임에 한 일의 양: 색 바꾸기, 위치·크기 바꾸기 — 가장 많았던 프레임
local frameColor, framePlace = 0, 0
Lines.maxColor, Lines.maxPlace = 0, 0
local function take(now: number, sk: number): Rec?
	local free = popFree(sk)
	if free then
		return free
	end
	if created < S.PoolSize then
		return newRec()
	end
	-- 풀이 가득: 이미 사라지는 중인 가장 오래된 선만 가져온다(켜진 순서 큐의 앞, 그사이 다시 켜졌거나 꺼진 것은 건너뛴다).
	-- 아직 또렷한 선뿐이면 새(더 먼) 선을 그리지 않는다 — 가까운 선이 지워졌다 다시 그려지는 일(깜빡임·렉)을 막는다.
	-- 내 음파(Lines.force)는 꼭 그려져야 한다: 사라지는 선이 없으면 가장 오래 켜져 있던 선(먼저 쏜 음파)을 가져온다
	local fadeAt = S.Hold - S.FadeTime
	while head <= tail do
		local r, t = orderRec[head], orderT[head]
		local valid = r.on and r.t0 == t
		if valid and now - t < fadeAt and not Lines.force then
			break
		end
		orderRec[head] = nil :: any
		orderT[head] = nil :: any
		head += 1
		if valid then
			Lines.stolen += 1
			release(r.slot)
			return popFree(sk)
		end
	end
	Lines.dropped += 1
	return nil
end

local function sizeKey(len: number, mid: Vector3, cam: Vector3): (number, number, number)
	local w = math.clamp(S.LineMinWidth + (mid - cam).Magnitude * S.LineWidthPerStud, S.LineMinWidth, S.LineMaxWidth)
	local wi = math.floor((w - S.LineMinWidth) / W_STEP + 0.5)
	w = S.LineMinWidth + wi * W_STEP
	local li = math.max(1, math.floor((len + w * 0.6) / LEN_STEP + 0.5))
	return li * 32 + wi, w, li * LEN_STEP
end

local function place(rec: Rec, a: Vector3, b: Vector3, sk: number, w: number, l: number)
	framePlace += 1
	rec.a, rec.b = a, b
	if rec.sk ~= sk then
		rec.sk = sk
		rec.part.Size = Vector3.new(w, w, l)
		Lines.sized += 1
	end
	local mid = (a + b) / 2
	local d = b - a
	local up = if math.abs(d.Y) > 0.98 * d.Magnitude then Vector3.xAxis else Vector3.yAxis
	table.insert(moveParts, rec.part)
	table.insert(moveCFs, CFrame.lookAt(mid, b, up))
end

Lines.sized = 0 -- (측정) 크기를 바꾼 수
-- 선 하나를 보여 준다. key 가 같은 선이 이미 있으면 그 선을 갱신한다. tint: 이 선만의 색(없으면 기본 흰색)
function Lines.show(a: Vector3, b: Vector3, now: number, peak: number, key: number?, cam: Vector3, replace: boolean?, tint: Color3?)
	local len = (b - a).Magnitude
	if len < 0.03 then
		return
	end
	Lines.shownTotal += 1
	if key then
		local rec = byKey[key]
		if rec then
			rec.t0 = now
			pushOrder(rec, now)
			rec.peak = math.max(peak, rec.peak * 0.5)
			rec.q = -1
			rec.wake = 0
			rec.tint = tint
			-- (그 자리 그대로면 옮기지 않는다: 서서 여러 번 쏠 때)
			if replace and (rec.a ~= a or rec.b ~= b) then
				place(rec, a, b, sizeKey(len, (a + b) / 2, cam))
			end
			return
		end
	end
	local sk, w, l = sizeKey(len, (a + b) / 2, cam)
	local rec = take(now, sk)
	if not rec then
		return
	end
	place(rec, a, b, sk, w, l)
	rec.on = true
	rec.t0 = now
	rec.peak = peak
	rec.key = key
	rec.q = -1
	rec.wake = 0
	rec.tint = tint
	rec.slot = #active + 1
	active[rec.slot] = rec
	pushOrder(rec, now)
	if key then
		byKey[key] = rec
	end
end

-- 밝기 곡선: 도달 순간 플래시 → 유지 → 서서히 사라짐
local function level(age: number): number
	if age < 0 then
		return 0
	end
	if age < S.FlashTime then
		return 1 - (1 - S.BaseLevel) * (age / S.FlashTime)
	end
	local fadeStart = S.Hold - S.FadeTime
	if age < fadeStart then
		return S.BaseLevel
	end
	local t = math.clamp((age - fadeStart) / S.FadeTime, 0, 1)
	return S.BaseLevel * (1 - t) * (1 - t * 0.35)
end

function Lines.update(now: number)
	local c0 = os.clock()
	local i = 1
	local fadeStart = S.Hold - S.FadeTime
	local step = S.FadeTime / QUANT
	while i <= #active do
		local rec = active[i]
		if now < rec.wake then
			i += 1
			continue
		end
		local age = now - rec.t0
		if age >= S.Hold then
			release(i)
		else
			-- 다음에 밝기가 바뀔 때까지 쉰다(매 프레임 색을 바꾸지 않게):
			--   플래시 동안: 플래시가 끝날 때(밝게 → 보통, 두 번만 바뀜)
			--   유지 동안: 사라지기 시작할 때
			--   사라지는 동안: 다음 단계쯤 — 같은 프레임에 켜진 선들이 한꺼번에 바뀌지 않게 조금씩 어긋나게
			rec.wake = if age < S.FlashTime
				then rec.t0 + S.FlashTime
				elseif age < fadeStart then rec.t0 + fadeStart
				else math.min(now + step * (0.6 + math.random() * 0.8), rec.t0 + S.Hold)
			local l = level(age) * rec.peak
			local q = math.floor(l * QUANT + 0.5)
			if q ~= rec.q then
				rec.q = q
				local v = q / QUANT
				local c = rec.tint
				rec.part.Color = if c then Color3.new(c.R * v, c.G * v, c.B * v) else LEVELS[q]
				frameColor += 1
			end
			i += 1
		end
	end
	pruneOrder()
	local c1 = os.clock()
	local moved = #moveParts
	if moved > 0 then
		workspace:BulkMoveTo(moveParts, moveCFs, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(moveParts)
		table.clear(moveCFs)
	end
	-- (측정) 훑기·색 바꾸기 / 한꺼번에 옮기기 시간, 개수 합계
	Perf.add("lines.scan", c1 - c0)
	Perf.add("lines.bulk", os.clock() - c1)
	Perf.count("lines.color", frameColor)
	Perf.count("lines.moved", moved)
	Perf.count("lines.release", frameRelease)
	frameRelease = 0
	Lines.maxColor = math.max(Lines.maxColor, frameColor)
	Lines.maxPlace = math.max(Lines.maxPlace, framePlace)
	frameColor, framePlace = 0, 0
end

-- 테스트: p 에서 r 안에 켜져 있는 선 수
function Lines.countNear(p: Vector3, r: number): number
	local n = 0
	for _, rec in active do
		if rec.q > 0 and (rec.part.Position - p).Magnitude < r then
			n += 1
		end
	end
	return n
end

-- 선 파트를 미리 만들어 둔다(음파 도중에 새로 만들면 그 프레임이 끊긴다). 스테이지를 불러올 때 조금씩 만든다
function Lines.prewarm(n: number)
	local want = math.min(n, S.PoolSize)
	while created < want do
		for _ = 1, 150 do
			if created >= want then
				break
			end
			giveFree(newRec())
		end
		task.wait()
	end
end

function Lines.clear()
	while #active > 0 do
		release(#active)
	end
	table.clear(orderRec)
	table.clear(orderT)
	head, tail = 1, 0
	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveCFs, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(moveParts)
		table.clear(moveCFs)
	end
end

function Lines.stats()
	local lit = 0
	for _, r in active do
		if r.q > 0 then
			lit += 1
		end
	end
	return { active = #active, lit = lit, created = created, free = freeCount, order = tail - head + 1, sized = Lines.sized, stolen = Lines.stolen, dropped = Lines.dropped, shown = Lines.shownTotal, maxColor = Lines.maxColor, maxPlace = Lines.maxPlace }
end

-- 테스트용: 현재 켜진 선의 가운데 점들
function Lines.litMidpoints(): { Vector3 }
	local out = {}
	for _, r in active do
		if r.q > 0 then
			table.insert(out, r.part.Position)
		end
	end
	return out
end

return Lines
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="300">
        <Properties>
          <string name="Name">SonarPulses</string>
          <string name="Source"><![CDATA[--!strict
-- 음파 전파: 발사 지점에서 복셀 격자를 따라 Dijkstra 로 퍼진다(벽은 통과 못 하고, 열린 통로·문으로만 돌아 들어간다).
-- 파면 반경 = 경과 시간 × WaveSpeed. 파면이 지나간 복셀에 연결된 선분이 그 순간 나타난다 → 가까운 곳부터 먼 곳으로.
-- 연산은 여러 프레임에 나눠 한다(프레임당 ExpandBudget).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Geo = require(ReplicatedStorage.Shared.SonarGeometry)
local World = require(script.Parent:WaitForChild("SonarWorld"))
local Lines = require(script.Parent:WaitForChild("SonarLines"))
local Perf = require(script.Parent:WaitForChild("Perf"))

local S = Config.Sonar
local Pulses = {}

type Pulse = {
	id: number,
	origin: Vector3,
	t0: number,
	-- 거리 창: 시작 복셀 둘레 WN × wy × WN 만(음파 반경 안이라 이 밖으로는 나갈 수 없다). f64 버퍼, 안 간 곳은 아주 큰 값
	dist: buffer,
	x0: number, -- 창의 (0,0,0) 이 격자의 어느 복셀인가
	y0: number,
	z0: number,
	wy: number,
	-- 버킷 큐(Dial): 거리 [k·bw, (k+1)·bw) 인 칸들. 폭 bw = 가장 짧은 이웃 거리(CellSize)라
	-- 같은 버킷 안 칸끼리는 서로 거리를 줄일 수 없다 → 힙과 똑같은 거리, 넣기·꺼내기는 O(1)
	bq: { [number]: { number } },
	bk: number, -- 지금 꺼내는 버킷
	bpos: number, -- 그 버킷에서 다음에 꺼낼 위치
	bw: number,
	bmax: number, -- 마지막 버킷 번호(반경 끝)
	seen: buffer, -- 정적 선분 번호 → 이미 넣었는가
	blockSeen: buffer, -- 구역 번호 → 그 구역의 원통·움직이는 부품을 이미 계산했는가
	viewSeen: buffer, -- 원통·구 번호 → 이미 계산했는가
	dynBlocks: { [number]: { DynItem } },
	cells: { number }, -- 닿은 복셀(World.index). 끝나면 지도에 남긴다
	buckets: { [number]: { number } },
	nextBucket: number,
	bucketPos: number, -- 지금 버킷에서 다음에 보여 줄 위치(한 프레임 상한에 걸려 버킷 중간에서 멈췄을 때)
	dynN: number,
	dynA: { Vector3 },
	dynB: { Vector3 },
	dynM: { Vector3 },
	dynKey: { number }, -- 나눈 선분 번호 → 선 키
	dynTint: { [number]: Color3 }, -- 나눈 선분 번호 → 색(파트 속성 SonarColor 가 있는 것만)
	dynCell: { [number]: { number } },
	dseen: { [number]: boolean },
	cam: Vector3,
	revealed: number,
	trace: { { number } }?,
	own: boolean,
	cpu: number, -- (측정) 이 음파에 쓴 CPU 시간(시작 + 전파 + 선 보이기)
	startCpu: number,
}
type DynItem = { part: BasePart, cf: CFrame, done: boolean }

local pulses: { Pulse } = {}
local nextId = 0
Pulses.last = nil :: Pulse?
Pulses.started = 0
Pulses.lastFail = nil :: string?
Pulses.maxActive = 0
-- (측정) 끝난 음파마다 쓴 CPU 시간: 합, 수, 최대, 시작(gatherDynamic) 최대
local cost = { sum = 0, n = 0, max = 0, startSum = 0, startMax = 0, startN = 0, cut = 0 }
function Pulses.costStats()
	return {
		avgMs = if cost.n > 0 then cost.sum / cost.n * 1000 else 0,
		maxMs = cost.max * 1000,
		finished = cost.n,
		startAvgMs = if cost.startN > 0 then cost.startSum / cost.startN * 1000 else 0,
		startMaxMs = cost.startMax * 1000,
		cut = cost.cut, -- 상한(MaxRemotePulses)에 걸려 일찍 끝낸 팀원 음파 수
	}
end
function Pulses.resetCost()
	cost.sum, cost.n, cost.max, cost.startSum, cost.startMax, cost.startN, cost.cut = 0, 0, 0, 0, 0, 0, 0
	Pulses.maxActive = #pulses
end
Pulses.camera = function(): Vector3
	local cam = workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

-- 18방향(면 6 + 모서리 12). 모서리 방향은 두 성분 칸이 모두 비어야 지나갈 수 있다(벽 모서리 새는 것 방지).
type Nb = { dx: number, dy: number, dz: number, w: number, a: { number }?, b: { number }? }
local NB: { Nb } = {}
do
	for dz = -1, 1 do
		for dy = -1, 1 do
			for dx = -1, 1 do
				local n = math.abs(dx) + math.abs(dy) + math.abs(dz)
				if n == 1 then
					table.insert(NB, { dx = dx, dy = dy, dz = dz, w = 1 })
				elseif n == 2 then
					local comps = {}
					if dx ~= 0 then
						table.insert(comps, { dx, 0, 0 })
					end
					if dy ~= 0 then
						table.insert(comps, { 0, dy, 0 })
					end
					if dz ~= 0 then
						table.insert(comps, { 0, 0, dz })
					end
					table.insert(NB, { dx = dx, dy = dy, dz = dz, w = math.sqrt(2), a = comps[1], b = comps[2] })
				end
			end
		end
	end
end

-- ── 버킷 큐 ──
-- (예전 이진 힙: 넣기·꺼내기 log n, 같은 거리로 두 번 들어간 칸을 두 번 처리했다. 버킷 큐는 같은 거리를 내면서 약 1/3 빠르다)
local function push(p: Pulse, key: number, val: number)
	local k = key // p.bw
	local l = p.bq[k]
	if l then
		l[#l + 1] = val
	else
		p.bq[k] = { val }
	end
end

-- 아직 처리하지 않은 칸 거리의 하한(없으면 math.huge). 다 쓴 버킷은 치운다
local function pending(p: Pulse): number
	local bq = p.bq
	while p.bk <= p.bmax do
		local l = bq[p.bk]
		if l and p.bpos <= #l then
			return p.bk * p.bw
		end
		bq[p.bk] = nil
		p.bk += 1
		p.bpos = 1
	end
	return math.huge
end

local function bucketAdd(p: Pulse, arrival: number, id: number)
	-- (이미 지나간 구간이면 다음에 보여 줄 구간에 넣는다: 늦게 확정된 칸의 선분이 빠지지 않게)
	local b = math.max(math.floor(arrival), p.nextBucket)
	local l = p.buckets[b]
	if not l then
		l = {}
		p.buckets[b] = l
	end
	table.insert(l, id)
end

-- 움직이는 파트마다 고정 번호(같은 선을 다음 음파 때 새로 만들지 않고 옮겨 쓴다 → 겹쳐서 두 줄·더 밝게 보이지 않는다)
local dynIds: { [BasePart]: number } = setmetatable({}, { __mode = "k" }) :: any
local nextDynId = 0
local function dynId(part: BasePart): number
	local id = dynIds[part]
	if not id then
		nextDynId += 1
		id = nextDynId
		dynIds[part] = id
	end
	return id
end

-- ── 이번 음파용 선분(원통·구 실루엣, 문·서랍·괴물) ──
-- 예전에는 쏘는 순간 반경 안 전부를 한 프레임에 계산했다(빽빽한 곳 15~50ms → 넷이 동시에 쏘면 화면이 멈칫).
-- 지금은 파동이 구역(8스터드)에 처음 들어갈 때 그 구역 것만 계산한다: 벽 너머라 닿지 않는 것은 아예 계산하지 않고, 일이 여러 프레임에 나뉜다.
-- 보는 위치(p.cam)와 움직이는 부품의 자세(item.cf)는 쏜 순간 것을 쓴다 → 그려지는 선은 예전과 같다.
local scratch = Geo.newList()

local function addSegments(p: Pulse, keyBase: number, tint: Color3?)
	local list = scratch
	local segLen = S.SegmentLength
	local R = S.Radius
	local n = p.dynN
	local dynCell = p.dynCell
	local o, cs = World.origin, World.cs
	local ox, oy, oz = o.X, o.Y, o.Z
	local nx, ny, nz = World.nx, World.ny, World.nz
	local occ = World.occ
	local lim = S.AttachDistance * S.AttachDistance
	local origin = p.origin
	for i = 1, list.n do
		local a, b = list.A[i], list.B[i]
		local d = b - a
		local len = d.Magnitude
		if len > 0.02 then
			local k = math.max(1, math.ceil(len / segLen))
			local key = (keyBase - i) * 32
			for s = 0, k - 1 do
				local pa = a + d * (s / k)
				local pb = a + d * ((s + 1) / k)
				local m = (pa + pb) / 2
				-- (곧은 거리가 이미 반경 밖이면 파동이 닿을 수 없다)
				if (m - origin).Magnitude <= R then
					n += 1
					p.dynA[n] = pa
					p.dynB[n] = pb
					p.dynM[n] = m
					p.dynKey[n] = key - s
					if tint then
						p.dynTint[n] = tint
					end
					-- World.attachCells 와 같은 판정(표를 만들지 않고 바로 넣는다)
					local mx, my, mz = m.X, m.Y, m.Z
					local x, y, z = (mx - ox) // cs, (my - oy) // cs, (mz - oz) // cs
					if x >= 0 and y >= 0 and z >= 0 and x < nx and y < ny and z < nz then
						for zz = math.max(0, z - 1), math.min(nz - 1, z + 1) do
							local cz = oz + (zz + 0.5) * cs - mz
							local czz = cz * cz
							if czz <= lim then
								for yy = math.max(0, y - 1), math.min(ny - 1, y + 1) do
									local cy = oy + (yy + 0.5) * cs - my
									local cyz = czz + cy * cy
									if cyz <= lim then
										local base = nx * (yy + ny * zz)
										for xx = math.max(0, x - 1), math.min(nx - 1, x + 1) do
											local cx = ox + (xx + 0.5) * cs - mx
											if cyz + cx * cx <= lim and buffer.readu8(occ, xx + base) == 0 then
												local idx = xx + base + 1
												local l = dynCell[idx]
												if l then
													table.insert(l, n)
												else
													dynCell[idx] = { n }
												end
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
	p.dynN = n
end

-- 구역 b 에 파동이 처음 들어왔다. 한 일의 양(전파 연산 수로 환산)을 돌려준다
local viewIds: { number } = {} -- 원통·구 번호 → 고정 번호(dynId)
local function enterBlock(p: Pulse, b: number): number
	local work = 0
	local list = scratch
	local vl = World.viewBlocks[b]
	if vl then
		local seen = p.viewSeen
		for _, i in vl do
			if buffer.readu8(seen, i) == 0 then
				buffer.writeu8(seen, i, 1)
				local cf, size = World.viewCF[i], World.viewSize[i]
				if (cf.Position - p.origin).Magnitude <= S.Radius + size.Magnitude / 2 then
					list.n = 0
					if World.viewBall[i] then
						Geo.ballSilhouette(cf, size, p.cam, list)
					else
						Geo.cylinderSilhouette(cf, size, p.cam, list)
					end
					if list.n > 0 then
						local vid = viewIds[i]
						if not vid then
							vid = dynId(World.viewParts[i])
							viewIds[i] = vid
						end
						addSegments(p, -(1e8 + vid * 64), nil)
						work += 4
					end
				end
			end
		end
	end
	local dl = p.dynBlocks[b]
	if dl then
		for _, item in dl do
			if not item.done then
				item.done = true
				local part = item.part
				if part.Parent then
					list.n = 0
					local moved = part.CFrame ~= item.cf
					if moved and Geo.shapeOf(part) == "Box" then
						local axis = part:GetAttribute("SonarEdgeAxis")
						Geo.boxEdges(item.cf, part.Size, list, if type(axis) == "string" then axis else nil, true)
					else
						Geo.staticEdges(part, list, true)
						Geo.viewEdges(part, p.cam, list)
					end
					local tint = part:GetAttribute("SonarColor")
					addSegments(p, -(2e8 + dynId(part) * 256), if typeof(tint) == "Color3" then tint else nil)
					work += 8
				end
			end
		end
	end
	return work
end

-- 쏜 순간의 문·서랍·괴물(자세는 지금 것을 적어 두고, 선은 파동이 닿을 때 만든다)
local function gatherDynamic(p: Pulse, exclude: Model?)
	local blocks = p.dynBlocks
	for _, part in World.dynamicParts(p.origin, S.Radius, exclude) do
		local cf = part.CFrame
		local item: DynItem = { part = part, cf = cf, done = false }
		local h = part.Size.Magnitude / 2
		World.eachBlock(cf.Position, h, h, h, function(b: number)
			local l = blocks[b]
			if l then
				table.insert(l, item)
			else
				blocks[b] = { item }
			end
		end)
	end
end

-- ── 거리 창·버퍼 재사용(음파마다 새로 만들지 않는다) ──
local HALF = math.ceil(S.Radius / S.CellSize) + 1 -- 시작 복셀에서 이보다 멀리 갈 수 없다
local WN = HALF * 2 + 1
local pool: { [number]: { buffer } } = {}
local function takeBuf(size: number, fill: number): buffer
	local l = pool[size]
	local b = l and table.remove(l)
	if not b then
		b = buffer.create(size)
	end
	buffer.fill(b :: buffer, 0, fill)
	return b :: buffer
end
local function giveBuf(b: buffer)
	local size = buffer.len(b)
	local l = pool[size]
	if not l then
		l = {}
		pool[size] = l
	end
	if #l < 8 then
		table.insert(l, b)
	end
end
local function recycle(p: Pulse)
	giveBuf(p.dist)
	giveBuf(p.seen)
	giveBuf(p.blockSeen)
	giveBuf(p.viewSeen)
end

-- 이웃 18방향의 번호 차이(격자 크기가 바뀌면 다시 계산)
local nbKey = ""
local nbW: { number } = {}
local nbDX: { number }, nbDY: { number }, nbDZ: { number } = {}, {}, {}
local nbL: { number } = {} -- 창 번호 차이
local nbG: { number } = {} -- 격자 번호 차이
local nbA: { number }, nbB: { number } = {}, {} -- 모서리 방향일 때 두 성분 칸의 격자 번호 차이(면 방향이면 0)
local function setupNeighbors(wy: number)
	local nx, ny = World.nx, World.ny
	local key = nx .. "," .. ny .. "," .. wy .. "," .. World.cs
	if key == nbKey then
		return
	end
	nbKey = key
	for i, nb in NB do
		nbW[i] = nb.w * World.cs
		nbDX[i], nbDY[i], nbDZ[i] = nb.dx, nb.dy, nb.dz
		nbL[i] = nb.dx + WN * (nb.dy + wy * nb.dz)
		nbG[i] = nb.dx + nx * (nb.dy + ny * nb.dz)
		local a, b = nb.a, nb.b
		nbA[i] = if a then a[1] + nx * (a[2] + ny * a[3]) else 0
		nbB[i] = if b then b[1] + nx * (b[2] + ny * b[3]) else 0
	end
end
local bufWorld: any = nil

function Pulses.start(origin: Vector3, exclude: Model?, traced: boolean?): boolean
	local c0 = os.clock()
	Pulses.lastFail = nil
	if not World.ready then
		Pulses.lastFail = "notReady"
		return false
	end
	if Pulses.onStart then
		Pulses.onStart(origin)
	end
	-- 격자 밖이면 격자 안 가장 가까운 칸으로(맵 가장자리·높은 곳에서도 쏴지게)
	local o, cs = World.origin, World.cs
	local cx = math.clamp(math.floor((origin.X - o.X) / cs), 0, World.nx - 1)
	local cy = math.clamp(math.floor((origin.Y - o.Y) / cs), 0, World.ny - 1)
	local cz = math.clamp(math.floor((origin.Z - o.Z) / cs), 0, World.nz - 1)
	if World.nx <= 0 or World.ny <= 0 or World.nz <= 0 then
		Pulses.lastFail = "outOfGrid"
		return false
	end
	local x, y, z = cx, cy, cz
	-- 시작 복셀(막혀 있으면 가까운 빈 칸. 좁은 곳·장식 옆이면 점점 넓게 찾는다)
	local start, startD = nil, math.huge
	for reach = 1, 4 do
		if start then
			break
		end
		for dz = -reach, reach do
			for dy = -reach, reach do
				for dx = -reach, reach do
					local xx, yy, zz = (x :: number) + dx, (y :: number) + dy, (z :: number) + dz
					if xx >= 0 and yy >= 0 and zz >= 0 and xx < World.nx and yy < World.ny and zz < World.nz then
						local idx = World.index(xx, yy, zz)
						if World.free(idx) then
							local d = (World.cellCenter(idx) - origin).Magnitude
							if d < startD then
								start, startD = idx, d
							end
						end
					end
				end
			end
		end
	end
	if not start then
		Pulses.lastFail = "blocked"
		return false
	end
	-- (새 스테이지: 크기가 다른 예전 버퍼는 버린다)
	if bufWorld ~= World.occ then
		bufWorld = World.occ
		table.clear(pool)
		table.clear(viewIds)
	end
	local sx, sy, sz = World.coords(start)
	local wy = math.min(World.ny, WN)
	local y0 = if World.ny <= WN then 0 else sy - HALF
	setupNeighbors(wy)
	nextId += 1
	local p: Pulse = {
		id = nextId,
		origin = origin,
		t0 = os.clock(),
		dist = takeBuf(WN * wy * WN * 8, 0x7f),
		x0 = sx - HALF,
		y0 = y0,
		z0 = sz - HALF,
		wy = wy,
		bq = {},
		bk = 0,
		bpos = 1,
		bw = World.cs,
		bmax = S.Radius // World.cs + 1,
		seen = takeBuf(World.segCount + 1, 0),
		blockSeen = takeBuf(World.bnx * World.bny * World.bnz, 0),
		viewSeen = takeBuf(#World.viewParts + 1, 0),
		dynBlocks = {},
		cells = {},
		buckets = {},
		nextBucket = 0,
		bucketPos = 1,
		dynN = 0,
		dynA = {},
		dynB = {},
		dynM = {},
		dynKey = {},
		dynTint = {},
		dynCell = {},
		dseen = {},
		cam = Pulses.camera(),
		revealed = 0,
		trace = if traced then {} else nil,
		own = traced == true,
		cpu = 0,
		startCpu = 0,
	}
	local g0 = os.clock()
	gatherDynamic(p, exclude)
	Perf.add("pulse.gather", os.clock() - g0)
	local li = HALF + WN * ((sy - y0) + wy * HALF)
	buffer.writef64(p.dist, li * 8, startD)
	push(p, startD, li)
	-- 내 음파를 먼저 처리한다(한 프레임 연산·선 수 한도를 팀원·도플갱어 음파보다 먼저 쓴다)
	if p.own then
		table.insert(pulses, 1, p)
	else
		-- 팀원·도플갱어 음파는 동시에 MaxRemotePulses 개까지만(여럿이 동시에 쏴도 렉 없이): 넘으면 가장 오래된 것부터 끝낸다
		local remote = 0
		for _, q in pulses do
			if not q.own then
				remote += 1
			end
		end
		local cap = (S :: any).MaxRemotePulses or 4
		while remote >= cap do
			for k, q in pulses do
				if not q.own then
					table.remove(pulses, k)
					recycle(q)
					cost.cut += 1
					break
				end
			end
			remote -= 1
		end
		table.insert(pulses, p)
	end
	Pulses.last = p
	Pulses.started += 1
	Pulses.maxActive = math.max(Pulses.maxActive, #pulses)
	local sc = os.clock() - c0
	p.cpu += sc
	p.startCpu = sc
	cost.startSum += sc
	cost.startN += 1
	cost.startMax = math.max(cost.startMax, sc)
	return true
end

local function settle(p: Pulse, c: number, d: number)
	local segs = World.cellSegs[c]
	local dyn = p.dynCell[c]
	if not segs and not dyn then
		return
	end
	local center = World.cellCenter(c)
	local R = S.Radius
	if segs then
		local SM = World.SM
		local seen = p.seen
		for _, s in segs do
			if buffer.readu8(seen, s) == 0 then
				buffer.writeu8(seen, s, 1)
				local arr = d + (SM[s] - center).Magnitude
				if arr <= R then
					bucketAdd(p, arr, s)
				end
			end
		end
	end
	if dyn then
		local dseen = p.dseen
		local dynM = p.dynM
		for _, s in dyn do
			if not dseen[s] then
				dseen[s] = true
				local arr = d + (dynM[s] - center).Magnitude
				if arr <= R then
					bucketAdd(p, arr, -s)
				end
			end
		end
	end
end

-- 파면을 limitD 까지 확장. 남은 예산을 돌려준다
local blockTime = 0 -- (측정) 이 프레임에 구역 선분(원통·문·괴물) 계산에 쓴 시간
local function expand(p: Pulse, limitD: number, budget: number): number
	local nx, ny, nz = World.nx, World.ny, World.nz
	local occ = World.occ
	local R = S.Radius
	local dist = p.dist
	local x0, y0, z0, wy = p.x0, p.y0, p.z0, p.wy
	local bnx, bny, BL = World.bnx, World.bny, World.BLOCK
	local blockSeen = p.blockSeen
	local cells = p.cells
	local bq, bw = p.bq, p.bw
	while budget > 0 do
		-- 다음 칸: 지금 버킷에서, 다 썼으면 다음 버킷(버킷 하한이 limitD 를 넘으면 멈춘다)
		local l = bq[p.bk]
		if not l or p.bpos > #l then
			if pending(p) > limitD then
				break
			end
			l = bq[p.bk]
		elseif p.bk * bw > limitD then
			break
		end
		local li = (l :: { number })[p.bpos]
		p.bpos += 1
		local d = buffer.readf64(dist, li * 8)
		-- (음수 = 이미 처리한 칸. 더 짧은 거리로 다시 들어가 남은 예전 항목은 건너뛴다)
		if d >= 0 then
			buffer.writef64(dist, li * 8, -1)
			local lt = li // WN
			local x = x0 + li % WN
			local y = y0 + lt % wy
			local z = z0 + lt // wy
			local g = x + nx * (y + ny * z)
			budget -= 1
			local b = x // BL + bnx * (y // BL + bny * (z // BL))
			if buffer.readu8(blockSeen, b) == 0 then
				buffer.writeu8(blockSeen, b, 1)
				local e0 = os.clock()
				budget -= enterBlock(p, b)
				blockTime += os.clock() - e0
			end
			table.insert(cells, g + 1)
			settle(p, g + 1, d)
			-- 격자 안쪽 복셀이면 이웃이 격자 밖인지 볼 필요가 없다
			local inner = x > 0 and y > 0 and z > 0 and x < nx - 1 and y < ny - 1 and z < nz - 1
			for i = 1, 18 do
				local nd = d + nbW[i]
				if nd <= R then
					local ok = true
					if not inner then
						local xx, yy, zz = x + nbDX[i], y + nbDY[i], z + nbDZ[i]
						ok = xx >= 0 and yy >= 0 and zz >= 0 and xx < nx and yy < ny and zz < nz
					end
					if ok and buffer.readu8(occ, g + nbG[i]) == 0 then
						local na = nbA[i]
						if na == 0 or (buffer.readu8(occ, g + na) == 0 and buffer.readu8(occ, g + nbB[i]) == 0) then
							local nl = li + nbL[i]
							if nd < buffer.readf64(dist, nl * 8) then
								buffer.writef64(dist, nl * 8, nd)
								push(p, nd, nl)
							end
						end
					end
				end
			end
		end
	end
	return budget
end

local function reveal(p: Pulse, id: number, arrival: number, now: number)
	local peak = 1 - (1 - S.FarLevel) * math.clamp(arrival / S.Radius, 0, 1)
	Lines.force = p.own
	if id > 0 then
		Lines.show(World.SA[id], World.SB[id], now, peak, id, p.cam, false)
	else
		local s = -id
		Lines.show(p.dynA[s], p.dynB[s], now, peak, p.dynKey[s] - 1e7, p.cam, true, p.dynTint[s])
	end
	p.revealed += 1
	if p.trace and #p.trace < 6000 then
		table.insert(p.trace, { now - p.t0, arrival, if id > 0 then id else 0 })
	end
end

function Pulses.update(now: number)
	if #pulses == 0 then
		return
	end
	local budget = S.ExpandBudget
	local R = S.Radius
	local expandTime, revealTime = 0, 0
	blockTime = 0
	local showLeft = S.RevealPerFrame -- 이 프레임에 새로 보여 줄 선 수(모든 음파 합계)
	local i = 1
	while i <= #pulses do
		local p = pulses[i]
		local c0 = os.clock()
		local front = (now - p.t0) * S.WaveSpeed
		local per = math.max(400, budget // (#pulses - i + 1))
		local left = expand(p, math.min(front + 3, R + 3), per)
		budget -= (per - left)
		local r0 = os.clock()
		expandTime += r0 - c0
		-- 확정된 거리(처리 안 한 칸 거리의 하한)까지, 그리고 파면까지만 보여 준다
		local settled = pending(p)
		local limit = math.min(front, settled)
		-- 한 프레임에 새로 보여 줄 선 수를 제한한다(모든 음파 합계, 버킷 중간에서도 멈춘다 — 빽빽한 곳에서 한 프레임이 길어지지 않게)
		while p.nextBucket <= limit and p.nextBucket <= R + 1 and showLeft > 0 do
			local l = p.buckets[p.nextBucket]
			if l then
				local k = p.bucketPos
				while k <= #l and showLeft > 0 do
					reveal(p, l[k], p.nextBucket, now)
					k += 1
					showLeft -= 1
				end
				if k <= #l then
					p.bucketPos = k
					break
				end
				p.buckets[p.nextBucket] = nil
			end
			p.bucketPos = 1
			p.nextBucket += 1
		end
		local r1 = os.clock()
		revealTime += r1 - r0
		p.cpu += r1 - c0
		if p.nextBucket > R + 1 and pending(p) > R then
			table.remove(pulses, i)
			cost.sum += p.cpu
			cost.n += 1
			cost.max = math.max(cost.max, p.cpu)
			-- 음파가 닿은 곳(내 것과 팀원 것 모두 지도에 남긴다 — 시야 공유)
			if Pulses.onReach then
				Pulses.onReach(p.cells)
			end
			recycle(p)
		else
			i += 1
		end
	end
	-- (측정) 전파(구역 선분 포함) / 그중 구역 선분 / 선 보이기(Lines.show)
	Perf.add("pulses.expand", expandTime)
	Perf.add("pulses.block", blockTime)
	Perf.add("pulses.reveal", revealTime)
end

-- 음파(내 것·팀원 것)가 끝났을 때 닿은 복셀 목록을 받는다(MapView)
Pulses.onStart = nil :: ((origin: Vector3) -> ())? -- 음파가 시작될 때(내 것·팀원 것): 도플갱어 눈 빛
Pulses.onReach = nil :: ((cells: { number }) -> ())?


function Pulses.active(): number
	return #pulses
end

function Pulses.clear()
	table.clear(pulses)
end

return Pulses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="301">
        <Properties>
          <string name="Name">SonarWorld</string>
          <string name="Source"><![CDATA[--!strict
-- 음파 렌더링용 월드 데이터(클라이언트). 스테이지가 로드되면 한 번만 만든다(매 프레임 다시 스캔하지 않음).
--   1) 윤곽선 선분: SonarRenderable 태그 파트의 모서리 → 같은 평면 이음매·묻힌 모서리 제거 → 짧게 분할
--   2) 전파 격자: 소리를 막는 구조물을 복셀(CellSize)로 칠한 점유 격자. 닫힌 문은 열고 닫을 때 갱신.
--   3) 선분 ↔ 복셀 연결: 각 선분은 가까운 빈 복셀을 통해 음파를 받는다(벽 너머 복셀은 거리 제한으로 제외).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Geo = require(ReplicatedStorage.Shared.SonarGeometry)

local S = Config.Sonar
local TAGS = Config.Tags

local World = {}
World.ready = false
World.buildId = 0
World.stage = nil :: Folder?

-- 정적 선분
World.SA = {} :: { Vector3 }
World.SB = {} :: { Vector3 }
World.SM = {} :: { Vector3 }
World.segCount = 0
World.buildSeconds = 0
World.buildCpu = 0
World.culled = 0
World.unattached = 0
World.cellSegs = {} :: { [number]: { number } }
-- 보는 위치에 따라 선이 바뀌는 정적 파트(원통·구): 위치·크기·모양을 빌드할 때 한 번만 읽어 두고,
-- 그 선이 음파를 받을 수 있는 구역(복셀 4칸 = 8스터드)마다 번호를 적어 둔다 → 파동이 그 구역에 들어갈 때만 계산한다
World.viewParts = {} :: { BasePart }
World.viewCF = {} :: { CFrame }
World.viewSize = {} :: { Vector3 }
World.viewBall = {} :: { boolean }
World.viewBlocks = {} :: { [number]: { number } }
World.BLOCK = 4
World.bnx, World.bny, World.bnz = 0, 0, 0
-- 격자
World.cs = S.CellSize
World.origin = Vector3.zero
World.nx, World.ny, World.nz = 0, 0, 0
World.occ = buffer.create(1)
World.doors = {} :: { { model: Model, cells: { number }, blocked: boolean, conn: RBXScriptConnection? } }

local function vkey(x: number, y: number, z: number): number
	return (x + 512) + (y + 64) * 1024 + (z + 512) * 1024 * 128
end

-- ── 판정 도우미 ──
local function isDynamic(inst: Instance, stage: Instance?): boolean
	local cur: Instance? = inst
	while cur and cur ~= stage and cur ~= workspace do
		if cur:GetAttribute(TAGS.Dynamic) == true then
			return true
		end
		cur = cur.Parent
	end
	return false
end

-- 태그가 붙은 인스턴스(파트 또는 모델)의 파트들
local function taggedParts(tag: string, within: Instance): { BasePart }
	local out = {}
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsDescendantOf(within) then
			if inst:IsA("BasePart") then
				table.insert(out, inst)
			else
				for _, d in inst:GetDescendants() do
					if d:IsA("BasePart") then
						table.insert(out, d)
					end
				end
			end
		end
	end
	return out
end

local function blocksSound(p: BasePart): boolean
	local b = p:GetAttribute("SonarBlocks")
	if type(b) == "boolean" then
		return b
	end
	if not p.CanCollide or p.Transparency >= 1 then
		return false
	end
	local s = p.Size
	local dims = { s.X, s.Y, s.Z }
	table.sort(dims)
	return dims[1] >= 0.9 and dims[2] >= 0.9
end

-- ── 격자 ──
function World.index(x: number, y: number, z: number): number
	return x + World.nx * (y + World.ny * z) + 1
end

function World.coords(idx: number): (number, number, number)
	local c = idx - 1
	local nx, ny = World.nx, World.ny
	local x = c % nx
	local t = c // nx
	return x, t % ny, t // ny
end

function World.cellCenter(idx: number): Vector3
	local x, y, z = World.coords(idx)
	local cs = World.cs
	return World.origin + Vector3.new((x + 0.5) * cs, (y + 0.5) * cs, (z + 0.5) * cs)
end

function World.cellOf(p: Vector3): (number?, number?, number?)
	local r = (p - World.origin) / World.cs
	local x, y, z = math.floor(r.X), math.floor(r.Y), math.floor(r.Z)
	if x < 0 or y < 0 or z < 0 or x >= World.nx or y >= World.ny or z >= World.nz then
		return nil, nil, nil
	end
	return x, y, z
end

function World.free(idx: number): boolean
	return buffer.readu8(World.occ, idx - 1) == 0
end

local function addOcc(idx: number, delta: number)
	local v = buffer.readu8(World.occ, idx - 1) + delta
	buffer.writeu8(World.occ, idx - 1, math.clamp(v, 0, 255))
end

-- 파트가 겹치는 복셀 목록(분리축: 파트 축 기준, 보수적)
local function rasterCells(cf: CFrame, size: Vector3): { number }
	local out = {}
	local cs = World.cs
	local h = cs / 2
	local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
	local ex = h * (math.abs(X.X) + math.abs(X.Y) + math.abs(X.Z))
	local ey = h * (math.abs(Y.X) + math.abs(Y.Y) + math.abs(Y.Z))
	local ez = h * (math.abs(Z.X) + math.abs(Z.Y) + math.abs(Z.Z))
	local hx, hy, hz = size.X / 2 + ex - 0.01, size.Y / 2 + ey - 0.01, size.Z / 2 + ez - 0.01
	-- 월드 AABB
	local ax = math.abs(X.X) * size.X / 2 + math.abs(Y.X) * size.Y / 2 + math.abs(Z.X) * size.Z / 2
	local ay = math.abs(X.Y) * size.X / 2 + math.abs(Y.Y) * size.Y / 2 + math.abs(Z.Y) * size.Z / 2
	local az = math.abs(X.Z) * size.X / 2 + math.abs(Y.Z) * size.Y / 2 + math.abs(Z.Z) * size.Z / 2
	local p = cf.Position
	local o = World.origin
	local x0 = math.max(0, math.floor((p.X - ax - o.X) / cs))
	local x1 = math.min(World.nx - 1, math.floor((p.X + ax - o.X) / cs))
	local y0 = math.max(0, math.floor((p.Y - ay - o.Y) / cs))
	local y1 = math.min(World.ny - 1, math.floor((p.Y + ay - o.Y) / cs))
	local z0 = math.max(0, math.floor((p.Z - az - o.Z) / cs))
	local z1 = math.min(World.nz - 1, math.floor((p.Z + az - o.Z) / cs))
	local Xx, Xy, Xz, Yx, Yy, Yz, Zx, Zy, Zz = X.X, X.Y, X.Z, Y.X, Y.Y, Y.Z, Z.X, Z.Y, Z.Z
	local px, py, pz, ox, oy, oz = p.X, p.Y, p.Z, o.X, o.Y, o.Z
	local nx, ny = World.nx, World.ny
	for z = z0, z1 do
		local dz = oz + (z + 0.5) * cs - pz
		for y = y0, y1 do
			local dy = oy + (y + 0.5) * cs - py
			for x = x0, x1 do
				local dx = ox + (x + 0.5) * cs - px
				if math.abs(dx * Xx + dy * Xy + dz * Xz) < hx and math.abs(dx * Yx + dy * Yy + dz * Yz) < hy and math.abs(dx * Zx + dy * Zy + dz * Zz) < hz then
					table.insert(out, x + nx * (y + ny * z) + 1)
				end
			end
		end
	end
	return out
end

-- mid 근처에서 음파를 받을 수 있는 빈 복셀들
function World.attachCells(mid: Vector3): { number }
	local out = {}
	-- (매우 자주 불린다: Vector3 를 만들지 않고 숫자로만 계산)
	local o, cs = World.origin, World.cs
	local ox, oy, oz = o.X, o.Y, o.Z
	local mx, my, mz = mid.X, mid.Y, mid.Z
	local nx, ny, nz = World.nx, World.ny, World.nz
	local x, y, z = math.floor((mx - ox) / cs), math.floor((my - oy) / cs), math.floor((mz - oz) / cs)
	if x < 0 or y < 0 or z < 0 or x >= nx or y >= ny or z >= nz then
		return out
	end
	local occ = World.occ
	local lim = S.AttachDistance * S.AttachDistance
	for zz = math.max(0, z - 1), math.min(nz - 1, z + 1) do
		local cz = oz + (zz + 0.5) * cs - mz
		for yy = math.max(0, y - 1), math.min(ny - 1, y + 1) do
			local cy = oy + (yy + 0.5) * cs - my
			local base = nx * (yy + ny * zz)
			for xx = math.max(0, x - 1), math.min(nx - 1, x + 1) do
				local cx = ox + (xx + 0.5) * cs - mx
				if cx * cx + cy * cy + cz * cz <= lim and buffer.readu8(occ, xx + base) == 0 then
					table.insert(out, xx + base + 1)
				end
			end
		end
	end
	return out
end

-- ── 문(닫히면 막고 열리면 통과) ──
local function refreshDoor(d)
	local open = d.model:GetAttribute("Open") == true
	local want = not open
	if want ~= d.blocked then
		for _, idx in d.cells do
			addOcc(idx, if want then 1 else -1)
		end
		d.blocked = want
	end
end

-- ── 구역(복셀 4칸) ──
-- 가운데 p, 반폭 (hx, hy, hz) 인 상자(음파를 받는 거리만큼 넓힌다)에 걸치는 구역마다 fn(구역 번호)
function World.eachBlock(p: Vector3, hx: number, hy: number, hz: number, fn: (b: number) -> ())
	local o, size = World.origin, World.cs * World.BLOCK
	local pad = S.AttachDistance + 0.1
	local bnx, bny, bnz = World.bnx, World.bny, World.bnz
	local x0 = math.clamp((p.X - hx - pad - o.X) // size, 0, bnx - 1)
	local x1 = math.clamp((p.X + hx + pad - o.X) // size, 0, bnx - 1)
	local y0 = math.clamp((p.Y - hy - pad - o.Y) // size, 0, bny - 1)
	local y1 = math.clamp((p.Y + hy + pad - o.Y) // size, 0, bny - 1)
	local z0 = math.clamp((p.Z - hz - pad - o.Z) // size, 0, bnz - 1)
	local z1 = math.clamp((p.Z + hz + pad - o.Z) // size, 0, bnz - 1)
	for z = z0, z1 do
		for y = y0, y1 do
			for x = x0, x1 do
				fn(x + bnx * (y + bny * z))
			end
		end
	end
end

-- 움직이는 대상(문, 괴물, 다른 플레이어 캐릭터)
-- 움직이는 파트: 스테이지 안(문·서랍·뚜껑)은 빌드할 때 모아 두고, 괴물은 모델마다 한 번만 모은다
-- (예전처럼 음파마다 태그된 파트 전부를 훑으면 큰 맵에서 한 번에 수십~수백 ms 가 걸린다)
World.stageDynamics = {} :: { BasePart }
-- (도플갱어는 몸이 바뀐다: 사람 → 괴물, 틈 ↔ 벌어진 입. 바뀔 때마다 BodyVersion 이 올라가면 다시 모은다)
local monsterParts: { [Model]: { BasePart } } = setmetatable({}, { __mode = "k" }) :: any
local monsterVer: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any
local function partsOfMonster(m: Model): { BasePart }
	local l = monsterParts[m]
	local ver = (m:GetAttribute("BodyVersion") :: number?) or 0
	if not l or monsterVer[m] ~= ver then
		l = {}
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") and CollectionService:HasTag(d, TAGS.Renderable) then
				table.insert(l, d)
			end
		end
		monsterParts[m] = l
		monsterVer[m] = ver
	end
	return l
end

-- 굳은 선을 그리지 않을 괴물(Main 이 Reveal.has 로 채운다)
World.skipMonster = function(_m: Model): boolean
	return false
end

function World.dynamicParts(near: Vector3, radius: number, exclude: Model?): { BasePart }
	local out = {}
	local reach = radius + 4
	for _, p in World.stageDynamics do
		if (p.Position - near).Magnitude <= reach and p.Parent then
			table.insert(out, p)
		end
	end
	for _, m in CollectionService:GetTagged(TAGS.Monster) do
		-- (음파에 맞아 지금 모습 그대로 보이는 괴물은 굳은 선(잔상)을 따로 그리지 않는다)
		if m:IsA("Model") and World.skipMonster(m :: Model) then
			continue
		end
		if m:IsA("Model") and m.Parent and m ~= exclude and m.PrimaryPart and (m.PrimaryPart.Position - near).Magnitude <= radius + 12 then
			for _, p in partsOfMonster(m) do
				if (p.Position - near).Magnitude <= reach then
					table.insert(out, p)
				end
			end
		end
	end
	-- (다른 플레이어는 Mates 의 윤곽선으로 늘 보이므로 음파 선은 만들지 않는다)
	return out
end

-- ── 빌드(양보하며 진행) ──
function World.build(stage: Folder)
	World.ready = false
	World.stage = stage
	local t0 = os.clock()
	local wall0 = t0
	local cpu = 0
	local function yieldSometimes()
		if os.clock() - t0 > 0.012 then
			cpu += os.clock() - t0
			task.wait()
			t0 = os.clock()
		end
	end
	for _, d in World.doors do
		if d.conn then
			d.conn:Disconnect()
		end
	end
	World.doors = {}
	World.SA, World.SB, World.SM = {}, {}, {}
	World.segCount = 0
	World.culled = 0
	World.unattached = 0
	World.cellSegs = {}
	World.viewParts, World.viewCF, World.viewSize, World.viewBall, World.viewBlocks = {}, {}, {}, {}, {}

	-- 정적 파트
	local statics: { BasePart } = {}
	World.stageDynamics = {}
	for _, p in taggedParts(TAGS.Renderable, stage) do
		if not isDynamic(p, stage) then
			table.insert(statics, p)
		else
			table.insert(World.stageDynamics, p)
		end
	end

	-- 격자 범위
	local bmin = stage:GetAttribute("BoundsMin") :: Vector3?
	local bmax = stage:GetAttribute("BoundsMax") :: Vector3?
	if not bmin or not bmax then
		local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
		for _, p in statics do
			lo = lo:Min(p.Position - p.Size)
			hi = hi:Max(p.Position + p.Size)
		end
		bmin, bmax = lo, hi
	end
	local cs = World.cs
	local lo = ((bmin :: Vector3) - Vector3.one * 4) / cs
	local hi = ((bmax :: Vector3) + Vector3.one * 4) / cs
	World.origin = Vector3.new(math.floor(lo.X), math.floor(lo.Y), math.floor(lo.Z)) * cs
	World.nx = math.ceil(hi.X) - math.floor(lo.X)
	World.ny = math.ceil(hi.Y) - math.floor(lo.Y)
	World.nz = math.ceil(hi.Z) - math.floor(lo.Z)
	World.occ = buffer.create(World.nx * World.ny * World.nz)
	World.bnx = (World.nx + World.BLOCK - 1) // World.BLOCK
	World.bny = (World.ny + World.BLOCK - 1) // World.BLOCK
	World.bnz = (World.nz + World.BLOCK - 1) // World.BLOCK

	-- 공간 해시(점 포함 판정용, 4스터드 버킷)
	local HB = 4
	-- 파트마다 위치·축·크기·모양을 숫자로 한 번만 읽어 둔다(속성 읽기는 느리다)
	type Info = { px: number, py: number, pz: number, xx: number, xy: number, xz: number, yx: number, yy: number, yz: number, zx: number, zy: number, zz: number, hx: number, hy: number, hz: number, shape: string }
	local hbuckets: { [number]: { Info } } = {}
	for _, p in statics do
		local cf, sz = p.CFrame, p.Size / 2
		local info: Info = {
			px = cf.Position.X, py = cf.Position.Y, pz = cf.Position.Z,
			xx = cf.XVector.X, xy = cf.XVector.Y, xz = cf.XVector.Z,
			yx = cf.YVector.X, yy = cf.YVector.Y, yz = cf.YVector.Z,
			zx = cf.ZVector.X, zy = cf.ZVector.Y, zz = cf.ZVector.Z,
			hx = sz.X, hy = sz.Y, hz = sz.Z,
			shape = Geo.shapeOf(p),
		}
		local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
		local half = Vector3.new(
			math.abs(X.X) * sz.X + math.abs(Y.X) * sz.Y + math.abs(Z.X) * sz.Z,
			math.abs(X.Y) * sz.X + math.abs(Y.Y) * sz.Y + math.abs(Z.Y) * sz.Z,
			math.abs(X.Z) * sz.X + math.abs(Y.Z) * sz.Y + math.abs(Z.Z) * sz.Z
		) + Vector3.one * 0.2
		local a = (p.Position - half) / HB
		local b = (p.Position + half) / HB
		for z = math.floor(a.Z), math.floor(b.Z) do
			for y = math.floor(a.Y), math.floor(b.Y) do
				for x = math.floor(a.X), math.floor(b.X) do
					local k = vkey(x, y, z)
					local l = hbuckets[k]
					if not l then
						l = {}
						hbuckets[k] = l
					end
					table.insert(l, info)
				end
			end
		end
		yieldSometimes()
	end
	-- 점이 어떤 정적 파트 안에 있는가(Geo.pointInside 와 같은 판정, 숫자만 사용)
	local function inside(pt: Vector3): boolean
		local x, y, z = pt.X, pt.Y, pt.Z
		local l = hbuckets[vkey(math.floor(x / HB), math.floor(y / HB), math.floor(z / HB))]
		if not l then
			return false
		end
		for _, i in l do
			local dx, dy, dz = x - i.px, y - i.py, z - i.pz
			local lx = dx * i.xx + dy * i.xy + dz * i.xz
			local ly = dx * i.yx + dy * i.yy + dz * i.yz
			local lz = dx * i.zx + dy * i.zy + dz * i.zz
			local sh = i.shape
			if sh == "Cylinder" then
				local r = math.min(i.hy, i.hz)
				if math.abs(lx) <= i.hx and ly * ly + lz * lz <= r * r then
					return true
				end
			elseif sh == "Ball" then
				local r = math.min(i.hx, i.hy, i.hz)
				if lx * lx + ly * ly + lz * lz <= r * r then
					return true
				end
			elseif math.abs(lx) <= i.hx and math.abs(ly) <= i.hy and math.abs(lz) <= i.hz then
				if sh ~= "Wedge" or (ly + i.hy) * i.hz <= (lz + i.hz) * i.hy then
					return true
				end
			end
		end
		return false
	end

	-- 점유 격자
	for _, p in statics do
		if blocksSound(p) then
			for _, idx in rasterCells(p.CFrame, p.Size) do
				addOcc(idx, 1)
			end
		end
		yieldSometimes()
	end
	-- 문
	for _, m in CollectionService:GetTagged(TAGS.Door) do
		if m:IsA("Model") and m:IsDescendantOf(stage) then
			local panel = m:FindFirstChild("Panel") :: BasePart?
			local closed = panel and panel:GetAttribute("ClosedCFrame") :: CFrame?
			if panel and closed then
				local d = { model = m, cells = rasterCells(closed, panel.Size), blocked = false, conn = nil :: RBXScriptConnection? }
				refreshDoor(d)
				d.conn = m:GetAttributeChangedSignal("Open"):Connect(function()
					refreshDoor(d)
				end)
				table.insert(World.doors, d)
			end
		end
	end

	-- 선분
	local EPS = 0.08
	local list = Geo.newList()
	local SA, SB, SM = World.SA, World.SB, World.SM
	local segLen = S.SegmentLength
	local n = 0
	for _, p in statics do
		if Geo.shapeOf(p) ~= "None" then
			list.n = 0
			Geo.staticEdges(p, list)
			for i = 1, list.n do
				local a, b = list.A[i], list.B[i]
				local n1, n2 = list.N1[i], list.N2[i]
				local d = b - a
				local len = d.Magnitude
				if len > 0.03 then
					-- 모서리 위 한 점이 보이는가(이음매·묻힌 모서리가 아닌가)
					local function keepAt(t: number): boolean
						if not (n1 and n2) then
							return true
						end
						local m = a + d * t
						local u1 = (n1 :: Vector3) * EPS
						local u2 = (n2 :: Vector3) * EPS
						if not inside(m + u1 + u2) then
							-- 한쪽 면이 모서리 너머로 같은 평면으로 이어지면 이음매
							return not (inside(m + u2 - u1) or inside(m + u1 - u2))
						end
						return not (inside(m + u1 - u2) and inside(m - u1 + u2)) -- 묻힌 모서리
					end
					-- 조각(SegmentLength) 가운데마다 판정하고, 이웃 조각과 결과가 다르면 그 사이 경계를 이분 탐색으로 정확히 잡는다
					-- (가운데 한 점으로만 자르면 벽 모서리에 걸친 조각이 통째로 빠져 선이 모서리 앞에서 끊긴다)
					local samples = math.max(1, math.ceil(len / segLen))
					local runs: { { number } } = {}
					local prevT = 0.5 / samples
					local prevKeep = keepAt(prevT)
					local runStart: number? = if prevKeep then 0 else nil
					for s = 1, samples - 1 do
						local t = (s + 0.5) / samples
						local k = keepAt(t)
						if k ~= prevKeep then
							local lo, hi = prevT, t
							for _ = 1, 7 do
								local mid = (lo + hi) / 2
								if keepAt(mid) == prevKeep then
									lo = mid
								else
									hi = mid
								end
							end
							local cut = (lo + hi) / 2
							if prevKeep then
								table.insert(runs, { runStart :: number, cut })
								runStart = nil
							else
								runStart = cut
							end
							prevKeep = k
						end
						prevT = t
					end
					if prevKeep and runStart then
						table.insert(runs, { runStart, 1 })
					end
					for _, run in runs do
						local t0, t1 = run[1], run[2]
						local rl = (t1 - t0) * len
						if rl > 0.05 then
							local k = math.max(1, math.ceil(rl / segLen))
							for s = 0, k - 1 do
								local pa = a + d * (t0 + (t1 - t0) * s / k)
								local pb = a + d * (t0 + (t1 - t0) * (s + 1) / k)
								n += 1
								SA[n] = pa
								SB[n] = pb
								SM[n] = (pa + pb) / 2
							end
						end
					end
					if #runs == 0 then
						World.culled += 1
					end
				end
			end
		end
		if Geo.hasViewEdges(p) then
			table.insert(World.viewParts, p)
			local i = #World.viewParts
			local cf, sz = p.CFrame, p.Size
			World.viewCF[i] = cf
			World.viewSize[i] = sz
			World.viewBall[i] = Geo.shapeOf(p) == "Ball"
			local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
			local h = sz / 2
			local blocks = World.viewBlocks
			World.eachBlock(
				cf.Position,
				math.abs(X.X) * h.X + math.abs(Y.X) * h.Y + math.abs(Z.X) * h.Z,
				math.abs(X.Y) * h.X + math.abs(Y.Y) * h.Y + math.abs(Z.Y) * h.Z,
				math.abs(X.Z) * h.X + math.abs(Y.Z) * h.Y + math.abs(Z.Z) * h.Z,
				function(b: number)
					local l = blocks[b]
					if not l then
						l = {}
						blocks[b] = l
					end
					table.insert(l, i)
				end
			)
		end
		yieldSometimes()
	end
	World.segCount = n

	-- 선분 ↔ 복셀
	local cellSegs = World.cellSegs
	for s = 1, n do
		local cells = World.attachCells(SM[s])
		if #cells == 0 then
			World.unattached += 1
		end
		for _, idx in cells do
			local l = cellSegs[idx]
			if not l then
				l = {}
				cellSegs[idx] = l
			end
			table.insert(l, s)
		end
		if s % 400 == 0 then
			yieldSometimes()
		end
	end

	World.buildId = (stage:GetAttribute("BuildId") :: number?) or 0
	cpu += os.clock() - t0
	World.buildSeconds = os.clock() - wall0
	World.buildCpu = cpu
	World.ready = true
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="302">
        <Properties>
          <string name="Name">SpriteAnim</string>
          <string name="Source"><![CDATA[--!strict
-- 시안 그림 챕터 괴물(Rig = 4): 시안을 만든 렌더러로 찍은 그림(8방향 × 9자세)을 그대로 띄운다.
--  · 보는 방향: 괴물이 향한 쪽과 카메라 사이 각도로 8방향 중 하나
--  · 자세: 서 있으면 걷기 0, 걸으면 걷기 4장, 쫓으면 추격 4장(실제 이동 거리로 넘김 → 미끄러지지 않음), 바로 앞이면 덮침
--  · 음파에 드러난 동안만 보인다(Reveal.active). 걸음 소리는 반 주기마다(onStep)
-- 그림 시트: Shared/CreatureSprites/<id> 의 sheets(로블록스 에셋 번호). 0 이면 Studio 안 로컬 파일(rbxasset://sonarcreatures/<id>_<n>.png)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SpriteAnim = {}
SpriteAnim.onStep = nil :: ((Model, Vector3, number) -> ())?
SpriteAnim.visible = nil :: ((Model) -> boolean)?
SpriteAnim.stats = {} :: { [string]: { frames: number, steps: number, shown: number, cell: number, loaded: boolean } }

type Body = {
	model: Model,
	root: BasePart,
	S: any,
	gui: BillboardGui,
	img: ImageLabel,
	hip: number,
	phase: number,
	stat: { frames: number, steps: number, shown: number, cell: number, loaded: boolean },
	lastCell: number,
}
local bodies: { [Model]: Body } = {}

local function sheetUrl(S: any, n: number): string
	local id = S.sheets[n]
	if id and id ~= 0 then
		return "rbxassetid://" .. id
	end
	return "rbxasset://sonarcreatures/" .. S.id .. "_" .. n .. ".png"
end

local function build(model: Model): Body?
	local root = model.PrimaryPart
	local id = model:GetAttribute("Creature")
	if not root or typeof(id) ~= "string" then
		return nil
	end
	local folder = ReplicatedStorage.Shared:FindFirstChild("CreatureSprites")
	local ms = folder and folder:FindFirstChild(id)
	if not ms or not ms:IsA("ModuleScript") then
		return nil
	end
	local S = require(ms) :: any
	local gui = Instance.new("BillboardGui")
	gui.Name = "CreatureSprite"
	gui.Adornee = root
	gui.Size = UDim2.fromScale(S.size[1], S.size[2])
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	gui.MaxDistance = 400
	gui.ClipsDescendants = true
	gui.Enabled = false
	local img = Instance.new("ImageLabel")
	img.Name = "Body"
	img.BackgroundTransparency = 1
	img.Size = UDim2.fromScale(1, 1)
	img.ImageRectSize = Vector2.new(S.cellPx[1], S.cellPx[2])
	img.Image = sheetUrl(S, 1)
	img.ResampleMode = Enum.ResamplerMode.Default
	img.Parent = gui
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	SpriteAnim.stats[id] = SpriteAnim.stats[id] or { frames = 0, steps = 0, shown = 0, cell = -1, loaded = false }
	return {
		model = model,
		root = root,
		S = S,
		gui = gui,
		img = img,
		hip = (model:GetAttribute("Hip") :: number?) or 2,
		phase = math.random(),
		stat = SpriteAnim.stats[id],
		lastCell = -1,
	}
end

local function update(b: Body, dt: number, camPos: Vector3)
	local S = b.S
	local v = b.root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local chasing = b.model:GetAttribute("State") == "Chase"
	-- 위상: 한 주기(발 두 번) = 보폭 × 2
	local before = b.phase
	b.phase = (b.phase + speed * dt / (S.stride * 2)) % 1
	if speed > 0.5 and ((before < 0.5 and b.phase >= 0.5) or b.phase < before) then
		b.stat.steps += 1
		if SpriteAnim.onStep then
			SpriteAnim.onStep(b.model, b.root.Position + Vector3.new(0, -(b.hip + 1), 0), math.clamp(speed / 10, 0.3, 1.4))
		end
	end
	local show = if SpriteAnim.visible then SpriteAnim.visible(b.model) else true
	b.gui.Enabled = show
	if not show then
		return
	end
	b.stat.shown += 1
	-- 자세
	local pose = 0
	local me = Players.LocalPlayer.Character
	local hrp = me and me:FindFirstChild("HumanoidRootPart") :: BasePart?
	local near = if hrp then (hrp.Position - b.root.Position).Magnitude else math.huge
	if chasing and near < 6 then
		pose = 8
	elseif speed > 0.5 then
		pose = math.floor(b.phase * 4) % 4 + (if chasing then 4 else 0)
	end
	-- 방향: 카메라가 괴물 기준 어디에 있나(디자인 좌표: 앞 +Z, 왼쪽 +X → 게임 로컬은 x·z 를 뒤집은 것)
	local lp = b.root.CFrame:PointToObjectSpace(camPos)
	local yaw = math.atan2(-lp.X, -lp.Z)
	local yi = math.floor(yaw / (2 * math.pi / S.yaws) + 0.5) % S.yaws
	local cell = yi * S.poses + pose
	if cell ~= b.lastCell then
		b.lastCell = cell
		b.stat.cell = cell
		local per = S.cols * S.rows
		local sheet = cell // per + 1
		local k = cell % per
		local url = sheetUrl(S, sheet)
		if b.img.Image ~= url then
			b.img.Image = url
		end
		b.img.ImageRectOffset = Vector2.new((k % S.cols) * S.cellPx[1], (k // S.cols) * S.cellPx[2])
	end
	-- 그림 가운데: 바닥 위 centerY, 몸 앞쪽 centerZ
	local look = b.root.CFrame.LookVector
	b.gui.StudsOffsetWorldSpace = Vector3.new(0, -(b.hip + 1) + S.centerY, 0) + Vector3.new(look.X, 0, look.Z) * S.centerZ
	b.stat.frames += 1
	b.stat.loaded = b.img.IsLoaded
end

local failedAt: { [Model]: number } = {} -- (그림 몸 만들기 실패: 1초 동안 다시 하지 않는다)
function SpriteAnim.step(model: Model, dt: number, camPos: Vector3)
	local b = bodies[model]
	if not b or b.root ~= model.PrimaryPart then
		if b then
			b.gui:Destroy()
			bodies[model] = nil
		end
		local f = failedAt[model]
		if f and os.clock() - f < 1 then
			return
		end
		local nb = build(model)
		if not nb then
			failedAt[model] = os.clock()
			return
		end
		failedAt[model] = nil
		bodies[model] = nb
		b = nb
	end
	update(b :: Body, dt, camPos)
end

function SpriteAnim.cleanup()
	for m in failedAt do
		if not m.Parent then
			failedAt[m] = nil
		end
	end
	for m, b in bodies do
		if not m.Parent then
			b.gui:Destroy()
			bodies[m] = nil
		end
	end
end

function SpriteAnim.reset()
	for _, st in SpriteAnim.stats do
		st.frames, st.steps, st.shown = 0, 0, 0
	end
end

-- (점프스케어) 이 괴물의 덮침 그림(정면): 이미지 주소와 칸 위치
function SpriteAnim.attackFrame(id: string): (string?, Vector2?, Vector2?)
	local folder = ReplicatedStorage.Shared:FindFirstChild("CreatureSprites")
	local ms = folder and folder:FindFirstChild(id)
	if not ms or not ms:IsA("ModuleScript") then
		return nil
	end
	local S = require(ms) :: any
	local cell = 8 -- 정면 · 덮침
	local per = S.cols * S.rows
	local k = cell % per
	return sheetUrl(S, cell // per + 1), Vector2.new((k % S.cols) * S.cellPx[1], (k // S.cols) * S.cellPx[2]), Vector2.new(S.cellPx[1], S.cellPx[2])
end

return SpriteAnim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="303">
        <Properties>
          <string name="Name">UI</string>
          <string name="Source"><![CDATA[--!strict
-- 최소 UI: 작은 조준점, 음파 재사용 대기 막대, 스테이지 이름, 상호작용 안내, 사망/탈출/클리어 화면.
-- 흰색·회색만. 미니맵이나 괴물 위치 표시는 없다.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local UI = {}
local player = Players.LocalPlayer

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "SonarUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 5
gui.Parent = player:WaitForChild("PlayerGui")

local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium)
local FONT_BOLD = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)

local function label(parent: Instance, text: string, size: number, pos: UDim2, anchor: Vector2, bold: boolean?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextSize = size
	l.FontFace = if bold then FONT_BOLD else FONT
	l.TextColor3 = Color3.fromRGB(220, 220, 220)
	l.Size = UDim2.fromOffset(600, size + 8)
	l.Position = pos
	l.AnchorPoint = anchor
	l.Parent = parent
	return l
end

-- 조준점
local dot = Instance.new("Frame")
dot.Size = UDim2.fromOffset(3, 3)
dot.AnchorPoint = Vector2.new(0.5, 0.5)
dot.Position = UDim2.fromScale(0.5, 0.5)
dot.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
dot.BackgroundTransparency = 0.35
dot.BorderSizePixel = 0
dot.Parent = gui

-- 음파 대기 막대(조준점 아래, 아주 얇게)
local barBack = Instance.new("Frame")
barBack.Size = UDim2.fromOffset(36, 2)
barBack.AnchorPoint = Vector2.new(0.5, 0)
barBack.Position = UDim2.new(0.5, 0, 0.5, 14)
barBack.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
barBack.BackgroundTransparency = 0.75
barBack.BorderSizePixel = 0
barBack.Parent = gui
local barFill = Instance.new("Frame")
barFill.Size = UDim2.fromScale(1, 1)
barFill.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
barFill.BackgroundTransparency = 0.5
barFill.BorderSizePixel = 0
barFill.Parent = barBack

-- 스테이지 이름(왼쪽 위, 흐리게)
local stageLabel = label(gui, "", 14, UDim2.fromOffset(18, 14), Vector2.zero)
stageLabel.TextXAlignment = Enum.TextXAlignment.Left
stageLabel.TextTransparency = 0.45

-- 가운데 큰 제목(스테이지 시작 시 잠깐)
local title = label(gui, "", 26, UDim2.fromScale(0.5, 0.36), Vector2.new(0.5, 0.5), true)
title.TextTransparency = 1
title.Size = UDim2.fromOffset(900, 40)

-- 짧은 안내(가운데 아래)
local hint = label(gui, "", 15, UDim2.new(0.5, 0, 0.5, 46), Vector2.new(0.5, 0))
hint.TextTransparency = 1

-- 상호작용 안내
local prompt = label(gui, "", 15, UDim2.new(0.5, 0, 0.5, 26), Vector2.new(0.5, 0))
prompt.TextTransparency = 0.2
prompt.Visible = false

-- 결과 화면
local overlay = Instance.new("Frame")
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundColor3 = Color3.new(0, 0, 0)
overlay.BackgroundTransparency = 1
overlay.BorderSizePixel = 0
overlay.ZIndex = 10
overlay.Parent = gui
local ovTitle = label(overlay, "", 40, UDim2.fromScale(0.5, 0.44), Vector2.new(0.5, 0.5), true)
ovTitle.Size = UDim2.fromOffset(900, 56)
ovTitle.ZIndex = 11
ovTitle.TextTransparency = 1
local ovSub = label(overlay, "", 16, UDim2.fromScale(0.5, 0.53), Vector2.new(0.5, 0.5))
ovSub.Size = UDim2.fromOffset(900, 24)
ovSub.ZIndex = 11
ovSub.TextColor3 = Color3.fromRGB(160, 160, 160)
ovSub.TextTransparency = 1

-- 관전 안내(아래쪽)
local spectate = label(gui, "", 14, UDim2.new(0.5, 0, 1, -40), Vector2.new(0.5, 0.5))
spectate.TextColor3 = Color3.fromRGB(170, 170, 170)
spectate.Visible = false

local function tween(obj: Instance, t: number, props: { [string]: any })
	TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Sine), props):Play()
end

local shownFrac = -1
function UI.setCooldown(frac: number)
	frac = math.clamp(frac, 0, 1)
	if frac == shownFrac then
		return -- (다 찼으면 매 프레임 다시 그리지 않는다)
	end
	shownFrac = frac
	barFill.Size = UDim2.fromScale(frac, 1)
	barFill.BackgroundTransparency = if frac >= 1 then 0.6 else 0.35
end

function UI.setStage(name: string)
	stageLabel.Text = name
	title.Text = name
	tween(title, 1.2, { TextTransparency = 0.1 })
	task.delay(3.5, function()
		if title.Text == name then
			tween(title, 1.5, { TextTransparency = 1 })
		end
	end)
end

function UI.hint(text: string, seconds: number)
	hint.Text = text
	tween(hint, 0.6, { TextTransparency = 0.25 })
	task.delay(seconds, function()
		if hint.Text == text then
			tween(hint, 1.2, { TextTransparency = 1 })
		end
	end)
end

-- 안내 문구는 두 곳에서 온다: 문·숨는 곳(가까이 가면) / 서랍·상자(조준하면). 조준한 것이 먼저 보이고,
-- 한쪽이 지워도 다른 쪽 문구는 남는다(서랍에서 눈을 떼도 옆 사물함의 '숨기'가 사라지지 않게)
local nearText: string? = nil
local lookText: string? = nil
local function showPrompt()
	local text = lookText or nearText
	local t = text or ""
	if prompt.Text ~= t or prompt.Visible ~= (text ~= nil) then
		prompt.Visible = text ~= nil
		prompt.Text = t
	end
end

function UI.setPrompt(text: string?)
	nearText = text
	showPrompt()
end

function UI.setLookPrompt(text: string?)
	lookText = text
	showPrompt()
end

-- 결과 화면. black: 화면을 검게 덮는다(아니면 글자만)
function UI.overlay(t: string, sub: string, black: boolean)
	ovTitle.Text = t
	ovSub.Text = sub
	tween(overlay, 0.9, { BackgroundTransparency = if black then 0 else 1 })
	tween(ovTitle, 0.9, { TextTransparency = 0 })
	tween(ovSub, 1.2, { TextTransparency = 0 })
	dot.Visible = false
	barBack.Visible = false
end

function UI.hideOverlay(fast: boolean?)
	local t = if fast then 0.2 else 0.8
	tween(overlay, t, { BackgroundTransparency = 1 })
	tween(ovTitle, t, { TextTransparency = 1 })
	tween(ovSub, t, { TextTransparency = 1 })
	dot.Visible = true
	barBack.Visible = true
end

-- 오버레이 글자만 남기고 배경을 걷는다(관전으로 넘어갈 때)
function UI.liftOverlay()
	tween(overlay, 1.2, { BackgroundTransparency = 1 })
	tween(ovTitle, 1.2, { TextTransparency = 1 })
	tween(ovSub, 1.2, { TextTransparency = 1 })
end

local spectateShown: string? = nil
function UI.setSpectate(text: string?)
	if text == spectateShown then
		-- (관전 중 매 프레임 같은 글을 다시 쓰지 않는다. 다른 화면이 조준점을 다시 켰으면 끄기만)
		if text and dot.Visible then
			dot.Visible = false
			barBack.Visible = false
		end
		return
	end
	spectateShown = text
	spectate.Visible = text ~= nil
	spectate.Text = text or ""
	if text then
		dot.Visible = false
		barBack.Visible = false
	end
end

function UI.state()
	return {
		overlayTitle = ovTitle.Text,
		overlayShown = ovTitle.TextTransparency < 0.5,
		stage = stageLabel.Text,
		spectate = if spectate.Visible then spectate.Text else nil,
		prompt = if prompt.Visible then prompt.Text else nil,
	}
end

return UI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="304">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>