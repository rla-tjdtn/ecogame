        <Item class="ModuleScript" referent="253">
          <Properties>
            <string name="Name">Stage8</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 8 — 폐유치원 (47x43칸, tools/places/kindergarten.js 로 생성)
-- ㄷ자 건물이 가운데 놀이 마당을 감싼다: 남서쪽 현관·신발장 홀(시작) → 서쪽 날개(위로) → 북쪽 날개(동쪽으로) → 동쪽 날개(아래로) →
-- 급식 홀·식당(서쪽으로) → 울타리 문(두 곳)으로 마당에 들어가 마당 북쪽 끝 뒷문 비상구(E)로 나간다.
-- 서쪽 날개: 해님반·낮잠방(N)·어린이 화장실 | 달님반·책놀이터(복도로 트인 도서 코너)·꽃님반. 북쪽 날개: 교재 창고·원장실·교무실·유희실(무대 a, 가장 큰 공간)·보건실·교사 화장실.
-- 동쪽 날개: 새싹반·볼풀 놀이방(G)·실내 놀이터 | 무지개반·구름반·블록 놀이방. 남쪽: 급식 홀(네 칸 폭)·식당·조리실·식품 창고.
-- 마당은 울타리로 세 칸(놀이기구 / 그네 / 모래밭 g). 전용 소품은 ChapterProps/Kindergarten.
-- 숨는 곳(L)은 어린이 사물함, 뒤지는 곳(Z)은 장난감 상자. 출구까지 최단 약 127칸.
local Props = require(script.Parent.Parent.Props)
local CP = require(script.Parent.Parent.ChapterProps.Kindergarten)
return {
	Seed = 81,
	PipeChance = 0.12,
	HideStyle = "cubby", -- 숨는 곳(L): 어린이 사물함
	SearchStyle = "toybox", -- 뒤지는 곳(Z): 장난감 상자, 그중 한 곳에 열쇠
