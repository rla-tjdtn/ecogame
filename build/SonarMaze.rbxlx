      <Item class="ModuleScript" referent="229">
        <Properties>
          <string name="Name">Doors</string>
          <string name="Source"><![CDATA[--!strict
-- 문: E(ProximityPrompt)로 열고 닫는다. 경첩을 축으로 90도 회전.
-- 문짝은 움직이므로 SonarDynamic(음파가 닿는 순간의 위치로 윤곽선), 닫혀 있으면 음파·소리를 막는다.
-- 괴물은 문을 지나갈 수 있도록 경로 계산에서 문짝을 무시(PathfindingModifier.PassThrough)하고, 가까이 가면 연다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local SoundBus = require(script.Parent.SoundBus)

local Doors = {}

type Door = {
	model: Model,
	panel: Part,
	prompt: ProximityPrompt,
	hinge: CFrame,
	closedRel: CFrame,
	swing: number,
	open: boolean,
	busy: boolean,
}

local doors: { Door } = {}

local function setPose(d: Door, t: number)
	local rot = CFrame.Angles(0, d.swing * (math.pi / 2) * t, 0)
	d.panel.CFrame = d.hinge * rot * d.closedRel
end

-- 문짝이나 그 근처에 캐릭터(플레이어·괴물)가 겹쳐 있는가
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude
local function someoneInside(panel: BasePart): boolean
	overlap.FilterDescendantsInstances = { panel.Parent :: Instance }
	for _, p in workspace:GetPartBoundsInBox(panel.CFrame, panel.Size + Vector3.new(0.4, 0, 0.6), overlap) do
		local m = p:FindFirstAncestorOfClass("Model")
		if m and m:FindFirstChildOfClass("Humanoid") then
			return true
		end
	end
	return false
end

-- from: 여는 사람(또는 괴물) 위치. 열 때 그 반대쪽으로 열려서 문짝이 사람을 치거나 가두지 않는다
function Doors.toggle(d: Door, source: Player?, from: Vector3?)
	if d.busy then
		return
	end
	d.busy = true
	local opening = not d.open
	if opening then
		local pos = from
		if not pos and source and source.Character then
			local r = source.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			pos = r and r.Position
		end
		if pos then
			-- 문짝은 경첩 기준 -Z*swing 쪽으로 열린다: 여는 사람이 있는 쪽의 반대
			d.swing = if (pos - d.hinge.Position):Dot(d.hinge.ZVector) >= 0 then 1 else -1
		end
	end
	-- 움직이는 동안은 부딪히지 않는다(끼임 방지)
	d.panel.CanCollide = false
	d.open = opening
	d.model:SetAttribute("Open", opening)
	d.prompt.ActionText = if opening then "문 닫기" else "문 열기"
	SoundBus.emit(d.panel.Position, Config.Noise.Door, source, "Door")
	task.spawn(function()
		local dur = 0.55
		local t0 = os.clock()
		while true do
			local a = math.clamp((os.clock() - t0) / dur, 0, 1)
			local e = 1 - (1 - a) * (1 - a)
			setPose(d, if opening then e else 1 - e)
			if a >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		d.busy = false
		-- 멈춘 뒤: 아무도 겹쳐 있지 않을 때 다시 단단해진다
		local waited = 0
		while d.panel.Parent and someoneInside(d.panel) and waited < 10 do
			task.wait(0.2)
			waited += 0.2
		end
		if d.panel.Parent and not d.busy then
			d.panel.CanCollide = true
		end
	end)
end

-- hingeBottom: 경첩 아래 끝, along: 닫힌 문짝이 경첩에서 뻗는 방향(수평), swing: +1/-1 (여는 방향)
function Doors.create(parent: Instance, hingeBottom: Vector3, along: Vector3, width: number, height: number, swing: number): Model
	local model = Instance.new("Model")
	model.Name = "Door"
	model:SetAttribute("Open", false)
	model:SetAttribute(Config.Tags.Dynamic, true)
	model.Parent = parent
	local dir = Vector3.new(along.X, 0, along.Z).Unit
	local hinge = CFrame.fromMatrix(hingeBottom, dir, Vector3.yAxis)
	local closedRel = CFrame.new(width / 2, height / 2, 0)
	local panel = Kit.box(model, hinge * closedRel, Vector3.new(width - 0.1, height - 0.05, 0.3), { name = "Panel" })
	panel:SetAttribute("ClosedCFrame", panel.CFrame)
	-- 손잡이(가로 막대) + 판 무늬: 문으로 알아볼 수 있게
	local handleY = height * 0.45
	for _, side in { -1, 1 } do
		local a = panel.CFrame * Vector3.new(width * 0.05, handleY - height / 2, side * 0.3)
		local b = panel.CFrame * Vector3.new(width * 0.38, handleY - height / 2, side * 0.3)
		local h = Kit.cylinder(model, a, b, 0.08, { collide = false, blocks = false })
		h.Anchored = false
		h.Massless = true
		local w = Instance.new("WeldConstraint")
		w.Part0 = panel
		w.Part1 = h
		w.Parent = h
	end
	local inset = Kit.box(model, panel.CFrame * CFrame.new(0, height * 0.18, 0), Vector3.new(width * 0.62, height * 0.3, 0.42), { collide = false, blocks = false })
	inset.Anchored = false
	inset.Massless = true
	local w2 = Instance.new("WeldConstraint")
	w2.Part0 = panel
	w2.Part1 = inset
	w2.Parent = inset
	local mod = Instance.new("PathfindingModifier")
	mod.PassThrough = true
	mod.Parent = panel
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "문 열기"
	prompt.ObjectText = ""
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Parent = panel
	CollectionService:AddTag(model, Config.Tags.Door)
	local d: Door = {
		model = model,
		panel = panel,
		prompt = prompt,
		hinge = hinge,
		closedRel = closedRel,
		swing = swing,
		open = false,
		busy = false,
	}
	table.insert(doors, d)
	prompt.Triggered:Connect(function(player)
		if player:GetAttribute("Status") ~= "Alive" then
			return
		end
		Doors.toggle(d, player)
	end)
	model.Destroying:Connect(function()
		local i = table.find(doors, d)
		if i then
			table.remove(doors, i)
		end
	end)
	return model
end

function Doors.all(): { Door }
	return doors
end

-- 괴물용: pos 근처 닫힌 문을 연다
function Doors.openNear(pos: Vector3, radius: number, from: Vector3?): boolean
	local any = false
	for _, d in doors do
		if not d.open and not d.busy and (d.panel.Position - pos).Magnitude <= radius then
			Doors.toggle(d, nil, from or pos)
			any = true
		end
	end
	return any
end

function Doors.clear()
	table.clear(doors)
end

return Doors
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="230">
        <Properties>
          <string name="Name">Hiding</string>
          <string name="Source"><![CDATA[--!strict
-- 숨는 곳(맵 문자 L): 챕터마다 모양이 다른 캐비닛·옷장. E(ProximityPrompt)로 들어가고 E 로 나온다.
-- 숨어 있는 동안: 움직일 수 없고 음파를 쏠 수 없으며, 괴물은 보지도 잡지도 못한다.
-- 단, 쫓아오던 괴물이 숨는 모습을 봤다면(Config.Hide.SeenWindow 안에 시야에 있었다면) 그 앞으로 와서 끌어낸다(Monster).
-- 문을 여닫는 소리(Config.Hide.Noise)는 가까운 괴물이 듣는다.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local SoundBus = require(script.Parent.SoundBus)

local Hiding = {}

export type Spot = {
	model: Model,
	center: Vector3, -- 바닥 높이의 안쪽 가운데
	facing: Vector3, -- 문이 향하는 방향(방 안쪽)
	front: Vector3, -- 문 앞(바닥 높이)
	prompt: ProximityPrompt,
	occupant: Player?,
}

local spots: { Spot } = {}
local occupied: { [Player]: Spot } = {}
local hideListeners: { (Player, Spot) -> () } = {}

-- 챕터별 모양
type Style = { w: number, d: number, h: number, doors: number, louvers: boolean, legs: boolean, crown: boolean, tilt: number }
local STYLES: { [string]: Style } = {
	locker = { w = 3.6, d = 3.0, h = 7.6, doors = 1, louvers = true, legs = false, crown = false, tilt = 0 }, -- 지하 시설: 철제 사물함
	tool = { w = 4.6, d = 3.2, h = 7.2, doors = 2, louvers = true, legs = false, crown = false, tilt = 0 }, -- 창고: 공구 캐비닛
	rusty = { w = 3.6, d = 3.0, h = 7.4, doors = 1, louvers = true, legs = false, crown = false, tilt = 0.035 }, -- 하수도: 찌그러진 정비 사물함
	wardrobe = { w = 5.6, d = 3.4, h = 8.0, doors = 2, louvers = true, legs = true, crown = true, tilt = 0 }, -- 병원: 병실 옷장
	closet = { w = 4.8, d = 3.4, h = 8.6, doors = 1, louvers = false, legs = false, crown = true, tilt = 0 }, -- 심층 미로: 낡은 벽장
	hotelcloset = { w = 5.0, d = 3.2, h = 8.2, doors = 2, louvers = false, legs = true, crown = true, tilt = 0 }, -- 호텔: 객실 옷장
	cubby = { w = 4.4, d = 3.0, h = 6.6, doors = 2, louvers = false, legs = true, crown = false, tilt = 0.02 }, -- 폐유치원: 낮은 어린이 사물함(몸을 웅크려 들어간다)
}
Hiding.Styles = STYLES

-- cf: 바닥 높이, 문이 향하는 쪽이 LookVector
local function buildModel(parent: Instance, cf: CFrame, s: Style): (Model, BasePart)
	local m = Instance.new("Model")
	m.Name = "HideSpot"
	local t = 0.25
	local y0 = if s.legs then 0.5 else 0
	local function box(local_: CFrame, size: Vector3, opts: Kit.Opts?): Part
		return Kit.box(m, cf * CFrame.Angles(0, 0, s.tilt) * local_, size, opts)
	end
	local h, w, d = s.h, s.w, s.d
	-- 몸통: 뒤판, 옆판, 지붕, 바닥판(속은 비어 있다)
	box(CFrame.new(0, y0 + h / 2, d / 2 - t / 2), Vector3.new(w, h, t))
	for _, sx in { -1, 1 } do
		box(CFrame.new(sx * (w / 2 - t / 2), y0 + h / 2, 0), Vector3.new(t, h, d))
	end
	box(CFrame.new(0, y0 + h - t / 2, 0), Vector3.new(w, t, d))
	box(CFrame.new(0, y0 + t / 2, 0), Vector3.new(w, t, d), { collide = false })
	if s.legs then
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				box(CFrame.new(sx * (w / 2 - 0.3), y0 / 2, sz * (d / 2 - 0.3)), Vector3.new(0.3, y0, 0.3), { blocks = false })
			end
		end
	end
	if s.crown then
		box(CFrame.new(0, y0 + h + 0.2, -0.1), Vector3.new(w + 0.4, 0.4, d + 0.2), { blocks = false })
	end
	-- 문(앞쪽, -Z): 틀 + 문짝 + 환기 살(숨은 사람이 틈으로 밖을 본다)
	local front = -d / 2 + t / 2
	local doorW = (w - t * 2) / s.doors
	local doorPart: BasePart? = nil
	for k = 1, s.doors do
		local cx = -w / 2 + t + doorW * (k - 0.5)
		local top = y0 + h - t
		if s.louvers then
			-- 아래쪽 판 + 위쪽 살(사이가 비어 있다)
			local solidH = (top - y0) * 0.55
			local p = box(CFrame.new(cx, y0 + solidH / 2, front), Vector3.new(doorW - 0.06, solidH, t), { name = "HideDoor" })
			doorPart = doorPart or p
			local slats = 7
			local span = top - (y0 + solidH)
			for q = 1, slats do
				local sy = y0 + solidH + span * (q - 0.5) / slats
				box(CFrame.new(cx, sy, front) * CFrame.Angles(math.rad(-25), 0, 0), Vector3.new(doorW - 0.06, span / slats * 0.55, 0.12), { blocks = false })
			end
			-- 문 가장자리 세로 틀
			for _, sx in { -1, 1 } do
				box(CFrame.new(cx + sx * (doorW / 2 - 0.1), y0 + solidH + span / 2, front), Vector3.new(0.2, span, t), { blocks = false })
			end
		else
			-- 판자 문 + 눈높이 틈 하나
			local gapY = y0 + 5.6
			local p = box(CFrame.new(cx, (y0 + gapY - 0.25) / 2, front), Vector3.new(doorW - 0.06, gapY - 0.25 - y0, t), { name = "HideDoor" })
			doorPart = doorPart or p
			box(CFrame.new(cx, (gapY + 0.25 + top) / 2, front), Vector3.new(doorW - 0.06, top - gapY - 0.25, t))
			for q = 1, 3 do
				box(CFrame.new(cx - doorW / 2 + doorW * q / 4, (y0 + top) / 2, front - 0.15), Vector3.new(0.08, top - y0 - 0.4, 0.08), { blocks = false, collide = false })
			end
		end
		-- 손잡이
		local hx = if s.doors == 2 then (if k == 1 then cx + doorW / 2 - 0.35 else cx - doorW / 2 + 0.35) else cx + doorW / 2 - 0.4
		box(CFrame.new(hx, y0 + 3.6, front - 0.25), Vector3.new(0.12, 0.9, 0.18), { blocks = false, collide = false })
	end
	m.Parent = parent
	return m, doorPart :: BasePart
end

local function rootHeight(char: Model): number
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hum and root then
		return hum.HipHeight + root.Size.Y / 2
	end
	return 3
end

local function clear(player: Player)
	local spot = occupied[player]
	if spot then
		spot.occupant = nil
		occupied[player] = nil
	end
	if player:GetAttribute("Hidden") then
		player:SetAttribute("Hidden", false)
	end
end

function Hiding.enter(player: Player, spot: Spot): boolean
	if player:GetAttribute("Status") ~= "Alive" or spot.occupant or occupied[player] then
		return false
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not char or not root then
		return false
	end
	spot.occupant = player
	occupied[player] = spot
	root.AssemblyLinearVelocity = Vector3.zero
	root.Anchored = true
	local p = spot.center + Vector3.new(0, rootHeight(char), 0) - spot.facing * 0.15
	char:PivotTo(CFrame.lookAt(p, p + spot.facing))
	player:SetAttribute("Hidden", true)
	SoundBus.emit(spot.front + Vector3.new(0, 3, 0), Config.Hide.Noise, player, "Hide")
	for _, fn in table.clone(hideListeners) do
		task.spawn(fn, player, spot)
	end
	return true
end

function Hiding.exit(player: Player): boolean
	local spot = occupied[player]
	if not spot then
		return false
	end
	clear(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if char and root then
		local p = spot.front + Vector3.new(0, rootHeight(char), 0)
		char:PivotTo(CFrame.lookAt(p, p + spot.facing))
		root.Anchored = false
	end
	SoundBus.emit(spot.front + Vector3.new(0, 3, 0), Config.Hide.Noise, player, "Hide")
	return true
end

function Hiding.spotOf(player: Player): Spot?
	return occupied[player]
end

function Hiding.all(): { Spot }
	return spots
end

-- 누가 숨었을 때(괴물이 그 모습을 봤는지 판단)
function Hiding.onHide(fn: (Player, Spot) -> ())
	table.insert(hideListeners, fn)
end

-- pos: 타일 가운데 바닥, back: 벽 쪽 방향(단위 벡터)
function Hiding.create(parent: Instance, pos: Vector3, back: Vector3, styleName: string?): Spot
	local s = STYLES[styleName or "locker"] or STYLES.locker
	local facing = -back
	local center = pos + back * (Config.Hide.Tile / 2 - s.d / 2 - 0.1)
	local cf = CFrame.lookAt(center, center + facing) -- (LookVector = -Z = 문 쪽, +Z = 벽 쪽 뒤판)
	local model, door = buildModel(parent, cf, s)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "숨기"
	prompt.ObjectText = ""
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Config.Hide.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("HideSpot", true)
	prompt.Parent = door
	CollectionService:AddTag(model, Config.Tags.HideSpot)
	local spot: Spot = {
		model = model,
		center = center,
		facing = facing,
		front = center + facing * (s.d / 2 + 2.4),
		prompt = prompt,
		occupant = nil,
	}
	table.insert(spots, spot)
	prompt.Triggered:Connect(function(player)
		if occupied[player] == spot then
			Hiding.exit(player)
		elseif not occupied[player] then
			Hiding.enter(player, spot)
		end
	end)
	model.Destroying:Connect(function()
		local i = table.find(spots, spot)
		if i then
			table.remove(spots, i)
		end
		if spot.occupant then
			clear(spot.occupant)
		end
	end)
	return spot
end

-- 죽거나 탈출하거나 새 캐릭터가 생기면 숨은 상태를 푼다
local function watch(p: Player)
	p:GetAttributeChangedSignal("Status"):Connect(function()
		if p:GetAttribute("Status") ~= "Alive" then
			clear(p)
		end
	end)
	p.CharacterAdded:Connect(function()
		clear(p)
	end)
end
for _, p in Players:GetPlayers() do
	watch(p)
end
Players.PlayerAdded:Connect(watch)
Players.PlayerRemoving:Connect(clear)

return Hiding
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="231">
        <Properties>
          <string name="Name">HomeProps</string>
          <string name="Source"><![CDATA[--!strict
-- 서브 괴물 자기 자리에 맵에 없던 소품을 더 놓는다(Shared/CreatureHomes 의 prop): 욕조 · 칠판 · 풍금 · 모빌 달린 아기 침대 · 천장 봉.
-- 스테이지를 지을 때(폴더가 workspace 에 들어가기 전) 같이 만들어서 음파 선에 다른 소품처럼 그려진다. 부딪히지 않는다(길을 막지 않게).
local Kit = require(script.Parent.MapKit)

local HomeProps = {}
local T = 8
local NC = { blocks = false, collide = false }

local function box(m: Instance, cf: CFrame, size: Vector3)
	Kit.box(m, cf, size, NC)
end
local function rod(m: Instance, a: Vector3, b: Vector3, r: number)
	local p = Kit.cylinder(m, a, b, r)
	p.CanCollide = false
end
local function ball(m: Instance, c: Vector3, r: number)
	local p = Kit.ball(m, c, r)
	p.CanCollide = false
end

local P: { [string]: (m: Model, cf: CFrame) -> () } = {}

-- 다리 달린 욕조(클로풋)
P.Bathtub = function(m, cf)
	local L, W, Hh, t = 6, 2.8, 2.2, 0.25
	local o = cf * CFrame.new(0, 0.8, 0)
	box(m, o * CFrame.new(0, 0, 0), Vector3.new(W, t, L)) -- 바닥
	box(m, o * CFrame.new(W / 2, Hh / 2, 0), Vector3.new(t, Hh, L))
	box(m, o * CFrame.new(-W / 2, Hh / 2, 0), Vector3.new(t, Hh, L))
	box(m, o * CFrame.new(0, Hh / 2, L / 2), Vector3.new(W, Hh, t))
	box(m, o * CFrame.new(0, Hh / 2, -L / 2), Vector3.new(W, Hh * 1.2, t))
	for _, s in { { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } } do
		ball(m, (o * CFrame.new(s[1] * (W / 2 - 0.3), -0.45, s[2] * (L / 2 - 0.5))).Position, 0.35)
	end
	rod(m, (o * CFrame.new(0, Hh * 1.2, -L / 2)).Position, (o * CFrame.new(0, Hh * 1.2 + 1.2, -L / 2 - 0.4)).Position, 0.12) -- 수도꼭지
end

-- 칠판 + 분필 받침 + 교탁
P.Blackboard = function(m, cf)
	local o = cf * CFrame.new(0, 0, -T / 2 + 0.4) -- 칸 뒤쪽 벽에 붙여
	box(m, o * CFrame.new(0, 6, 0), Vector3.new(12, 4.5, 0.25))
	box(m, o * CFrame.new(0, 6, 0.05), Vector3.new(12.6, 5.1, 0.12)) -- 테두리
	box(m, o * CFrame.new(0, 3.6, 0.35), Vector3.new(12, 0.15, 0.5)) -- 분필 받침
	box(m, o * CFrame.new(0, 1.8, 3.2), Vector3.new(4, 3.6, 2)) -- 교탁
end

-- 풍금(페달 오르간): 몸통 · 건반 · 악보대 · 페달
P.Organ = function(m, cf)
	local o = cf * CFrame.new(0, 0, -T / 2 + 1.4)
	box(m, o * CFrame.new(0, 1.9, 0), Vector3.new(5, 3.8, 1.8))
	box(m, o * CFrame.new(0, 3.1, 1.2), Vector3.new(4.6, 0.25, 0.8)) -- 건반
	for k = -9, 9 do
		box(m, o * CFrame.new(k * 0.24, 3.27, 1.25), Vector3.new(0.12, 0.08, 0.6))
	end
	box(m, o * CFrame.new(0, 4.6, -0.3), Vector3.new(4.4, 1.6, 0.2)) -- 악보대
	box(m, o * CFrame.new(-0.8, 0.3, 1.2) * CFrame.Angles(-0.3, 0, 0), Vector3.new(1, 0.15, 1.4)) -- 페달
	box(m, o * CFrame.new(0.8, 0.3, 1.2) * CFrame.Angles(-0.3, 0, 0), Vector3.new(1, 0.15, 1.4))
	box(m, o * CFrame.new(0, 1.2, 3), Vector3.new(2.6, 0.3, 1.2)) -- 의자
end

-- 아기 침대(난간 살) + 천장에 매단 모빌
P.CribMobile = function(m, cf)
	local L, W, Hh = 4.4, 2.6, 3
	box(m, cf * CFrame.new(0, 1, 0), Vector3.new(W, 0.3, L))
	for _, x in { -W / 2, W / 2 } do
		rod(m, (cf * CFrame.new(x, Hh, -L / 2)).Position, (cf * CFrame.new(x, Hh, L / 2)).Position, 0.08)
		for k = 0, 8 do
			local z = -L / 2 + k * L / 8
			rod(m, (cf * CFrame.new(x, 0, z)).Position, (cf * CFrame.new(x, Hh, z)).Position, 0.06)
		end
	end
	for _, z in { -L / 2, L / 2 } do
		rod(m, (cf * CFrame.new(-W / 2, Hh, z)).Position, (cf * CFrame.new(W / 2, Hh, z)).Position, 0.08)
	end
	-- 모빌: 천장에서 내려온 줄 · 십자 팔 · 매달린 인형들
	local top = cf * CFrame.new(0, 13.6, 0)
	local hub = cf * CFrame.new(0, 8.6, 0)
	rod(m, top.Position, hub.Position, 0.05)
	for k = 0, 5 do
		local a = k * math.pi / 3
		local tip = hub * CFrame.new(math.cos(a) * 2.2, 0, math.sin(a) * 2.2)
		rod(m, hub.Position, tip.Position, 0.06)
		rod(m, tip.Position, (tip * CFrame.new(0, -1.4, 0)).Position, 0.03)
		ball(m, (tip * CFrame.new(0, -1.75, 0)).Position, 0.35)
		ball(m, (tip * CFrame.new(0, -2.3, 0)).Position, 0.25)
	end
end

-- 천장 가까이 가로지른 봉(덮개가 매달린다)
P.HangBar = function(m, cf)
	local a = cf * CFrame.new(0, 12.2, -T * 1.5)
	local b = cf * CFrame.new(0, 12.2, T * 1.5)
	rod(m, a.Position, b.Position, 0.25)
	for _, c in { a, b, cf * CFrame.new(0, 12.2, 0) } do
		rod(m, c.Position, (c * CFrame.new(0, 1.8, 0)).Position, 0.12) -- 천장 고정대
	end
end

-- 칸 (i, j) 의 바닥 높이: 그 칸의 배회 지점(바닥 + 3) 중 band 에 맞는 것
local function floorAt(nodes: { Vector3 }, i: number, j: number, band: string?): number?
	local low = math.huge
	for _, p in nodes do
		low = math.min(low, p.Y)
	end
	local best, bd = nil, math.huge
	local c = Vector3.new((i - 0.5) * T, 0, (j - 0.5) * T)
	for _, p in nodes do
		local okBand = band == nil or (band == "upper" and p.Y > low + 8) or (band == "lower" and p.Y <= low + 8)
		if okBand then
			local d = (Vector3.new(p.X, 0, p.Z) - c).Magnitude
			if d < bd then
				best, bd = p.Y - 3, d
			end
		end
	end
	return best
end

-- 이번 스테이지의 서브 괴물들 자리에 소품을 놓는다
function HomeProps.place(info: any, homes: { [string]: any }, ids: { string }, parent: Instance): number
	local n = 0
	for _, id in ids do
		local h = homes[id]
		local make = h and h.prop and P[h.prop]
		if make then
			local ci = math.floor((h.rect[1] + h.rect[3]) / 2)
			local cj = math.floor((h.rect[2] + h.rect[4]) / 2)
			local y = floorAt(info.nodes, ci, cj, h.band)
			if y then
				local m = Instance.new("Model")
				m.Name = "Home_" .. h.prop
				m:SetAttribute("HomeOf", id)
				m.Parent = parent
				make(m, CFrame.new((ci - 0.5) * T, y, (cj - 0.5) * T))
				n += 1
			end
		end
	end
	return n
end

return HomeProps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="232">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[--!strict
-- 로비와 방.
--   · 서버가 시작되면: 예약 서버(방에서 텔레포트로 온 게임 서버)면 바로 게임, 아니면 로비.
--   · 로비: 방 만들기 / 참가 / 나가기 / 시작(방장만) / 친구만(방장만, 켜면 방장의 친구만 참가). 방 목록은 ReplicatedStorage 속성 "Rooms"(JSON), 내 방은 Player 속성 "RoomId".
--   · 시작: 게임에서는 방 사람들을 새 예약 서버로 텔레포트(방마다 따로 플레이).
--           Studio(텔레포트 불가)에서는 이 서버에서 그 방 사람들로 바로 시작하고, 다 깨면 로비로 돌아온다.
-- 클라이언트 요청: Remotes.RoomAction:FireServer(action, arg)  action = "create" | "join"(arg = 방 번호) | "leave" | "start" | "friendsOnly"(arg = true/false)
-- 친구 초대는 클라이언트가 SocialService 초대 창으로 한다(초대받은 친구는 이 로비 서버로 들어온다).

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local Config = require(ReplicatedStorage.Shared.Config)
local Round = require(script.Parent.Round)
local Rejoin = require(script.Parent.Rejoin)
local RateLimit = require(script.Parent.RateLimit)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RoomAction = Remotes:WaitForChild("RoomAction") :: RemoteEvent
local RoundEvent = Remotes:WaitForChild("RoundEvent") :: RemoteEvent

local Lobby = {}

type Room = { id: number, host: Player, members: { Player }, started: boolean, friendsOnly: boolean }
local rooms: { [number]: Room } = {}
local nextId = 0
Lobby.rooms = rooms

local function publish()
	local list = {}
	for _, r in rooms do
		local names, ids = {}, {}
		for _, m in r.members do
			table.insert(names, m.DisplayName)
			table.insert(ids, m.UserId)
		end
		table.insert(list, { id = r.id, host = r.host.DisplayName, hostId = r.host.UserId, names = names, ids = ids, started = r.started, friendsOnly = r.friendsOnly, max = Config.Lobby.MaxPlayers })
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	ReplicatedStorage:SetAttribute("Rooms", HttpService:JSONEncode(list))
end

local function message(p: Player, text: string)
	RoundEvent:FireClient(p, "RoomMsg", { text = text })
end

local function roomOf(p: Player): Room?
	local id = p:GetAttribute("RoomId")
	return if type(id) == "number" then rooms[id] else nil
end

local function leave(p: Player)
	local r = roomOf(p)
	p:SetAttribute("RoomId", nil)
	if not r then
		return
	end
	local i = table.find(r.members, p)
	if i then
		table.remove(r.members, i)
	end
	if #r.members == 0 then
		rooms[r.id] = nil
	elseif r.host == p then
		r.host = r.members[1] -- 방장이 나가면 다음 사람이 방장
		message(r.host, "방장이 되었습니다")
	end
	publish()
end

local function join(p: Player, r: Room): boolean
	if r.started then
		message(p, "이미 시작한 방입니다")
		return false
	end
	if #r.members >= Config.Lobby.MaxPlayers then
		message(p, "방이 가득 찼습니다")
		return false
	end
	if r.friendsOnly and p ~= r.host then
		local ok, friend = pcall(p.IsFriendsWith, p, r.host.UserId)
		if not (ok and friend) then
			message(p, "방장의 친구만 들어올 수 있는 방입니다")
			return false
		end
	end
	leave(p)
	table.insert(r.members, p)
	p:SetAttribute("RoomId", r.id)
	publish()
	return true
end

-- 이 서버에서 그 방 사람들로 게임을 시작한다(Studio, 또는 텔레포트를 쓸 수 없을 때)
function Lobby.startLocal(r: Room)
	local members = {}
	for _, m in r.members do
		members[m] = true
	end
	-- 로비 맵이 사라지므로 다른 방은 모두 닫는다(그 사람들은 게임이 끝날 때까지 기다린다)
	for id, other in rooms do
		for _, m in other.members do
			m:SetAttribute("RoomId", nil)
			if not members[m] then
				message(m, "다른 방이 이 서버에서 게임 중입니다. 끝나면 로비로 돌아옵니다")
			end
		end
		rooms[id] = nil
	end
	publish()
	Round.members = members
	Round.returnToLobby = true
	Round.stageIndex = 1
	task.spawn(Round.loop)
end

local function startTeleport(r: Room)
	local ok, err = pcall(function()
		local code = TeleportService:ReserveServer(game.PlaceId)
		local options = Instance.new("TeleportOptions")
		options.ReservedServerAccessCode = code
		options:SetTeleportData({ room = r.id, code = code }) -- (code: 끊긴 사람이 다시 돌아오게 게임 서버가 기억한다)
		TeleportService:TeleportAsync(game.PlaceId, r.members, options)
	end)
	if not ok then
		r.started = false
		publish()
		for _, m in r.members do
			message(m, "시작하지 못했습니다(텔레포트 실패). 다시 눌러 주세요")
		end
		warn("[Lobby] teleport failed: " .. tostring(err))
	end
end

local function start(p: Player)
	local r = roomOf(p)
	if not r then
		return
	end
	if r.host ~= p then
		message(p, "방장만 시작할 수 있습니다")
		return
	end
	if r.started then
		return
	end
	if #r.members < Config.Lobby.MinPlayers then
		message(p, string.format("%d명 이상이어야 시작합니다", Config.Lobby.MinPlayers))
		return
	end
	r.started = true
	publish()
	for _, m in r.members do
		RoundEvent:FireClient(m, "RoomStarting", { id = r.id })
	end
	if Lobby.localStart() then
		Lobby.startLocal(r)
	else
		startTeleport(r)
	end
end

-- 텔레포트 대신 이 서버에서 시작하는가(Studio 에서는 텔레포트가 안 된다)
function Lobby.localStart(): boolean
	return RunService:IsStudio() or Config.Lobby.LocalStart == true
end

-- 방에서 텔레포트로 온 게임 서버인가(예약 서버)
function Lobby.isGameServer(): boolean
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
end

function Lobby.act(p: Player, action: any, arg: any)
	if Round.state ~= "Lobby" or type(action) ~= "string" then
		return
	end
	-- (방 목록 변경은 모두에게 복제된다: 만들기·나가기를 빠르게 되풀이해도 초당 몇 번만)
	if not RateLimit.allow(p, "RoomAction", 4, 8) then
		return
	end
	if action == "create" then
		if roomOf(p) then
			return
		end
		nextId += 1
		local r: Room = { id = nextId, host = p, members = {}, started = false, friendsOnly = false }
		rooms[r.id] = r
		join(p, r)
	elseif action == "join" then
		local r = if type(arg) == "number" then rooms[arg] else nil
		if r and roomOf(p) ~= r then
			join(p, r)
		end
	elseif action == "leave" then
		leave(p)
	elseif action == "start" then
		start(p)
	elseif action == "friendsOnly" then
		local r = roomOf(p)
		if r and r.host == p then
			r.friendsOnly = arg == true
			publish()
		end
	end
end

RoomAction.OnServerEvent:Connect(Lobby.act)
Players.PlayerRemoving:Connect(leave)

-- 서버 시작: 첫 플레이어가 들어오면 모드를 정한다(테스트는 ReplicatedStorage 속성 ForceMode 로 고른다)
function Lobby.boot()
	while #Players:GetPlayers() == 0 do
		task.wait(0.2)
	end
	local force = ReplicatedStorage:GetAttribute("ForceMode")
	local mode = if force == "Game" or force == "Lobby" then force elseif Lobby.isGameServer() then "Game" else "Lobby"
	if mode == "Game" then
		ReplicatedStorage:SetAttribute("Mode", "Game")
		-- 끊긴 사람이 다시 켜면 이 게임으로 돌아오게: 들어온 사람마다 기록, 30초마다 갱신
		for _, p in Players:GetPlayers() do
			Rejoin.arrived(p)
		end
		Players.PlayerAdded:Connect(Rejoin.arrived)
		Rejoin.startHeartbeat()
		Round.loop()
	else
		publish()
		-- 진행 중인 게임에서 끊겼던 사람은 그 게임(예약 서버)으로 바로 돌려보낸다
		local function tryRejoin(p: Player)
			local code = Rejoin.lookup(p.UserId)
			if not code then
				return
			end
			message(p, "진행 중이던 게임으로 다시 연결합니다…")
			local ok, err = pcall(function()
				local options = Instance.new("TeleportOptions")
				options.ReservedServerAccessCode = code
				options:SetTeleportData({ room = 0, code = code, rejoin = true })
				TeleportService:TeleportAsync(game.PlaceId, { p }, options)
			end)
			if not ok then
				Rejoin.forget(p.UserId)
				message(p, "다시 연결하지 못했습니다. 새 방을 만들어 주세요")
				warn("[Lobby] rejoin failed: " .. tostring(err))
			end
		end
		for _, p in Players:GetPlayers() do
			task.spawn(tryRejoin, p)
		end
		Players.PlayerAdded:Connect(function(p)
			task.spawn(tryRejoin, p)
		end)
		Round.enterLobby()
	end
end

publish()
return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="233">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- 서버 진입점(ServerScriptService.Server.Main)
--   · 완전한 어둠 조명 강제
--   · 음파 발사 검증(발사 간격·생존 여부, 위치는 서버가 캐릭터 머리에서 정한다) → 다른 클라이언트에 전달 + 괴물에게 소리
--   · 이동 모드(걷기/달리기/웅크리기) 요청 처리
--   · 로비(방) 또는 게임 시작(Lobby.boot)

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local SoundBus = require(script.Parent.SoundBus)
local Round = require(script.Parent.Round)
local RateLimit = require(script.Parent.RateLimit)
local RateLimit = require(script.Parent.RateLimit)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SonarFire = Remotes:WaitForChild("SonarFire") :: RemoteEvent
local SonarPulse = Remotes:WaitForChild("SonarPulse") :: RemoteEvent
local SetMoveMode = Remotes:WaitForChild("SetMoveMode") :: RemoteEvent

-- ── 어둠: 환경광·하늘빛·반사 없음 ──
Lighting.Brightness = 0
Lighting.Ambient = Color3.new(0, 0, 0)
Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
Lighting.EnvironmentDiffuseScale = 0
Lighting.EnvironmentSpecularScale = 0
Lighting.ClockTime = 0
Lighting.GlobalShadows = false
Lighting.FogEnd = 100000
for _, d in Lighting:GetChildren() do
	if d:IsA("Atmosphere") or d:IsA("Clouds") then
		d:Destroy()
	end
end

-- ── 음파 ──
local lastPulse: { [Player]: number } = {}
local accepted: { [Player]: number } = {}
local Sonar = {}
Sonar.accepted = accepted

-- ── 시선 공유(관전용): 각 플레이어가 보내는 카메라 방향(좌우 yaw·위아래 pitch, 라디안)을 속성으로 퍼뜨린다 ──
local LookShare = Remotes:WaitForChild("LookShare") :: RemoteEvent
LookShare.OnServerEvent:Connect(function(player: Player, yaw: any, pitch: any)
	if not RateLimit.allow(player, "LookShare", 15, 20) then
		return -- (클라이언트는 초당 최대 10번 보낸다)
	end
	if not RateLimit.allow(player, "LookShare", 15, 20) then
		return -- (클라이언트는 초당 최대 10번 보낸다)
	end
	if type(yaw) ~= "number" or type(pitch) ~= "number" or yaw ~= yaw or pitch ~= pitch then
		return
	end
	-- (같은 값이면 속성을 다시 쓰지 않는다: 복제 트래픽)
	local y, p = math.clamp(yaw, -10, 10), math.clamp(pitch, -1.5, 1.5)
	if player:GetAttribute("LookYaw") ~= y then
		player:SetAttribute("LookYaw", y)
	end
	if player:GetAttribute("LookPitch") ~= p then
		player:SetAttribute("LookPitch", p)
	end
end)

SonarFire.OnServerEvent:Connect(function(player: Player)
	if player:GetAttribute("Status") ~= "Alive" or player:GetAttribute("Hidden") then
		return
	end
	local char = player.Character
	local head = char and (char:FindFirstChild("Head") :: BasePart?)
	if not head then
		return
	end
	-- 간격 검증(여럿이 하거나 휴대폰이라 요청이 늦게·몰려 도착해도 정상 발사는 받아 준다):
	-- "다음 발사 허용 시각"을 쌓아 가며, 그보다 ServerTolerance 까지 일찍 온 것은 받는다. 평균으로는 Cooldown 보다 빨리 쏠 수 없다
	local now = os.clock()
	local tat = lastPulse[player] or -math.huge
	local cd = Config.Sonar.Cooldown
	if now < tat - Config.Sonar.ServerTolerance then
		return -- 간격 위반: 무시(시각 효과는 그 클라이언트에만 있고 괴물·다른 플레이어에게는 없음)
	end
	lastPulse[player] = math.max(tat, now) + cd
	accepted[player] = (accepted[player] or 0) + 1
	local origin = head.Position
	for _, other in Players:GetPlayers() do
		if other ~= player then
			SonarPulse:FireClient(other, player.UserId, origin)
		end
	end
	SoundBus.emit(origin, Config.Noise.Sonar, player, "Sonar")
end)

-- ── 이동 모드(소리·시점 표시용 속성. 실제 소음 크기는 서버가 속도로 판정) ──
local MODES = { Walk = Config.Move.Walk, Run = Config.Move.Run, Crouch = Config.Move.Crouch }
SetMoveMode.OnServerEvent:Connect(function(player: Player, mode: any)
	if not RateLimit.allow(player, "SetMoveMode", 8, 12) then
		return
	end
	if not RateLimit.allow(player, "SetMoveMode", 8, 12) then
		return
	end
	if type(mode) ~= "string" or not MODES[mode] then
		return
	end
	local char = player.Character
	if not char or player:GetAttribute("Status") ~= "Alive" then
		return
	end
	char:SetAttribute("MoveMode", mode)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = MODES[mode]
	end
end)

Players.PlayerRemoving:Connect(function(p)
	lastPulse[p] = nil
	accepted[p] = nil
end)

-- 테스트 하네스가 읽는 값
_G.SonarMaze = { Round = Round, Sonar = Sonar, SoundBus = SoundBus }

-- 로비(방 만들기) 또는 게임 서버로 시작
local Lobby = require(script.Parent.Lobby)
task.spawn(Lobby.boot)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="234">
        <Properties>
          <string name="Name">MapKit</string>
          <string name="Source"><![CDATA[--!strict
-- 모듈형 구조물 키트: 모든 스테이지가 같은 부품으로 맵을 짓는다.
-- 모든 구조물은 검은색 무광, 조명 없음. SonarRenderable 태그가 붙어 음파 윤곽선 대상이 된다.
-- 원통(파이프·난간)은 Shape = Cylinder 그대로라서 음파 렌더러가 원통 모양(끝 원 + 실루엣)으로 그린다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Kit = {}
local TAG = Config.Tags.Renderable
local BLACK = Color3.new(0, 0, 0)

export type Opts = {
	collide: boolean?,
	tag: boolean?, -- false 면 음파 대상 아님(보이지 않는 충돌 경사로 등)
	invisible: boolean?,
	shape: string?, -- SonarShape 속성
	axis: string?, -- SonarEdgeAxis 속성
	rings: number?,
	blocks: boolean?, -- SonarBlocks: 음파·소리 전파를 막는가(nil 이면 크기로 판단)
	name: string?,
}

local function base(p: BasePart, parent: Instance, opts: Opts?)
	local o = opts or {}
	p.Anchored = true
	p.Color = BLACK
	p.Material = Enum.Material.SmoothPlastic
	p.Reflectance = 0
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = if o.collide == nil then true else o.collide
	p.CanTouch = false
	-- 부딪히지 않고 음파·소리도 막지 않는 장식은 공간 쿼리에서도 뺀다(서버 소리·괴물 레이, 클라 Reveal 은 RespectCanCollide,
	-- 음파 윤곽은 태그·지오메트리만 쓴다 — opt-sonar 확인). SearchLook 은 손잡이 뒤 서랍 판(충돌)으로 같은 Comp 를 맞힌다.
	p.CanQuery = p.CanCollide or o.blocks == true
	if o.invisible then
		p.Transparency = 1
	end
	if o.shape then
		p:SetAttribute("SonarShape", o.shape)
	end
	if o.axis then
		p:SetAttribute("SonarEdgeAxis", o.axis)
	end
	if o.rings then
		p:SetAttribute("SonarRings", o.rings)
	end
	if o.blocks ~= nil then
		p:SetAttribute("SonarBlocks", o.blocks)
	end
	if o.name then
		p.Name = o.name
	end
	if o.tag ~= false and not o.invisible then
		CollectionService:AddTag(p, TAG)
	end
	p.Parent = parent
end

function Kit.box(parent: Instance, cf: CFrame, size: Vector3, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	base(p, parent, opts)
	return p
end

-- 두 모서리 좌표(최소·최대)로 축 정렬 상자
function Kit.span(parent: Instance, lo: Vector3, hi: Vector3, opts: Opts?): Part
	local a = Vector3.new(math.min(lo.X, hi.X), math.min(lo.Y, hi.Y), math.min(lo.Z, hi.Z))
	local b = Vector3.new(math.max(lo.X, hi.X), math.max(lo.Y, hi.Y), math.max(lo.Z, hi.Z))
	return Kit.box(parent, CFrame.new((a + b) / 2), b - a, opts)
end

function Kit.wedge(parent: Instance, cf: CFrame, size: Vector3, opts: Opts?): WedgePart
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = cf
	base(p, parent, opts)
	return p
end

-- a 에서 b 까지 원통(반지름 r)
function Kit.cylinder(parent: Instance, a: Vector3, b: Vector3, r: number, opts: Opts?): Part
	local d = b - a
	local len = d.Magnitude
	local dir = d / len
	local up = if math.abs(dir.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(len, r * 2, r * 2)
	p.CFrame = CFrame.fromMatrix((a + b) / 2, dir, dir:Cross(up).Unit:Cross(dir))
	base(p, parent, opts)
	return p
end

function Kit.ball(parent: Instance, c: Vector3, r: number, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(r * 2, r * 2, r * 2)
	p.CFrame = CFrame.new(c)
	base(p, parent, opts)
	return p
end

-- 배관: 본체 + 양 끝 플랜지(+ 볼트). flangeEvery 마다 중간 플랜지.
function Kit.pipe(parent: Instance, a: Vector3, b: Vector3, r: number, flangeAt: { number }?, bolts: boolean?)
	local m = Instance.new("Model")
	m.Name = "Pipe"
	m.Parent = parent
	Kit.cylinder(m, a, b, r, { blocks = r >= 0.9 })
	local dir = (b - a).Unit
	local len = (b - a).Magnitude
	for _, t in flangeAt or { 0, 1 } do
		local c = a + dir * (math.clamp(t * len, 0.2, len - 0.2))
		local fr = r * 1.35 + 0.08
		local fl = Kit.cylinder(m, c - dir * 0.18, c + dir * 0.18, fr, { blocks = false })
		if bolts and fr >= 0.6 then
			-- 볼트: 플랜지 둘레의 작은 원통 6개
			local up = if math.abs(dir.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis
			local u = dir:Cross(up).Unit
			local w = dir:Cross(u).Unit
			for i = 0, 5 do
				local ang = i / 6 * math.pi * 2 + 0.3
				local bp = c + (u * math.cos(ang) + w * math.sin(ang)) * (fr - 0.17)
				Kit.cylinder(m, bp - dir * 0.3, bp + dir * 0.3, 0.09, { blocks = false, collide = false })
			end
		end
		local _ = fl
	end
	return m
end

-- 난간: a → b (바닥 높이 기준), 기둥 간격 step
function Kit.railing(parent: Instance, a: Vector3, b: Vector3, height: number?, step: number?)
	local h = height or 3.3
	local st = step or 2.6
	local m = Instance.new("Model")
	m.Name = "Railing"
	m.Parent = parent
	local d = b - a
	local len = d.Magnitude
	local n = math.max(1, math.floor(len / st + 0.5))
	for i = 0, n do
		local p = a + d * (i / n)
		Kit.cylinder(m, p, p + Vector3.new(0, h, 0), 0.11, { blocks = false })
	end
	local up = Vector3.new(0, h, 0)
	Kit.cylinder(m, a + up, b + up, 0.13, { blocks = false })
	Kit.cylinder(m, a + up * 0.5, b + up * 0.5, 0.09, { blocks = false })
	-- 발끝 막이(얇은 판)
	local dir = d.Unit
	local cf = CFrame.lookAt((a + b) / 2 + Vector3.new(0, 0.2, 0), (a + b) / 2 + Vector3.new(0, 0.2, 0) + dir)
	Kit.box(m, cf, Vector3.new(0.1, 0.4, len), { blocks = false, collide = false })
	-- 보이지 않는 충돌 벽(떨어지지 않게)
	Kit.box(m, CFrame.lookAt((a + b) / 2 + up / 2, (a + b) / 2 + up / 2 + dir), Vector3.new(0.3, h, len), { invisible = true, tag = false })
	return m
end

-- 계단: bottomCenter(아래 첫 계단 앞 가운데, 바닥 높이) 에서 forward 방향으로 rise 만큼 올라간다.
-- 보이는 계단 판은 충돌 없음, 걷는 면은 보이지 않는 경사로.
function Kit.stairs(parent: Instance, bottomCenter: Vector3, forward: Vector3, width: number, rise: number, run: number, steps: number)
	local m = Instance.new("Model")
	m.Name = "Stairs"
	m.Parent = parent
	local f = Vector3.new(forward.X, 0, forward.Z).Unit
	local stepH = rise / steps
	local stepD = run / steps
	for i = 0, steps - 1 do
		local top = (i + 1) * stepH
		local c = bottomCenter + f * (stepD * (i + 0.5)) + Vector3.new(0, top / 2, 0)
		Kit.box(m, CFrame.lookAt(c, c + f), Vector3.new(width, top, stepD), { collide = false, blocks = i >= steps / 2 })
	end
	-- 경사로(쐐기): 경사가 forward 방향으로 올라가도록 뒤(+Z)를 forward 쪽으로
	local mid = bottomCenter + f * (run / 2) + Vector3.new(0, rise / 2, 0)
	Kit.wedge(m, CFrame.lookAt(mid, mid - f), Vector3.new(width, rise, run), { invisible = true, tag = false })
	return m
end

-- 아치 리브: center = 바닥 가운데, right = 가로 방향, 개구부 폭 2*inner, 스프링 높이 spring
-- 벽 사이에 걸치는 리브(기둥 + 반원 아치) 와 그 위 막힌 벽(header).
function Kit.archPortal(parent: Instance, center: Vector3, right: Vector3, span: number, spring: number, ceiling: number, ribDepth: number?)
	local m = Instance.new("Model")
	m.Name = "Arch"
	m.Parent = parent
	local depth = ribDepth or 1.4
	local r = right.Unit
	local fwd = r:Cross(Vector3.yAxis).Unit
	local half = span / 2
	local pier = 0.7
	local inner = half - pier
	local ring = 0.7
	local outer = inner + ring
	local basis = CFrame.fromMatrix(center, r, Vector3.yAxis) -- X = 가로, Z = 진행 방향
	-- 기둥(좌우)
	for _, s in { -1, 1 } do
		local x = s * (half - pier / 2)
		Kit.box(m, basis * CFrame.new(x, spring / 2, 0), Vector3.new(pier, spring, depth))
	end
	-- 반원 아치 조각
	local segs = 9
	for i = 0, segs - 1 do
		local a0 = math.pi * (i / segs)
		local a1 = math.pi * ((i + 1) / segs)
		local am = (a0 + a1) / 2
		local rm = (inner + outer) / 2
		local chord = 2 * outer * math.sin((a1 - a0) / 2)
		local px, py = math.cos(am) * rm, spring + math.sin(am) * rm
		local seg = basis * CFrame.new(px, py, 0) * CFrame.Angles(0, 0, am + math.pi / 2)
		Kit.box(m, seg, Vector3.new(chord, ring, depth), { axis = "X" })
	end
	-- 아치 위 막힌 벽(리브보다 얇게 → 리브가 튀어나와 윤곽이 보인다), 선 없는 채움
	local wallD = depth * 0.55
	local topY = spring + outer
	Kit.box(m, basis * CFrame.new(0, (topY + ceiling) / 2, 0), Vector3.new(span, ceiling - topY, wallD))
	-- 아치 옆 삼각 부분(스팬드럴)을 세로 띠로 채움
	local cols = 6
	for i = 0, cols - 1 do
		for _, s in { -1, 1 } do
			local x0 = (i / cols) * outer
			local x1 = ((i + 1) / cols) * outer
			-- (띠 바닥은 띠 구간에서 가장 낮은 아치 바깥 높이: 구멍 없이 아치 조각과 겹친다)
			local xm = math.min(x1, outer)
			local yArc = spring + math.sqrt(math.max(0, outer * outer - xm * xm)) - 0.05
			local h = topY - yArc
			if h > 0.05 then
				local cx = s * (x0 + x1) / 2
				Kit.box(m, basis * CFrame.new(cx, yArc + h / 2, 0), Vector3.new(x1 - x0 + 0.02, h, wallD), { shape = "None" })
			end
		end
		local _ = i
	end
	for _, s in { -1, 1 } do
		-- 바깥 원과 기둥 사이
		local x0, x1 = outer, half
		if x1 - x0 > 0.05 then
			Kit.box(m, basis * CFrame.new(s * (x0 + x1) / 2, (spring + topY) / 2, 0), Vector3.new(x1 - x0, topY - spring, wallD), { shape = "None" })
		end
	end
	return m
end

-- 상자(나무 상자 느낌: 모서리 + 가로 띠)
function Kit.crate(parent: Instance, bottom: Vector3, size: Vector3, yaw: number?)
	local cf = CFrame.new(bottom + Vector3.new(0, size.Y / 2, 0)) * CFrame.Angles(0, yaw or 0, 0)
	local b = Kit.box(parent, cf, size, { name = "Crate" })
	-- 가운데 띠
	Kit.box(parent, cf, Vector3.new(size.X + 0.12, 0.3, size.Z + 0.12), { blocks = false })
	return b
end

-- 글자(EXIT 표지): 막대 조합. origin = 글자 왼쪽 아래, right/up = 벽면 방향, 글자 높이 h
function Kit.letter(parent: Instance, ch: string, origin: Vector3, right: Vector3, out: Vector3, h: number)
	local w = h * 0.62
	local t = h * 0.14
	local depth = 0.35
	local up = Vector3.yAxis
	local function bar(x0: number, y0: number, x1: number, y1: number)
		local a = origin + right * x0 + up * y0 + out * (depth / 2)
		local b = origin + right * x1 + up * y1 + out * (depth / 2)
		local d = b - a
		local len = d.Magnitude
		local cf = CFrame.fromMatrix((a + b) / 2, d.Unit, out:Cross(d.Unit).Unit)
		Kit.box(parent, cf, Vector3.new(len + t, t, depth), { blocks = false, collide = false })
	end
	local ht = t / 2
	if ch == "E" then
		bar(ht, ht, ht, h - ht)
		bar(ht, h - ht, w - ht, h - ht)
		bar(ht, h / 2, w * 0.8 - ht, h / 2)
		bar(ht, ht, w - ht, ht)
	elseif ch == "X" then
		bar(ht, ht, w - ht, h - ht)
		bar(ht, h - ht, w - ht, ht)
	elseif ch == "I" then
		bar(w / 2, ht, w / 2, h - ht)
	elseif ch == "T" then
		bar(ht, h - ht, w - ht, h - ht)
		bar(w / 2, ht, w / 2, h - ht)
	end
	return w
end

function Kit.word(parent: Instance, text: string, center: Vector3, right: Vector3, out: Vector3, h: number)
	local gap = h * 0.3
	local w = h * 0.62
	local total = #text * w + (#text - 1) * gap
	local x = -total / 2
	for i = 1, #text do
		local ch = text:sub(i, i)
		Kit.letter(parent, ch, center + right * x - Vector3.new(0, h / 2, 0), right, out, h)
		x += w + gap
	end
end

return Kit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="235">
        <Properties>
          <string name="Name">Monster</string>
          <string name="Source"><![CDATA[--!strict
-- 괴물: 모델 생성 + AI(배회 → 소리 감지 → 수색 → 추격 → 추격 해제).
-- 보이지 않는 검은 몸. 음파가 닿으면 클라이언트가 몸의 윤곽선을 그린다(SonarDynamic).
-- 이동은 PathfindingService 경로만 따라가므로 벽을 통과하지 않는다. 막히면 경로를 다시 계산하고, 그래도 안 되면 목표를 바꾼다.

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local Faces = require(ReplicatedStorage.Shared.MonsterFaces)
local Doors = require(script.Parent.Doors)
local SoundBus = require(script.Parent.SoundBus)
local Hiding = require(script.Parent.Hiding)

local MC = Config.Monster

local Monster = {}
Monster.__index = Monster
-- 안전 구역(시작 방) 판정: Round 가 채운다. 그 안의 플레이어는 보지도 잡지도 않고, 그 안으로 들어가지 않는다
Monster.isSafe = function(_pos: Vector3): boolean
	return false
end
-- 살아 있는 괴물 전부(서로 몰리지 않게 거리를 본다)
Monster.registry = {} :: { any }
local SPREAD = 35 -- 배회 중 다른 괴물이 이 거리 안이면 반대쪽으로 간다
local SHARE_SOUND = 25 -- 같은 소리를 이미 다른 괴물이 이 거리 안으로 조사하러 가면 따라가지 않는다

export type State = "Wander" | "Alert" | "Investigate" | "Search" | "Chase" | "Disguise" | "Dormant" | "Look" | "Return"

-- ── 메인 괴물 몸: 모든 스테이지 같은 디자인(삼각 머리 구체관절, buildModel). 스테이지 번호(Voice)는 소리·추격 리듬만 바꾼다 ──

-- ── 몸 조립 공통: 팔·다리 묶음은 관절(Motor6D)에, 나머지는 루트에 붙인다. 몸은 완전히 투명(음파에만 드러난다) ──
-- prefix: 관절 이름 앞부분(같은 모델에 몸이 둘일 때 구분), holder: 관절 받침 파트를 둘 곳
local function rig(model: Model, root: BasePart, cf: CFrame, parts: { BasePart }, groupParts: { [string]: { BasePart } }, joints: { [string]: Vector3 }, prefix: string, holder: Instance?)
	local grouped: { [BasePart]: boolean } = {}
	for name, list in groupParts do
		local off = joints[name]
		if off then
			local pv = Instance.new("Part")
			pv.Name = "Pivot" .. name
			pv.Size = Vector3.new(0.2, 0.2, 0.2)
			pv.Transparency = 1
			pv.CanCollide = false
			pv.CanQuery = false
			pv.CanTouch = false
			pv.Massless = true
			pv.CFrame = cf * CFrame.new(off)
			pv.Parent = holder or model
			local motor = Instance.new("Motor6D")
			motor.Name = prefix .. name
			motor.Part0 = root
			motor.Part1 = pv
			motor.C0 = CFrame.new(off)
			motor.C1 = CFrame.identity
			motor.Parent = root
			for _, p in list do
				p.Anchored = false
				p.CanCollide = false
				p.CanQuery = false
				p.Massless = true
				local w = Instance.new("WeldConstraint")
				w.Part0 = pv
				w.Part1 = p
				w.Parent = p
				grouped[p] = true
			end
		end
	end
	for _, p in parts do
		if p.Name == "Part" then
			p.Name = "Body"
		end
		-- 몸은 완전히 투명: 음파를 맞을 때만 선으로 드러난다(검은 몸이 선을 가려 위치가 드러나지 않게)
		p.Transparency = 1
		p.CastShadow = false
		if not grouped[p] then
			p.Anchored = false
			p.CanCollide = false
			p.CanQuery = false
			p.Massless = true
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
		end
	end
end

-- ── 전신 뼈대(Rig 2): 골반 → 허리(가슴) → 목 → 머리, 가슴 → 어깨 → 위팔 → (가운데 마디) → 아래팔 → 손,
-- 골반 → 허벅지 → 정강이 → 발. 뼈마다 투명한 작은 파트 + Motor6D(이름 "B_<뼈>").
-- 그림 선(parts)은 가장 가까운 뼈에 붙는다(팔 묶음 "Arm±1" 은 그쪽 팔 뼈 중에서, 다리 묶음은 그쪽 다리 뼈 중에서).
-- 움직임은 클라이언트(MonsterAnim)가 매 프레임 Motor6D.Transform 으로 만든다(발 고정 IK, 무게중심, 관성).
-- 뼈 파트 속성 Tip = 그 뼈 끝(발끝·손끝·머리 끝)의 위치(뼈 기준). 모델 속성 FloorY = 루트 기준 바닥 높이, Rig = 2.
export type Limb = { Vector3 }
export type Skeleton = {
	pelvis: Vector3,
	waist: Vector3,
	neck: Vector3,
	head: Vector3,
	headEnd: Vector3,
	legs: { [number]: { hip: Vector3, knee: Vector3, ankle: Vector3, toe: Vector3, ball: Vector3? } }, -- ball: 발볼(있으면 발가락이 따로 접힌다)
	arms: { [number]: { shoulder: Vector3, elbow: Vector3, mid: Vector3?, wrist: Vector3, tip: Vector3 } },
	floorY: number,
	mass: number, -- 무게(착지 충격·둔중함), 1 = 메인 괴물
}
local function skeleton(model: Model, root: BasePart, cf: CFrame, parts: { BasePart }, groupParts: { [string]: { BasePart } }, sk: Skeleton, holder: Instance?)
	type Bone = { name: string, parent: string?, joint: Vector3, tip: Vector3, part: BasePart? }
	local bones: { [string]: Bone } = {}
	local order: { string } = {}
	local function bone(name: string, parent: string?, joint: Vector3, tip: Vector3)
		bones[name] = { name = name, parent = parent, joint = joint, tip = tip }
		table.insert(order, name)
	end
	bone("Pelvis", nil, sk.pelvis, sk.waist)
	bone("Chest", "Pelvis", sk.waist, sk.neck)
	bone("Neck", "Chest", sk.neck, sk.head)
	bone("Head", "Neck", sk.head, sk.headEnd)
	for _, s in { -1, 1 } do
		local L = sk.legs[s]
		bone("Thigh" .. s, "Pelvis", L.hip, L.knee)
		bone("Shin" .. s, "Thigh" .. s, L.knee, L.ankle)
		if L.ball then
			-- 발등(발목 → 발볼) + 발가락(발볼 → 발끝): 걸을 때 발가락이 따로 접혔다 펴진다
			bone("Foot" .. s, "Shin" .. s, L.ankle, L.ball)
			bone("Toe" .. s, "Foot" .. s, L.ball, L.toe)
		else
			bone("Foot" .. s, "Shin" .. s, L.ankle, L.toe)
		end
		local A = sk.arms[s]
		bone("Upper" .. s, "Chest", A.shoulder, A.elbow)
		local last = "Upper" .. s
		local from = A.elbow
		if A.mid then
			bone("Mid" .. s, last, A.elbow, A.mid)
			last, from = "Mid" .. s, A.mid
		end
		bone("Fore" .. s, last, from, A.wrist)
		bone("Hand" .. s, "Fore" .. s, A.wrist, A.tip)
	end
	-- 뼈 파트 + 관절
	for _, name in order do
		local b = bones[name]
		local pv = Instance.new("Part")
		pv.Name = "Bone_" .. name
		pv.Size = Vector3.new(0.2, 0.2, 0.2)
		pv.Transparency = 1
		pv.CanCollide = false
		pv.CanQuery = false
		pv.CanTouch = false
		pv.Massless = true
		pv.CastShadow = false
		pv:SetAttribute("SonarShape", "None")
		pv:SetAttribute("Tip", b.tip - b.joint)
		pv.CFrame = cf * CFrame.new(b.joint)
		pv.Parent = holder or model
		b.part = pv
		local parentPart: BasePart = if b.parent then (bones[b.parent].part :: BasePart) else root
		local parentJoint = if b.parent then bones[b.parent].joint else Vector3.zero
		local motor = Instance.new("Motor6D")
		motor.Name = "B_" .. name
		motor.Part0 = parentPart
		motor.Part1 = pv
		motor.C0 = CFrame.new(b.joint - parentJoint)
		motor.C1 = CFrame.identity
		motor.Parent = pv
	end
	local function segDist(p: Vector3, a: Vector3, b: Vector3): number
		local ab = b - a
		local t = if ab.Magnitude < 1e-4 then 0 else math.clamp((p - a):Dot(ab) / ab:Dot(ab), 0, 1)
		return (a + ab * t - p).Magnitude
	end
	local candidates: { [string]: { string } } = {
		["Leg-1"] = { "Thigh-1", "Shin-1", "Foot-1", "Toe-1" },
		["Leg1"] = { "Thigh1", "Shin1", "Foot1", "Toe1" },
		["Arm-1"] = { "Upper-1", "Mid-1", "Fore-1", "Hand-1" },
		["Arm1"] = { "Upper1", "Mid1", "Fore1", "Hand1" },
	}
	local groupOf: { [BasePart]: string } = {}
	for g, list in groupParts do
		for _, p in list do
			groupOf[p] = g
		end
	end
	local core = { "Pelvis", "Chest", "Neck", "Head" }
	for _, p in parts do
		if p.Name == "Part" then
			p.Name = "Body"
		end
		p.Transparency = 1
		p.CastShadow = false
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		local local_ = cf:PointToObjectSpace(p.Position)
		local best, bestD = "Chest", math.huge
		for _, name in candidates[groupOf[p] or ""] or core do
			local b = bones[name]
			if b then
				local d = segDist(local_, b.joint, b.tip)
				if d < bestD then
					best, bestD = name, d
				end
			end
		end
		local w = Instance.new("WeldConstraint")
		w.Part0 = bones[best].part
		w.Part1 = p
		w.Parent = p
	end
	model:SetAttribute("Rig", 2)
	model:SetAttribute("FloorY", sk.floorY)
	model:SetAttribute("Mass", sk.mass)
end

local function makeHumanoid(model: Model, hip: number, speed: number): Humanoid
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = hip
	hum.WalkSpeed = speed
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	hum.AutoJumpEnabled = false
	hum.UseJumpPower = true
	hum.JumpPower = 0
	hum.Parent = model
	for _, st in { Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.Dead } do
		hum:SetStateEnabled(st, false)
	end
	return hum
end

-- ── 도플갱어 ──
-- 루트(2x2x1) 가운데 기준 바닥은 y = -3 (HipHeight 2). 사람 모습은 약 5.2, 괴물 모습은 약 6.5 스터드.
local DOPPEL_HIP = 2.0

-- 사람 모습: 로블록스 기본 아바타 비율의 상자 6개(머리·몸통·팔·다리). 음파에는 상자 윤곽(사람 모양)으로 보인다
local function buildDisguise(model: Model, root: BasePart, cf: CFrame)
	local folder = Instance.new("Folder")
	folder.Name = "Disguise"
	folder.Parent = model
	local parts: { BasePart } = {}
	local groups: { [string]: { BasePart } } = {}
	local function box(name: string, center: Vector3, size: Vector3, group: string?)
		local p = Kit.box(folder, cf * CFrame.new(center), size, { name = name })
		table.insert(parts, p)
		if group then
			groups[group] = groups[group] or {}
			table.insert(groups[group], p)
		end
	end
	box("Head", Vector3.new(0, 1.62, 0), Vector3.new(1.15, 1.2, 1.15))
	box("Torso", Vector3.new(0, 0, 0), Vector3.new(2, 2, 1))
	box("LeftArm", Vector3.new(-1.5, 0, 0), Vector3.new(1, 2, 1), "Arm-1")
	box("RightArm", Vector3.new(1.5, 0, 0), Vector3.new(1, 2, 1), "Arm1")
	box("LeftLeg", Vector3.new(-0.5, -2, 0), Vector3.new(1, 2, 1), "Leg-1")
	box("RightLeg", Vector3.new(0.5, -2, 0), Vector3.new(1, 2, 1), "Leg1")
	-- (관절은 어깨·엉덩이 위쪽: 팔·다리가 그 점을 축으로 흔들린다)
	rig(model, root, cf, parts, groups, {
		["Arm-1"] = Vector3.new(-1.5, 0.9, 0),
		["Arm1"] = Vector3.new(1.5, 0.9, 0),
		["Leg-1"] = Vector3.new(-0.5, -1, 0),
		["Leg1"] = Vector3.new(0.5, -1, 0),
	}, "DJoint", folder)
end

-- 괴물 모습(확정 시안): 둥글고 긴 머리 위쪽에 빛나는 두 눈, 이마에서 배까지 이어지는 지그재그 틈,
-- 솟은 어깨, 무릎까지 늘어진 굵은 팔과 갈고리 손가락, 굽힌 다리. 앞으로 숙인 자세(머리가 앞으로 나온다).
-- 좌표는 시안 그림(픽셀, 가운데 x=130, 바닥 y=394, 38.2px = 1스터드)에서 옮긴다. 앞 = -Z
-- 틈(Slit)과 벌어진 입(Maw)은 둘 다 만들어 두고 음파 대상 태그로 바꿔 낀다(덮칠 때 입이 벌어진다)
local function buildBeast(model: Model, root: BasePart, cf: CFrame)
	local folder = Instance.new("Folder")
	folder.Name = "Beast"
	folder.Parent = model
	local S = 38.2
	local parts: { BasePart } = {}
	local groups: { [string]: { BasePart } } = {}
	local group: string? = nil
	local mark: string? = nil -- "Slit" / "Maw"
	local function P(px: number, py: number, z: number): Vector3
		return Vector3.new((px - 130) / S, (394 - py) / S - 3, z)
	end
	local function seg(a: Vector3, b: Vector3, r: number, name: string?)
		local shape = if (b - a).Magnitude > r * 4 then "Line" else "Disc"
		local p = Kit.cylinder(folder, cf:PointToWorldSpace(a), cf:PointToWorldSpace(b), r, { shape = shape, name = name, tag = mark ~= "Maw" })
		if mark then
			p:SetAttribute(mark, true)
		end
		table.insert(parts, p)
		if group then
			groups[group] = groups[group] or {}
			table.insert(groups[group], p)
		end
	end
	-- 깊이(z): 머리가 가장 앞, 목·어깨, 몸통, 엉덩이 순으로 뒤
	local function depth(py: number): number
		if py < 210 then
			return -1.05
		elseif py < 236 then
			return -0.75
		elseif py < 300 then
			return -0.45
		end
		return -0.25
	end
	-- 3차 베지어를 n 토막의 선으로(zf: 높이에 따른 깊이 함수)
	local function bez(x0: number, y0: number, x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, n: number, zf: (number) -> number, r: number?)
		local prev = P(x0, y0, zf(y0))
		for i = 1, n do
			local t = i / n
			local u = 1 - t
			local x = u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3
			local y = u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3
			local p = P(x, y, zf(y))
			seg(prev, p, r or 0.035)
			prev = p
		end
	end
	local function poly(pts: { number }, zf: (number) -> number, r: number?)
		for i = 1, #pts - 2, 2 do
			seg(P(pts[i], pts[i + 1], zf(pts[i + 1])), P(pts[i + 2], pts[i + 3], zf(pts[i + 3])), r or 0.035)
		end
	end
	-- 머리(둥글고 위아래로 긴 돔)
	bez(112, 186, 108, 160, 116, 146, 130, 146, 3, depth)
	bez(130, 146, 144, 146, 152, 160, 148, 186, 3, depth)
	bez(148, 186, 146, 198, 140, 206, 130, 208, 2, depth)
	bez(130, 208, 120, 206, 114, 198, 112, 186, 2, depth)
	-- 빛나는 두 눈(클라이언트가 음파 뒤에도 잠깐 빛나게 한다: 이름 Eye)
	for _, ex in { 122, 138 } do
		seg(P(ex, 166, -1.12), P(ex, 166, -1.18), 0.11, "Eye")
	end
	-- 목, 솟은 어깨(승모근), 둥근 어깨 근육
	poly({ 118, 204, 114, 216 }, depth)
	poly({ 142, 204, 146, 216 }, depth)
	bez(114, 216, 100, 218, 90, 222, 84, 232, 2, depth)
	bez(146, 216, 160, 218, 170, 222, 176, 232, 2, depth)
	bez(84, 232, 78, 242, 78, 252, 84, 262, 2, depth)
	bez(176, 232, 182, 242, 182, 252, 176, 262, 2, depth)
	-- 몸통(좁아지는 허리) + 가슴 근육 선
	bez(90, 240, 88, 270, 98, 300, 108, 318, 3, depth)
	poly({ 108, 318, 152, 318 }, depth)
	bez(152, 318, 162, 300, 172, 270, 170, 240, 3, depth)
	bez(98, 248, 110, 258, 120, 256, 124, 250, 2, depth, 0.025)
	bez(162, 248, 150, 258, 140, 256, 136, 250, 2, depth, 0.025)
	-- 이마에서 배까지 이어지는 지그재그 틈(평소)
	mark = "Slit"
	poly({ 130, 172, 127, 180, 133, 188, 127, 196, 133, 204, 127, 212, 133, 220, 126, 230, 134, 240, 126, 250, 134, 260, 126, 270, 134, 280, 127, 290, 133, 300, 128, 310, 130, 318 }, function(py)
		return depth(py) - 0.06
	end)
	-- 벌어진 세로 입(덮칠 때): 머리~배의 렌즈 모양 + 양쪽 이빨
	mark = "Maw"
	local function front(py: number): number
		return depth(py) - 0.08
	end
	bez(130, 168, 116, 196, 112, 236, 114, 266, 3, front)
	bez(114, 266, 116, 292, 122, 308, 130, 322, 2, front)
	bez(130, 322, 138, 308, 144, 292, 146, 266, 2, front)
	bez(146, 266, 148, 236, 144, 196, 130, 168, 3, front)
	for _, t in { { 124, 182, 130, 185 }, { 121, 196, 128, 197 }, { 118, 210, 126, 210 }, { 116, 224, 124, 223 }, { 115, 238, 123, 237 }, { 115, 252, 123, 250 }, { 116, 266, 124, 264 }, { 118, 280, 125, 278 }, { 121, 294, 127, 292 }, { 124, 306, 129, 304 } } do
		poly({ t[1], t[2], t[3], t[4] }, front, 0.025)
		poly({ 260 - t[1], t[2], 260 - t[3], t[4] }, front, 0.025)
	end
	mark = nil
	-- 팔: 무릎 아래까지 늘어진 굵은 팔(바깥선·안쪽선) + 손바닥 + 갈고리 손가락 4개. 손은 몸 앞쪽으로
	local function armZ(py: number): number
		return -0.45 - math.clamp((py - 232) / 162, 0, 1) * 0.55
	end
	for _, s in { -1, 1 } do
		local function X(px: number): number
			return if s < 0 then px else 260 - px
		end
		group = "Arm" .. s
		bez(X(84), 232, X(72), 258, X(70), 280, X(74), 298, 2, armZ)
		bez(X(74), 298, X(68), 320, X(66), 340, X(70), 356, 2, armZ)
		bez(X(100), 252, X(92), 272, X(90), 284, X(92), 298, 2, armZ)
		bez(X(92), 298, X(90), 320, X(86), 340, X(86), 356, 2, armZ)
		bez(X(70), 356, X(68), 366, X(72), 372, X(78), 374, 2, armZ)
		poly({ X(78), 374, X(86), 370 }, armZ)
		bez(X(86), 370, X(88), 364, X(88), 360, X(86), 356, 1, armZ)
		bez(X(72), 370, X(64), 380, X(62), 388, X(66), 394, 2, armZ, 0.028)
		bez(X(77), 373, X(74), 384, X(74), 392, X(79), 396, 2, armZ, 0.028)
		bez(X(82), 372, X(84), 384, X(86), 390, X(90), 392, 2, armZ, 0.028)
		bez(X(86), 366, X(94), 372, X(96), 378, X(94), 386, 2, armZ, 0.028)
	end
	-- 다리: 무릎을 굽히고 한 발을 내딛은 자세, 크고 납작한 발
	local function legZ(py: number): number
		return if py < 362 then -0.25 - (py - 318) / 44 * 0.2 else -0.45 + (py - 362) / 32 * 0.45
	end
	group = "Leg-1"
	bez(108, 318, 100, 340, 98, 352, 104, 362, 2, legZ)
	bez(104, 362, 100, 376, 98, 386, 96, 392, 2, legZ)
	bez(126, 324, 122, 340, 120, 352, 118, 362, 2, legZ)
	bez(118, 362, 116, 374, 114, 384, 114, 392, 2, legZ)
	poly({ 92, 394, 118, 394 }, legZ)
	group = "Leg1"
	bez(152, 318, 162, 336, 166, 350, 160, 362, 2, legZ)
	bez(160, 362, 166, 374, 170, 386, 174, 392, 2, legZ)
	bez(134, 324, 140, 340, 144, 352, 144, 362, 2, legZ)
	bez(144, 362, 146, 374, 148, 384, 150, 392, 2, legZ)
	poly({ 146, 394, 178, 394 }, legZ)
	group = nil
	-- 전신 뼈대(작고 가벼운 몸: 빠르고 날카롭게 반응)
	skeleton(model, root, cf, parts, groups, {
		pelvis = P(130, 318, -0.25),
		waist = P(130, 280, -0.45),
		neck = P(130, 216, -0.75),
		head = P(130, 204, -0.9),
		headEnd = P(130, 150, -1.05),
		legs = {
			[-1] = { hip = P(116, 318, -0.25), knee = P(104, 362, legZ(362)), ankle = P(96, 392, legZ(392)), toe = P(96, 394, -0.6) },
			[1] = { hip = P(144, 318, -0.25), knee = P(160, 362, legZ(362)), ankle = P(174, 392, legZ(392)), toe = P(174, 394, -0.6) },
		},
		arms = {
			[-1] = { shoulder = P(84, 232, armZ(232)), elbow = P(74, 298, armZ(298)), wrist = P(70, 356, armZ(356)), tip = P(76, 394, armZ(394)) },
			[1] = { shoulder = P(176, 232, armZ(232)), elbow = P(186, 298, armZ(298)), wrist = P(190, 356, armZ(356)), tip = P(184, 394, armZ(394)) },
		},
		floorY = -3,
		mass = 0.55,
	}, folder)
end

-- ── 꽃괴물 ──
-- 확정 시안(꽃괴물): 줄기처럼 휜 긴 목, 잎맥 같은 갈비뼈의 마른 몸, 무릎 아래까지 늘어진 팔과 뿌리처럼 갈라진 손가락,
-- 뒤로 꺾인 다리와 뿌리 같은 발. 머리는 평소 고개 숙인 튤립 봉오리(Bud), 깨어나면 뾰족한 꽃잎 6장이 젖혀지고
-- 가운데 작은 눈 7개가 모인 머리(Bloom). 키 약 8.5스터드. 루트 가운데 기준 바닥 y = -4 (HipHeight 3).
-- 좌표는 시안 그림(픽셀, 몸 가운데 x=180, 바닥 y=396, 36.2px = 1스터드)에서 옮긴다. 앞 = -Z
-- 봉오리·펼친 머리는 둘 다 만들어 두고 음파 대상 태그를 바꿔 낀다(도플갱어 입과 같은 방식)
local FLOWER_HIP = 3.0
local function buildFlower(cf: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "Flower"
	model:SetAttribute(Config.Tags.Dynamic, true)
	model:SetAttribute("State", "Dormant")
	model:SetAttribute("Form", "Bud")
	model:SetAttribute("BodyVersion", 1)
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.CanCollide = true
	root.CanTouch = false
	root.CFrame = cf
	root.Parent = model
	model.PrimaryPart = root
	local folder = Instance.new("Folder")
	folder.Name = "Body"
	folder.Parent = model
	local S = 36.2
	local parts: { BasePart } = {}
	local groups: { [string]: { BasePart } } = {}
	local group: string? = nil
	local mark: string? = nil -- "Bud" / "Bloom"
	local function P(px: number, py: number, z: number): Vector3
		return Vector3.new((px - 180) / S, (396 - py) / S - 4, z)
	end
	local function seg(a: Vector3, b: Vector3, r: number, name: string?)
		local shape = if (b - a).Magnitude > r * 4 then "Line" else "Disc"
		local p = Kit.cylinder(folder, cf:PointToWorldSpace(a), cf:PointToWorldSpace(b), r, { shape = shape, name = name, tag = mark ~= "Bloom" })
		if mark then
			p:SetAttribute(mark, true)
		end
		table.insert(parts, p)
		if group then
			groups[group] = groups[group] or {}
			table.insert(groups[group], p)
		end
	end
	local function flat(z: number): (number) -> number
		return function(_py: number): number
			return z
		end
	end
	local function bez(x0: number, y0: number, x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, n: number, zf: (number) -> number, r: number?)
		local prev = P(x0, y0, zf(y0))
		for i = 1, n do
			local t = i / n
			local u = 1 - t
			local x = u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3
			local y = u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3
			local p = P(x, y, zf(y))
			seg(prev, p, r or 0.035)
			prev = p
		end
	end
	local function line(x0: number, y0: number, x1: number, y1: number, zf: (number) -> number, r: number?)
		seg(P(x0, y0, zf(y0)), P(x1, y1, zf(y1)), r or 0.035)
	end
	local body = flat(-0.2)
	-- 굶주린 몸통: 가시처럼 솟은 어깨뼈, 드러난 갈비뼈, 푹 꺼진 배, 마디 불거진 등뼈
	local function knob(x: number, y: number, zf: (number) -> number, r: number)
		local z = zf(y)
		seg(P(x, y, z), P(x, y, z - 0.05), r)
	end
	bez(177, 190, 168, 206, 160, 222, 152, 228, 2, body, 0.035)
	bez(152, 228, 146, 222, 140, 214, 132, 204, 2, body, 0.035)
	line(132, 204, 140, 234, body, 0.03)
	bez(140, 234, 136, 254, 140, 272, 152, 282, 2, body, 0.035)
	bez(152, 282, 164, 290, 166, 304, 160, 318, 2, body, 0.035)
	bez(180, 240, 166.5, 241.6, 151.5, 248.8, 153, 256, 2, flat(-0.25), 0.024)
	bez(180, 251, 164.7, 252.8, 147.7, 260.9, 149.4, 269, 2, flat(-0.25), 0.024)
	bez(180, 262, 165.6, 263.8, 149.6, 271.9, 151.2, 280, 2, flat(-0.25), 0.024)
	bez(180, 273, 169.2, 274.4, 157.2, 280.7, 158.4, 287, 2, flat(-0.25), 0.024)
	bez(183, 190, 192, 206, 200, 222, 208, 228, 2, body, 0.035)
	bez(208, 228, 214, 222, 220, 214, 228, 204, 2, body, 0.035)
	line(228, 204, 220, 234, body, 0.03)
	bez(220, 234, 224, 254, 220, 272, 208, 282, 2, body, 0.035)
	bez(208, 282, 196, 290, 194, 304, 200, 318, 2, body, 0.035)
	bez(180, 240, 193.5, 241.6, 208.5, 248.8, 207, 256, 2, flat(-0.25), 0.024)
	bez(180, 251, 195.3, 252.8, 212.3, 260.9, 210.6, 269, 2, flat(-0.25), 0.024)
	bez(180, 262, 194.4, 263.8, 210.4, 271.9, 208.8, 280, 2, flat(-0.25), 0.024)
	bez(180, 273, 190.8, 274.4, 202.8, 280.7, 201.6, 287, 2, flat(-0.25), 0.024)
	line(180, 232, 180, 318, flat(-0.25), 0.025)
	knob(180, 240, flat(-0.25), 0.05)
	knob(180, 252, flat(-0.25), 0.05)
	knob(180, 264, flat(-0.25), 0.05)
	knob(180, 276, flat(-0.25), 0.05)
	knob(180, 288, flat(-0.25), 0.05)
	knob(180, 300, flat(-0.25), 0.05)
	knob(180, 312, flat(-0.25), 0.05)
	-- 팔: 바깥으로 꺾인 팔꿈치(뼈 가시) 아래로 무릎까지 늘어진 앙상한 팔
	-- 손: 거미 다리처럼 벌어진 긴 손가락 4개(마디 3개 + 갈고리 손톱)와 몸 쪽으로 꺾인 엄지
	local function armZ(py: number): number
		return -0.25 - math.clamp((py - 250) / 140, 0, 1) * 0.45
	end
	group = "Arm-1"
	bez(140, 234, 124, 248, 108, 268, 98, 290, 2, armZ, 0.04)
	knob(98, 290, armZ, 0.08)
	line(98, 290, 86, 282, armZ, 0.028)
	line(98, 290, 90, 298, armZ, 0.024)
	bez(98, 290, 98, 306, 102, 320, 108, 330, 2, armZ, 0.035)
	bez(102, 292, 106, 306, 110, 318, 112, 328, 2, armZ, 0.022)
	knob(108, 330, armZ, 0.065)
	line(108, 330, 96.3, 344, armZ, 0.026)
	knob(96.3, 344, armZ, 0.045)
	line(96.3, 344, 85.9, 359, armZ, 0.024)
	knob(85.9, 359, armZ, 0.036)
	line(85.9, 359, 79.4, 374, armZ, 0.022)
	knob(79.4, 374, armZ, 0.03)
	line(79.4, 374, 85.4, 386, armZ, 0.018)
	line(108, 330, 102.6, 344, armZ, 0.026)
	knob(102.6, 344, armZ, 0.045)
	line(102.6, 344, 97.8, 361.3, armZ, 0.024)
	knob(97.8, 361.3, armZ, 0.036)
	line(97.8, 361.3, 94.8, 378.5, armZ, 0.022)
	knob(94.8, 378.5, armZ, 0.03)
	line(94.8, 378.5, 100.8, 392.3, armZ, 0.018)
	line(108, 330, 108.9, 344, armZ, 0.026)
	knob(108.9, 344, armZ, 0.045)
	line(108.9, 344, 109.7, 360.5, armZ, 0.024)
	knob(109.7, 360.5, armZ, 0.036)
	line(109.7, 360.5, 110.2, 377, armZ, 0.022)
	knob(110.2, 377, armZ, 0.03)
	line(110.2, 377, 104.2, 390.2, armZ, 0.018)
	line(108, 330, 114.3, 344, armZ, 0.026)
	knob(114.3, 344, armZ, 0.045)
	line(114.3, 344, 119.9, 357.5, armZ, 0.024)
	knob(119.9, 357.5, armZ, 0.036)
	line(119.9, 357.5, 123.4, 371, armZ, 0.022)
	knob(123.4, 371, armZ, 0.03)
	line(123.4, 371, 117.4, 381.8, armZ, 0.018)
	line(108, 330, 122, 336, armZ, 0.024)
	knob(122, 336, armZ, 0.04)
	line(122, 336, 130, 350, armZ, 0.022)
	line(130, 350, 126, 360, armZ, 0.018)
	group = "Arm1"
	bez(220, 234, 236, 248, 252, 268, 262, 290, 2, armZ, 0.04)
	knob(262, 290, armZ, 0.08)
	line(262, 290, 274, 282, armZ, 0.028)
	line(262, 290, 270, 298, armZ, 0.024)
	bez(262, 290, 262, 306, 258, 320, 252, 330, 2, armZ, 0.035)
	bez(258, 292, 254, 306, 250, 318, 248, 328, 2, armZ, 0.022)
	knob(252, 330, armZ, 0.065)
	line(252, 330, 263.7, 344, armZ, 0.026)
	knob(263.7, 344, armZ, 0.045)
	line(263.7, 344, 274.1, 359, armZ, 0.024)
	knob(274.1, 359, armZ, 0.036)
	line(274.1, 359, 280.6, 374, armZ, 0.022)
	knob(280.6, 374, armZ, 0.03)
	line(280.6, 374, 274.6, 386, armZ, 0.018)
	line(252, 330, 257.4, 344, armZ, 0.026)
	knob(257.4, 344, armZ, 0.045)
	line(257.4, 344, 262.2, 361.3, armZ, 0.024)
	knob(262.2, 361.3, armZ, 0.036)
	line(262.2, 361.3, 265.2, 378.5, armZ, 0.022)
	knob(265.2, 378.5, armZ, 0.03)
	line(265.2, 378.5, 259.2, 392.3, armZ, 0.018)
	line(252, 330, 251.1, 344, armZ, 0.026)
	knob(251.1, 344, armZ, 0.045)
	line(251.1, 344, 250.3, 360.5, armZ, 0.024)
	knob(250.3, 360.5, armZ, 0.036)
	line(250.3, 360.5, 249.8, 377, armZ, 0.022)
	knob(249.8, 377, armZ, 0.03)
	line(249.8, 377, 255.8, 390.2, armZ, 0.018)
	line(252, 330, 245.7, 344, armZ, 0.026)
	knob(245.7, 344, armZ, 0.045)
	line(245.7, 344, 240.1, 357.5, armZ, 0.024)
	knob(240.1, 357.5, armZ, 0.036)
	line(240.1, 357.5, 236.6, 371, armZ, 0.022)
	knob(236.6, 371, armZ, 0.03)
	line(236.6, 371, 242.6, 381.8, armZ, 0.018)
	line(252, 330, 238, 336, armZ, 0.024)
	knob(238, 336, armZ, 0.04)
	line(238, 336, 230, 350, armZ, 0.022)
	line(230, 350, 234, 360, armZ, 0.018)
	group = nil
	-- 하반신: 다리 없이 몸통이 그대로 땅에 박혀 있다. 허리 아래가 굵어지며 바닥으로 파고들고,
	-- 밑동에서 뿌리·촉수가 바닥을 따라 사방으로 꿈틀대며 뻗는다
	-- (뼈대의 다리는 보이지 않는 채로 남겨 걸음 리듬만 쓴다. 바닥 쪽 선은 루트에 붙여 땅에 고정)
	do
		local function ground(n0: number)
			for k = n0 + 1, #parts do
				parts[k]:SetAttribute("Ground", true)
			end
		end
		-- 허리 → 땅으로 파고드는 밑동(위쪽 절반은 골반, 아래쪽 절반은 땅에 붙는다)
		for _, s in { -1, 1 } do
			local function X(px: number): number
				return 180 + (px - 180) * -s
			end
			bez(X(160), 318, X(158), 330, X(156), 344, X(154), 356, 2, body)
			local n0 = #parts
			bez(X(154), 356, X(152), 370, X(146), 384, X(134), 396, 3, body)
			ground(n0)
		end
		-- 밑동 껍질의 결(세로 주름)
		for _, x in { 166, 174, 186, 194 } do
			line(x, 324, x + (x - 180) * 0.15, 352, flat(-0.25), 0.02)
			local n0 = #parts
			line(x + (x - 180) * 0.15, 356, x + (x - 180) * 0.6, 394, flat(-0.25), 0.02)
			ground(n0)
		end
		-- 땅을 따라 사방으로 뻗은 뿌리 촉수(길이·휘는 방향이 제각각), 끝은 살짝 들려 꿈틀
		local n0 = #parts
		for k, c in { { 0, 2.6, 1 }, { 50, 1.9, -1 }, { 95, 2.4, 1 }, { 140, 1.6, -1 }, { 185, 2.8, 1 }, { 230, 2.0, -1 }, { 275, 2.3, 1 }, { 320, 1.7, -1 } } do
			local a, len, s = math.rad(c[1]), c[2], c[3]
			local dir = Vector3.new(math.sin(a), 0, math.cos(a))
			local side = Vector3.new(dir.Z, 0, -dir.X)
			local base = P(180, 394, -0.2) + dir * 0.55
			local prev = base
			local n = 6
			for i = 1, n do
				local t = i / n
				local lift = if i == n then 0.25 else 0.04 * math.sin(t * math.pi)
				local p = base + dir * (len * t) + side * (s * math.sin(t * math.pi * 1.5) * 0.35) + Vector3.new(0, lift, 0)
				seg(prev, p, 0.055 * (1 - t * 0.75))
				prev = p
			end
			-- 곁가지 하나
			if k % 2 == 1 then
				local m = base + dir * (len * 0.5)
				seg(m, m + (dir + side * s * 1.2).Unit * 0.6 + Vector3.new(0, 0.05, 0), 0.02)
			end
		end
		ground(n0)
	end
	-- 뼈대용 다리 위치(보이는 선은 없음)
	local function legZ(py: number): number
		return if py < 360 then -0.2 - (py - 318) / 42 * 0.35 else -0.55 + (py - 360) / 36 * 0.6
	end
	group = nil
	-- 머리(평소): 줄기처럼 휜 목 끝에 고개 숙인 튤립 봉오리
	mark = "Bud"
	local function budZ(py: number): number
		return -0.35 - math.clamp((198 - py) / 110, 0, 1) * 0.55
	end
	bez(180, 190, 186, 172, 196, 158, 210, 150, 3, budZ, 0.04)
	-- 봉오리 덩어리는 목 끝(210,150)을 기준으로 크게(BUD_K 배)
	local BUD_K = 1.9
	local function bb(x0: number, y0: number, x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, n: number, r: number?)
		local function k(x: number, y: number): (number, number)
			return 210 + (x - 210) * BUD_K, 150 + (y - 150) * BUD_K
		end
		local a0, b0 = k(x0, y0)
		local a1, b1 = k(x1, y1)
		local a2, b2 = k(x2, y2)
		local a3, b3 = k(x3, y3)
		bez(a0, b0, a1, b1, a2, b2, a3, b3, n, budZ, r)
	end
	-- 바깥 윤곽(꽃잎 겹이 보이게 양옆 두 장 + 가운데 한 장)
	bb(210, 150, 200, 132, 204, 106, 222, 96, 4, 0.04)
	bb(222, 96, 238, 104, 244, 128, 236, 148, 4, 0.04)
	bb(236, 148, 228, 158, 218, 158, 210, 150, 3, 0.04)
	bb(210, 150, 194, 138, 198, 112, 216, 99, 3, 0.03)
	bb(236, 148, 252, 136, 248, 112, 228, 99, 3, 0.03)
	-- 꽃잎 겹선(봉오리 결)
	bb(222, 96, 220, 116, 220, 136, 224, 154, 3, 0.026)
	bb(212, 110, 216, 124, 218, 140, 220, 156, 3, 0.026)
	bb(232, 108, 230, 124, 230, 140, 228, 154, 3, 0.026)
	-- 꼭대기 뾰족한 끝 + 밑동을 감싼 꽃받침 3장
	bb(222, 96, 221, 92, 220, 90, 219, 84, 1, 0.026)
	bb(222, 96, 223, 92, 225, 90, 227, 85, 1, 0.026)
	bb(210, 150, 204, 156, 200, 160, 196, 166, 1, 0.026)
	bb(223, 156, 223, 160, 223, 163, 223, 168, 1, 0.026)
	bb(236, 148, 242, 154, 246, 158, 250, 164, 1, 0.026)
	-- 머리(깨어나면): 곧게 선 목 끝에 뾰족한 꽃잎 6장이 젖혀지고 가운데 작은 눈 7개
	mark = "Bloom"
	local headZ = flat(-0.95)
	bez(180, 190, 180, 172, 182, 154, 186, 138, 3, function(py)
		return -0.35 - math.clamp((198 - py) / 60, 0, 1) * 0.55
	end)
	local hx, hy = 186, 104
	local PK = 1.75 -- 꽃잎 크기(원래의 배)
	-- 안쪽 겹: 바깥 꽃잎 사이로 짧은 꽃잎 6장
	for k = 0, 5 do
		local a = math.rad(k * 60 + 30)
		local function R(x: number, y: number): (number, number)
			x, y = x * PK * 0.55, y * PK * 0.55
			return hx + x * math.cos(a) - y * math.sin(a), hy + x * math.sin(a) + y * math.cos(a)
		end
		local x0, y0 = R(-5, -8)
		local x1, y1 = R(-12, -30)
		local x2, y2 = R(0, -60)
		local u1, v1 = R(12, -30)
		local u2, v2 = R(5, -8)
		bez(x0, y0, x1, y1, x1, y1, x2, y2, 2, flat(-0.9), 0.028)
		bez(x2, y2, u1, v1, u1, v1, u2, v2, 2, flat(-0.9), 0.028)
	end
	for k = 0, 5 do
		local a = math.rad(k * 60)
		local function R(x: number, y: number): (number, number)
			x, y = x * PK, y * PK
			return hx + x * math.cos(a) - y * math.sin(a), hy + x * math.sin(a) + y * math.cos(a)
		end
		local x0, y0 = R(-4, -6)
		local x1, y1 = R(-10, -24)
		local x2, y2 = R(-8, -46)
		local x3, y3 = R(0, -62)
		bez(x0, y0, x1, y1, x2, y2, x3, y3, 3, headZ, 0.04)
		local u1, v1 = R(8, -46)
		local u2, v2 = R(10, -24)
		local u3, v3 = R(4, -6)
		bez(x3, y3, u1, v1, u2, v2, u3, v3, 3, headZ, 0.04)
		local m0, n0 = R(0, -14)
		local m1, n1 = R(0, -52)
		line(m0, n0, m1, n1, headZ, 0.02)
		for _, t in { { 6, -30, 11, -32 }, { 6, -40, 11, -43 } } do
			local a0, b0 = R(t[1], t[2])
			local a1, b1 = R(t[3], t[4])
			line(a0, b0, a1, b1, headZ, 0.02)
		end
	end
	for _, e in { { 0, 0, 0.09 }, { -8, -6, 0.06 }, { 8, -6, 0.06 }, { -10, 4, 0.055 }, { 10, 4, 0.055 }, { -3, 10, 0.05 }, { 3, 10, 0.05 } } do
		local ex, ey, er = e[1] * 1.5, e[2] * 1.5, e[3] * 1.5
		seg(P(hx + ex, hy + ey, -1.0), P(hx + ex, hy + ey, -1.06), er, "FEye")
	end
	mark = nil
	-- 전신 뼈대(키 크고 가는 몸: 긴 목·긴 팔의 휘청임)
	skeleton(model, root, cf, parts, groups, {
		pelvis = P(180, 318, -0.2),
		waist = P(180, 280, -0.2),
		neck = P(180, 236, -0.2),
		head = P(180, 198, -0.35),
		headEnd = P(190, 104, -0.9),
		legs = {
			[-1] = { hip = P(168, 318, -0.2), knee = P(174, 360, legZ(360)), ankle = P(152, 392, legZ(392)), toe = P(138, 395, -0.6) },
			[1] = { hip = P(192, 318, -0.2), knee = P(186, 360, legZ(360)), ankle = P(208, 392, legZ(392)), toe = P(222, 395, -0.6) },
		},
		arms = {
			[-1] = { shoulder = P(140, 234, armZ(234)), elbow = P(98, 290, armZ(290)), wrist = P(108, 330, armZ(330)), tip = P(108, 390, armZ(390)) },
			[1] = { shoulder = P(220, 234, armZ(234)), elbow = P(262, 290, armZ(290)), wrist = P(252, 330, armZ(330)), tip = P(252, 390, armZ(390)) },
		},
		floorY = -4,
		mass = 0.7,
	}, folder)
	for _, p in parts do
		if p:GetAttribute("Ground") then
			local w = p:FindFirstChildOfClass("WeldConstraint")
			if w then
				w.Part0 = root -- 땅에 박힌 부분은 상체가 흔들려도 바닥에 그대로
			end
		end
	end
	makeHumanoid(model, FLOWER_HIP, 0)
	CollectionService:AddTag(model, Config.Tags.Monster)
	CollectionService:AddTag(model, Config.Tags.Flower)
	return model
end

local function buildDoppel(cf: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "Doppel"
	model:SetAttribute(Config.Tags.Dynamic, true)
	model:SetAttribute("State", "Disguise")
	model:SetAttribute("Form", "Disguise")
	model:SetAttribute("BodyVersion", 1)
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.CanCollide = true
	root.CanTouch = false
	root.CFrame = cf
	root.Parent = model
	model.PrimaryPart = root
	buildDisguise(model, root, cf)
	makeHumanoid(model, DOPPEL_HIP, Config.Doppel.WalkSpeed)
	CollectionService:AddTag(model, Config.Tags.Monster)
	CollectionService:AddTag(model, Config.Tags.Doppel)
	return model
end

-- ── 모델 ──
local function buildModel(cf: CFrame, _stage: number): Model
	local model = Instance.new("Model")
	model.Name = "Monster"
	model:SetAttribute(Config.Tags.Dynamic, true)
	model:SetAttribute("State", "Wander")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1.2)
	root.Transparency = 1
	root.CanCollide = true
	root.CanTouch = false
	root.CFrame = cf
	root.Parent = model
	model.PrimaryPart = root

	local function at(v: Vector3): Vector3
		return cf:PointToWorldSpace(v)
	end
	-- 몸통(앞으로 숙인 마른 몸), 머리, 긴 팔, 다리. 루트 가운데 기준 바닥은 y = -5
	local parts: { BasePart } = {}
	-- 팔·다리는 어깨·엉덩이 관절(Motor6D)에 붙여 걸을 때 흔든다(Monster.animate)
	local group: string? = nil
	local groupParts: { [string]: { BasePart } } = {}
	local function add(p: BasePart)
		table.insert(parts, p)
		if group then
			local l = groupParts[group] or {}
			groupParts[group] = l
			table.insert(l, p)
		end
	end
	-- 레퍼런스(손그림): 작은 머리 + 짧은 목 + 좁고 긴 몸통 + 바깥으로 벌어진 긴 팔(발톱 5개) + 길고 가는 다리. 바닥 y = -5, 앞 = -Z
	local function seg(a: Vector3, b: Vector3, r: number)
		-- 음파에는 한 획으로: 막대는 가운데 선 하나(Line), 얇은 원판은 원 하나(Disc)
		local shape = if (b - a).Magnitude > r * 4 then "Line" else "Disc"
		local p = Kit.cylinder(model, at(a), at(b), r, { shape = shape })
		add(p)
		return p
	end
	local V3 = Vector3.new
	-- ── 사용자 확정 디자인(노트 main-monster-bone.svg, 모든 스테이지 공통) ──
	-- 뒤집힌 삼각 머리(둥근 눈 둘 + 위아래 이빨 입) · 속이 빈 관 뼈 · 구체관절 · 손발 모두 마디 손가락 4개 + 발톱
	-- 시안 좌표(px): 가운데 x = 335, 발톱 끝(바닥) y = 852, 아래로 +y, 75px = 1스터드. 바닥 y = -5, 앞 = -Z
	local PX = 75
	type Pt = { number }
	local function S(x: number, y: number, z: number): Vector3
		return V3((x - 335) / PX, -5 + (852 - y) / PX, z)
	end
	-- 한 획 선. ra/rb 만큼 양 끝을 잘라 관절 공 안으로 들어가지 않게
	local function line(a: Vector3, b: Vector3, r: number, ra: number?, rb: number?)
		local u = (b - a).Unit
		seg(a + u * (ra or 0), b - u * (rb or 0), r)
	end
	-- 관 뼈: 가는 원통(음파에는 보는 쪽 실루엣 2줄 + 끝 가로선 = 속이 빈 관). 양 끝은 관절 공 겉면까지만
	local BONE_R, BALL_R, KNUCKLE_R = 0.08, 0.15, 0.06
	local function bone(a: Vector3, b: Vector3)
		local u = (b - a).Unit
		add(Kit.cylinder(model, at(a + u * BALL_R), at(b - u * BALL_R), BONE_R))
	end
	-- 구체관절: 어느 쪽에서 봐도 원
	local function ball(p: Vector3, r: number)
		add(Kit.ball(model, at(p), r))
	end
	local function poly(pts: { Pt }, closed: boolean, z: number, r: number)
		local n = #pts
		for i = 1, (if closed then n else n - 1) do
			local a, b = pts[i], pts[i % n + 1]
			seg(S(a[1], a[2], z), S(b[1], b[2], z), r)
		end
	end
	local function curve(p0: Pt, c: Pt, p1: Pt, n: number, z: number, r: number)
		local pts: { Pt } = {}
		for i = 0, n do
			local t = i / n
			local u = 1 - t
			table.insert(pts, { u * u * p0[1] + 2 * u * t * c[1] + t * t * p1[1], u * u * p0[2] + 2 * u * t * c[2] + t * t * p1[2] })
		end
		poly(pts, false, z, r)
	end

	-- 몸통: 목 · 어깨 가로대 · 좁아지는 사다리꼴 몸통 · 휘어진 갈비뼈 5줄 · 육각 골반
	line(S(335, 200, -0.15), S(335, 213, 0), 0.03)
	line(S(287.5, 212, 0), S(392.5, 212, 0), 0.03, BALL_R, BALL_R)
	poly({ { 300, 215 }, { 380, 215 }, { 355, 300 }, { 322.5, 300 } }, true, 0, 0.03)
	curve({ 308, 230 }, { 318, 262 }, { 326, 296 }, 3, -0.02, 0.022)
	for _, rib in { { 318, 228, 345, 242, 372, 226 }, { 321, 242, 346, 254, 369, 240 }, { 324, 256, 346, 266, 366, 254 }, { 327, 269, 346, 278, 362, 268 }, { 330, 282, 346, 289, 358, 281 } } do
		curve({ rib[1], rib[2] }, { rib[3], rib[4] }, { rib[5], rib[6] }, 3, -0.03, 0.03)
	end
	poly({ { 322.5, 300 }, { 355, 300 }, { 362.5, 317.5 }, { 352.5, 335 }, { 325, 335 }, { 315, 317.5 } }, true, 0, 0.03)

	-- 팔·다리: 왼쪽(s = -1) 시안 좌표, 오른쪽은 좌우 대칭(x → 670 - x)
	-- 손·발: 손목(발목)에서 마디 손가락 4개. { 첫 마디 x, y, 둘째 마디 x, y, 발톱 끝 x, y }
	local HAND = { { 180, 512.5, 150, 535, 140, 585 }, { 190, 519, 162.5, 565, 160, 617.5 }, { 202.5, 520, 195, 567.5, 202.5, 612.5 }, { 215, 516, 239, 544, 244, 592.5 } }
	-- 손가락은 아래로 갈수록 앞으로 굽고, 발가락은 발목에서 앞으로 뻗어 발톱 끝이 바닥에 닿는다
	local function handZ(y: number): number
		return -0.15 - 0.45 * math.clamp((y - 462.5) / 155, 0, 1)
	end
	local function digits(w: Vector3, list: { { number } }, P: (number, number, number) -> Vector3, zf: (number) -> number): Vector3
		local sum = Vector3.zero
		for _, d in list do
			local k1 = P(d[1], d[2], zf(d[2]))
			local k2 = P(d[3], d[4], zf(d[4]))
			local tip = P(d[5], d[6], zf(d[6]))
			line(w, k1, 0.025, BALL_R, KNUCKLE_R)
			line(k1, k2, 0.025, KNUCKLE_R, KNUCKLE_R)
			ball(k1, KNUCKLE_R)
			ball(k2, KNUCKLE_R)
			-- 발톱: 끝으로 갈수록 가늘어지는 가시(두 줄이 끝에서 만난다)
			local dir = (tip - k2).Unit
			local side = dir:Cross(Vector3.zAxis)
			if side.Magnitude < 0.1 then
				side = dir:Cross(Vector3.xAxis)
			end
			side = side.Unit * 0.04
			local base = k2 + dir * KNUCKLE_R
			seg(base + side, tip, 0.015)
			seg(base - side, tip, 0.015)
			sum += tip
		end
		return sum / #list
	end
	type LimbJ = { a: Vector3, b: Vector3, c: Vector3, tip: Vector3, ball: Vector3? }
	local armJ: { [number]: LimbJ } = {}
	local legJ: { [number]: LimbJ } = {}
	for _, s in { -1, 1 } do
		local function P(x: number, y: number, z: number): Vector3
			return S(if s < 0 then x else 670 - x, y, z)
		end
		group = "Arm" .. s
		local sh, el, wr = P(287.5, 211.5, 0), P(252.5, 332.5, 0.2), P(202.5, 462.5, -0.15)
		bone(sh, el)
		bone(el, wr)
		ball(el, BALL_R)
		ball(wr, BALL_R)
		armJ[s] = { a = sh, b = el, c = wr, tip = digits(wr, HAND, P, handZ) }
		group = "Leg" .. s
		local hip, kn, an = P(310, 333.5, 0), P(287.5, 480, -0.3), P(260, 715, 0.1)
		bone(hip, kn)
		bone(kn, an)
		ball(kn, BALL_R)
		ball(an, BALL_R)
		-- 발: 발목에서 앞아래로 내려가는 발등뼈 → 바닥의 발볼(구체관절) → 앞으로 바닥을 따라 뻗은 마디 발가락 4개 + 발톱,
		-- 발목 뒤로 뒤꿈치 발톱 하나. (발볼에서 발가락이 따로 접힌다)
		local ballP = P(262, 836, -0.55)
		bone(an, ballP)
		ball(ballP, BALL_R * 0.8)
		local sum = Vector3.zero
		for _, dx in { -30, -10, 10, 30 } do
			local k1 = P(262 + dx * 0.45, 845, -0.95)
			local k2 = P(262 + dx * 0.8, 848, -1.35)
			local tip = P(262 + dx, 852, -1.8)
			line(ballP, k1, 0.03, BALL_R * 0.8, KNUCKLE_R)
			line(k1, k2, 0.028, KNUCKLE_R, KNUCKLE_R)
			ball(k1, KNUCKLE_R)
			ball(k2, KNUCKLE_R)
			local dir = (tip - k2).Unit
			local side = dir:Cross(Vector3.yAxis).Unit * 0.045
			local base = k2 + dir * KNUCKLE_R
			seg(base + side, tip, 0.015)
			seg(base - side, tip, 0.015)
			sum += tip
		end
		-- 뒤꿈치 발톱(발목 뒤로 꺾여 바닥을 찌름)
		local heel = P(262, 772, 0.5)
		line(an, heel, 0.028, BALL_R, KNUCKLE_R)
		ball(heel, KNUCKLE_R)
		seg(heel, P(262, 846, 0.72), 0.018)
		legJ[s] = { a = hip, b = kn, c = an, tip = sum / 4, ball = ballP }
		group = nil
		ball(sh, BALL_R)
		ball(hip, BALL_R * 0.9)
	end

	-- ── 머리: 공용 모양(MonsterFaces.BONE, 점프스케어 얼굴과 같다) ──
	local face = Faces.build(Faces.BONE)
	local HZ = -0.25 -- 머리 면의 깊이(조금 앞으로)
	local function hp(u: number, v: number, dz: number): Vector3
		return S(face.tx + u, face.ty + v, HZ + dz)
	end
	for _, l in face.lines do
		local n = #l.pts
		for i = 1, (if l.closed then n else n - 1) do
			local a, b = l.pts[i], l.pts[i % n + 1]
			local p = seg(hp(a[1], a[2], l.dz), hp(b[1], b[2], l.dz), l.r)
			if l.tint then
				p:SetAttribute("SonarColor", l.tint) -- 붉은 바늘 이빨
			end
		end
	end
	for _, c in face.circles do
		local p = hp(c.u, c.v, c.dz)
		seg(p, p + V3(0, 0, -0.02), c.rad / PX)
	end

	-- 전신 뼈대: 관절 위치는 시안 좌표 그대로(팔은 마디 2개, 무릎은 앞으로 굽는다)
	skeleton(model, root, cf, parts, groupParts, {
		pelvis = S(338.75, 318, 0),
		waist = S(340, 262, 0),
		neck = S(340, 212, 0),
		head = S(335, 202, -0.15),
		headEnd = S(face.tx, face.ty - 40, HZ),
		legs = {
			[-1] = { hip = legJ[-1].a, knee = legJ[-1].b, ankle = legJ[-1].c, toe = legJ[-1].tip, ball = legJ[-1].ball },
			[1] = { hip = legJ[1].a, knee = legJ[1].b, ankle = legJ[1].c, toe = legJ[1].tip, ball = legJ[1].ball },
		},
		arms = {
			[-1] = { shoulder = armJ[-1].a, elbow = armJ[-1].b, wrist = armJ[-1].c, tip = armJ[-1].tip },
			[1] = { shoulder = armJ[1].a, elbow = armJ[1].b, wrist = armJ[1].c, tip = armJ[1].tip },
		},
		floorY = -5,
		mass = 1,
	})
	makeHumanoid(model, 4.0, MC.WanderSpeed)
	CollectionService:AddTag(model, Config.Tags.Monster)
	return model
end

-- ── AI ──
export type Monster = typeof(setmetatable({} :: {
	model: Model,
	root: BasePart,
	hum: Humanoid,
	state: State,
	nodes: { Vector3 },
	waypoints: { PathWaypoint },
	wp: number,
	goal: Vector3?,
	target: Player?,
	lastSeen: number,
	lastKnown: Vector3?,
	alertUntil: number,
	searchCenter: Vector3?,
	searchUntil: number,
	lastRepath: number,
	progressPos: Vector3,
	progressT: number,
	stuck: number,
	alive: boolean,
	path: Path,
	rayParams: RaycastParams,
	onCatch: (Player, Monster) -> (),
	log: { string },
	geometry: Instance,
	startAt: number,
	stateChanged: number,
	route: ((Vector3, Vector3, boolean?) -> { Vector3 }?)?,
	legGoal: Vector3?,
	pullSpot: Vector3?, -- 쫓던 플레이어가 숨는 것을 봤다: 그 숨는 곳 앞
	lastHunt: number,
	joints: { { motor: Motor6D, base: CFrame, offset: number, amp: number } },
	phase: number,
	animT: number,
	kind: string, -- "main" / "doppel"
	form: string, -- 도플갱어: "Disguise"(사람 모습) → "Bursting" → "Beast". 메인 괴물은 "Beast"
	cfg: any, -- 속도·거리 설정(도플갱어는 Config.Doppel 이 먼저, 없으면 Config.Monster)
	discoveredBy: Player?,
	transformAt: number,
	pauseUntil: number,
	nextPause: number,
	nextPing: number,
	mawOpen: boolean,
	tracks: { walk: AnimationTrack, idle: AnimationTrack }?, -- 도플갱어가 진짜 아바타로 걷는 애니메이션
}, Monster))

local function between(r: { number }): number
	return r[1] + math.random() * (r[2] - r[1])
end

-- kind = "doppel" 이면 도플갱어(사람 모습으로 시작). 배회 지점(spawnPos)은 바닥 + 3
-- 챕터 괴물 모듈(Creatures/<id>.luau): { cfg = { WanderSpeed, ChaseSpeed, ... }, build(cf: CFrame): Model, tick?, hear? }
local creatureMods: { [string]: any } = {}
function Monster.creatureModule(id: string): any
	if creatureMods[id] == nil then
		local folder = script.Parent:FindFirstChild("Creatures")
		local ms = folder and folder:FindFirstChild(id)
		creatureMods[id] = if ms and ms:IsA("ModuleScript") then require(ms) :: any else false
	end
	return creatureMods[id] or nil
end

function Monster.new(parent: Instance, spawnPos: Vector3, nodes: { Vector3 }, geometry: Instance, onCatch: (Player, any) -> (), stage: number?, kind: string?, creature: string?): Monster
	local isDoppel = kind == "doppel"
	local isFlower = kind == "flower"
	local cmod: any = if creature then Monster.creatureModule(creature) else nil
	local own: any = if isDoppel then Config.Doppel elseif isFlower then Config.Flower elseif cmod then (cmod.cfg or {}) else nil
	local cfg: any = if own
		then setmetatable({}, {
			__index = function(_, k)
				local v = own[k]
				if v ~= nil then
					return v
				end
				return (MC :: any)[k]
			end,
		})
		else MC
	local model = if isDoppel
		then buildDoppel(CFrame.new(spawnPos + Vector3.new(0, 0.1, 0)))
		elseif isFlower then buildFlower(CFrame.new(spawnPos + Vector3.new(0, 1.1, 0)))
		elseif cmod then cmod.build(CFrame.new(spawnPos + Vector3.new(0, cmod.spawnLift or 2, 0)))
		else buildModel(CFrame.new(spawnPos + Vector3.new(0, 2.2, 0)), stage or 1)
	model.Parent = parent
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = { geometry }
	rp.RespectCanCollide = true
	local self = setmetatable({
		model = model,
		root = root,
		hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid,
		state = "Wander" :: State,
		nodes = nodes,
		waypoints = {},
		wp = 1,
		goal = nil,
		target = nil,
		lastSeen = 0,
		lastKnown = nil,
		alertUntil = 0,
		searchCenter = nil,
		searchUntil = 0,
		lastRepath = 0,
		progressPos = root.Position,
		progressT = os.clock(),
		stuck = 0,
		alive = true,
		path = PathfindingService:CreatePath({
			AgentRadius = cfg.AgentRadius,
			AgentHeight = cfg.AgentHeight,
			AgentCanJump = false,
			AgentCanClimb = false,
			WaypointSpacing = 4,
			Costs = { SafeZone = math.huge }, -- (안전 구역 칸은 지나가지 않는다)
		}),
		rayParams = rp,
		onCatch = if cmod and cmod.catch
			then function(p: Player, m: any)
				if not cmod.catch(m, p) then
					onCatch(p, m)
				end
			end
			else onCatch,
		log = {},
		geometry = geometry,
		startAt = os.clock() + cfg.StartDelay,
		stateChanged = os.clock(),
		route = nil,
		legGoal = nil,
		pullSpot = nil,
		lastHunt = os.clock(),
		joints = {},
		phase = 0,
		animT = 0,
		kind = if isDoppel then "doppel" elseif isFlower then "flower" else "main",
		form = if isDoppel then "Disguise" elseif isFlower then "Bud" else "Beast",
		cfg = cfg,
		discoveredBy = nil,
		transformAt = 0,
		pauseUntil = 0,
		nextPause = os.clock() + between(Config.Doppel.PauseEvery),
		nextPing = os.clock() + between(Config.Doppel.FakePingEvery),
		mawOpen = false,
		tracks = nil,
		creature = creature,
		cmod = cmod,
		cdata = {},
	}, Monster)
	-- 괴물마다 자기 소리(Config.MonsterVoices): 메인 괴물은 스테이지(머리 모양) 번호, 도플갱어는 "Doppel"
	model:SetAttribute("Voice", if isDoppel then "Doppel" elseif isFlower then "Flower" elseif cmod and cmod.voice then cmod.voice else tostring(((stage or 1) - 1) % 5 + 1))
	if cmod and cmod.init then
		cmod.init(self)
	end
	if isDoppel then
		self:setState("Disguise")
	elseif isFlower then
		self:setState("Dormant")
	end
	for _, name in { "Leg-1", "Leg1", "Arm-1", "Arm1" } do
		local motor = root:FindFirstChild("Joint" .. name) :: Motor6D?
		if motor then
			local isLeg = name:sub(1, 3) == "Leg"
			local left = name:find("-1") ~= nil
			-- 다리끼리, 팔끼리 반대로, 팔은 같은 쪽 다리와 반대로
			table.insert(self.joints, { motor = motor, base = motor.C0, offset = if (isLeg == left) then 0 else math.pi, amp = if isLeg then 0.5 else 0.38 })
		end
	end
	table.insert(Monster.registry, self)
	return self
end

-- 쫓아올 때 확 튀어나갔다 멈칫하는 괴물(머리 모양 번호): 1 삼각 · 3 원 · 4 별. 평균 속도는 ChaseSpeed 그대로
-- (몸 동작은 서버가 아니라 클라이언트 MonsterAnim 이 매 프레임 만든다: 전신 뼈대 Rig 2)
local LUNGE: { [number]: boolean } = { [1] = true, [3] = true, [4] = true }

-- 서버 쪽 움직임: 쫓아올 때 속도 리듬만. 예전 몸(관절 4개, Rig 2 가 아닌 것)은 팔다리를 흔든다
function Monster.animate(self: Monster, dt: number)
	local tracks = self.tracks
	if tracks then
		-- 진짜 아바타 모습: 움직이면 걷기, 서 있으면 숨쉬기(플레이어와 같은 기본 애니메이션)
		local v = self.root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		if speed > 0.6 then
			if not tracks.walk.IsPlaying then
				tracks.idle:Stop(0.2)
				tracks.walk:Play(0.2)
			end
			tracks.walk:AdjustSpeed(math.clamp(speed / 12, 0.4, 1.4))
		elseif not tracks.idle.IsPlaying then
			tracks.walk:Stop(0.2)
			tracks.idle:Play(0.2)
		end
		return
	end
	local shape = if self.kind == "main" then tonumber(self.model:GetAttribute("Voice")) else nil
	if shape and LUNGE[shape] and self.state == "Chase" then
		-- 확 튀어나갔다 멈칫(0.4초 × 1.35배 + 0.3초 × 0.55배 = 평균 ChaseSpeed)
		local cyc = (os.clock() - self.stateChanged) % 0.7
		self.hum.WalkSpeed = self.cfg.ChaseSpeed * (if cyc < 0.4 then 1.35 else 0.55)
	end
	self.animT += dt
	if self.animT < 0.1 or #self.joints == 0 then
		return
	end
	local step = self.animT
	self.animT = 0
	local v = self.root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	self.phase = (self.phase + step * speed * 0.55) % (math.pi * 2)
	local amt = math.clamp(speed / 3, 0, 1)
	for _, j in self.joints do
		j.motor.C0 = j.base * CFrame.Angles(math.sin(self.phase + j.offset) * j.amp * amt, 0, 0)
	end
end

function Monster.note(self: Monster, s: string)
	table.insert(self.log, string.format("%.1f %s", os.clock(), s))
	if #self.log > 40 then
		table.remove(self.log, 1)
	end
end

function Monster.setState(self: Monster, s: State)
	if self.state ~= s then
		self:note(self.state .. "->" .. s)
		self.state = s
		self.stateChanged = os.clock()
		self.model:SetAttribute("State", s)
	end
	local cfg = self.cfg
	local speed = cfg.WanderSpeed
	if s == "Disguise" then
		speed = cfg.WalkSpeed
	elseif s == "Dormant" or s == "Look" then
		speed = 0
	elseif s == "Investigate" or s == "Search" then
		speed = cfg.InvestigateSpeed
	elseif s == "Chase" then
		speed = cfg.ChaseSpeed
	elseif s == "Alert" then
		speed = 0
	elseif s == "Return" then
		speed = cfg.ReturnSpeed or cfg.WanderSpeed
	end
	self.hum.WalkSpeed = speed
	if s ~= "Chase" and self.mawOpen then
		self:setMaw(false)
	end
end

-- (테스트용) 경로 계산 횟수·시간, tick 횟수
Monster.stats = { pathCalls = 0, pathWall = 0, ticks = 0 }

local function feet(p: Vector3): Vector3
	return p - Vector3.new(0, 4.5, 0)
end

-- 경로 계산(양보 있음). 성공하면 true
function Monster.pathTo(self: Monster, rawGoal: Vector3): boolean
	self.lastRepath = os.clock()
	-- 목표를 바닥 높이로 내린다(소리 위치는 머리 높이일 수 있다)
	local goal = rawGoal
	local down = workspace:Raycast(rawGoal + Vector3.new(0, 1, 0), Vector3.new(0, -14, 0), self.rayParams)
	if down then
		goal = down.Position + Vector3.new(0, 0.5, 0)
	end
	self.legGoal = nil
	local from = feet(self.root.Position)
	local function compute(to: Vector3): boolean
		local c0 = os.clock()
		local ok = pcall(function()
			self.path:ComputeAsync(from, to)
		end)
		Monster.stats.pathCalls += 1
		Monster.stats.pathWall += os.clock() - c0
		return ok and self.alive and self.path.Status == Enum.PathStatus.Success
	end
	local function take(final: boolean): boolean
		self.waypoints = self.path:GetWaypoints()
		self.wp = math.min(2, #self.waypoints)
		self.goal = goal
		self.legGoal = if final then nil else goal
		return true
	end
	if compute(goal) then
		return take(true)
	end
	if not self.alive then
		return false
	end
	-- 멀리 돌아가는 길: 타일 경로를 따라 몇 칸 앞까지만 계산하고, 도착하면 다시 계산한다(follow)
	local route = self.route and self.route(from, goal, true)
	if route and #route > 1 then
		for _, ahead in { MC.LegTiles, math.ceil(MC.LegTiles / 2), 2 } do
			local idx = math.min(#route, ahead + 1)
			if compute(route[idx]) then
				return take(idx == #route)
			end
		end
	end
	self.waypoints = {}
	self.wp = 1
	return false
end

-- 구간 끝에 왔다: 최종 목표가 남아 있으면 다음 구간을 계산한다. 최종 목표에 도착했으면 true
function Monster.nextLeg(self: Monster): boolean
	local g = self.legGoal
	if g and (feet(self.root.Position) - g).Magnitude > 4 and self:pathTo(g) then
		return false
	end
	self.legGoal = nil
	return true
end

-- 경로를 따라 한 걸음. 끝에 도착하면 true
function Monster.follow(self: Monster): boolean
	local wps = self.waypoints
	if #wps == 0 or self.wp > #wps then
		return self:nextLeg()
	end
	local wp = wps[self.wp]
	local pos = self.root.Position
	local flat = Vector3.new(wp.Position.X - pos.X, 0, wp.Position.Z - pos.Z)
	if flat.Magnitude < 2.2 and math.abs(feet(pos).Y - wp.Position.Y) < 4 then
		self.wp += 1
		if self.wp > #wps then
			return self:nextLeg()
		end
		wp = wps[self.wp]
	end
	self.hum:MoveTo(wp.Position)
	-- 앞에 닫힌 문이 있으면 연다
	Doors.openNear(pos + self.root.CFrame.LookVector * 2, 6, self.root.Position)
	return false
end

-- 맡은 반쪽(territory): 맵을 반으로 나눠 메인 괴물이 한 마리씩 맡는다. 없으면 맵 전체
function Monster.inTerritory(self: Monster, pos: Vector3): boolean
	local t = (self :: any).territory
	if not t then
		return true
	end
	if t.x0 then
		-- 사각 구역(메인 괴물: 맵을 나눈 한 칸, 서브 괴물: 자기 방 + 둘레). y0·y1 이 있으면 그 층만
		return pos.X >= t.x0 and pos.X <= t.x1 and pos.Z >= t.z0 and pos.Z <= t.z1 and (t.y0 == nil or (pos.Y >= t.y0 - 6 and pos.Y <= t.y1 + 6))
	end
	local v = if t.axis == "X" then pos.X else pos.Z
	return (v - t.mid) * t.side >= 0
end

function Monster.randomNode(self: Monster, awayFrom: Vector3?): Vector3
	local function pick(): Vector3
		for _ = 1, 16 do
			local n = self.nodes[math.random(1, #self.nodes)]
			if not Monster.isSafe(n) and self:inTerritory(n) then
				return n
			end
		end
		for _ = 1, 12 do
			local n = self.nodes[math.random(1, #self.nodes)]
			if not Monster.isSafe(n) then
				return n
			end
		end
		return self.nodes[math.random(1, #self.nodes)]
	end
	local best = pick()
	if awayFrom then
		for _ = 1, 6 do
			local n = pick()
			if (n - awayFrom).Magnitude > (best - awayFrom).Magnitude and (n - awayFrom).Magnitude < 90 then
				best = n
			end
		end
	end
	return best
end

-- 안전 구역 밖에서 pos 에 가장 가까운 배회 지점
function Monster.nearestOutside(self: Monster, pos: Vector3): Vector3?
	local best, bd = nil, math.huge
	for _, n in self.nodes do
		if not Monster.isSafe(n) then
			local d = (n - pos).Magnitude
			if d < bd then
				best, bd = n, d
			end
		end
	end
	return best
end

-- 머리에서 대상까지 벽에 막히지 않는가
function Monster.lineOfSight(self: Monster, p: Vector3): boolean
	local from = self.root.Position + Vector3.new(0, 2.5, 0)
	local hit = workspace:Raycast(from, p - from, self.rayParams)
	return hit == nil
end

-- 살아 있고 숨지 않은, 안전 구역 밖 플레이어. 같은 프레임 안에서는 한 번만 모은다(괴물 수 × 매 프레임 잡기 판정·감각이 같은 목록을 쓴다)
-- (목록을 받은 쪽은 고치지 않는다. 같은 프레임에 누가 잡혔을 수 있으니 잡기 직전에 Status 를 다시 본다)
local apFrame, apList = -1, {} :: { { player: Player, root: BasePart, char: Model } }
local frameNo = 0
game:GetService("RunService").Heartbeat:Connect(function()
	frameNo += 1
end)
local function alivePlayers(): { { player: Player, root: BasePart, char: Model } }
	if apFrame == frameNo then
		return apList
	end
	apFrame = frameNo
	local out = {}
	apList = out
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Status") == "Alive" and not p:GetAttribute("Hidden") then
			local char = p.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if char and root and not Monster.isSafe(root.Position) then
				table.insert(out, { player = p, root = root, char = char })
			end
		end
	end
	return out
end

function Monster.startChase(self: Monster, p: Player, pos: Vector3)
	if self.state ~= "Chase" then
		self:note("chase " .. p.Name)
	end
	self.target = p
	self.lastSeen = os.clock()
	self.lastKnown = pos
	self.pullSpot = nil
	self:setState("Chase")
end

-- 누가 숨었다: 쫓던 대상이고 방금까지 보고 있었다면 숨는 곳을 기억한다
function Monster.onHide(self: Monster, p: Player, front: Vector3)
	if self.form ~= "Beast" then
		return
	end
	if self.state == "Chase" and self.target == p and os.clock() - self.lastSeen <= Config.Hide.SeenWindow then
		self:note("saw " .. p.Name .. " hide")
		self.pullSpot = front
		self.lastKnown = front
		self.waypoints = {}
	end
end

function Monster.investigate(self: Monster, pos: Vector3)
	if Monster.isSafe(pos) then
		-- 안전 구역 안의 소리: 그 앞(밖)까지만 와 본다
		pos = self:nearestOutside(pos) or pos
	end
	-- 같은 소리에 여러 마리가 몰려가지 않게: 이미 그 근처를 조사하러 가는(더 가까운) 괴물이 있으면 이 괴물은 가지 않는다
	-- (소리가 아주 가까우면 예외)
	local myD = (pos - self.root.Position).Magnitude
	if myD > 15 and self.state ~= "Chase" then
		for _, o in Monster.registry do
			if o ~= self and o.alive and (o.state == "Alert" or o.state == "Investigate" or o.state == "Search" or o.state == "Chase") then
				local og = o.goal or o.searchCenter
				if og and (og - pos).Magnitude < SHARE_SOUND and (pos - o.root.Position).Magnitude <= myD then
					return
				end
			end
		end
	end
	self.searchCenter = pos
	if self.state == "Wander" then
		self:setState("Alert")
		self.alertUntil = os.clock() + MC.AlertTime
		self.goal = pos
		return
	end
	if self.state == "Alert" then
		self.goal = pos
		return
	end
	-- 수색 중이거나 조사 중이면 새 위치로
	self:setState("Investigate")
	if not self.goal or (self.goal - pos).Magnitude > 4 or os.clock() - self.lastRepath > 1.5 then
		self.goal = pos
		self.waypoints = {}
	end
end

-- 소리를 들었다(SoundBus)
function Monster.hear(self: Monster, pos: Vector3, radius: number, source: Player?, kind: string)
	if not self.alive or os.clock() < self.startAt then
		return
	end
	if kind == "Door" and source == nil then
		return -- 괴물이 연 문 소리(괴물끼리 서로 문 소리에 끌려다니지 않게)
	end
	if self.kind == "flower" then
		self:flowerHear(pos, radius, kind)
		return
	end
	-- 챕터 괴물의 고유 규칙(공포 장치): true 를 돌려주면 기본 반응을 건너뛴다
	local cm = (self :: any).cmod
	if cm and cm.hear and cm.hear(self, pos, radius, source, kind) then
		return
	end
	if self.form ~= "Beast" then
		-- 사람 모습일 때는 소리에 반응하지 않는다. 다만 가까이서 쏜 음파에 모습이 드러나면 들킨 것
		if self.form == "Disguise" and kind == "Sonar" and source then
			self:sonarSeen(pos, source)
		end
		return
	end
	if not SoundBus.canHear(pos, self.root.Position, radius) then
		return
	end
	-- (클라이언트 몸 동작: 소리 난 쪽으로 움찔하며 고개를 돌린다)
	self.model:SetAttribute("Focus", pos)
	self.model:SetAttribute("Heard", os.clock())
	if self.state == "Chase" then
		if source and source == self.target then
			self.lastKnown = pos
			self.lastSeen = math.max(self.lastSeen, os.clock() - MC.LoseTime * 0.5)
		end
		return
	end
	self:note("heard " .. kind .. " " .. (if source then source.Name else "-"))
	self:investigate(pos)
end

-- 감각: 가까운 플레이어를 발견
function Monster.sense(self: Monster)
	local my = self.root.Position
	local best: { player: Player, root: BasePart, char: Model }? = nil
	local bestD = math.huge
	for _, e in alivePlayers() do
		local p = e.root.Position
		local d = (p - my).Magnitude
		local crouch = e.char:GetAttribute("MoveMode") == "Crouch"
		local range = if crouch then MC.SightRangeCrouch else MC.SightRange
		local limit = (self.cfg :: any).SightLimit -- (서브 괴물 기믹: 이 거리 안에서만 알아챈다)
		local senseR = MC.SenseRange
		if limit then
			range = math.min(range, limit)
			senseR = math.min(senseR, limit)
		end
		local outside = (self.cfg :: any).SenseInTerritory and self.state ~= "Chase" and not self:inTerritory(p) -- (서브 괴물: 자기 영역 밖의 사람은 모른 척)
		if d < bestD and math.abs(p.Y - my.Y) < 9 and not outside then
			if d <= senseR or (d <= range and self:lineOfSight(p + Vector3.new(0, 1, 0))) then
				best = e
				bestD = d
			end
		end
	end
	if best then
		if self.state ~= "Chase" or self.target == best.player then
			self:startChase(best.player, best.root.Position)
		elseif bestD < 6 then
			self:startChase(best.player, best.root.Position)
		end
	end
end

function Monster.checkStuck(self: Monster, moving: boolean)
	local now = os.clock()
	if now - self.progressT < 1.5 then
		return
	end
	local moved = (self.root.Position - self.progressPos).Magnitude
	self.progressPos = self.root.Position
	self.progressT = now
	if not moving or self.hum.WalkSpeed <= 0 then
		self.stuck = 0
		return
	end
	if moved < 1.0 then
		self.stuck += 1
		self:note("stuck " .. self.stuck)
		self.waypoints = {}
		if self.stuck >= 3 then
			-- 목표를 포기하고 다른 곳으로
			self.goal = nil
			if self.state ~= "Chase" then
				self:setState("Wander")
			end
		end
		if self.stuck >= 6 then
			-- 마지막 수단: 가장 가까운 배회 지점으로 옮긴다
			local best, bd = self.nodes[1], math.huge
			for _, n in self.nodes do
				local d = (n - self.root.Position).Magnitude
				if d < bd and d > 2 then
					best, bd = n, d
				end
			end
			self.model:PivotTo(CFrame.new(best + Vector3.new(0, 2.2, 0)))
			self.stuck = 0
		end
	else
		self.stuck = 0
	end
end

function Monster.tick(self: Monster)
	local now = os.clock()
	if now < self.startAt then
		return
	end
	if self.kind == "flower" then
		self:flowerTick(now)
		return
	end
	local cm = (self :: any).cmod
	if cm and cm.tick and cm.tick(self, now) then
		return
	end
	if self.form == "Disguise" then
		self:disguiseTick(now)
		return
	elseif self.form ~= "Beast" then
		return
	end
	self:sense()
	local st = self.state
	local moving = true
	if st == "Chase" then
		local t = self.target
		local char = t and t.Character
		local troot = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not t or t:GetAttribute("Status") ~= "Alive" or not troot then
			self.pullSpot = nil
			self.target = nil
			self.searchCenter = self.lastKnown or self.root.Position
			self.searchUntil = now + MC.SearchTime
			self:setState("Search")
			self.waypoints = {}
			return
		end
		local tp = troot.Position
		if Monster.isSafe(tp) then
			-- 안전 구역으로 도망쳤다: 쫓기를 그만두고 그 근처(밖)를 뒤진다
			self:note("target reached safe zone")
			self.pullSpot = nil
			self.target = nil
			self.searchCenter = self:nearestOutside(self.root.Position) or self.root.Position
			self.searchUntil = now + MC.SearchTime
			self:setState("Search")
			self.waypoints = {}
			return
		end
		local d = (tp - self.root.Position).Magnitude
		if self.kind == "doppel" then
			-- 덮칠 만큼 가까우면 머리~배의 틈이 세로 입으로 벌어진다(조금 멀어지면 다시 닫힌다)
			if d < self.cfg.MawDistance then
				self:setMaw(true)
			elseif d > self.cfg.MawDistance + 3 then
				self:setMaw(false)
			end
		end
		local hidden = t:GetAttribute("Hidden") == true
		if hidden and self.pullSpot then
			-- 숨는 걸 봤다: 그 앞으로 가서 끌어낸다
			local front = self.pullSpot
			local flat = Vector3.new(front.X - self.root.Position.X, 0, front.Z - self.root.Position.Z).Magnitude
			if flat < 4.5 then
				self:note("pulled out " .. t.Name)
				self.pullSpot = nil
				Hiding.exit(t)
				self.onCatch(t, self)
				self.target = nil
				self.searchCenter = front
				self.searchUntil = now + MC.SearchTime
				self:setState("Search")
				self.waypoints = {}
				return
			end
			if #self.waypoints == 0 or self:follow() then
				if not self:pathTo(front) then
					self.hum:MoveTo(front)
				end
			end
			self:checkStuck(true)
			return
		end
		if not hidden then
			self.pullSpot = nil
		end
		local losR = if (self.cfg :: any).SightLimit then math.max((self.cfg :: any).SightLimit + 6, 10) else 40
		local los = not hidden and d < losR and self:lineOfSight(tp)
		if los then
			self.lastSeen = now
			self.lastKnown = tp
		end
		if now - self.lastSeen > MC.LoseTime then
			-- 놓쳤다: 마지막 위치로 가서 수색
			self:note("lost target")
			self.target = nil
			self:setState("Investigate")
			self.goal = self.lastKnown
			self.searchCenter = self.lastKnown
			self.waypoints = {}
			return
		end
		if los and d < 14 and math.abs(tp.Y - self.root.Position.Y) < 3 then
			self.waypoints = {}
			self.hum:MoveTo(tp)
			Doors.openNear(self.root.Position + self.root.CFrame.LookVector * 2, 6, self.root.Position)
		else
			local goal = self.lastKnown or tp
			-- 다시 계산: 경로가 없을 때, 또는 RepathChase 가 지났고 목표가 움직였을 때(가만히 있는 목표면 2초마다만).
			-- (예전엔 0.5초마다 무조건 다시 계산했다. 목표가 그대로면 같은 경로가 나온다)
			local og = self.goal
			local goalMoved = og == nil or Vector2.new(goal.X - og.X, goal.Z - og.Z).Magnitude > 2 or math.abs(goal.Y - og.Y) > 6
			-- (길을 못 찾았으면 0.4초 동안은 다시 계산하지 않는다: 예전엔 실패하면 0.1초 tick 마다 최대 4번씩 계산했다)
			local failWait = now - ((self :: any).pathFailAt or 0) < 0.4
			if (#self.waypoints == 0 and not failWait) or (now - self.lastRepath > MC.RepathChase and (goalMoved or now - self.lastRepath > 2)) then
				if not self:pathTo(goal) then
					self.lastRepath = now
					;(self :: any).pathFailAt = now
				end
			end
			self:follow()
		end
	elseif st == "Alert" then
		moving = false
		if self.goal then
			local look = Vector3.new(self.goal.X, self.root.Position.Y, self.goal.Z)
			if (look - self.root.Position).Magnitude > 0.5 then
				self.hum:MoveTo(self.root.Position + (look - self.root.Position).Unit * 0.5)
			end
		end
		if now >= self.alertUntil then
			self:setState("Investigate")
			self.waypoints = {}
		end
	elseif st == "Investigate" then
		local goal = self.goal or self.searchCenter
		if not goal then
			self:setState("Wander")
			return
		end
		if #self.waypoints == 0 then
			if not self:pathTo(goal) then
				-- 그 자리로 갈 수 없다: 근처 배회 지점을 대신 조사
				local best, bd = nil, math.huge
				for _, n in self.nodes do
					local dd = (n - goal).Magnitude
					if dd < bd then
						best, bd = n, dd
					end
				end
				if best and (best - goal).Magnitude > 0.5 and bd < 20 then
					self.goal = best
					if not self:pathTo(best) then
						self:setState("Wander")
						return
					end
				else
					self:setState("Wander")
					return
				end
			end
		end
		local arrived = self:follow()
		if arrived or (self.root.Position - goal).Magnitude < 4 then
			self.searchCenter = goal
			self.searchUntil = now + MC.SearchTime
			self:setState("Search")
			self.waypoints = {}
		end
	elseif st == "Search" then
		if now > self.searchUntil then
			self:setState("Wander")
			self.waypoints = {}
			return
		end
		if #self.waypoints == 0 or self:follow() then
			local c = self.searchCenter or self.root.Position
			local ok = false
			for _ = 1, 4 do
				local ang = math.random() * math.pi * 2
				local r = MC.SearchRadius * (0.4 + math.random() * 0.6)
				local p = c + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
				if not Monster.isSafe(p) and self:pathTo(p) then
					ok = true
					break
				end
			end
			if not ok then
				self:setState("Wander")
			end
		end
	else -- Wander
		if #self.waypoints == 0 or self:follow() then
			-- 다른 괴물이 가까우면 그 반대쪽으로(한 곳에 몰리지 않게)
			local away = self.root.Position
			local nearest, nd = nil, SPREAD
			for _, o in Monster.registry do
				if o ~= self and o.alive and o.root then
					local d = (o.root.Position - self.root.Position).Magnitude
					if d < nd then
						nearest, nd = o, d
					end
				end
			end
			if nearest then
				away = nearest.root.Position
			end
			local n = self:randomNode(away)
			-- 넓은 맵에서 영영 마주치지 않는 일이 없게: 가끔 플레이어(숨지 않은) 근처로 배회한다
			if now - self.lastHunt >= MC.HuntEvery then
				self.lastHunt = now
				-- (자기 반쪽에 있는 플레이어만 찾아간다)
				local ps = {}
				for _, e in alivePlayers() do
					if self:inTerritory(e.root.Position) then
						table.insert(ps, e)
					end
				end
				if #ps > 0 then
					local pick = ps[math.random(1, #ps)]
					local tp = pick.root.Position
					local near = {}
					for _, c in self.nodes do
						local dd = (c - tp).Magnitude
						if dd > 12 and dd <= MC.HuntRadius and not Monster.isSafe(c) then
							table.insert(near, c)
						end
					end
					local best = if #near > 0 then near[math.random(1, #near)] else nil
					if best then
						self:note("hunt near " .. pick.player.Name)
						n = best
					end
				end
			end
			if not self:pathTo(n) then
				self.waypoints = {}
			end
		end
	end
	if Monster.isSafe(self.root.Position) then
		local out = self:nearestOutside(self.root.Position)
		if out then
			self.waypoints = {}
			self.hum:MoveTo(out)
		end
	end
	self:checkStuck(moving)
end

-- ── 도플갱어: 사람 흉내 → 들킴 → 5~10초 뒤 터지며 괴물로 ──
local RoundEvent: RemoteEvent? = nil
local function roundEvent(): RemoteEvent?
	if not RoundEvent then
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		RoundEvent = remotes and remotes:FindFirstChild("RoundEvent") :: RemoteEvent?
	end
	return RoundEvent
end

-- 가짜 음파: 머리 높이에서 팀원 음파와 똑같이(SonarPulse, userId 0 + 이 모델)
local SonarPulseRemote: RemoteEvent? = nil
function Monster.fakeSonar(self: Monster)
	if not SonarPulseRemote then
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		SonarPulseRemote = remotes and remotes:FindFirstChild("SonarPulse") :: RemoteEvent?
	end
	local head = self.model:FindFirstChild("Head") :: BasePart?
	local origin = if head then head.Position else self.root.Position + Vector3.new(0, 1.5, 0)
	if SonarPulseRemote then
		SonarPulseRemote:FireAllClients(0, origin, self.model)
	end
	self.model:SetAttribute("FakePing", os.clock()) -- (테스트·기록용. 소리는 SonarPulse 가 낸다)
end

-- 들켰다: 변신 시각을 정한다(Config.Doppel.TransformDelay: 10~30초 뒤, 그때 플레이어가 가까이 있어야 변신)
function Monster.discover(self: Monster, p: Player)
	if self.discoveredBy or self.form ~= "Disguise" then
		return
	end
	self.discoveredBy = p
	self.transformAt = os.clock() + between(self.cfg.TransformDelay)
	self.waypoints = {}
	self.model:SetAttribute("Discovered", true)
	self:note(string.format("discovered by %s, transform in %.1f", p.Name, self.transformAt - os.clock()))
end

-- 가까이서 쏜 음파(벽 1장 이하)에 모습이 드러났다
function Monster.sonarSeen(self: Monster, pos: Vector3, source: Player)
	local my = self.root.Position
	if (pos - my).Magnitude <= self.cfg.SonarRange and SoundBus.wallsBetween(pos, my) <= 1 then
		self:discover(source)
	end
end

-- 사람 모습일 때: 플레이어처럼 걷다 멈춰 두리번, 가끔 가짜 음파 소리. 누가 가까이서 보면 들킨다
function Monster.disguiseTick(self: Monster, now: number)
	local cfg = self.cfg
	local my = self.root.Position
	if not self.discoveredBy then
		for _, e in alivePlayers() do
			local p = e.root.Position
			if (p - my).Magnitude <= cfg.SeeRange and math.abs(p.Y - my.Y) < 6 and self:lineOfSight(p) then
				self:discover(e.player)
				break
			end
		end
	end
	local who = self.discoveredBy
	if who then
		if now >= self.transformAt then
			-- 시간이 됐어도 플레이어가 가까이(TransformNear) 있을 때만 변신한다. 멀면 가까워질 때까지 사람 모습으로 기다린다
			local near = false
			for _, e in alivePlayers() do
				if (e.root.Position - my).Magnitude <= (cfg.TransformNear or 20) then
					near = true
					break
				end
			end
			if near then
				self:transform()
				return
			end
		end
		-- 변신 전: 발견한 플레이어를 바라보며 아주 천천히 다가온다(멀면 그 자리에 서서 바라본다)
		local char = who.Character
		local troot = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		self.hum.WalkSpeed = cfg.StalkSpeed
		if troot and who:GetAttribute("Status") == "Alive" then
			local tp = troot.Position
			local flat = Vector3.new(tp.X - my.X, 0, tp.Z - my.Z)
			if flat.Magnitude > 4 and flat.Magnitude < 30 and self:lineOfSight(tp) then
				self.hum:MoveTo(tp)
			else
				self.hum:MoveTo(my)
				if flat.Magnitude > 0.5 then
					self.root.CFrame = CFrame.lookAt(my, my + flat.Unit)
				end
			end
		else
			self.hum:MoveTo(my)
		end
		return
	end
	self.hum.WalkSpeed = cfg.WalkSpeed
	-- 멈춰 서서 두리번
	if now < self.pauseUntil then
		self.hum:MoveTo(my)
		return
	end
	if now >= self.nextPause then
		self.pauseUntil = now + between(cfg.PauseFor)
		self.nextPause = self.pauseUntil + between(cfg.PauseEvery)
		self.waypoints = {}
		self.hum:MoveTo(my)
		return
	end
	-- 가짜 음파: 플레이어처럼 진짜 음파를 쏜다(모두에게 파동·소리가 보이고 들린다. 괴물을 부르지는 않는다)
	if now >= self.nextPing then
		self.nextPing = now + between(cfg.FakePingEvery)
		self:fakeSonar()
	end
	if #self.waypoints == 0 or self:follow() then
		if not self:pathTo(self:randomNode(my)) then
			self.waypoints = {}
		end
	end
	self:checkStuck(true)
end

-- 도플갱어를 진짜 아바타로 입힌다(친구 목록의 사람, 없으면 지금 플레이어 중 한 명 — 혼자면 내 모습).
-- 아바타 몸(R15 파트·장신구)을 모델 바로 아래로 옮기고(속성 DisguisePart), 관절을 우리 루트에 잇는다.
-- 몸은 그대로 보인다: 클라이언트가 팀원과 똑같이 늘 흰 윤곽선을 씌운다(Mates). 음파 선은 그리지 않는다(플레이어처럼)
local WALK_ANIM = "rbxassetid://507777826" -- 로블록스 기본 R15 걷기
local IDLE_ANIM = "rbxassetid://507766388" -- 로블록스 기본 R15 서 있기
function Monster.applyAvatar(self: Monster, desc: HumanoidDescription, who: string): boolean
	if self.form ~= "Disguise" or not self.alive or not self.model.Parent then
		return false
	end
	local ok, av = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not av then
		warn("[Doppel] avatar build failed: " .. tostring(av))
		return false
	end
	local avatar = av :: Model
	local avRoot = avatar:FindFirstChild("HumanoidRootPart") :: BasePart?
	local avHum = avatar:FindFirstChildOfClass("Humanoid")
	if not avRoot or not avHum or self.form ~= "Disguise" then
		avatar:Destroy()
		return false
	end
	avatar:PivotTo(self.root.CFrame)
	-- 예전 상자 몸 치우기
	for _, j in self.root:GetChildren() do
		if j:IsA("Motor6D") and j.Name:find("^DJoint") then
			j:Destroy()
		end
	end
	local old = self.model:FindFirstChild("Disguise")
	if old then
		old:Destroy()
	end
	self.joints = {}
	local tag = Config.Tags.Renderable
	for _, c in avatar:GetChildren() do
		if c ~= avRoot and not c:IsA("Humanoid") and not c:IsA("BaseScript") then
			c:SetAttribute("DisguisePart", true)
			c.Parent = self.model
			local list: { Instance } = c:GetDescendants()
			table.insert(list, c)
			for _, d in list do
				if d:IsA("JointInstance") then
					local jd = d :: any
					if jd.Part0 == avRoot then
						jd.Part0 = self.root
					end
					if jd.Part1 == avRoot then
						jd.Part1 = self.root
					end
				elseif d:IsA("WeldConstraint") then
					if d.Part0 == avRoot then
						d.Part0 = self.root
					end
					if d.Part1 == avRoot then
						d.Part1 = self.root
					end
				elseif d:IsA("BasePart") then
					d.Anchored = false
					d.Massless = true
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.CastShadow = false
					-- (투명하게 하지 않는다: 들키기 전에도 팀원처럼 늘 그 사람 모습으로 보인다)
					CollectionService:AddTag(d, tag)
				end
			end
		end
	end
	self.hum.HipHeight = avHum.HipHeight
	avatar:Destroy()
	-- 플레이어와 같은 걷기·서 있기 애니메이션
	local animator = self.hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = self.hum
	end
	local function load(id: string, fallback: string): AnimationTrack
		local a = Instance.new("Animation")
		a.AnimationId = if id ~= "" and id ~= "rbxassetid://0" then id else fallback
		local tr = (animator :: Animator):LoadAnimation(a)
		tr.Looped = true
		return tr
	end
	self.tracks = {
		walk = load(if desc.WalkAnimation ~= 0 then "rbxassetid://" .. desc.WalkAnimation else "", WALK_ANIM),
		idle = load(if desc.IdleAnimation ~= 0 then "rbxassetid://" .. desc.IdleAnimation else "", IDLE_ANIM),
	}
	self.model:SetAttribute("AvatarOf", who)
	self.model:SetAttribute("BodyVersion", ((self.model:GetAttribute("BodyVersion") :: number?) or 1) + 1)
	self:note("dressed as " .. who)
	return true
end

-- 사람 모습이 터지고(클라이언트가 조각을 흩날린다) 그 자리에서 괴물이 나온다
function Monster.transform(self: Monster)
	if self.form ~= "Disguise" then
		return
	end
	self.form = "Bursting"
	self.model:SetAttribute("Form", "Bursting")
	self.hum.WalkSpeed = 0
	self.hum:MoveTo(self.root.Position)
	local boxes = {}
	local disguise = self.model:FindFirstChild("Disguise")
	if disguise then
		for _, d in disguise:GetChildren() do
			if d:IsA("BasePart") and d.Name ~= "Body" and not d.Name:find("^Pivot") then
				table.insert(boxes, { cf = d.CFrame, size = d.Size })
			end
		end
	end
	-- 진짜 아바타 모습이면 그 몸 파트들(장신구 포함)이 터진다
	local avatarParts: { Instance } = {}
	for _, c in self.model:GetChildren() do
		if c:GetAttribute("DisguisePart") then
			table.insert(avatarParts, c)
			local list: { Instance } = c:GetDescendants()
			table.insert(list, c)
			for _, d in list do
				if d:IsA("BasePart") and #boxes < 40 then
					table.insert(boxes, { cf = d.CFrame, size = d.Size })
				end
			end
		end
	end
	if self.tracks then
		self.tracks.walk:Stop(0)
		self.tracks.idle:Stop(0)
		self.tracks = nil
	end
	local ev = roundEvent()
	if ev then
		ev:FireAllClients("DoppelBurst", { at = self.root.Position, boxes = boxes })
	end
	-- 사람 몸(상자·관절)을 없애고 괴물 몸을 붙인다
	for _, j in self.root:GetChildren() do
		if j:IsA("Motor6D") and j.Name:find("^DJoint") then
			j:Destroy()
		end
	end
	if disguise then
		disguise:Destroy()
	end
	for _, c in avatarParts do
		c:Destroy()
	end
	self.hum.HipHeight = DOPPEL_HIP
	buildBeast(self.model, self.root, self.root.CFrame)
	self.joints = {}
	for _, name in { "Leg-1", "Leg1", "Arm-1", "Arm1" } do
		local motor = self.root:FindFirstChild("Joint" .. name) :: Motor6D?
		if motor then
			local isLeg = name:sub(1, 3) == "Leg"
			local left = name:find("-1") ~= nil
			table.insert(self.joints, { motor = motor, base = motor.C0, offset = if (isLeg == left) then 0 else math.pi, amp = if isLeg then 0.45 else 0.35 })
		end
	end
	self.mawOpen = false
	self.model:SetAttribute("BodyVersion", ((self.model:GetAttribute("BodyVersion") :: number?) or 1) + 1)
	self.model:SetAttribute("Form", "Beast")
	self.form = "Beast"
	self:note("transformed")
	-- 터지는 동안 잠깐 멈췄다가 발견한 플레이어를 쫓는다
	local now = os.clock()
	self.startAt = now + self.cfg.BurstPause
	local who = self.discoveredBy
	local char = who and who.Character
	local troot = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if who and troot and who:GetAttribute("Status") == "Alive" then
		self:startChase(who, troot.Position)
		self.lastSeen = now + self.cfg.BurstPause
	else
		self:setState("Wander")
	end
	self.waypoints = {}
end

-- 세로 입 열기/닫기: 음파 대상 태그를 틈(Slit) ↔ 입(Maw) 선으로 바꿔 낀다(클라이언트는 BodyVersion 이 바뀌면 다시 모은다)
function Monster.setMaw(self: Monster, open: boolean)
	if self.mawOpen == open or self.form ~= "Beast" then
		return
	end
	self.mawOpen = open
	local beast = self.model:FindFirstChild("Beast")
	if not beast then
		return
	end
	local tag = Config.Tags.Renderable
	for _, p in beast:GetChildren() do
		if p:IsA("BasePart") then
			local on = if p:GetAttribute("Maw") then open elseif p:GetAttribute("Slit") then not open else nil
			if on == true then
				CollectionService:AddTag(p, tag)
			elseif on == false then
				CollectionService:RemoveTag(p, tag)
			end
		end
	end
	self.model:SetAttribute("MawOpen", open)
	self.model:SetAttribute("BodyVersion", ((self.model:GetAttribute("BodyVersion") :: number?) or 1) + 1)
end

-- ── 꽃괴물: 가만히 서 있다가 음파를 들으면 머리를 펼치고 쏜 곳으로 달려간다 ──
-- 머리 펼치기/닫기: 음파 대상 태그를 봉오리(Bud) ↔ 펼친 머리(Bloom) 선으로 바꿔 낀다
function Monster.setBloom(self: Monster, open: boolean)
	local want = if open then "Open" else "Bud"
	if self.form == want then
		return
	end
	self.form = want
	local tag = Config.Tags.Renderable
	local body = self.model:FindFirstChild("Body")
	if body then
		for _, p in body:GetChildren() do
			if p:IsA("BasePart") then
				local on = if p:GetAttribute("Bloom") then open elseif p:GetAttribute("Bud") then not open else nil
				if on == true then
					CollectionService:AddTag(p, tag)
				elseif on == false then
					CollectionService:RemoveTag(p, tag)
				end
			end
		end
	end
	self.model:SetAttribute("Form", want)
	self.model:SetAttribute("BodyVersion", ((self.model:GetAttribute("BodyVersion") :: number?) or 1) + 1)
end

-- 달려갈 곳: 음파 쏜 자리(안전 구역 안이면 그 앞, 바닥 위)
-- 꽃괴물이 들어가면 안 되는 곳: 안전 구역, 그리고 시작점 둘레(KeepOut) — 시작 위치를 막아 못 나가게 되지 않게
local function flowerBanned(self: Monster, p: Vector3): boolean
	if Monster.isSafe(p) then
		return true
	end
	local ko = (self :: any).keepOut
	return ko ~= nil and Vector3.new(p.X - ko.X, 0, p.Z - ko.Z).Magnitude < self.cfg.KeepOut
end

local function rushGoal(self: Monster, pos: Vector3): Vector3
	if flowerBanned(self, pos) then
		-- 소리 난 곳에서 가장 가까운, 들어가도 되는 지점까지만 온다
		local best, bd = nil, math.huge
		for _, n in self.nodes do
			if not flowerBanned(self, n) then
				local d = (n - pos).Magnitude
				if d < bd then
					best, bd = n, d
				end
			end
		end
		return best or self:nearestOutside(pos) or pos
	end
	return pos
end

function Monster.flowerHear(self: Monster, pos: Vector3, radius: number, kind: string)
	if kind ~= "Sonar" or not self.alive or os.clock() < self.startAt then
		return
	end
	if not SoundBus.canHear(pos, self.root.Position, radius) then
		return
	end
	local goal = rushGoal(self, pos)
	self.goal = goal
	self.waypoints = {}
	if self.state == "Dormant" then
		-- 깨어난다: 쉿(Alert 특수 소리) + 꽃잎을 펼친다, 펼치는 동안은 멈춰 있다
		self:note("woke to sonar")
		self:setBloom(true)
		self.alertUntil = os.clock() + self.cfg.WakeTime
		self:setState("Alert")
	elseif self.state == "Look" then
		self:setState("Chase")
	elseif self.state == "Return" then
		-- 돌아가던 중: 다시 펼치고 달려간다
		self:setBloom(true)
		self.alertUntil = os.clock() + self.cfg.WakeTime
		self:setState("Alert")
	end
	-- (달리는 중이면 목표만 바뀐다)
end

function Monster.flowerTick(self: Monster, now: number)
	local cfg = self.cfg
	local my = self.root.Position
	local st = self.state
	if st == "Dormant" then
		self.hum:MoveTo(my)
		return
	end
	-- 달리거나 두리번거리는 중, 바로 앞(벽 없이)에 플레이어가 있으면 덤빈다
	if st == "Chase" or st == "Look" then
		for _, e in alivePlayers() do
			local p = e.root.Position
			if (p - my).Magnitude <= cfg.GrabRange and math.abs(p.Y - my.Y) < 7 and self:lineOfSight(p) then
				self.goal = p
				self.waypoints = {}
				if st == "Look" then
					self:setState("Chase")
					st = "Chase"
				end
				self.hum:MoveTo(p)
				return
			end
		end
	end
	if st == "Alert" then
		self.hum:MoveTo(my)
		if now >= self.alertUntil then
			self:setState("Chase")
		end
		return
	end
	if st == "Chase" then
		local goal = self.goal
		if not goal then
			self:setState("Look")
			self.searchUntil = now + between(cfg.LookAround)
			return
		end
		local flat = Vector3.new(goal.X - my.X, 0, goal.Z - my.Z).Magnitude
		if flat < 4 then
			-- 도착: 아무도 없다 → 두리번
			self:note("arrived, looking around")
			self.waypoints = {}
			self.goal = nil
			self:setState("Look")
			self.searchUntil = now + between(cfg.LookAround)
			return
		end
		if #self.waypoints == 0 then
			if not self:pathTo(goal) then
				-- 갈 수 없는 곳: 가장 가까운 배회 지점으로
				local best, bd = nil, math.huge
				for _, n in self.nodes do
					local dd = (n - goal).Magnitude
					if dd < bd and not flowerBanned(self, n) then
						best, bd = n, dd
					end
				end
				if best and (best - goal).Magnitude > 0.5 then
					self.goal = best
				else
					self.goal = nil
				end
				return
			end
		end
		self:follow()
		Doors.openNear(my + self.root.CFrame.LookVector * 2, 6, my)
		self:checkStuck(true)
		return
	end
	if st == "Look" then
		self.hum:MoveTo(my)
		-- 두리번: 조금씩 몸을 돌린다
		self.root.CFrame = self.root.CFrame * CFrame.Angles(0, math.rad(math.random(-25, 25)), 0)
		if now >= self.searchUntil then
			-- 머리를 닫고 원래 자리(맵 가운데쯤)로 걸어 돌아간다(가까우면 그 자리에서 기다린다)
			self:setBloom(false)
			local home = (self :: any).home
			if home and Vector3.new(home.X - my.X, 0, home.Z - my.Z).Magnitude > 6 then
				self:note("closing, returning home")
				self.goal = home
				self.waypoints = {}
				self:setState("Return")
			else
				self:note("closing, dormant")
				self:setState("Dormant")
			end
		end
		return
	end
	if st == "Return" then
		local home = (self :: any).home
		local flat = if home then Vector3.new(home.X - my.X, 0, home.Z - my.Z).Magnitude else 0
		if not home or flat < 4 then
			self:note("home, dormant")
			self.waypoints = {}
			self.goal = nil
			self:setState("Dormant")
			return
		end
		self.goal = home
		if #self.waypoints == 0 and not self:pathTo(home) then
			-- 길을 못 찾으면 그 자리에서 기다린다
			self:setState("Dormant")
			return
		end
		self:follow()
		Doors.openNear(my + self.root.CFrame.LookVector * 2, 6, my)
		self:checkStuck(false)
		return
	end
	-- (그 밖의 상태가 되면 기다림으로)
	self:setBloom(false)
	self:setState("Dormant")
end

-- 잡기 판정(매 프레임)
function Monster.checkCatch(self: Monster)
	if not self.alive or os.clock() < self.startAt then
		return
	end
	-- 도플갱어는 괴물 모습일 때만, 꽃괴물은 머리를 펼쳤을 때만 잡는다
	if (self.kind == "doppel" and self.form ~= "Beast") or (self.kind == "flower" and self.form ~= "Open") then
		return
	end
	local my = self.root.Position
	for _, e in alivePlayers() do
		local p = e.root.Position
		local flat = Vector3.new(p.X - my.X, 0, p.Z - my.Z).Magnitude
		if flat <= self.cfg.CatchDistance and math.abs(p.Y - (my.Y - 1.5)) < 5 then
			-- (목록은 프레임 캐시: 같은 프레임에 다른 괴물이 잡았거나 방금 숨었거나 안전 구역에 들어갔으면 건너뛴다)
			local pl = e.player
			if pl:GetAttribute("Status") ~= "Alive" or pl:GetAttribute("Hidden") or Monster.isSafe(p) then
				continue
			end
			self:note("caught " .. e.player.Name)
			self.onCatch(e.player, self)
			-- 잡은 뒤에는 그 자리를 잠깐 뒤진다
			self.target = nil
			self.searchCenter = p
			self.searchUntil = os.clock() + MC.SearchTime
			self:setState("Search")
			self.waypoints = {}
		end
	end
end

function Monster.run(self: Monster)
	task.spawn(function()
		-- 괴물마다 0.1초 주기 안의 다른 시점에 생각하게 흩뿌린다(같은 프레임에 전부 몰려 경로 계산·레이가 겹치지 않게)
		task.wait(math.random() * 0.1)
		while self.alive and self.model.Parent do
			local ok, err = pcall(self.tick, self)
			Monster.stats.ticks += 1
			if not ok then
				warn("[Monster] " .. tostring(err))
				self.waypoints = {}
			end
			task.wait(0.1)
		end
	end)
end

function Monster.destroy(self: Monster)
	self.alive = false
	local i = table.find(Monster.registry, self)
	if i then
		table.remove(Monster.registry, i)
	end
	self.model:Destroy()
end

return Monster
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="236">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[--!strict
-- 스테이지별 소품 타일(창고 선반·컨테이너, 하수도 수로·대형 배관, 병원 침대·책상·수술대·캐비닛).
-- 각 함수는 StageBuilder 의 ctx 와 타일 좌표(i, j)를 받는다. 모두 MapKit 부품만 쓴다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)

local Props = {}

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

-- 타일에서 가장 가까운 벽 방향(없으면 nil)
local function wallSide(ctx, i: number, j: number): Vector3?
	for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local function emitter(parent: Instance, pos: Vector3, sound: string)
	local em = Kit.box(parent, CFrame.new(pos), Vector3.new(0.2, 0.2, 0.2), { invisible = true, collide = false, tag = false })
	em.CanQuery = false
	em:SetAttribute("Sound", sound)
	CollectionService:AddTag(em, Config.Tags.AmbientEmitter)
end

-- ── 창고 ──
-- 대형 선반(랙): 기둥 + 3단 가로보 + 선반판 + 상자. axis = 선반이 뻗는 방향
local function rack(ctx, i: number, j: number, axis: Vector3)
	local p = base(ctx, i, j)
	local across = Vector3.new(axis.Z, 0, -axis.X)
	local len, depth, height = ctx.T - 0.4, 2.4, 10
	local m = Instance.new("Model")
	m.Name = "Rack"
	m.Parent = ctx.props
	-- (선반 창고는 음파 선이 아주 많아지는 곳이라 꼭 필요한 모서리만: 기둥은 세로선, 보·판은 긴 선만)
	for _, a in { -1, 1 } do
		for _, b in { -1, 1 } do
			local c = p + axis * (a * (len / 2 - 0.15)) + across * (b * (depth / 2 - 0.15))
			Kit.box(m, CFrame.lookAt(c + Vector3.new(0, height / 2, 0), c + Vector3.new(0, height / 2, 0) + axis), Vector3.new(0.3, height, 0.3), { blocks = false, axis = "Y" })
		end
	end
	for k, y in { 0.4, 3.6, 6.8, 9.8 } do
		for _, b in { -1, 1 } do
			local c = p + across * (b * (depth / 2 - 0.15)) + Vector3.new(0, y, 0)
			Kit.box(m, CFrame.lookAt(c, c + axis), Vector3.new(0.25, 0.4, len), { blocks = false, axis = "Z" })
		end
		local deck = p + Vector3.new(0, y + 0.25, 0)
		-- 선반 판은 선을 그리지 않는다(양옆 보가 이미 선반 모양을 보여 준다)
		Kit.box(m, CFrame.lookAt(deck, deck + axis), Vector3.new(depth - 0.3, 0.12, len - 0.3), { blocks = false, collide = k == 1, shape = "None" })
		-- 상자들(층마다 위치를 바꿔서)
		if k < 3 then
			local h = ctx.hash(i * 3 + k, j, 5)
			local n = 1
			for q = 1, n do
				local off = (q - (n + 1) / 2) * 2.3 + (h - 0.5) * 0.8
				local sz = Vector3.new(1.6 + h * 0.6, 1.4 + ((q * 7 + k) % 3) * 0.4, 1.7)
				local bp = deck + axis * off + Vector3.new(0, 0.06, 0)
				local cf = CFrame.lookAt(bp + Vector3.new(0, sz.Y / 2, 0), bp + Vector3.new(0, sz.Y / 2, 0) + axis) * CFrame.Angles(0, (h - 0.5) * 0.3, 0)
				Kit.box(m, cf, Vector3.new(sz.Z, sz.Y, sz.X), { blocks = false })
			end
		end
	end
	-- 보이지 않는 충돌(선반 사이로 들어가지 않게)
	Kit.box(m, CFrame.lookAt(p + Vector3.new(0, 1.5, 0), p + Vector3.new(0, 1.5, 0) + axis), Vector3.new(depth, 3, len), { invisible = true, tag = false })
end
function Props.RackX(ctx, i, j)
	rack(ctx, i, j, Vector3.new(1, 0, 0))
end
function Props.RackZ(ctx, i, j)
	rack(ctx, i, j, Vector3.new(0, 0, 1))
end

-- 컨테이너: 골판 리브 + 한쪽 끝 문짝과 잠금 막대. stacked 면 두 단
function Props.Container(ctx, i: number, j: number, stacked: boolean?)
	local p = base(ctx, i, j)
	local axis = if ctx.hash(i, j, 9) < 0.5 then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
	local across = Vector3.new(axis.Z, 0, -axis.X)
	local len, w, h = 7.4, 6.2, 6.4
	local levels = if stacked then 2 else 1
	for lv = 0, levels - 1 do
		local y0 = lv * (h + 0.05)
		local c = p + Vector3.new(0, y0 + h / 2, 0)
		local m = Instance.new("Model")
		m.Name = "Container"
		m.Parent = ctx.props
		Kit.box(m, CFrame.lookAt(c, c + axis), Vector3.new(w, h, len))
		-- 옆면 세로 리브
		for k = -3, 3 do
			for _, s in { -1, 1 } do
				local rp = c + axis * (k * 1.0) + across * (s * (w / 2 + 0.06))
				Kit.box(m, CFrame.lookAt(rp, rp + axis), Vector3.new(0.12, h - 0.6, 0.35), { blocks = false, collide = false })
			end
		end
		-- 문 쪽(앞) 잠금 막대
		local front = c + axis * (len / 2 + 0.12)
		for _, s in { -1.6, -0.6, 0.6, 1.6 } do
			local a = front + across * s - Vector3.new(0, h / 2 - 0.3, 0)
			Kit.cylinder(m, a, a + Vector3.new(0, h - 0.6, 0), 0.09, { blocks = false, collide = false })
		end
		Kit.box(m, CFrame.lookAt(front, front + axis), Vector3.new(0.12, h - 0.4, 0.08), { blocks = false, collide = false })
	end
end
function Props.ContainerStack(ctx, i, j)
	Props.Container(ctx, i, j, true)
end

-- ── 하수도 ──
-- 수로: 아래층 바닥 위 얕은 물(선 없음, 걸어서 지나갈 수 있음) + 물소리
function Props.Water(ctx, i: number, j: number)
	local c = ctx.center(i, j)
	local s = Kit.box(ctx.props, CFrame.new(c + Vector3.new(0, ctx.PIT_Y + 0.6, 0)), Vector3.new(ctx.T, 1.2, ctx.T), { collide = false, shape = "None", blocks = false })
	s.CanQuery = false
	if (i + j) % 3 == 0 then
		emitter(ctx.props, c + Vector3.new(0, ctx.PIT_Y + 1, 0), "AmbientWater")
	end
end

-- 대형 배관(머리 위, 타일을 가로지른다)
function Props.BigPipe(ctx, i: number, j: number)
	local c = ctx.center(i, j)
	local axis = Vector3.new(1, 0, 0)
	if ctx.isWall(i - 1, j) and ctx.isWall(i + 1, j) then
		axis = Vector3.new(0, 0, 1)
	end
	local y = ctx.floorY(i, j) + 11 -- (가로대 밑이 8.9 — 괴물(키 8)도 밑으로 지나간다)
	local a = c - axis * (ctx.T / 2) + Vector3.new(0, y, 0)
	local b = c + axis * (ctx.T / 2) + Vector3.new(0, y, 0)
	Kit.pipe(ctx.props, a, b, 1.7, { 0 }, true)
	-- 받침(바닥까지 내려오는 H 프레임)
	local across = Vector3.new(axis.Z, 0, -axis.X)
	for _, s in { -1, 1 } do
		local leg = c + across * (s * 2.4) + Vector3.new(0, ctx.floorY(i, j) + (y - 1.7) / 2, 0)
		Kit.box(ctx.props, CFrame.new(leg), Vector3.new(0.4, y - 1.7, 0.4), { blocks = false })
	end
	local cross = c + Vector3.new(0, ctx.floorY(i, j) + y - 1.9, 0)
	Kit.box(ctx.props, CFrame.lookAt(cross, cross + axis), Vector3.new(5.2, 0.4, 0.5), { blocks = false })
end

-- ── 병원 ──
-- 침대: 벽에 머리를 붙인 철제 침대(다리, 매트리스, 머리판, 난간)
function Props.Bed(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local head = p + side * (ctx.T / 2 - 0.4)
	local foot = head - side * 6.6
	local across = Vector3.new(side.Z, 0, -side.X)
	local mid = (head + foot) / 2
	local m = Instance.new("Model")
	m.Name = "Bed"
	m.Parent = ctx.props
	Kit.box(m, CFrame.lookAt(mid + Vector3.new(0, 2.0, 0), mid + Vector3.new(0, 2.0, 0) + side), Vector3.new(3.0, 0.7, 6.2), { blocks = false })
	Kit.box(m, CFrame.lookAt(mid + Vector3.new(0, 1.5, 0), mid + Vector3.new(0, 1.5, 0) + side), Vector3.new(3.2, 0.25, 6.4), { blocks = false })
	for _, e in { head, foot } do
		for _, s in { -1, 1 } do
			local leg = e + across * (s * 1.5) - side * (if e == head then 0.15 else -0.15)
			Kit.cylinder(m, leg, leg + Vector3.new(0, if e == head then 3.6 else 2.8, 0), 0.1, { blocks = false })
		end
	end
	local hb = head - side * 0.15 + Vector3.new(0, 2.9, 0)
	Kit.box(m, CFrame.lookAt(hb, hb + side), Vector3.new(3.0, 1.2, 0.12), { blocks = false })
	local fb = foot + side * 0.15 + Vector3.new(0, 2.45, 0)
	Kit.box(m, CFrame.lookAt(fb, fb + side), Vector3.new(3.0, 0.7, 0.12), { blocks = false })
	for _, s in { -1, 1 } do
		local a = head - side * 1.2 + across * (s * 1.65) + Vector3.new(0, 2.8, 0)
		Kit.cylinder(m, a, a - side * 3.2, 0.06, { blocks = false, collide = false })
	end
	Kit.box(m, CFrame.lookAt(mid + Vector3.new(0, 1.5, 0), mid + Vector3.new(0, 1.5, 0) + side), Vector3.new(3.2, 3, 6.4), { invisible = true, tag = false })
end

-- 책상 + 의자
function Props.Desk(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local yaw = ctx.hash(i, j, 3) * 0.6 - 0.3
	local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0)
	local m = Instance.new("Model")
	m.Name = "Desk"
	m.Parent = ctx.props
	Kit.box(m, cf * CFrame.new(0, 3.1, 0), Vector3.new(4.6, 0.2, 2.4), { blocks = false })
	for _, x in { -2.1, 2.1 } do
		for _, z in { -1.0, 1.0 } do
			Kit.box(m, cf * CFrame.new(x, 1.5, z), Vector3.new(0.2, 3.0, 0.2), { blocks = false })
		end
	end
	Kit.box(m, cf * CFrame.new(1.4, 2.2, 0), Vector3.new(1.4, 1.5, 2.0), { blocks = false })
	-- 의자
	local ch = cf * CFrame.new(-0.6, 0, 2.2) * CFrame.Angles(0, 0.4, 0)
	Kit.box(m, ch * CFrame.new(0, 1.8, 0), Vector3.new(1.6, 0.18, 1.6), { blocks = false })
	Kit.box(m, ch * CFrame.new(0, 2.8, 0.75), Vector3.new(1.6, 1.8, 0.15), { blocks = false })
	for _, x in { -0.7, 0.7 } do
		for _, z in { -0.7, 0.7 } do
			Kit.box(m, ch * CFrame.new(x, 0.9, z), Vector3.new(0.12, 1.8, 0.12), { blocks = false })
		end
	end
	Kit.box(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(4.6, 3, 2.4), { invisible = true, tag = false })
end

-- 수술대 + 천장 원형 조명(꺼진) + 기구 카트
function Props.Surgery(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = Instance.new("Model")
	m.Name = "Surgery"
	m.Parent = ctx.props
	Kit.box(m, CFrame.new(p + Vector3.new(0, 3.0, 0)), Vector3.new(2.4, 0.4, 6.0), { blocks = false })
	Kit.cylinder(m, p + Vector3.new(0, 0, 0), p + Vector3.new(0, 2.8, 0), 0.45, { blocks = false })
	Kit.box(m, CFrame.new(p + Vector3.new(0, 0.15, 0)), Vector3.new(2.2, 0.3, 2.8), { blocks = false })
	local lamp = p + Vector3.new(0, ctx.H - ctx.floorY(i, j) - 4.2, 0)
	Kit.cylinder(m, lamp + Vector3.new(0, 4.2, 0), lamp + Vector3.new(0, 1.0, 0), 0.12, { blocks = false, collide = false })
	Kit.cylinder(m, lamp, lamp + Vector3.new(0, 1.0, 0), 1.6, { blocks = false, collide = false })
	Kit.cylinder(m, lamp + Vector3.new(2.6, 0.2, 1), lamp + Vector3.new(2.6, 0.9, 1), 0.9, { blocks = false, collide = false })
	Kit.cylinder(m, lamp + Vector3.new(0, 1.0, 0), lamp + Vector3.new(2.6, 0.9, 1), 0.1, { blocks = false, collide = false })
	local cart = p + Vector3.new(3.0, 0, -2.0)
	Kit.box(m, CFrame.new(cart + Vector3.new(0, 2.6, 0)), Vector3.new(1.4, 0.15, 2.0), { blocks = false })
	Kit.box(m, CFrame.new(cart + Vector3.new(0, 1.2, 0)), Vector3.new(1.4, 0.15, 2.0), { blocks = false })
	for _, x in { -0.6, 0.6 } do
		for _, z in { -0.9, 0.9 } do
			Kit.cylinder(m, cart + Vector3.new(x, 0, z), cart + Vector3.new(x, 2.6, z), 0.06, { blocks = false })
		end
	end
	Kit.box(m, CFrame.new(p + Vector3.new(0, 1.5, 0)), Vector3.new(2.4, 3, 6), { invisible = true, tag = false })
end

-- 캐비닛(벽에 붙은 키 큰 수납장)
function Props.Cabinet(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(1, 0, 0)
	local c = p + side * (ctx.T / 2 - 1.0) + Vector3.new(0, 3.5, 0)
	local m = Instance.new("Model")
	m.Name = "Cabinet"
	m.Parent = ctx.props
	Kit.box(m, CFrame.lookAt(c, c - side), Vector3.new(3.6, 7, 1.8))
	local face = c - side * 0.95
	Kit.box(m, CFrame.lookAt(face, face - side), Vector3.new(0.08, 6.4, 0.1), { blocks = false, collide = false })
	Kit.box(m, CFrame.lookAt(face + Vector3.new(0, 0.6, 0), face + Vector3.new(0, 0.6, 0) - side) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(0.08, 3.4, 0.1), { blocks = false, collide = false })
end

-- ── 폐유치원 ──
-- 모든 것이 어른 눈높이보다 낮다(작은 놀이기구 옆에 숨은 괴물이 오히려 커 보이게).

-- 미끄럼틀(U): 벽 쪽 사다리 + 작은 발판 + 방 안쪽으로 내려오는 미끄럼 판
function Props.Slide(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local across = Vector3.new(side.Z, 0, -side.X)
	local top = 4.6
	local deck = p + side * 1.6
	local m = Instance.new("Model")
	m.Name = "Slide"
	m.Parent = ctx.props
	-- 발판 + 네 기둥 + 난간
	Kit.box(m, CFrame.lookAt(deck + Vector3.new(0, top, 0), deck + Vector3.new(0, top, 0) + side), Vector3.new(2.8, 0.25, 2.6), { blocks = false })
	for _, a in { -1, 1 } do
		for _, b in { -1, 1 } do
			local c = deck + across * (a * 1.3) + side * (b * 1.2)
			Kit.cylinder(m, c, c + Vector3.new(0, top + 2.2, 0), 0.12, { blocks = false })
		end
		local r0 = deck + across * (a * 1.3) + Vector3.new(0, top + 1.6, 0)
		Kit.cylinder(m, r0 - side * 1.2, r0 + side * 1.2, 0.07, { blocks = false, collide = false })
	end
	-- 작은 삼각 지붕
	for _, a in { -1, 1 } do
		local c = deck + across * (a * 0.75) + Vector3.new(0, top + 2.65, 0)
		Kit.box(m, CFrame.lookAt(c, c + side) * CFrame.Angles(0, 0, a * 0.55), Vector3.new(1.75, 0.15, 2.8), { blocks = false, collide = false })
	end
	-- 사다리(벽 쪽)
	local lad = deck + side * 1.25
	for _, a in { -1, 1 } do
		local c = lad + across * (a * 0.8)
		Kit.cylinder(m, c, c + Vector3.new(0, top, 0), 0.08, { blocks = false })
	end
	for k = 1, 4 do
		local c = lad + Vector3.new(0, k * top / 5, 0)
		Kit.cylinder(m, c - across * 0.8, c + across * 0.8, 0.06, { blocks = false, collide = false })
	end
	-- 미끄럼 판(방 안쪽으로 비스듬히) + 양옆 턱
	local a0 = deck - side * 1.3 + Vector3.new(0, top, 0)
	local a1 = p - side * 3.6 + Vector3.new(0, 0.6, 0)
	local mid = (a0 + a1) / 2
	local len = (a1 - a0).Magnitude
	local cf = CFrame.lookAt(mid, a1)
	Kit.box(m, cf, Vector3.new(1.8, 0.15, len), { blocks = false })
	for _, a in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(a * 0.95, 0.3, 0), Vector3.new(0.12, 0.6, len), { blocks = false, collide = false })
	end
	Kit.box(m, CFrame.lookAt(p + Vector3.new(0, 2.5, 0), p + Vector3.new(0, 2.5, 0) + side), Vector3.new(3, 5, 6.5), { invisible = true, tag = false })
end

-- 작은 책걸상(t): 무릎 높이 탁자 + 작은 의자 둘
function Props.SmallDesk(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local yaw = ctx.hash(i, j, 3) * 0.5 - 0.25
	local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0)
	local m = Instance.new("Model")
	m.Name = "SmallDesk"
	m.Parent = ctx.props
	Kit.box(m, cf * CFrame.new(0, 2.1, 0), Vector3.new(3.8, 0.18, 2.2), { blocks = false })
	for _, x in { -1.7, 1.7 } do
		for _, z in { -0.9, 0.9 } do
			Kit.box(m, cf * CFrame.new(x, 1.0, z), Vector3.new(0.18, 2.0, 0.18), { blocks = false })
		end
	end
	for k, s in { -1, 1 } do
		local ch = cf * CFrame.new(s * 0.9, 0, 1.9) * CFrame.Angles(0, (ctx.hash(i, j, 5 + k) - 0.5) * 0.8, 0)
		Kit.box(m, ch * CFrame.new(0, 1.1, 0), Vector3.new(1.1, 0.14, 1.1), { blocks = false })
		Kit.box(m, ch * CFrame.new(0, 1.75, 0.5), Vector3.new(1.1, 1.0, 0.12), { blocks = false })
		for _, x in { -0.45, 0.45 } do
			for _, z in { -0.45, 0.45 } do
				Kit.box(m, ch * CFrame.new(x, 0.55, z), Vector3.new(0.1, 1.1, 0.1), { blocks = false })
			end
		end
	end
	Kit.box(m, cf * CFrame.new(0, 1.2, 0.6), Vector3.new(3.8, 2.4, 3.6), { invisible = true, tag = false })
end

-- 장난감 더미(y): 뚜껑 열린 장난감 상자 + 쌓기 블록 + 공 + 곰 인형
function Props.ToyPile(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local across = Vector3.new(side.Z, 0, -side.X)
	local h = ctx.hash(i, j, 7)
	local c = p + side * (ctx.T / 2 - 1.4)
	local m = Instance.new("Model")
	m.Name = "ToyPile"
	m.Parent = ctx.props
	local box = CFrame.lookAt(c + Vector3.new(0, 0.9, 0), c + Vector3.new(0, 0.9, 0) - side)
	Kit.box(m, box, Vector3.new(3.0, 1.8, 1.9), { blocks = false })
	Kit.box(m, box * CFrame.new(0, 1.3, 1.1) * CFrame.Angles(-1.2, 0, 0), Vector3.new(3.0, 0.15, 1.9), { blocks = false, collide = false })
	-- 블록 탑
	local b0 = c - side * 2.0 + across * (if h < 0.5 then 1.4 else -1.4)
	for k = 0, 2 do
		local s = 0.9 - k * 0.12
		Kit.box(m, CFrame.new(b0 + Vector3.new(0, s / 2 + k * 0.85, 0)) * CFrame.Angles(0, k * 0.5 + h, 0), Vector3.new(s, s, s), { blocks = false })
	end
	Kit.ball(m, c - side * 2.4 + across * (if h < 0.5 then -1.2 else 1.2) + Vector3.new(0, 0.6, 0), 0.6, { blocks = false, collide = false })
	-- 곰 인형(상자 위에 기대 앉은 실루엣)
	local t = c + across * 0.6 + Vector3.new(0, 1.8, 0) - side * 0.3
	Kit.ball(m, t + Vector3.new(0, 0.55, 0), 0.55, { blocks = false, collide = false })
	Kit.ball(m, t + Vector3.new(0, 1.4, 0), 0.42, { blocks = false, collide = false })
	for _, s in { -1, 1 } do
		Kit.ball(m, t + Vector3.new(0, 1.78, 0) + across * (s * 0.32), 0.16, { blocks = false, collide = false })
	end
	Kit.box(m, CFrame.lookAt(c - side * 0.6 + Vector3.new(0, 1.2, 0), c - side * 0.6 + Vector3.new(0, 1.2, 0) + side), Vector3.new(3.4, 2.4, 3.2), { invisible = true, tag = false })
end

-- 볼풀(G): 밟고 지나가는 칸. 공 몇 개 + 볼풀이 아닌 쪽 가장자리에 낮은 쿠션 턱(통과됨)
function Props.BallPit(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = Instance.new("Model")
	m.Name = "BallPit"
	m.Parent = ctx.props
	for k = 1, 5 do
		local a, b, r = ctx.hash(i, j, 10 + k), ctx.hash(i, j, 20 + k), 0.45 + ctx.hash(i, j, 30 + k) * 0.2
		Kit.ball(m, p + Vector3.new((a - 0.5) * 6.4, r + (k % 2) * 0.3, (b - 0.5) * 6.4), r, { blocks = false, collide = false })
	end
	for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		local n = ctx.at(i + d[1], j + d[2])
		if n ~= "G" and not ctx.isWall(i + d[1], j + d[2]) then
			local v = Vector3.new(d[1], 0, d[2])
			local e = p + v * (ctx.T / 2 - 0.4) + Vector3.new(0, 0.6, 0)
			Kit.box(m, CFrame.lookAt(e, e + v), Vector3.new(ctx.T, 1.2, 0.8), { blocks = false, collide = false })
		end
	end
end

-- 낮잠 매트(N): 밟고 지나가는 얇은 매트 + 베개
function Props.NapMat(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = Instance.new("Model")
	m.Name = "NapMat"
	m.Parent = ctx.props
	local cf = CFrame.new(p) * CFrame.Angles(0, (ctx.hash(i, j, 4) - 0.5) * 0.25, 0)
	Kit.box(m, cf * CFrame.new(0, 0.15, 0), Vector3.new(2.6, 0.3, 5.6), { blocks = false, collide = false })
	Kit.box(m, cf * CFrame.new(0, 0.45, -2.2), Vector3.new(1.8, 0.35, 0.9), { blocks = false, collide = false })
	if ctx.hash(i, j, 6) < 0.4 then
		Kit.box(m, cf * CFrame.new(0.2, 0.4, 0.8) * CFrame.Angles(0, 0.3, 0), Vector3.new(2.4, 0.15, 2.6), { blocks = false, collide = false }) -- 흐트러진 이불
	end
end

-- 작은 변기·세면대(j)
function Props.KidToilet(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local c = p + side * (ctx.T / 2 - 1.2)
	local m = Instance.new("Model")
	m.Name = "KidToilet"
	m.Parent = ctx.props
	if ctx.hash(i, j, 8) < 0.5 then
		Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 1.9, 0), c + Vector3.new(0, 1.9, 0) - side), Vector3.new(1.6, 1.0, 0.5), { blocks = false })
		Kit.cylinder(m, c - side * 0.9, c - side * 0.9 + Vector3.new(0, 1.0, 0), 0.65, { blocks = false })
		Kit.cylinder(m, c - side * 0.9 + Vector3.new(0, 1.0, 0), c - side * 0.9 + Vector3.new(0, 1.15, 0), 0.75, { blocks = false })
	else
		Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 2.2, 0) - side * 0.4, c + Vector3.new(0, 2.2, 0) - side), Vector3.new(2.2, 0.4, 1.4), { blocks = false })
		Kit.cylinder(m, c - side * 0.3, c - side * 0.3 + Vector3.new(0, 2.0, 0), 0.25, { blocks = false })
		Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 4.2, 0) + side * 0.4, c + Vector3.new(0, 4.2, 0) - side), Vector3.new(1.8, 1.4, 0.08), { blocks = false, collide = false }) -- 낮은 거울
	end
	Kit.box(m, CFrame.lookAt(c - side * 0.5 + Vector3.new(0, 1.2, 0), c - side * 0.5 + Vector3.new(0, 1.2, 0) + side), Vector3.new(2.4, 2.4, 2.4), { invisible = true, tag = false })
end

-- 낮은 기어가는 통로(q): 어린이 키 높이로 내려온 천장 + 칸마다 둥근 테(통과됨, 괴물도 지나간다)
function Props.LowTunnel(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = Instance.new("Model")
	m.Name = "LowTunnel"
	m.Parent = ctx.props
	local low = 6.4
	Kit.box(m, CFrame.new(p + Vector3.new(0, low + 0.15, 0)), Vector3.new(ctx.T, 0.3, ctx.T), { blocks = false, collide = false })
	local ns = ctx.isWall(i - 1, j) and ctx.isWall(i + 1, j) -- 양옆이 벽이면 남북 통로
	local along = if ns then Vector3.new(0, 0, 1) else Vector3.new(1, 0, 0)
	local across = Vector3.new(along.Z, 0, -along.X)
	for _, s in { -1, 1 } do
		local c = p + across * (s * (ctx.T / 2 - 0.5))
		Kit.cylinder(m, c, c + Vector3.new(0, low, 0), 0.18, { blocks = false, collide = false })
	end
	Kit.cylinder(m, p - across * (ctx.T / 2 - 0.5) + Vector3.new(0, low - 0.2, 0), p + across * (ctx.T / 2 - 0.5) + Vector3.new(0, low - 0.2, 0), 0.18, { blocks = false, collide = false })
end

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="237">
        <Properties>
          <string name="Name">RateLimit</string>
          <string name="Source"><![CDATA[--!strict
-- 리모트 과부하 방어: 플레이어·이름마다 토큰 통(초당 rate 개, 한 번에 burst 개까지). 정상 입력보다 넉넉하게 잡아
-- 평소 플레이는 절대 막히지 않고, 한꺼번에 수백 번 보내는 것만 버린다. 나간 플레이어 기록은 지운다.

local Players = game:GetService("Players")

local RateLimit = {}

type Bucket = { tokens: number, at: number }
local buckets: { [Player]: { [string]: Bucket } } = {}
RateLimit.dropped = {} :: { [string]: number } -- (측정) 버린 수

-- true 면 처리, false 면 버린다
function RateLimit.allow(p: Player, key: string, rate: number, burst: number): boolean
	local per = buckets[p]
	if not per then
		if not p.Parent then
			return false -- (이미 나간 사람)
		end
		per = {}
		buckets[p] = per
	end
	local now = os.clock()
	local b = per[key]
	if not b then
		b = { tokens = burst, at = now }
		per[key] = b
	end
	b.tokens = math.min(burst, b.tokens + (now - b.at) * rate)
	b.at = now
	if b.tokens < 1 then
		RateLimit.dropped[key] = (RateLimit.dropped[key] or 0) + 1
		return false
	end
	b.tokens -= 1
	return true
end

Players.PlayerRemoving:Connect(function(p)
	buckets[p] = nil
end)

return RateLimit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="238">
        <Properties>
          <string name="Name">Rejoin</string>
          <string name="Source"><![CDATA[--!strict
-- 끊겼을 때 진행 중이던 게임으로 다시 들어가기.
-- 방에서 시작한 게임은 예약(비공개) 서버라서, 연결이 끊기면(휴대폰 오류 277 등) 친구 따라가기로도 못 들어온다.
--  · 게임 서버: 로비가 넘겨준 예약 서버 접속 코드를 기억하고, 이 게임에 참가한 사람마다 "살아 있음"을 30초마다 적는다(MemoryStore).
--  · 로비 서버: 들어온 사람에게 최근(90초 안) 살아 있는 게임 기록이 있으면 그 예약 서버로 바로 보낸다.
--  · 게임이 끝나면(마지막 스테이지 클리어) 기록을 지운다. 서버가 닫히면 기록이 갱신되지 않아 90초 뒤 저절로 무시된다.
-- Studio·API 꺼짐 등 MemoryStore 를 못 쓰면 조용히 아무것도 하지 않는다.

local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Rejoin = {}
Rejoin.FRESH = 90 -- 이 초 안에 갱신된 기록만 "진행 중"
Rejoin.TTL = 15 * 60 -- 기록 보관(초)
Rejoin.code = nil :: string? -- (게임 서버) 이 예약 서버의 접속 코드
Rejoin.roster = {} :: { [number]: boolean } -- (게임 서버) 이 게임에 들어왔던 사람(끊겨도 남는다)

local map: MemoryStoreSortedMap? = nil
local function store(): MemoryStoreSortedMap?
	if RunService:IsStudio() then
		return nil
	end
	if not map then
		local ok, m = pcall(function()
			return MemoryStoreService:GetSortedMap("SonarRejoin")
		end)
		map = if ok then m else nil
	end
	return map
end

local function write(userId: number)
	local m = store()
	if not m or not Rejoin.code then
		return
	end
	pcall(function()
		m:SetAsync(tostring(userId), { code = Rejoin.code, at = os.time() }, Rejoin.TTL)
	end)
end

function Rejoin.forget(userId: number)
	local m = store()
	if not m then
		return
	end
	pcall(function()
		m:RemoveAsync(tostring(userId))
	end)
end

-- (로비 서버) 이 사람이 돌아갈 진행 중인 게임의 접속 코드
function Rejoin.lookup(userId: number): string?
	local m = store()
	if not m then
		return nil
	end
	local ok, data = pcall(function()
		return m:GetAsync(tostring(userId))
	end)
	if ok and type(data) == "table" and type(data.code) == "string" and type(data.at) == "number" and os.time() - data.at <= Rejoin.FRESH then
		return data.code
	end
	return nil
end

-- (게임 서버) 들어온 사람의 접속 코드를 기억하고 명단에 넣는다
function Rejoin.arrived(p: Player)
	local ok, jd = pcall(function()
		return p:GetJoinData()
	end)
	local td = ok and jd and (jd :: any).TeleportData
	if type(td) == "table" and type(td.code) == "string" and not Rejoin.code then
		Rejoin.code = td.code
	end
	Rejoin.roster[p.UserId] = true
	write(p.UserId)
end

-- (게임 서버) 게임이 끝났다: 기록을 지워 다시 끌려오지 않게
local ended = false
function Rejoin.gameOver()
	ended = true
	for userId in Rejoin.roster do
		Rejoin.forget(userId)
	end
end

-- (게임 서버) 30초마다 명단 전원의 "진행 중" 갱신(끊긴 사람도 돌아올 수 있게)
function Rejoin.startHeartbeat()
	task.spawn(function()
		while not ended do
			if Rejoin.code then
				for userId in Rejoin.roster do
					write(userId)
				end
			end
			task.wait(30)
		end
	end)
end

Players.PlayerRemoving:Connect(function(_p)
	-- (기록은 남겨 둔다: 끊긴 사람이 다시 켜면 돌아올 수 있게. 게임이 끝나거나 서버가 닫히면 무시된다)
end)

return Rejoin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="239">
        <Properties>
          <string name="Name">Round</string>
          <string name="Source"><![CDATA[--!strict
-- 라운드(스테이지) 진행: 스테이지 짓기 → 플레이어 배치 → 괴물 → 탈출/사망 판정 → 다음 스테이지 또는 재시작.
-- 플레이어 상태(Player 속성 "Status"): "Waiting" | "Alive" | "Dead" | "Escaped"
-- ReplicatedStorage 속성: StageIndex, StageName, RoundState("Waiting"|"Lobby"|"Loading"|"Playing"|"Result"), RoundId, Mode("Lobby"|"Game")
-- 로비(RoundState "Lobby"): 로비 맵을 스테이지처럼 지어 음파로 본다. 방(Lobby.luau)에서 시작하면 그 방 사람만 참가자(Round.members).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local Builder = require(script.Parent.StageBuilder)
local HomeProps = require(script.Parent.HomeProps)
local Doors = require(script.Parent.Doors)
local SoundBus = require(script.Parent.SoundBus)
local Monster = require(script.Parent.Monster)
local Rejoin = require(script.Parent.Rejoin)
local Hiding = require(script.Parent.Hiding)
local Search = require(script.Parent.Search)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RoundEvent = Remotes:WaitForChild("RoundEvent") :: RemoteEvent
local MapShare = Remotes:WaitForChild("MapShare") :: RemoteEvent
local RateLimit = require(script.Parent.RateLimit)

local Round = {}

-- ── 팀 지도 공유: 이번 스테이지에서 팀이 밝힌 칸(행*1024+열). 스테이지를 새로 지으면 비운다 ──
Round.explored = {} :: { [number]: boolean }
MapShare.OnServerEvent:Connect(function(p: Player, data: any)
	local build = Round.roundId
	if data == "sync" then
		-- (팀 기록 전부를 돌려주는 큰 응답: 스테이지를 받을 때 한 번이면 된다)
		if not RateLimit.allow(p, "MapSync", 0.5, 3) then
			return
		end
		-- 이 사람 지도에 지금까지 팀 기록 전부
		local all = {}
		for k in Round.explored do
			table.insert(all, k)
		end
		MapShare:FireClient(p, { build = build, tiles = all })
		return
	end
	if type(data) ~= "table" or data.build ~= build or type(data.tiles) ~= "table" then
		return
	end
	if not RateLimit.allow(p, "MapTiles", 4, 10) then
		return -- (음파가 끝날 때마다 한 번: 1.5초에 한 번 정도)
	end
	local fresh = {}
	for i = 1, math.min(#data.tiles, 800) do
		local k = data.tiles[i]
		if type(k) == "number" and k == math.floor(k) and k > 0 and k < 200000 and not Round.explored[k] then
			Round.explored[k] = true
			table.insert(fresh, k)
		end
	end
	-- 출구 칸이 처음 밝혀졌다: 팀 전체에 알린다(지도에도 이미 공유된다)
	local info = Round.info
	if #fresh > 0 and not Round.exitAnnounced and info then
		local ep = info.exitCFrame.Position
		local exitKey = (math.floor(ep.Z / 8) + 1) * 1024 + math.floor(ep.X / 8) + 1 + (if ep.Y > 9 then 100000 else 0) -- (2층 칸은 +100000)
		if table.find(fresh, exitKey) then
			Round.exitAnnounced = true
			RoundEvent:FireAllClients("ExitFound", { by = p.DisplayName, userId = p.UserId })
		end
	end
	if #fresh > 0 then
		for _, other in Players:GetPlayers() do
			if other ~= p then
				MapShare:FireClient(other, { build = build, tiles = fresh })
			end
		end
	end
end)

Round.stageIndex = 1
Round.state = "Waiting"
Round.roundId = 0
Round.lastBuildMs = 0
Round.info = nil :: Builder.StageInfo?
Round.monsters = {} :: { any }
Round.doppels = {} :: { any } -- 도플갱어(서브 괴물): 메인 괴물 수와 따로 센다
Round.flowers = {} :: { any } -- 꽃괴물(서브 괴물)
Round.autoLoop = true -- 테스트가 끌 수 있다
Round.lastOutcome = "" :: string
Round.events = {} :: { string }
Round.members = nil :: { [Player]: boolean }? -- nil 이면 서버의 모든 플레이어가 참가자
Round.returnToLobby = false -- 로비에서 시작한 게임: 마지막 스테이지를 깨거나 참가자가 모두 나가면 로비로
Round.lastAllClear = false

local stageFolder: Folder? = nil
local spawnCursor = 0
local monsterFolder: Folder = Instance.new("Folder")
monsterFolder.Name = "Monsters"
monsterFolder.Parent = workspace

local function note(s: string)
	table.insert(Round.events, string.format("%.1f %s", os.clock(), s))
	if #Round.events > 80 then
		table.remove(Round.events, 1)
	end
end

local function setStatus(p: Player, s: string)
	p:SetAttribute("Status", s)
end

function Round.status(p: Player): string
	return (p:GetAttribute("Status") :: string?) or "Waiting"
end

-- 이번 게임 참가자(로비에서 방으로 시작했으면 그 방 사람만)
function Round.participants(): { Player }
	local out = {}
	for _, p in Players:GetPlayers() do
		if not Round.members or Round.members[p] then
			table.insert(out, p)
		end
	end
	return out
end

function Round.alivePlayers(): { Player }
	local out = {}
	for _, p in Round.participants() do
		if Round.status(p) == "Alive" then
			table.insert(out, p)
		end
	end
	return out
end

local function stageDef(i: number)
	return Config.Stages[i]
end

local function stageModule(i: number): any?
	local def = stageDef(i)
	if not def then
		return nil
	end
	local m = script.Parent.Stages:FindFirstChild(def.Module)
	if not m then
		return nil
	end
	return require(m :: ModuleScript)
end

-- ── 안전 구역: 시작 칸(S)이 있는 방(벽·문·아치로 둘러싸인 곳) ──
Round.safe = {} :: { [string]: boolean }
local function computeSafe(rows: { string }): { [string]: boolean }
	local H = #rows
	local W = if H > 0 then #rows[1] else 0
	local function at(x: number, y: number): string
		if y < 0 or y >= H or x < 0 or x >= W then
			return "#"
		end
		return string.sub(rows[y + 1], x + 1, x + 1)
	end
	local set: { [string]: boolean } = {}
	local q: { { number } } = {}
	for y = 0, H - 1 do
		for x = 0, W - 1 do
			if at(x, y) == "S" then
				set[x .. "," .. y] = true
				table.insert(q, { x, y })
			end
		end
	end
	while #q > 0 do
		local c = table.remove(q) :: { number }
		for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			local nx, ny = c[1] + d[1], c[2] + d[2]
			local ch = at(nx, ny)
			local k = nx .. "," .. ny
			if ch ~= "#" and ch ~= "D" and ch ~= "A" and not set[k] then
				set[k] = true
				table.insert(q, { nx, ny })
			end
		end
	end
	return set
end

-- 이 위치가 안전 구역 안인가(맵 칸 8스터드)
function Round.inSafe(pos: Vector3): boolean
	if not Config.SafeZone.Enabled or Round.state == "Lobby" then
		return false
	end
	return Round.safe[math.floor(pos.X / 8) .. "," .. math.floor(pos.Z / 8)] == true
end
Monster.isSafe = Round.inSafe

local function buildLayout(layout: any, label: string)
	if stageFolder then
		stageFolder:Destroy()
		stageFolder = nil
	end
	Doors.clear()
	local b0 = os.clock()
	local info = Builder.build(layout, workspace, "Stage")
	Round.lastBuildMs = (os.clock() - b0) * 1000
	local folder = info.folder
	folder:SetAttribute("Rows", table.concat(layout.Rows, "/")) -- 클라이언트 지도(Q)용 격자(행을 / 로 구분)
	folder:SetAttribute("Rows2", if layout.Rows2 then table.concat(layout.Rows2, "/") else nil) -- 겹쳐 쌓은 2층 건물의 2층 격자(같은 크기)
	-- 안전 구역: 클라이언트 안내용 목록 + 괴물 길찾기가 피해 가도록 PathfindingModifier(SafeZone) 칸
	Round.safe = computeSafe(layout.Rows)
	local keys = {}
	for k in Round.safe do
		table.insert(keys, k)
	end
	folder:SetAttribute("SafeTiles", table.concat(keys, ";"))
	if Config.SafeZone.Enabled and label ~= "lobby" then
		local zone = Instance.new("Folder")
		zone.Name = "SafeZone"
		zone.Parent = folder
		for _, k in keys do
			local xy = string.split(k, ",")
			local x, y = tonumber(xy[1]) :: number, tonumber(xy[2]) :: number
			local part = Instance.new("Part")
			part.Name = "Safe"
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Transparency = 1
			part.CastShadow = false
			part.Size = Vector3.new(8, 12, 8)
			part.Position = Vector3.new(x * 8 + 4, 5, y * 8 + 4)
			local mod = Instance.new("PathfindingModifier")
			mod.Label = "SafeZone"
			mod.Parent = part
			part.Parent = zone
		end
	end
	local count = 0
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") then
			count += 1
		end
	end
	Round.roundId += 1
	table.clear(Round.explored) -- (새 스테이지: 팀 지도 기록 비우기)
	Round.exitAnnounced = false
	folder:SetAttribute("PartCount", count)
	folder:SetAttribute("BuildId", Round.roundId)
	folder:SetAttribute("BoundsMin", info.bounds.min)
	folder:SetAttribute("BoundsMax", info.bounds.max)
	-- 서브 괴물 자리에 맵에 없던 소품(욕조·칠판·풍금·모빌·천장 봉)
	if label ~= "lobby" then
		local cl = Round.chapterCreatures()
		local hm = ReplicatedStorage.Shared:FindFirstChild("CreatureHomes")
		if cl and hm then
			local ids = {}
			for _, e in cl do
				if e.sub then
					table.insert(ids, e.id)
				end
			end
			local props = folder:FindFirstChild("Props") or folder
			local n = HomeProps.place(info, require(hm) :: any, ids, props)
			if n > 0 then
				note("home props " .. n)
			end
		end
	end
	folder.Parent = workspace
	stageFolder = folder
	Round.info = info
	SoundBus.setGeometry(folder)
	note("built " .. label .. " parts=" .. count)
end

function Round.buildStage(i: number)
	local layout = stageModule(i)
	assert(layout, "stage module missing: " .. tostring(i))
	buildLayout(layout, "stage " .. i)
end

local function nextSpawn(): CFrame
	local info = Round.info :: Builder.StageInfo
	spawnCursor += 1
	local n = #info.spawns
	local cf = info.spawns[((spawnCursor - 1) % n) + 1]
	-- 시작 칸보다 사람이 많으면(최대 6명, 시작 칸 4개) 같은 칸 안에서 옆으로 비켜 선다(겹치지 않게)
	local lap = math.floor((spawnCursor - 1) / n)
	if lap > 0 then
		cf = cf * CFrame.new(if lap % 2 == 1 then 2.5 else -2.5, 0, 0)
	end
	return cf
end

function Round.spawnPlayer(p: Player)
	if not Round.info then
		return
	end
	setStatus(p, "Alive")
	p:LoadCharacter()
	local char = p.Character
	if not char or Round.status(p) ~= "Alive" then
		return
	end
	local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
	local root = char:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	if not hum or not root then
		return
	end
	hum.WalkSpeed = Config.Move.Walk
	hum.UseJumpPower = true
	hum.JumpPower = Config.Move.JumpPower
	-- 착지 소리: 괴물이 듣는다
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed and Round.state == "Playing" and Round.status(p) == "Alive" and p.Character == char then
			SoundBus.emit(root.Position - Vector3.new(0, 2.5, 0), Config.Noise.Land, p, "StepLand")
		end
	end)
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	char:SetAttribute("MoveMode", "Walk")
	char:PivotTo(nextSpawn())
	-- 다른 원인으로 죽어도(맵 밖 등) 사망 처리
	hum.Died:Connect(function()
		if Round.status(p) == "Alive" and p.Character == char then
			Round.kill(p, "fell")
		end
	end)
end

function Round.kill(p: Player, why: string?, by: any?)
	-- by = 잡은 괴물(Monster): 점프스케어에 그 괴물의 그림·괴성
	local byVoice = by and by.model and by.model:GetAttribute("Voice")
	local byCreature = by and by.creature
	if Round.status(p) ~= "Alive" then
		return
	end
	if Round.state == "Lobby" then
		-- 로비에서는 죽지 않는다(떨어지면 다시 세운다)
		task.delay(1, function()
			if Round.state == "Lobby" then
				Round.spawnPlayer(p)
			end
		end)
		return
	end
	-- 목숨이 남아 있으면: 하나 잃고 잠시 뒤 그 스테이지 시작 방에서 다시
	local lives = ((p:GetAttribute("Lives") :: number?) or 1) - 1
	p:SetAttribute("Lives", math.max(0, lives))
	if lives > 0 and Round.state == "Playing" then
		setStatus(p, "Respawning")
		note("life lost " .. p.Name .. " " .. (why or "") .. " left " .. lives)
		RoundEvent:FireAllClients("LifeLost", { userId = p.UserId, lives = lives, why = why, seconds = Config.Lives.RespawnDelay, voice = byVoice, creature = byCreature })
		local char0 = p.Character
		if char0 then
			local root0 = char0:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root0 then
				root0.Anchored = true
			end
			task.delay(Config.Round.DeadBodyLinger, function()
				if p.Character == char0 then
					p.Character = nil
				end
				char0:Destroy()
			end)
		end
		local rid = Round.roundId
		task.delay(Config.Lives.RespawnDelay, function()
			if Round.state == "Playing" and Round.roundId == rid and Round.status(p) == "Respawning" and p.Parent then
				Round.spawnPlayer(p)
				note("respawned " .. p.Name)
			end
		end)
		return
	end
	setStatus(p, "Dead")
	note("dead " .. p.Name .. " " .. (why or ""))
	local others = #Round.alivePlayers()
	RoundEvent:FireAllClients("Died", { userId = p.UserId, solo = #Round.participants() == 1, othersAlive = others, why = why, voice = byVoice, creature = byCreature })
	local char = p.Character
	if char then
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.Anchored = true
		end
		task.delay(Config.Round.DeadBodyLinger, function()
			if p.Character == char then
				p.Character = nil
			end
			char:Destroy()
		end)
	end
end

function Round.escape(p: Player)
	if Round.status(p) ~= "Alive" then
		return
	end
	setStatus(p, "Escaped")
	note("escaped " .. p.Name)
	RoundEvent:FireAllClients("Escaped", { userId = p.UserId, othersAlive = #Round.alivePlayers() })
	local char = p.Character
	if char then
		p.Character = nil
		char:Destroy()
	end
end

local function clearMonsters()
	for _, m in Round.monsters do
		m:destroy()
	end
	table.clear(Round.monsters)
	for _, m in Round.doppels do
		m:destroy()
	end
	table.clear(Round.doppels)
	for _, m in Round.flowers do
		m:destroy()
	end
	table.clear(Round.flowers)
	monsterFolder:ClearAllChildren()
end

-- 도플갱어가 흉내 낼 사람:
--  · 여럿이 할 때: 지금 같이 플레이 중인 친구들(참가자) 중 한 명의 실제 외형(진짜 친구와 헷갈리게)
--  · 혼자 할 때: 내 친구 목록 중 한 명의 아바타, 못 가져오면 내 모습
function Round.pickDisguise(): (HumanoidDescription?, string?)
	local function applied(p: Player): HumanoidDescription?
		local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if not hum then
			return nil
		end
		local ok, desc = pcall(function()
			return hum:GetAppliedDescription()
		end)
		return if ok then desc else nil
	end
	local ps = Round.participants()
	if #ps >= 2 then
		local order = table.clone(ps)
		for i = #order, 2, -1 do
			local j = math.random(1, i)
			order[i], order[j] = order[j], order[i]
		end
		for _, p in order do
			local desc = applied(p)
			if desc then
				return desc, p.DisplayName
			end
		end
		return nil, nil
	end
	-- 혼자: 친구 목록에서
	local me = ps[1]
	if me and me.UserId > 0 then
		local ok, pages = pcall(function()
			return Players:GetFriendsAsync(me.UserId)
		end)
		if ok and pages then
			local friends = {}
			for _, fr in (pages :: FriendPages):GetCurrentPage() do
				table.insert(friends, { id = fr.Id, name = fr.DisplayName or fr.Username })
			end
			for _ = 1, math.min(4, #friends) do
				local fr = table.remove(friends, math.random(1, #friends))
				local ok2, desc = pcall(function()
					return Players:GetHumanoidDescriptionFromUserId(fr.id)
				end)
				if ok2 and desc then
					return desc, fr.name
				end
			end
		end
	end
	if me then
		local desc = applied(me)
		if desc then
			return desc, me.DisplayName
		end
	end
	return nil, nil
end

-- 괴물끼리 한 곳에 몰려 나오지 않게: 이미 놓인 괴물들과 minD 이상 떨어진 후보 중 무작위(없으면 가장 먼 곳)
local function spreadPick(list: { Vector3 }, placed: { Vector3 }, minD: number): Vector3
	local ok = {}
	local best, bestD = list[1], -1
	for _, n in list do
		local d = math.huge
		for _, q in placed do
			d = math.min(d, (n - q).Magnitude)
		end
		if d >= minD then
			table.insert(ok, n)
		end
		if d > bestD then
			best, bestD = n, d
		end
	end
	if #ok > 0 then
		return ok[math.random(1, #ok)]
	end
	return best
end
local MONSTER_GAP = 70 -- 괴물끼리 처음 자리 사이 최소 거리(스터드)

-- 이 챕터의 시안 괴물(Config.Creatures.Chapters): { {id, sub}... } 또는 nil(기존 메인 괴물)
function Round.chapterCreatures(): { { id: string, sub: boolean } }?
	local def = Config.Stages[Round.stageIndex]
	local ch = def and Config.Creatures.On and Config.Creatures.Chapters[def.Id]
	if not ch then
		return nil
	end
	local out = {}
	-- 3D 메시까지 준비된(ready) 괴물만. 메인 괴물이 하나도 준비되지 않았으면 이 챕터는 예전 괴물 그대로
	local function ok(id: string): boolean
		local mod = Monster.creatureModule(id)
		return mod ~= nil and (mod.ready == nil or mod.ready())
	end
	local mains = 0
	for _, id in ch.main do
		if ok(id) then
			table.insert(out, { id = id, sub = false })
			mains += 1
		end
	end
	if mains == 0 then
		return nil
	end
	for _, id in ch.sub do
		if ok(id) then
			table.insert(out, { id = id, sub = true })
		end
	end
	return out
end
function Round.creatureFor(_k: number): string?
	return nil -- (예전 방식: 메인 괴물 자리를 번갈아 채움. 이제 chapterCreatures 가 따로 띄운다)
end

-- 메인 괴물 구역: 맵을 긴 변 쪽으로 n 등분(4마리면 2×2), 이웃 구역과 살짝(Overlap) 겹치게
type Zone = { x0: number, x1: number, z0: number, z1: number, y0: number?, y1: number? }
local function mainZones(nodes: { Vector3 }, n: number): { Zone }
	local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
	for _, p in nodes do
		x0, x1 = math.min(x0, p.X), math.max(x1, p.X)
		z0, z1 = math.min(z0, p.Z), math.max(z1, p.Z)
	end
	local cols, rows = n, 1
	if n == 4 then
		cols, rows = 2, 2
	end
	if z1 - z0 > x1 - x0 then
		cols, rows = rows, cols
	end
	local cw, rd = (x1 - x0) / cols, (z1 - z0) / rows
	local ox, oz = cw * Config.Creatures.Overlap, rd * Config.Creatures.Overlap
	local out = {}
	for rr = 0, rows - 1 do
		for c = 0, cols - 1 do
			table.insert(out, { x0 = x0 + c * cw - ox, x1 = x0 + (c + 1) * cw + ox, z0 = z0 + rr * rd - oz, z1 = z0 + (rr + 1) * rd + oz })
		end
	end
	return out
end

-- 서브 괴물 자기 방(Shared/CreatureHomes: 칸 좌표 사각형 + 층): 방 + 둘레 HomeMargin 칸
local function homeZone(id: string, nodes: { Vector3 }): Zone?
	local ok, H = pcall(require, ReplicatedStorage.Shared:FindFirstChild("CreatureHomes") :: ModuleScript)
	local h = ok and (H :: any)[id]
	if not h then
		return nil
	end
	local T, m = Builder.Tile, Config.Creatures.HomeMargin
	local z: Zone = { x0 = (h.rect[1] - 1 - m) * T, x1 = (h.rect[3] + m) * T, z0 = (h.rect[2] - 1 - m) * T, z1 = (h.rect[4] + m) * T }
	-- 층: 맵에서 가장 낮은 배회 지점 + 8 스터드를 경계로 위층(upper) / 아래층(lower). 없으면 층 구분 없음
	local low = math.huge
	for _, p in nodes do
		low = math.min(low, p.Y)
	end
	if h.band == "upper" then
		z.y0, z.y1 = low + 8, math.huge
	elseif h.band == "lower" then
		z.y0, z.y1 = -math.huge, low + 8
	end
	return z
end

local function nodesIn(nodes: { Vector3 }, z: Zone): { Vector3 }
	local out = {}
	for _, n in nodes do
		if n.X >= z.x0 and n.X <= z.x1 and n.Z >= z.z0 and n.Z <= z.z1 and (not z.y0 or (n.Y >= z.y0 and n.Y <= (z.y1 :: number))) and not Round.inSafe(n) then
			table.insert(out, n)
		end
	end
	return out
end

-- 시안 괴물: 메인은 맵을 나눈 구역 하나씩(시작점이 든 구역은 늦게 채운다), 서브는 생김새에 맞는 자기 방
function Round.spawnCreatures(list: { { id: string, sub: boolean } }, placed: { Vector3 })
	local info = Round.info :: Builder.StageInfo
	local spawnPos = info.spawns[1].Position
	local mains, subs = {}, {}
	for _, e in list do
		table.insert(if e.sub then subs else mains, e)
	end
	local zones = mainZones(info.nodes, math.max(1, #mains))
	-- 시작점에서 먼 구역부터 메인 괴물에게
	table.sort(zones, function(a, b)
		local ca = Vector3.new((a.x0 + a.x1) / 2, 0, (a.z0 + a.z1) / 2)
		local cb = Vector3.new((b.x0 + b.x1) / 2, 0, (b.z0 + b.z1) / 2)
		local s = Vector3.new(spawnPos.X, 0, spawnPos.Z)
		return (ca - s).Magnitude > (cb - s).Magnitude
	end)
	local function spawnOne(e: { id: string, sub: boolean }, z: Zone, label: string)
		local inZ = nodesIn(info.nodes, z)
		local far = {}
		for _, n in inZ do
			if (n - spawnPos).Magnitude >= Config.Monster.MinSpawnDistance * 0.6 then
				table.insert(far, n)
			end
		end
		local pool = if #far > 0 then far elseif #inZ > 0 then inZ else info.nodes
		local pick = spreadPick(pool, placed, if e.sub then 12 else 40)
		if e.sub and #inZ > 0 then
			-- 서브 괴물: 자기 자리 한가운데에서 시작
			local c = Vector3.new((z.x0 + z.x1) / 2, 0, (z.z0 + z.z1) / 2)
			local bd = math.huge
			for _, n in inZ do
				local d = (Vector3.new(n.X, 0, n.Z) - c).Magnitude
				if d < bd then
					pick, bd = n, d
				end
			end
		end
		local m = Monster.new(monsterFolder, pick, info.nodes, info.folder, function(player, by)
			Round.kill(player, "monster", by)
		end, Round.stageIndex, nil, e.id)
		m.route = info.route
		;(m :: any).territory = if #inZ > 0 then z else nil
		m.model:SetAttribute("Zone", label)
		m.model:SetAttribute("Sub", e.sub)
		table.insert(placed, pick)
		table.insert(Round.monsters, m)
		m:run()
	end
	for k, e in mains do
		spawnOne(e, zones[k], "main" .. k)
	end
	for _, e in subs do
		local z = homeZone(e.id, info.nodes)
		if z then
			spawnOne(e, z, "home " .. e.id)
		else
			-- (방이 정해지지 않았으면 맵 아무 곳)
			spawnOne(e, { x0 = -math.huge, x1 = math.huge, z0 = -math.huge, z1 = math.huge }, "free " .. e.id)
		end
	end
	note("creatures " .. #mains .. " mains (zones) + " .. #subs .. " subs (homes)")
end

function Round.spawnMonsters(count: number)
	local placed: { Vector3 } = {}
	local info = Round.info :: Builder.StageInfo
	local spawnPos = info.spawns[1].Position
	local candidates = {}
	for _, n in info.nodes do
		if (n - spawnPos).Magnitude >= Config.Monster.MinSpawnDistance then
			table.insert(candidates, n)
		end
	end
	if #candidates == 0 then
		candidates = info.nodes
	end
	table.sort(candidates, function(a, b)
		return (a - spawnPos).Magnitude > (b - spawnPos).Magnitude
	end)
	-- 맵을 반으로 나눠(긴 쪽 기준) 반쪽마다 메인 괴물 한 마리: 그 반쪽에서 나타나 그 안을 돌아다닌다(쫓을 때는 넘어온다)
	local halves: { { axis: string, mid: number, side: number } }? = nil
	if count == 2 then
		local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
		for _, n in info.nodes do
			x0, x1 = math.min(x0, n.X), math.max(x1, n.X)
			z0, z1 = math.min(z0, n.Z), math.max(z1, n.Z)
		end
		local axis = if x1 - x0 >= z1 - z0 then "X" else "Z"
		local mid = if axis == "X" then (x0 + x1) / 2 else (z0 + z1) / 2
		halves = { { axis = axis, mid = mid, side = -1 }, { axis = axis, mid = mid, side = 1 } }
	end
	local cl = Round.chapterCreatures()
	if cl then
		Round.spawnCreatures(cl, placed)
		count = 0
	end
	for k = 1, count do
		-- 멀리 있는 지점들 중 서로 떨어진 곳
		local pick = candidates[math.min(#candidates, 1 + (k - 1) * math.max(1, math.floor(#candidates / (count + 1))))]
		local half = halves and halves[k]
		if half then
			-- 그 반쪽 안, 안전 구역 밖에서 시작점과 먼 곳 중 하나
			local inHalf = {}
			for _, n in candidates do
				local v = if half.axis == "X" then n.X else n.Z
				if (v - half.mid) * half.side >= 0 and not Round.inSafe(n) then
					table.insert(inHalf, n)
				end
			end
			if #inHalf == 0 then
				for _, n in info.nodes do
					local v = if half.axis == "X" then n.X else n.Z
					if (v - half.mid) * half.side >= 0 and not Round.inSafe(n) then
						table.insert(inHalf, n)
					end
				end
			end
			if #inHalf > 0 then
				-- (candidates 는 시작점에서 먼 순: 먼 쪽 3분의 1 중 무작위)
				local far = {}
				for i = 1, math.max(1, math.ceil(#inHalf / 3)) do
					table.insert(far, inHalf[i])
				end
				pick = spreadPick(far, placed, MONSTER_GAP)
			end
		end
		local m = Monster.new(monsterFolder, pick, info.nodes, info.folder, function(player, by)
			Round.kill(player, "monster", by)
		end, Round.stageIndex, nil, Round.creatureFor(k))
		m.route = info.route
		;(m :: any).territory = half
		table.insert(placed, pick)
		table.insert(Round.monsters, m)
		m:run()
	end
	note("monsters " .. count)
	-- 도플갱어: 시작점에서 적당히 떨어진(너무 멀지 않은) 곳에, 플레이어처럼 돌아다니게
	local D = Config.Doppel
	if D.Enabled and Round.stageIndex > 0 then
		local near = {}
		for _, n in info.nodes do
			local d = (n - spawnPos).Magnitude
			if d >= D.SpawnDistance[1] and d <= D.SpawnDistance[2] then
				table.insert(near, n)
			end
		end
		if #near == 0 then
			near = candidates
		end
		for _ = 1, D.PerStage do
			local pick = spreadPick(near, placed, MONSTER_GAP)
			table.insert(placed, pick)
			local m = Monster.new(monsterFolder, pick, info.nodes, info.folder, function(player)
				Round.kill(player, "doppel")
			end, Round.stageIndex, "doppel")
			m.route = info.route
			table.insert(Round.doppels, m)
			m:run()
			-- 진짜 사람(친구 또는 플레이어)의 아바타로 갈아입힌다(가져오는 데 잠깐 걸린다)
			task.spawn(function()
				for _ = 1, 20 do
					if not m.alive or m.form ~= "Disguise" then
						return
					end
					local desc, who = Round.pickDisguise()
					if desc and who and m:applyAvatar(desc, who) then
						note("doppel looks like " .. who)
						return
					end
					-- (아직 캐릭터가 없거나 입히기에 실패: 잠깐 뒤 다시)
					task.wait(0.5) -- (플레이어 캐릭터가 아직 안 생겼다)
				end
			end)
		end
		note("doppels " .. D.PerStage)
	end
	-- 꽃괴물: 늘 맵 한가운데쯤(안전 구역 밖, 시작점에서 떨어진 곳)에 가만히 서 있게
	local F = Config.Flower
	local stageDef = Config.Stages[Round.stageIndex]
	if F.Enabled and stageDef and table.find(F.Stages, stageDef.Id) and not Round.chapterCreatures() then -- (시안 괴물이 나오는 챕터는 꽃괴물 대신 서브 괴물)
		local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
		for _, n in info.nodes do
			x0, x1 = math.min(x0, n.X), math.max(x1, n.X)
			z0, z1 = math.min(z0, n.Z), math.max(z1, n.Z)
		end
		local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
		local function toMid(n: Vector3): number
			return math.sqrt((n.X - cx) ^ 2 + (n.Z - cz) ^ 2)
		end
		local pool = {}
		for _, n in info.nodes do
			if (n - spawnPos).Magnitude >= F.SpawnDistance[1] and not Round.inSafe(n) then
				table.insert(pool, n)
			end
		end
		if #pool == 0 then
			pool = candidates
		end
		table.sort(pool, function(a, b)
			return toMid(a) < toMid(b)
		end)
		-- 가운데에서 가까운 순으로, 맵 크기의 MidRadius 안(최소 몇 곳은 확보)
		local limit = math.max(x1 - x0, z1 - z0) * F.MidRadius
		local spots = {}
		for i, n in pool do
			if toMid(n) <= limit or i <= 6 then
				table.insert(spots, n)
			end
		end
		for _ = 1, F.PerStage do
			local pick = spreadPick(spots, placed, MONSTER_GAP)
			table.insert(placed, pick)
			local m = Monster.new(monsterFolder, pick, info.nodes, info.folder, function(player)
				Round.kill(player, "flower")
			end, Round.stageIndex, "flower")
			m.route = info.route
			;(m :: any).home = pick -- 쫓아갔다가 이 자리로 돌아온다
			;(m :: any).keepOut = spawnPos -- 시작점 둘레로는 들어오지 않는다
			table.insert(Round.flowers, m)
			m:run()
		end
		note("flowers " .. F.PerStage)
	end
end

function Round.startStage(i: number)
	clearMonsters()
	Round.stageIndex = i
	Round.state = "Loading"
	ReplicatedStorage:SetAttribute("RoundState", "Loading")
	ReplicatedStorage:SetAttribute("Mode", "Game")
	for _, p in Players:GetPlayers() do
		setStatus(p, "Waiting")
		if p.Character then
			p.Character:Destroy()
			p.Character = nil
		end
	end
	Round.buildStage(i)
	local def = stageDef(i)
	ReplicatedStorage:SetAttribute("StageIndex", i)
	ReplicatedStorage:SetAttribute("StageName", def.Name)
	ReplicatedStorage:SetAttribute("RoundId", Round.roundId)
	spawnCursor = 0
	for _, p in Round.participants() do
		p:SetAttribute("Lives", Config.Lives.PerStage)
		task.spawn(Round.spawnPlayer, p)
	end
	Round.state = "Playing"
	ReplicatedStorage:SetAttribute("RoundState", "Playing")
	Search.assignKey((Round.info :: Builder.StageInfo).spawns[1].Position)
	RoundEvent:FireAllClients("Start", { stage = i, name = def.Name })
	Round.spawnMonsters(def.Monsters)
	note("start " .. i)
end

-- 라운드가 끝났는가: 살아 있는 플레이어가 없다
function Round.finished(): boolean
	if Round.state ~= "Playing" then
		return false
	end
	if #Round.participants() == 0 then
		return true
	end
	for _, p in Round.participants() do
		local s = Round.status(p)
		if s == "Alive" or s == "Waiting" or s == "Respawning" then
			return false
		end
	end
	return true
end

function Round.finish(): string
	local anyEscaped = false
	Round.lastAllClear = false
	for _, p in Round.participants() do
		if Round.status(p) == "Escaped" then
			anyEscaped = true
		end
	end
	Round.state = "Result"
	ReplicatedStorage:SetAttribute("RoundState", "Result")
	clearMonsters()
	local i = Round.stageIndex
	local outcome
	if anyEscaped then
		local nextI = i + 1
		local allClear = nextI > #Config.Stages or stageModule(nextI) == nil
		if allClear then
			nextI = 1
		end
		outcome = "Clear"
		RoundEvent:FireAllClients("Clear", { stage = i, nextStage = nextI, nextName = stageDef(nextI).Name, allClear = allClear, toLobby = Round.returnToLobby, seconds = Config.Round.ResultSeconds })
		Round.stageIndex = nextI
		Round.lastAllClear = allClear
		if allClear then
			Rejoin.gameOver() -- (다 깼다: 끊긴 사람을 이 게임으로 다시 끌어오지 않는다)
		end
	else
		outcome = "Failed"
		RoundEvent:FireAllClients("Failed", { stage = i, nextName = stageDef(i).Name, seconds = Config.Round.ResultSeconds })
	end
	Round.lastOutcome = outcome
	note("finish " .. outcome)
	return outcome
end

-- 출구·잡기 판정
RunService.Heartbeat:Connect(function(dt)
	if Round.state ~= "Playing" then
		return
	end
	for _, m in Round.monsters do
		m:checkCatch()
		m:animate(dt)
	end
	for _, m in Round.doppels do
		m:checkCatch()
		m:animate(dt)
	end
	for _, m in Round.flowers do
		m:checkCatch()
		m:animate(dt)
	end
	local info = Round.info
	if not info then
		return
	end
	for _, p in Round.participants() do
		if Round.status(p) == "Alive" then
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local lp = info.exitCFrame:PointToObjectSpace(root.Position)
				local s = info.exitSize / 2
				if math.abs(lp.X) <= s.X and math.abs(lp.Y) <= s.Y and math.abs(lp.Z) <= s.Z then
					if Config.Key.Required and ReplicatedStorage:GetAttribute("HasKey") ~= true then
						-- 잠긴 출구: 몇 초에 한 번 알려 준다
						local last = (p:GetAttribute("ExitLockedAt") :: number?) or 0
						if os.clock() - last > 3 then
							p:SetAttribute("ExitLockedAt", os.clock())
							RoundEvent:FireClient(p, "ExitLocked", {})
						end
					else
						Round.escape(p)
					end
				end
			end
		end
	end
end)

-- 발소리 소음: 서버가 실제 이동 속도로 판정(클라이언트 값을 믿지 않는다)
task.spawn(function()
	local N = Config.Noise
	while true do
		task.wait(N.StepInterval)
		if Round.state == "Playing" then
			for _, p in Players:GetPlayers() do
				if Round.status(p) == "Alive" then
					local char = p.Character
					local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					if char and root then
						local v = root.AssemblyLinearVelocity
						local speed = Vector3.new(v.X, 0, v.Z).Magnitude
						if speed > N.MovingAbove then
							local radius, kind = N.Crouch, "StepCrouch"
							if speed > N.RunSpeedAbove then
								radius, kind = N.Run, "StepRun"
							elseif speed > N.WalkSpeedAbove then
								radius, kind = N.Walk, "StepWalk"
							end
							SoundBus.emit(root.Position - Vector3.new(0, 2.5, 0), radius, p, kind)
						end
					end
				end
			end
		end
	end
end)

SoundBus.listen(function(pos, radius, source, kind)
	for _, m in Round.monsters do
		m:hear(pos, radius, source, kind)
	end
	for _, m in Round.doppels do
		m:hear(pos, radius, source, kind)
	end
	for _, m in Round.flowers do
		m:hear(pos, radius, source, kind)
	end
end)

-- 숨는 순간: 쫓던 괴물이 그 모습을 봤는지
Hiding.onHide(function(p, spot)
	for _, m in Round.monsters do
		m:onHide(p, spot.front)
	end
	for _, m in Round.doppels do
		m:onHide(p, spot.front)
	end
end)

-- 끊겼다 다시 들어온 사람: 같은 스테이지면 남은 목숨·상태를 그대로(끊겼다고 목숨이 다시 차지 않게)
local saved: { [number]: { lives: number?, status: string, rid: number } } = {}

Players.PlayerAdded:Connect(function(p)
	setStatus(p, "Waiting")
	if Round.state == "Lobby" then
		task.defer(Round.spawnPlayer, p)
	elseif Round.state == "Playing" and not Round.members then
		-- 늦게 들어온(또는 끊겼다 돌아온) 플레이어도 시작 지점에서 함께 한다(방에서 시작한 게임은 그 방 사람만)
		local sv = saved[p.UserId]
		saved[p.UserId] = nil
		if sv and sv.rid == Round.roundId then
			p:SetAttribute("Lives", sv.lives or Config.Lives.PerStage)
			if sv.status == "Dead" or sv.status == "Escaped" or (sv.lives or 1) <= 0 then
				setStatus(p, sv.status == "Escaped" and "Escaped" or "Dead") -- (관전)
				note("rejoined " .. p.Name .. " as " .. Round.status(p))
				return
			end
			note("rejoined " .. p.Name .. " lives " .. tostring(sv.lives))
		else
			p:SetAttribute("Lives", Config.Lives.PerStage)
		end
		task.defer(Round.spawnPlayer, p)
	end
end)

Players.PlayerRemoving:Connect(function(p)
	if Round.state == "Playing" then
		saved[p.UserId] = { lives = p:GetAttribute("Lives") :: number?, status = Round.status(p), rid = Round.roundId }
	end
	if Round.members then
		Round.members[p] = nil
	end
end)

-- 로비: 로비 맵을 짓고 모두 그 안에 세운다
function Round.enterLobby()
	clearMonsters()
	Round.members = nil
	Round.returnToLobby = false
	Round.state = "Loading"
	ReplicatedStorage:SetAttribute("RoundState", "Loading")
	ReplicatedStorage:SetAttribute("Mode", "Lobby")
	for _, p in Players:GetPlayers() do
		setStatus(p, "Waiting")
		if p.Character then
			p.Character:Destroy()
			p.Character = nil
		end
	end
	buildLayout(require(script.Parent.Stages.Lobby) :: any, "lobby")
	ReplicatedStorage:SetAttribute("HasKey", false)
	ReplicatedStorage:SetAttribute("Keys", 0)
	ReplicatedStorage:SetAttribute("StageIndex", 0)
	ReplicatedStorage:SetAttribute("StageName", "로비")
	ReplicatedStorage:SetAttribute("RoundId", Round.roundId)
	spawnCursor = 0
	Round.state = "Lobby"
	ReplicatedStorage:SetAttribute("RoundState", "Lobby")
	for _, p in Players:GetPlayers() do
		task.spawn(Round.spawnPlayer, p)
	end
	RoundEvent:FireAllClients("Lobby", {})
	note("lobby")
end

-- 게임 진행(스테이지 → 결과 → 다음/재시작).
-- returnToLobby 면 다섯 스테이지를 모두 깨거나 참가자가 모두 나가면 로비로 돌아가며 끝난다.
function Round.loop()
	while true do
		while #Round.participants() == 0 do
			if Round.returnToLobby then
				Round.enterLobby()
				return
			end
			task.wait(0.5)
		end
		task.wait(Config.Round.FirstStartDelay)
		Round.startStage(Round.stageIndex)
		while not Round.finished() do
			task.wait(0.2)
		end
		Round.finish()
		task.wait(Config.Round.ResultSeconds)
		while not Round.autoLoop do
			task.wait(0.2)
		end
		if Round.returnToLobby and (Round.lastAllClear or #Round.participants() == 0) then
			Round.enterLobby()
			return
		end
	end
end

return Round
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="240">
        <Properties>
          <string name="Name">Search</string>
          <string name="Source"><![CDATA[--!strict
-- 뒤질 수 있는 상자·서랍(맵 문자 Z). 챕터별 모양(SearchStyle). 서랍장은 서랍마다, 상자는 뚜껑을 따로 열고 닫는다.
-- 조작: 조준점으로 서랍/뚜껑을 보고 E(클라이언트 SearchLook → Remotes.SearchAction(spotId, index)). 다시 E 면 닫힌다.
-- 스테이지마다 한 칸(서랍 하나 또는 뚜껑 하나)에 열쇠가 있고(라운드마다 서버가 고른다), 누가 찾든 팀 전체가 가진다
-- (ReplicatedStorage 속성 HasKey). 열쇠가 없으면 출구가 열리지 않는다(Round). 처음 열 때 뒤지는 소리를 괴물이 듣는다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local SoundBus = require(script.Parent.SoundBus)
local RateLimit = require(script.Parent.RateLimit)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RoundEvent = Remotes:WaitForChild("RoundEvent") :: RemoteEvent
local SearchAction = Remotes:WaitForChild("SearchAction") :: RemoteEvent
local KeyHint = Remotes:WaitForChild("KeyHint") :: RemoteEvent
-- 마지막 열쇠 힌트: 하나만 남고 Config.Key.HintAfter 초가 지나면 KeyHintReady. 누가 "힌트 보기"를 누르면
-- 그 상자 위치를 KeyHintPos 로 팀 전체 지도에 표시한다(ReplicatedStorage 속성)
local assignId = 0
local function armHint()
	ReplicatedStorage:SetAttribute("KeyHintReady", false)
	local id = assignId
	task.delay(Config.Key.HintAfter or 60, function()
		if assignId == id and ReplicatedStorage:GetAttribute("HasKey") ~= true then
			ReplicatedStorage:SetAttribute("KeyHintReady", true)
		end
	end)
end

local Search = {}

export type Comp = {
	model: Model, -- 움직이는 서랍/뚜껑(음파는 움직이는 물체로 그린다)
	closedPivot: CFrame,
	openPivot: CFrame,
	open: boolean,
	busy: boolean,
	searched: boolean,
	hasKey: boolean,
}
export type Spot = {
	id: number,
	model: Model,
	center: Vector3,
	front: Vector3,
	comps: { Comp },
	name: string,
}

local spots: { Spot } = {}
local byId: { [number]: Spot } = {}
local nextId = 0

-- 챕터별 모양: w 폭, h 높이, d 깊이, kind = "drawers"(rows 칸) | "lid"
type Style = { w: number, h: number, d: number, kind: string, rows: number, name: string }
local STYLES: { [string]: Style } = {
	drawers = { w = 3.2, h = 3.8, d = 2.2, kind = "drawers", rows = 3, name = "서랍장" }, -- 지하 시설: 철제 서랍장
	crate = { w = 3.6, h = 3.2, d = 3.0, kind = "lid", rows = 0, name = "나무 상자" }, -- 창고
	toolbox = { w = 3.4, h = 1.9, d = 2.0, kind = "lid", rows = 0, name = "공구함" }, -- 하수도
	nightstand = { w = 2.6, h = 2.8, d = 2.2, kind = "drawers", rows = 2, name = "협탁" }, -- 병원
	chest = { w = 3.6, h = 2.3, d = 2.4, kind = "lid", rows = 0, name = "궤짝" }, -- 심층 미로
	dresser = { w = 3.8, h = 3.3, d = 2.4, kind = "drawers", rows = 3, name = "서랍장" }, -- 호텔: 객실 서랍장
	safe = { w = 2.8, h = 2.6, d = 2.4, kind = "lid", rows = 0, name = "금고" }, -- 호텔: 객실 금고
	toybox = { w = 3.4, h = 2.1, d = 2.4, kind = "lid", rows = 0, name = "장난감 상자" }, -- 폐유치원: 뚜껑 달린 장난감 상자
}
Search.Styles = STYLES

local function newComp(parent: Model, idx: number, spotId: number): Model
	local mv = Instance.new("Model")
	mv.Name = "Comp" .. idx
	mv:SetAttribute(Config.Tags.Dynamic, true)
	mv:SetAttribute("SpotId", spotId)
	mv:SetAttribute("Comp", idx)
	mv.Parent = parent
	return mv
end

-- cf: 바닥 가운데, LookVector(-Z) = 앞(방 안쪽)
local function build(parent: Instance, cf: CFrame, s: Style, spotId: number): (Model, { Comp })
	local m = Instance.new("Model")
	m.Name = "SearchSpot"
	m:SetAttribute("SpotId", spotId)
	m:SetAttribute("Label", s.name)
	local t = 0.2
	local w, h, d = s.w, s.h, s.d
	local function box(par: Instance, local_: CFrame, size: Vector3, opts: Kit.Opts?): Part
		return Kit.box(par, cf * local_, size, opts)
	end
	box(m, CFrame.new(0, h / 2, d / 2 - t / 2), Vector3.new(w, h, t))
	for _, sx in { -1, 1 } do
		box(m, CFrame.new(sx * (w / 2 - t / 2), h / 2, 0), Vector3.new(t, h, d))
	end
	box(m, CFrame.new(0, t / 2, 0), Vector3.new(w, t, d))
	local comps: { Comp } = {}
	local facing = cf.LookVector
	if s.kind == "drawers" then
		box(m, CFrame.new(0, h - t / 2, 0), Vector3.new(w + 0.1, t, d + 0.1))
		local rowH = (h - t * 2) / s.rows
		for k = 1, s.rows do
			local mv = newComp(m, k, spotId)
			local y = h - t - rowH * (k - 0.5) -- 1 = 맨 위
			local inner = d - t * 2
			box(mv, CFrame.new(0, y, -d / 2 + t / 2), Vector3.new(w - t * 2 - 0.08, rowH - 0.1, t), { blocks = false })
			box(mv, CFrame.new(0, y, -d / 2 - 0.1), Vector3.new(0.8, 0.12, 0.12), { blocks = false, collide = false })
			-- 서랍 통(바닥 + 양옆 + 뒤): 빠졌을 때 서랍 모양이 보이게
			box(mv, CFrame.new(0, y - rowH / 2 + 0.12, -d / 2 + t + inner / 2), Vector3.new(w - t * 2 - 0.15, 0.08, inner), { blocks = false, collide = false })
			for _, sx in { -1, 1 } do
				box(mv, CFrame.new(sx * (w / 2 - t - 0.12), y - rowH * 0.15, -d / 2 + t + inner / 2), Vector3.new(0.08, rowH * 0.6, inner), { blocks = false, collide = false })
			end
			box(mv, CFrame.new(0, y - rowH * 0.15, d / 2 - t - 0.06), Vector3.new(w - t * 2 - 0.15, rowH * 0.6, 0.08), { blocks = false, collide = false })
			local closed = mv:GetPivot()
			-- 앞으로 곧게 빠진다(월드 기준 이동)
			table.insert(comps, { model = mv, closedPivot = closed, openPivot = closed + facing * (inner * 0.75), open = false, busy = false, searched = false, hasKey = false })
		end
	else
		box(m, CFrame.new(0, h / 2, -d / 2 + t / 2), Vector3.new(w, h, t))
		local mv = newComp(m, 1, spotId)
		box(mv, CFrame.new(0, h + t / 2, 0), Vector3.new(w + 0.12, t, d + 0.12))
		if s.name ~= "공구함" then
			for _, sx in { -0.3, 0.3 } do
				box(mv, CFrame.new(sx * w, h + t + 0.03, 0), Vector3.new(0.18, 0.06, d + 0.14), { blocks = false, collide = false })
			end
		else
			box(mv, CFrame.new(0, h + t + 0.25, 0), Vector3.new(w * 0.5, 0.12, 0.12), { blocks = false, collide = false })
		end
		local closed = mv:GetPivot()
		-- 뒤쪽 경첩을 축으로 뒤로 젖혀진다(월드 기준 회전)
		local hinge = (cf * CFrame.new(0, h + t, d / 2)).Position
		local turn = CFrame.new(hinge) * CFrame.fromAxisAngle(cf.RightVector, math.rad(100)) * CFrame.new(-hinge)
		table.insert(comps, { model = mv, closedPivot = closed, openPivot = turn * closed, open = false, busy = false, searched = false, hasKey = false })
	end
	m.Parent = parent
	return m, comps
end

-- pos: 타일 가운데 바닥, back: 벽 쪽(단위 벡터)
function Search.create(parent: Instance, pos: Vector3, back: Vector3, styleName: string?): Spot
	local s = STYLES[styleName or "drawers"] or STYLES.drawers
	local facing = -back
	local center = pos + back * (Config.Hide.Tile / 2 - s.d / 2 - 0.15)
	local cf = CFrame.lookAt(center, center + facing)
	nextId += 1
	local model, comps = build(parent, cf, s, nextId)
	CollectionService:AddTag(model, Config.Tags.SearchSpot)
	local spot: Spot = { id = nextId, model = model, center = center, front = center + facing * (s.d / 2 + 2.2), comps = comps, name = s.name }
	table.insert(spots, spot)
	byId[spot.id] = spot
	model.Destroying:Connect(function()
		local i = table.find(spots, spot)
		if i then
			table.remove(spots, i)
		end
		byId[spot.id] = nil
	end)
	return spot
end

-- 팀이 찾은 열쇠 수(ReplicatedStorage 속성 Keys)와 필요한 수(KeysNeeded). 다 찾으면 HasKey = true(출구가 열린다)
local function keysFound(): number
	return (ReplicatedStorage:GetAttribute("Keys") :: number?) or 0
end

local function move(c: Comp, toOpen: boolean)
	c.busy = true
	local a, b = if toOpen then c.closedPivot else c.openPivot, if toOpen then c.openPivot else c.closedPivot
	local t0 = os.clock()
	local dur = 0.25
	while true do
		local k = math.clamp((os.clock() - t0) / dur, 0, 1)
		local e = 1 - (1 - k) * (1 - k)
		if not c.model.Parent then
			break
		end
		c.model:PivotTo(a:Lerp(b, e))
		if k >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	c.open = toOpen
	c.model:SetAttribute("Open", toOpen)
	c.busy = false
end

-- 서랍/뚜껑 하나를 열거나 닫는다. 처음 열면 뒤진다(결과: "key" | "empty").
-- 돌려주는 값: "key" | "empty" | "opened" | "closed" | "busy"
function Search.toggle(player: Player, spot: Spot, index: number): string
	local c = spot.comps[index]
	if not c or c.busy or player:GetAttribute("Status") ~= "Alive" or player:GetAttribute("Hidden") then
		return "busy"
	end
	if c.open then
		move(c, false)
		return "closed"
	end
	local first = not c.searched
	if first then
		SoundBus.emit(spot.front + Vector3.new(0, 2, 0), Config.Key.SearchNoise, player, "Search")
		RoundEvent:FireClient(player, "SearchResult", { result = "searching" })
	end
	move(c, true)
	if not first then
		return "opened"
	end
	task.wait(math.max(0, Config.Key.SearchSeconds - 0.25))
	c.searched = true
	if c.hasKey then
		-- 열쇠 하나 찾음(팀 공유). 다 모으면 출구가 열린다
		c.hasKey = false
		local need = (ReplicatedStorage:GetAttribute("KeysNeeded") :: number?) or 1
		local found = math.min(need, keysFound() + 1)
		ReplicatedStorage:SetAttribute("Keys", found)
		if found >= need then
			ReplicatedStorage:SetAttribute("HasKey", true)
			ReplicatedStorage:SetAttribute("KeyHintReady", false)
			ReplicatedStorage:SetAttribute("KeyHintPos", nil)
		elseif found == need - 1 then
			armHint() -- (마지막 하나 남음: 시간이 지나면 힌트)
		end
		RoundEvent:FireAllClients("KeyFound", { by = player.DisplayName, userId = player.UserId, found = found, need = need })
		return "key"
	end
	RoundEvent:FireClient(player, "SearchResult", { result = if c.hasKey then "empty" else "empty" })
	return "empty"
end

-- (예전 호출용) 그 상자의 첫 칸을 연다
function Search.search(player: Player, spot: Spot): string
	for i, c in spot.comps do
		if not c.searched then
			return Search.toggle(player, spot, i)
		end
	end
	RoundEvent:FireClient(player, "SearchResult", { result = "already" })
	return "already"
end

SearchAction.OnServerEvent:Connect(function(player: Player, spotId: any, index: any)
	if type(spotId) ~= "number" or type(index) ~= "number" then
		return
	end
	if not RateLimit.allow(player, "SearchAction", 6, 10) then
		return
	end
	local spot = byId[spotId]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not spot or not root or (root.Position - spot.center).Magnitude > Config.Key.PromptDistance + 2 then
		return
	end
	Search.toggle(player, spot, index)
end)

-- 새 스테이지: 열쇠 Config.Key.Count 개를 서로 다른 상자에 하나씩 넣는다.
-- 시작에서 가장 가까운 상자들(3분의 1)은 빼고, 열쇠끼리는 되도록 멀리 흩어 놓는다(무작위 + 서로 먼 곳)
function Search.assignKey(start: Vector3)
	assignId += 1
	ReplicatedStorage:SetAttribute("HasKey", false)
	ReplicatedStorage:SetAttribute("Keys", 0)
	ReplicatedStorage:SetAttribute("KeyHintReady", false)
	ReplicatedStorage:SetAttribute("KeyHintPos", nil)
	for _, s in spots do
		for _, c in s.comps do
			c.hasKey = false
		end
	end
	if #spots == 0 then
		ReplicatedStorage:SetAttribute("KeysNeeded", 0)
		ReplicatedStorage:SetAttribute("HasKey", true)
		return
	end
	local sorted = table.clone(spots)
	table.sort(sorted, function(a, b)
		return (a.front - start).Magnitude > (b.front - start).Magnitude
	end)
	local pool = {}
	for i = 1, math.max(1, math.ceil(#sorted * 2 / 3)) do
		table.insert(pool, sorted[i])
	end
	local need = math.min(Config.Key.Count or 1, #spots)
	local picked: { Spot } = {}
	while #picked < need do
		if #pool == 0 then
			-- (모자라면 나머지 상자에서)
			for _, s in sorted do
				if not table.find(picked, s) then
					table.insert(pool, s)
				end
			end
		end
		local choice: Spot
		if #picked == 0 then
			choice = pool[math.random(1, #pool)]
		else
			-- 이미 고른 열쇠들과 가장 먼 상자 몇 개 중 무작위
			table.sort(pool, function(a, b)
				local da, db = math.huge, math.huge
				for _, q in picked do
					da = math.min(da, (a.front - q.front).Magnitude)
					db = math.min(db, (b.front - q.front).Magnitude)
				end
				return da > db
			end)
			choice = pool[math.random(1, math.min(3, #pool))]
		end
		table.remove(pool, table.find(pool, choice) :: number)
		table.insert(picked, choice)
		choice.comps[math.random(1, #choice.comps)].hasKey = true
	end
	ReplicatedStorage:SetAttribute("KeysNeeded", need)
	if need == 1 then
		armHint() -- (열쇠가 하나뿐이면 처음부터 그 하나가 마지막)
	end
end

-- "힌트 보기": 준비됐고 아직 남은 열쇠가 있으면 그 상자 위치를 팀 전체 지도에 표시
KeyHint.OnServerEvent:Connect(function(player: Player)
	if not RateLimit.allow(player, "KeyHint", 1, 3) then
		return
	end
	if ReplicatedStorage:GetAttribute("KeyHintReady") ~= true or ReplicatedStorage:GetAttribute("HasKey") == true then
		return
	end
	if player:GetAttribute("Status") ~= "Alive" or ReplicatedStorage:GetAttribute("KeyHintPos") ~= nil then
		return
	end
	-- 힌트는 목숨 1개를 쓴다(마지막 남은 목숨으로는 볼 수 없다)
	local lives = (player:GetAttribute("Lives") :: number?) or 1
	if lives <= 1 then
		RoundEvent:FireClient(player, "KeyHintDenied", { lives = lives })
		return
	end
	local spot = Search.keySpot()
	if spot then
		player:SetAttribute("Lives", lives - 1)
		ReplicatedStorage:SetAttribute("KeyHintPos", spot.center)
		RoundEvent:FireAllClients("KeyHintShown", { by = player.DisplayName, userId = player.UserId, lives = lives - 1 })
	end
end)

function Search.all(): { Spot }
	return spots
end

-- 열쇠가 든 상자와 칸 번호
function Search.keySpot(): (Spot?, number?)
	for _, s in spots do
		for i, c in s.comps do
			if c.hasKey then
				return s, i
			end
		end
	end
	return nil, nil
end

return Search
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="241">
        <Properties>
          <string name="Name">SoundBus</string>
          <string name="Source"><![CDATA[--!strict
-- 서버의 소리 이벤트 통로. 음파·발소리·문 소리가 여기로 들어오고, 괴물들이 듣는다.
-- 들리는 거리 = 소리 크기(반경) × (벽 감쇠 ^ 사이에 낀 벽 수).
-- 지금은 거리 + 벽 개수 감쇠. 나중에 경로 길이 기반 전파 등으로 바꾸려면 heardRange 만 고치면 된다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local SoundBus = {}

export type Listener = (pos: Vector3, radius: number, source: Player?, kind: string) -> ()

local listeners: { Listener } = {}
SoundBus.recent = {} :: { { pos: Vector3, radius: number, kind: string, t: number, source: string } }

local geometry: Instance? = nil
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include
params.RespectCanCollide = true

function SoundBus.setGeometry(folder: Instance?)
	geometry = folder
	if folder then
		params.FilterDescendantsInstances = { folder }
	end
end

function SoundBus.listen(fn: Listener): () -> ()
	table.insert(listeners, fn)
	return function()
		local i = table.find(listeners, fn)
		if i then
			table.remove(listeners, i)
		end
	end
end

-- a 와 b 사이의 벽(충돌 파트) 수, 최대 MaxWallsCounted
function SoundBus.wallsBetween(a: Vector3, b: Vector3): number
	if not geometry then
		return 0
	end
	local count = 0
	local from = a
	for _ = 1, Config.Noise.MaxWallsCounted do
		local d = b - from
		if d.Magnitude < 0.1 then
			break
		end
		local hit = workspace:Raycast(from, d, params)
		if not hit then
			break
		end
		count += 1
		-- (파트 안에서 시작한 레이는 그 파트를 다시 맞히지 않으므로 다음 레이는 벽 너머로 나간다)
		from = hit.Position + d.Unit * 0.05
	end
	return count
end

-- 소리(pos, radius)가 listenerPos 에서 들리는 최대 거리
function SoundBus.heardRange(pos: Vector3, listenerPos: Vector3, radius: number): number
	if (pos - listenerPos).Magnitude > radius then
		return radius -- 이미 범위 밖: 벽 계산 생략
	end
	local walls = SoundBus.wallsBetween(pos + Vector3.new(0, 0.5, 0), listenerPos)
	return radius * (Config.Noise.WallAttenuation ^ walls)
end

function SoundBus.canHear(pos: Vector3, listenerPos: Vector3, radius: number): boolean
	local d = (pos - listenerPos).Magnitude
	if d > radius then
		return false
	end
	return d <= SoundBus.heardRange(pos, listenerPos, radius)
end

function SoundBus.emit(pos: Vector3, radius: number, source: Player?, kind: string)
	table.insert(SoundBus.recent, { pos = pos, radius = radius, kind = kind, t = os.clock(), source = if source then source.Name else "" })
	if #SoundBus.recent > 50 then
		table.remove(SoundBus.recent, 1)
	end
	for _, fn in table.clone(listeners) do
		local ok, err = pcall(fn, pos, radius, source, kind)
		if not ok then
			warn("[SoundBus] listener error: " .. tostring(err))
		end
	end
end

return SoundBus
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="242">
        <Properties>
          <string name="Name">StageBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- 타일 레이아웃(문자 격자)으로 스테이지 지형을 짓는다. 모든 스테이지가 같은 빌더와 MapKit 부품을 쓴다.
-- 타일 1칸 = 8스터드. 위층 바닥 y=0, 구덩이(아래층) 바닥 y=-6, 천장 y=14.
--
-- 공통 타일 문자
--   #  벽            .  바닥          S  시작 지점       E  출구
--   D  문(복도를 가로지르는 벽 + 문)   A  아치 리브       O  기둥
--   c  상자 더미      m  기계 설비     v  수직 배관 묶음  f  천장 환풍기
--   p  구덩이(아래층) b  구덩이 위 철제 다리             s  계단(구덩이 ↔ 위층)
--   1  2층 계단 아래 칸(바닥 0 → 6)   2  2층 계단 위 칸(6 → 12). 1 은 1층 칸, 2 는 2층 칸과 맞닿는다.
-- 2층: layout.UpperRects 의 직사각형(타일 좌표 {i0, j0, i1, j1}) 안 칸은 바닥이 y=12(UP)이고 천장이 y=26.
--   2층 칸은 1층 칸 위에 겹쳐 쌓지 않고 같은 격자의 다른 구역에 높게 짓는다(벽으로 막혀 있으니 음파로는 구별되지 않는다).
--   center(i, j) 의 y 가 그 칸의 바닥 기준 높이라서, 소품 함수는 floorY·H 를 그대로 상대 높이로 쓰면 된다.
-- 스테이지별 추가 타일은 레이아웃 모듈의 Props 함수로 짓는다(같은 ctx 를 받는다).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local Doors = require(script.Parent.Doors)
local Hiding = require(script.Parent.Hiding)
local Search = require(script.Parent.Search)

local Builder = {}

local T = 8
local H = 14
local PIT_Y = -6
local BOTTOM = -10
local UP = 12 -- 2층 바닥 높이
Builder.Tile = T
Builder.Height = H
Builder.PitY = PIT_Y
Builder.Up = UP

export type Layout = {
	Rows: { string },
	Props: { [string]: (ctx: any, i: number, j: number) -> () }?,
	Walkable: { [string]: boolean }?, -- Props 타일 중 괴물 배회 지점으로 쓸 수 있는 것
	PitTiles: { [string]: boolean }?, -- Props 타일 중 아래층 높이인 것
	PipeChance: number?,
	HideStyle: string?,
	SearchStyle: string?, -- 상자·서랍(Z) 모양: drawers / crate / toolbox / nightstand / chest (Search.Styles) -- 숨는 곳(L) 모양: locker / tool / rusty / wardrobe / closet (Hiding.Styles)
	Seed: number?,
	UpperRects: { { number } }?, -- 2층 구역(타일 좌표 {i0, j0, i1, j1})
}

export type StageInfo = {
	folder: Folder,
	spawns: { CFrame },
	exitCFrame: CFrame,
	exitSize: Vector3,
	nodes: { Vector3 },
	bounds: { min: Vector3, max: Vector3 },
	-- 타일 격자 위 최단 경로(타일 가운데 바닥 높이 좌표들). PathfindingService 는 시작·목표 주변만 탐색하므로
	-- 큰 맵에서 멀리 돌아가야 하는 길은 이 경로를 짧은 구간으로 나눠 계산한다. monster = true 면 좁은 다리(n) 제외
	route: (from: Vector3, to: Vector3, monster: boolean?) -> { Vector3 }?,
}

local PIT = { p = true, b = true, s = true, n = true }
local function bridgeChar(c: string): boolean
	return c == "b" or c == "n"
end

local function hash(a: number, b: number, c: number): number
	local h = bit32.bxor(bit32.bxor((a * 73856093) % 4294967296, (b * 19349663) % 4294967296), (c * 83492791) % 4294967296)
	return (h % 1000) / 1000
end

-- 한 층(격자 하나)을 짓는다. fl 이 있으면 겹쳐 쌓는 2층 건물의 한 층:
--   fl.rows 이 층 격자, fl.y0 바닥 높이(1층 0, 2층 UP), fl.Hc 이 층 천장 높이, fl.above(1층일 때 2층 격자: 계단 구멍 o 위치·계단 도착 칸),
--   fl.below(2층일 때 1층 격자: 계단 구멍 난간), fl.folder(2층은 1층 폴더에 함께 짓는다)
type Floor = { rows: { string }, y0: number, Hc: number, above: { string }?, below: { string }?, folder: Folder? }
local function buildGrid(layout: Layout, parent: Instance?, name: string, fl: Floor?): StageInfo
	local rows = if fl then fl.rows else layout.Rows
	local H = if fl then fl.Hc else H
	local Y0 = if fl then fl.y0 else 0
	local above = fl and fl.above
	local below = fl and fl.below
	local function rowAt(rs: { string }?, i: number, j: number): string
		if not rs or j < 1 or j > #rs or i < 1 or i > #rs[1] then
			return "#"
		end
		return rs[j]:sub(i, i)
	end
	-- 2층 바닥 칸(1층 격자에서 본 위층): 벽도 계단 구멍도 아니다
	local function aboveFloor(i: number, j: number): boolean
		local c = rowAt(above, i, j)
		return above ~= nil and c ~= "#" and c ~= "o"
	end
	local nz = #rows
	local nx = #rows[1]
	local grid: { { string } } = {}
	for j = 1, nz do
		grid[j] = {}
		for i = 1, nx do
			grid[j][i] = rows[j]:sub(i, i)
		end
	end
	local function at(i: number, j: number): string
		if j < 1 or j > nz or i < 1 or i > nx then
			return "#"
		end
		return grid[j][i]
	end
	local pitSet = table.clone(PIT)
	for k, v in layout.PitTiles or {} do
		pitSet[k] = v
	end
	local function isWall(i: number, j: number): boolean
		return at(i, j) == "#"
	end
	local function isPit(i: number, j: number): boolean
		return pitSet[at(i, j)] == true
	end
	local function floorY(i: number, j: number): number
		return if isPit(i, j) then PIT_Y else 0
	end
	-- 2층 구역
	local upperSet: { [number]: boolean } = {}
	local hasUpper = false
	for _, r in layout.UpperRects or {} do
		for j = r[2], r[4] do
			for i = r[1], r[3] do
				upperSet[j * 1000 + i] = true
				hasUpper = true
			end
		end
	end
	local function isFlight(i: number, j: number): boolean
		local c = at(i, j)
		return c == "1" or c == "2"
	end
	-- 이 칸의 바닥 기준 높이(1층 0, 계단 위 칸 6, 2층 12)
	local function base(i: number, j: number): number
		local c = at(i, j)
		if c == "1" then
			return 0
		elseif c == "2" then
			return UP / 2
		end
		return if upperSet[j * 1000 + i] then UP else 0
	end
	local function isUpper(i: number, j: number): boolean
		return upperSet[j * 1000 + i] == true and not isFlight(i, j)
	end
	-- 타일 (i, j) 의 가운데(x,z, y = 그 칸의 바닥 기준 높이). i = 열(x), j = 행(z)
	local function center(i: number, j: number): Vector3
		return Vector3.new((i - 1) * T + T / 2, base(i, j) + Y0, (j - 1) * T + T / 2)
	end
	local TOP = if hasUpper then UP + H else H

	local folder = if fl and fl.folder then fl.folder else Instance.new("Folder")
	folder.Name = name
	local geo = folder:FindFirstChild("Geometry") :: Folder?
	if not geo then
		geo = Instance.new("Folder")
		;(geo :: Folder).Name = "Geometry"
		;(geo :: Folder).Parent = folder
	end
	local props = folder:FindFirstChild("Props") :: Folder?
	if not props then
		props = Instance.new("Folder")
		;(props :: Folder).Name = "Props"
		;(props :: Folder).Parent = folder
	end
	local geo = geo :: Folder
	local props = props :: Folder

	-- ── 직사각형 병합(같은 종류 타일을 큰 상자 하나로) ──
	local function merge(pred: (i: number, j: number) -> boolean): { { number } }
		local used: { [number]: boolean } = {}
		local rects = {}
		for j = 1, nz do
			for i = 1, nx do
				if not used[j * 1000 + i] and pred(i, j) then
					local i1 = i
					while i1 + 1 <= nx and pred(i1 + 1, j) and not used[j * 1000 + i1 + 1] do
						i1 += 1
					end
					local j1 = j
					local grow = true
					while grow and j1 + 1 <= nz do
						for x = i, i1 do
							if not pred(x, j1 + 1) or used[(j1 + 1) * 1000 + x] then
								grow = false
								break
							end
						end
						if grow then
							j1 += 1
						end
					end
					for y = j, j1 do
						for x = i, i1 do
							used[y * 1000 + x] = true
						end
					end
					table.insert(rects, { i, j, i1, j1 })
				end
			end
		end
		return rects
	end
	local function rectSpan(r: { number }, y0: number, y1: number, opts: Kit.Opts?)
		local lo = Vector3.new((r[1] - 1) * T, y0, (r[2] - 1) * T)
		local hi = Vector3.new(r[3] * T, y1, r[4] * T)
		return Kit.span(geo, lo, hi, opts)
	end

	-- 벽 덩어리, 위층 바닥(벽 아래 포함), 아래층 바닥, 천장
	for _, r in merge(function(i, j) return isWall(i, j) end) do
		rectSpan(r, Y0, Y0 + TOP, { name = "Wall" })
	end
	-- (겹쳐 쌓은 2층: 바닥은 1층을 지을 때 층 사이 판으로 이미 깔았다)
	for _, top in if below then {} else { 0, UP / 2, UP } do
		for _, r in merge(function(i, j) return not isPit(i, j) and not isWall(i, j) and base(i, j) == top end) do
			rectSpan(r, BOTTOM, top, { name = if top == UP then "UpperFloor" else "Floor" })
		end
	end
	if not below then
		for _, r in merge(function(i, j) return isWall(i, j) end) do
			rectSpan(r, BOTTOM, 0, { name = "Floor" })
		end
		for _, r in merge(function(i, j) return isPit(i, j) end) do
			rectSpan(r, BOTTOM, PIT_Y, { name = "PitFloor" })
		end
	end
	if above then
		-- 겹쳐 쌓은 1층: 천장 = 층 사이 판(1층 천장 H ~ 2층 바닥 UP). 계단 위(2층 격자의 o)만 뚫는다
		for _, r in merge(function(i, j) return rowAt(above, i, j) ~= "o" end) do
			rectSpan(r, H, UP, { name = "UpperFloor" })
		end
	elseif below then
		Kit.span(geo, Vector3.new(0, Y0 + H, 0), Vector3.new(nx * T, Y0 + H + 2, nz * T), { name = "Ceiling" })
	elseif hasUpper then
		-- 1층 천장(1층·구덩이 칸 위만) + 맨 위 천장(2층과 계단실 위)
		for _, r in merge(function(i, j) return not isWall(i, j) and not isFlight(i, j) and not isUpper(i, j) end) do
			rectSpan(r, H, H + 2, { name = "Ceiling" })
		end
		Kit.span(geo, Vector3.new(0, TOP, 0), Vector3.new(nx * T, TOP + 2, nz * T), { name = "Ceiling" })
	else
		Kit.span(geo, Vector3.new(0, H, 0), Vector3.new(nx * T, H + 2, nz * T), { name = "Ceiling" })
	end

	local dirs = {
		{ di = 1, dj = 0, v = Vector3.new(1, 0, 0) },
		{ di = -1, dj = 0, v = Vector3.new(-1, 0, 0) },
		{ di = 0, dj = 1, v = Vector3.new(0, 0, 1) },
		{ di = 0, dj = -1, v = Vector3.new(0, 0, -1) },
	}

	local info: StageInfo = {
		folder = folder,
		spawns = {},
		exitCFrame = CFrame.new(),
		exitSize = Vector3.new(6, 8, 6),
		nodes = {},
		bounds = { min = Vector3.new(0, BOTTOM, 0), max = Vector3.new(nx * T, Y0 + TOP + 2, nz * T) },
		route = nil,
	}

	-- ── 타일 경로(tools/check-layout.js 와 같은 규칙: 구덩이 = 아래층, 다리 = 위층, 계단 = 둘 다) ──
	-- (벽에 붙은 상자 더미 c·모서리 배관 v 는 칸 절반 이상이 비어 있어 지나갈 수 있다: tools/level-graph.js 와 같은 규칙)
	local passable: { [string]: boolean } = { ["."] = true, S = true, E = true, D = true, A = true, f = true, s = true, ["1"] = true, ["2"] = true, c = true, v = true } -- (P 등 소품 문자는 레이아웃 Walkable 에 적은 것만)
	for k in pitSet do
		passable[k] = true
	end
	for k, v in layout.Walkable or {} do
		passable[k] = v
	end
	local function levels(c: string): { number }
		if pitSet[c] then
			if bridgeChar(c) then
				return { 0 }
			elseif c == "s" then
				return { 0, 1 }
			end
			return { 1 }
		end
		return { 0 }
	end
	-- 층 번호: 0 = 1층, 1 = 구덩이(아래층), 2 = 2층. 계단 1 칸은 1층, 2 칸은 2층으로 치고 둘 사이를 건너면 층이 바뀐다
	local function levelsAt(i: number, j: number): { number }
		local c = at(i, j)
		if c == "1" then
			return { 0 }
		elseif c == "2" or upperSet[j * 1000 + i] then
			return { 2 }
		end
		return levels(c)
	end
	local function hasLevel(i: number, j: number, l: number): boolean
		for _, x in levelsAt(i, j) do
			if x == l then
				return true
			end
		end
		return false
	end
	info.route = function(from: Vector3, to: Vector3, monster: boolean?): { Vector3 }?
		local function tileOf(p: Vector3): (number, number, number)
			local i, j = math.floor(p.X / T) + 1, math.floor(p.Z / T) + 1
			local l = if p.Y < PIT_Y / 2 then 1 elseif p.Y > UP - 4 then 2 else 0
			if not hasLevel(i, j, l) then
				l = levelsAt(i, j)[1]
			end
			return i, j, l
		end
		local si, sj, sl = tileOf(from)
		local gi, gj, gl = tileOf(to)
		if not passable[at(si, sj)] or not passable[at(gi, gj)] then
			return nil
		end
		local function k(i: number, j: number, l: number): number
			return (l * nz + (j - 1)) * (nx + 2) + i
		end
		local prev: { [number]: number } = { [k(si, sj, sl)] = -1 }
		local q = { { si, sj, sl } }
		local head = 1
		local found = false
		while head <= #q do
			local cur = q[head]
			head += 1
			local i, j, l = cur[1], cur[2], cur[3]
			if i == gi and j == gj and l == gl then
				found = true
				break
			end
			local here = k(i, j, l)
			if at(i, j) == "s" then
				local other = k(i, j, 1 - l)
				if prev[other] == nil then
					prev[other] = here
					table.insert(q, { i, j, 1 - l })
				end
			end
			local here_c = at(i, j)
			for _, d in dirs do
				local ni, nj = i + d.di, j + d.dj
				local c = at(ni, nj)
				local nl = l
				-- 계단 아래 칸(1) ↔ 위 칸(2): 층이 바뀐다
				if (here_c == "1" and c == "2") or (here_c == "2" and c == "1") then
					nl = levelsAt(ni, nj)[1]
				end
				if passable[c] and not (monster and c == "n") and hasLevel(ni, nj, nl) then
					local nk = k(ni, nj, nl)
					if prev[nk] == nil then
						prev[nk] = here
						table.insert(q, { ni, nj, nl })
					end
				end
			end
		end
		if not found then
			return nil
		end
		local out = {}
		local cur = k(gi, gj, gl)
		while cur ~= -1 do
			local l = cur // ((nx + 2) * nz)
			local rest = cur % ((nx + 2) * nz)
			local j, i = rest // (nx + 2) + 1, rest % (nx + 2)
			local y = if l == 1 then PIT_Y else 0
			if at(i, j) == "s" then
				y = PIT_Y / 2
			elseif isFlight(i, j) then
				y = UP / 4 -- (계단 칸 가운데 높이: center 의 y 가 그 칸 아래 끝)
			end
			table.insert(out, 1, center(i, j) + Vector3.new(0, y + 0.5, 0))
			cur = prev[cur]
		end
		return out
	end

	local ctx = {
		Kit = Kit,
		Doors = Doors,
		props = props,
		geo = geo,
		at = at,
		center = center,
		floorY = floorY,
		isWall = isWall,
		isPit = isPit,
		T = T,
		H = H,
		PIT_Y = PIT_Y,
		info = info,
		hash = hash,
	}

	-- 이 타일에서 벽이 있는 방향 목록
	local function wallSides(i: number, j: number)
		local out = {}
		for _, d in dirs do
			if isWall(i + d.di, j + d.dj) then
				table.insert(out, d)
			end
		end
		return out
	end
	-- 복도 방향: 양옆이 벽이면 진행 방향 벡터
	local function corridorAxis(i: number, j: number): Vector3?
		local wx = isWall(i - 1, j) and isWall(i + 1, j)
		local wz = isWall(i, j - 1) and isWall(i, j + 1)
		if wx and not wz then
			return Vector3.new(0, 0, 1)
		elseif wz and not wx then
			return Vector3.new(1, 0, 0)
		end
		return nil
	end

	-- ── 벽면 장식: 벽기둥(필라스터), 천장 모서리 경사, 벽 배관 ──
	local pipeChance = layout.PipeChance or 0.55
	local seed = layout.Seed or 1
	for j = 1, nz do
		for i = 1, nx do
			local ch = at(i, j)
			if ch ~= "#" and ch ~= "o" and not isFlight(i, j) then
				local fy = floorY(i, j)
				local c = center(i, j)
				for _, d in wallSides(i, j) do
					local n = -d.v -- 벽면이 방을 향하는 법선
					local along = Vector3.new(d.v.Z, 0, -d.v.X) -- 벽을 따라가는 방향
					local face = c + d.v * (T / 2) -- 벽면 가운데(바닥 높이 0)
					-- 벽기둥: 이 타일의 시작 모서리에, 다음 타일도 같은 쪽에 벽이 있을 때
					local ni, nj = i - math.round(along.X), j - math.round(along.Z)
					if at(ni, nj) ~= "#" and isWall(ni + d.di, nj + d.dj) and floorY(ni, nj) == fy then
						local p = face - along * (T / 2) + n * 0.25
						Kit.box(geo, CFrame.lookAt(p + Vector3.new(0, (fy + H) / 2, 0), p + Vector3.new(0, (fy + H) / 2, 0) + n), Vector3.new(1.1, H - fy, 0.5), { name = "Pilaster" })
					end
					-- 천장 모서리 경사(쐐기): 바닥면이 천장에, 뒷면이 벽에 붙는다
					if ch ~= "D" and ch ~= "A" and ch ~= "E" then
						local s = 1.4
						local pos = face + n * (s / 2) + Vector3.new(0, H - s / 2, 0)
						local vY = Vector3.new(0, -1, 0)
						local vZ = -n
						Kit.wedge(geo, CFrame.fromMatrix(pos, vY:Cross(vZ), vY, vZ), Vector3.new(T, s, s), { name = "Haunch", collide = false, blocks = false })
					end
					-- 벽 배관: 같은 벽 줄(행/열 + 방향)마다 정해진 확률로, 줄 전체에 이어진다
					local lineKey = if math.abs(d.v.X) > 0 then i * 2 + (if d.v.X > 0 then 1 else 0) else j * 2 + (if d.v.Z > 0 then 1 else 0)
					local axisKey = if math.abs(d.v.X) > 0 then 1 else 2
					if hash(lineKey, axisKey, seed) < pipeChance and ch ~= "D" and ch ~= "A" and ch ~= "E" and ch ~= "S" then
						local r = 0.5
						local y = H - 3
						local off = n * (r + 0.9)
						local a = face - along * (T / 2) + off + Vector3.new(0, y, 0)
						local b = face + along * (T / 2) + off + Vector3.new(0, y, 0)
						Kit.pipe(props, a, b, r, { 0 }, true)
						-- 벽 고정 브래킷
						local bc = face + n * 0.6 + Vector3.new(0, y, 0)
						Kit.box(props, CFrame.lookAt(bc, bc + n), Vector3.new(0.3, 0.3, 1.2), { blocks = false, collide = false })
						-- 다음 타일에서 벽이 끊기면 배관을 벽 속으로 꺾어 넣는다
						for _, sgn in { -1, 1 } do
							local ti, tj = i + math.round(along.X) * sgn, j + math.round(along.Z) * sgn
							local continues = at(ti, tj) ~= "#" and isWall(ti + d.di, tj + d.dj) and not (at(ti, tj) == "D" or at(ti, tj) == "A" or at(ti, tj) == "E" or at(ti, tj) == "S")
							if not continues then
								local endP = if sgn > 0 then b else a
								local inner = endP - along * sgn * 0.6
								if isWall(ti, tj) then
									-- 앞이 벽이면 그 벽으로 들어간다(배관이 이미 닿음)
									local _ = inner
								else
									Kit.cylinder(props, inner, inner - n * (r + 1.2), r, { blocks = false })
								end
							end
						end
						-- 가는 전선관(위쪽)
						if hash(lineKey, axisKey, seed + 7) < 0.5 then
							local off2 = n * 0.45
							local a2 = face - along * (T / 2) + off2 + Vector3.new(0, H - 1.9, 0)
							local b2 = face + along * (T / 2) + off2 + Vector3.new(0, H - 1.9, 0)
							Kit.cylinder(props, a2, b2, 0.16, { blocks = false, collide = false })
						end
					end
				end
			end
		end
	end

	-- ── 타일별 구조물 ──
	for j = 1, nz do
		for i = 1, nx do
			local ch = at(i, j)
			local c = center(i, j)
			local fy = floorY(i, j)
			local axis = corridorAxis(i, j)
			if ch == "S" then
				local look = Vector3.new(nx * T / 2, 0, nz * T / 2)
				local p = c + Vector3.new(0, 3.2, 0)
				for k = 0, 1 do
					local off = Vector3.new(if k == 0 then -1.6 else 1.6, 0, 0)
					table.insert(info.spawns, CFrame.lookAt(p + off, Vector3.new(look.X, p.Y, look.Z)))
				end
			elseif ch == "E" then
				-- 들어오는 방향(바닥 이웃)
				local entry = dirs[1]
				for _, d in dirs do
					if not isWall(i + d.di, j + d.dj) then
						entry = d
					end
				end
				local back = -entry.v -- 출구 안쪽 끝 벽 방향
				local right = Vector3.new(back.Z, 0, -back.X)
				-- 입구 문틀(두꺼운 이중 프레임)
				local gate = c + entry.v * (T / 2 - 0.6)
				for _, s in { -1, 1 } do
					for k = 0, 1 do
						local p = gate + right * s * (3.2 + k * 0.6) + Vector3.new(0, 5, 0) - entry.v * k * 0.4
						Kit.box(geo, CFrame.lookAt(p, p + entry.v), Vector3.new(0.5, 10, 1.2), { name = "ExitFrame" })
					end
				end
				Kit.box(geo, CFrame.lookAt(gate + Vector3.new(0, 10.4, 0), gate + Vector3.new(0, 10.4, 0) + entry.v), Vector3.new(8, 0.8, 1.2), { name = "ExitLintel" })
				Kit.box(geo, CFrame.lookAt(gate + Vector3.new(0, 11.6, 0), gate + Vector3.new(0, 11.6, 0) + entry.v), Vector3.new(8, 1.6, 0.6))
				-- EXIT 글자(안쪽 벽)
				local wallFace = c + back * (T / 2 - 0.01)
				Kit.word(props, "EXIT", wallFace + Vector3.new(0, 8.5, 0) - right * 0.7, -right, -back, 1.4)
				-- 사다리와 천장 해치
				local lad = wallFace - back * 0.6 + right * 3.0
				for _, s in { -0.7, 0.7 } do
					Kit.cylinder(props, lad + right * s, lad + right * s + Vector3.new(0, H, 0), 0.1, { blocks = false })
				end
				for y = 1, H - 1, 1.2 do
					Kit.cylinder(props, lad + right * -0.7 + Vector3.new(0, y, 0), lad + right * 0.7 + Vector3.new(0, y, 0), 0.07, { blocks = false, collide = false })
				end
				local hatch = lad + back * 0.4 + Vector3.new(0, H - 0.2, 0)
				for _, s in { -1, 1 } do
					Kit.box(props, CFrame.lookAt(hatch + right * s * 1.4, hatch + right * s * 1.4 + back), Vector3.new(0.3, 0.4, 3.0), { blocks = false, collide = false })
					Kit.box(props, CFrame.lookAt(hatch + back * s * 1.4, hatch + back * s * 1.4 + right), Vector3.new(0.3, 0.4, 3.0), { blocks = false, collide = false })
				end
				info.exitCFrame = CFrame.lookAt(c + Vector3.new(0, 4, 0) + back * 0.8, c + Vector3.new(0, 4, 0) + back * 2)
				info.exitSize = Vector3.new(T - 1, 8, T - 2.5)
			elseif ch == "D" then
				local ax = axis or Vector3.new(1, 0, 0)
				local across = Vector3.new(ax.Z, 0, -ax.X)
				local doorW, doorH, thick = 5, 9, 2
				-- 문 벽: 문 양옆과 문 위
				local sideW = (T - doorW) / 2
				for _, s in { -1, 1 } do
					local p = c + across * s * (doorW / 2 + sideW / 2) + Vector3.new(0, H / 2, 0)
					Kit.box(geo, CFrame.lookAt(p, p + ax), Vector3.new(sideW, H, thick), { name = "DoorWall" })
					-- 문틀(양쪽으로 튀어나온 문설주)
					local jp = c + across * s * (doorW / 2 + 0.25) + Vector3.new(0, doorH / 2, 0)
					Kit.box(geo, CFrame.lookAt(jp, jp + ax), Vector3.new(0.5, doorH, thick + 0.5), { name = "DoorJamb" })
				end
				local top = c + Vector3.new(0, (doorH + H) / 2, 0)
				Kit.box(geo, CFrame.lookAt(top, top + ax), Vector3.new(doorW, H - doorH, thick), { name = "DoorWall" })
				local lint = c + Vector3.new(0, doorH + 0.25, 0)
				Kit.box(geo, CFrame.lookAt(lint, lint + ax), Vector3.new(doorW + 1, 0.5, thick + 0.5), { name = "DoorHead" })
				local hingeBottom = c - across * (doorW / 2) + ax * (thick / 2 - 0.15) + Vector3.new(0, 0.02, 0)
				local swing = if hash(i, j, seed) < 0.5 then 1 else -1
				-- (문짝은 경첩에서 across 방향으로 뻗는다. swing 부호에 따라 ax 쪽이나 반대쪽으로 열린다)
				Doors.create(props, hingeBottom, across, doorW, doorH, swing)
			elseif ch == "A" then
				local ax = axis or Vector3.new(1, 0, 0)
				local across = Vector3.new(ax.Z, 0, -ax.X)
				Kit.archPortal(geo, c + Vector3.new(0, fy, 0), across, T, 6, H - fy)
			elseif ch == "O" then
				local p = c + Vector3.new(0, fy, 0)
				Kit.box(geo, CFrame.new(p + Vector3.new(0, (H - fy) / 2, 0)), Vector3.new(2.4, H - fy, 2.4), { name = "Pillar" })
				Kit.box(geo, CFrame.new(p + Vector3.new(0, 0.4, 0)), Vector3.new(3.4, 0.8, 3.4), { name = "PillarBase" })
				Kit.box(geo, CFrame.new(p + Vector3.new(0, H - fy - 0.6, 0)), Vector3.new(3.2, 1.2, 3.2), { name = "PillarCap" })
			elseif ch == "c" then
				-- 벽 쪽으로 붙인 상자 더미
				local side = Vector3.new(-1, 0, 0)
				for _, d in dirs do
					if isWall(i + d.di, j + d.dj) then
						side = d.v
						break
					end
				end
				local along = Vector3.new(side.Z, 0, -side.X)
				local base = c + side * (T / 2 - 1.8) + Vector3.new(0, fy, 0)
				local yaw = math.atan2(side.X, side.Z)
				Kit.crate(props, base - along * 1.8, Vector3.new(3, 3, 3), yaw)
				Kit.crate(props, base - along * 1.8 + Vector3.new(0, 3, 0), Vector3.new(2.2, 2.2, 2.2), yaw + 0.25)
				Kit.crate(props, base + along * 1.7, Vector3.new(3.2, 2.2, 2.6), yaw - 0.1)
				Kit.box(props, CFrame.new(base + along * 1.7 + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, yaw, 0), Vector3.new(3.6, 0.24, 3.0), { blocks = false })
			elseif ch == "m" then
				local p = c + Vector3.new(0, fy, 0)
				Kit.box(props, CFrame.new(p + Vector3.new(0, 0.4, 0)), Vector3.new(5.4, 0.8, 4.2), { name = "MachineBase" })
				Kit.box(props, CFrame.new(p + Vector3.new(-0.6, 2.4, 0)), Vector3.new(3.6, 3.2, 3.4), { name = "Machine" })
				Kit.box(props, CFrame.new(p + Vector3.new(1.9, 1.9, 0)), Vector3.new(1.0, 2.2, 1.6), { name = "Panel" })
				Kit.pipe(props, p + Vector3.new(-2.4, 5.2, 0), p + Vector3.new(1.6, 5.2, 0), 1.1, { 0, 1 }, true)
				Kit.pipe(props, p + Vector3.new(1.0, 6.3, 0), p + Vector3.new(1.0, H - fy, 0), 0.45, { 0.05, 0.95 }, false)
				for _, s in { -1, 1 } do
					Kit.box(props, CFrame.new(p + Vector3.new(-0.4 + s * 1.4, 4.4, 0)), Vector3.new(0.4, 1.0, 2.2), { blocks = false })
				end
				local em = Kit.box(props, CFrame.new(p + Vector3.new(0, 3, 0)), Vector3.new(0.2, 0.2, 0.2), { invisible = true, collide = false, tag = false })
				em.CanQuery = false
				em:SetAttribute("Sound", "AmbientFan")
				CollectionService:AddTag(em, Config.Tags.AmbientEmitter)
			elseif ch == "Z" then
				local back = nil
				for _, d in dirs do
					if isWall(i + d.di, j + d.dj) and not isWall(i - d.di, j - d.dj) then
						back = d.v
						break
					end
				end
				Search.create(props, c + Vector3.new(0, fy, 0), back or Vector3.new(0, 0, -1), layout.SearchStyle)
			elseif ch == "L" then
				-- 숨는 곳: 등을 댈 벽(맞은편이 열린 쪽)을 찾는다
				local back = nil
				for _, d in dirs do
					if isWall(i + d.di, j + d.dj) and not isWall(i - d.di, j - d.dj) then
						back = d.v
						break
					end
				end
				Hiding.create(props, c + Vector3.new(0, fy, 0), back or Vector3.new(0, 0, -1), layout.HideStyle)
			elseif ch == "v" then
				local p = c + Vector3.new(0, fy, 0)
				local spots = { Vector3.new(-2.2, 0, -2.2), Vector3.new(-2.4, 0, 1.6), Vector3.new(1.8, 0, -2.6) }
				local radii = { 1.0, 0.6, 0.7 }
				for k, o in spots do
					Kit.pipe(props, p + o, p + o + Vector3.new(0, H - fy, 0), radii[k], { 0.07, 0.5, 0.93 }, true)
				end
				Kit.pipe(props, p + spots[1] + Vector3.new(0, 10, 0), p + spots[3] + Vector3.new(0, 10, 0), 0.4, { 0.5 }, false)
			elseif ch == "f" then
				local p = c + Vector3.new(0, H, 0)
				Kit.cylinder(props, p - Vector3.new(0, 1.2, 0), p, 2.4, { blocks = false, collide = false, rings = 1 })
				for k = 0, 3 do
					local a = k * math.pi / 2 + 0.4
					local bp = p - Vector3.new(0, 1.0, 0) + Vector3.new(math.cos(a), 0, math.sin(a)) * 1.05
					Kit.box(props, CFrame.lookAt(bp, bp + Vector3.new(math.cos(a), 0, math.sin(a))) * CFrame.Angles(0, 0, 0.35), Vector3.new(0.7, 0.08, 1.8), { blocks = false, collide = false })
				end
				local em = Kit.box(props, CFrame.new(p - Vector3.new(0, 1.5, 0)), Vector3.new(0.2, 0.2, 0.2), { invisible = true, collide = false, tag = false })
				em.CanQuery = false
				em:SetAttribute("Sound", "AmbientFan")
				CollectionService:AddTag(em, Config.Tags.AmbientEmitter)
			elseif ch == "b" or ch == "n" then
				-- 다리 방향: 다리/위층과 이어진 축
				local bx = (bridgeChar(at(i - 1, j)) or (not isPit(i - 1, j) and not isWall(i - 1, j))) and (bridgeChar(at(i + 1, j)) or (not isPit(i + 1, j) and not isWall(i + 1, j)))
				local ax = if bx then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
				local across = Vector3.new(ax.Z, 0, -ax.X)
				local w = if ch == "n" then 3.2 else 5 -- (좁은 다리 n: 괴물은 지나갈 수 없다)
				local deck = c + Vector3.new(0, -0.25, 0)
				Kit.box(geo, CFrame.lookAt(deck, deck + ax), Vector3.new(w, 0.5, T), { name = "Catwalk" })
				for _, s in { -1, 1 } do
					local beam = c + across * s * (w / 2 - 0.3) + Vector3.new(0, -0.9, 0)
					Kit.box(props, CFrame.lookAt(beam, beam + ax), Vector3.new(0.4, 0.8, T), { blocks = false })
					local ra = c + across * s * (w / 2 - 0.15) - ax * (T / 2)
					Kit.railing(props, ra, ra + ax * T, 3.3, 2.65)
				end
				Kit.box(props, CFrame.lookAt(c + Vector3.new(0, -1.0, 0), c + Vector3.new(0, -1.0, 0) + across), Vector3.new(0.4, 0.6, w), { blocks = false })
				if (i + j) % 2 == 0 then
					for _, s in { -1, 1 } do
						local col = c + across * s * (w / 2 - 0.3)
						Kit.box(props, CFrame.new(col + Vector3.new(0, (PIT_Y - 1.3) / 2, 0)), Vector3.new(0.5, -1.3 - PIT_Y, 0.5), { blocks = false })
					end
				end
			elseif ch == "s" then
				-- 계단: 위층 이웃 쪽으로 올라간다
				local up = dirs[1]
				for _, d in dirs do
					local n = at(i + d.di, j + d.dj)
					if n ~= "#" and not isPit(i + d.di, j + d.dj) then
						up = d
					end
				end
				local across = Vector3.new(up.v.Z, 0, -up.v.X)
				local bottom = c - up.v * (T / 2) + Vector3.new(0, PIT_Y, 0)
				Kit.stairs(props, bottom, up.v, 6, -PIT_Y, T, 8)
				-- 계단 옆이 구덩이면 기울어진 난간
				for _, s in { -1, 1 } do
					local si, sj = i + math.round(across.X * s), j + math.round(across.Z * s)
					if not isWall(si, sj) then
						local a = bottom + across * s * 2.9
						local b = a + up.v * T + Vector3.new(0, -PIT_Y, 0)
						Kit.railing(props, a, b, 3.3, 2.7)
					end
				end
			end
			if ch == "1" or ch == "2" then
				-- 2층 계단: 1 칸은 2 칸 쪽으로, 2 칸은 2층 칸 쪽으로 올라간다(칸마다 6스터드)
				local up = dirs[1]
				for _, d in dirs do
					local ni, nj = i + d.di, j + d.dj
					if (ch == "1" and at(ni, nj) == "2") or (ch == "2" and ((isUpper(ni, nj) and not isWall(ni, nj)) or aboveFloor(ni, nj))) then
						up = d
					end
				end
				local bottom = c - up.v * (T / 2)
				Kit.stairs(props, bottom, up.v, 6, UP / 2, T, 8)
				-- 벽 쪽 손잡이(양옆)
				local across = Vector3.new(up.v.Z, 0, -up.v.X)
				for _, s in { -1, 1 } do
					local a = bottom + across * s * 3.4
					Kit.railing(props, a, a + up.v * T + Vector3.new(0, UP / 2, 0), 3.3, 2.7)
				end
			end
			local pf = layout.Props and layout.Props[ch]
			if pf then
				pf(ctx, i, j)
			end
		end
	end

	-- ── 구덩이 가장자리 난간(위층 쪽) ──
	for j = 1, nz do
		for i = 1, nx do
			if not isWall(i, j) and not isPit(i, j) then
				for _, d in dirs do
					local ni, nj = i + d.di, j + d.dj
					local n = at(ni, nj)
					if isPit(ni, nj) then
						local open = false
						if n == "s" then
							-- 그 계단이 이 타일로 올라오면 난간 없음
							local best = nil
							for _, d2 in dirs do
								local m = at(ni + d2.di, nj + d2.dj)
								if m ~= "#" and not isPit(ni + d2.di, nj + d2.dj) then
									best = d2
								end
							end
							open = best ~= nil and best.di == -d.di and best.dj == -d.dj
						elseif bridgeChar(n) then
							local bx = (bridgeChar(at(ni - 1, nj)) or (not isPit(ni - 1, nj) and not isWall(ni - 1, nj))) and (bridgeChar(at(ni + 1, nj)) or (not isPit(ni + 1, nj) and not isWall(ni + 1, nj)))
							open = (bx and d.dj == 0) or (not bx and d.di == 0)
						end
						if open and bridgeChar(n) then
							-- 다리 입구 양옆은 난간
							local c = center(i, j)
							local edge = c + d.v * (T / 2 - 0.3)
							local across = Vector3.new(d.v.Z, 0, -d.v.X)
							local bw = if n == "n" then 1.75 else 2.6
							for _, s in { -1, 1 } do
								Kit.railing(props, edge + across * s * bw, edge + across * s * (T / 2 - 0.3), 3.3, 2.6)
							end
						elseif not open then
							local c = center(i, j)
							local edge = c + d.v * (T / 2 - 0.3)
							local across = Vector3.new(d.v.Z, 0, -d.v.X)
							Kit.railing(props, edge - across * (T / 2 - 0.3), edge + across * (T / 2 - 0.3), 3.3, 2.6)
						end
					end
				end
			end
		end
	end

	-- ── 괴물 배회 지점 ──
	local walk = layout.Walkable or {}
	for j = 1, nz do
		for i = 1, nx do
			local ch = at(i, j)
			if ch == "." or ch == "p" or ch == "b" or ch == "f" or ch == "D" or ch == "A" or walk[ch] then
				local c = center(i, j)
				local y = if ch == "b" then 0 else floorY(i, j)
				table.insert(info.nodes, c + Vector3.new(0, y + 3, 0))
			end
		end
	end

	-- ── 겹쳐 쌓은 2층: 계단 구멍(o) 둘레 난간(계단이 올라와 닿는 칸 쪽은 뚫는다) ──
	if below then
		for j = 1, nz do
			for i = 1, nx do
				if at(i, j) ~= "#" and at(i, j) ~= "o" then
					for _, d in dirs do
						local hi, hj = i + d.di, j + d.dj
						if at(hi, hj) == "o" then
							local landing = rowAt(below, hi, hj) == "2" and rowAt(below, hi + d.di, hj + d.dj) == "1"
							if not landing then
								local c = center(i, j)
								local edge = c + d.v * (T / 2 - 0.3)
								local across = Vector3.new(d.v.Z, 0, -d.v.X)
								Kit.railing(props, edge - across * (T / 2 - 0.3), edge + across * (T / 2 - 0.3), 3.3, 2.6)
							end
						end
					end
				end
			end
		end
		return info
	end

	-- 바닥 아래 낙하 방지(맵 밖)
	local kill = Kit.span(folder, Vector3.new(-20, BOTTOM - 4, -20), Vector3.new(nx * T + 20, BOTTOM - 2, nz * T + 20), { tag = false, invisible = true })
	kill.Name = "Underfloor"

	return info
end

-- ── 겹쳐 쌓은 2층 건물(layout.Rows2: 1층과 같은 크기의 2층 격자) ──
-- 1층 천장 H1, 그 위 층 사이 판(H1 ~ UP), 2층 바닥 UP, 2층 천장 UP + H. 계단은 1층의 1(0 → 6)·2(6 → 12) 칸이고,
-- 2층 격자에서 그 두 칸 자리는 계단 구멍 o(바닥 없음, 둘레 난간), 2 칸 앞(1 의 반대쪽) 2층 칸이 계단 도착 칸이다.
local H1 = 11
Builder.LowerCeiling = H1
function Builder.build(layout: Layout, parent: Instance, name: string): StageInfo
	local r2 = (layout :: any).Rows2 :: { string }?
	if not r2 then
		return buildGrid(layout, parent, name, nil)
	end
	local r1 = layout.Rows
	local info = buildGrid(layout, parent, name, { rows = r1, y0 = 0, Hc = H1, above = r2 })
	local info2 = buildGrid(layout, parent, name, { rows = r2, y0 = UP, Hc = H, below = r1, folder = info.folder })
	for _, n in info2.nodes do
		table.insert(info.nodes, n)
	end
	if table.concat(r2, ""):find("E", 1, true) then
		info.exitCFrame, info.exitSize = info2.exitCFrame, info2.exitSize
	end
	info.bounds = { min = info.bounds.min, max = info2.bounds.max }
	-- 타일 경로: (층, 열, 행, 높이) — 1층 구덩이 규칙은 그대로, 계단 2 ↔ 2층 도착 칸
	local nz, nx = #r1, #r1[1]
	local pitSet = table.clone(PIT)
	for k, v in layout.PitTiles or {} do
		pitSet[k] = v
	end
	-- (벽에 붙은 상자 더미 c·모서리 배관 v 는 칸 절반 이상이 비어 있어 지나갈 수 있다: tools/level-graph.js 와 같은 규칙)
	local passable: { [string]: boolean } = { ["."] = true, S = true, E = true, D = true, A = true, f = true, s = true, ["1"] = true, ["2"] = true, c = true, v = true } -- (P 등 소품 문자는 레이아웃 Walkable 에 적은 것만)
	for k in pitSet do
		passable[k] = true
	end
	for k, v in layout.Walkable or {} do
		passable[k] = v
	end
	local function ch(f: number, i: number, j: number): string
		local rs = if f == 1 then r1 else r2
		if j < 1 or j > nz or i < 1 or i > nx then
			return "#"
		end
		return rs[j]:sub(i, i)
	end
	local function lv(f: number, c: string): { number }
		if f == 2 or c == "1" or c == "2" or not pitSet[c] then
			return { 0 }
		end
		if bridgeChar(c) then
			return { 0 }
		elseif c == "s" then
			return { 0, 1 }
		end
		return { 1 }
	end
	local function has(f: number, i: number, j: number, l: number): boolean
		for _, x in lv(f, ch(f, i, j)) do
			if x == l then
				return true
			end
		end
		return false
	end
	local D4 = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
	local function key(f: number, i: number, j: number, l: number): number
		return (((f - 1) * 2 + l) * (nz + 2) + j) * (nx + 2) + i
	end
	info.route = function(from: Vector3, to: Vector3, monster: boolean?): { Vector3 }?
		local function tileOf(p: Vector3): (number, number, number, number)
			local i, j = math.floor(p.X / T) + 1, math.floor(p.Z / T) + 1
			local f = if p.Y > UP - 3 and passable[ch(2, i, j)] then 2 else 1
			local l = if f == 1 and p.Y < PIT_Y / 2 then 1 else 0
			if not has(f, i, j, l) then
				l = lv(f, ch(f, i, j))[1]
			end
			return f, i, j, l
		end
		local sf, si, sj, sl = tileOf(from)
		local gf, gi, gj, gl = tileOf(to)
		if not passable[ch(sf, si, sj)] or not passable[ch(gf, gi, gj)] then
			return nil
		end
		local prev: { [number]: number } = { [key(sf, si, sj, sl)] = -1 }
		local where: { [number]: { number } } = { [key(sf, si, sj, sl)] = { sf, si, sj, sl } }
		local q = { { sf, si, sj, sl } }
		local head = 1
		local goalK = key(gf, gi, gj, gl)
		local function push(here: number, f: number, i: number, j: number, l: number)
			local c = ch(f, i, j)
			if not passable[c] or (monster and c == "n") or not has(f, i, j, l) then
				return
			end
			local k = key(f, i, j, l)
			if prev[k] == nil then
				prev[k] = here
				where[k] = { f, i, j, l }
				table.insert(q, { f, i, j, l })
			end
		end
		while head <= #q do
			local cur = q[head]
			head += 1
			local f, i, j, l = cur[1], cur[2], cur[3], cur[4]
			local here = key(f, i, j, l)
			if here == goalK then
				break
			end
			local c = ch(f, i, j)
			if f == 1 and c == "s" then
				push(here, 1, i, j, 1 - l)
			end
			for _, d in D4 do
				local ni, nj = i + d[1], j + d[2]
				local n = ch(f, ni, nj)
				if f == 1 and c == "2" then
					-- 계단 위 칸: 1 칸으로 내려가거나, 1 의 반대쪽 2층 칸으로 올라선다
					if n == "1" then
						push(here, 1, ni, nj, 0)
					elseif ch(1, i - d[1], j - d[2]) == "1" then
						push(here, 2, ni, nj, 0)
					end
				elseif f == 2 and n == "o" then
					if ch(1, ni, nj) == "2" and ch(1, ni + d[1], nj + d[2]) == "1" then
						push(here, 1, ni, nj, 0)
					end
				elseif f == 1 and n == "2" and c ~= "1" then
					-- (계단 위 칸은 옆·앞에서 들어갈 수 없다)
				else
					local nl = l
					if f == 1 and (c == "s" or n == "s" or pitSet[n] or pitSet[c]) then
						nl = l
					end
					push(here, f, ni, nj, nl)
				end
			end
		end
		if prev[goalK] == nil then
			return nil
		end
		local out = {}
		local cur = goalK
		while cur ~= -1 do
			local w = where[cur]
			local f, i, j, l = w[1], w[2], w[3], w[4]
			local c = ch(f, i, j)
			local y = if f == 2 then UP elseif l == 1 then PIT_Y else 0
			if f == 1 and c == "s" then
				y = PIT_Y / 2
			elseif f == 1 and c == "1" then
				y = UP / 4
			elseif f == 1 and c == "2" then
				y = UP * 3 / 4
			end
			table.insert(out, 1, Vector3.new((i - 1) * T + T / 2, y + 0.5, (j - 1) * T + T / 2))
			cur = prev[cur]
		end
		return out
	end
	return info
end

return Builder
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="243">
        <Properties>
          <string name="Name">Stages</string>
        </Properties>
        <Item class="ModuleScript" referent="244">
          <Properties>
            <string name="Name">Lobby</string>
            <string name="Source"><![CDATA[--!strict
-- 로비: 방을 만들고 기다리는 어두운 대기실. 스테이지처럼 지어서 음파로 본다(괴물 없음, 출구 없음).
-- 음파 한 번(반경 35스터드)으로 방 전체가 거의 다 보이게 작은 방 하나(안쪽 6x5칸 = 48x40스터드).
-- 가운데 상자 더미(시작 칸 S 4개 사이), 양옆 벽가 기둥, 구석에 상자·기계·배관.
return {
	Seed = 7,
	PipeChance = 0.45,
	Rows = {
		"########",
		"#c....m#",
		"#..SS..#",
		"#O.cc.O#",
		"#..SS..#",
		"#v....c#",
		"########",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="245">
          <Properties>
            <string name="Name">Stage1</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 1 — 지하 시설 (47x43칸, tools/places/facility.js 로 생성)
-- 출입 통제 구역(왼쪽 위): 경비 초소(시작)·검문 홀·탈의실·보안 사무실·출입 복도 — 자동 테스트가 쓰는 칸이라 모양을 지킨다.
-- 시작에서 나가는 길 셋: 동쪽 검문 홀 → 통제실 방 사슬, 보안 사무실·출입 복도 → 본 복도, 출입 복도 서쪽 아치 → 서쪽 정비 통로 → 장비 정비실 → 본 복도(서쪽 날개가 다시 이어진다).
-- 시설을 시계 방향으로 한 바퀴 감아 돈 뒤 봉인된 가운데 기계실의 화물 엘리베이터(출구)로 들어간다. 구간마다 길이 두세 갈래다.
-- 1구간(위, 동쪽으로): 통제실·기록 보관실·장비실·환기 설비실이 옆문으로 이어진 방 사슬 ↔ 본 복도(기록 보관실 앞이 무너져 방으로 돌아간다).
-- 2구간(동쪽, 남쪽으로): 발전기 홀(발전기 넷, 기둥, 가장 큰 공간) → 냉각 배관 구역(배관 벽 사이 좁은 길) ↔ 동쪽 비상 복도, 서로 옆문 2곳씩.
-- 3구간(아래, 서쪽으로): 아래 복도 ↔ 자재 복도(작업장 남쪽, 냉각 구역·창고와 이어짐) 두 갈래.
-- 4구간(서쪽, 북쪽으로): 서쪽 정비 통로 아래쪽·창고 북문 → 정비 통로 C2, 또는 창고 동문 → 구덩이 작업장 → C2 동쪽 → 기계실(남문 2곳) → 화물 엘리베이터.
-- 막다른 곳(숨기 좋은 곳): 배전함 칸·대피 칸들·구덩이 바닥. 기계실은 본 복도·발전기 홀·장비 정비실과 벽으로 막혀 마지막에만 들어간다.
-- 출구까지 최단 약 137칸.
local Props = require(script.Parent.Parent.Props)
local CP = require(script.Parent.Parent.ChapterProps.Facility) -- 챕터 1 전용 소품(통제 콘솔·상황판·발전기·배전반 …)
return {
	Seed = 11,
	PipeChance = 0.55,
	HideStyle = "locker", -- 숨는 곳(L): 철제 사물함
	SearchStyle = "drawers", -- 뒤지는 곳(Z): 철제 서랍장, 그중 한 곳에 열쇠
	Props = { T = Props.Desk, k = CP.Console, W = CP.VideoWall, F = CP.FileCabinet, G = CP.Generator, g = CP.Filler, P = CP.Switchgear, U = CP.PipeRack, j = CP.Workbench, Y = CP.AirHandler, y = CP.Filler, R = Props.RackX, h = CP.Hazard, x = CP.HoseCabinet },
	Walkable = { W = true, h = true, x = true }, -- (상황판·소화전 함은 벽에 붙어 있고, 경고 줄무늬는 바닥 무늬라 지나갈 수 있다)
	Rows = {
		"###############################################",
		"#SS.#.......#...W.W.W..#L......#.PP..PP#v...Yy#",
		"#SS.D..O.O..A..........D..F.F..D.......#v.....#",
		"#...#.......#..k.k.k.k.#..F.F..#.......D..f...#",
		"##A###A######..........#..F.F..#L...c.Z#......#",
		"#..L#......Z#..k.k.k.k.#...f...##.######......#",
		"#...#..T.T..#.....f....#..F.F..##.######......#",
		"#..L#L.....c#L........Z#......Z##.######L....Z#",
		"##D######D#####D#########D###D###D#########D###",
		"#.........................##c................##",
		"###A#####................c##.................##",
		"###.########D###################D#########..###",
		"###.#L.j.j.j...Z#..........Z##v.........v#..###",
		"##Z.#...........#......mm.hhE#.Gg..Gg...v#..###",
		"###A#...........#.mm.....v.h##.gg..gg....#..###",
		"###.D...........#..........v##...........#..###",
		"###.#...........#...#...#.v.##Z..#...#...#..###",
		"#x..#mm.....c.m.#L....f.....##...........#...L#",
		"#c..#############...........##.Gg.....Gg.#....#",
		"###.#########PPP#.mm.....m..##.gg..f..gg.#...c#",
		"###.#########...#v.........v##...........#..###",
		"##############A#####D#####D###...#...#...D..###",
		"###.....A........A....#.....##...........#..###",
		"###.##.#################D#####...........#..###",
		"#L..##D########mm..........v##v.....L...Z#.c###",
		"#...#c......c##......#......####D#########..###",
		"#c..#......c.##..#.......#..####.#########..###",
		"###.#........##...pppsppp...##v.........v#..###",
		"###A#..RRRR..##...ppppppp..Z##..........Z#..###",
		"###.#L.......D....bbbbbbb...##..UUU..UU..#...c#",
		"###.D.......Z##...ppppppp...##...........#....#",
		"#x..#..RRRR..##Z..ppppppp...##...........D...Z#",
		"#L..#........##...spppppp..L##UUUU...UUUU#..###",
		"###.#........#################L..........#v.###",
		"###A#..RRRR..##..#.......#..##...........#..###",
		"###.#c.......D........c.....D............#..###",
		"###.#Z......c##v..........jj##........Z.c#..###",
		"###.####D##########D#####D##########D#####..###",
		"##..............c................c..........###",
		"#c..........................................###",
		"#########################L####Z################",
		"###############################################",
		"###############################################",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="246">
          <Properties>
            <string name="Name">Stage10</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 10 — 폐영화관 (47x43칸 2층, tools/places/cinema.js 로 생성) — 마지막 장, 괴물 5마리
-- 뼈대: 로비 허브 + 둘레 상영관 다섯 + 스크린 뒤 서비스 테(설명·검증: docs/levels/stage10.md).
-- 로비(시작 바람막이 → 매표 창구 B·시간표 H·발권기 k·줄 기둥 r → 매점 섬 팝콘 M·음료 N·메뉴판 Y·카운터 C → 대기 소파 w·원탁 t·입간판 y)
--   → 검표구 둘(검표대 g) → ㄷ자 상영관 복도(번호판 h·포스터 F) → 상영관 1~5(스크린 W·계단식 좌석 q·발밑등 a).
-- 열린 비상문은 4관(북)·5관(동) 둘뿐(표지 i), 나머지는 쇠사슬(x). 스크린 뒤 무대 뒤 복도(서·북·동 ㄷ자) → 남서 하역장 트럭 셔터(출구, 짐수레 Q).
-- 2층: 로비 계단 → 사무실·회의실·라운지 → 영사 복도·영사실(영사기 J·되감기 대 G·앰프 랙 e·필름 선반 R) → 덕트 기계실 층 → 하역장 다락 계단.
-- 출구까지 최단 약 126칸.
local Props = require(script.Parent.Parent.Props)
local CP = require(script.Parent.Parent.ChapterProps.Cinema) -- 영화관 전용 소품

return {
	Seed = 101,
	PipeChance = 0.1,
	HideStyle = "locker", -- 숨는 곳(L): 철제 사물함·청소도구함
	SearchStyle = "drawers", -- 뒤지는 곳(Z): 매점 서랍·필름 캐비닛·사무 서랍, 그중 한 곳에 열쇠
	Props = { q = CP.Seats, j = CP.BrokenSeats, W = CP.Screen, a = CP.AisleLight, x = CP.LockedExit, i = CP.ExitSign, C = CP.Counter, M = CP.Popcorn, N = CP.Drink, Y = CP.MenuBoard, t = CP.HighTable, w = CP.Sofa, y = CP.Standee, d = CP.BinStation, B = CP.TicketWindow, H = CP.Showtimes, k = CP.Kiosk, r = CP.Stanchion, g = CP.TicketStand, F = CP.Poster, h = CP.HallSign, J = CP.Projector, G = CP.RewindBench, e = CP.AmpRack, R = CP.FilmRack, V = CP.Sink, U = CP.ToiletStall, Q = CP.HandCart, T = Props.Desk },
	Walkable = { F = true, r = true, a = true, x = true, h = true, i = true, Y = true, H = true }, -- (벽에 걸린 것·충돌 없는 것: 바닥은 지나갈 수 있다)
	Rows = {
		"###############################################",
		"#c.......e......c.......RR.......c....m......c#",
