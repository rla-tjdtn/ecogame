	{ Id = 9125548429, Start = 0, Dur = 3, Volume = 0.5, Name = "느리게 웅웅거리는 드론 소리 (Slow Buzzing Synth Drone Hum)" },
	{ Id = 9113980319, Start = 0, Dur = 3, Volume = 0.5, Name = "거대 게 괴물의 포효와 으르렁 (Giant Crab Monster Roar Growl)" },
