      </Item>
      <Item class="ModuleScript" referent="132">
        <Properties>
          <string name="Name">MonsterFaces</string>
          <string name="Source"><![CDATA[--!strict
-- 메인 괴물 머리(사용자 확정 3차 시안, 노트 main-monster-v3.svg). 1 삼각 · 2 사각 · 3 원 · 4 별 · 5 육각.
-- 서버(Monster.luau: 3D 선 몸)와 클라이언트(JumpScare.luau: 잡혔을 때 화면 가득 얼굴)가 같은 모양을 쓴다.
-- 좌표는 시안의 머리 기준 px(가운데 0, 아래가 +y). 머리 전체는 (tx, ty)로 옮기고 deg 만큼 돌리고 scale 배.
-- extra 는 머리 밖(몸 좌표 그대로) — 2번 어깨의 작은 머리. 점프스케어는 extra 를 그리지 않는다.

local Faces = {}
-- 지금 메인 괴물 머리(모든 스테이지 공통). 1~5 는 예전 스테이지별 머리(지금은 쓰지 않음)
Faces.BONE = 6
-- 메인 괴물 바늘 이빨 색(사용자 확정: 흰 몸 · 흰 눈 · 붉은 이빨). 음파 선(SonarColor)과 점프스케어에 같이 쓴다
Faces.TEETH = Color3.fromRGB(255, 42, 42)

export type Pt = { number }
export type Line = { pts: { Pt }, r: number, closed: boolean, dz: number, tint: Color3? }
export type Circle = { u: number, v: number, rad: number, dz: number, pupil: boolean }
export type Face = { tx: number, ty: number, deg: number, scale: number, lines: { Line }, circles: { Circle }, extra: { Line }, extraCircles: { Circle } }

type Map = (number, number) -> (number, number)

local function quad(p0: Pt, c: Pt, p1: Pt, n: number): { Pt }
	local out: { Pt } = {}
	for i = 0, n do
		local t = i / n
		local u = 1 - t
		table.insert(out, { u * u * p0[1] + 2 * u * t * c[1] + t * t * p1[1], u * u * p0[2] + 2 * u * t * c[2] + t * t * p1[2] })
	end
	return out
end
local function join(a: { Pt }, b: { Pt }): { Pt }
	local out: { Pt } = table.clone(a)
	for i = 2, #b do
		table.insert(out, b[i])
	end
	return out
end
local function ellipse(cx: number, cy: number, rx: number, ry: number, n: number): { Pt }
	local out: { Pt } = {}
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		table.insert(out, { cx + rx * math.cos(a), cy + ry * math.sin(a) })
	end
	return out
end
local function hexagon(r: number): { Pt }
	local h = r * 0.866
	return { { r, 0 }, { r / 2, h }, { -r / 2, h }, { -r, 0 }, { -r / 2, -h }, { r / 2, -h } }
end
-- translate(tx, ty) rotate(deg) (시안 SVG 와 같은 순서)
local function T(tx: number, ty: number, deg: number): Map
	local c, s = math.cos(math.rad(deg)), math.sin(math.rad(deg))
	return function(u: number, v: number): (number, number)
		return tx + u * c - v * s, ty + u * s + v * c
	end
end
-- rotate(deg cx cy)
local function Rabout(deg: number, cx: number, cy: number): Map
	local c, s = math.cos(math.rad(deg)), math.sin(math.rad(deg))
	return function(u: number, v: number): (number, number)
		local x, y = u - cx, v - cy
		return cx + x * c - y * s, cy + x * s + y * c
	end
end
local function mapPts(m: Map, pts: { Pt }): { Pt }
	local out: { Pt } = {}
	for _, p in pts do
		local x, y = m(p[1], p[2])
		table.insert(out, { x, y })
	end
	return out
end

function Faces.build(shape: number): Face
	local f: Face = { tx = 0, ty = 0, deg = 0, scale = 1, lines = {}, circles = {}, extra = {}, extraCircles = {} }
	local sub: Map? = nil -- 머리 안의 작은 부분 변환(쪼개진 반쪽, 혹)
	local function L(pts: { Pt }, r: number, closed: boolean?, dz: number?)
		table.insert(f.lines, { pts = if sub then mapPts(sub, pts) else pts, r = r, closed = closed == true, dz = dz or 0 })
	end
	local function C(u: number, v: number, rad: number, dz: number?)
		if sub then
			u, v = sub(u, v)
		end
		table.insert(f.circles, { u = u, v = v, rad = rad, dz = dz or -0.05, pupil = (dz or 0) <= -0.07 })
	end
	local function teeth(list: { { number } }, r: number)
		for _, q in list do
			L({ { q[1], q[2] }, { q[3], q[4] } }, r, false, -0.04)
		end
	end
	local function drool(list: { { number } })
		for _, q in list do
			L({ { q[1], q[2] }, { q[3], q[4] } }, 0.012, false, -0.04)
		end
	end

	if shape == Faces.BONE then
		-- 메인 괴물(사용자 확정, 모든 스테이지): 크게 뒤집힌 삼각 머리, 속이 빈 둥근 눈 둘,
		-- 머리 안의 삼각 입 + 입 둘레에 촘촘히 박힌 가는 바늘 이빨(윗니 16 · 아랫니 17, 노트 main-monster-bone.svg 6차)
		-- 좌표는 몸 시안 px(75px = 1스터드), 머리 가운데 기준
		f.tx, f.ty = 342, 99
		L({ { -114.5, -40.5 }, { 108, -71.5 }, { 6.5, 111 } }, 0.04, true)
		C(-34.5, -21.5, 15)
		C(30.5, -31.5, 15)
		L({ { -62, 11 }, { 63, -10.5 }, { 6.5, 98.5 } }, 0.03, true, -0.02)
		-- 바늘 이빨: 입 가장자리(x, y)에서 안쪽으로(SVG rotate 각도) len 만큼. 밑동 양 끝 → 끝 두 줄이 만나는 가시
		local function needles(deg: number, list: { { number } })
			local c, s = math.cos(math.rad(deg)), math.sin(math.rad(deg))
			local w = 2.1
			for _, q in list do
				local x, y, len = q[1] - f.tx, q[2] - f.ty, q[3]
				L({ { x - w * c, y - w * s }, { x + len * s, y - len * c }, { x + w * c, y + w * s } }, 0.012, false, -0.04)
				f.lines[#f.lines].tint = Faces.TEETH
			end
		end
		needles(170.24, { { 287.4, 108.7, 12 }, { 294.7, 107.5, 21 }, { 302.1, 106.2, 18 }, { 309.4, 104.9, 26 }, { 316.8, 103.7, 20 }, { 324.1, 102.4, 29 }, { 331.5, 101.1, 21 }, { 338.8, 99.9, 29 }, { 346.2, 98.6, 22 }, { 353.5, 97.4, 29 }, { 360.9, 96.1, 21 }, { 368.2, 94.8, 27 }, { 375.6, 93.6, 20 }, { 382.9, 92.3, 25 }, { 390.3, 91, 17 }, { 397.6, 89.8, 13 } })
		needles(51.9, { { 287.6, 119.7, 12 }, { 295.2, 129.4, 18 }, { 302.8, 139.2, 16 }, { 310.4, 148.9, 20 }, { 318.1, 158.6, 14 }, { 325.7, 168.3, 16 }, { 333.3, 178.1, 10 }, { 340.9, 187.8, 8 } })
		needles(-62.6, { { 399.4, 99.4, 10 }, { 393.7, 110.3, 17 }, { 388.1, 121.2, 20 }, { 382.4, 132.1, 16 }, { 376.8, 143, 21 }, { 371.1, 153.9, 16 }, { 365.5, 164.8, 17 }, { 359.8, 175.7, 12 }, { 354.2, 186.6, 8 } })
	elseif shape == 1 then
		-- 1 삼각: 기울어진 머리, 크기 다른 눈 5개, 머리 밖까지 찢어져 목까지 내려오는 입, 가슴까지 늘어진 혀
		f.tx, f.ty, f.deg = -4, -256, -24
		L({ { -30, 22 }, { -10, 23 }, { 9, 21 }, { 30, 22 }, { 15, -6 }, { 0, -34 }, { -16, -7 } }, 0.03, true)
		L({ { -36, 8 }, { -12, 6 }, { 12, 7 }, { 36, 4 } }, 0.028, false, -0.03)
		L(join(quad({ -36, 8 }, { -26, 50 }, { 0, 52 }, 4), quad({ 0, 52 }, { 26, 50 }, { 36, 4 }, 4)), 0.028, false, -0.03)
		teeth({ { -30, 8, -30, 20 }, { -25, 7, -24, 30 }, { -20, 7, -20, 16 }, { -15, 6, -14, 34 }, { -10, 6, -10, 18 }, { -5, 6, -4, 38 }, { 0, 7, 0, 20 }, { 5, 7, 5, 36 }, { 10, 7, 10, 16 }, { 15, 6, 16, 32 }, { 20, 6, 20, 14 }, { 25, 5, 25, 28 }, { 30, 5, 30, 12 } }, 0.014)
		teeth({ { -18, 46, -17, 36 }, { -8, 50, -8, 38 }, { 4, 51, 4, 40 }, { 14, 48, 14, 38 }, { 24, 40, 23, 32 } }, 0.014)
		L(join(quad({ 2, 50 }, { 10, 70 }, { 0, 86 }, 3), quad({ 0, 86 }, { -8, 100 }, { 4, 116 }, 3)), 0.02, false, -0.08)
		C(-8, -8, 7)
		C(-7, -7, 1.5, -0.07)
		C(7, -15, 2.4)
		C(11, -4, 1.6)
		C(1, -22, 1.4)
		C(-16, 2, 2)
		drool({ { -22, 40, -22, 52 }, { 28, 30, 29, 40 } })
	elseif shape == 2 then
		-- 2 사각: 부러진 목처럼 38° 꺾인 머리, 머리 폭 두 배로 삐져나온 입, 어깨에 작은 머리 하나 더
		f.tx, f.ty, f.deg = 16, -244, 38
		L({ { -22, -22 }, { -6, -24 }, { 9, -21 }, { 22, -22 }, { 21, -6 }, { 24, 9 }, { 22, 22 }, { 6, 24 }, { -8, 21 }, { -22, 22 }, { -21, 6 }, { -24, -8 } }, 0.03, true)
		L({ { -44, 2 }, { -14, 1 }, { 14, 3 }, { 44, 0 } }, 0.028, false, -0.03)
		L(join(quad({ -44, 2 }, { -30, 38 }, { -4, 42 }, 4), quad({ -4, 42 }, { 26, 40 }, { 44, 0 }, 4)), 0.028, false, -0.03)
		teeth({ { -38, 2, -37, 14 }, { -32, 1, -31, 24 }, { -26, 1, -26, 12 }, { -20, 1, -19, 30 }, { -14, 1, -14, 14 }, { -8, 2, -7, 34 }, { -2, 2, -2, 16 }, { 4, 2, 4, 36 }, { 10, 3, 10, 14 }, { 16, 2, 17, 30 }, { 22, 2, 22, 12 }, { 28, 1, 28, 24 }, { 34, 1, 34, 10 } }, 0.014)
		C(-9, -10, 8)
		C(-12, -12, 1.5, -0.07)
		C(-6, -7, 1, -0.07)
		C(12, -4, 1.8)
		-- 어깨의 작은 머리(몸 좌표)
		local m = T(-30, -210, -20)
		table.insert(f.extra, { pts = mapPts(m, { { -9, -9 }, { 9, -8 }, { 10, 9 }, { -8, 10 } }), r = 0.025, closed = true, dz = 0.55 })
		table.insert(f.extra, { pts = mapPts(m, { { -6, 5 }, { 7, 5 } }), r = 0.016, closed = false, dz = 0.5 })
		table.insert(f.extra, { pts = { { -24, -198 }, { -28, -202 }, { -30, -201 } }, r = 0.016, closed = false, dz = 0.6 })
		local ex, ey = m(-2, -2)
		table.insert(f.extraCircles, { u = ex, v = ey, rad = 2.4, dz = 0.5, pupil = false })
	elseif shape == 3 then
		-- 3 원: 둥근 머리가 세로로 쪼개져 V자로 벌어지고, 틈 안에 세로 눈동자의 큰 눈. 갈라진 면마다 이빨
		f.tx, f.ty, f.deg = 2, -256, 6
		L(ellipse(0, -2, 9, 20, 12), 0.022, true, 0.05)
		L(join(quad({ 0, -17 }, { 3, -2 }, { 0, 13 }, 3), quad({ 0, 13 }, { -3, -2 }, { 0, -17 }, 3)), 0.016, false, 0.03)
		for _, s in { -1, 1 } do
			local outline: { Pt } = {}
			for i = 0, 8 do
				local t = math.rad(-90 + i * 22.5)
				table.insert(outline, { 6 * s + s * 22 * math.cos(t), 22 * math.sin(t) })
			end
			for _, z in { { 10, 17 }, { 6, 12 }, { 11, 7 }, { 6, 2 }, { 11, -3 }, { 6, -8 }, { 11, -13 }, { 6, -18 } } do
				table.insert(outline, { z[1] * s, z[2] })
			end
			sub = Rabout(16 * s, 6 * s, 22)
			L(outline, 0.028, true)
			if s < 0 then
				C(-18, -6, 2.4)
				C(-18, -6, 0.8, -0.07)
				C(-14, 8, 1.4)
			else
				C(17, -8, 1.8)
				C(15, 6, 2.6)
				C(15, 6, 0.8, -0.07)
			end
			sub = nil
		end
		L(quad({ -14, -30 }, { 0, -24 }, { 14, -30 }, 3), 0.012, false, 0.02)
		drool({ { -2, 20, -3, 34 }, { 3, 19, 4, 30 } })
	elseif shape == 4 then
		-- 4 별: 다섯 꼭짓점에서 촉수가 뻗고 끝에 눈동자 있는 눈. 가운데 둥근 입 + 사방으로 난 이빨
		f.tx, f.ty, f.deg, f.scale = 0, -244, 14, 0.9
		L({ { 0, -26 }, { -7.3, -10.1 }, { -24.7, -8 }, { -11.9, 3.9 }, { -15.3, 21 }, { 0, 12.5 }, { 15.3, 21 }, { 11.9, 3.9 }, { 24.7, -8 }, { 7.3, -10.1 } }, 0.03, true)
		local tent = {
			{ { 0, -26 }, { 4, -34 }, { 0, -40 }, { 0, -44 }, { 1, -45 } },
			{ { -24.7, -8 }, { -32, -6 }, { -37, -12 }, { -41, -13 }, { -42, -12 } },
			{ { -15.3, 21 }, { -17, 30 }, { -23, 33 }, { -26, 36 }, { -25, 37 } },
			{ { 15.3, 21 }, { 20, 29 }, { 24, 32 }, { 27, 35 }, { 28, 34 } },
			{ { 24.7, -8 }, { 33, -12 }, { 38, -12 }, { 42, -13 }, { 41, -14 } },
		}
		for _, t in tent do
			L(quad(t[1], t[2], t[3], 3), 0.022)
			C(t[4][1], t[4][2], 4.2)
			C(t[5][1], t[5][2], 1.6, -0.07)
		end
		C(0, 0, 8)
		teeth({ { 0, -8, 0, -3 }, { 5.7, -5.7, 2.1, -2.1 }, { 8, 0, 3, 0 }, { 5.7, 5.7, 2.1, 2.1 }, { 0, 8, 0, 3 }, { -5.7, 5.7, -2.1, 2.1 }, { -8, 0, -3, 0 }, { -5.7, -5.7, -2.1, -2.1 } }, 0.012)
		drool({ { 0, 8, 1, 22 } })
	else
		-- 5 육각: 큰 육각 머리에 크기 다른 육각 혹 4개가 엉겨 붙음(혹마다 눈), 머리보다 넓은 입
		f.tx, f.ty, f.deg = 2, -256, -6
		-- 혹: { x, y, 회전, 육각 반지름, 눈 반지름, 눈동자(0 = 없음) }
		for _, lump in { { -21, -13, 18, 11, 3.4, 1 }, { 17, -19, -10, 9, 2, 0 }, { 23, 3, 25, 6, 1.4, 0 }, { -6, -30, 8, 6, 1.2, 0 } } do
			sub = T(lump[1], lump[2], lump[3])
			L(hexagon(lump[4]), 0.024, true, 0.04)
			C(0, 0, lump[5])
			if lump[6] > 0 then
				C(0, 0, lump[6], -0.07)
			end
			sub = nil
		end
		L(hexagon(16), 0.03, true)
		C(-5, -4, 4.6)
		C(-4, -3, 1.3, -0.07)
		C(7, -6, 1.8)
		L({ { -24, 11 }, { 24, 14 } }, 0.028, false, -0.03)
		L(join(quad({ -24, 11 }, { -14, 40 }, { 2, 42 }, 4), quad({ 2, 42 }, { 18, 40 }, { 24, 14 }, 4)), 0.028, false, -0.03)
		teeth({ { -19, 11, -19, 20 }, { -14, 12, -13, 27 }, { -9, 12, -9, 19 }, { -4, 12, -3, 30 }, { 1, 13, 1, 21 }, { 6, 13, 6, 31 }, { 11, 13, 11, 20 }, { 16, 14, 16, 27 }, { 21, 14, 21, 19 } }, 0.014)
		teeth({ { -10, 38, -10, 30 }, { 0, 41, 0, 32 }, { 10, 39, 10, 31 } }, 0.014)
		drool({ { -2, 42, -3, 56 } })
	end
	return f
end

return Faces
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="133">
        <Properties>
          <string name="Name">SonarGeometry</string>
          <string name="Source"><![CDATA[--!strict
-- 구조물 모양별 윤곽선(모서리) 데이터 생성.
--   Box      : 상자의 12개 모서리 (속성 SonarEdgeAxis = "X"/"Y"/"Z" 이면 그 축 방향 4개만 — 아치 조각, 이어진 난간 등)
--   Wedge    : 쐐기의 9개 모서리
--   Cylinder : 양 끝 원 + (속성 SonarRings 개수만큼) 중간 원 / 보는 위치 기준 실루엣 2줄은 viewEdges 에서
--   Ball     : 보는 위치 기준 실루엣 원(viewEdges)
--   Line     : 가장 긴 축을 따라 선 하나(속성 SonarShape = "Line"). 괴물처럼 가는 막대를 한 획으로 그릴 때
--   Disc     : 원통 가운데 원 하나(속성 SonarShape = "Disc"). 얇은 원판(눈, 둥근 머리)을 한 줄 원으로
--   None     : 선 없음(속성 SonarShape = "None")
-- MeshPart / Union 처럼 정확한 모서리를 얻기 어려운 것은 상자 프록시를 쓴다(SonarShape 속성으로 바꿀 수 있다).
--
-- 결과는 EdgeList 에 쌓는다: A[i]→B[i] 선분, N1[i]/N2[i] 는 그 모서리에 붙은 두 면의 바깥 법선
-- (이음매 제거 판정에 쓰며, 원통의 원처럼 판정이 필요 없는 선은 nil).

local Geo = {}

export type EdgeList = {
	A: { Vector3 },
	B: { Vector3 },
	N1: { Vector3 | false },
	N2: { Vector3 | false },
	n: number,
}

function Geo.newList(): EdgeList
	return { A = {}, B = {}, N1 = {}, N2 = {}, n = 0 }
end

local function push(out: EdgeList, a: Vector3, b: Vector3, n1: Vector3?, n2: Vector3?)
	local i = out.n + 1
	out.n = i
	out.A[i] = a
	out.B[i] = b
	out.N1[i] = n1 or false
	out.N2[i] = n2 or false
end

function Geo.shapeOf(part: BasePart): string
	local forced = part:GetAttribute("SonarShape")
	if type(forced) == "string" then
		return forced
	end
	if part:IsA("WedgePart") then
		return "Wedge"
	end
	if part:IsA("Part") then
		local s = (part :: Part).Shape
		if s == Enum.PartType.Cylinder then
			return "Cylinder"
		elseif s == Enum.PartType.Ball then
			return "Ball"
		elseif s == Enum.PartType.Wedge then
			return "Wedge"
		end
	end
	return "Box"
end

local function ringSegments(r: number): number
	return math.clamp(math.floor(r * 5) + 6, 8, 24)
end

-- 상자 모서리. axisOnly: "X"/"Y"/"Z" 이면 그 축과 평행한 모서리만.
function Geo.boxEdges(cf: CFrame, size: Vector3, out: EdgeList, axisOnly: string?, noNormals: boolean?)
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
	local p = cf.Position
	for _, s1 in { -1, 1 } do
		for _, s2 in { -1, 1 } do
			-- X 방향 모서리 (y = s1, z = s2)
			if axisOnly == nil or axisOnly == "X" then
				local o = p + Y * (s1 * hy) + Z * (s2 * hz)
				if noNormals then
					push(out, o - X * hx, o + X * hx)
				else
					push(out, o - X * hx, o + X * hx, Y * s1, Z * s2)
				end
			end
			-- Y 방향 모서리 (x = s1, z = s2)
			if axisOnly == nil or axisOnly == "Y" then
				local o = p + X * (s1 * hx) + Z * (s2 * hz)
				if noNormals then
					push(out, o - Y * hy, o + Y * hy)
				else
					push(out, o - Y * hy, o + Y * hy, X * s1, Z * s2)
				end
			end
			-- Z 방향 모서리 (x = s1, y = s2)
			if axisOnly == nil or axisOnly == "Z" then
				local o = p + X * (s1 * hx) + Y * (s2 * hy)
				if noNormals then
					push(out, o - Z * hz, o + Z * hz)
				else
					push(out, o - Z * hz, o + Z * hz, X * s1, Y * s2)
				end
			end
		end
	end
end

-- 쐐기: 바닥(-Y) 전체, 뒷면(+Z) 전체 높이, 경사면은 앞(-Z) 아래쪽에서 뒤(+Z) 위쪽으로 올라간다.
function Geo.wedgeEdges(cf: CFrame, size: Vector3, out: EdgeList, noNormals: boolean?)
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
	local p = cf.Position
	local slopeN = (Y * hz - Z * hy).Unit
	local function v(x: number, y: number, z: number): Vector3
		return p + X * x + Y * y + Z * z
	end
	local function e(a: Vector3, b: Vector3, n1: Vector3, n2: Vector3)
		if noNormals then
			push(out, a, b)
		else
			push(out, a, b, n1, n2)
		end
	end
	e(v(-hx, -hy, -hz), v(hx, -hy, -hz), -Y, slopeN) -- 앞 아래
	e(v(-hx, -hy, hz), v(hx, -hy, hz), -Y, Z) -- 뒤 아래
	e(v(-hx, hy, hz), v(hx, hy, hz), Z, slopeN) -- 꼭대기
	for _, s in { -1, 1 } do
		local x = s * hx
		e(v(x, -hy, hz), v(x, hy, hz), X * s, Z) -- 뒤 세로
		e(v(x, -hy, -hz), v(x, -hy, hz), X * s, -Y) -- 옆 아래
		e(v(x, -hy, -hz), v(x, hy, hz), X * s, slopeN) -- 옆 경사
	end
end

local function circle(center: Vector3, u: Vector3, w: Vector3, r: number, segs: number, out: EdgeList)
	local prev = center + u * r
	for i = 1, segs do
		local t = (i / segs) * math.pi * 2
		local cur = center + u * (math.cos(t) * r) + w * (math.sin(t) * r)
		push(out, prev, cur)
		prev = cur
	end
end

-- 원통(축 = 로컬 X): 양 끝 원과 중간 원
function Geo.cylinderRings(cf: CFrame, size: Vector3, out: EdgeList, rings: number?)
	local r = math.min(size.Y, size.Z) / 2
	local hx = size.X / 2
	local thin = r < 0.3
	if thin then
		return -- 가는 원통(난간, 기둥 살)은 실루엣만
	end
	local segs = ringSegments(r)
	local count = (rings or 0)
	for i = 0, count + 1 do
		local x = -hx + (2 * hx) * (i / (count + 1))
		circle(cf.Position + cf.XVector * x, cf.YVector, cf.ZVector, r, segs, out)
	end
end

-- 원통의 실루엣 2줄(보는 위치 기준)
function Geo.cylinderSilhouette(cf: CFrame, size: Vector3, view: Vector3, out: EdgeList)
	local r = math.min(size.Y, size.Z) / 2
	local hx = size.X / 2
	local lv = cf:PointToObjectSpace(view)
	local d = math.sqrt(lv.Y * lv.Y + lv.Z * lv.Z)
	if d <= r * 1.02 then
		return
	end
	local phi0 = math.atan2(lv.Z, lv.Y)
	local theta = math.acos(r / d)
	for _, s in { -1, 1 } do
		local phi = phi0 + s * theta
		local y, z = math.cos(phi) * r, math.sin(phi) * r
		push(out, cf:PointToWorldSpace(Vector3.new(-hx, y, z)), cf:PointToWorldSpace(Vector3.new(hx, y, z)))
	end
	-- 가는 원통은 끝을 짧은 가로선으로 닫는다(난간 끝, 기둥 살 끝)
	if r < 0.3 then
		local a = Vector3.new(0, math.cos(phi0 + theta) * r, math.sin(phi0 + theta) * r)
		local b = Vector3.new(0, math.cos(phi0 - theta) * r, math.sin(phi0 - theta) * r)
		for _, x in { -hx, hx } do
			local o = Vector3.new(x, 0, 0)
			push(out, cf:PointToWorldSpace(o + a), cf:PointToWorldSpace(o + b))
		end
	end
end

-- 구의 실루엣 원(보는 위치 기준)
function Geo.ballSilhouette(cf: CFrame, size: Vector3, view: Vector3, out: EdgeList)
	local r = math.min(size.X, size.Y, size.Z) / 2
	local c = cf.Position
	local toC = c - view
	local D = toC.Magnitude
	if D <= r * 1.05 then
		return
	end
	local dir = toC / D
	local cc = c - dir * (r * r / D)
	local rr = r * math.sqrt(1 - (r * r) / (D * D))
	local u = dir:Cross(Vector3.yAxis)
	if u.Magnitude < 0.01 then
		u = dir:Cross(Vector3.xAxis)
	end
	u = u.Unit
	local w = dir:Cross(u).Unit
	circle(cc, u, w, rr, ringSegments(r), out)
end

-- 보는 위치와 상관없는 모서리(정적 데이터로 미리 만들어 둔다)
function Geo.staticEdges(part: BasePart, out: EdgeList, noNormals: boolean?)
	local shape = Geo.shapeOf(part)
	local cf, size = part.CFrame, part.Size
	if shape == "Box" then
		local axis = part:GetAttribute("SonarEdgeAxis")
		Geo.boxEdges(cf, size, out, if type(axis) == "string" then axis else nil, noNormals)
	elseif shape == "Wedge" then
		Geo.wedgeEdges(cf, size, out, noNormals)
	elseif shape == "Line" then
		local s = size
		local axis = if s.X >= s.Y and s.X >= s.Z then cf.XVector * (s.X / 2) elseif s.Y >= s.Z then cf.YVector * (s.Y / 2) else cf.ZVector * (s.Z / 2)
		push(out, cf.Position - axis, cf.Position + axis)
	elseif shape == "Disc" then
		local r = math.min(size.Y, size.Z) / 2
		circle(cf.Position, cf.YVector, cf.ZVector, r, ringSegments(r), out)
	elseif shape == "Cylinder" then
		local rings = part:GetAttribute("SonarRings")
		Geo.cylinderRings(cf, size, out, if type(rings) == "number" then rings else nil)
	end
end

-- 보는 위치에 따라 달라지는 선(원통·구의 실루엣)
function Geo.viewEdges(part: BasePart, view: Vector3, out: EdgeList)
	local shape = Geo.shapeOf(part)
	if shape == "Cylinder" then
		Geo.cylinderSilhouette(part.CFrame, part.Size, view, out)
	elseif shape == "Ball" then
		Geo.ballSilhouette(part.CFrame, part.Size, view, out)
	end
end

function Geo.hasViewEdges(part: BasePart): boolean
	local shape = Geo.shapeOf(part)
	return shape == "Cylinder" or shape == "Ball"
end

-- 점이 파트 안에 있는가(이음매 제거, 복셀화에 사용)
function Geo.pointInside(part: BasePart, p: Vector3, pad: number?): boolean
	local lp = part.CFrame:PointToObjectSpace(p)
	local s = part.Size
	local m = pad or 0
	local shape = Geo.shapeOf(part)
	if shape == "Cylinder" then
		local r = math.min(s.Y, s.Z) / 2 + m
		return math.abs(lp.X) <= s.X / 2 + m and (lp.Y * lp.Y + lp.Z * lp.Z) <= r * r
	elseif shape == "Ball" then
		local r = math.min(s.X, s.Y, s.Z) / 2 + m
		return lp.Magnitude <= r
	end
	if math.abs(lp.X) > s.X / 2 + m or math.abs(lp.Y) > s.Y / 2 + m or math.abs(lp.Z) > s.Z / 2 + m then
		return false
	end
	if shape == "Wedge" then
		-- 경사면 아래(뒤)쪽만 속이 차 있다
		local hy, hz = s.Y / 2, s.Z / 2
		-- 경사면: (y + hy) * (2hz) <= (z + hz) * (2hy)
		return (lp.Y + hy) * hz <= (lp.Z + hz) * hy + m * math.max(hy, hz) * 1.5
	end
	return true
end

return Geo
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="134">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="135">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="136">
        <Properties>
          <string name="Name">ChapterProps</string>
        </Properties>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">Cinema</string>
            <string name="Source"><![CDATA[--!nonstrict
-- 챕터 10 폐영화관 전용 소품(타일 문자 → 함수). Stage10.luau 의 Props 줄에서 쓴다.
-- MapKit 부품만(검은 무광, 음파 윤곽선). 굵은 윤곽 위주, 막는 소품은 보이지 않는 충돌 상자를 둔다.
--   상영관  q 계단식 좌석 줄   W 스크린·무대   a 통로 발밑등·벽 스피커(지나감)  x 쇠사슬 잠긴 비상구(지나감)  j 무너진 좌석 더미
--   로비    C 매점 카운터      M 팝콘 기계     N 음료 기계    Y 메뉴판(벽, 지나감)   t 높은 원탁   w 소파   y 입간판   d 분리수거대
--   매표소  B 매표 창구        H 상영 시간표(벽, 지나감)      k 무인 발권기          r 줄 기둥(지나감)         g 검표대
--   복도    F 포스터 액자(지나감)  h 상영관 번호판(지나감)  i 비상구 표지(지나감)
--   영사실  J 영사기·영사창    G 필름 되감기 대   e 앰프·전원 랙   R 필름 깡통 선반
--   그 밖   V 세면대·거울      U 화장실 칸     Q 짐수레(하역장)

local Kit = require(script.Parent.Parent.MapKit)

local P = {}

local LINE = { blocks = false, collide = false }
local SOFT = { blocks = false }

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

local function wallSide(ctx, i: number, j: number): Vector3?
	for _, d in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local function model(ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end

local function solid(m: Instance, cf: CFrame, size: Vector3)
	Kit.box(m, cf * CFrame.new(0, size.Y / 2, 0), size, { invisible = true, tag = false })
end

-- 같은 문자가 이어지는 방향(없으면 x)
local function runAxis(ctx, i: number, j: number, ch: string): Vector3
	if ctx.at(i, j - 1) == ch or ctx.at(i, j + 1) == ch then
		return Vector3.new(0, 0, 1)
	end
	return Vector3.new(1, 0, 0)
end

-- 벽을 등진 좌표계: 로컬 -Z = 방 안쪽, +Z = 벽 쪽. prefer 방향이 벽이면 그쪽을 쓴다
local function againstWall(ctx, i: number, j: number, prefer: Vector3?): CFrame
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	if prefer and ctx.isWall(i + prefer.X, j + prefer.Z) then
		side = prefer
	end
	return CFrame.lookAt(p, p - side)
end

local function at(cf: CFrame, x: number, y: number, z: number): Vector3
	return (cf * CFrame.new(x, y, z)).Position
end

-- ── 상영관 ──

-- q 좌석 줄: 한 칸에 의자 3개, 북쪽 스크린을 본다. 스크린에서 멀수록 높은 단(계단식 객석) 위에 놓인다
local STEP = 0.55
function P.Seats(ctx, i: number, j: number)
	local T = ctx.T
	local p = base(ctx, i, j)
	-- 스크린(W)이 북쪽인지 남쪽인지: 좌석 줄을 따라 위아래로 훑어 먼저 만나는 W 쪽을 본다(없으면 북쪽)
	local dz = -1
	for k = 1, 14 do
		if ctx.at(i, j + k) == "W" then
			dz = 1
			break
		elseif ctx.at(i, j - k) == "W" then
			break
		end
	end
	local n = 1 -- 스크린 쪽 벽까지 칸 수
	while n < 20 and not ctx.isWall(i, j + dz * n) do
		n += 1
	end
	local h = math.max(0, n - 4) * STEP
	local m = model(ctx, "TheaterSeats")
	if h > 0.05 then
		Kit.box(m, CFrame.new(p + Vector3.new(0, h / 2, 0)), Vector3.new(T, h, T), { blocks = false, name = "SeatRiser" })
	end
	-- 로컬 -Z = 스크린 쪽. 한 칸 = 긴 의자 한 덩어리(방석 + 등받이) + 팔걸이 선 하나, 줄 끝 칸만 바깥 팔걸이를 더한다(부품 4~5개)
	local cf = CFrame.lookAt(p + Vector3.new(0, h, -dz * 0.8), p + Vector3.new(0, h, -dz * 0.8 + dz))
	Kit.box(m, cf * CFrame.new(0, 1.0, 0.2), Vector3.new(T - 0.3, 2.0, 2.0), SOFT)
	Kit.box(m, cf * CFrame.new(0, 3.0, 1.2) * CFrame.Angles(0.18, 0, 0), Vector3.new(T - 0.3, 2.4, 0.35), SOFT)
	Kit.box(m, cf * CFrame.new(-T / 2 + 0.15, 2.2, 0), Vector3.new(0.3, 0.25, 2.0), LINE)
	-- (줄 끝: 이웃 칸이 좌석이 아니면 그쪽 끝에도 팔걸이. 로컬 +X 가 어느 칸인지는 방향에 따라 바뀌므로 양쪽 다 본다)
	if ctx.at(i + 1, j) ~= "q" or ctx.at(i - 1, j) ~= "q" then
		Kit.box(m, cf * CFrame.new(T / 2 - 0.15, 2.2, 0), Vector3.new(0.3, 0.25, 2.0), LINE)
	end
	solid(m, CFrame.new(p), Vector3.new(T, h + 4, T))
end

-- j 무너진 좌석 더미: 뜯겨 넘어진 의자 줄 두 개
function P.BrokenSeats(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local yaw = (ctx.hash(i, j, 7) - 0.5) * 1.2
	local m = model(ctx, "BrokenSeats")
	for k = 0, 1 do
		local cf = CFrame.new(p + Vector3.new(0, 0.5 + k * 1.5, (k - 0.5) * 2.4)) * CFrame.Angles(0.3 + k * 0.8, yaw + k * 0.7, 0.15)
		Kit.box(m, cf, Vector3.new(6.0, 0.5, 2.0), SOFT)
		Kit.box(m, cf * CFrame.new(0, 1.3, 1.0), Vector3.new(6.0, 2.2, 0.35), SOFT)
		for _, x in { -2.9, -1, 1, 2.9 } do
			Kit.box(m, cf * CFrame.new(x, 0.6, 0), Vector3.new(0.3, 0.25, 2.0), LINE)
		end
	end
	solid(m, CFrame.new(p), Vector3.new(6.6, 3.6, 5.6))
end

-- W 스크린 벽: 벽에 붙은 큰 막(군데군데 찢어짐) + 위아래 테두리 + 낮은 무대, 줄 끝에는 막 옆 커튼
function P.Screen(ctx, i: number, j: number)
	local T = ctx.T
	local cf = againstWall(ctx, i, j, Vector3.new(0, 0, -1))
	local m = model(ctx, "Screen")
	local z = T / 2 - 0.3
	local sh = ctx.H - 4.5
	local cy = 2.5 + sh / 2
	if ctx.hash(i, j, 101) < 0.25 then
		-- 찢어져 늘어진 막: 위쪽 반만 + 아래로 기울어진 조각
		Kit.box(m, cf * CFrame.new(0, cy + sh / 4, z), Vector3.new(T, sh / 2, 0.15), SOFT)
		Kit.box(m, cf * CFrame.new(0, cy - sh / 4, z - 0.8) * CFrame.Angles(0.25, 0, 0.12), Vector3.new(T * 0.7, sh / 2, 0.12), LINE)
	else
		Kit.box(m, cf * CFrame.new(0, cy, z), Vector3.new(T, sh, 0.15), SOFT)
	end
	for _, y in { 2.3, 2.5 + sh + 0.2 } do
		Kit.box(m, cf * CFrame.new(0, y, z - 0.1), Vector3.new(T, 0.5, 0.4), LINE)
	end
	for _, s in { -1, 1 } do
		if ctx.at(i + s, j) ~= "W" then
			-- 막 옆 커튼 주름 셋
			for k = 0, 2 do
				local q = base(ctx, i, j) + Vector3.new(s * (T / 2 - 0.5 - k * 0.9), (ctx.H - 0.6) / 2, -cf.LookVector.Z * (T / 2 - 0.9))
				Kit.box(m, CFrame.new(q) * CFrame.Angles(0, if k % 2 == 0 then 0.5 else -0.5, 0), Vector3.new(1.1, ctx.H - 1.6, 0.25), LINE)
			end
		end
	end
	Kit.box(m, cf * CFrame.new(0, 0.6, 1.0), Vector3.new(T, 1.2, T - 2.0), { name = "Stage" })
end

-- a 통로 발밑등(작은 등 + 바닥 선) + 벽 스피커: 양옆 통로, 지나갈 수 있다
function P.AisleLight(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "AisleLight")
	local z = ctx.T / 2
	Kit.box(m, cf * CFrame.new(0, 0.7, z - 0.2), Vector3.new(1.0, 0.5, 0.3), LINE)
	Kit.box(m, cf * CFrame.new(0, 7.4, z - 1.0) * CFrame.Angles(0.25, 0, 0), Vector3.new(2.0, 2.8, 1.4), LINE)
	Kit.box(m, cf * CFrame.new(0, 7.6, z - 0.2), Vector3.new(0.4, 0.4, 0.6), LINE)
end

-- x 잠긴 비상구: 두 짝 문 + 손잡이 봉에 감긴 쇠사슬·자물쇠 + EXIT 표지(지나갈 수 있는 칸, 문은 안 열린다)
function P.LockedExit(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(0, 0, -1))
	local m = model(ctx, "LockedExit")
	local z = ctx.T / 2
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 1.6, 3.6, z - 0.2), Vector3.new(3.1, 7.2, 0.3), LINE)
		Kit.cylinder(m, at(cf, s * 0.4, 3.4, z - 0.55), at(cf, s * 2.6, 3.4, z - 0.55), 0.14, LINE)
	end
	for k = 0, 2 do -- 쇠사슬(엇갈린 막대 셋)
		Kit.box(m, cf * CFrame.new(0, 3.4 + (k - 1) * 0.5, z - 0.7) * CFrame.Angles(0, 0, if k % 2 == 0 then 0.5 else -0.5), Vector3.new(3.0, 0.16, 0.16), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 2.5, z - 0.8), Vector3.new(0.8, 0.9, 0.3), LINE) -- 자물쇠
	Kit.word(m, "EXIT", at(cf, 0, 8.6, z - 0.3), -cf.RightVector, cf.LookVector, 1.4)
end

-- i 비상구 표지: 열리는 비상문 앞 천장에 매달린 표지판
function P.ExitSign(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "ExitSign")
	local y = ctx.H - 1.9
	Kit.box(m, CFrame.new(p + Vector3.new(0, y, 0)), Vector3.new(5.0, 1.8, 0.2), LINE)
	for _, x in { -1.8, 1.8 } do
		Kit.cylinder(m, p + Vector3.new(x, y + 0.9, 0), p + Vector3.new(x, ctx.H, 0), 0.08, LINE)
	end
	Kit.word(m, "EXIT", p + Vector3.new(0, y, 0.1), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1), 1.2)
end

-- ── 매점 ──

-- (길이 방향 +X 를 보는 좌표계에서 로컬 +X = 남쪽 = 손님 쪽)
-- C 카운터(매점·라운지 바): 몸통 + 상판 + 유리 진열 가림막, 군데군데 금전 등록기
function P.Counter(ctx, i: number, j: number)
	local T = ctx.T
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "C")
	local cf = CFrame.lookAt(p, p + axis) -- 로컬 Z = 카운터 길이 방향
	local m = model(ctx, "Counter")
	Kit.box(m, cf * CFrame.new(0, 1.7, 0), Vector3.new(3.0, 3.4, T), { name = "CounterBody" })
	Kit.box(m, cf * CFrame.new(0, 3.5, 0), Vector3.new(3.6, 0.25, T), SOFT)
	Kit.box(m, cf * CFrame.new(0, 4.5, 0), Vector3.new(0.1, 1.6, T - 0.4), LINE)
	local r = ctx.hash(i, j, 103)
	if r < 0.3 then
		Kit.box(m, cf * CFrame.new(-0.9, 4.0, 1.2), Vector3.new(1.2, 0.8, 1.4), LINE) -- 금전 등록기
	elseif r > 0.75 then
		Kit.cylinder(m, at(cf, -0.9, 3.6, -1.4), at(cf, -0.9, 5.0, -1.4), 0.6, LINE) -- 남은 팝콘 통
	end
end

-- M 팝콘 기계(벽 쪽): 아래 수납장 + 유리 상자(네 기둥) + 안쪽 솥 + 위 간판
function P.Popcorn(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(0, 0, -1)) * CFrame.new(0, 0, ctx.T / 2 - 1.8)
	local m = model(ctx, "Popcorn")
	Kit.box(m, cf * CFrame.new(0, 1.8, 0), Vector3.new(4.0, 3.6, 3.0), { name = "PopcornBase" })
	for _, a in { -1.8, 1.8 } do
		for _, b in { -1.3, 1.3 } do
			Kit.box(m, cf * CFrame.new(a, 5.4, b), Vector3.new(0.2, 3.6, 0.2), LINE)
		end
	end
	Kit.box(m, cf * CFrame.new(0, 7.4, 0), Vector3.new(4.0, 0.4, 3.0), SOFT)
	Kit.cylinder(m, at(cf, 0, 5.8, 0), at(cf, 0, 6.8, 0), 0.9, LINE)
	Kit.cylinder(m, at(cf, 0, 6.8, 0), at(cf, 0, 7.2, 0), 0.12, LINE)
	Kit.box(m, cf * CFrame.new(0, 3.8, 0), Vector3.new(3.4, 0.3, 2.4), LINE) -- 남은 팝콘
	Kit.box(m, cf * CFrame.new(0, 8.3, 0), Vector3.new(3.6, 1.4, 0.25), LINE)
	solid(m, cf, Vector3.new(4.0, 7.6, 3.0))
end

-- N 음료 기계(벽 쪽): 몸통 + 앞으로 나온 머리 + 꼭지 넷 + 컵 탑
function P.Drink(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(0, 0, -1)) * CFrame.new(0, 0, ctx.T / 2 - 1.8)
	local m = model(ctx, "DrinkMachine")
	Kit.box(m, cf * CFrame.new(0, 1.6, 0), Vector3.new(5.0, 3.2, 3.0), { name = "DrinkBase" })
	Kit.box(m, cf * CFrame.new(0, 5.2, 0.8), Vector3.new(4.4, 4.0, 1.2), SOFT)
	Kit.box(m, cf * CFrame.new(0, 6.6, -0.3), Vector3.new(4.4, 1.6, 2.2), SOFT)
	for k = 0, 3 do
		local x = -1.5 + k
		Kit.cylinder(m, at(cf, x, 5.8, -0.9), at(cf, x, 5.1, -0.9), 0.15, LINE)
	end
	Kit.cylinder(m, at(cf, 1.9, 3.2, -0.8), at(cf, 1.9, 4.8, -0.8), 0.35, LINE)
	solid(m, cf, Vector3.new(5.0, 7.4, 3.0))
end

-- Y 메뉴판(벽 높이 달린 판 + 글줄): 지나갈 수 있다
function P.MenuBoard(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(0, 0, -1))
	local m = model(ctx, "MenuBoard")
	local z = ctx.T / 2
	Kit.box(m, cf * CFrame.new(0, 7.6, z - 0.4) * CFrame.Angles(0.12, 0, 0), Vector3.new(7.0, 3.0, 0.25), LINE)
	for k = -1, 1 do
		Kit.box(m, cf * CFrame.new(-0.6 + k * 0.4, 7.6 + k * 0.8, z - 0.65), Vector3.new(4.2, 0.18, 0.1), LINE)
	end
end

-- t 높은 원탁(서서 먹는 탁자): 기둥 + 둥근 판 + 남은 컵
function P.HighTable(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "HighTable")
	Kit.cylinder(m, p, p + Vector3.new(0, 0.2, 0), 1.2, LINE)
	Kit.cylinder(m, p, p + Vector3.new(0, 3.8, 0), 0.25, LINE)
	Kit.cylinder(m, p + Vector3.new(0, 3.8, 0), p + Vector3.new(0, 4.05, 0), 2.0, SOFT)
	local c = p + Vector3.new((ctx.hash(i, j, 31) - 0.5) * 2, 4.05, 0.6)
	Kit.cylinder(m, c, c + Vector3.new(0, 1.1, 0), 0.4, LINE)
	solid(m, CFrame.new(p), Vector3.new(3.4, 4.2, 3.4))
end

-- w 소파(대기 의자): 앉는 판 + 등받이 + 팔걸이. 남쪽을 본다
function P.Sofa(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + Vector3.new(0, 0, 1)) -- 로컬 -Z = 앞(남쪽)
	local m = model(ctx, "Sofa")
	local T = ctx.T
	Kit.box(m, cf * CFrame.new(0, 1.0, 0), Vector3.new(T - 0.4, 2.0, 3.4), SOFT)
	Kit.box(m, cf * CFrame.new(0, 2.6, 1.5) * CFrame.Angles(0.12, 0, 0), Vector3.new(T - 0.4, 2.4, 0.8), SOFT)
	for _, s in { -1, 1 } do
		if ctx.at(i - s, j) ~= "w" then -- (로컬 x 는 남쪽을 보므로 격자 i 와 반대)
			Kit.box(m, cf * CFrame.new(s * (T / 2 - 0.5), 1.5, 0), Vector3.new(0.7, 3.0, 3.4), SOFT)
		end
	end
	solid(m, cf, Vector3.new(T - 0.4, 3.2, 3.8))
end

-- y 입간판(등신대): 사람 모양 판 + 받침. 어둠 속에서 사람처럼 보인다
function P.Standee(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, (ctx.hash(i, j, 41) - 0.5) * 0.8, 0)
	local m = model(ctx, "Standee")
	Kit.box(m, cf * CFrame.new(0, 0.2, 0), Vector3.new(4.2, 0.4, 2.0), LINE)
	Kit.box(m, cf * CFrame.new(0, 2.4, 0), Vector3.new(1.8, 4.2, 0.2), SOFT) -- 몸 아래
	Kit.box(m, cf * CFrame.new(0, 5.4, 0), Vector3.new(3.0, 2.2, 0.2), SOFT) -- 어깨
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 1.9, 4.6, 0) * CFrame.Angles(0, 0, s * 0.25), Vector3.new(0.6, 3.6, 0.2), LINE)
	end
	Kit.ball(m, at(cf, 0, 7.3, 0), 0.9, SOFT) -- 머리
	Kit.box(m, cf * CFrame.new(0, 2.0, 0.8) * CFrame.Angles(-0.35, 0, 0), Vector3.new(0.4, 4.2, 0.15), LINE) -- 뒤 버팀대
	solid(m, cf, Vector3.new(3.6, 7.6, 2.0))
end

-- d 분리수거대: 구멍 둘 난 통 + 윗선반에 쌓인 쟁반
function P.BinStation(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j) * CFrame.new(0, 0, ctx.T / 2 - 1.6)
	local m = model(ctx, "BinStation")
	Kit.box(m, cf * CFrame.new(0, 2.0, 0), Vector3.new(5.6, 4.0, 2.6), SOFT)
	for _, x in { -1.4, 1.4 } do
		Kit.box(m, cf * CFrame.new(x, 2.9, -1.33), Vector3.new(1.8, 1.0, 0.1), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 4.4, 0.3), Vector3.new(2.6, 0.7, 1.6), LINE)
	solid(m, cf, Vector3.new(5.6, 4.2, 2.6))
end

-- ── 매표소 ──

-- B 매표 창구: 카운터 + 유리 칸막이 틀 + 말구멍 + 화면. 한 칸이 창구 하나
function P.TicketWindow(ctx, i: number, j: number)
	local T = ctx.T
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "B")
	local cf = CFrame.lookAt(p, p + axis)
	local m = model(ctx, "TicketWindow")
	Kit.box(m, cf * CFrame.new(0, 1.8, 0), Vector3.new(2.8, 3.6, T), { name = "TicketCounter" })
	Kit.box(m, cf * CFrame.new(0, 3.7, 0), Vector3.new(3.4, 0.25, T), SOFT)
	for _, z in { -T / 2 + 0.15, T / 2 - 0.15 } do
		if z > 0 or ctx.at(i + axis.X, j + axis.Z) ~= "B" then
			Kit.box(m, cf * CFrame.new(0, 5.9, z), Vector3.new(0.3, 4.2, 0.3), LINE)
		end
	end
	Kit.box(m, cf * CFrame.new(0, 8.1, 0), Vector3.new(0.4, 0.5, T), LINE) -- 윗보
	Kit.box(m, cf * CFrame.new(0, 4.9, 0), Vector3.new(0.1, 0.12, T - 0.6), LINE) -- 유리 아래 테
	Kit.box(m, cf * CFrame.new(0, 5.6, 1.6) * CFrame.Angles(0, 0.2, 0), Vector3.new(0.3, 1.5, 2.0), LINE) -- 발권 화면
	solid(m, cf, Vector3.new(3.0, 8.2, T))
end

-- H 상영 시간표(벽 위 큰 판 + 줄): 지나갈 수 있다
function P.Showtimes(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(0, 0, -1))
	local m = model(ctx, "Showtimes")
	local z = ctx.T / 2
	Kit.box(m, cf * CFrame.new(0, 7.2, z - 0.3), Vector3.new(7.6, 4.2, 0.25), LINE)
	for k = 0, 3 do
		Kit.box(m, cf * CFrame.new((ctx.hash(i, j, 60 + k) - 0.5), 5.9 + k * 0.85, z - 0.5), Vector3.new(5.6, 0.16, 0.1), LINE)
	end
end

-- k 무인 발권기: 기둥 몸통 + 기울어진 화면 + 표 나오는 구멍
function P.Kiosk(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(1, 0, 0)) * CFrame.new(0, 0, ctx.T / 2 - 1.6)
	local m = model(ctx, "Kiosk")
	Kit.box(m, cf * CFrame.new(0, 2.0, 0), Vector3.new(2.8, 4.0, 2.2))
	Kit.box(m, cf * CFrame.new(0, 5.2, -0.2) * CFrame.Angles(0.25, 0, 0), Vector3.new(3.0, 2.8, 0.5), SOFT)
	Kit.box(m, cf * CFrame.new(0, 2.8, -1.15), Vector3.new(1.4, 0.3, 0.1), LINE)
	Kit.box(m, cf * CFrame.new(0, 7.2, 0), Vector3.new(2.8, 0.9, 0.4), LINE)
	solid(m, cf, Vector3.new(3.0, 6.6, 2.2))
end

-- r 줄 세우기 기둥(벨트로 이어짐): 지나갈 수 있다(충돌 없음)
function P.Stanchion(ctx, i: number, j: number)
	local T = ctx.T
	local m = model(ctx, "Stanchion")
	local a = base(ctx, i, j) + Vector3.new(-T / 2 + 0.5, 0, 0)
	local b = a + Vector3.new(T - 1, 0, 0)
	local function post(q: Vector3)
		Kit.cylinder(m, q, q + Vector3.new(0, 3.2, 0), 0.15, LINE)
		Kit.cylinder(m, q, q + Vector3.new(0, 0.2, 0), 0.6, LINE)
	end
	post(a)
	if ctx.at(i + 1, j) ~= "r" then
		post(b)
	end
	if ctx.hash(i, j, 107) < 0.8 then
		local sag = if ctx.hash(i, j, 108) < 0.3 then 1.6 else 0.2
		Kit.box(m, CFrame.new((a + b) / 2 + Vector3.new(0, 2.9 - sag, 0)), Vector3.new(T - 1, 0.25, 0.1), LINE)
	end
end

-- g 검표대: 작은 연단 + 기울어진 윗판
function P.TicketStand(ctx, i: number, j: number)
	local cf = CFrame.new(base(ctx, i, j))
	local m = model(ctx, "TicketStand")
	Kit.box(m, cf * CFrame.new(0, 1.9, 0), Vector3.new(2.6, 3.8, 2.0), { name = "TicketStandBody" })
	Kit.box(m, cf * CFrame.new(0, 4.0, 0) * CFrame.Angles(0.3, 0, 0), Vector3.new(3.0, 0.2, 2.4), LINE)
	Kit.box(m, cf * CFrame.new(2.4, 0.2, 1.5) * CFrame.Angles(0, 0.5, 0), Vector3.new(2.2, 0.3, 3.0), LINE) -- 넘어진 안내판
end

-- ── 복도 ──

-- F 포스터 액자(벽에 걸린 라이트박스): 지나갈 수 있다
function P.Poster(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j) * CFrame.new(0, 5.2, ctx.T / 2 - 0.25) * CFrame.Angles(0, 0, (ctx.hash(i, j, 105) - 0.5) * 0.12)
	local m = model(ctx, "PosterFrame")
	Kit.box(m, cf, Vector3.new(3.6, 5.2, 0.35), LINE)
	Kit.box(m, cf * CFrame.new(0, 0, -0.2), Vector3.new(3.0, 4.6, 0.08), LINE)
end

-- h 상영관 번호판: 벽에서 튀어나온 네모 판 + 굵은 숫자(막대 획). 열 위치로 1~4관을 정한다
local SEG = { -- 위, 가운데, 아래, 왼위, 왼아래, 오른위, 오른아래
	{ false, false, false, false, false, true, true },
	{ true, true, true, false, true, true, false },
	{ true, true, true, false, false, true, true },
	{ false, true, false, true, false, true, true },
	{ true, true, true, true, false, false, true },
}
function P.HallSign(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(0, 0, -1)) * CFrame.new(0, 6.6, ctx.T / 2 - 0.5)
	local m = model(ctx, "HallSign")
	Kit.box(m, cf, Vector3.new(3.6, 4.6, 0.5), LINE)
	-- 상영관 복도(1층 y19~22): 북쪽 벽 = 2·3·4관(x6~16 / 18~28 / 30~40), 남쪽 벽 = 1관(서)·5관(동). i·j 는 1부터
	local x, y = i - 1, j - 1
	local n
	if y >= 21 then
		n = if x <= 14 then 1 else 5
	else
		n = if x <= 16 then 2 elseif x <= 28 then 3 else 4
	end
	local s = SEG[n]
	-- (로컬 -Z 쪽에서 보면 로컬 +X 가 왼쪽)
	local bars = {
		{ 0, 1.5, true }, { 0, 0, true }, { 0, -1.5, true },
		{ 0.8, 0.75, false }, { 0.8, -0.75, false }, { -0.8, 0.75, false }, { -0.8, -0.75, false },
	}
	for k, b in bars do
		if s[k] then
			Kit.box(m, cf * CFrame.new(b[1], b[2], -0.35), if b[3] then Vector3.new(1.6, 0.35, 0.2) else Vector3.new(0.35, 1.6, 0.2), LINE)
		end
	end
end

-- ── 영사실 ──

-- J 영사기: 받침대 + 몸체 + 렌즈(북쪽 영사창) + 필름 릴 두 개 + 영사창 틀
function P.Projector(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	-- 로컬 -Z = 영사창(상영관 쪽 벽): 북쪽 벽이 있으면 북쪽, 아니면 남쪽(1관·5관 영사실은 남쪽 상영관을 본다)
	local dz = if ctx.isWall(i, j - 1) or not ctx.isWall(i, j + 1) then -1 else 1
	local cf = CFrame.lookAt(p, p + Vector3.new(0, 0, dz))
	local m = model(ctx, "Projector")
	Kit.box(m, cf * CFrame.new(0, 1.6, 0), Vector3.new(2.4, 3.2, 3.0), { name = "ProjectorStand" })
	Kit.box(m, cf * CFrame.new(0, 4.4, 0), Vector3.new(1.8, 2.4, 3.6))
	Kit.cylinder(m, at(cf, 0, 4.4, -1.8), at(cf, 0, 4.4, -3.2), 0.45, { blocks = false, collide = false, rings = 1 })
	for _, z in { -1.2, 1.0 } do
		Kit.cylinder(m, at(cf, -0.15, 7.0, z), at(cf, 0.15, 7.0, z), 1.3, { blocks = false, collide = false, rings = 1 })
	end
	Kit.box(m, cf * CFrame.new(0, 4.6, -ctx.T / 2 + 0.1), Vector3.new(2.4, 1.6, 0.3), LINE)
	solid(m, cf, Vector3.new(2.6, 6, 3.8))
end

-- G 필름 되감기 대: 작업대 + 양끝에 선 릴 둘 + 사이를 잇는 필름 선
function P.RewindBench(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j) * CFrame.new(0, 0, ctx.T / 2 - 1.6)
	local m = model(ctx, "RewindBench")
	Kit.box(m, cf * CFrame.new(0, 3.0, 0), Vector3.new(6.6, 0.3, 2.6), SOFT)
	for _, x in { -3.0, 3.0 } do
		Kit.box(m, cf * CFrame.new(x, 1.5, 0), Vector3.new(0.3, 3.0, 2.2), LINE)
		Kit.cylinder(m, at(cf, x * 0.7, 4.6, 0.15), at(cf, x * 0.7, 4.6, -0.15), 1.3, { blocks = false, collide = false, rings = 1 })
		Kit.box(m, cf * CFrame.new(x * 0.7, 3.8, 0.4), Vector3.new(0.3, 1.6, 0.3), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 3.5, 0), Vector3.new(4.2, 0.1, 0.1), LINE)
	solid(m, cf, Vector3.new(6.6, 3.6, 2.6))
end

-- e 앰프·전원 랙: 키 큰 장 + 칸 나눔 + 손잡이
function P.AmpRack(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j) * CFrame.new(0, 0, ctx.T / 2 - 1.5)
	local m = model(ctx, "AmpRack")
	Kit.box(m, cf * CFrame.new(0, 3.6, 0), Vector3.new(3.4, 7.2, 2.4))
	for k = 1, 4 do
		Kit.box(m, cf * CFrame.new(0, k * 1.4, -1.25), Vector3.new(3.2, 0.1, 0.1), LINE)
	end
	for _, x in { -1.0, 1.0 } do
		Kit.cylinder(m, at(cf, x, 6.4, -1.2), at(cf, x, 6.4, -1.5), 0.35, LINE) -- 계기
	end
end

-- R 필름 깡통 선반: 기둥 틀 + 선반 셋 + 세워 둔 둥근 필름통
function P.FilmRack(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j) * CFrame.new(0, 0, ctx.T / 2 - 1.4)
	local m = model(ctx, "FilmRack")
	for _, x in { -3.2, 3.2 } do
		Kit.box(m, cf * CFrame.new(x, 3.6, 0), Vector3.new(0.25, 7.2, 2.2), SOFT)
	end
	for k = 0, 2 do
		local y = 0.6 + k * 2.5
		Kit.box(m, cf * CFrame.new(0, y, 0), Vector3.new(6.4, 0.2, 2.2), LINE)
		local x = (ctx.hash(i, j, 70 + k) - 0.5) * 3.6
		for s = 0, 1 do
			Kit.cylinder(m, at(cf, x + s * 0.7, y + 1.1, 0), at(cf, x + s * 0.7 + 0.4, y + 1.1, 0), 1.0, LINE)
		end
	end
	solid(m, cf, Vector3.new(6.6, 7.2, 2.2))
end

-- ── 화장실·하역장 ──

-- V 세면대 + 거울
function P.Sink(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local T = ctx.T
	local m = model(ctx, "Sink")
	local z = T / 2 - 1.2
	Kit.box(m, cf * CFrame.new(0, 2.9, z), Vector3.new(T - 0.5, 0.6, 2.2), SOFT)
	for _, x in { -1.8, 1.8 } do
		Kit.box(m, cf * CFrame.new(x, 3.22, z), Vector3.new(1.8, 0.05, 1.2), LINE)
		Kit.cylinder(m, at(cf, x, 3.2, z + 0.7), at(cf, x, 4.1, z + 0.4), 0.12, LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 1.3, z), Vector3.new(T - 1.5, 2.6, 1.6), LINE)
	Kit.box(m, cf * CFrame.new(0, 6.0, T / 2 - 0.2), Vector3.new(T - 1.0, 3.0, 0.1), LINE)
	solid(m, cf * CFrame.new(0, 0, z), Vector3.new(T - 0.5, 3.4, 2.2))
end

-- U 화장실 칸: 옆 칸막이 + 반쯤 열린 문 + 변기
function P.ToiletStall(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(0, 0, 1))
	local m = model(ctx, "ToiletStall")
	local h = 6.6
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 3.2, h / 2 + 0.6, 1.4), Vector3.new(0.15, h, 5.0), SOFT)
	end
	Kit.box(m, cf * CFrame.new(-2.0, h / 2 + 0.6, -1.1) * CFrame.Angles(0, 0.5, 0), Vector3.new(2.4, h, 0.15), SOFT)
	Kit.box(m, cf * CFrame.new(2.3, h / 2 + 0.6, -1.1), Vector3.new(1.7, h, 0.15), SOFT)
	Kit.cylinder(m, at(cf, 0, 0, 1.6), at(cf, 0, 1.6, 1.6), 0.8, SOFT)
	Kit.cylinder(m, at(cf, 0, 1.6, 1.4), at(cf, 0, 1.85, 1.4), 1.0, LINE)
	Kit.box(m, cf * CFrame.new(0, 2.6, 3.1), Vector3.new(1.8, 1.8, 0.9), SOFT)
	solid(m, cf * CFrame.new(0, 0, 1.4), Vector3.new(6.6, 7, 5.2))
end

-- Q 짐수레(하역장): 바닥판 + 손잡이 틀 + 필름 상자 둘
function P.HandCart(ctx, i: number, j: number)
	local cf = CFrame.new(base(ctx, i, j)) * CFrame.Angles(0, (ctx.hash(i, j, 81) - 0.5) * 1.2, 0)
	local m = model(ctx, "HandCart")
	Kit.box(m, cf * CFrame.new(0, 0.9, 0), Vector3.new(3.4, 0.3, 5.4), SOFT)
	for _, x in { -1.5, 1.5 } do
		Kit.cylinder(m, at(cf, x, 1.0, 2.6), at(cf, x, 4.4, 3.0), 0.12, LINE)
		for _, z in { -2.0, 2.0 } do
			Kit.cylinder(m, at(cf, x - 0.1, 0.4, z), at(cf, x + 0.1, 0.4, z), 0.4, LINE)
		end
	end
	Kit.cylinder(m, at(cf, -1.5, 4.4, 3.0), at(cf, 1.5, 4.4, 3.0), 0.12, LINE)
	Kit.box(m, cf * CFrame.new(0.2, 1.9, -1.0) * CFrame.Angles(0, 0.1, 0), Vector3.new(2.6, 1.8, 2.4), SOFT)
	Kit.box(m, cf * CFrame.new(-0.1, 3.4, -0.9) * CFrame.Angles(0, -0.2, 0), Vector3.new(2.0, 1.2, 2.0), SOFT)
	solid(m, cf, Vector3.new(3.6, 4, 6))
end

return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">Facility</string>
            <string name="Source"><![CDATA[--!strict
-- 챕터 1 지하 시설 전용 소품(타일 문자 → 함수). Stage1.luau 의 Props 줄에서 쓴다.
-- 각 함수는 StageBuilder 의 ctx 와 타일 좌표(i, j)를 받는다. MapKit 부품만 쓰고(검은 무광, 음파 윤곽선),
-- 굵은 윤곽 위주로 부품 수를 적게(소품 하나 25개 이하) 한다. 막는 소품은 보이지 않는 충돌 상자를 둔다.
--   k 통제 콘솔(모니터 3대 + 경사 조작판 + 의자)      W 상황판(벽에 붙은 대형 화면, 지나갈 수 있음)
--   F 서류 캐비닛 줄(4단 서랍, 앞뒤 양면)              G 비상 발전기(2x2 머리 칸) / g 발전기 나머지 칸
--   P 배전반(고압 차단기 함 + 경고 삼각형)            U 냉각 배관 선반(굵은 배관 3단 + 받침)
--   j 정비 작업대(바이스·공구판)                       Y 공조기(큰 송풍기 둥근 얼굴 + 덕트, 2칸 머리) / y 나머지 칸
--   h 바닥 경고 줄무늬(지나갈 수 있음)
--   x 벽 소화전 함(벽에 붙은 얕은 함 + 호스 릴 + 위 비상등, 지나갈 수 있음 — 정비 통로 대피 칸 표시)

local Kit = require(script.Parent.Parent.MapKit)

local Facility = {}

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

local function wallSide(ctx, i: number, j: number): Vector3?
	for _, d in { { 0, -1 }, { 1, 0 }, { -1, 0 }, { 0, 1 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local function model(ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end

-- 막는 소품의 보이지 않는 충돌(타일 안)
local function solid(m: Instance, p: Vector3, size: Vector3)
	Kit.box(m, CFrame.new(p + Vector3.new(0, size.Y / 2, 0)), size, { invisible = true, tag = false })
end

-- 이 칸 둘레에서 같은 문자가 이어지는 축(가로면 x, 세로면 z)
local function runAxis(ctx, i: number, j: number, ch: string): Vector3
	if ctx.at(i, j - 1) == ch or ctx.at(i, j + 1) == ch then
		return Vector3.new(0, 0, 1)
	end
	return Vector3.new(1, 0, 0)
end

-- k 통제 콘솔: 조작원은 남쪽에 앉아 북쪽(상황판 쪽)을 본다
function Facility.Console(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Console")
	local fwd = Vector3.new(0, 0, -1) -- 화면 쪽
	local cf = CFrame.lookAt(p, p + fwd)
	-- 받침 몸통 + 경사 조작판
	Kit.box(m, cf * CFrame.new(0, 1.4, -0.6), Vector3.new(6.4, 2.8, 2.6))
	Kit.wedge(m, cf * CFrame.new(0, 3.15, 0.2) * CFrame.Angles(0, math.pi, 0), Vector3.new(6.4, 0.7, 1.4), { blocks = false })
	-- 모니터 3대(가운데 정면, 양옆 살짝 안으로)
	for k = -1, 1 do
		local mc = cf * CFrame.new(k * 2.1, 4.6, -1.3) * CFrame.Angles(0, -k * 0.25, 0)
		Kit.box(m, mc, Vector3.new(1.9, 1.3, 0.2), { blocks = false })
		Kit.box(m, mc * CFrame.new(0, -0.95, 0.1), Vector3.new(0.25, 0.7, 0.25), { blocks = false, collide = false })
	end
	-- 의자(바퀴 기둥 + 좌판 + 등판)
	local ch = cf * CFrame.new(0.4, 0, 2.3)
	Kit.cylinder(m, (ch * CFrame.new(0, 0.2, 0)).Position, (ch * CFrame.new(0, 1.7, 0)).Position, 0.15, { blocks = false })
	Kit.box(m, ch * CFrame.new(0, 0.12, 0), Vector3.new(1.8, 0.2, 1.8), { blocks = false, collide = false })
	Kit.box(m, ch * CFrame.new(0, 1.85, 0), Vector3.new(1.7, 0.25, 1.7), { blocks = false })
	Kit.box(m, ch * CFrame.new(0, 3.0, 0.8), Vector3.new(1.7, 2.0, 0.2), { blocks = false })
	solid(m, p, Vector3.new(6.6, 3.2, 6.6))
end

-- W 상황판: 북쪽 벽(가장 가까운 벽)에 붙은 3x2 화면 + 테두리. 낮은 곳이 비어 있어 칸은 지나갈 수 있다
function Facility.VideoWall(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local across = Vector3.new(side.Z, 0, -side.X)
	local m = model(ctx, "VideoWall")
	local c = p + side * (ctx.T / 2 - 0.3) + Vector3.new(0, 7.2, 0)
	local cf = CFrame.lookAt(c, c - side)
	Kit.box(m, cf, Vector3.new(7.6, 4.6, 0.3), { collide = false, blocks = false })
	for a = -1, 1 do
		for b = -1, 1, 2 do
			Kit.box(m, cf * CFrame.new(a * 2.45, b * 1.1, -0.25), Vector3.new(2.3, 2.1, 0.2), { collide = false, blocks = false })
		end
	end
	-- 천장에서 내려온 받침 두 줄
	for _, s in { -1, 1 } do
		local t = c + across * (s * 3.2) + Vector3.new(0, 2.3, 0)
		Kit.cylinder(m, t, t + Vector3.new(0, math.max(0.5, ctx.H - 9.5), 0), 0.12, { collide = false, blocks = false })
	end
end

-- F 서류 캐비닛 줄: 이어진 방향으로 길게, 양면 4단 서랍
function Facility.FileCabinet(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "F")
	local m = model(ctx, "FileCabinet")
	local len, h = ctx.T - 0.2, 6
	local cf = CFrame.lookAt(p + Vector3.new(0, h / 2, 0), p + Vector3.new(0, h / 2, 0) + axis)
	Kit.box(m, cf, Vector3.new(3.0, h, len))
	-- 서랍 줄(양면, 4단) + 칸 나눔
	for _, s in { -1, 1 } do
		for k = 1, 3 do
			Kit.box(m, cf * CFrame.new(s * 1.55, -h / 2 + k * h / 4, 0), Vector3.new(0.08, 0.1, len - 0.3), { blocks = false, collide = false })
		end
		Kit.box(m, cf * CFrame.new(s * 1.55, 0, 0), Vector3.new(0.08, h - 0.4, 0.12), { blocks = false, collide = false })
	end
	-- 위에 쌓인 상자 하나(칸마다 다르게)
	if ctx.hash(i, j, 11) > 0.5 then
		Kit.crate(m, p + Vector3.new(0, h, 0) + axis * ((ctx.hash(i, j, 12) - 0.5) * 3), Vector3.new(2.2, 1.4, 2.6), ctx.hash(i, j, 13) * 0.6)
	end
end

-- G 비상 발전기(2x2 칸, 이 칸이 왼쪽 위): 받침 스키드, 엔진 몸통, 방열기, 배기 굴뚝, 제어함
function Facility.Generator(ctx, i: number, j: number)
	local p = (base(ctx, i, j) + base(ctx, i + 1, j + 1)) / 2
	local m = model(ctx, "Generator")
	local T = ctx.T
	Kit.box(m, CFrame.new(p + Vector3.new(0, 0.5, 0)), Vector3.new(2 * T - 1.6, 1.0, 2 * T - 4.5), { name = "Skid" })
	Kit.box(m, CFrame.new(p + Vector3.new(-1.0, 3.6, 0)), Vector3.new(8.5, 5.2, 7.0), { name = "Engine" })
	-- 엔진 위 실린더 머리 줄
	for k = -1, 1 do
		Kit.box(m, CFrame.new(p + Vector3.new(-1.0 + k * 2.6, 6.6, 0)), Vector3.new(1.8, 0.8, 5.6), { blocks = false })
	end
	-- 방열기(한쪽 끝, 격자 무늬)
	local r = p + Vector3.new(5.0, 3.8, 0)
	Kit.box(m, CFrame.new(r), Vector3.new(1.6, 6.4, 7.6), { name = "Radiator" })
	for k = -2, 2 do
		Kit.box(m, CFrame.new(r + Vector3.new(0.85, k * 1.2, 0)), Vector3.new(0.1, 0.15, 7.0), { blocks = false, collide = false })
	end
	-- 배기 굴뚝(천장까지)
	local ex = p + Vector3.new(-4.0, 6.2, 2.0)
	Kit.cylinder(m, ex, ex + Vector3.new(0, 1.4, 0), 0.9, { blocks = false })
	Kit.pipe(m, ex + Vector3.new(0, 1.4, 0), Vector3.new(ex.X, ctx.H, ex.Z), 0.6, { 0.1, 0.9 }, false)
	-- 제어함 + 굵은 전선
	local cb = p + Vector3.new(-1.0, 3.0, -4.3)
	Kit.box(m, CFrame.new(cb), Vector3.new(2.6, 3.0, 0.9), { blocks = false })
	Kit.cylinder(m, cb + Vector3.new(1.0, -1.5, 0), p + Vector3.new(3.2, 0.3, -6.5), 0.22, { blocks = false, collide = false })
	solid(m, p, Vector3.new(2 * T - 1.2, 7.5, 2 * T - 1.2))
end

-- g 발전기 나머지 칸(G 가 다 짓는다)
function Facility.Filler(_ctx, _i: number, _j: number) end

-- P 배전반: 벽에 등을 댄 차단기 함 3칸, 손잡이, 경고 삼각형, 천장으로 올라가는 전선관
function Facility.Switchgear(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local across = Vector3.new(side.Z, 0, -side.X)
	local m = model(ctx, "Switchgear")
	local c = p + side * (ctx.T / 2 - 1.3) + Vector3.new(0, 3.6, 0)
	local cf = CFrame.lookAt(c, c - side)
	Kit.box(m, cf, Vector3.new(7.4, 7.2, 2.4))
	for k = -1, 1 do
		-- 문 테두리 + 손잡이
		Kit.box(m, cf * CFrame.new(k * 2.45, 0, -1.25), Vector3.new(2.2, 6.6, 0.1), { blocks = false, collide = false })
		Kit.box(m, cf * CFrame.new(k * 2.45 + 0.8, 0.2, -1.4), Vector3.new(0.15, 1.0, 0.2), { blocks = false, collide = false })
	end
	-- 경고 삼각형(가운데 문 위쪽)
	local t = cf * CFrame.new(0, 2.4, -1.35)
	for _, a in { 0, 2 * math.pi / 3, 4 * math.pi / 3 } do
		Kit.box(m, t * CFrame.Angles(0, 0, a) * CFrame.new(0, -0.3, 0), Vector3.new(1.05, 0.14, 0.08), { blocks = false, collide = false })
	end
	-- 전선관(천장으로)
	for _, s in { -1, 1 } do
		local a = c + across * (s * 2.5) + Vector3.new(0, 3.6, 0) + side * 0.4
		Kit.cylinder(m, a, Vector3.new(a.X, ctx.H, a.Z), 0.3, { blocks = false, collide = false })
	end
	solid(m, p + side * (ctx.T / 2 - 1.5), Vector3.new(if side.X ~= 0 then 3 else 7.6, 7.2, if side.X ~= 0 then 7.6 else 3))
end

-- U 냉각 배관 선반: 굵은 배관 3단이 이어진 방향으로 지나간다(벽 대신 서 있는 배관 벽)
function Facility.PipeRack(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = Vector3.new(1, 0, 0)
	local x = function(ch: string): boolean
		return ch == "U" or ch == "v" or ch == "#"
	end
	if not (x(ctx.at(i - 1, j)) or x(ctx.at(i + 1, j))) and (x(ctx.at(i, j - 1)) or x(ctx.at(i, j + 1))) then
		axis = Vector3.new(0, 0, 1)
	end
	local across = Vector3.new(axis.Z, 0, -axis.X)
	local m = model(ctx, "PipeRack")
	local half = ctx.T / 2
	for k, y in { 1.6, 4.6, 7.8 } do
		local r = if k == 2 then 1.3 else 1.0
		local off = across * (if k == 2 then 0.6 else -0.5)
		Kit.pipe(m, p - axis * half + off + Vector3.new(0, y, 0), p + axis * half + off + Vector3.new(0, y, 0), r, if (i + j + k) % 2 == 0 then { 0.5 } else nil, false)
	end
	-- 받침 H 틀(칸 가운데)
	for _, s in { -1, 1 } do
		local leg = p + across * (s * 1.9)
		Kit.box(m, CFrame.new(leg + Vector3.new(0, 4.8, 0)), Vector3.new(0.35, 9.6, 0.35), { blocks = false })
	end
	Kit.box(m, CFrame.lookAt(p + Vector3.new(0, 9.6, 0), p + Vector3.new(0, 9.6, 0) + axis), Vector3.new(4.2, 0.35, 0.4), { blocks = false })
	-- 보이지 않는 충돌(배관 사이로 넘어가지 않게, 천장까지)
	Kit.box(m, CFrame.lookAt(p + Vector3.new(0, ctx.H / 2, 0), p + Vector3.new(0, ctx.H / 2, 0) + axis), Vector3.new(4.4, ctx.H, ctx.T), { invisible = true, tag = false })
end

-- j 정비 작업대: 철제 작업대 + 바이스 + 서랍, 벽 쪽 공구판
function Facility.Workbench(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local m = model(ctx, "Workbench")
	local c = p + side * (ctx.T / 2 - 1.9)
	local cf = CFrame.lookAt(c, c - side)
	Kit.box(m, cf * CFrame.new(0, 3.2, 0), Vector3.new(6.8, 0.3, 3.2))
	for _, x in { -3.1, 3.1 } do
		for _, z in { -1.4, 1.4 } do
			Kit.box(m, cf * CFrame.new(x, 1.5, z), Vector3.new(0.25, 3.0, 0.25), { blocks = false })
		end
	end
	Kit.box(m, cf * CFrame.new(-1.9, 2.1, 0), Vector3.new(2.4, 1.8, 2.8), { blocks = false }) -- 서랍함
	Kit.box(m, cf * CFrame.new(0, 0.5, 0), Vector3.new(6.4, 0.15, 2.8), { blocks = false, collide = false }) -- 아래 선반
	-- 바이스
	Kit.box(m, cf * CFrame.new(2.4, 3.75, -1.2), Vector3.new(1.0, 0.8, 1.2), { blocks = false })
	Kit.cylinder(m, (cf * CFrame.new(2.4, 3.75, -1.8)).Position, (cf * CFrame.new(2.4, 3.75, -2.5)).Position, 0.08, { blocks = false, collide = false })
	-- 공구판(벽면)
	local board = cf * CFrame.new(0, 6.0, 1.7)
	Kit.box(m, board, Vector3.new(6.4, 3.2, 0.12), { blocks = false, collide = false })
	for k = -2, 2 do
		Kit.box(m, board * CFrame.new(k * 1.2, -0.2 + (k % 2) * 0.5, -0.15), Vector3.new(0.18, 1.3, 0.12), { blocks = false, collide = false })
	end
	solid(m, c, Vector3.new(if side.X ~= 0 then 3.4 else 7, 4, if side.X ~= 0 then 7 else 3.4))
end

-- Y 공조기(2칸, 이 칸이 서쪽 끝, y 가 동쪽 칸): 상자 몸통, 남쪽으로 향한 둥근 송풍기 얼굴, 천장으로 올라가는 큰 덕트
function Facility.AirHandler(ctx, i: number, j: number)
	local p = (base(ctx, i, j) + base(ctx, i + 1, j)) / 2
	local m = model(ctx, "AirHandler")
	local fwd = Vector3.new(0, 0, 1)
	Kit.box(m, CFrame.new(p + Vector3.new(0, 3.6, -0.8)), Vector3.new(13.4, 7.2, 5.6), { name = "AHU" })
	-- 둥근 송풍기(앞면) 2개
	for _, s in { -1, 1 } do
		local f = p + Vector3.new(s * 3.3, 3.8, 2.0)
		Kit.cylinder(m, f, f + fwd * 0.4, 2.4, { blocks = false, rings = 2 })
		for k = 0, 2 do
			local a = k * math.pi / 3
			local bp = f + fwd * 0.5
			Kit.box(m, CFrame.lookAt(bp, bp + fwd) * CFrame.Angles(0, 0, a), Vector3.new(4.4, 0.18, 0.1), { blocks = false, collide = false })
		end
	end
	-- 덕트(천장으로)
	local d = p + Vector3.new(0, 7.2, -1.2)
	Kit.box(m, CFrame.new(Vector3.new(d.X, (d.Y + ctx.H) / 2, d.Z)), Vector3.new(5.0, math.max(1, ctx.H - d.Y), 3.4), { blocks = false })
	solid(m, p + Vector3.new(0, 0, -0.4), Vector3.new(14, 7.5, 7))
end

-- h 바닥 경고 줄무늬(화물 엘리베이터 앞·구덩이 둘레): 바닥에 얕게 솟은 빗금 판. 걸어서 지나간다
function Facility.Hazard(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Hazard")
	for k = -1, 1 do
		local c = p + Vector3.new(k * 2.6, 0.04, 0)
		Kit.box(m, CFrame.new(c) * CFrame.Angles(0, math.pi / 4, 0), Vector3.new(1.0, 0.08, ctx.T * 0.6), { collide = false, blocks = false })
	end
end

-- x 벽 소화전 함: 벽에 붙은 얕은 철제 함(문틀 선) + 안쪽 둥근 호스 릴 + 함 위 비상등. 두께가 얕아 칸은 그대로 지나간다
function Facility.HoseCabinet(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	if not side then
		return
	end
	local m = model(ctx, "HoseCabinet")
	local c = p + side * (ctx.T / 2 - 0.45) + Vector3.new(0, 3.4, 0)
	local face = CFrame.lookAt(c, c - side)
	Kit.box(m, face, Vector3.new(3.6, 4.4, 0.9), { name = "Cabinet", blocks = false })
	Kit.box(m, face * CFrame.new(0, 0, -0.5), Vector3.new(3.0, 3.8, 0.1), { blocks = false, collide = false })
	local r = (face * CFrame.new(0, -0.2, -0.6)).Position
	Kit.cylinder(m, r, r - side * 0.3, 1.2, { blocks = false, collide = false, rings = 1 })
	local l = (face * CFrame.new(0, 2.9, -0.3)).Position
	Kit.box(m, CFrame.lookAt(l, l - side), Vector3.new(1.6, 0.6, 0.6), { blocks = false, collide = false })
end

return Facility
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">Hospital</string>
            <string name="Source"><![CDATA[--!nonstrict
-- 챕터 4 폐병원 전용 소품(타일 문자 → 함수). Stage4.luau 의 Props 줄에서 쓴다.
-- MapKit 부품만(검은 무광, 음파 윤곽선). 굵은 윤곽 위주, 막는 소품은 보이지 않는 충돌 상자를 둔다.
--   N 카운터(접수대·간호 스테이션·조제 창구)   w 대기 의자 줄            C 침대 사이 커튼(레일 + 천, 지나감)
--   I 수액 걸이대                               G 바퀴 달린 들것          W 휠체어
--   u 세면대 + 거울                             Y 엑스선 촬영대           F 시신 냉장고(3단 문, 벽 줄)
--   H 약장·차트 선반(양면)                      j 화장실 칸(변기 + 칸막이)  e 엘리베이터 문(벽, 지나감)
--   M 감시 모니터 벽 / 마취 모니터 대
--   U CT 촬영기(고리 갠트리 + 환자 테이블)      Q 멈춘 회전문(원통 몸체 + 날개 넷)  g 유리 바람막이·칸막이(틀 + 판)
--   B 방화 셔터(내려온 철제 셔터, 가로 살)      P 평행봉(재활 보행 훈련)    d 협탁 + 오버베드 테이블
--   a 약품 카트(서랍 + 바퀴)

local Kit = require(script.Parent.Parent.MapKit)

local P = {}

local LINE = { blocks = false, collide = false }
local SOFT = { blocks = false }

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

local function wallSide(ctx, i: number, j: number): Vector3?
	for _, d in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local function model(ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end

local function solid(m: Instance, cf: CFrame, size: Vector3)
	Kit.box(m, cf * CFrame.new(0, size.Y / 2, 0), size, { invisible = true, tag = false })
end

-- 같은 문자가 이어지는 축(세로 이웃이 있으면 z, 아니면 x)
local function runAxis(ctx, i: number, j: number, ch: string): Vector3
	if ctx.at(i, j - 1) == ch or ctx.at(i, j + 1) == ch then
		return Vector3.new(0, 0, 1)
	end
	return Vector3.new(1, 0, 0)
end

-- 벽을 등진 좌표계: 로컬 -Z = 방 안쪽, +Z = 벽 쪽
local function againstWall(ctx, i: number, j: number): (CFrame, Vector3)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	return CFrame.lookAt(p, p - side), side
end

-- N 카운터: 이어진 방향으로 한 칸 길이. 앞판 + 높은 선반 + 안쪽 작업대
function P.Counter(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "N")
	local cf = CFrame.lookAt(p, p + axis) -- 로컬 Z = 이어진 방향
	local m = model(ctx, "Counter")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 1.9, 0), Vector3.new(1.0, 3.8, L), SOFT)
	Kit.box(m, cf * CFrame.new(0, 3.95, 0), Vector3.new(2.2, 0.25, L), SOFT)
	Kit.box(m, cf * CFrame.new(1.4, 2.7, 0), Vector3.new(1.8, 0.2, L), SOFT)
	if ctx.hash(i, j, 21) > 0.5 then -- 모니터
		Kit.box(m, cf * CFrame.new(1.4, 3.6, 0) * CFrame.Angles(0, 0.2, 0), Vector3.new(0.15, 1.2, 1.8), LINE)
	else -- 서류철
		Kit.box(m, cf * CFrame.new(0.1, 4.3, 1.2), Vector3.new(1.0, 0.45, 1.4), LINE)
	end
	solid(m, cf, Vector3.new(3.2, 4.1, L))
end

-- w 대기 의자 줄: 한 칸에 의자 셋(연결 다리)
function P.Bench(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "WaitingChairs")
	local axis = runAxis(ctx, i, j, "w")
	local cf = CFrame.lookAt(p, p + Vector3.new(axis.Z, 0, -axis.X)) -- 로컬 X = 줄 방향
	Kit.box(m, cf * CFrame.new(0, 1.2, 0), Vector3.new(7.4, 0.2, 0.3), LINE)
	for k = -1, 1 do
		Kit.box(m, cf * CFrame.new(k * 2.5, 1.7, -0.1), Vector3.new(2.0, 0.2, 1.9), SOFT)
		Kit.box(m, cf * CFrame.new(k * 2.5, 2.8, 0.9) * CFrame.Angles(-0.12, 0, 0), Vector3.new(2.0, 1.7, 0.18), SOFT)
	end
	for _, x in { -3.2, 3.2 } do
		Kit.box(m, cf * CFrame.new(x, 0.6, 0), Vector3.new(0.2, 1.2, 1.8), LINE)
	end
	solid(m, cf, Vector3.new(7.6, 3.4, 2.4))
end

-- C 침대 사이 커튼: 천장 레일 + 세로 주름 천(지나갈 수 있다)
function P.Curtain(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Curtain")
	local top = math.min(9.2, ctx.H - 1)
	Kit.cylinder(m, (cf * CFrame.new(0, top, 3.8)).Position, (cf * CFrame.new(0, top, -3.2)).Position, 0.1, LINE)
	local n = 5
	for k = 0, n - 1 do -- 주름(지그재그로 선 판)
		local z = 3.4 - k * 1.1
		Kit.box(m, cf * CFrame.new(if k % 2 == 0 then 0.18 else -0.18, (top + 1.2) / 2, z) * CFrame.Angles(0, if k % 2 == 0 then 0.35 else -0.35, 0), Vector3.new(0.1, top - 1.2, 1.1), LINE)
	end
end

-- I 수액 걸이대
function P.IVStand(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "IVStand")
	local c = p + Vector3.new((ctx.hash(i, j, 31) - 0.5) * 2, 0, (ctx.hash(i, j, 32) - 0.5) * 2)
	Kit.cylinder(m, c + Vector3.new(0, 0.3, 0), c + Vector3.new(0, 7.0, 0), 0.12, SOFT)
	for k = 0, 2 do
		local a = k * math.pi * 2 / 3
		Kit.cylinder(m, c + Vector3.new(0, 0.35, 0), c + Vector3.new(math.cos(a) * 1.2, 0.15, math.sin(a) * 1.2), 0.1, LINE)
	end
	Kit.cylinder(m, c + Vector3.new(-0.9, 6.9, 0), c + Vector3.new(0.9, 6.9, 0), 0.08, LINE)
	Kit.box(m, CFrame.new(c + Vector3.new(0.8, 6.0, 0)), Vector3.new(0.9, 1.5, 0.35), LINE) -- 수액 주머니
	Kit.box(m, CFrame.new(c + Vector3.new(0, 3.8, 0.3)), Vector3.new(0.9, 1.1, 0.6), LINE) -- 펌프
	solid(m, CFrame.new(c), Vector3.new(1.8, 7, 1.8))
end

-- G 들것: 매트리스 + 바퀴 다리 + 옆 난간
function P.Gurney(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, ctx.hash(i, j, 41) * math.pi, 0)
	local m = model(ctx, "Gurney")
	Kit.box(m, cf * CFrame.new(0, 2.8, 0), Vector3.new(2.5, 0.6, 6.4), SOFT)
	Kit.box(m, cf * CFrame.new(0, 3.5, 2.2) * CFrame.Angles(-0.35, 0, 0), Vector3.new(2.5, 0.4, 2.2), SOFT)
	for _, x in { -1.1, 1.1 } do
		for _, z in { -2.6, 2.6 } do
			Kit.cylinder(m, (cf * CFrame.new(x, 2.6, z)).Position, (cf * CFrame.new(x, 0.4, z * 0.85)).Position, 0.1, LINE)
			Kit.cylinder(m, (cf * CFrame.new(x - 0.12, 0.4, z * 0.85)).Position, (cf * CFrame.new(x + 0.12, 0.4, z * 0.85)).Position, 0.4, LINE)
		end
		Kit.cylinder(m, (cf * CFrame.new(x * 1.2, 3.9, -1.8)).Position, (cf * CFrame.new(x * 1.2, 3.9, 1.6)).Position, 0.08, LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 1.0, 0), Vector3.new(2.0, 0.15, 4.6), LINE)
	solid(m, cf, Vector3.new(2.8, 4.2, 6.6))
end

-- W 휠체어
function P.Wheelchair(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, ctx.hash(i, j, 51) * math.pi * 2, 0)
	local m = model(ctx, "Wheelchair")
	Kit.box(m, cf * CFrame.new(0, 2.0, 0), Vector3.new(2.0, 0.25, 2.0), SOFT)
	Kit.box(m, cf * CFrame.new(0, 3.3, 1.0), Vector3.new(2.0, 2.4, 0.2), SOFT)
	for _, x in { -1.25, 1.25 } do
		Kit.cylinder(m, (cf * CFrame.new(x - 0.1, 1.5, 0.5)).Position, (cf * CFrame.new(x + 0.1, 1.5, 0.5)).Position, 1.5, LINE) -- 큰 바퀴
		Kit.cylinder(m, (cf * CFrame.new(x * 0.85, 0.5, -1.4)).Position, (cf * CFrame.new(x * 0.85 + 0.1, 0.5, -1.4)).Position, 0.5, LINE)
		Kit.cylinder(m, (cf * CFrame.new(x * 0.85, 3.1, 0.9)).Position, (cf * CFrame.new(x * 0.85, 3.1, -0.8)).Position, 0.1, LINE) -- 팔걸이
		Kit.cylinder(m, (cf * CFrame.new(x * 0.8, 4.4, 1.0)).Position, (cf * CFrame.new(x * 0.8, 4.4, 1.7)).Position, 0.1, LINE) -- 손잡이
		Kit.box(m, cf * CFrame.new(x * 0.45, 0.6, -1.9), Vector3.new(0.9, 0.12, 0.9), LINE) -- 발판
	end
	solid(m, cf, Vector3.new(3, 4.4, 3.6))
end

-- u 세면대 + 거울
function P.Sink(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Sink")
	local z = ctx.T / 2 - 1.1
	Kit.box(m, cf * CFrame.new(0, 2.8, z), Vector3.new(2.8, 0.8, 2.0), SOFT)
	Kit.box(m, cf * CFrame.new(0, 3.22, z - 0.1), Vector3.new(1.9, 0.05, 1.2), LINE)
	Kit.cylinder(m, (cf * CFrame.new(0, 0, z + 0.2)).Position, (cf * CFrame.new(0, 2.4, z + 0.2)).Position, 0.35, SOFT)
	Kit.cylinder(m, (cf * CFrame.new(0, 3.2, z + 0.7)).Position, (cf * CFrame.new(0, 4.1, z + 0.7)).Position, 0.1, LINE)
	Kit.cylinder(m, (cf * CFrame.new(0, 4.1, z + 0.7)).Position, (cf * CFrame.new(0, 4.0, z - 0.1)).Position, 0.1, LINE)
	Kit.box(m, cf * CFrame.new(0, 6.2, ctx.T / 2 - 0.25), Vector3.new(2.4, 2.6, 0.1), LINE) -- 거울
	solid(m, cf * CFrame.new(0, 0, z), Vector3.new(3, 3.4, 2.2))
end

-- Y 엑스선 촬영대: 긴 촬영 침대 + 천장 기둥에 매달린 관구
function P.XRay(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p)
	local m = model(ctx, "XRay")
	Kit.box(m, cf * CFrame.new(0, 2.7, 0), Vector3.new(7.4, 0.5, 2.8), SOFT)
	Kit.box(m, cf * CFrame.new(0, 1.2, 0), Vector3.new(3.0, 2.4, 1.8), SOFT)
	local top = ctx.H
	Kit.cylinder(m, (cf * CFrame.new(1.2, top, -0.2)).Position, (cf * CFrame.new(1.2, 6.8, -0.2)).Position, 0.4, SOFT)
	Kit.box(m, cf * CFrame.new(1.2, 6.2, -0.2), Vector3.new(2.6, 1.4, 1.6), SOFT)
	Kit.cylinder(m, (cf * CFrame.new(1.2, 5.6, -0.2)).Position, (cf * CFrame.new(1.2, 4.7, -0.2)).Position, 0.75, LINE)
	Kit.box(m, cf * CFrame.new(0, top - 0.25, -0.2), Vector3.new(7.6, 0.3, 0.6), LINE) -- 천장 레일
	for _, s in { -1, 1 } do -- 조작 손잡이
		Kit.cylinder(m, (cf * CFrame.new(1.2 + s * 1.3, 6.2, -0.2)).Position, (cf * CFrame.new(1.2 + s * 1.9, 5.6, -1.0)).Position, 0.1, LINE)
	end
	solid(m, cf, Vector3.new(7.4, 3.2, 2.8))
end

-- F 시신 냉장고: 벽을 따라 3단 문 + 손잡이. 가끔 트레이가 나와 있다
function P.MorgueFridge(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "MorgueFridge")
	local z = ctx.T / 2 - 1.6
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 4.5, z), Vector3.new(L, 9, 3.0))
	for k = 0, 2 do
		for _, s in { -1, 1 } do
			local c = cf * CFrame.new(s * L / 4, 1.6 + k * 2.9, z - 1.55)
			Kit.box(m, c, Vector3.new(L / 2 - 0.5, 2.5, 0.12), LINE)
			Kit.box(m, c * CFrame.new(1.1, 0, -0.15), Vector3.new(0.2, 0.9, 0.25), LINE)
		end
	end
	if ctx.hash(i, j, 61) > 0.7 then
		Kit.box(m, cf * CFrame.new(-L / 4, 1.2, z - 2.3), Vector3.new(L / 2 - 0.9, 0.25, 1.6), LINE)
	end
end

-- H 약장·차트 선반: 양면 5단 선반 + 상자 몇 개
function P.MedShelf(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "H")
	local cf = CFrame.lookAt(p, p + axis)
	local m = model(ctx, "MedShelf")
	local L = ctx.T
	local h = 7.2
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(0, h / 2, s * (L / 2 - 0.1)), Vector3.new(2.4, h, 0.2), SOFT)
	end
	Kit.box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(0.15, h, L - 0.3))
	for k = 0, 4 do
		Kit.box(m, cf * CFrame.new(0, 0.5 + k * 1.65, 0), Vector3.new(2.4, 0.14, L - 0.3), LINE)
	end
	for k = 0, 2 do -- 남은 약 상자·차트 몇 개
		local r = ctx.hash(i, j, 70 + k)
		Kit.box(m, cf * CFrame.new(if r > 0.5 then 0.65 else -0.65, 1.1 + math.floor(r * 4) * 1.65, (ctx.hash(i, j, 80 + k) - 0.5) * (L - 2.4)), Vector3.new(0.9, 1.0, 1.6), LINE)
	end
	solid(m, cf, Vector3.new(2.4, h, L))
end

-- j 화장실 칸: 양옆 칸막이 + 반쯤 열린 문 + 변기
function P.ToiletStall(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "ToiletStall")
	local h = 6.6
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 3.2, h / 2 + 0.6, 1.4), Vector3.new(0.15, h, 5.0), SOFT)
	end
	Kit.box(m, cf * CFrame.new(-2.0, h / 2 + 0.6, -1.1) * CFrame.Angles(0, 0.5, 0), Vector3.new(2.4, h, 0.15), SOFT) -- 열린 문
	Kit.box(m, cf * CFrame.new(2.3, h / 2 + 0.6, -1.1), Vector3.new(1.7, h, 0.15), SOFT)
	Kit.cylinder(m, (cf * CFrame.new(0, 0, 1.6)).Position, (cf * CFrame.new(0, 1.6, 1.6)).Position, 0.8, SOFT)
	Kit.cylinder(m, (cf * CFrame.new(0, 1.6, 1.4)).Position, (cf * CFrame.new(0, 1.85, 1.4)).Position, 1.0, LINE)
	Kit.box(m, cf * CFrame.new(0, 2.6, 3.1), Vector3.new(1.8, 1.8, 0.9), SOFT)
	solid(m, cf * CFrame.new(0, 0, 1.4), Vector3.new(6.6, 7, 5.2))
end

-- e 엘리베이터 문(벽면): 문틀 + 두 짝 문 + 층 표시 + 호출 단추
function P.Elevator(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "ElevatorDoor")
	local z = ctx.T / 2 - 0.2
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 3.0, 4.2, z), Vector3.new(0.5, 8.4, 0.5), LINE)
		Kit.box(m, cf * CFrame.new(s * 1.4, 4.0, z + 0.05), Vector3.new(2.7, 8.0, 0.12), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 8.5, z), Vector3.new(6.5, 0.5, 0.5), LINE)
	Kit.box(m, cf * CFrame.new(0, 9.3, z), Vector3.new(1.8, 0.8, 0.3), LINE)
	Kit.box(m, cf * CFrame.new(3.6, 4.2, z), Vector3.new(0.5, 1.2, 0.2), LINE)
end

-- M 감시 모니터: 바퀴 달린 대 + 화면 둘 + 늘어진 선
function P.Monitor(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local cf = if side then CFrame.lookAt(p + side * (ctx.T / 2 - 1.5), p) else CFrame.new(p)
	local m = model(ctx, "PatientMonitor")
	Kit.box(m, cf * CFrame.new(0, 2.0, 0), Vector3.new(2.8, 3.2, 1.8), SOFT)
	for k = 0, 1 do
		Kit.box(m, cf * CFrame.new(0, 1.2 + k * 1.3, -0.95), Vector3.new(2.4, 0.1, 0.1), LINE)
	end
	Kit.cylinder(m, (cf * CFrame.new(0, 3.6, 0)).Position, (cf * CFrame.new(0, 5.0, 0)).Position, 0.15, LINE)
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 1.15, 5.4, -0.1) * CFrame.Angles(0, s * 0.25, 0), Vector3.new(2.1, 1.6, 0.25), SOFT)
	end
	Kit.cylinder(m, (cf * CFrame.new(1.2, 4.6, 0.2)).Position, (cf * CFrame.new(1.9, 0.6, 0.6)).Position, 0.08, LINE)
	solid(m, cf, Vector3.new(3.4, 6, 2.2))
end

-- U CT 촬영기: 여덟 조각 고리(갠트리, 음파에 둥근 고리로 보인다) + 고리를 지나는 환자 테이블 + 받침
function P.CTScanner(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) -- 고리 면 = YZ, 테이블 = X 방향
	local m = model(ctx, "CTScanner")
	local cy, R = 3.6, 2.7
	for k = 0, 7 do
		local a = k * math.pi / 4
		local c = cf * CFrame.new(1.2, cy + math.sin(a) * R, math.cos(a) * R) * CFrame.Angles(a, 0, 0)
		Kit.box(m, c, Vector3.new(1.6, 1.0, 2.35), SOFT)
	end
	Kit.box(m, cf * CFrame.new(1.2, 0.5, 0), Vector3.new(1.8, 1.0, 4.4), SOFT) -- 고리 받침
	Kit.box(m, cf * CFrame.new(-1.0, 2.9, 0), Vector3.new(6.8, 0.35, 1.5), SOFT) -- 테이블 판(고리 안으로 들어간다)
	Kit.box(m, cf * CFrame.new(-2.6, 1.35, 0), Vector3.new(2.4, 2.7, 1.2), SOFT) -- 테이블 받침
	Kit.box(m, cf * CFrame.new(-3.4, 3.2, 0), Vector3.new(0.6, 0.25, 1.2), LINE) -- 머리 받침
	solid(m, cf, Vector3.new(7.2, 6.6, 6.4))
end

-- Q 멈춘 회전문: 지붕·바닥 원판, 양옆 곡면 유리(판 셋씩), 가운데 기둥과 날개 넷. 지나갈 수 없다(옆 여닫이문 E 가 출구)
function P.RevolvingDoor(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "RevolvingDoor")
	local top = math.min(9.5, ctx.H - 1)
	local R = 3.6
	Kit.cylinder(m, p + Vector3.new(0, top, 0), p + Vector3.new(0, top + 0.6, 0), R + 0.3, SOFT) -- 지붕 원판
	Kit.cylinder(m, p + Vector3.new(0, 0.02, 0), p + Vector3.new(0, 0.18, 0), R, LINE) -- 바닥 원판
	Kit.cylinder(m, p + Vector3.new(0, 0, 0), p + Vector3.new(0, top, 0), 0.25, SOFT) -- 가운데 기둥
	for _, s in { 0, 1 } do -- 동·서 곡면 유리(바깥 쪽 반원)
		for k = -1, 1 do
			local a = s * math.pi + k * 0.55
			local c = CFrame.new(p + Vector3.new(math.cos(a) * R, top / 2, math.sin(a) * R)) * CFrame.Angles(0, -a, 0)
			Kit.box(m, c, Vector3.new(0.12, top, 2.0), LINE)
		end
	end
	local yaw = 0.35 -- 멈춘 날개 각도
	for k = 0, 3 do
		local a = yaw + k * math.pi / 2
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		local c = CFrame.lookAt(p + d * (R / 2) + Vector3.new(0, top / 2, 0), p + d * R + Vector3.new(0, top / 2, 0))
		Kit.box(m, c, Vector3.new(0.12, top - 0.6, R - 0.3), LINE)
		Kit.box(m, c * CFrame.new(0, 0, 0), Vector3.new(0.3, 0.25, R - 0.3), SOFT) -- 날개 손잡이 가로대
	end
	solid(m, CFrame.new(p), Vector3.new(R * 2, top, R * 2))
end

-- g 유리 바람막이·칸막이: 금속 틀(기둥 둘·위아래 가로대·가운데 띠) + 얇은 판. 이어진 방향으로 한 칸 길이, 막힌다
function P.GlassScreen(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "g")
	local cf = CFrame.lookAt(p, p + axis) -- 로컬 Z = 이어진 방향
	local m = model(ctx, "GlassScreen")
	local L = ctx.T
	local h = math.min(9, ctx.H - 1)
	Kit.box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(0.08, h - 0.4, L - 0.4), LINE) -- 유리판
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(0, h / 2, s * (L / 2 - 0.15)), Vector3.new(0.35, h, 0.3), SOFT) -- 기둥
	end
	Kit.box(m, cf * CFrame.new(0, h, 0), Vector3.new(0.4, 0.35, L), SOFT)
	Kit.box(m, cf * CFrame.new(0, 0.2, 0), Vector3.new(0.4, 0.4, L), SOFT)
	Kit.box(m, cf * CFrame.new(0, 3.4, 0), Vector3.new(0.3, 0.15, L), LINE) -- 손 닿는 높이 띠(부딪힘 방지 표시)
	solid(m, cf, Vector3.new(0.6, h, L))
end

-- B 방화 셔터: 천장 셔터 박스에서 바닥까지 내려온 철판 + 가로 살 줄 + 아래 막대. 줄 끝(벽 쪽)에 안내 레일
function P.FireShutter(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "B")
	local cf = CFrame.lookAt(p, p + axis) -- 로컬 Z = 셔터 줄 방향
	local m = model(ctx, "FireShutter")
	local L = ctx.T
	local h = ctx.H
	Kit.box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(0.35, h, L)) -- 철판(음파·소리를 막는다)
	for k = 1, 7 do -- 가로 살(앞뒤 면에 선이 보이게 살짝 튀어나온 띠)
		Kit.box(m, cf * CFrame.new(0, k * (h - 1.6) / 8, 0), Vector3.new(0.55, 0.12, L), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, h - 0.8, 0), Vector3.new(1.6, 1.6, L), SOFT) -- 셔터 박스
	Kit.box(m, cf * CFrame.new(0, 0.25, 0), Vector3.new(0.7, 0.5, L), SOFT) -- 아래 막대
	for _, s in { -1, 1 } do
		local ni, nj = i + math.round(axis.X) * s, j + math.round(axis.Z) * s
		if ctx.at(ni, nj) ~= "B" then -- 줄 끝: 벽에 붙은 안내 레일
			Kit.box(m, cf * CFrame.new(0, h / 2, s * (L / 2 - 0.2)), Vector3.new(0.9, h, 0.4), SOFT)
		end
	end
end

-- P 평행봉: 바닥 판 + 손잡이 봉 둘(이어진 방향) + 기둥
function P.ParallelBars(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "P")
	local cf = CFrame.lookAt(p, p + axis) -- 로컬 Z = 봉 방향
	local m = model(ctx, "ParallelBars")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 0.1, 0), Vector3.new(3.4, 0.2, L), LINE)
	for _, x in { -1.2, 1.2 } do
		Kit.cylinder(m, (cf * CFrame.new(x, 3.0, -L / 2)).Position, (cf * CFrame.new(x, 3.0, L / 2)).Position, 0.12, SOFT)
		for _, z in { -L / 4, L / 4 } do
			Kit.cylinder(m, (cf * CFrame.new(x, 0.2, z)).Position, (cf * CFrame.new(x, 3.0, z)).Position, 0.1, LINE)
		end
	end
	solid(m, cf, Vector3.new(3.4, 3.2, L))
end

-- d 협탁 + 오버베드 테이블: 벽 쪽 작은 서랍장(서랍 선 둘) + 바퀴 받침의 ㄱ자 식사 테이블
function P.Bedside(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Bedside")
	local z = ctx.T / 2 - 1.3
	Kit.box(m, cf * CFrame.new(0, 1.4, z), Vector3.new(1.9, 2.8, 1.9), SOFT)
	for k = 1, 2 do
		Kit.box(m, cf * CFrame.new(0, k * 0.9, z - 0.97), Vector3.new(1.6, 0.08, 0.05), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 3.05, z), Vector3.new(0.5, 0.5, 0.5), LINE) -- 컵·약통
	local tz = z - 2.4
	Kit.box(m, cf * CFrame.new(-1.1, 0.12, tz), Vector3.new(0.5, 0.24, 2.2), LINE) -- 바퀴 받침
	Kit.cylinder(m, (cf * CFrame.new(-1.1, 0.2, tz)).Position, (cf * CFrame.new(-1.1, 3.6, tz)).Position, 0.1, LINE)
	Kit.box(m, cf * CFrame.new(0, 3.7, tz), Vector3.new(2.8, 0.15, 1.3), SOFT) -- 식사 판
	solid(m, cf * CFrame.new(0, 0, z - 1), Vector3.new(3, 3.8, 3.6))
end

-- a 약품 카트: 서랍 몸체(서랍 선 셋) + 위 쟁반 테 + 손잡이 + 바퀴 넷
function P.MedCart(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, ctx.hash(i, j, 91) * math.pi, 0)
	local m = model(ctx, "MedCart")
	Kit.box(m, cf * CFrame.new(0, 2.0, 0), Vector3.new(3.0, 2.8, 2.0), SOFT)
	for k = 1, 3 do
		Kit.box(m, cf * CFrame.new(0, 0.9 + k * 0.7, -1.02), Vector3.new(2.7, 0.08, 0.05), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 3.55, 0), Vector3.new(3.2, 0.3, 2.2), LINE) -- 쟁반 테
	Kit.cylinder(m, (cf * CFrame.new(-1.3, 3.5, 1.3)).Position, (cf * CFrame.new(1.3, 3.5, 1.3)).Position, 0.09, LINE) -- 손잡이
	for _, x in { -1.2, 1.2 } do
		for _, zz in { -0.75, 0.75 } do
			Kit.cylinder(m, (cf * CFrame.new(x - 0.1, 0.3, zz)).Position, (cf * CFrame.new(x + 0.1, 0.3, zz)).Position, 0.3, LINE)
		end
	end
	solid(m, cf, Vector3.new(3.2, 3.8, 2.6))
end

return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">Hotel</string>
            <string name="Source"><![CDATA[--!nonstrict
-- 챕터 6 호텔 전용 소품(구역마다 실제로 있어야 할 장비·가구). MapKit 부품만 쓴다(직접 만든 에셋).
--   F 프런트 데스크(로비 랜드마크: 길게 이어지는 카운터 + 높은 접수대 + 모니터)
--   G 짐 카트(황동 새장 모양 트롤리: 아치 손잡이 + 기둥 넷)       w 소파(로비·라운지·스위트 거실)
--   q 바 카운터(라운지 바, 손님 쪽 바 의자)                       U 원형 테이블 + 의자 넷(연회장·레스토랑·직원 식당)
--   K 업소용 화구(가스레인지 + 위 후드·덕트: 주방 랜드마크)        P 스테인리스 조리대(아래 선반)
--   W 업소용 세탁기(둥근 문)                                       j 린넨 선반(접힌 수건·시트 더미)
--   l 직원 사물함 줄(좁은 문 셋)                                   h 하우스키핑 카트(선반 + 빨래 자루 + 손잡이)
--   V 제빙기·자판기(층 제빙기실)                                   e 엘리베이터 문(문틀 + 두 짝 문 + 층 표시판 + 호출 버튼)
-- 각 함수는 StageBuilder 의 ctx 와 타일 좌표(i, j)를 받는다. 1층 천장은 11(2층 건물)이라 모든 소품은 바닥에서 10 아래.

local Kit = require(script.Parent.Parent.MapKit)

local P = {}

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

-- 가장 가까운 벽 쪽(없으면 기본값)
local function wallSide(ctx, i: number, j: number, default: Vector3?): Vector3
	for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return default or Vector3.new(0, 0, -1)
end

local function model(ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end

local function same(ctx, i: number, j: number, ch: string): boolean
	local ok, v = pcall(ctx.at, i, j)
	return ok and v == ch
end

-- 같은 글자가 이어진 방향(카운터 줄): 가로로 이웃이 있으면 X, 세로면 Z, 혼자면 벽과 나란히
local function runAxis(ctx, i: number, j: number, ch: string): Vector3
	if same(ctx, i - 1, j, ch) or same(ctx, i + 1, j, ch) then
		return Vector3.new(1, 0, 0)
	elseif same(ctx, i, j - 1, ch) or same(ctx, i, j + 1, ch) then
		return Vector3.new(0, 0, 1)
	end
	local s = wallSide(ctx, i, j)
	return Vector3.new(s.Z, 0, -s.X)
end

-- 축(axis)·앞(front)·위로 세운 CFrame: 로컬 X = axis, 로컬 Z = -front(앞이 -Z)
local function frame(p: Vector3, axis: Vector3, front: Vector3): CFrame
	return CFrame.lookAt(p, p + front)
end

-- ── 로비 ──
-- 프런트 데스크: 칸마다 한 토막(8 길이). 손님 쪽(앞)은 높은 접수대, 직원 쪽은 낮은 작업대. 줄 끝에는 옆판
function P.FrontDesk(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "F")
	-- 손님 쪽: 가로 줄이면 남쪽(+Z), 세로 줄이면 동쪽(+X)
	local front = if math.abs(axis.X) > 0.5 then Vector3.new(0, 0, 1) else Vector3.new(1, 0, 0)
	local cf = frame(p, axis, front) -- 로컬 -Z = 앞
	local m = model(ctx, "FrontDesk")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 2.0, -0.9), Vector3.new(L, 4.0, 0.5), { blocks = false }) -- 앞 판(손님 쪽 벽)
	Kit.box(m, cf * CFrame.new(0, 4.1, -0.9), Vector3.new(L, 0.2, 1.2), { blocks = false }) -- 높은 접수대
	Kit.box(m, cf * CFrame.new(0, 2.8, 0.4), Vector3.new(L, 0.2, 2.2), { blocks = false }) -- 직원 작업대
	Kit.box(m, cf * CFrame.new(0, 0.2, -0.6), Vector3.new(L, 0.4, 1.4), { blocks = false, collide = false }) -- 발판 띠
	local h = ctx.hash(i, j, 61)
	if h > 0.35 then -- 모니터(칸마다 있지는 않다)
		local mp = cf * CFrame.new((h - 0.65) * 3, 3.9, 0.5)
		Kit.box(m, mp, Vector3.new(1.6, 1.0, 0.12), { blocks = false, collide = false })
		Kit.box(m, cf * CFrame.new((h - 0.65) * 3, 3.1, 0.6), Vector3.new(0.6, 0.12, 0.5), { blocks = false, collide = false })
	end
	for _, s in { -1, 1 } do
		local ni = i + math.round(axis.X) * s
		local nj = j + math.round(axis.Z) * s
		if not same(ctx, ni, nj, "F") then
			Kit.box(m, cf * CFrame.new(s * (L / 2 - 0.2), 2.1, -0.2), Vector3.new(0.4, 4.2, 2.6), { blocks = false }) -- 옆판
		end
	end
	if h < 0.25 then -- 호출 벨
		Kit.cylinder(m, (cf * CFrame.new(0.5, 4.2, -1.0)).Position, (cf * CFrame.new(0.5, 4.55, -1.0)).Position, 0.3, { blocks = false, collide = false })
	end
	Kit.box(m, cf * CFrame.new(0, 2.1, -0.2), Vector3.new(L, 4.2, 2.8), { invisible = true, tag = false })
end

-- 짐 카트: 카펫 바닥판 + 바퀴 넷 + 기둥 넷 + 위 아치 손잡이 + 옷걸이 봉 + 여행 가방 둘
function P.LuggageCart(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local yaw = ctx.hash(i, j, 62) * 1.2 - 0.6
	local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0)
	local m = model(ctx, "LuggageCart")
	Kit.box(m, cf * CFrame.new(0, 0.9, 0), Vector3.new(2.6, 0.3, 4.4), { blocks = false }) -- 바닥판
	for _, x in { -1.1, 1.1 } do
		for _, z in { -1.9, 1.9 } do
			Kit.cylinder(m, (cf * CFrame.new(x, 0.35, z)).Position, (cf * CFrame.new(x + 0.15 * math.sign(x), 0.35, z)).Position, 0.35, { blocks = false, collide = false })
		end
	end
	for _, z in { -1.9, 1.9 } do
		for _, x in { -1.1, 1.1 } do
			Kit.cylinder(m, (cf * CFrame.new(x, 1.0, z)).Position, (cf * CFrame.new(x, 5.6, z)).Position, 0.09, { blocks = false, collide = false })
		end
		Kit.cylinder(m, (cf * CFrame.new(-1.1, 5.6, z)).Position, (cf * CFrame.new(0, 6.4, z)).Position, 0.09, { blocks = false, collide = false }) -- 아치
		Kit.cylinder(m, (cf * CFrame.new(1.1, 5.6, z)).Position, (cf * CFrame.new(0, 6.4, z)).Position, 0.09, { blocks = false, collide = false })
	end
	Kit.cylinder(m, (cf * CFrame.new(0, 6.4, -1.9)).Position, (cf * CFrame.new(0, 6.4, 1.9)).Position, 0.08, { blocks = false, collide = false }) -- 옷걸이 봉
	Kit.box(m, cf * CFrame.new(0, 2.2, -0.9), Vector3.new(2.0, 2.4, 1.0), { blocks = false }) -- 가방
	Kit.box(m, cf * CFrame.new(0.2, 1.7, 0.9) * CFrame.Angles(0, 0.2, 0), Vector3.new(1.8, 1.4, 1.4), { blocks = false })
	Kit.box(m, cf * CFrame.new(0, 2.5, 0), Vector3.new(2.6, 5, 4.4), { invisible = true, tag = false })
end

-- 소파: 등받이는 벽 쪽(없으면 북쪽), 팔걸이 둘, 방석
function P.Sofa(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j, Vector3.new(0, 0, -1))
	local axis = Vector3.new(side.Z, 0, -side.X)
	local cf = frame(p, axis, -side) -- 로컬 -Z = 앞(방 안쪽), +Z = 벽 쪽
	local m = model(ctx, "Sofa")
	local off = ctx.T / 2 - 1.8
	Kit.box(m, cf * CFrame.new(0, 0.9, off - 0.2), Vector3.new(6.2, 1.2, 2.8), { blocks = false }) -- 좌판
	Kit.box(m, cf * CFrame.new(0, 2.4, off + 1.0), Vector3.new(6.2, 2.0, 0.7), { blocks = false }) -- 등받이
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 3.0, 1.6, off - 0.1), Vector3.new(0.6, 1.4, 3.0), { blocks = false }) -- 팔걸이
	end
	Kit.box(m, cf * CFrame.new(-1.5, 1.6, off - 0.3), Vector3.new(2.8, 0.3, 2.2), { blocks = false, collide = false }) -- 방석 둘
	Kit.box(m, cf * CFrame.new(1.5, 1.6, off - 0.3), Vector3.new(2.8, 0.3, 2.2), { blocks = false, collide = false })
	Kit.box(m, cf * CFrame.new(0, 1.6, off), Vector3.new(6.4, 3.2, 3.2), { invisible = true, tag = false })
end

-- ── 라운지 바 ──
-- 바 카운터: 칸마다 한 토막(벽 쪽이 바텐더 자리), 앞에 바 의자 둘, 벽에 술병 선반
function P.BarCounter(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j, Vector3.new(0, 0, -1))
	local axis = Vector3.new(side.Z, 0, -side.X)
	local cf = frame(p, axis, -side)
	local m = model(ctx, "BarCounter")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 1.9, -0.2), Vector3.new(L, 3.8, 1.6), { blocks = false }) -- 카운터 몸
	Kit.box(m, cf * CFrame.new(0, 3.9, -0.4), Vector3.new(L, 0.2, 2.4), { blocks = false }) -- 상판
	Kit.box(m, cf * CFrame.new(0, 5.6, L / 2 - 0.5), Vector3.new(L - 0.4, 0.15, 0.9), { blocks = false, collide = false }) -- 술병 선반
	for k = -2, 2 do
		local b = cf * CFrame.new(k * 1.4, 6.3, L / 2 - 0.5)
		Kit.cylinder(m, b.Position - Vector3.new(0, 0.6, 0), b.Position + Vector3.new(0, 0.5, 0), 0.22, { blocks = false, collide = false })
	end
	for _, x in { -1.9, 1.9 } do -- 바 의자
		local s = cf * CFrame.new(x, 0, -2.6)
		Kit.cylinder(m, s.Position, s.Position + Vector3.new(0, 2.8, 0), 0.12, { blocks = false, collide = false })
		Kit.cylinder(m, s.Position + Vector3.new(0, 2.8, 0), s.Position + Vector3.new(0, 3.05, 0), 0.75, { blocks = false, collide = false })
	end
	Kit.box(m, cf * CFrame.new(0, 2, -0.3), Vector3.new(L, 4, 2.6), { invisible = true, tag = false })
end

-- 원형 테이블 + 의자 넷(연회장·레스토랑)
function P.RoundTable(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local yaw = ctx.hash(i, j, 63) * math.pi
	local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0)
	local m = model(ctx, "RoundTable")
	Kit.cylinder(m, (cf * CFrame.new(0, 2.9, 0)).Position, (cf * CFrame.new(0, 3.1, 0)).Position, 2.2, { blocks = false }) -- 상판
	Kit.cylinder(m, (cf * CFrame.new(0, 0, 0)).Position, (cf * CFrame.new(0, 2.9, 0)).Position, 0.25, { blocks = false }) -- 다리
	Kit.cylinder(m, (cf * CFrame.new(0, 0, 0)).Position, (cf * CFrame.new(0, 0.15, 0)).Position, 1.0, { blocks = false, collide = false })
	for k = 0, 3 do
		local a = k * math.pi / 2 + 0.3
		local c = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -3.1)
		Kit.box(m, c * CFrame.new(0, 1.8, 0), Vector3.new(1.5, 0.18, 1.5), { blocks = false, collide = false }) -- 좌판
		Kit.box(m, c * CFrame.new(0, 2.9, -0.7), Vector3.new(1.5, 2.0, 0.15), { blocks = false, collide = false }) -- 등받이
		Kit.box(m, c * CFrame.new(0, 0.9, 0), Vector3.new(0.2, 1.8, 0.2), { blocks = false, collide = false })
	end
	Kit.box(m, CFrame.new(p + Vector3.new(0, 1.5, 0)), Vector3.new(4.6, 3, 4.6), { invisible = true, tag = false })
end

-- ── 주방 ──
-- 업소용 화구: 벽 쪽 레인지(화구 넷, 오븐 문 선) + 위 후드 + 천장으로 가는 덕트
function P.Range(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local axis = Vector3.new(side.Z, 0, -side.X)
	local cf = frame(p, axis, -side)
	local m = model(ctx, "Range")
	local back = ctx.T / 2 - 1.6
	Kit.box(m, cf * CFrame.new(0, 1.6, back), Vector3.new(7.4, 3.2, 3.0)) -- 몸통
	for _, x in { -2.2, 2.2 } do
		for _, z in { -0.6, 0.6 } do
			local c = (cf * CFrame.new(x * 0.8, 3.2, back + z)).Position
			Kit.cylinder(m, c, c + Vector3.new(0, 0.12, 0), 0.45, { blocks = false, collide = false }) -- 화구
		end
	end
	Kit.box(m, cf * CFrame.new(0, 1.5, back - 1.52), Vector3.new(6.6, 0.08, 0.08), { blocks = false, collide = false }) -- 오븐 문 손잡이
	Kit.box(m, cf * CFrame.new(0, 7.0, back + 0.2), Vector3.new(7.8, 1.4, 3.4), { blocks = false }) -- 후드
	Kit.wedge(m, cf * CFrame.new(0, 8.2, back + 0.6) * CFrame.Angles(0, math.pi, 0), Vector3.new(7.0, 1.0, 2.6), { blocks = false, collide = false })
	Kit.box(m, cf * CFrame.new(0, 9.6, back + 1.0), Vector3.new(2.0, 1.8, 1.6), { blocks = false, collide = false }) -- 덕트
end

-- 스테인리스 조리대: 상판 + 다리 넷 + 아래 선반 + 위 선반(양념통)
function P.PrepTable(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "P")
	local cf = frame(p, axis, Vector3.new(axis.Z, 0, -axis.X))
	local m = model(ctx, "PrepTable")
	local L = ctx.T - 0.6
	Kit.box(m, cf * CFrame.new(0, 3.0, 0), Vector3.new(L, 0.15, 3.0), { blocks = false })
	Kit.box(m, cf * CFrame.new(0, 0.9, 0), Vector3.new(L - 0.4, 0.1, 2.6), { blocks = false, collide = false })
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.box(m, cf * CFrame.new(x * (L / 2 - 0.2), 1.5, z * 1.3), Vector3.new(0.15, 3.0, 0.15), { blocks = false, collide = false })
		end
	end
	local h = ctx.hash(i, j, 64)
	Kit.box(m, cf * CFrame.new((h - 0.5) * 3, 3.5, 0.4), Vector3.new(1.8, 0.8, 1.2), { blocks = false, collide = false }) -- 통
	Kit.box(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(L, 3, 3), { invisible = true, tag = false })
end

-- ── 세탁실·린넨실·하우스키핑 ──
-- 업소용 세탁기: 큰 상자 + 앞의 둥근 문(원통 테두리) + 위 조작판
function P.Washer(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local axis = Vector3.new(side.Z, 0, -side.X)
	local cf = frame(p, axis, -side)
	local m = model(ctx, "Washer")
	local back = ctx.T / 2 - 2.6
	Kit.box(m, cf * CFrame.new(0, 3.0, back), Vector3.new(5.6, 6.0, 5.0)) -- 몸통
	local doorC = cf * CFrame.new(0, 2.8, back - 2.5)
	Kit.cylinder(m, doorC.Position, (doorC * CFrame.new(0, 0, -0.35)).Position, 1.7, { blocks = false, collide = false }) -- 둥근 문
	Kit.cylinder(m, (doorC * CFrame.new(0, 0, -0.35)).Position, (doorC * CFrame.new(0, 0, -0.5)).Position, 1.1, { blocks = false, collide = false })
	Kit.box(m, cf * CFrame.new(0, 5.4, back - 2.55), Vector3.new(4.4, 0.8, 0.15), { blocks = false, collide = false }) -- 조작판
end

-- 린넨 선반: 철망 선반(기둥 넷 + 선반 넷) + 접힌 수건·시트 더미
function P.LinenShelf(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local axis = Vector3.new(side.Z, 0, -side.X)
	local cf = frame(p, axis, -side)
	local m = model(ctx, "LinenShelf")
	local back = ctx.T / 2 - 1.2
	local L = ctx.T - 0.8
	for _, x in { -1, 1 } do
		for _, z in { -0.9, 0.9 } do
			Kit.box(m, cf * CFrame.new(x * (L / 2 - 0.1), 3.6, back + z), Vector3.new(0.15, 7.2, 0.15), { blocks = false, axis = "Y" })
		end
	end
	for k, y in { 0.4, 2.3, 4.2, 6.1 } do
		Kit.box(m, cf * CFrame.new(0, y, back), Vector3.new(L, 0.1, 2.0), { blocks = false, collide = k == 1, shape = "None" })
		if k < 4 then
			local h = ctx.hash(i * 4 + k, j, 65)
			for q = -1, 1, 2 do
				Kit.box(m, cf * CFrame.new(q * 1.8 + (h - 0.5), y + 0.55, back), Vector3.new(2.6, 0.9 + h * 0.5, 1.6), { blocks = false, collide = false })
			end
		end
	end
	Kit.box(m, cf * CFrame.new(0, 3.6, back), Vector3.new(L, 7.2, 2.0), { invisible = true, tag = false })
end

-- 직원 사물함 줄: 벽에 붙은 좁은 사물함 셋(문 틈 선 + 환기 구멍 줄)
function P.StaffLockers(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local axis = Vector3.new(side.Z, 0, -side.X)
	local cf = frame(p, axis, -side)
	local m = model(ctx, "StaffLockers")
	local back = ctx.T / 2 - 1.0
	Kit.box(m, cf * CFrame.new(0, 3.6, back), Vector3.new(7.4, 7.2, 1.9))
	for _, x in { -1.23, 1.23 } do
		Kit.box(m, cf * CFrame.new(x, 3.6, back - 0.97), Vector3.new(0.08, 6.8, 0.08), { blocks = false, collide = false }) -- 문 틈
	end
	for _, x in { -2.46, 0, 2.46 } do
		Kit.box(m, cf * CFrame.new(x, 6.3, back - 0.97), Vector3.new(1.2, 0.5, 0.08), { blocks = false, collide = false }) -- 환기 구멍
		Kit.box(m, cf * CFrame.new(x + 0.8, 3.6, back - 1.0), Vector3.new(0.12, 0.6, 0.12), { blocks = false, collide = false }) -- 손잡이
	end
	Kit.box(m, cf * CFrame.new(0, 0.9, back - 2.2), Vector3.new(6.0, 0.25, 1.2), { blocks = false, collide = false }) -- 앞 긴 의자 상판
	for _, x in { -2.6, 2.6 } do
		Kit.box(m, cf * CFrame.new(x, 0.45, back - 2.2), Vector3.new(0.25, 0.9, 1.0), { blocks = false, collide = false })
	end
end

-- 하우스키핑 카트: 선반 셋 상자 + 한쪽 빨래 자루 + 반대쪽 손잡이 + 바퀴
function P.HousekeepingCart(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local axis = Vector3.new(side.Z, 0, -side.X)
	local cf = frame(p, axis, -side) * CFrame.new(0, 0, ctx.T / 2 - 2.0)
	local m = model(ctx, "HousekeepingCart")
	Kit.box(m, cf * CFrame.new(0, 0.6, 0), Vector3.new(4.6, 0.2, 2.2), { blocks = false })
	Kit.box(m, cf * CFrame.new(0, 2.2, 0), Vector3.new(4.6, 0.15, 2.2), { blocks = false, collide = false })
	Kit.box(m, cf * CFrame.new(0, 3.8, 0), Vector3.new(4.6, 0.2, 2.2), { blocks = false })
	for _, x in { -2.2, 2.2 } do
		Kit.box(m, cf * CFrame.new(x, 2.2, 0), Vector3.new(0.2, 3.4, 2.2), { blocks = false })
	end
	Kit.box(m, cf * CFrame.new(-0.8, 3.0, 0), Vector3.new(1.6, 1.4, 1.6), { blocks = false, collide = false }) -- 수건 더미
	Kit.box(m, cf * CFrame.new(1.0, 4.3, 0), Vector3.new(1.0, 0.8, 0.8), { blocks = false, collide = false }) -- 세제통
	Kit.box(m, cf * CFrame.new(3.3, 2.0, 0), Vector3.new(1.8, 3.2, 2.0), { blocks = false }) -- 빨래 자루
	Kit.cylinder(m, (cf * CFrame.new(-2.9, 3.6, -0.9)).Position, (cf * CFrame.new(-2.9, 3.6, 0.9)).Position, 0.1, { blocks = false, collide = false }) -- 손잡이
	for _, x in { -1.9, 1.9 } do
		Kit.cylinder(m, (cf * CFrame.new(x, 0.3, -1.15)).Position, (cf * CFrame.new(x, 0.3, 1.15)).Position, 0.3, { blocks = false, collide = false })
	end
	Kit.box(m, cf * CFrame.new(0.5, 2.2, 0), Vector3.new(6.6, 4.4, 2.4), { invisible = true, tag = false })
end

-- 제빙기·자판기: 키 큰 상자 + 앞 비스듬한 얼음 칸 문 + 앞면 패널 선
function P.IceMachine(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local axis = Vector3.new(side.Z, 0, -side.X)
	local cf = frame(p, axis, -side)
	local m = model(ctx, "IceMachine")
	local back = ctx.T / 2 - 1.8
	local tall = ctx.hash(i, j, 66) > 0.5
	if tall then -- 자판기
		Kit.box(m, cf * CFrame.new(0, 3.5, back), Vector3.new(4.2, 7.0, 3.2))
		Kit.box(m, cf * CFrame.new(-0.6, 4.4, back - 1.62), Vector3.new(2.6, 4.0, 0.08), { blocks = false, collide = false }) -- 진열 창
		Kit.box(m, cf * CFrame.new(1.4, 4.4, back - 1.62), Vector3.new(0.6, 1.6, 0.08), { blocks = false, collide = false }) -- 버튼 판
		Kit.box(m, cf * CFrame.new(-0.6, 1.2, back - 1.62), Vector3.new(2.4, 0.8, 0.08), { blocks = false, collide = false }) -- 꺼내는 곳
	else -- 제빙기
		Kit.box(m, cf * CFrame.new(0, 2.4, back), Vector3.new(4.0, 4.8, 3.2))
		Kit.box(m, cf * CFrame.new(0, 5.6, back + 0.2), Vector3.new(3.6, 1.6, 2.6), { blocks = false })
		Kit.wedge(m, cf * CFrame.new(0, 3.6, back - 1.8) * CFrame.Angles(0, math.pi, 0), Vector3.new(3.4, 1.6, 0.5), { blocks = false, collide = false })
		Kit.box(m, cf * CFrame.new(0, 1.0, back - 1.62), Vector3.new(3.2, 0.5, 0.08), { blocks = false, collide = false }) -- 바람 구멍
	end
end

-- 엘리베이터 문: 벽에 붙은 문틀 + 두 짝 문(가운데 틈) + 위 층 표시판 + 옆 호출 버튼
function P.Elevator(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local axis = Vector3.new(side.Z, 0, -side.X)
	local cf = frame(p, axis, -side)
	local m = model(ctx, "Elevator")
	local wz = ctx.T / 2 - 0.3 -- 벽 바로 앞
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 2.7, 4.0, wz), Vector3.new(0.6, 8.0, 0.6), { blocks = false, axis = "Y" }) -- 문틀 기둥
		Kit.box(m, cf * CFrame.new(s * 1.2, 3.75, wz + 0.1), Vector3.new(2.3, 7.5, 0.2), { blocks = false }) -- 문짝
	end
	Kit.box(m, cf * CFrame.new(0, 8.2, wz), Vector3.new(6.0, 0.6, 0.6), { blocks = false }) -- 문틀 위
	Kit.box(m, cf * CFrame.new(0, 9.1, wz + 0.1), Vector3.new(2.0, 0.7, 0.15), { blocks = false, collide = false }) -- 층 표시판
	Kit.box(m, cf * CFrame.new(3.4, 4.2, wz + 0.1), Vector3.new(0.5, 1.0, 0.12), { blocks = false, collide = false }) -- 호출 버튼
	Kit.box(m, cf * CFrame.new(0, 4.0, wz), Vector3.new(6.0, 8.0, 1.0), { invisible = true, tag = false })
end

return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">Kindergarten</string>
            <string name="Source"><![CDATA[--!nonstrict
-- 챕터 8 폐유치원 전용 소품(타일 문자 → 함수). Stage8.luau 의 Props 줄에서 쓴다.
-- MapKit 부품만(검은 무광, 음파 윤곽선). 모든 것이 어른 허리보다 낮다 — 괴물이 오히려 커 보이게. 막는 소품은 보이지 않는 충돌 상자를 둔다.
--   W 신발장(현관)      r 안내 창구         T 모둠 책상 + 작은 의자 넷    B 칠판 + 자석 글자판(벽)   k 가방장(벽)
--   P 풍금 + 의자       h 앞면 책장         M 쌓인 낮잠 매트              i 놀이집(지붕 있는 작은 집) X 큰 스펀지 블록
--   x 보건실 침대       I 어린이 세면대(벽)  a 유희실 무대                 F 낮은 식탁(긴 의자)       V 배식대
--   R 조리대 + 후드(벽) K 조리 작업대        J 정글짐                      w 그네                    e 시소
--   H 스프링 목마       g 모래밭(지나감)     u 화분 상자(벽)

local Kit = require(script.Parent.Parent.MapKit)

local P = {}

local LINE = { blocks = false, collide = false }
local SOFT = { blocks = false }

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

local function wallSide(ctx, i: number, j: number): Vector3?
	for _, d in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local function model(ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end

local function solid(m: Instance, cf: CFrame, size: Vector3)
	Kit.box(m, cf * CFrame.new(0, size.Y / 2, 0), size, { invisible = true, tag = false })
end

-- 같은 문자가 이어지는 방향(세로면 Z, 아니면 X)
local function runAxis(ctx, i: number, j: number, ch: string): Vector3
	if ctx.at(i, j - 1) == ch or ctx.at(i, j + 1) == ch then
		return Vector3.new(0, 0, 1)
	end
	return Vector3.new(1, 0, 0)
end

-- 벽을 등진 좌표계: 로컬 -Z = 방 안쪽, +Z = 벽 쪽
local function againstWall(ctx, i: number, j: number): CFrame
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	return CFrame.lookAt(p, p - side)
end

local function at(cf: CFrame, x: number, y: number, z: number): Vector3
	return (cf * CFrame.new(x, y, z)).Position
end

-- 낮은 어린이 의자(등받이 한 장)
local function kidChair(m: Instance, cf: CFrame)
	Kit.box(m, cf * CFrame.new(0, 1.1, 0), Vector3.new(1.1, 0.14, 1.1), LINE)
	Kit.box(m, cf * CFrame.new(0, 1.75, 0.5), Vector3.new(1.1, 1.0, 0.12), LINE)
	Kit.box(m, cf * CFrame.new(0, 0.55, 0), Vector3.new(0.8, 1.1, 0.12), LINE)
end

-- W 신발장: 현관의 낮은 칸칸이 선반(양면), 위에 실내화 한두 켤레
function P.ShoeCubby(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + runAxis(ctx, i, j, "W"))
	local m = model(ctx, "ShoeCubby")
	local L, h = ctx.T, 3.4
	Kit.box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(2.6, h, L))
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 1.34, h / 2, 0), Vector3.new(0.08, 0.12, L - 0.2), LINE)
		for k = -1, 1 do
			Kit.box(m, cf * CFrame.new(s * 1.34, h / 2, k * L / 4), Vector3.new(0.08, h - 0.2, 0.12), LINE)
		end
	end
	if ctx.hash(i, j, 3) > 0.4 then
		for _, x in { -0.4, 0.4 } do
			Kit.box(m, cf * CFrame.new(x, h + 0.2, (ctx.hash(i, j, 4) - 0.5) * 4), Vector3.new(0.5, 0.35, 1.1), LINE)
		end
	end
end

-- r 안내 창구: 어른 허리 높이 카운터 + 유리 틀 + 출석부
function P.Reception(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + runAxis(ctx, i, j, "r"))
	local m = model(ctx, "Reception")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 1.7, 0), Vector3.new(2.6, 3.4, L))
	Kit.box(m, cf * CFrame.new(0, 3.5, 0), Vector3.new(3.4, 0.2, L), LINE)
	for _, z in { -L / 2 + 0.2, L / 2 - 0.2 } do
		Kit.box(m, cf * CFrame.new(0, 5.4, z), Vector3.new(0.2, 3.6, 0.2), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 7.2, 0), Vector3.new(0.2, 0.2, L), LINE)
	Kit.box(m, cf * CFrame.new(0.4, 3.7, 1.2) * CFrame.Angles(0, 0.3, 0), Vector3.new(1.2, 0.15, 1.6), LINE)
end

-- T 모둠 책상: 육각으로 읽히는 둥근 판 + 작은 의자 넷(하나는 넘어졌다)
function P.KidTable(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, (ctx.hash(i, j, 3) - 0.5) * 0.8, 0)
	local m = model(ctx, "KidTable")
	Kit.cylinder(m, at(cf, 0, 2.0, 0), at(cf, 0, 2.2, 0), 1.7, SOFT)
	for k = 0, 2 do
		local a = k * 2 * math.pi / 3
		Kit.cylinder(m, at(cf, math.cos(a) * 1.2, 0, math.sin(a) * 1.2), at(cf, math.cos(a) * 1.2, 2.0, math.sin(a) * 1.2), 0.1, LINE)
	end
	local n = 3
	for k = 0, n - 1 do
		kidChair(m, cf * CFrame.Angles(0, k * 2 * math.pi / n + 0.4, 0) * CFrame.new(0, 0, 2.5) * CFrame.Angles(0, (ctx.hash(i, j, 5 + k) - 0.5) * 0.6, 0))
	end
	if ctx.hash(i, j, 9) > 0.5 then
		kidChair(m, cf * CFrame.new(-2.4, 0.6, -1.8) * CFrame.Angles(math.pi / 2, 0.6, 0))
	end
	solid(m, cf, Vector3.new(4.4, 2.4, 4.4))
end

-- B 칠판(벽, 낮게) + 자석 글자판 + 아래 교구 선반
function P.Board(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Board")
	local z = ctx.T / 2 - 0.25
	Kit.box(m, cf * CFrame.new(0, 5.0, z), Vector3.new(13, 3.8, 0.2), LINE)
	Kit.box(m, cf * CFrame.new(0, 5.0, z - 0.14), Vector3.new(12.2, 3.0, 0.08), LINE)
	for k = 0, 3 do -- 자석 글자(네모·세모 조각)
		local r = ctx.hash(i, j, 20 + k)
		Kit.box(m, cf * CFrame.new(-4.2 + k * 1.5, 4.6 + r * 1.2, z - 0.22) * CFrame.Angles(0, 0, r * 2), Vector3.new(0.7, 0.7, 0.06), LINE)
	end
	-- 해 그림(원 하나)
	Kit.cylinder(m, at(cf, 4.2, 5.4, z - 0.2), at(cf, 4.2, 5.4, z - 0.28), 0.8, LINE)
	-- 낮은 교구 선반
	Kit.box(m, cf * CFrame.new(0, 1.2, z - 0.9), Vector3.new(7.2, 2.4, 1.6), SOFT)
	for k = -1, 1 do
		Kit.box(m, cf * CFrame.new(k * 1.8, 1.2, z - 1.74), Vector3.new(0.1, 2.2, 0.08), LINE)
	end
	solid(m, cf * CFrame.new(0, 0, z - 0.9), Vector3.new(7.2, 2.6, 1.8))
end

-- k 가방장: 벽에 붙은 칸칸이 장 + 걸린 가방
function P.BagCubby(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "BagCubby")
	local z = ctx.T / 2 - 0.9
	local h = 4.4
	Kit.box(m, cf * CFrame.new(0, h / 2, z), Vector3.new(7.2, h, 1.6))
	Kit.box(m, cf * CFrame.new(0, h * 0.32, z - 0.84), Vector3.new(7.0, 0.12, 0.08), LINE)
	for k = -1, 1 do
		Kit.box(m, cf * CFrame.new(k * 1.8, h / 2, z - 0.84), Vector3.new(0.1, h - 0.2, 0.08), LINE)
	end
	local s = math.floor(ctx.hash(i, j, 6) * 4)
	local x = -2.7 + s * 1.8
	Kit.box(m, cf * CFrame.new(x, 2.6, z - 1.1), Vector3.new(1.1, 1.3, 0.6), LINE) -- 남은 가방
	solid(m, cf * CFrame.new(0, 0, z), Vector3.new(7.2, h, 1.8))
end

-- P 풍금 + 작은 의자
function P.Organ(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Organ")
	Kit.box(m, cf * CFrame.new(0, 2.1, 2.6), Vector3.new(5.6, 4.2, 1.8))
	Kit.box(m, cf * CFrame.new(0, 2.4, 1.2), Vector3.new(5.4, 0.35, 1.2), SOFT)
	for k = -3, 3 do
		Kit.box(m, cf * CFrame.new(k * 0.7, 2.62, 1.0), Vector3.new(0.16, 0.1, 0.8), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 4.9, 2.4) * CFrame.Angles(0.25, 0, 0), Vector3.new(2.6, 1.3, 0.1), LINE)
	for _, x in { -2.5, 2.5 } do
		Kit.box(m, cf * CFrame.new(x, 1.1, 0.8), Vector3.new(0.3, 2.2, 0.3), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 1.5, -0.8), Vector3.new(2.4, 0.3, 1.2), SOFT)
	for _, x in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(x, 0.7, -0.8), Vector3.new(0.2, 1.4, 1.0), LINE)
	end
	solid(m, cf * CFrame.new(0, 0, 1.8), Vector3.new(5.8, 4.2, 3.2))
end

-- h 앞면 책장: 낮은 2단(양쪽에서 책 표지가 보이는 경사 선반)
function P.KidShelf(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + runAxis(ctx, i, j, "h"))
	local m = model(ctx, "KidShelf")
	local L, h = ctx.T, 4.2
	for _, z in { -L / 2 + 0.15, L / 2 - 0.15 } do
		Kit.box(m, cf * CFrame.new(0, h / 2, z), Vector3.new(2.6, h, 0.25), SOFT)
	end
	Kit.box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(0.3, h, L - 0.4))
	for _, y in { 0.3, 2.2 } do
		Kit.box(m, cf * CFrame.new(0, y, 0), Vector3.new(2.6, 0.15, L - 0.4), LINE)
	end
	for k = 0, 3 do -- 세워 둔 그림책 몇 권
		local r = ctx.hash(i, j, 30 + k)
		local s = if k % 2 == 0 then 1 else -1
		Kit.box(m, cf * CFrame.new(s * 0.7, (if k < 2 then 1.1 else 3.0), (r - 0.5) * (L - 3)) * CFrame.Angles(0, 0, s * 0.3), Vector3.new(0.12, 1.4, 1.2), LINE)
	end
	solid(m, cf, Vector3.new(2.6, h, L))
end

-- M 쌓인 낮잠 매트 + 접은 이불
function P.MatPile(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "MatPile")
	for k = 0, 4 do
		local r = ctx.hash(i, j, 10 + k)
		Kit.box(m, cf * CFrame.new((r - 0.5) * 0.7, 0.3 + k * 0.62, 1.6) * CFrame.Angles(0, (r - 0.5) * 0.15, 0), Vector3.new(5.6, 0.55, 3.0), SOFT)
	end
	Kit.box(m, cf * CFrame.new(0.4, 3.5, 1.6) * CFrame.Angles(0, 0.2, 0), Vector3.new(2.6, 0.6, 2.0), LINE)
	solid(m, cf * CFrame.new(0, 0, 1.6), Vector3.new(6, 3.6, 3.4))
end

-- i 놀이집: 어린이 키만 한 집(벽 네 장·문 구멍·뾰족 지붕)
function P.Playhouse(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Playhouse")
	local w, h = 5.6, 4.0
	Kit.box(m, cf * CFrame.new(0, h / 2, 2.6), Vector3.new(w, h, 0.2))
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * w / 2, h / 2, 0), Vector3.new(0.2, h, 5.2))
		Kit.box(m, cf * CFrame.new(s * 2.0, h / 2, -2.6), Vector3.new(1.6, h, 0.2), SOFT)
		Kit.box(m, cf * CFrame.new(s * 1.6, h + 1.1, 0) * CFrame.Angles(0, 0, -s * 0.62), Vector3.new(4.2, 0.25, 6.2), SOFT)
	end
	Kit.box(m, cf * CFrame.new(0, 3.6, -2.6), Vector3.new(2.4, 0.8, 0.2), LINE)
	for _, s in { -1, 1 } do -- 창틀
		Kit.box(m, cf * CFrame.new(s * (w / 2 + 0.12), 2.6, 0), Vector3.new(0.06, 1.3, 1.6), LINE)
	end
	-- 안에 앉은 인형
	Kit.ball(m, at(cf, 0.4, 0.8, 1.2), 0.8, LINE)
	Kit.ball(m, at(cf, 0.4, 2.0, 1.2), 0.6, LINE)
	solid(m, cf, Vector3.new(5.8, 5.4, 5.4))
end

-- X 큰 스펀지 블록(아치·원기둥·삼각)
function P.SoftBlocks(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, math.floor(ctx.hash(i, j, 3) * 4) * math.pi / 2, 0)
	local m = model(ctx, "SoftBlocks")
	Kit.box(m, cf * CFrame.new(-1.8, 1.4, 0), Vector3.new(1.6, 2.8, 2.4), SOFT)
	Kit.box(m, cf * CFrame.new(1.8, 1.4, 0), Vector3.new(1.6, 2.8, 2.4), SOFT)
	Kit.box(m, cf * CFrame.new(0, 3.4, 0), Vector3.new(5.4, 1.2, 2.4), SOFT)
	Kit.wedge(m, cf * CFrame.new(0, 4.8, 0), Vector3.new(2.4, 1.6, 2.6), LINE)
	Kit.cylinder(m, at(cf, -1.2, 1.0, 2.6), at(cf, 1.4, 1.0, 2.6), 1.0, LINE)
	Kit.box(m, cf * CFrame.new(2.4, 0.7, -2.4) * CFrame.Angles(0, 0.5, 0), Vector3.new(1.4, 1.4, 1.4), LINE)
	solid(m, cf, Vector3.new(5.6, 4.2, 4))
end

-- x 보건실 어린이 침대 + 걷힌 커튼
function P.SickBed(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "SickBed")
	Kit.box(m, cf * CFrame.new(0, 1.7, 1.0), Vector3.new(3.0, 0.5, 5.0), SOFT)
	Kit.box(m, cf * CFrame.new(0, 2.1, 2.8), Vector3.new(2.0, 0.4, 1.0), LINE)
	for _, x in { -1.4, 1.4 } do
		for _, z in { -1.4, 3.4 } do
			Kit.cylinder(m, at(cf, x, 0, z), at(cf, x, if z > 0 then 3.0 else 2.4, z), 0.1, LINE)
		end
	end
	Kit.box(m, cf * CFrame.new(0, 2.6, 3.4), Vector3.new(2.8, 0.8, 0.1), LINE)
	-- 커튼 레일과 한쪽으로 몰린 커튼
	Kit.cylinder(m, at(cf, 2.6, 7.2, 3.6), at(cf, 2.6, 7.2, -2.6), 0.08, LINE)
	Kit.box(m, cf * CFrame.new(2.6, 4.2, 2.8), Vector3.new(0.5, 5.6, 1.4), LINE)
	solid(m, cf * CFrame.new(0, 0, 1.0), Vector3.new(3.2, 2.6, 5.4))
end

-- I 어린이 세면대: 무릎 높이 긴 개수대 + 낮은 거울 + 수도 셋
function P.KidSink(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "KidSink")
	local z = ctx.T / 2 - 1.1
	Kit.box(m, cf * CFrame.new(0, 1.8, z), Vector3.new(7.0, 0.8, 2.0), SOFT)
	Kit.box(m, cf * CFrame.new(0, 0.7, z + 0.4), Vector3.new(6.0, 1.4, 1.0), SOFT)
	for _, x in { -2.2, 0, 2.2 } do
		Kit.cylinder(m, at(cf, x, 2.2, z + 0.7), at(cf, x, 3.0, z + 0.7), 0.1, LINE)
		Kit.cylinder(m, at(cf, x, 3.0, z + 0.7), at(cf, x, 2.9, z), 0.1, LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 4.4, ctx.T / 2 - 0.25), Vector3.new(6.8, 1.8, 0.1), LINE)
	solid(m, cf * CFrame.new(0, 0, z), Vector3.new(7.2, 2.4, 2.2))
end

-- a 유희실 무대 한 칸: 무릎 높이 단 + 앞판 + 뒤 막 주름 + 위 장식 띠
function P.Stage(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Stage")
	local T = ctx.T
	Kit.box(m, cf * CFrame.new(0, 0.9, 0), Vector3.new(T, 1.8, T - 0.6), SOFT)
	Kit.box(m, cf * CFrame.new(0, 0.9, -T / 2 + 0.25), Vector3.new(T - 0.4, 1.4, 0.1), LINE)
	for k = -1, 1 do
		Kit.box(m, cf * CFrame.new(k * 2.6, 5.6, T / 2 - 0.5), Vector3.new(1.2, 7.4, 0.5), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 9.4, T / 2 - 1.0), Vector3.new(T, 1.0, 0.2), LINE)
	solid(m, cf, Vector3.new(T, 2.0, T - 0.6))
end

-- F 낮은 식탁: 긴 상 + 붙은 긴 의자, 식판
function P.LunchTable(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + runAxis(ctx, i, j, "F"))
	local m = model(ctx, "KidLunchTable")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 2.0, 0), Vector3.new(2.4, 0.2, L), SOFT)
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 2.0, 1.1, 0), Vector3.new(0.9, 0.16, L), LINE)
	end
	for _, z in { -2.6, 2.6 } do
		Kit.box(m, cf * CFrame.new(0, 1.0, z), Vector3.new(0.3, 2.0, 0.3), LINE)
		Kit.box(m, cf * CFrame.new(0, 0.5, z), Vector3.new(4.2, 0.2, 0.25), LINE)
	end
	for k = 0, 1 do
		if ctx.hash(i, j, 22 + k) > 0.5 then
			Kit.box(m, cf * CFrame.new(0.4, 2.2, -2 + k * 3.4) * CFrame.Angles(0, 0.3, 0), Vector3.new(1.3, 0.12, 0.9), LINE)
		end
	end
	solid(m, cf, Vector3.new(4.8, 2.2, L))
end

-- V 배식대: 카운터 + 국통 + 위 선반
function P.ServingCounter(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + runAxis(ctx, i, j, "V"))
	local m = model(ctx, "ServingCounter")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(2.8, 3.0, L))
	Kit.box(m, cf * CFrame.new(0, 3.1, 0), Vector3.new(3.4, 0.2, L), LINE)
	for _, z in { -L / 2 + 0.3, L / 2 - 0.3 } do
		Kit.box(m, cf * CFrame.new(0, 4.4, z), Vector3.new(0.2, 2.6, 0.2), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 5.8, 0), Vector3.new(2.2, 0.2, L), LINE)
	local c = at(cf, 0, 3.2, (ctx.hash(i, j, 25) - 0.5) * 3)
	Kit.cylinder(m, c, c + Vector3.new(0, 1.2, 0), 1.0, LINE)
end

-- R 조리대(벽): 화구 둘 + 큰 솥 + 배기 후드
function P.Range(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Range")
	local z = ctx.T / 2 - 1.6
	local y = math.min(ctx.H - 4, 8)
	Kit.box(m, cf * CFrame.new(0, 1.6, z), Vector3.new(7.8, 3.2, 3.0))
	for _, x in { -1.9, 1.9 } do
		Kit.cylinder(m, at(cf, x, 3.25, z), at(cf, x, 3.4, z), 1.1, LINE)
		Kit.box(m, cf * CFrame.new(x, 1.6, z - 1.54), Vector3.new(3.2, 2.2, 0.08), LINE)
	end
	local pot = at(cf, if ctx.hash(i, j, 4) > 0.5 then 1.9 else -1.9, 3.4, z)
	Kit.cylinder(m, pot, pot + Vector3.new(0, 1.8, 0), 1.2, LINE)
	-- 배기 후드와 덕트
	Kit.box(m, cf * CFrame.new(0, y, z), Vector3.new(7.6, 1.4, 3.2), SOFT)
	Kit.box(m, cf * CFrame.new(0, (y + 0.7 + ctx.H) / 2, z + 0.6), Vector3.new(2.0, ctx.H - y - 0.7, 1.6), LINE)
	solid(m, cf * CFrame.new(0, 0, z), Vector3.new(7.8, 3.4, 3.2))
end

-- K 조리 작업대: 스테인리스 상판 + 아래 선반 + 도마·양동이
function P.PrepTable(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + runAxis(ctx, i, j, "K"))
	local m = model(ctx, "PrepTable")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 3.2, 0), Vector3.new(3.6, 0.3, L), SOFT)
	Kit.box(m, cf * CFrame.new(0, 0.9, 0), Vector3.new(3.2, 0.15, L - 0.4), LINE)
	for _, x in { -1.6, 1.6 } do
		for _, z in { -L / 2 + 0.4, L / 2 - 0.4 } do
			Kit.box(m, cf * CFrame.new(x, 1.6, z), Vector3.new(0.2, 3.2, 0.2), LINE)
		end
	end
	Kit.box(m, cf * CFrame.new(0.3, 3.45, (ctx.hash(i, j, 5) - 0.5) * 4) * CFrame.Angles(0, 0.4, 0), Vector3.new(1.2, 0.15, 1.8), LINE)
	local c = at(cf, -0.2, 1.0, (ctx.hash(i, j, 6) - 0.5) * 4)
	Kit.cylinder(m, c, c + Vector3.new(0, 1.2, 0), 0.8, LINE)
	solid(m, cf, Vector3.new(3.6, 3.4, L))
end

-- J 정글짐: 3x3 기둥 + 두 층 가로대
function P.JungleGym(ctx, i: number, j: number)
	local cf = CFrame.new(base(ctx, i, j))
	local m = model(ctx, "JungleGym")
	local s, h = 2.8, 7.2
	for _, x in { -s, 0, s } do
		for _, z in { -s, s } do
			Kit.cylinder(m, at(cf, x, 0, z), at(cf, x, h, z), 0.14, LINE)
		end
	end
	for _, y in { 2.4, 4.8, 7.2 } do
		for _, z in { -s, s } do
			Kit.cylinder(m, at(cf, -s, y, z), at(cf, s, y, z), 0.11, LINE)
		end
		for _, x in { -s, 0, s } do
			Kit.cylinder(m, at(cf, x, y, -s), at(cf, x, y, s), 0.11, LINE)
		end
	end
	solid(m, cf, Vector3.new(s * 2 + 0.3, h, s * 2 + 0.3))
end

-- w 그네: A 자 다리 + 가로대 + 줄에 매달린 자리(하나는 비뚤어져 멈춰 있다)
function P.Swing(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + Vector3.new(0, 0, -1)) -- 가로대는 X 방향
	local m = model(ctx, "Swing")
	local L, h = ctx.T, 7.4
	for _, x in { -L / 2 + 0.3, L / 2 - 0.3 } do
		for _, z in { -2.0, 2.0 } do
			Kit.cylinder(m, at(cf, x, 0, z), at(cf, x, h, 0), 0.16, LINE)
		end
	end
	Kit.cylinder(m, at(cf, -L / 2 + 0.3, h, 0), at(cf, L / 2 - 0.3, h, 0), 0.16, LINE)
	local off = (ctx.hash(i, j, 4) - 0.5) * 2.4
	for _, x in { -0.9, 0.9 } do
		Kit.cylinder(m, at(cf, x, h, 0), at(cf, x, 1.6 + math.abs(off) * 0.3, off), 0.06, LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 1.5 + math.abs(off) * 0.3, off) * CFrame.Angles(off * 0.15, 0, 0), Vector3.new(2.0, 0.18, 0.9), LINE)
	solid(m, cf, Vector3.new(L - 0.4, 6, 3.4))
end

-- e 시소: 받침 + 기운 긴 판 + 손잡이
function P.Seesaw(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, ctx.hash(i, j, 3) * 1.2 - 0.6, 0)
	local m = model(ctx, "Seesaw")
	Kit.wedge(m, cf * CFrame.new(0, 0.9, 0.6), Vector3.new(1.6, 1.8, 1.2), SOFT)
	Kit.wedge(m, cf * CFrame.new(0, 0.9, -0.6) * CFrame.Angles(0, math.pi, 0), Vector3.new(1.6, 1.8, 1.2), SOFT)
	local plank = cf * CFrame.new(0, 2.0, 0) * CFrame.Angles(0.22, 0, 0)
	Kit.box(m, plank, Vector3.new(1.2, 0.22, 7.6), SOFT)
	for _, z in { -2.4, 2.4 } do
		Kit.cylinder(m, at(plank, -0.5, 0, z), at(plank, -0.5, 1.2, z), 0.08, LINE)
		Kit.cylinder(m, at(plank, 0.5, 0, z), at(plank, 0.5, 1.2, z), 0.08, LINE)
		Kit.cylinder(m, at(plank, -0.5, 1.2, z), at(plank, 0.5, 1.2, z), 0.08, LINE)
	end
	solid(m, cf, Vector3.new(2.2, 2.6, 7.2))
end

-- H 스프링 목마: 용수철 + 말 몸통·목·머리
function P.SpringHorse(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, ctx.hash(i, j, 3) * 6.28, 0) * CFrame.new(0, 0, 0)
	local m = model(ctx, "SpringHorse")
	for k = 0, 3 do -- 용수철 고리
		Kit.cylinder(m, at(cf, 0, 0.2 + k * 0.45, 0), at(cf, 0, 0.35 + k * 0.45, 0), 0.7, LINE)
	end
	local body = cf * CFrame.new(0, 2.6, 0) * CFrame.Angles((ctx.hash(i, j, 5) - 0.5) * 0.4, 0, 0)
	Kit.box(m, body, Vector3.new(1.2, 1.3, 3.2), SOFT)
	Kit.box(m, body * CFrame.new(0, 1.2, -1.5) * CFrame.Angles(0.5, 0, 0), Vector3.new(0.8, 2.0, 0.9), LINE)
	Kit.box(m, body * CFrame.new(0, 2.0, -2.2) * CFrame.Angles(-0.4, 0, 0), Vector3.new(0.8, 0.9, 1.6), LINE)
	Kit.cylinder(m, at(body, -1.1, 1.5, -1.5), at(body, 1.1, 1.5, -1.5), 0.1, LINE) -- 손잡이
	Kit.box(m, body * CFrame.new(0, 0.4, 1.8) * CFrame.Angles(0.5, 0, 0), Vector3.new(0.3, 1.4, 0.3), LINE) -- 꼬리
	solid(m, cf, Vector3.new(2.4, 4, 3.6))
end

-- g 모래밭(지나간다): 가장자리 턱 + 버려진 양동이·삽
function P.Sand(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Sand")
	for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		if ctx.at(i + d[1], j + d[2]) ~= "g" and not ctx.isWall(i + d[1], j + d[2]) then
			local v = Vector3.new(d[1], 0, d[2])
			local e = p + v * (ctx.T / 2 - 0.3) + Vector3.new(0, 0.25, 0)
			Kit.box(m, CFrame.lookAt(e, e + v), Vector3.new(ctx.T, 0.5, 0.6), LINE)
		end
	end
	local r = ctx.hash(i, j, 8)
	if r > 0.75 then
		local c = p + Vector3.new((r - 0.85) * 12, 0, 1)
		Kit.cylinder(m, c, c + Vector3.new(0, 1.0, 0), 0.6, LINE)
	elseif r < 0.2 then
		Kit.ball(m, p + Vector3.new(0.6, 0.1, -0.8), 1.2, LINE) -- 모래 무더기
	end
end

-- u 화분 상자(벽): 나무 상자 + 마른 줄기
function P.Planter(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Planter")
	local z = ctx.T / 2 - 1.2
	Kit.box(m, cf * CFrame.new(0, 0.8, z), Vector3.new(6.2, 1.6, 2.0))
	for k = 0, 3 do
		local r = ctx.hash(i, j, 12 + k)
		Kit.cylinder(m, at(cf, -2.2 + k * 1.5, 1.6, z), at(cf, -2.2 + k * 1.5 + (r - 0.5) * 1.6, 3.2 + r * 1.2, z - (r - 0.3)), 0.08, LINE)
	end
	solid(m, cf * CFrame.new(0, 0, z), Vector3.new(6.2, 2, 2.2))
end

return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="142">
          <Properties>
            <string name="Name">Maze</string>
            <string name="Source"><![CDATA[--!nonstrict
-- 챕터 5 심층 미로(버려진 지하 채석장 납골당 = 카타콤) 전용 소품. 모두 MapKit 부품만 쓴다(검은 무광 + 음파 윤곽).
-- 각 함수는 StageBuilder 의 ctx 와 타일 좌표(i, j)를 받는다. 1칸 = 8스터드, 사람 키 약 5스터드, 천장 14.
--   B 석조 보강 기둥       U 뼈 더미 벽(섬)       u 벽면에 붙여 쌓은 뼈(얇음, 밟고 지나감)   Q 해골 원통(랜드마크)
--   K 석회암 석재 블록     W 손 권양기            R 광차                                  r 광차 레일(바닥, 밟고 지나감)
--   N 갱도 이름 벽 명판    P 예배당 신도석        J 제단 + 벽 십자가                       Y 채석공 우물
--   G 수직갱 권양탑        I 지상으로 오르는 나선 계단(입구)                               V 석관
--   H 납골당 문틀(명문 판, 밟고 지나감)  F 붕락 돌무더기(무너진 갱도)  l 무덤 등불(불 그릇 기둥)  M 채석공 요새 부조
local Kit = require(script.Parent.Parent.MapKit)

local M = {}

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

-- 가장 가까운 벽 방향(없으면 nil)
local function wallSide(ctx, i: number, j: number): Vector3?
	for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local function model(ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end

local function height(ctx, i: number, j: number): number
	return ctx.H - ctx.floorY(i, j)
end

-- B: 석조 보강 기둥(채석 갱도 천장을 받치는 쌓은 돌 기둥) — 받침·몸·머리 세 덩어리, 줄눈 띠 둘
function M.Pillar(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local h = height(ctx, i, j)
	local m = model(ctx, "MasonryPillar")
	Kit.box(m, CFrame.new(p + Vector3.new(0, h / 2, 0)), Vector3.new(4.4, h, 4.4), { name = "Pillar" })
	Kit.box(m, CFrame.new(p + Vector3.new(0, 0.6, 0)), Vector3.new(6, 1.2, 6))
	Kit.box(m, CFrame.new(p + Vector3.new(0, h - 1.2, 0)), Vector3.new(6, 2.4, 6))
	for _, y in { h * 0.38, h * 0.66 } do
		Kit.box(m, CFrame.new(p + Vector3.new(0, y, 0)), Vector3.new(4.7, 0.25, 4.7), { blocks = false, collide = false })
	end
end

-- 해골 한 줄(뼈 벽 앞면): from → to 사이에 공 n 개
local function skullRow(m: Instance, a: Vector3, b: Vector3, n: number, r: number)
	for k = 0, n - 1 do
		local t = if n == 1 then 0.5 else k / (n - 1)
		Kit.ball(m, a:Lerp(b, t), r, { blocks = false, collide = false })
	end
end

-- U: 뼈 더미 벽(통로 가운데 섬) — 정강이뼈를 벽돌처럼 쌓고 해골 띠 두 줄을 박은 낮은 담. 어른 키보다 조금 높다
function M.BoneStack(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "BoneStack")
	local h = 6.2
	Kit.box(m, CFrame.new(p + Vector3.new(0, h / 2, 0)), Vector3.new(7.2, h, 5.6), { name = "Bones" })
	-- 해골 띠(긴 쪽 양면) + 위를 덮은 뼈 갓돌
	for _, s in { -1, 1 } do
		local z = s * 2.85
		skullRow(m, p + Vector3.new(-2.8, 2.2, z), p + Vector3.new(2.8, 2.2, z), 4, 0.45)
		skullRow(m, p + Vector3.new(-2.8, 4.6, z), p + Vector3.new(2.8, 4.6, z), 4, 0.45)
	end
	Kit.box(m, CFrame.new(p + Vector3.new(0, h + 0.2, 0)), Vector3.new(7.4, 0.4, 5.9), { blocks = false })
end

-- u: 벽면에 붙여 쌓은 뼈(두께 1.1) — 벽 장식이라 칸은 그대로 밟고 지나간다
function M.BoneFacing(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	if not side then
		return
	end
	local m = model(ctx, "BoneFacing")
	local along = Vector3.new(side.Z, 0, -side.X)
	local c = p + side * (ctx.T / 2 - 0.55)
	Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 3, 0), c + Vector3.new(0, 3, 0) - side), Vector3.new(ctx.T, 6, 1.1), { blocks = false })
	local f = c - side * 0.6
	skullRow(m, f + Vector3.new(0, 2.4, 0) - along * 2.8, f + Vector3.new(0, 2.4, 0) + along * 2.8, 4, 0.42)
	skullRow(m, f + Vector3.new(0, 4.8, 0) - along * 2.8, f + Vector3.new(0, 4.8, 0) + along * 2.8, 4, 0.42)
end

-- Q: 해골 원통(납골 회랑의 랜드마크) — 뼈를 둥글게 쌓아 올린 기둥, 해골 고리 둘
function M.SkullBarrel(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "SkullBarrel")
	Kit.cylinder(m, p, p + Vector3.new(0, 7, 0), 2.6, { name = "Barrel", rings = 2 })
	Kit.cylinder(m, p + Vector3.new(0, 7, 0), p + Vector3.new(0, 7.4, 0), 2.9, { blocks = false })
	for _, y in { 2.4, 5.0 } do
		for k = 0, 7 do
			local a = k * math.pi / 4
			Kit.ball(m, p + Vector3.new(math.cos(a) * 2.6, y, math.sin(a) * 2.6), 0.5, { blocks = false, collide = false })
		end
	end
end

-- K: 잘라 낸 석회암 블록 두세 개(아래 큰 것, 위 작은 것)
function M.StoneBlocks(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "StoneBlocks")
	local h = ctx.hash(i, j, 11)
	local yaw = (h - 0.5) * 0.5
	Kit.box(m, CFrame.new(p + Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, yaw, 0), Vector3.new(6, 2.8, 4.2), { name = "Block" })
	Kit.box(m, CFrame.new(p + Vector3.new(-0.6, 3.9, 0.2)) * CFrame.Angles(0, yaw + 0.3, 0), Vector3.new(3.6, 2.2, 3), { name = "Block" })
	if h > 0.45 then
		Kit.box(m, CFrame.new(p + Vector3.new(2.2, 0.9, 2.6)) * CFrame.Angles(0, -0.4, 0), Vector3.new(2, 1.8, 1.6), { blocks = false })
	end
end

-- W: 손 권양기 — 양쪽 A자 나무 틀, 감는 드럼, 손잡이, 아래로 늘어진 밧줄과 갈고리
function M.Winch(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Winch")
	for _, x in { -2.4, 2.4 } do
		Kit.box(m, CFrame.new(p + Vector3.new(x, 2.4, -1.0)) * CFrame.Angles(0.35, 0, 0), Vector3.new(0.5, 5.2, 0.5), { blocks = false })
		Kit.box(m, CFrame.new(p + Vector3.new(x, 2.4, 1.0)) * CFrame.Angles(-0.35, 0, 0), Vector3.new(0.5, 5.2, 0.5), { blocks = false })
		Kit.box(m, CFrame.new(p + Vector3.new(x, 0.25, 0)), Vector3.new(0.6, 0.5, 4.2), { blocks = false })
	end
	Kit.cylinder(m, p + Vector3.new(-2.2, 4.4, 0), p + Vector3.new(2.2, 4.4, 0), 0.9, { name = "Drum" })
	Kit.box(m, CFrame.new(p + Vector3.new(2.9, 4.4, 0.8)), Vector3.new(0.3, 0.3, 1.8), { blocks = false, collide = false })
	Kit.cylinder(m, p + Vector3.new(0.6, 4.4, 0.9), p + Vector3.new(0.6, 1.2, 0.9), 0.08, { blocks = false, collide = false })
	Kit.box(m, CFrame.new(p + Vector3.new(0.6, 1.0, 0.9)), Vector3.new(0.6, 0.5, 0.2), { blocks = false, collide = false })
	Kit.box(m, CFrame.new(p + Vector3.new(0, 2.5, 0)), Vector3.new(5.4, 5, 3.4), { invisible = true, tag = false })
end

-- 광차 방향: 이웃 레일(r)이 동서에 있으면 X 축
local function railAxis(ctx, i: number, j: number): Vector3
	if ctx.at(i - 1, j) == "r" or ctx.at(i + 1, j) == "r" then
		return Vector3.new(1, 0, 0)
	end
	if ctx.at(i, j - 1) == "r" or ctx.at(i, j + 1) == "r" then
		return Vector3.new(0, 0, 1)
	end
	return Vector3.new(1, 0, 0)
end

-- R: 광차(돌 싣는 쇠 수레) — 위가 넓은 통, 바퀴 넷, 레일 두 줄
function M.MineCart(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local ax = railAxis(ctx, i, j)
	local m = model(ctx, "MineCart")
	local cf = CFrame.lookAt(p, p + ax)
	Kit.box(m, cf * CFrame.new(0, 2.4, 0), Vector3.new(3.6, 2.4, 5.4), { name = "Tub" })
	Kit.box(m, cf * CFrame.new(0, 3.7, 0), Vector3.new(4.0, 0.3, 5.8), { blocks = false })
	for _, x in { -1.5, 1.5 } do
		for _, z in { -1.8, 1.8 } do
			local c = (cf * CFrame.new(x, 0.8, z)).Position
			Kit.cylinder(m, c - cf.RightVector * 0.2, c + cf.RightVector * 0.2, 0.75, { blocks = false })
		end
	end
	for _, x in { -1.5, 1.5 } do
		Kit.box(m, cf * CFrame.new(x, 0.1, 0), Vector3.new(0.3, 0.2, ctx.T), { blocks = false, collide = false })
	end
	Kit.box(m, cf * CFrame.new(0, 1.2, 0.4), Vector3.new(2.0, 0.9, 2.2), { blocks = false }) -- (실린 돌)
end

-- r: 광차 레일(바닥) — 침목 셋 + 레일 두 줄, 충돌 없음
function M.Rail(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local ax = railAxis(ctx, i, j)
	local m = model(ctx, "Rail")
	local cf = CFrame.lookAt(p, p + ax)
	for _, x in { -1.5, 1.5 } do
		Kit.box(m, cf * CFrame.new(x, 0.15, 0), Vector3.new(0.3, 0.3, ctx.T), { blocks = false, collide = false, axis = "Z" })
	end
	for _, z in { -2.6, 0, 2.6 } do
		Kit.box(m, cf * CFrame.new(0, 0.06, z), Vector3.new(4.2, 0.12, 0.8), { blocks = false, collide = false, shape = "None" })
	end
end

-- N: 갱도 이름을 새긴 벽 명판(카타콤 갱도마다 위 지상 거리 이름을 새겨 둔 판) — 벽면에 붙은 얇은 판
function M.Plaque(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	if not side then
		return
	end
	local m = model(ctx, "Plaque")
	local c = p + side * (ctx.T / 2 - 0.15) + Vector3.new(0, 6.2, 0)
	Kit.box(m, CFrame.lookAt(c, c - side), Vector3.new(3.4, 1.4, 0.3), { blocks = false, collide = false })
	Kit.box(m, CFrame.lookAt(c - side * 0.2, c - side * 1.2), Vector3.new(2.6, 0.18, 0.12), { blocks = false, collide = false })
end

-- P: 예배당 신도석(등받이 나무 의자, 동쪽 제단을 바라본다)
function M.Pew(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Pew")
	local face = Vector3.new(1, 0, 0) -- (제단은 동쪽)
	local cf = CFrame.lookAt(p, p + face)
	Kit.box(m, cf * CFrame.new(0, 1.7, 0), Vector3.new(ctx.T - 0.4, 0.3, 1.8), { blocks = false })
	Kit.box(m, cf * CFrame.new(0, 3.0, 1.0), Vector3.new(ctx.T - 0.4, 2.6, 0.25), { blocks = false })
	for _, x in { -3.4, 3.4 } do
		Kit.box(m, cf * CFrame.new(x, 1.6, 0.4), Vector3.new(0.3, 3.2, 2.4), { blocks = false })
	end
	Kit.box(m, cf * CFrame.new(0, 1.6, 0.3), Vector3.new(ctx.T - 0.4, 3.2, 2.4), { invisible = true, tag = false })
end

-- J: 제단(돌 제단 + 촛대 둘 + 뒤 벽 십자가) — 예배당 동쪽 끝 랜드마크
function M.Altar(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(1, 0, 0)
	local along = Vector3.new(side.Z, 0, -side.X)
	local m = model(ctx, "Altar")
	local c = p + side * 1.2
	Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 1.8, 0), c + Vector3.new(0, 1.8, 0) - side), Vector3.new(6.4, 3.6, 2.8), { name = "Altar" })
	Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 3.75, 0), c + Vector3.new(0, 3.75, 0) - side), Vector3.new(7.0, 0.3, 3.2), { blocks = false })
	for _, s in { -1, 1 } do
		local cs = c + along * (s * 2.6) + Vector3.new(0, 3.9, 0)
		Kit.cylinder(m, cs, cs + Vector3.new(0, 1.6, 0), 0.15, { blocks = false, collide = false })
		Kit.cylinder(m, cs, cs + Vector3.new(0, 0.2, 0), 0.5, { blocks = false, collide = false })
	end
	local w = p + side * (ctx.T / 2 - 0.25) + Vector3.new(0, 8.4, 0)
	Kit.box(m, CFrame.lookAt(w, w - side), Vector3.new(0.6, 5.0, 0.4), { blocks = false, collide = false })
	Kit.box(m, CFrame.lookAt(w + Vector3.new(0, 1.0, 0), w + Vector3.new(0, 1.0, 0) - side), Vector3.new(3.0, 0.6, 0.4), { blocks = false, collide = false })
end

-- Y: 채석공 우물 — 둥근 돌 우물 턱, 나무 기둥 둘 + 도르래 보, 늘어진 밧줄과 두레박
function M.Well(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Well")
	Kit.cylinder(m, p, p + Vector3.new(0, 2.6, 0), 3.0, { name = "WellCurb", rings = 2 })
	Kit.cylinder(m, p + Vector3.new(0, 2.6, 0), p + Vector3.new(0, 2.65, 0), 2.3, { blocks = false, collide = false, shape = "None" })
	for _, x in { -3.0, 3.0 } do
		Kit.box(m, CFrame.new(p + Vector3.new(x, 4.2, 0)), Vector3.new(0.5, 8.4, 0.5), { blocks = false })
	end
	Kit.box(m, CFrame.new(p + Vector3.new(0, 8.2, 0)), Vector3.new(6.6, 0.5, 0.5), { blocks = false })
	Kit.cylinder(m, p + Vector3.new(0, 8.2, -0.3), p + Vector3.new(0, 8.2, 0.3), 0.6, { blocks = false, collide = false })
	Kit.cylinder(m, p + Vector3.new(0, 7.6, 0), p + Vector3.new(0, 4.2, 0), 0.07, { blocks = false, collide = false })
	Kit.cylinder(m, p + Vector3.new(0, 3.4, 0), p + Vector3.new(0, 4.2, 0), 0.5, { blocks = false, collide = false })
end

-- G: 수직갱 권양탑 다리(출구 승강기 케이지를 매단 철골 탑) — 기둥 넷 + 가새 + 꼭대기 도르래 바퀴
function M.Headframe(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local h = height(ctx, i, j) - 0.6
	local m = model(ctx, "Headframe")
	for _, x in { -2.2, 2.2 } do
		for _, z in { -2.2, 2.2 } do
			Kit.box(m, CFrame.new(p + Vector3.new(x, h / 2, z)), Vector3.new(0.6, h, 0.6), { blocks = false })
		end
	end
	for _, y in { 4.0, 8.5 } do
		for _, z in { -2.2, 2.2 } do
			Kit.box(m, CFrame.new(p + Vector3.new(0, y, z)), Vector3.new(4.8, 0.4, 0.4), { blocks = false })
		end
		for _, x in { -2.2, 2.2 } do
			Kit.box(m, CFrame.new(p + Vector3.new(x, y, 0)), Vector3.new(0.4, 0.4, 4.8), { blocks = false })
		end
	end
	Kit.box(m, CFrame.new(p + Vector3.new(-2.2, 6.2, 0)) * CFrame.Angles(0.9, 0, 0), Vector3.new(0.3, 5.6, 0.3), { blocks = false, collide = false })
	Kit.cylinder(m, p + Vector3.new(-0.3, h - 1.6, 0), p + Vector3.new(0.3, h - 1.6, 0), 1.5, { blocks = false, collide = false, rings = 1 })
	Kit.box(m, CFrame.new(p + Vector3.new(0, 2.5, 0)), Vector3.new(5, 5, 5), { invisible = true, tag = false })
end

-- I: 지상으로 오르는 나선 계단(입구 계단실) — 가운데 돌기둥 + 천장으로 감겨 오르는 디딤판
function M.SpiralStair(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local h = height(ctx, i, j)
	local m = model(ctx, "SpiralStair")
	Kit.cylinder(m, p, p + Vector3.new(0, h, 0), 0.7, { name = "Newel" })
	local n = 10
	for k = 0, n - 1 do
		local a = k * (math.pi * 2 / 8)
		local y = 0.6 + k * (h - 1) / n
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		local c = p + d * 1.9 + Vector3.new(0, y, 0)
		Kit.box(m, CFrame.lookAt(c, c + d), Vector3.new(1.6, 0.3, 2.6), { blocks = false })
	end
	Kit.cylinder(m, p + Vector3.new(0, 0.05, 0), p + Vector3.new(0, 0.1, 0), 3.4, { blocks = false, collide = false, shape = "None" })
	Kit.box(m, CFrame.new(p + Vector3.new(0, h / 2, 0)), Vector3.new(6.4, h, 6.4), { invisible = true, tag = false })
end

-- V: 석관(돌 관 + 비스듬히 밀린 뚜껑 + 뚜껑 위 십자)
function M.Sarcophagus(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Sarcophagus")
	Kit.box(m, CFrame.new(p + Vector3.new(0, 1.5, 0)), Vector3.new(3.2, 3.0, 6.6), { name = "Coffin" })
	local lid = CFrame.new(p + Vector3.new(0.5, 3.25, 0.4)) * CFrame.Angles(0, 0.18, 0)
	Kit.box(m, lid, Vector3.new(3.4, 0.5, 6.8), { blocks = false })
	Kit.box(m, lid * CFrame.new(0, 0.35, -0.6), Vector3.new(0.4, 0.2, 3.4), { blocks = false, collide = false })
	Kit.box(m, lid * CFrame.new(0, 0.35, -1.4), Vector3.new(1.8, 0.2, 0.4), { blocks = false, collide = false })
end

-- 갱도 진행 방향(양옆이 벽이면 그 사이로 지나간다): 동서로 지나가면 X 축
local function passAxis(ctx, i: number, j: number): Vector3
	if ctx.isWall(i, j - 1) or ctx.isWall(i, j + 1) or ctx.at(i, j - 1) == "H" or ctx.at(i, j + 1) == "H" then
		return Vector3.new(1, 0, 0)
	end
	return Vector3.new(0, 0, 1)
end

-- H: 납골당 문틀 — 갱도를 가로지르는 돌 문설주(벽 쪽에만) + 위 상인방 + "멈춰라, 여기부터 죽음의 제국" 명문 판(글줄 셋).
--   두 칸 폭 문이면 두 칸이 한 문틀을 나눠 짓는다(벽에 붙은 쪽에만 기둥). 칸은 그대로 밟고 지나간다
function M.OssuaryGate(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local h = height(ctx, i, j)
	local go = passAxis(ctx, i, j) -- 지나가는 방향
	local across = Vector3.new(go.Z, 0, go.X) -- 문 폭 방향
	local m = model(ctx, "OssuaryGate")
	local T = ctx.T
	local top = math.min(h - 0.6, 9.5)
	for _, s in { -1, 1 } do
		local ni, nj = i + across.X * s, j + across.Z * s
		if ctx.isWall(ni, nj) then
			local c = p + across * (s * (T / 2 - 0.7))
			Kit.box(m, CFrame.lookAt(c + Vector3.new(0, top / 2, 0), c + Vector3.new(0, top / 2, 0) + go), Vector3.new(1.4, top, 2.2), { name = "Jamb" })
		end
	end
	local lc = p + Vector3.new(0, top + 0.5, 0)
	Kit.box(m, CFrame.lookAt(lc, lc + go), Vector3.new(T, 1.0, 2.4), { name = "Lintel" })
	-- 명문 판: 상인방 위 얇은 판 + 글줄 셋(가는 띠)
	if ctx.at(i - across.X, j - across.Z) ~= "H" then
		local both = ctx.at(i + across.X, j + across.Z) == "H"
		local w = if both then T * 2 - 1.5 else T - 1.5
		local pc = lc + Vector3.new(0, 1.3, 0) + (if both then across * (T / 2) else Vector3.zero)
		Kit.box(m, CFrame.lookAt(pc, pc + go), Vector3.new(w, 1.6, 0.4), { blocks = false, collide = false })
		for k = -1, 1 do
			local q = pc + Vector3.new(0, k * 0.45, 0) - go * 0.25
			Kit.box(m, CFrame.lookAt(q, q + go), Vector3.new(w * (0.8 - math.abs(k) * 0.15), 0.12, 0.1), { blocks = false, collide = false })
		end
	end
end

-- F: 붕락 돌무더기 — 천장이 무너져 갱도를 막은 큰 바위 셋 + 기울어진 판석 + 부서진 버팀목
function M.Rubble(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local h = height(ctx, i, j)
	local m = model(ctx, "Rubble")
	local r = ctx.hash(i, j, 5)
	Kit.box(m, CFrame.new(p + Vector3.new(0, 1.8, 0)) * CFrame.Angles(0.2, r, 0.15), Vector3.new(7, 3.6, 6.5), { name = "Rock" })
	Kit.box(m, CFrame.new(p + Vector3.new(-1.2, 4.6, 0.6)) * CFrame.Angles(-0.3, r + 0.7, 0.25), Vector3.new(5, 3, 4.4), { name = "Rock" })
	Kit.box(m, CFrame.new(p + Vector3.new(1.4, 7.2, -0.4)) * CFrame.Angles(0.4, r - 0.5, -0.3), Vector3.new(4.2, 2.6, 3.6), { name = "Rock" })
	Kit.wedge(m, CFrame.new(p + Vector3.new(0.5, math.min(h - 1.6, 10), 1.2)) * CFrame.Angles(0, r, 0.5), Vector3.new(6, 2, 5), { blocks = false })
	Kit.box(m, CFrame.new(p + Vector3.new(2.6, 2.6, 2.6)) * CFrame.Angles(0.8, 0.3, 0), Vector3.new(0.6, 5.5, 0.6), { blocks = false, collide = false })
	Kit.box(m, CFrame.new(p + Vector3.new(0, math.min(h, 12) / 2, 0)), Vector3.new(ctx.T, math.min(h, 12), ctx.T), { invisible = true, tag = false })
end

-- l: 무덤 등불 — 납골당 공기를 돌리려고 불을 피우던 돌 기둥 위 넓은 불 그릇(원형실의 둘째 랜드마크)
function M.Lamp(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "SepulchralLamp")
	Kit.box(m, CFrame.new(p + Vector3.new(0, 0.5, 0)), Vector3.new(4.4, 1, 4.4), { name = "Plinth" })
	Kit.cylinder(m, p + Vector3.new(0, 1, 0), p + Vector3.new(0, 4.2, 0), 1.0, { name = "Shaft" })
	Kit.cylinder(m, p + Vector3.new(0, 4.2, 0), p + Vector3.new(0, 5.2, 0), 2.6, { name = "Bowl", rings = 1 })
	Kit.cylinder(m, p + Vector3.new(0, 5.2, 0), p + Vector3.new(0, 5.4, 0), 2.9, { blocks = false, collide = false })
	Kit.box(m, CFrame.new(p + Vector3.new(0, 2.8, 0)), Vector3.new(4.4, 5.6, 4.4), { invisible = true, tag = false })
end

-- M: 채석공 요새 부조 — 옛 채석공이 벽 턱에 새긴 성채 모형(탑 셋 + 성벽 + 받침 턱). 벽에 붙는다
function M.Sculpture(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local along = Vector3.new(side.Z, 0, -side.X)
	local m = model(ctx, "QuarrySculpture")
	local c = p + side * (ctx.T / 2 - 1.6)
	local face = function(q: Vector3): CFrame
		return CFrame.lookAt(q, q - side)
	end
	Kit.box(m, face(c + Vector3.new(0, 1.6, 0)), Vector3.new(ctx.T - 0.6, 3.2, 3.2), { name = "Ledge" })
	Kit.box(m, face(c + Vector3.new(0, 4.0, 0)), Vector3.new(5.6, 1.6, 1.6), { name = "Rampart" })
	for k, x in { -2.6, 0, 2.6 } do
		local th = if k == 2 then 3.4 else 2.4
		local q = c + along * x + Vector3.new(0, 3.2 + th / 2, 0)
		Kit.box(m, face(q), Vector3.new(1.2, th, 1.2), { blocks = false })
		Kit.wedge(m, face(q + Vector3.new(0, th / 2 + 0.4, 0)), Vector3.new(1.3, 0.8, 1.3), { blocks = false, collide = false })
	end
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="143">
          <Properties>
            <string name="Name">Parking</string>
            <string name="Source"><![CDATA[--!nonstrict
-- 챕터 9 지하 주차장 전용 소품(타일 문자 → 함수). Stage9.luau 의 Props 줄에서 쓴다. MapKit 부품만(검은 무광, 음파 윤곽선).
--   Q/K 주차된 차  l/y 빈 주차 칸  B/X 굵은 기둥(번호판)  s 차량 램프(옆으로 이어진 계단을 경사판으로)  e 엘리베이터 문  J 정산기  g 차단기
--   h 소화전  u 카트  x 셔터  C CCTV 콘솔(방재실)  t 전기차 충전기  N/q 천장 안내 표지  j/a 제트 팬  d 환기 덕트  i 라바콘  w 과속 방지턱
--   G 비상 발전기  R 배전반  P 소화 펌프  H 저수조  V 급배기 팬  U 탑차(세로 두 칸)  z 파레트 잭  Y 재활용 수거함

local Kit = require(script.Parent.Parent.MapKit)

local P = {}

local function base(ctx: any, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

local function wallDir(ctx: any, i: number, j: number): Vector3?
	for _, d in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local STALL = { Q = true, K = true, l = true, y = true }

-- 주차 칸 바닥선: 칸 양옆(x 방향 경계) 흰 선 + 앞쪽 끝선 대신 바퀴 멈춤턱
local function stallLines(ctx: any, i: number, j: number, p: Vector3)
	local Kit = ctx.Kit
	local T = ctx.T
	for _, s in { -1, 1 } do
		-- 오른쪽 경계는 옆 칸이 주차 칸이 아닐 때만(겹치지 않게)
		if s == -1 or not STALL[ctx.at(i + 1, j)] then
			Kit.box(ctx.props, CFrame.new(p + Vector3.new(s * (T / 2 - 0.15), 0.04, 0)), Vector3.new(0.25, 0.08, T - 1), { blocks = false, collide = false })
		end
	end
	local back = if ctx.isWall(i, j - 1) then -1 elseif ctx.isWall(i, j + 1) then 1 else 0
	if back ~= 0 then
		local st = p + Vector3.new(0, 0.25, back * (T / 2 - 1.2))
		for _, s in { -1, 1 } do
			Kit.box(ctx.props, CFrame.new(st + Vector3.new(s * 1.5, 0, 0)), Vector3.new(1.8, 0.5, 0.6), { blocks = false, collide = false })
		end
	end
end

-- 주차된 차(큰 상자형): 바퀴 4개 + 차체 + 객실 + 범퍼·창틀 선
function P.Car(ctx: any, i: number, j: number)
	local Kit = ctx.Kit
	local p = base(ctx, i, j)
	stallLines(ctx, i, j, p)
	local nose = if ctx.hash(i, j, 91) < 0.5 then 1 else -1
	local yaw = (ctx.hash(i, j, 92) - 0.5) * 0.12
	local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0)
	local m = Instance.new("Model")
	m.Name = "Car"
	m.Parent = ctx.props
	for _, x in { -2.3, 2.3 } do
		for _, z in { -2.5, 2.5 } do
			local w = cf * CFrame.new(x, 1.05, z)
			Kit.cylinder(m, (w * CFrame.new(-0.35, 0, 0)).Position, (w * CFrame.new(0.35, 0, 0)).Position, 1.05, { blocks = false, collide = false })
		end
	end
	Kit.box(m, cf * CFrame.new(0, 2.0, 0), Vector3.new(4.8, 1.9, 7.4), { name = "CarBody" })
	Kit.box(m, cf * CFrame.new(0, 3.75, -nose * 0.5), Vector3.new(4.2, 1.6, 3.8), { name = "CarCabin" })
	-- 앞·뒤 유리 경사(쐐기)
	Kit.wedge(m, cf * CFrame.new(0, 3.75, nose * 1.95) * CFrame.Angles(0, if nose == 1 then 0 else math.pi, 0), Vector3.new(4.2, 1.6, 0.8), { blocks = false, collide = false })
	-- 창틀 가운데 기둥, 범퍼, 전조등
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 2.12, 3.75, -nose * 0.5), Vector3.new(0.08, 1.4, 0.25), { blocks = false, collide = false })
		Kit.box(m, cf * CFrame.new(0, 1.3, s * 3.78), Vector3.new(5.0, 0.5, 0.25), { blocks = false, collide = false })
		Kit.box(m, cf * CFrame.new(s * 1.6, 2.3, nose * 3.72), Vector3.new(0.9, 0.4, 0.12), { blocks = false, collide = false })
	end
	Kit.box(m, cf * CFrame.new(0, 2.4, 0), Vector3.new(5.0, 4.6, 7.6), { invisible = true, tag = false })
end

-- 빈 주차 칸(바닥선만)
function P.EmptyStall(ctx: any, i: number, j: number)
	stallLines(ctx, i, j, base(ctx, i, j))
end

-- 굵은 기둥 + 모서리 보호대 + 네 면 번호판(7세그먼트 숫자 두 자리)
local SEG = {
	["0"] = "abcdef", ["1"] = "bc", ["2"] = "abged", ["3"] = "abgcd", ["4"] = "fgbc",
	["5"] = "afgcd", ["6"] = "afgedc", ["7"] = "abc", ["8"] = "abcdefg", ["9"] = "abcdfg",
}
local function digit(ctx: any, ch: string, origin: Vector3, right: Vector3, out: Vector3, h: number)
	local w, t = h * 0.55, h * 0.13
	local half = h / 2
	local bars = {
		a = { 0, h, w, h }, b = { w, h, w, half }, c = { w, half, w, 0 }, d = { 0, 0, w, 0 },
		e = { 0, half, 0, 0 }, f = { 0, h, 0, half }, g = { 0, half, w, half },
	}
	for k in (SEG[ch] or ""):gmatch(".") do
		local b = bars[k]
		local a = origin + right * b[1] + Vector3.yAxis * b[2] + out * 0.1
		local z = origin + right * b[3] + Vector3.yAxis * b[4] + out * 0.1
		local d = z - a
		ctx.Kit.box(ctx.props, CFrame.fromMatrix((a + z) / 2, d.Unit, out:Cross(d.Unit).Unit), Vector3.new(d.Magnitude + t, t, 0.12), { blocks = false, collide = false })
	end
end
function P.Pillar(ctx: any, i: number, j: number)
	local Kit = ctx.Kit
	local p = base(ctx, i, j)
	local h = ctx.H - ctx.floorY(i, j)
	Kit.box(ctx.geo, CFrame.new(p + Vector3.new(0, h / 2, 0)), Vector3.new(4.0, h, 4.0), { name = "Pillar" })
	Kit.box(ctx.geo, CFrame.new(p + Vector3.new(0, 0.5, 0)), Vector3.new(4.8, 1.0, 4.8), { name = "PillarBase" })
	Kit.box(ctx.geo, CFrame.new(p + Vector3.new(0, h - 0.8, 0)), Vector3.new(5.0, 1.6, 5.0), { name = "PillarCap" })
	local label = string.format("%02d", (j * 47 + i) % 97) -- 칸 위치로 정해지는 번호(다시 지어도 같다)
	-- 번호판은 마주 보는 두 면에만(부품·선을 줄인다)
	for _, f in { Vector3.xAxis, -Vector3.xAxis } do
		local right = Vector3.new(f.Z, 0, -f.X) -- 번호판을 마주 본 사람의 오른쪽
		local face = p + f * 2.05 + Vector3.new(0, 6.0, 0)
		Kit.box(ctx.props, CFrame.lookAt(face, face + f), Vector3.new(2.8, 1.9, 0.1), { blocks = false, collide = false })
		local dh = 1.2
		for n = 1, 2 do
			local o = face + Vector3.new(0, -dh / 2, 0) + right * ((n - 1.5) * dh * 0.95 - dh * 0.27) + f * 0.05
			digit(ctx, label:sub(n, n), o, right, f, dh)
		end
	end
	-- 모서리 보호대: 기둥을 두르는 띠 두 줄
	for _, y in { 1.6, 2.6 } do
		Kit.box(ctx.props, CFrame.new(p + Vector3.new(0, y, 0)), Vector3.new(4.2, 0.3, 4.2), { blocks = false, collide = false })
	end
end

-- 손수레(카트): 벽 쪽으로 붙여 둔다
function P.Cart(ctx: any, i: number, j: number)
	local Kit = ctx.Kit
	local side = wallDir(ctx, i, j) or Vector3.new(1, 0, 0)
	local p = base(ctx, i, j) + side * 2.0
	local yaw = ctx.hash(i, j, 7) * 1.2
	local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0)
	local m = Instance.new("Model")
	m.Name = "Cart"
	m.Parent = ctx.props
	Kit.box(m, cf * CFrame.new(0, 0.9, 0), Vector3.new(2.4, 0.2, 3.6))
	Kit.crate(m, (cf * CFrame.new(0, 1.0, 0.4)).Position, Vector3.new(2.0, 1.6, 2.0), yaw + 0.1)
	for _, x in { -1.0, 1.0 } do
		for _, z in { -1.5, 1.5 } do
			Kit.cylinder(m, (cf * CFrame.new(x - 0.15, 0.35, z)).Position, (cf * CFrame.new(x + 0.15, 0.35, z)).Position, 0.35, { blocks = false, collide = false })
		end
		Kit.cylinder(m, (cf * CFrame.new(x, 0.9, -1.8)).Position, (cf * CFrame.new(x, 3.6, -1.9)).Position, 0.08, { blocks = false, collide = false })
	end
	Kit.cylinder(m, (cf * CFrame.new(-1.0, 3.6, -1.9)).Position, (cf * CFrame.new(1.0, 3.6, -1.9)).Position, 0.08, { blocks = false, collide = false })
end

-- 소화전: 벽에 붙은 소화전함 + 바닥 소화전
function P.Hydrant(ctx: any, i: number, j: number)
	local Kit = ctx.Kit
	local side = wallDir(ctx, i, j) or Vector3.new(0, 0, -1)
	local p = base(ctx, i, j)
	local face = p + side * (ctx.T / 2 - 0.4)
	Kit.box(ctx.props, CFrame.lookAt(face + Vector3.new(0, 4.2, 0), face + Vector3.new(0, 4.2, 0) - side), Vector3.new(2.8, 3.4, 0.8), { blocks = false })
	Kit.box(ctx.props, CFrame.lookAt(face + Vector3.new(0, 4.2, 0) - side * 0.42, face + Vector3.new(0, 4.2, 0) - side), Vector3.new(2.2, 2.8, 0.05), { blocks = false, collide = false })
	local post = face - side * 0.9 + Vector3.new(side.Z, 0, -side.X) * 2.2
	Kit.cylinder(ctx.props, post, post + Vector3.new(0, 2.2, 0), 0.4, { blocks = false })
	Kit.ball(ctx.props, post + Vector3.new(0, 2.3, 0), 0.42, { blocks = false, collide = false })
	Kit.cylinder(ctx.props, post + Vector3.new(0, 1.5, 0) - Vector3.new(side.Z, 0, -side.X) * 0.7, post + Vector3.new(0, 1.5, 0) + Vector3.new(side.Z, 0, -side.X) * 0.7, 0.18, { blocks = false, collide = false })
end

-- 엘리베이터 문(벽면): 문틀 + 두 짝 + 호출 버튼
function P.Elevator(ctx: any, i: number, j: number)
	local Kit = ctx.Kit
	local side = wallDir(ctx, i, j) or Vector3.new(0, 0, -1)
	local right = Vector3.new(side.Z, 0, -side.X)
	local face = base(ctx, i, j) + side * (ctx.T / 2 - 0.15)
	for _, s in { -1, 1 } do
		local jp = face + right * s * 2.9 + Vector3.new(0, 4.5, 0)
		Kit.box(ctx.props, CFrame.lookAt(jp, jp - side), Vector3.new(0.6, 9, 0.5), { blocks = false })
		local dp = face + right * s * 1.3 + Vector3.new(0, 4.2, 0) - side * 0.05
		Kit.box(ctx.props, CFrame.lookAt(dp, dp - side), Vector3.new(2.5, 8.2, 0.12), { blocks = false, collide = false })
	end
	local top = face + Vector3.new(0, 9.2, 0)
	Kit.box(ctx.props, CFrame.lookAt(top, top - side), Vector3.new(6.4, 0.8, 0.5), { blocks = false })
	local btn = face + right * 3.8 + Vector3.new(0, 4.0, 0) - side * 0.1
	Kit.box(ctx.props, CFrame.lookAt(btn, btn - side), Vector3.new(0.5, 1.0, 0.15), { blocks = false, collide = false })
end

-- 셔터(하역장 벽면): 말린 셔터 통 + 가로 살
function P.Shutter(ctx: any, i: number, j: number)
	local Kit = ctx.Kit
	local side = wallDir(ctx, i, j) or Vector3.new(0, 0, 1)
	local right = Vector3.new(side.Z, 0, -side.X)
	local face = base(ctx, i, j) + side * (ctx.T / 2 - 0.2)
	for y = 0.4, 9.0, 0.75 do
		local sp = face + Vector3.new(0, y, 0)
		Kit.box(ctx.props, CFrame.lookAt(sp, sp - side), Vector3.new(ctx.T - 0.2, 0.6, 0.12), { blocks = false, collide = false })
	end
	Kit.cylinder(ctx.props, face + Vector3.new(0, 9.9, 0) - right * (ctx.T / 2) - side * 0.4, face + Vector3.new(0, 9.9, 0) + right * (ctx.T / 2) - side * 0.4, 0.8, { blocks = false, collide = false })
	-- 하역장 바닥 정지선
	local st = face - side * 2.5 + Vector3.new(0, 0.04, 0)
	Kit.box(ctx.props, CFrame.lookAt(st, st - side), Vector3.new(ctx.T - 1, 0.08, 0.35), { blocks = false, collide = false })
end

-- 차량 출구 차단기: 벽 쪽 기둥 + 위로 들린 막대
function P.Barrier(ctx: any, i: number, j: number)
	local Kit = ctx.Kit
	local side = wallDir(ctx, i, j) or Vector3.new(0, 0, -1)
	local p = base(ctx, i, j)
	local post = p + side * (ctx.T / 2 - 1.0)
	Kit.box(ctx.props, CFrame.new(post + Vector3.new(0, 1.9, 0)), Vector3.new(1.3, 3.8, 1.3), { name = "BarrierPost" })
	local hinge = post + Vector3.new(0, 3.4, 0)
	local tip = hinge - side * 1.6 + Vector3.new(0, 6.0, 0)
	Kit.cylinder(ctx.props, hinge, tip, 0.18, { blocks = false, collide = false })
	-- 바닥 정지선
	local axis = Vector3.new(side.Z, 0, -side.X)
	Kit.box(ctx.props, CFrame.lookAt(p + Vector3.new(0, 0.04, 0), p + Vector3.new(0, 0.04, 0) + axis), Vector3.new(ctx.T - 0.5, 0.08, 0.4), { blocks = false, collide = false })
end

-- 주차 정산기(벽에 붙은 키오스크)
function P.PayMachine(ctx: any, i: number, j: number)
	local Kit = ctx.Kit
	local side = wallDir(ctx, i, j) or Vector3.new(0, 0, -1)
	local p = base(ctx, i, j) + side * (ctx.T / 2 - 1.1)
	Kit.box(ctx.props, CFrame.lookAt(p + Vector3.new(0, 2.6, 0), p + Vector3.new(0, 2.6, 0) - side), Vector3.new(2.6, 5.2, 1.8), { name = "PayMachine" })
	local f = p - side * 0.92
	Kit.box(ctx.props, CFrame.lookAt(f + Vector3.new(0, 3.9, 0), f + Vector3.new(0, 3.9, 0) - side), Vector3.new(1.8, 1.2, 0.06), { blocks = false, collide = false })
	Kit.box(ctx.props, CFrame.lookAt(f + Vector3.new(0, 2.6, 0), f + Vector3.new(0, 2.6, 0) - side), Vector3.new(1.0, 0.2, 0.15), { blocks = false, collide = false })
	Kit.box(ctx.props, CFrame.lookAt(f + Vector3.new(0, 1.3, 0), f + Vector3.new(0, 1.3, 0) - side), Vector3.new(1.6, 0.5, 0.2), { blocks = false, collide = false })
end

-- 램프: 계단(s)이 옆으로 이어진 넓은 곳은 매끈한 경사판 + 가장자리 연석으로 덮는다(비상계단은 계단 그대로)
function P.Ramp(ctx: any, i: number, j: number)
	local wide = ctx.at(i - 1, j) == "s" or ctx.at(i + 1, j) == "s" or ctx.at(i, j - 1) == "s" or ctx.at(i, j + 1) == "s"
	if not wide then
		return
	end
	local Kit = ctx.Kit
	local up = Vector3.new(0, 0, -1)
	for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		local n = ctx.at(i + d[1], j + d[2])
		if n ~= "#" and not ctx.isPit(i + d[1], j + d[2]) then
			up = Vector3.new(d[1], 0, d[2])
		end
	end
	local c = ctx.center(i, j)
	local rise = -ctx.PIT_Y
	-- 경사선이 계단 코보다 조금 위로 오도록 아래쪽으로 1.1 밀어 둔다
	local mid = c - up * 1.1 + Vector3.new(0, ctx.PIT_Y + rise / 2, 0)
	Kit.wedge(ctx.props, CFrame.lookAt(mid, mid - up), Vector3.new(ctx.T, rise, ctx.T), { name = "Ramp" })
	local across = Vector3.new(up.Z, 0, -up.X)
	for _, s in { -1, 1 } do
		if ctx.isWall(i + math.round(across.X * s), j + math.round(across.Z * s)) then
			local a = c + across * s * (ctx.T / 2 - 0.4) - up * (ctx.T / 2) + Vector3.new(0, ctx.PIT_Y + 0.5, 0)
			local b = a + up * ctx.T + Vector3.new(0, rise, 0)
			local d = b - a
			Kit.box(ctx.props, CFrame.lookAt((a + b) / 2, b), Vector3.new(0.6, 1.0, d.Magnitude), { blocks = false, collide = false })
		end
	end
end

-- ── 새 장비 ──
local LINE = { blocks = false, collide = false }
local SOFT = { blocks = false }

local function model(ctx: any, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end
local function solid(m: Instance, cf: CFrame, size: Vector3)
	Kit.box(m, cf * CFrame.new(0, size.Y / 2, 0), size, { invisible = true, tag = false })
end
-- 벽을 등진 좌표계: 로컬 -Z = 방 안쪽, +Z = 벽 쪽
local function againstWall(ctx: any, i: number, j: number): CFrame
	local p = base(ctx, i, j)
	local side = wallDir(ctx, i, j) or Vector3.new(0, 0, -1)
	return CFrame.lookAt(p, p - side)
end
local function at(cf: CFrame, x: number, y: number, z: number): Vector3
	return (cf * CFrame.new(x, y, z)).Position
end
-- 이 칸의 바닥에서 천장까지 높이
local function roomH(ctx: any, i: number, j: number): number
	return ctx.H - ctx.floorY(i, j)
end

-- C 방재실 CCTV 콘솔: 책상 + 모니터 벽(2단 3열) + 의자
function P.CctvDesk(ctx: any, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "CctvDesk")
	Kit.box(m, cf * CFrame.new(0, 1.5, 2.0), Vector3.new(7.6, 3.0, 2.4), SOFT)
	Kit.wedge(m, cf * CFrame.new(0, 3.4, 1.7), Vector3.new(7.4, 0.8, 1.6), LINE)
	for k = -1, 1 do
		for r = 0, 1 do
			Kit.box(m, cf * CFrame.new(k * 2.4, 5.0 + r * 1.9, 3.2), Vector3.new(2.1, 1.6, 0.5), LINE)
		end
	end
	local c = cf * CFrame.new((ctx.hash(i, j, 3) - 0.5) * 2, 0, -1.2)
	Kit.cylinder(m, at(c, 0, 0, 0), at(c, 0, 1.8, 0), 0.2, LINE)
	Kit.box(m, c * CFrame.new(0, 1.9, 0), Vector3.new(1.9, 0.3, 1.9), LINE)
	Kit.box(m, c * CFrame.new(0, 3.2, -0.9), Vector3.new(1.8, 2.0, 0.2), LINE)
	solid(m, cf * CFrame.new(0, 0, 2.2), Vector3.new(7.6, 4.2, 2.8))
end

-- t 전기차 충전기: 기둥 + 화면 + 늘어진 케이블 + 바닥 보호대
function P.EvCharger(ctx: any, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "EvCharger")
	Kit.box(m, cf * CFrame.new(0, 2.8, 2.6), Vector3.new(2.2, 5.6, 1.4))
	Kit.box(m, cf * CFrame.new(0, 4.4, 1.86), Vector3.new(1.4, 1.0, 0.08), LINE)
	Kit.box(m, cf * CFrame.new(0, 5.9, 2.4), Vector3.new(2.6, 0.5, 1.9), LINE)
	Kit.cylinder(m, at(cf, 1.2, 3.6, 2.4), at(cf, 1.9, 1.2, 1.6), 0.12, LINE)
	Kit.cylinder(m, at(cf, 1.9, 1.2, 1.6), at(cf, 1.3, 2.6, 1.4), 0.12, LINE)
	for _, x in { -2.2, 2.2 } do
		Kit.cylinder(m, at(cf, x, 0, 0.4), at(cf, x, 2.6, 0.4), 0.3, SOFT)
	end
	solid(m, cf * CFrame.new(0, 0, 1.8), Vector3.new(4.8, 4, 3.2))
end

-- N(위층)·q(지하 2층) 천장 안내 표지: 매단 판 + 화살표 + EXIT
function P.HangSign(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "HangSign")
	local top = roomH(ctx, i, j)
	local y = math.min(top - 2.2, 11)
	local axis = if ctx.hash(i, j, 2) < 0.5 then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
	local cf = CFrame.lookAt(p, p + axis)
	Kit.box(m, cf * CFrame.new(0, y, 0), Vector3.new(6.4, 1.8, 0.3), LINE)
	for _, x in { -2.4, 2.4 } do
		Kit.cylinder(m, at(cf, x, y + 0.9, 0), at(cf, x, top, 0), 0.07, LINE)
	end
	-- 앞면(로컬 -Z)에서 보면 오른쪽은 -RightVector 다
	Kit.word(m, "EXIT", at(cf, 0.9, y, -0.16), -cf.RightVector, cf.LookVector, 0.9)
	-- 화살표
	Kit.box(m, cf * CFrame.new(-2.2, y, -0.2), Vector3.new(1.2, 0.18, 0.1), LINE)
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(-2.6, y + s * 0.2, -0.2) * CFrame.Angles(0, 0, s * 0.8), Vector3.new(0.6, 0.18, 0.1), LINE)
	end
end

-- j(위층)·a(지하 2층) 제트 팬: 천장에 매단 긴 원통 + 걸쇠
function P.JetFan(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "JetFan")
	local y = roomH(ctx, i, j) - 2.0
	local ax = Vector3.new(1, 0, 0)
	Kit.cylinder(m, p - ax * 3.4 + Vector3.new(0, y, 0), p + ax * 3.4 + Vector3.new(0, y, 0), 1.1, LINE)
	for _, s in { -1, 1 } do
		Kit.cylinder(m, p + ax * (s * 2.4) + Vector3.new(0, y, 0), p + ax * (s * 3.6) + Vector3.new(0, y, 0), 1.3, LINE)
		Kit.box(m, CFrame.new(p + ax * (s * 1.6) + Vector3.new(0, y + 1.5, 0)), Vector3.new(0.2, 1.0, 2.4), LINE)
	end
end

-- d 환기 덕트: 천장의 네모 덕트 + 이음 띠 + 아래로 열린 취출구
function P.Duct(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Duct")
	local y = roomH(ctx, i, j) - 1.8
	local T = ctx.T
	Kit.box(m, CFrame.new(p + Vector3.new(0, y, 0)), Vector3.new(T * 3, 1.8, 3.0), LINE)
	for k = -1, 1 do
		Kit.box(m, CFrame.new(p + Vector3.new(k * T, y, 0)), Vector3.new(0.4, 2.1, 3.3), LINE)
	end
	Kit.box(m, CFrame.new(p + Vector3.new(0, y - 1.2, 0)), Vector3.new(2.6, 0.6, 2.2), LINE)
end

-- i 라바콘 셋(걸어서 지나간다)
function P.Cone(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Cones")
	for k = 0, 2 do
		local c = p + Vector3.new((k - 1) * 2.3, 0, (ctx.hash(i, j, 4 + k) - 0.5) * 2)
		Kit.box(m, CFrame.new(c + Vector3.new(0, 0.1, 0)), Vector3.new(1.4, 0.2, 1.4), LINE)
		for n = 0, 2 do
			Kit.cylinder(m, c + Vector3.new(0, 0.2 + n * 0.7, 0), c + Vector3.new(0, 0.9 + n * 0.7, 0), 0.5 - n * 0.16, LINE)
		end
	end
end

-- w 과속 방지턱(차로를 가로지른다, 세로로 이어짐)
function P.SpeedBump(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "SpeedBump")
	local T = ctx.T
	Kit.box(m, CFrame.new(p + Vector3.new(0, 0.18, 0)), Vector3.new(1.8, 0.36, T), LINE)
	for _, s in { -1, 1 } do
		Kit.box(m, CFrame.new(p + Vector3.new(s * 1.4, 0.1, 0)) * CFrame.Angles(0, 0, -s * 0.22), Vector3.new(1.3, 0.1, T), LINE)
	end
	Kit.box(m, CFrame.new(p + Vector3.new(3.2, 0.04, 0)), Vector3.new(0.35, 0.08, T - 2), LINE)
end

-- G 비상 발전기: 엔진 덩어리 + 방열판 + 배기관 + 축전지
function P.Generator(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Generator")
	local cf = CFrame.new(p)
	Kit.box(m, cf * CFrame.new(0, 0.4, 0), Vector3.new(7.4, 0.8, 4.2), SOFT)
	Kit.box(m, cf * CFrame.new(-0.8, 2.5, 0), Vector3.new(4.4, 3.4, 3.2))
	Kit.box(m, cf * CFrame.new(2.7, 2.6, 0), Vector3.new(0.8, 3.8, 3.8), SOFT) -- 방열판
	for k = -2, 2 do
		Kit.box(m, cf * CFrame.new(3.15, 2.6 + k * 0.7, 0), Vector3.new(0.08, 0.12, 3.6), LINE)
	end
	Kit.cylinder(m, at(cf, -2.6, 2.4, 0), at(cf, -3.6, 2.4, 0), 1.3, SOFT) -- 발전 코일
	Kit.cylinder(m, at(cf, 0.2, 4.2, 0), at(cf, 0.2, roomH(ctx, i, j), 0), 0.5, SOFT) -- 배기관
	Kit.cylinder(m, at(cf, 0.2, 5.6, 0), at(cf, 0.2, 8.2, 0), 0.95, LINE) -- 소음통
	Kit.box(m, cf * CFrame.new(-0.8, 1.2, 2.2), Vector3.new(2.4, 1.2, 0.9), LINE) -- 축전지
	solid(m, cf, Vector3.new(7.4, 4.4, 4.2))
end

-- R 배전반: 벽에 붙은 키 큰 철제 함 + 문 두 짝 + 계기 + 천장 전선관
function P.Switchgear(ctx: any, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Switchgear")
	Kit.box(m, cf * CFrame.new(0, 4.2, 2.6), Vector3.new(7.6, 8.4, 2.4))
	Kit.box(m, cf * CFrame.new(0, 4.2, 1.36), Vector3.new(0.12, 7.8, 0.08), LINE)
	for _, x in { -1.9, 1.9 } do
		Kit.box(m, cf * CFrame.new(x, 6.6, 1.36), Vector3.new(2.0, 1.2, 0.1), LINE) -- 계기창
		Kit.box(m, cf * CFrame.new(x * 0.35, 4.0, 1.3), Vector3.new(0.25, 1.4, 0.25), LINE) -- 손잡이
		for k = 0, 2 do
			Kit.box(m, cf * CFrame.new(x, 1.0 + k * 0.5, 1.36), Vector3.new(2.4, 0.12, 0.08), LINE) -- 통풍 살
		end
		Kit.cylinder(m, at(cf, x, 8.4, 2.8), at(cf, x, ctx.H, 2.8), 0.4, LINE)
	end
	solid(m, cf * CFrame.new(0, 0, 2.6), Vector3.new(7.6, 8.4, 2.6))
end

-- P 소화 펌프: 받침 + 모터 원통 + 펌프 몸통 + 위로 오르는 굵은 배관 + 밸브 바퀴
function P.FirePump(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "FirePump")
	local cf = CFrame.lookAt(p, p + Vector3.new(1, 0, 0))
	Kit.box(m, cf * CFrame.new(0, 0.5, 0), Vector3.new(3.0, 1.0, 6.0), SOFT)
	Kit.cylinder(m, at(cf, 0, 2.0, 2.6), at(cf, 0, 2.0, 0.2), 1.1)
	Kit.cylinder(m, at(cf, 0, 2.0, 0.2), at(cf, 0, 2.0, -0.6), 0.4, LINE)
	Kit.cylinder(m, at(cf, -0.8, 2.0, -1.6), at(cf, 0.8, 2.0, -1.6), 1.4, SOFT)
	Kit.cylinder(m, at(cf, 0, 3.2, -1.6), at(cf, 0, roomH(ctx, i, j), -1.6), 0.6, SOFT)
	Kit.cylinder(m, at(cf, 0, 6.0, -1.6), at(cf, 0, 6.3, -1.6), 1.0, LINE)
	Kit.cylinder(m, at(cf, 0, 5.0, -1.6), at(cf, 1.6, 5.0, -1.6), 0.15, LINE)
	Kit.cylinder(m, at(cf, 1.6, 5.0, -1.6), at(cf, 1.75, 5.0, -1.6), 0.9, LINE)
	solid(m, cf, Vector3.new(3.2, 4, 6))
end

-- H 저수조: 칸을 채우는 큰 패널 탱크(가로세로 이음 선 + 사다리)
function P.WaterTank(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "WaterTank")
	local cf = CFrame.new(p)
	local w, h = 7.2, 8.0
	Kit.box(m, cf * CFrame.new(0, h / 2 + 0.6, 0), Vector3.new(w, h, w))
	for _, y in { 0.6, 3.3, 5.9, 8.6 } do
		Kit.box(m, cf * CFrame.new(0, y, 0), Vector3.new(w + 0.2, 0.18, w + 0.2), LINE)
	end
	for _, x in { -1.8, 1.8 } do
		Kit.box(m, cf * CFrame.new(x, h / 2 + 0.6, 0), Vector3.new(0.18, h, w + 0.2), LINE)
	end
	for _, x in { -0.6, 0.6 } do -- 사다리(북쪽 면)
		Kit.cylinder(m, at(cf, x, 0, -w / 2 - 0.3), at(cf, x, h + 1.4, -w / 2 - 0.3), 0.08, LINE)
	end
	for k = 1, 6 do
		Kit.cylinder(m, at(cf, -0.6, k * 1.3, -w / 2 - 0.3), at(cf, 0.6, k * 1.3, -w / 2 - 0.3), 0.06, LINE)
	end
end

-- V 급배기 팬 유닛: 네모 함 + 둥근 팬 구멍 + 날개 + 천장 덕트
function P.FanUnit(ctx: any, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "FanUnit")
	Kit.box(m, cf * CFrame.new(0, 3.2, 1.2), Vector3.new(6.8, 6.4, 5.0))
	Kit.cylinder(m, at(cf, 0, 3.2, -1.3), at(cf, 0, 3.2, -1.7), 2.6, LINE)
	Kit.cylinder(m, at(cf, 0, 3.2, -1.7), at(cf, 0, 3.2, -1.9), 0.6, LINE)
	for k = 0, 3 do
		Kit.box(m, cf * CFrame.new(0, 3.2, -1.8) * CFrame.Angles(0, 0, k * math.pi / 4 + 0.2), Vector3.new(0.5, 4.8, 0.12), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, (6.4 + ctx.H) / 2, 1.6), Vector3.new(3.4, ctx.H - 6.4, 3.0), SOFT)
	solid(m, cf * CFrame.new(0, 0, 1.2), Vector3.new(6.8, 6.6, 5.2))
end

-- U 탑차(세로 두 칸): 위쪽 칸 = 운전석, 아래쪽 칸 = 짐칸. 뒷문이 반쯤 열려 있다
function P.Truck(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Truck")
	local cf = CFrame.new(p)
	local T = ctx.T
	for _, x in { -2.6, 2.6 } do
		for _, z in { -1.8, 1.8 } do
			Kit.cylinder(m, at(cf, x - 0.4, 1.2, z), at(cf, x + 0.4, 1.2, z), 1.2, LINE)
		end
	end
	if ctx.at(i, j - 1) == "U" then
		-- 짐칸
		Kit.box(m, cf * CFrame.new(0, 6.0, -0.4), Vector3.new(6.6, 7.6, T - 1.0))
		Kit.box(m, cf * CFrame.new(0, 1.9, -0.4), Vector3.new(6.0, 0.6, T - 0.6), LINE)
		for k = -1, 1 do
			for _, s in { -1, 1 } do
				Kit.box(m, cf * CFrame.new(s * 3.35, 6.0, -0.4 + k * 2.2), Vector3.new(0.1, 7.4, 0.2), LINE)
			end
		end
		Kit.box(m, cf * CFrame.new(-3.2, 6.0, T / 2 - 0.4) * CFrame.Angles(0, -0.9, 0) * CFrame.new(1.5, 0, 0), Vector3.new(3.0, 7.2, 0.2), LINE) -- 열린 문짝
		solid(m, cf, Vector3.new(6.8, 8, T))
	else
		-- 운전석
		Kit.box(m, cf * CFrame.new(0, 2.9, 0.6), Vector3.new(6.2, 2.6, 5.4))
		Kit.box(m, cf * CFrame.new(0, 5.6, 1.2), Vector3.new(6.0, 2.8, 4.2))
		Kit.box(m, cf * CFrame.new(0, 5.6, -1.0), Vector3.new(5.2, 2.0, 0.12), LINE) -- 앞유리 틀
		Kit.box(m, cf * CFrame.new(0, 1.6, -2.3), Vector3.new(6.4, 0.8, 0.4), LINE) -- 범퍼
		for _, s in { -1, 1 } do
			Kit.box(m, cf * CFrame.new(s * 2.2, 2.6, -2.2), Vector3.new(1.0, 0.6, 0.15), LINE)
			Kit.box(m, cf * CFrame.new(s * 3.6, 5.4, -1.0), Vector3.new(0.5, 1.4, 0.3), LINE) -- 거울
		end
		solid(m, cf * CFrame.new(0, 0, 0.6), Vector3.new(6.6, 7, 6.2))
	end
end

-- z 핸드 파레트 잭 + 팔레트 + 짐 하나
function P.PalletJack(ctx: any, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "PalletJack")
	local cf = CFrame.new(p) * CFrame.Angles(0, ctx.hash(i, j, 3) * 1.0 - 0.5, 0)
	for _, x in { -1.8, 0, 1.8 } do
		Kit.box(m, cf * CFrame.new(x, 0.3, -0.6), Vector3.new(0.5, 0.6, 4.4), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 0.7, -0.6), Vector3.new(4.4, 0.2, 4.4), SOFT)
	Kit.crate(m, at(cf, -0.4, 0.8, -0.8), Vector3.new(3.0, 2.4, 2.8), ctx.hash(i, j, 5))
	Kit.box(m, cf * CFrame.new(0, 0.9, 2.2), Vector3.new(2.2, 1.4, 1.0), SOFT)
	Kit.cylinder(m, at(cf, 0, 1.4, 2.4), at(cf, 0, 4.2, 3.4), 0.12, LINE)
	Kit.cylinder(m, at(cf, -0.8, 4.2, 3.4), at(cf, 0.8, 4.2, 3.4), 0.12, LINE)
	solid(m, cf * CFrame.new(0, 0, 0.2), Vector3.new(4.4, 3.2, 5.8))
end

-- Y 재활용 수거함: 바퀴 달린 큰 통 + 기울어진 뚜껑 + 넘친 봉투
function P.RecycleBin(ctx: any, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "RecycleBin")
	Kit.box(m, cf * CFrame.new(0, 2.6, 1.4), Vector3.new(5.6, 4.0, 3.6))
	Kit.box(m, cf * CFrame.new(0, 4.9, 1.4) * CFrame.Angles(ctx.hash(i, j, 2) * 0.35, 0, 0), Vector3.new(5.9, 0.3, 3.9), LINE)
	for _, x in { -2.2, 2.2 } do
		for _, z in { 0, 2.8 } do
			Kit.cylinder(m, at(cf, x - 0.15, 0.4, z), at(cf, x + 0.15, 0.4, z), 0.4, LINE)
		end
	end
	Kit.box(m, cf * CFrame.new(0, 3.0, -0.44), Vector3.new(4.6, 0.2, 0.1), LINE)
	for k = 0, 1 do
		Kit.ball(m, at(cf, -1.4 + k * 2.6, 0.8, -1.8 + ctx.hash(i, j, 6 + k)), 0.9, LINE)
	end
	solid(m, cf * CFrame.new(0, 0, 1.2), Vector3.new(5.8, 4.8, 4.0))
end

return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="144">
          <Properties>
            <string name="Name">School</string>
            <string name="Source"><![CDATA[--!nonstrict
-- 챕터 7 학교 전용 소품(타일 문자 → 함수). Stage7.luau 의 Props 줄에서 쓴다.
-- MapKit 부품만(검은 무광, 음파 윤곽선). 굵은 윤곽 위주, 막는 소품은 보이지 않는 충돌 상자를 둔다.
--   T 학생 책상 + 의자        G 칠판 + 교탁(서쪽 앞 벽)   N 게시판(벽, 지나감)      k 사물함·캐비닛(벽, 지나감)
--   W 신발장                  U 화장실 칸                 I 세면대 + 거울           J 실험대(개수대)
--   Y 업라이트 피아노         e 이젤                      M 방송 콘솔               F 급식 식탁(긴 의자)
--   V 배식대                  H 서가                      g 농구대(벽)              u 체육관 단상
--   t 중정 나무(줄기 + 가지)  h 중정 동상(받침대 위 인물)  r 화단(낮은 벽돌 틀)      j 중정 벤치
--   q 뜀틀·매트 더미          x 트로피 진열장(벽)          w 정수기(벽, 지나감)      P 프로젝터 스크린(벽)

local Kit = require(script.Parent.Parent.MapKit)

local P = {}

local LINE = { blocks = false, collide = false }
local SOFT = { blocks = false }

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

local function wallSide(ctx, i: number, j: number): Vector3?
	for _, d in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local function model(ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end

local function solid(m: Instance, cf: CFrame, size: Vector3)
	Kit.box(m, cf * CFrame.new(0, size.Y / 2, 0), size, { invisible = true, tag = false })
end

local function runAxis(ctx, i: number, j: number, ch: string): Vector3
	if ctx.at(i, j - 1) == ch or ctx.at(i, j + 1) == ch then
		return Vector3.new(0, 0, 1)
	end
	return Vector3.new(1, 0, 0)
end

-- 벽을 등진 좌표계: 로컬 -Z = 방 안쪽, +Z = 벽 쪽. prefer 방향이 벽이면 그쪽을 쓴다
local function againstWall(ctx, i: number, j: number, prefer: Vector3?): CFrame
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	if prefer and ctx.isWall(i + prefer.X, j + prefer.Z) then
		side = prefer
	end
	return CFrame.lookAt(p, p - side)
end

local function at(cf: CFrame, x: number, y: number, z: number): Vector3
	return (cf * CFrame.new(x, y, z)).Position
end

-- T 학생 책상 + 의자(교탁이 있는 서쪽을 본다). 몇 개는 삐뚤거나 의자가 넘어졌다
function P.StudentDesk(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local yaw = (ctx.hash(i, j, 3) - 0.5) * 0.3
	local cf = CFrame.lookAt(p, p + Vector3.new(-1, 0, 0)) * CFrame.Angles(0, yaw, 0) -- 로컬 -Z = 앞(서쪽)
	local m = model(ctx, "StudentDesk")
	Kit.box(m, cf * CFrame.new(0, 2.6, -0.8), Vector3.new(2.8, 0.18, 1.9), SOFT)
	Kit.box(m, cf * CFrame.new(0, 2.1, -0.8), Vector3.new(2.3, 0.6, 1.5), LINE) -- 서랍
	for _, x in { -1.2, 1.2 } do
		Kit.box(m, cf * CFrame.new(x, 1.25, -0.8), Vector3.new(0.12, 2.5, 1.5), LINE) -- 다리 틀
	end
	local fallen = ctx.hash(i, j, 4) > 0.82
	local ch = if fallen then cf * CFrame.new(0.4, 0.8, 1.8) * CFrame.Angles(math.pi / 2, 0.5, 0) else cf * CFrame.new(0, 0, 1.2)
	Kit.box(m, ch * CFrame.new(0, 1.6, 0), Vector3.new(1.6, 0.15, 1.5), SOFT)
	Kit.box(m, ch * CFrame.new(0, 2.8, 0.75), Vector3.new(1.6, 0.9, 0.12), SOFT)
	for _, x in { -0.7, 0.7 } do
		Kit.box(m, ch * CFrame.new(x, 1.6, 0.75), Vector3.new(0.1, 3.0, 0.1), LINE)
		Kit.box(m, ch * CFrame.new(x, 0.8, -0.65), Vector3.new(0.1, 1.6, 0.1), LINE)
	end
	solid(m, cf * CFrame.new(0, 0, 0), Vector3.new(3, 2.8, 4))
end

-- G 칠판(벽 가운데, 세로로 세 칸 길이) + 분필 받침 + 교탁
function P.Blackboard(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(-1, 0, 0))
	local m = model(ctx, "Blackboard")
	local z = ctx.T / 2 - 0.25
	Kit.box(m, cf * CFrame.new(0, 5.6, z), Vector3.new(15, 4.4, 0.2), LINE)
	Kit.box(m, cf * CFrame.new(0, 5.6, z - 0.14), Vector3.new(14.2, 3.6, 0.08), LINE)
	Kit.box(m, cf * CFrame.new(0, 3.3, z - 0.35), Vector3.new(15, 0.18, 0.6), LINE) -- 분필 받침
	for _, x in { -5.4, -5.0, 1.0 } do -- 분필 낙서 선 몇 줄
		Kit.box(m, cf * CFrame.new(x, 5.8, z - 0.2) * CFrame.Angles(0, 0, x * 0.2), Vector3.new(0.12, 1.6, 0.05), LINE)
	end
	-- 교탁
	local t = cf * CFrame.new(0, 0, -0.4)
	Kit.box(m, t * CFrame.new(0, 1.8, 0), Vector3.new(3.4, 3.6, 1.8), SOFT)
	Kit.box(m, t * CFrame.new(0, 3.75, 0) * CFrame.Angles(0.15, 0, 0), Vector3.new(3.8, 0.2, 2.2), SOFT)
	solid(m, t, Vector3.new(3.8, 4, 2.2))
end

-- N 게시판(벽면): 판 + 종이 몇 장
function P.NoticeBoard(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "NoticeBoard")
	local z = ctx.T / 2 - 0.2
	Kit.box(m, cf * CFrame.new(0, 5.6, z), Vector3.new(6.4, 3.2, 0.15), LINE)
	for k = 0, 2 do
		local r = ctx.hash(i, j, 90 + k)
		Kit.box(m, cf * CFrame.new(-2 + k * 2, 5.4 + r * 0.6, z - 0.1) * CFrame.Angles(0, 0, (r - 0.5) * 0.5), Vector3.new(1.1, 1.5, 0.05), LINE)
	end
end

-- k 학생 사물함(벽면 낮은 2단, 칸 반이 빈다)
function P.Locker(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Locker")
	local z = ctx.T / 2 - 1.0
	Kit.box(m, cf * CFrame.new(0, 2.2, z), Vector3.new(7.2, 4.4, 1.8))
	Kit.box(m, cf * CFrame.new(0, 2.2, z - 0.93), Vector3.new(7.0, 0.12, 0.08), LINE)
	for k = -1, 1 do
		Kit.box(m, cf * CFrame.new(k * 1.8, 2.2, z - 0.93), Vector3.new(0.1, 4.2, 0.08), LINE)
	end
end

-- W 신발장: 현관의 낮은 칸칸이 선반
function P.ShoeLocker(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "W")
	local cf = CFrame.lookAt(p, p + axis)
	local m = model(ctx, "ShoeLocker")
	local L = ctx.T
	local h = 4.6
	Kit.box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(2.6, h, L))
	for _, s in { -1, 1 } do
		for k = 1, 3 do
			Kit.box(m, cf * CFrame.new(s * 1.34, k * h / 4, 0), Vector3.new(0.08, 0.1, L - 0.2), LINE)
		end
		for k = -1, 1 do
			Kit.box(m, cf * CFrame.new(s * 1.34, h / 2, k * L / 4), Vector3.new(0.08, h - 0.2, 0.1), LINE)
		end
	end
end

-- U 화장실 칸
function P.ToiletStall(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j, Vector3.new(1, 0, 0))
	local m = model(ctx, "ToiletStall")
	local h = 6.6
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 3.2, h / 2 + 0.6, 1.4), Vector3.new(0.15, h, 5.0), SOFT)
	end
	Kit.box(m, cf * CFrame.new(-2.0, h / 2 + 0.6, -1.1) * CFrame.Angles(0, 0.5, 0), Vector3.new(2.4, h, 0.15), SOFT)
	Kit.box(m, cf * CFrame.new(2.3, h / 2 + 0.6, -1.1), Vector3.new(1.7, h, 0.15), SOFT)
	Kit.cylinder(m, at(cf, 0, 0, 1.6), at(cf, 0, 1.6, 1.6), 0.8, SOFT)
	Kit.cylinder(m, at(cf, 0, 1.6, 1.4), at(cf, 0, 1.85, 1.4), 1.0, LINE)
	Kit.box(m, cf * CFrame.new(0, 2.6, 3.1), Vector3.new(1.8, 1.8, 0.9), SOFT)
	solid(m, cf * CFrame.new(0, 0, 1.4), Vector3.new(6.6, 7, 5.2))
end

-- I 세면대 + 거울
function P.Sink(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Sink")
	local z = ctx.T / 2 - 1.1
	Kit.box(m, cf * CFrame.new(0, 2.7, z), Vector3.new(6.4, 0.9, 2.0), SOFT)
	for _, x in { -1.8, 1.8 } do
		Kit.box(m, cf * CFrame.new(x, 3.18, z - 0.1), Vector3.new(1.8, 0.05, 1.2), LINE)
		Kit.cylinder(m, at(cf, x, 3.1, z + 0.6), at(cf, x, 4.0, z + 0.6), 0.1, LINE)
		Kit.cylinder(m, at(cf, x, 4.0, z + 0.6), at(cf, x, 3.9, z - 0.1), 0.1, LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 6.2, ctx.T / 2 - 0.25), Vector3.new(6.2, 2.4, 0.1), LINE)
	solid(m, cf * CFrame.new(0, 0, z), Vector3.new(6.6, 3.3, 2.2))
end

-- J 과학 실험대: 검은 상판 + 개수대 + 수도 + 비커 몇 개
function P.LabBench(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p)
	local m = model(ctx, "LabBench")
	Kit.box(m, cf * CFrame.new(0, 1.6, 0), Vector3.new(6.0, 3.2, 2.8), SOFT)
	Kit.box(m, cf * CFrame.new(0, 3.3, 0), Vector3.new(6.6, 0.25, 3.2), SOFT)
	Kit.cylinder(m, at(cf, 2.2, 3.4, 0.8), at(cf, 2.2, 4.8, 0.8), 0.1, LINE)
	Kit.cylinder(m, at(cf, 2.2, 4.8, 0.8), at(cf, 2.2, 4.6, 0), 0.1, LINE)
	for k = 0, 1 do -- 비커
		local c = at(cf, -1.8 + k * 1.3, 3.4, (ctx.hash(i, j, 12 + k) - 0.5) * 1.6)
		Kit.cylinder(m, c, c + Vector3.new(0, 1.0 - k * 0.3, 0), 0.4, LINE)
	end
	for _, x in { -1.2, 1.2 } do -- 둥근 의자
		local c = at(cf, x, 0, 2.6)
		Kit.cylinder(m, c, c + Vector3.new(0, 1.9, 0), 0.15, LINE)
		Kit.cylinder(m, c + Vector3.new(0, 1.9, 0), c + Vector3.new(0, 2.1, 0), 0.7, LINE)
	end
	solid(m, cf, Vector3.new(6.6, 3.5, 3.2))
end

-- Y 업라이트 피아노 + 의자
function P.Piano(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + Vector3.new(-1, 0, 0))
	local m = model(ctx, "Piano")
	Kit.box(m, cf * CFrame.new(0, 2.6, -1.2), Vector3.new(6.0, 5.2, 1.6))
	Kit.box(m, cf * CFrame.new(0, 2.7, 0.2), Vector3.new(5.8, 0.4, 1.6), SOFT) -- 건반 선반
	for k = -3, 3 do
		Kit.box(m, cf * CFrame.new(k * 0.75, 2.95, 0.4), Vector3.new(0.18, 0.1, 0.9), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 4.2, -0.3) * CFrame.Angles(-0.2, 0, 0), Vector3.new(2.6, 1.4, 0.1), LINE) -- 악보대
	for _, x in { -2.7, 2.7 } do
		Kit.box(m, cf * CFrame.new(x, 1.3, 0.8), Vector3.new(0.4, 2.6, 0.4), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 1.8, 2.4), Vector3.new(2.4, 0.4, 1.2), SOFT)
	for _, x in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(x, 0.8, 2.4), Vector3.new(0.2, 1.6, 1.0), LINE)
	end
	solid(m, cf * CFrame.new(0, 0, -0.4), Vector3.new(6.2, 5.2, 3.2))
end

-- e 이젤 + 캔버스
function P.Easel(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, (ctx.hash(i, j, 15) - 0.5) * 1.4, 0)
	local m = model(ctx, "Easel")
	Kit.cylinder(m, at(cf, -1.3, 0, -0.6), at(cf, -0.3, 6.4, 0), 0.12, LINE)
	Kit.cylinder(m, at(cf, 1.3, 0, -0.6), at(cf, 0.3, 6.4, 0), 0.12, LINE)
	Kit.cylinder(m, at(cf, 0, 0, 1.8), at(cf, 0, 6.2, 0.1), 0.12, LINE)
	Kit.box(m, cf * CFrame.new(0, 4.3, -0.4) * CFrame.Angles(0.1, 0, 0), Vector3.new(3.0, 3.4, 0.15), SOFT)
	Kit.box(m, cf * CFrame.new(0, 2.5, -0.55), Vector3.new(3.0, 0.2, 0.5), LINE)
	solid(m, cf, Vector3.new(3, 6, 2.6))
end

-- M 방송 콘솔: 조절판 + 스피커 + 마이크
function P.BroadcastDesk(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "BroadcastDesk")
	Kit.box(m, cf * CFrame.new(0, 1.5, 2.2), Vector3.new(7.6, 3.0, 2.6), SOFT)
	Kit.wedge(m, cf * CFrame.new(0, 3.5, 2.2), Vector3.new(7.4, 1.0, 2.2), SOFT)
	for k = -3, 3 do -- 조절 손잡이
		Kit.box(m, cf * CFrame.new(k * 0.9, 3.75, 1.9), Vector3.new(0.2, 0.5, 0.3), LINE)
	end
	for _, x in { -2.8, 2.8 } do -- 벽 스피커
		Kit.box(m, cf * CFrame.new(x, 6.6, ctx.T / 2 - 0.8), Vector3.new(1.6, 2.4, 1.2), SOFT)
	end
	Kit.cylinder(m, at(cf, 0.4, 3.8, 1.6), at(cf, 0, 5.2, 0.7), 0.08, LINE)
	Kit.ball(m, at(cf, 0, 5.3, 0.6), 0.3, LINE)
	solid(m, cf * CFrame.new(0, 0, 2.2), Vector3.new(7.6, 4, 2.8))
end

-- F 급식 식탁: 긴 상 + 붙은 긴 의자
function P.LunchTable(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "F")
	local cf = CFrame.lookAt(p, p + axis)
	local m = model(ctx, "LunchTable")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 2.7, 0), Vector3.new(2.6, 0.22, L), SOFT)
	for _, s in { -1, 1 } do
		Kit.box(m, cf * CFrame.new(s * 2.3, 1.5, 0), Vector3.new(1.0, 0.18, L), SOFT)
	end
	for _, z in { -2.6, 2.6 } do
		Kit.box(m, cf * CFrame.new(0, 1.35, z), Vector3.new(0.3, 2.7, 0.3), LINE)
		Kit.box(m, cf * CFrame.new(0, 0.7, z), Vector3.new(4.8, 0.2, 0.25), LINE)
	end
	if ctx.hash(i, j, 22) > 0.6 then -- 남은 식판
		Kit.box(m, cf * CFrame.new(0.4, 2.9, 1.2) * CFrame.Angles(0, 0.4, 0), Vector3.new(1.4, 0.15, 1.0), LINE)
	end
	solid(m, cf, Vector3.new(5.2, 2.9, L))
end

-- V 배식대: 카운터 + 유리 가림막 틀 + 국통
function P.ServingCounter(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "V")
	local cf = CFrame.lookAt(p, p + axis)
	local m = model(ctx, "ServingCounter")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 1.7, 0), Vector3.new(2.8, 3.4, L), SOFT)
	Kit.box(m, cf * CFrame.new(0, 3.5, 0), Vector3.new(3.4, 0.2, L), SOFT)
	for _, z in { -L / 2 + 0.3, L / 2 - 0.3 } do
		Kit.box(m, cf * CFrame.new(0, 4.8, z), Vector3.new(0.2, 2.6, 0.2), LINE)
	end
	Kit.box(m, cf * CFrame.new(0, 6.1, 0), Vector3.new(2.2, 0.2, L), LINE) -- 가림막 윗판
	local c = at(cf, 0, 3.6, (ctx.hash(i, j, 25) - 0.5) * 3)
	Kit.cylinder(m, c, c + Vector3.new(0, 1.0, 0), 0.9, LINE)
	solid(m, cf, Vector3.new(3.4, 3.6, L))
end

-- H 서가: 양면 5단 책꽂이
function P.Bookshelf(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "H")
	local cf = CFrame.lookAt(p, p + axis)
	local m = model(ctx, "Bookshelf")
	local L = ctx.T
	local h = 7.4
	Kit.box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(0.3, h, L))
	for _, z in { -L / 2 + 0.15, L / 2 - 0.15 } do
		Kit.box(m, cf * CFrame.new(0, h / 2, z), Vector3.new(2.8, h, 0.25), SOFT)
	end
	for k = 0, 4 do
		Kit.box(m, cf * CFrame.new(0, 0.4 + k * 1.75, 0), Vector3.new(2.8, 0.15, L - 0.4), LINE)
	end
	for k = 0, 3 do -- 남은 책 묶음
		local r = ctx.hash(i, j, 40 + k)
		Kit.box(m, cf * CFrame.new(if r > 0.5 then 0.8 else -0.8, 1.15 + k * 1.75, (ctx.hash(i, j, 50 + k) - 0.5) * (L - 3.4)), Vector3.new(0.9, 1.3, 2.4), LINE)
	end
	solid(m, cf, Vector3.new(2.8, h, L))
end

-- g 농구대(벽): 벽 지지대 + 백보드 + 림
function P.Hoop(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Hoop")
	local z = ctx.T / 2
	local y = math.min(ctx.H - 3.2, 10)
	Kit.box(m, cf * CFrame.new(0, y, z - 2.4), Vector3.new(6.4, 4.0, 0.25), SOFT)
	Kit.box(m, cf * CFrame.new(0, y - 0.5, z - 2.6), Vector3.new(2.2, 1.6, 0.08), LINE)
	for _, x in { -1.6, 1.6 } do
		Kit.cylinder(m, at(cf, x, y + 0.6, z - 0.2), at(cf, x, y + 0.6, z - 2.3), 0.15, LINE)
	end
	local n = 8
	for k = 0, n - 1 do -- 림
		local a0, a1 = k * 2 * math.pi / n, (k + 1) * 2 * math.pi / n
		Kit.cylinder(m, at(cf, math.cos(a0) * 1.1, y - 1.4, z - 4.0 + math.sin(a0) * 1.1), at(cf, math.cos(a1) * 1.1, y - 1.4, z - 4.0 + math.sin(a1) * 1.1), 0.08, LINE)
	end
	-- 벽 아래 안전 매트(막힌 칸인 까닭)
	Kit.box(m, cf * CFrame.new(0, 2.6, z - 0.6), Vector3.new(7.6, 5.2, 1.0))
	solid(m, cf * CFrame.new(0, 0, z - 0.6), Vector3.new(7.6, 5.2, 1.1))
end

-- u 체육관 단상: 무대 한 칸(낮은 단 + 앞판 선 + 뒤 막)
function P.Stage(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p)
	local m = model(ctx, "GymStage")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 1.7, 0), Vector3.new(L, 3.4, L))
	Kit.box(m, cf * CFrame.new(0, 3.3, L / 2 + 0.05), Vector3.new(L, 0.25, 0.15), LINE)
	for _, x in { -L / 4, L / 4 } do
		Kit.box(m, cf * CFrame.new(x, 1.6, L / 2 + 0.05), Vector3.new(0.12, 2.8, 0.1), LINE)
	end
	for k = 0, 2 do -- 뒤쪽 막 주름
		Kit.box(m, cf * CFrame.new(-2.7 + k * 2.7, 3.4 + (ctx.H - 4.6) / 2, -L / 2 + 0.5) * CFrame.Angles(0, if k % 2 == 0 then 0.25 else -0.25, 0), Vector3.new(2.6, ctx.H - 4.6, 0.12), LINE)
	end
end

-- t 중정 나무: 굵은 줄기 + 사방 가지(잎 없는 겨울나무 — 음파에 가지 선이 또렷하다)
function P.Tree(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Tree")
	local top = math.min(ctx.H - 0.6, 10.5)
	Kit.cylinder(m, p, p + Vector3.new(0.3, top * 0.6, 0.2), 0.7, SOFT)
	local fork = p + Vector3.new(0.3, top * 0.6, 0.2)
	for k = 0, 3 do
		local a = k * math.pi / 2 + ctx.hash(i, j, 60 + k) * 0.8
		local tip = fork + Vector3.new(math.cos(a) * 3.0, top * 0.35 + ctx.hash(i, j, 70 + k), math.sin(a) * 3.0)
		Kit.cylinder(m, fork, tip, 0.22, LINE)
	end
	Kit.box(m, CFrame.new(p + Vector3.new(0, 0.3, 0)), Vector3.new(4.4, 0.6, 4.4), LINE) -- 나무 둘레 보호틀
	solid(m, CFrame.new(p), Vector3.new(2.2, top, 2.2))
end

-- h 중정 동상: 두 단 받침대 + 책을 든 인물(머리·몸·팔 덩어리) — 중정 한가운데 랜드마크
function P.Statue(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.lookAt(p, p + Vector3.new(0, 0, 1))
	local m = model(ctx, "Statue")
	Kit.box(m, cf * CFrame.new(0, 0.6, 0), Vector3.new(6.4, 1.2, 6.4))
	Kit.box(m, cf * CFrame.new(0, 2.4, 0), Vector3.new(3.6, 2.4, 3.6))
	Kit.box(m, cf * CFrame.new(0, 4.6, 0), Vector3.new(1.8, 2.0, 1.1), SOFT) -- 다리·옷자락
	Kit.box(m, cf * CFrame.new(0, 6.6, 0), Vector3.new(2.2, 2.2, 1.2), SOFT) -- 몸
	Kit.ball(m, at(cf, 0, 8.3, 0), 0.75, SOFT) -- 머리
	Kit.box(m, cf * CFrame.new(1.2, 6.9, 0.7) * CFrame.Angles(-0.9, 0, 0), Vector3.new(0.5, 2.0, 0.5), SOFT) -- 책 든 팔
	Kit.box(m, cf * CFrame.new(1.2, 7.4, 1.4), Vector3.new(1.4, 1.0, 0.25), LINE) -- 책
	solid(m, cf, Vector3.new(6.4, 9, 6.4))
end

-- r 화단: 무릎 높이 벽돌 틀 + 마른 줄기 몇 개
function P.FlowerBed(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local axis = runAxis(ctx, i, j, "r")
	local cf = CFrame.lookAt(p, p + axis)
	local m = model(ctx, "FlowerBed")
	local L = ctx.T
	Kit.box(m, cf * CFrame.new(0, 0.9, 0), Vector3.new(4.6, 1.8, L))
	Kit.box(m, cf * CFrame.new(0, 1.85, 0), Vector3.new(3.8, 0.1, L - 0.8), LINE)
	for k = -1, 1 do
		local x = (ctx.hash(i, j, 80 + k) - 0.5) * 2.4
		Kit.cylinder(m, at(cf, x, 1.8, k * 2.4), at(cf, x * 1.2, 3.4, k * 2.6), 0.08, LINE)
	end
end

-- j 중정 벤치: 앉는 판 + 등판 + 다리 둘
function P.Bench(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "Bench")
	Kit.box(m, cf * CFrame.new(0, 1.7, 1.2), Vector3.new(6.4, 0.25, 1.8), SOFT)
	Kit.box(m, cf * CFrame.new(0, 2.9, 2.1) * CFrame.Angles(-0.15, 0, 0), Vector3.new(6.4, 1.4, 0.2), SOFT)
	for _, x in { -2.6, 2.6 } do
		Kit.box(m, cf * CFrame.new(x, 0.85, 1.2), Vector3.new(0.3, 1.7, 1.6), LINE)
	end
	solid(m, cf * CFrame.new(0, 0, 1.2), Vector3.new(6.6, 2.0, 2.0))
end

-- q 뜀틀 + 접은 매트 더미(체육관 창고에서 끌어낸 것)
function P.VaultBox(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local cf = CFrame.new(p) * CFrame.Angles(0, (ctx.hash(i, j, 33) - 0.5) * 0.6, 0)
	local m = model(ctx, "VaultBox")
	for k = 0, 3 do -- 뜀틀 단(위로 갈수록 좁다)
		Kit.box(m, cf * CFrame.new(-1.2, 0.5 + k * 0.95, 0), Vector3.new(3.4 - k * 0.3, 0.9, 5.2 - k * 0.3), if k == 3 then SOFT else nil)
	end
	Kit.box(m, cf * CFrame.new(2.2, 0.9, 0) * CFrame.Angles(0, 0, 0.12), Vector3.new(2.4, 1.8, 5.6), SOFT) -- 접은 매트
	solid(m, cf, Vector3.new(7, 4, 6))
end

-- x 트로피 진열장(벽): 유리장 틀 + 선반 셋 + 트로피 몇 개
function P.TrophyCase(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "TrophyCase")
	local z = ctx.T / 2 - 1.1
	local h = math.min(ctx.H - 1.5, 8)
	Kit.box(m, cf * CFrame.new(0, h / 2, z), Vector3.new(6.6, h, 2.0), SOFT)
	for k = 1, 3 do
		Kit.box(m, cf * CFrame.new(0, k * h / 4, z - 0.2), Vector3.new(6.2, 0.12, 1.6), LINE)
		local x = (ctx.hash(i, j, 100 + k) - 0.5) * 4
		local c = at(cf, x, k * h / 4, z - 0.2)
		Kit.cylinder(m, c, c + Vector3.new(0, 1.2, 0), 0.35, LINE)
	end
	solid(m, cf * CFrame.new(0, 0, z), Vector3.new(6.6, h, 2.1))
end

-- w 정수기(벽, 지나감): 몸통 + 물통 + 컵 받침
function P.WaterCooler(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "WaterCooler")
	local z = ctx.T / 2 - 1.0
	Kit.box(m, cf * CFrame.new(1.8, 2.2, z), Vector3.new(1.8, 4.4, 1.8), SOFT)
	Kit.cylinder(m, at(cf, 1.8, 4.4, z), at(cf, 1.8, 6.0, z), 0.8, LINE)
	Kit.box(m, cf * CFrame.new(1.8, 3.0, z - 1.0), Vector3.new(1.2, 0.12, 0.3), LINE)
end

-- P 프로젝터 스크린(시청각실 앞 벽): 내려온 스크린 막 + 위 통 + 아래 교탁
function P.ProjectorScreen(ctx, i: number, j: number)
	local cf = againstWall(ctx, i, j)
	local m = model(ctx, "ProjectorScreen")
	local z = ctx.T / 2 - 0.3
	local top = ctx.H - 1.2
	Kit.box(m, cf * CFrame.new(0, top, z), Vector3.new(14, 0.6, 0.6), SOFT)
	Kit.box(m, cf * CFrame.new(0, top - 3.4, z - 0.1), Vector3.new(13, 6.2, 0.08), LINE)
	Kit.box(m, cf * CFrame.new(-2.2, 1.6, z - 2.2), Vector3.new(2.4, 3.2, 1.6), SOFT)
	solid(m, cf * CFrame.new(-2.2, 0, z - 2.2), Vector3.new(2.6, 3.4, 1.8))
end

return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="145">
          <Properties>
            <string name="Name">Sewer</string>
            <string name="Source"><![CDATA[--!strict
-- 챕터 3 하수도 전용 소품(타일 문자 → 함수). Stage3.luau 의 Props 줄에서 쓴다.
-- MapKit 부품만(검은 무광, 음파 윤곽선). 굵은 윤곽 위주, 소품 하나 25개 이하. 막는 소품은 보이지 않는 충돌 상자를 둔다.
--   l 맨홀 사다리(벽에 붙은 철제 사다리 + 천장 맨홀 테, 지나갈 수 있음)
--   M 원심 펌프(모터 + 펌프 몸통 + 토출관이 천장으로)       V 밸브 스탠드(기둥 + 큰 손바퀴)
--   Y 계기 제어반(둥근 압력계 줄 + 스위치)                  G 수문 승강기(문틀 + 나사봉 + 손바퀴)
--   H 협잡물 스크린(수로 칸: 물 + 비스듬한 철창, 아래층 칸)  J 정비 작업대
--   I 배관 자재 더미(굵은 관 토막을 쌓아 묶음)

local Kit = require(script.Parent.Parent.MapKit)
local Props = require(script.Parent.Parent.Props)

local Sewer = {}

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

local function wallSide(ctx, i: number, j: number): Vector3?
	for _, d in { { 0, -1 }, { 1, 0 }, { -1, 0 }, { 0, 1 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local function model(ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end

local function solid(m: Instance, p: Vector3, size: Vector3)
	Kit.box(m, CFrame.new(p + Vector3.new(0, size.Y / 2, 0)), size, { invisible = true, tag = false })
end

-- l 맨홀 사다리: 벽면 사다리(두 기둥 + 가로대) 가 천장 맨홀 테까지
function Sewer.Ladder(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local across = Vector3.new(side.Z, 0, -side.X)
	local m = model(ctx, "Ladder")
	local w = p + side * (ctx.T / 2 - 0.55)
	local top = ctx.H - ctx.floorY(i, j)
	for _, s in { -1, 1 } do
		local a = w + across * (s * 0.9)
		Kit.cylinder(m, a, a + Vector3.new(0, top, 0), 0.1, { blocks = false, collide = false })
	end
	for k = 1, 9 do
		local c = w + Vector3.new(0, k * top / 10, 0)
		Kit.cylinder(m, c - across * 0.9, c + across * 0.9, 0.07, { blocks = false, collide = false })
	end
	-- 천장 맨홀 테(둥근 구멍 둘레)
	local h = w - side * 0.9 + Vector3.new(0, top - 0.2, 0)
	Kit.cylinder(m, h - Vector3.new(0, 0.3, 0), h, 1.9, { blocks = false, collide = false, rings = 2 })
end

-- M 원심 펌프: 받침 위 모터(원통) + 달팽이 몸통 + 토출관(위로, 천장 배관으로)
function Sewer.Pump(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "Pump")
	local ax = if ctx.hash(i, j, 7) > 0.5 then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
	Kit.box(m, CFrame.lookAt(p + Vector3.new(0, 0.4, 0), p + Vector3.new(0, 0.4, 0) + ax), Vector3.new(3.6, 0.8, 6.6), { name = "PumpBase" })
	-- 모터(눕힌 원통) + 냉각 띠
	local m0 = p - ax * 2.8 + Vector3.new(0, 2.4, 0)
	local m1 = p - ax * 0.2 + Vector3.new(0, 2.4, 0)
	Kit.cylinder(m, m0, m1, 1.5, { rings = 3 })
	-- 펌프 몸통(달팽이: 세운 원통)
	local body = p + ax * 1.6 + Vector3.new(0, 2.4, 0)
	local across = Vector3.new(ax.Z, 0, -ax.X)
	Kit.cylinder(m, body - across * 0.9, body + across * 0.9, 1.9, { rings = 2 })
	-- 흡입관(옆) + 토출관(위, 플랜지)
	Kit.pipe(m, body + across * 0.9, body + across * 3.6, 0.8, { 0 }, true)
	Kit.pipe(m, body + Vector3.new(0, 1.9, 0), Vector3.new(body.X, ctx.H, body.Z), 0.75, { 0.15, 0.85 }, true)
	solid(m, p, Vector3.new(6.6, 4.4, 6.6))
end

-- V 밸브 스탠드: 바닥 플랜지에서 솟은 기둥, 위에 큰 손바퀴(바큇살 넷)
function Sewer.ValveStand(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "ValveStand")
	Kit.box(m, CFrame.new(p + Vector3.new(0, 0.3, 0)), Vector3.new(2.6, 0.6, 2.6))
	Kit.cylinder(m, p + Vector3.new(0, 0.6, 0), p + Vector3.new(0, 4.4, 0), 0.45, { blocks = false })
	local hub = p + Vector3.new(0, 4.6, 0)
	Kit.cylinder(m, hub - Vector3.new(0, 0.15, 0), hub + Vector3.new(0, 0.15, 0), 2.0, { blocks = false, collide = false, rings = 1 })
	for k = 0, 1 do
		local a = k * math.pi / 2
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		Kit.cylinder(m, hub - d * 1.9, hub + d * 1.9, 0.1, { blocks = false, collide = false })
	end
	-- 바닥 아래로 내려가는 관(바닥 위로 조금 보이는 플랜지)
	Kit.pipe(m, p + Vector3.new(1.8, 0, 0), p + Vector3.new(1.8, 2.2, 0), 0.6, { 1 }, true)
	solid(m, p, Vector3.new(4.4, 5, 4.4))
end

-- Y 계기 제어반: 벽에 붙은 키 큰 함, 둥근 압력계 2x3, 스위치 줄
function Sewer.GaugePanel(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local m = model(ctx, "GaugePanel")
	local c = p + side * (ctx.T / 2 - 1.1) + Vector3.new(0, 3.4, 0)
	local cf = CFrame.lookAt(c, c - side)
	Kit.box(m, cf, Vector3.new(6.2, 6.8, 2.0))
	for a = -1, 1 do
		for b = 0, 1 do
			local g = (cf * CFrame.new(a * 1.9, 1.0 + b * 1.7, -1.0)).Position
			Kit.cylinder(m, g, g - side * 0.25, 0.65, { blocks = false, collide = false, rings = 1 })
		end
	end
	for a = -2, 2 do
		Kit.box(m, cf * CFrame.new(a * 1.0, -1.4, -1.15), Vector3.new(0.3, 0.6, 0.3), { blocks = false, collide = false })
	end
	solid(m, p + side * (ctx.T / 2 - 1.3), Vector3.new(if side.X ~= 0 then 2.6 else 6.4, 6.8, if side.X ~= 0 then 6.4 else 2.6))
end

-- G 수문 승강기: 벽 쪽 문틀(두 기둥 + 들보), 가운데 닫힌 철판 수문, 위로 솟은 나사봉 + 손바퀴
function Sewer.SluiceGate(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local across = Vector3.new(side.Z, 0, -side.X)
	local m = model(ctx, "SluiceGate")
	local c = p + side * (ctx.T / 2 - 1.2)
	for _, s in { -1, 1 } do
		local a = c + across * (s * 3.2)
		Kit.box(m, CFrame.new(a + Vector3.new(0, 4.8, 0)), Vector3.new(0.8, 9.6, 0.8))
	end
	Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 9.8, 0), c + Vector3.new(0, 9.8, 0) + across), Vector3.new(1.0, 0.8, 7.2))
	local gate = c + Vector3.new(0, 3.2, 0)
	Kit.box(m, CFrame.lookAt(gate, gate - side), Vector3.new(5.6, 6.4, 0.4), { name = "Gate" })
	for k = 1, 3 do
		Kit.box(m, CFrame.lookAt(gate, gate - side) * CFrame.new(0, -3.2 + k * 1.6, -0.3), Vector3.new(5.6, 0.25, 0.2), { blocks = false, collide = false })
	end
	-- 나사봉 + 손바퀴
	local st = c + Vector3.new(0, 6.4, 0)
	Kit.cylinder(m, st, st + Vector3.new(0, 4.6, 0), 0.18, { blocks = false, collide = false })
	local hub = c - side * 0.9 + Vector3.new(0, 10.6, 0)
	Kit.cylinder(m, hub, hub - side * 0.2, 1.3, { blocks = false, collide = false, rings = 1 })
	solid(m, c, Vector3.new(if side.X ~= 0 then 2.6 else 7.4, 10, if side.X ~= 0 then 7.4 else 2.6))
end

-- H 협잡물 스크린(수로 칸): 물 + 수로를 가로지르는 비스듬한 철창(쓰레기를 걸러 낸다)
function Sewer.BarScreen(ctx, i: number, j: number)
	Props.Water(ctx, i, j)
	local c = ctx.center(i, j)
	local m = model(ctx, "BarScreen")
	-- 물길 방향: 양옆(가로)이 벽이 아니면 가로로 흐른다
	local flow = if not ctx.isWall(i - 1, j) and not ctx.isWall(i + 1, j) then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
	local across = Vector3.new(flow.Z, 0, -flow.X)
	local y0 = ctx.PIT_Y
	for k = -3, 3 do
		local a = c + across * (k * 1.05) + Vector3.new(0, y0, 0) - flow * 1.4
		Kit.cylinder(m, a, a + flow * 2.6 + Vector3.new(0, 6.4, 0), 0.1, { blocks = false })
	end
	-- 위 가로대(보행로 높이)
	local t = c + flow * 1.2 + Vector3.new(0, 0.4, 0)
	Kit.box(m, CFrame.lookAt(t, t + across), Vector3.new(0.5, 0.5, ctx.T), { blocks = false })
end

-- J 정비 작업대: 철제 작업대 + 바이스 + 벽 공구판
function Sewer.Workbench(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local m = model(ctx, "Workbench")
	local c = p + side * (ctx.T / 2 - 1.9)
	local cf = CFrame.lookAt(c, c - side)
	Kit.box(m, cf * CFrame.new(0, 3.2, 0), Vector3.new(6.8, 0.3, 3.2))
	for _, x in { -3.1, 3.1 } do
		for _, z in { -1.4, 1.4 } do
			Kit.box(m, cf * CFrame.new(x, 1.5, z), Vector3.new(0.25, 3.0, 0.25), { blocks = false })
		end
	end
	Kit.box(m, cf * CFrame.new(2.4, 3.75, -1.2), Vector3.new(1.0, 0.8, 1.2), { blocks = false })
	local board = cf * CFrame.new(0, 6.0, 1.7)
	Kit.box(m, board, Vector3.new(6.4, 3.2, 0.12), { blocks = false, collide = false })
	for k = -2, 2 do
		Kit.box(m, board * CFrame.new(k * 1.2, -0.2 + (k % 2) * 0.5, -0.15), Vector3.new(0.18, 1.3, 0.12), { blocks = false, collide = false })
	end
	solid(m, c, Vector3.new(if side.X ~= 0 then 3.4 else 7, 4, if side.X ~= 0 then 7 else 3.4))
end

-- I 배관 자재 더미: 굵은 관 토막 3+2 단(받침목 위), 고정 띠
function Sewer.PipeStack(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "PipeStack")
	local ax = if ctx.at(i - 1, j) == "I" or ctx.at(i + 1, j) == "I" then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
	local across = Vector3.new(ax.Z, 0, -ax.X)
	local half = ctx.T / 2 - 0.4
	for _, s in { -1, 1 } do
		local b = p + ax * (s * 2.4) + Vector3.new(0, 0.25, 0)
		Kit.box(m, CFrame.lookAt(b, b + across), Vector3.new(0.5, 0.5, 6.4), { blocks = false })
	end
	local r = 0.95
	for k = -1, 1 do
		local c = p + across * (k * 2 * r) + Vector3.new(0, 0.5 + r, 0)
		Kit.cylinder(m, c - ax * half, c + ax * half, r, { rings = 1 })
	end
	for k = 0, 1 do
		local c = p + across * ((k - 0.5) * 2 * r) + Vector3.new(0, 0.5 + r * 2.7, 0)
		Kit.cylinder(m, c - ax * half, c + ax * half, r, { rings = 1 })
	end
	solid(m, p, Vector3.new(6.6, 4.6, 6.6))
end

return Sewer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="146">
          <Properties>
            <string name="Name">Warehouse</string>
            <string name="Source"><![CDATA[--!strict
-- 챕터 2 물류 창고 전용 소품(구역마다 실제로 있어야 할 장비). MapKit 부품만 쓴다(직접 만든 에셋).
--   H·h 팔레트 랙(가로·세로 줄): 줄 하나(등을 맞댄 두 줄이면 두 줄)를 머리 칸에서 한 덩어리로 짓는다 — 기둥은 두 칸마다, 보는 줄 길이 하나.
--       (예전 칸마다 짓던 랙은 칸당 부품 약 20개 → 지금은 칸당 약 2개, 음파 선도 긴 보 몇 줄로 깔끔하다)
--   k 박스 흐름 선반(피킹 메자닌, 세로 줄, 낮고 비스듬한 판)   u 컨베이어(줄 하나를 한 덩어리로)
--   F 지게차(랜드마크: 마스트·포크·운전석 지붕)    J 팔레트 적재(랩 감은 상자 더미)
--   g 지게차 충전기(벽 쪽 캐비닛 + 케이블)        e 냉동기 증발기(천장 쪽 벽걸이 팬 — 지나갈 수 있음)
--   R 서버 랙(전산실)    Y 포장대·검수대(작업대 + 모니터 + 상자)    W 랩 감는 기계(회전판 + 기둥 + 감긴 팔레트)
--   B 정비 작업대(바이스 + 공구판)    d 도크 문(말아 올린 셔터 + 도크 레벨러 — 지나갈 수 있음)
--   x 내려온 화재 셔터(벽 틈을 막은 철판, 막힘)    K 탑차(줄 머리에서 짐칸·운전석·바퀴)    G 정문 경비 초소
-- 각 함수는 StageBuilder 의 ctx 와 타일 좌표(i, j)를 받는다(i = 열 = X, j = 행 = Z). ctx.at 으로 이웃 칸 문자를 본다.


local Kit = require(script.Parent.Parent.MapKit)

local W = {}

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

-- 가장 가까운 벽 쪽(없으면 -Z)
local function wallSide(ctx, i: number, j: number): Vector3
	for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return Vector3.new(0, 0, -1)
end

local function model(ctx, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = ctx.props
	return m
end

-- 지게차: 차체·운전석 지붕 기둥·마스트·포크(벽 반대쪽을 본다)
function W.Forklift(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local fwd = -wallSide(ctx, i, j)
	local yaw = ctx.hash(i, j, 21) * 0.4 - 0.2
	local cf = CFrame.lookAt(p, p + fwd) * CFrame.Angles(0, yaw, 0)
	local m = model(ctx, "Forklift")
	Kit.box(m, cf * CFrame.new(0, 1.6, 0.6), Vector3.new(3.4, 2.2, 4.6), { blocks = false }) -- 차체
	Kit.box(m, cf * CFrame.new(0, 2.9, 2.4), Vector3.new(3.2, 1.4, 1.2), { blocks = false }) -- 균형추
	for _, x in { -1.5, 1.5 } do
		for _, z in { -0.6, 2.4 } do
			Kit.box(m, cf * CFrame.new(x, 4.6, z), Vector3.new(0.2, 3.4, 0.2), { blocks = false }) -- 지붕 기둥
		end
		Kit.cylinder(m, (cf * CFrame.new(x * 1.08, 0.75, -0.9)).Position, (cf * CFrame.new(x * 1.18, 0.75, -0.9)).Position, 0.75, { blocks = false, collide = false })
		Kit.cylinder(m, (cf * CFrame.new(x * 1.08, 0.6, 2.2)).Position, (cf * CFrame.new(x * 1.18, 0.6, 2.2)).Position, 0.6, { blocks = false, collide = false })
	end
	Kit.box(m, cf * CFrame.new(0, 6.35, 0.9), Vector3.new(3.4, 0.15, 3.4), { blocks = false }) -- 지붕
	for _, x in { -1.0, 1.0 } do
		Kit.box(m, cf * CFrame.new(x, 3.4, -1.9), Vector3.new(0.3, 6.6, 0.3), { blocks = false, axis = "Y" }) -- 마스트
		Kit.box(m, cf * CFrame.new(x * 0.8, 0.45, -3.3), Vector3.new(0.35, 0.12, 2.8), { blocks = false, collide = false }) -- 포크
	end
	Kit.box(m, cf * CFrame.new(0, 1.0, -2.0), Vector3.new(2.4, 1.4, 0.15), { blocks = false, collide = false }) -- 포크 등판
	Kit.box(m, cf * CFrame.new(0, 1.8, 0.2), Vector3.new(3.4, 3.6, 6.4), { invisible = true, tag = false })
end

-- 팔레트 적재: 나무 팔레트 + 랩 감은 상자 더미(높이 제각각)
function W.PalletStack(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "PalletStack")
	local h = ctx.hash(i, j, 22)
	for k, off in { Vector3.new(-1.9, 0, 0), Vector3.new(1.9, 0, 0) } do
		local q = p + off
		Kit.box(m, CFrame.new(q + Vector3.new(0, 0.3, 0)), Vector3.new(3.4, 0.6, 3.4), { blocks = false }) -- 팔레트
		local tall = 2 + ((k + math.floor(h * 4)) % 3) * 1.2
		Kit.box(m, CFrame.new(q + Vector3.new(0, 0.6 + tall / 2, 0)) * CFrame.Angles(0, (h - 0.5) * 0.2, 0), Vector3.new(3.1, tall, 3.1), { blocks = false })
	end
	Kit.box(m, CFrame.new(p + Vector3.new(0, 2, 0)), Vector3.new(7.4, 4, 3.6), { invisible = true, tag = false })
end

-- 컨베이어: 허리 높이 롤러 줄(긴 옆판 두 줄 + 롤러) + 다리. 벽과 나란히
function W.Conveyor(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local axis = Vector3.new(side.Z, 0, -side.X)
	local m = model(ctx, "Conveyor")
	local c = p - side * 1.0
	for _, s in { -1, 1 } do
		local rail = c + side * (s * 1.1) + Vector3.new(0, 3.0, 0)
		Kit.box(m, CFrame.lookAt(rail, rail + axis), Vector3.new(0.2, 0.5, 8), { blocks = false, axis = "Z" })
		for _, a in { -3.2, 3.2 } do
			local leg = c + side * (s * 1.0) + axis * a + Vector3.new(0, 1.4, 0)
			Kit.box(m, CFrame.new(leg), Vector3.new(0.25, 2.8, 0.25), { blocks = false })
		end
	end
	for k = -3, 3 do
		local r = c + axis * (k * 1.1) + Vector3.new(0, 3.05, 0)
		Kit.cylinder(m, r - side * 1.0, r + side * 1.0, 0.18, { blocks = false, collide = false })
	end
	-- 상자 하나(포장 중)
	Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 3.9, 0) + axis * 1.4, c + Vector3.new(0, 3.9, 0) + axis * 2.4), Vector3.new(1.6, 1.4, 1.8), { blocks = false })
	Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 1.6, 0), c + Vector3.new(0, 1.6, 0) + axis), Vector3.new(2.6, 3.2, 8), { invisible = true, tag = false })
end

-- 지게차 충전기: 벽에 붙은 캐비닛 + 표시창 + 바닥으로 늘어진 케이블
function W.Charger(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local m = model(ctx, "Charger")
	local c = p + side * (ctx.T / 2 - 1.0)
	Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 2.6, 0), c + Vector3.new(0, 2.6, 0) - side), Vector3.new(2.6, 5.2, 1.6))
	Kit.box(m, CFrame.lookAt(c - side * 0.85 + Vector3.new(0, 4.0, 0), c - side * 1.85 + Vector3.new(0, 4.0, 0)), Vector3.new(1.4, 0.8, 0.1), { blocks = false, collide = false })
	local a = c - side * 0.8 + Vector3.new(0.6, 2.2, 0)
	Kit.cylinder(m, a, a - side * 2.2 - Vector3.new(0, 2.0, 0), 0.15, { blocks = false, collide = false })
	Kit.cylinder(m, a - side * 2.2 - Vector3.new(0, 2.0, 0), a - side * 3.4 - Vector3.new(0, 2.1, 0), 0.15, { blocks = false, collide = false })
	-- 바닥 정차 표시(낮은 선)
	Kit.box(m, CFrame.lookAt(p - side * 1.5 + Vector3.new(0, 0.05, 0), p - side * 2.5 + Vector3.new(0, 0.05, 0)), Vector3.new(4.5, 0.1, 0.2), { blocks = false, collide = false })
end

-- 냉동기 증발기: 벽 위쪽에 매단 팬 상자(지나갈 수 있음)
function W.Evaporator(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local m = model(ctx, "Evaporator")
	local c = p + side * (ctx.T / 2 - 1.3) + Vector3.new(0, ctx.H - 2.4, 0)
	local across = Vector3.new(side.Z, 0, -side.X)
	Kit.box(m, CFrame.lookAt(c, c - side), Vector3.new(6.0, 2.2, 2.4), { blocks = false, collide = false })
	for _, s in { -1.5, 1.5 } do
		local f = c - side * 1.25 + across * s
		Kit.cylinder(m, f, f - side * 0.1, 0.9, { blocks = false, collide = false, rings = 1 })
	end
end

-- 서버 랙: 키 큰 캐비닛 + 앞면 줄(장비 칸)
function W.ServerRack(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local m = model(ctx, "ServerRack")
	local c = p + side * 1.4
	Kit.box(m, CFrame.lookAt(c + Vector3.new(0, 3.6, 0), c + Vector3.new(0, 3.6, 0) - side), Vector3.new(2.6, 7.2, 3.2))
	for k = 0, 5 do
		local y = 1.0 + k * 1.05
		Kit.box(m, CFrame.lookAt(c - side * 1.62 + Vector3.new(0, y, 0), c - side * 2.62 + Vector3.new(0, y, 0)), Vector3.new(2.2, 0.12, 0.08), { blocks = false, collide = false })
	end
end

-- ── 줄로 짓는 설비(랙·선반·컨베이어) ──
-- 머리 칸: 줄 방향 앞 칸도, 옆(두께) 방향 앞 칸도 같은 문자가 아닌 칸. 머리에서 줄 길이 n, 두께 deep(1 또는 2)을 재서 한 번에 짓는다.
type RunInfo = { n: number, deep: number, axis: Vector3, across: Vector3, center: Vector3 }
local function runHead(ctx, i: number, j: number, alongX: boolean): RunInfo?
	local ch = ctx.at(i, j)
	local di, dj = if alongX then 1 else 0, if alongX then 0 else 1
	local ci, cj = dj, di
	if ctx.at(i - di, j - dj) == ch or ctx.at(i - ci, j - cj) == ch then
		return nil
	end
	local n = 1
	while n < 40 and ctx.at(i + di * n, j + dj * n) == ch do
		n += 1
	end
	local deep = if ctx.at(i + ci, j + cj) == ch then 2 else 1
	local axis = Vector3.new(di, 0, dj)
	local across = Vector3.new(ci, 0, cj)
	local c = base(ctx, i, j) + axis * ((n - 1) * ctx.T / 2) + across * ((deep - 1) * ctx.T / 2)
	return { n = n, deep = deep, axis = axis, across = across, center = c }
end

-- 선반 틀: 기둥(두 칸마다, 앞·뒤 줄) + 층마다 앞·뒤 긴 보 + 칸마다 짐 하나 + 보이지 않는 충돌 하나
local function shelfRun(ctx, i: number, j: number, alongX: boolean, o: { name: string, height: number, levels: { number }, depthPad: number, tilt: number, load: Vector3 })
	local r = runHead(ctx, i, j, alongX)
	if not r then
		return
	end
	local T = ctx.T
	local m = model(ctx, o.name)
	local len = r.n * T - 0.6
	local depth = r.deep * T - o.depthPad
	local height = math.min(o.height, ctx.H - 0.8)
	local posts = math.max(1, math.floor(r.n / 2 + 0.5))
	for k = 0, posts do
		local t = -len / 2 + 0.15 + (len - 0.3) * (k / posts)
		for _, s in { -1, 1 } do
			local c = r.center + r.axis * t + r.across * (s * (depth / 2 - 0.15)) + Vector3.new(0, height / 2, 0)
			Kit.box(m, CFrame.lookAt(c, c + r.axis), Vector3.new(0.3, height, 0.3), { blocks = false, axis = "Y" })
		end
	end
	for _, y in o.levels do
		local yy = math.min(y, height - 0.2)
		for _, s in { -1, 1 } do
			-- (박스 흐름 선반은 판이 앞쪽으로 기운다: 뒤 보가 조금 높다)
			local c = r.center + r.across * (s * (depth / 2 - 0.15)) + Vector3.new(0, yy + (if s > 0 then o.tilt else 0), 0)
			Kit.box(m, CFrame.lookAt(c, c + r.axis), Vector3.new(0.25, 0.4, len), { blocks = false, axis = "Z" })
		end
	end
	-- 짐(칸마다 하나, 층·앞뒤는 칸마다 다르게)
	for k = 0, r.n - 1 do
		local h = ctx.hash(i + k * r.axis.X, j + k * r.axis.Z, 31)
		local lv = o.levels[1 + math.floor(h * #o.levels) % #o.levels]
		local side = if r.deep == 2 then (if h < 0.5 then -1 else 1) * T / 2 else 0
		if lv + o.load.Y < height then
			local c = r.center + r.axis * (-len / 2 + (k + 0.5) * T) + r.across * side + Vector3.new(0, lv + 0.25 + o.load.Y / 2, 0)
			Kit.box(m, CFrame.lookAt(c, c + r.axis) * CFrame.Angles(0, (h - 0.5) * 0.2, 0), o.load, { blocks = false })
		end
	end
	-- 보이지 않는 충돌(선반 사이로 들어가거나 올라가지 못하게)
	local cc = r.center + Vector3.new(0, height / 2, 0)
	Kit.box(m, CFrame.lookAt(cc, cc + r.axis), Vector3.new(depth, height, len), { invisible = true, tag = false })
end

local RACK = { name = "Rack", height = 10.2, levels = { 0.2, 3.6, 7.0 }, depthPad = 2.4, tilt = 0, load = Vector3.new(4.6, 2.6, 6.2) }
-- H 팔레트 랙(가로 줄, X 방향)
function W.RackRunX(ctx, i: number, j: number)
	shelfRun(ctx, i, j, true, RACK)
end
-- h 팔레트 랙(세로 줄, Z 방향: 냉장·냉동실)
function W.RackRunZ(ctx, i: number, j: number)
	shelfRun(ctx, i, j, false, RACK)
end
-- k 박스 흐름 선반(피킹 메자닌): 사람 키 높이, 판 셋이 통로 쪽으로 기운다. 세로 줄
local FLOW = { name = "CartonFlow", height = 7.2, levels = { 1.2, 3.4, 5.6 }, depthPad = 3.0, tilt = 0.6, load = Vector3.new(2.4, 1.4, 3.0) }
function W.CartonFlow(ctx, i: number, j: number)
	shelfRun(ctx, i, j, false, FLOW)
end

-- u 컨베이어: 줄 하나를 머리 칸에서 — 옆판 두 줄 + 벨트 판 + 두 칸마다 다리 + 상자 몇 개. 방향은 이웃 u 로 정한다
function W.ConveyorRun(ctx, i: number, j: number)
	local alongX = ctx.at(i + 1, j) == "u" or ctx.at(i - 1, j) == "u"
	local di, dj = if alongX then 1 else 0, if alongX then 0 else 1
	if ctx.at(i - di, j - dj) == "u" then
		return
	end
	local n = 1
	while n < 40 and ctx.at(i + di * n, j + dj * n) == "u" do
		n += 1
	end
	local T = ctx.T
	local axis = Vector3.new(di, 0, dj)
	local across = Vector3.new(dj, 0, di)
	local c = base(ctx, i, j) + axis * ((n - 1) * T / 2)
	local len = n * T - 0.4
	local m = model(ctx, "Conveyor")
	for _, s in { -1, 1 } do
		local rail = c + across * (s * 1.7) + Vector3.new(0, 3.0, 0)
		Kit.box(m, CFrame.lookAt(rail, rail + axis), Vector3.new(0.2, 0.6, len), { blocks = false, axis = "Z" })
	end
	local belt = c + Vector3.new(0, 3.05, 0)
	Kit.box(m, CFrame.lookAt(belt, belt + axis), Vector3.new(3.2, 0.15, len), { blocks = false, shape = "None" })
	local legs = math.max(1, math.floor(n / 2 + 0.5))
	for k = 0, legs do
		local t = -len / 2 + 0.4 + (len - 0.8) * (k / legs)
		for _, s in { -1, 1 } do
			local lp = c + axis * t + across * (s * 1.5) + Vector3.new(0, 1.4, 0)
			Kit.box(m, CFrame.new(lp), Vector3.new(0.25, 2.8, 0.25), { blocks = false })
		end
	end
	for k = 0, n - 1, 3 do
		local h = ctx.hash(i + k * di, j + k * dj, 33)
		local bp = c + axis * (-len / 2 + (k + 0.3 + h * 0.4) * T) + Vector3.new(0, 3.9, 0)
		Kit.box(m, CFrame.lookAt(bp, bp + axis) * CFrame.Angles(0, (h - 0.5) * 0.5, 0), Vector3.new(2.0, 1.5, 2.2), { blocks = false })
	end
	local cc = c + Vector3.new(0, 1.7, 0)
	Kit.box(m, CFrame.lookAt(cc, cc + axis), Vector3.new(3.6, 3.4, len), { invisible = true, tag = false })
end

-- ── 벽 틈 설비(문 칸처럼 양옆이 벽인 칸) ──
-- 틈이 지나가는 방향(통로 축). 양옆(통로 축과 직각) 중 벽이 있는 쪽을 본다
local function gapAxis(ctx, i: number, j: number): Vector3
	if ctx.isWall(i - 1, j) or ctx.isWall(i + 1, j) then
		if not ctx.isWall(i, j - 1) and not ctx.isWall(i, j + 1) then
			return Vector3.new(0, 0, 1)
		end
	end
	return Vector3.new(1, 0, 0)
end

-- d 도크 문: 문 위 벽(문 높이 9 위) + 말아 올린 셔터 통 + 벽 쪽 안내 레일 + 바닥 도크 레벨러 판. 지나갈 수 있다
function W.DockDoor(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local ax = gapAxis(ctx, i, j)
	local across = Vector3.new(ax.Z, 0, ax.X)
	local m = model(ctx, "DockDoor")
	local T, H = ctx.T, ctx.H
	local top = 9.2
	if H - top > 0.2 then
		local hc = p + Vector3.new(0, (top + H) / 2, 0)
		Kit.box(m, CFrame.lookAt(hc, hc + ax), Vector3.new(T, H - top, 1.6), { name = "DoorWall" })
	end
	local drum = p + Vector3.new(0, top - 0.6, 0) + ax * 1.2
	Kit.cylinder(m, drum - across * (T / 2 - 0.2), drum + across * (T / 2 - 0.2), 0.6, { blocks = false, collide = false })
	for _, s in { -1, 1 } do
		if ctx.isWall(i + across.X * s, j + across.Z * s) then
			local gp = p + across * (s * (T / 2 - 0.25)) + Vector3.new(0, top / 2, 0)
			Kit.box(m, CFrame.lookAt(gp, gp + ax), Vector3.new(0.5, top, 0.5), { blocks = false })
		end
	end
	local lev = p + Vector3.new(0, 0.06, 0)
	Kit.box(m, CFrame.lookAt(lev, lev + ax), Vector3.new(T - 1.2, 0.12, T - 1.0), { blocks = false, collide = false })
end

-- x 내려온 화재 셔터: 벽 틈을 바닥까지 막은 철판(막힘) + 가로 줄무늬 + 위쪽 셔터 통 + 양옆 레일
function W.FireShutter(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local ax = gapAxis(ctx, i, j)
	local across = Vector3.new(ax.Z, 0, ax.X)
	local m = model(ctx, "FireShutter")
	local T, H = ctx.T, ctx.H
	local c = p + Vector3.new(0, H / 2, 0)
	Kit.box(m, CFrame.lookAt(c, c + ax), Vector3.new(T, H, 0.6), { blocks = true, name = "Shutter" })
	for _, f in { -1, 1 } do
		for _, y in { 2.5, 5.0, 7.5 } do
			local sp = p + ax * (f * 0.36) + Vector3.new(0, y, 0)
			Kit.box(m, CFrame.lookAt(sp, sp + ax), Vector3.new(T - 0.6, 0.18, 0.12), { blocks = false, collide = false })
		end
		local hp = p + ax * (f * 0.9) + Vector3.new(0, H - 1.0, 0)
		Kit.box(m, CFrame.lookAt(hp, hp + ax), Vector3.new(T, 1.6, 1.0), { blocks = false })
		-- 양옆 레일(벽에 붙은 세로 홈)
		local rp = p + across * (f * (T / 2 - 0.3)) + Vector3.new(0, (H - 1.8) / 2, 0)
		Kit.box(m, CFrame.lookAt(rp, rp + ax), Vector3.new(0.5, H - 1.8, 1.1), { blocks = false, axis = "Y" })
	end
end

-- ── 낱개 장비 ──
-- Y 포장대·검수대: 작업대(판 + 다리 판 둘) + 모니터 + 상자 + 테이프 받침. 벽을 등진다
function W.PackStation(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local along = Vector3.new(side.Z, 0, -side.X)
	local m = model(ctx, "PackStation")
	local c = p + side * 0.8
	local cf = CFrame.lookAt(c, c - side)
	Kit.box(m, cf * CFrame.new(0, 3.2, 0), Vector3.new(6.4, 0.25, 3.2), { blocks = false })
	for _, x in { -2.9, 2.9 } do
		Kit.box(m, cf * CFrame.new(x, 1.55, 0), Vector3.new(0.25, 3.1, 2.8), { blocks = false })
	end
	Kit.box(m, cf * CFrame.new(1.6, 4.6, 1.0), Vector3.new(2.0, 1.4, 0.15), { blocks = false }) -- 모니터
	Kit.box(m, cf * CFrame.new(1.6, 3.7, 1.1), Vector3.new(0.2, 0.9, 0.2), { blocks = false, collide = false })
	Kit.box(m, cf * CFrame.new(-1.4, 4.1, -0.2) * CFrame.Angles(0, 0.2, 0), Vector3.new(2.2, 1.6, 1.8), { blocks = false }) -- 포장 중인 상자
	Kit.cylinder(m, (cf * CFrame.new(0.2, 3.6, -0.6)).Position - along * 0.4, (cf * CFrame.new(0.2, 3.6, -0.6)).Position + along * 0.4, 0.45, { blocks = false, collide = false }) -- 테이프
	Kit.box(m, cf * CFrame.new(0, 1.8, 0), Vector3.new(6.4, 3.6, 3.2), { invisible = true, tag = false })
end

-- W 랩 감는 기계: 둥근 회전판 + 옆 기둥(마스트) + 필름 수레 + 랩이 감긴 팔레트
function W.StretchWrapper(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local m = model(ctx, "StretchWrapper")
	Kit.cylinder(m, p + Vector3.new(0, 0.05, 0), p + Vector3.new(0, 0.6, 0), 3.0, { blocks = false, rings = 1 })
	Kit.box(m, CFrame.new(p + Vector3.new(0, 2.85, 0)), Vector3.new(3.2, 4.4, 3.2), { blocks = false }) -- 감긴 짐
	local mast = p + side * 3.4 + Vector3.new(0, 4.5, 0)
	Kit.box(m, CFrame.lookAt(mast, mast - side), Vector3.new(0.9, 9.0, 0.9), { blocks = false, axis = "Y" })
	Kit.box(m, CFrame.lookAt(mast - side * 0.8 + Vector3.new(0, -0.5, 0), mast - side * 2 + Vector3.new(0, -0.5, 0)), Vector3.new(1.8, 1.4, 1.2), { blocks = false }) -- 필름 수레
	Kit.box(m, CFrame.lookAt(p + side * 3.4 + Vector3.new(0, 0.6, 0), p + Vector3.new(0, 0.6, 0)), Vector3.new(2.4, 1.2, 2.0), { blocks = false }) -- 제어함 받침
	Kit.box(m, CFrame.new(p + Vector3.new(0, 2.5, 0)), Vector3.new(6.4, 5, 6.4), { invisible = true, tag = false })
end

-- B 정비 작업대: 두꺼운 판 + 다리 + 바이스 + 벽 공구판(구멍판)
function W.Workbench(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j)
	local m = model(ctx, "Workbench")
	local c = p + side * 1.6
	local cf = CFrame.lookAt(c, c - side)
	Kit.box(m, cf * CFrame.new(0, 3.1, 0), Vector3.new(6.6, 0.4, 2.8), { blocks = false })
	for _, x in { -3.0, 3.0 } do
		Kit.box(m, cf * CFrame.new(x, 1.45, 0), Vector3.new(0.3, 2.9, 2.4), { blocks = false })
	end
	Kit.box(m, cf * CFrame.new(-2.2, 3.7, -1.0), Vector3.new(1.0, 0.8, 1.2), { blocks = false }) -- 바이스
	Kit.box(m, cf * CFrame.new(0, 6.2, 1.3), Vector3.new(6.0, 3.6, 0.12), { blocks = false, collide = false }) -- 공구판
	Kit.box(m, cf * CFrame.new(1.4, 3.75, 0), Vector3.new(1.6, 0.9, 1.0), { blocks = false }) -- 공구함
	Kit.box(m, cf * CFrame.new(0, 1.7, 0), Vector3.new(6.6, 3.4, 2.8), { invisible = true, tag = false })
end

-- K 탑차: 줄(두 칸) 머리에서 — 짐칸 상자, 운전석, 바퀴 넷, 뒷문 이음선. 짐칸 뒤(문)가 도크 문(d) 쪽을 본다
function W.BoxTruck(ctx, i: number, j: number)
	local alongX = ctx.at(i + 1, j) == "K" or ctx.at(i - 1, j) == "K"
	local di, dj = if alongX then 1 else 0, if alongX then 0 else 1
	if ctx.at(i - di, j - dj) == "K" then
		return
	end
	local n = 1
	while n < 4 and ctx.at(i + di * n, j + dj * n) == "K" do
		n += 1
	end
	local T = ctx.T
	local axis = Vector3.new(di, 0, dj)
	-- 뒤(도크 쪽)가 머리 칸 앞이면 운전석은 줄 끝 쪽
	local fwd = if ctx.at(i - di, j - dj) == "d" or ctx.isWall(i - di, j - dj) then axis else -axis
	local c = base(ctx, i, j) + axis * ((n - 1) * T / 2)
	local len = n * T - 0.8
	local m = model(ctx, "BoxTruck")
	local cargoLen = len - 4.4
	local cargoC = c - fwd * (len / 2 - cargoLen / 2) + Vector3.new(0, 1.8 + 3.6, 0)
	Kit.box(m, CFrame.lookAt(cargoC, cargoC + fwd), Vector3.new(6.4, 7.2, cargoLen), { name = "Cargo" })
	local rear = cargoC - fwd * (cargoLen / 2 + 0.05)
	Kit.box(m, CFrame.lookAt(rear, rear + fwd), Vector3.new(0.12, 6.8, 0.1), { blocks = false, collide = false }) -- 뒷문 이음선
	local cabC = c + fwd * (len / 2 - 2.0) + Vector3.new(0, 3.6, 0)
	Kit.box(m, CFrame.lookAt(cabC, cabC + fwd), Vector3.new(6.2, 4.8, 3.6), { name = "Cab" })
	Kit.box(m, CFrame.lookAt(cabC + fwd * 1.85 + Vector3.new(0, 0.9, 0), cabC + fwd * 3 + Vector3.new(0, 0.9, 0)), Vector3.new(5.2, 1.8, 0.1), { blocks = false, collide = false }) -- 앞유리 테
	local across = Vector3.new(axis.Z, 0, axis.X)
	for _, t in { -len / 2 + 2.2, len / 2 - 2.0 } do
		for _, s in { -1, 1 } do
			local w = c + fwd * t + across * (s * 3.1) + Vector3.new(0, 1.3, 0)
			Kit.cylinder(m, w - across * 0.45, w + across * 0.45, 1.3, { blocks = false, collide = false, rings = 1 })
		end
	end
end

-- G 정문 경비 초소: 네 기둥 + 허리 벽 + 지붕 판 + 창틀
function W.GuardBooth(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = model(ctx, "GuardBooth")
	for _, x in { -2.6, 2.6 } do
		for _, z in { -2.6, 2.6 } do
			Kit.box(m, CFrame.new(p + Vector3.new(x, 3.8, z)), Vector3.new(0.4, 7.6, 0.4), { blocks = false, axis = "Y" })
		end
	end
	Kit.box(m, CFrame.new(p + Vector3.new(0, 1.6, 0)), Vector3.new(5.4, 3.2, 5.4), { name = "BoothWall" })
	Kit.box(m, CFrame.new(p + Vector3.new(0, 7.8, 0)), Vector3.new(6.6, 0.4, 6.6), { blocks = false })
	Kit.box(m, CFrame.new(p + Vector3.new(0, 5.2, 0)), Vector3.new(5.6, 0.15, 5.6), { blocks = false, collide = false }) -- 창 아래 테
end

return W
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="147">
        <Properties>
          <string name="Name">Creatures</string>
        </Properties>
        <Item class="ModuleScript" referent="148">
          <Properties>
            <string name="Name">Baked</string>
            <string name="Source"><![CDATA[--!strict
-- 시안 챕터 괴물(Rig = 4): 몸은 시안 조각을 그대로 옮긴 3D 뼈 메시(Shared/CreatureRigs/<id>.meshId 모델 에셋)를 불러와 루트에 붙이고,
-- 클라이언트(RigAnim)가 디자인 자세 프레임으로 뼈를 움직인다. 서버는 길찾기·충돌용 뿌리(HumanoidRootPart) + Humanoid + 메시.
-- 메시가 아직 업로드되지 않은 괴물은 ready() = false 라 게임에 나오지 않는다(Round 가 예전 괴물로 대신).
-- 루트 가운데는 바닥 위 hip + 1.
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rig = require(script.Parent.Rig)

local Baked = {}

export type Spec = {
	id: string,
	sprite: string?, -- 그림(같은 괴물 여러 마리면 같은 그림, 소리만 다르게). 없으면 id
	hip: number, -- Humanoid HipHeight
	rootSize: Vector3?,
	cfg: { [string]: any },
	voice: string,
	gimmick: string?, -- 서브 괴물 기믹(Creatures/Sub.luau): "scare" / "near" / "freeze" / "blind"
}

function Baked.sprite(id: string): any
	local folder = ReplicatedStorage.Shared:FindFirstChild("CreatureSprites")
	local ms = folder and folder:FindFirstChild(id)
	return if ms and ms:IsA("ModuleScript") then require(ms) :: any else nil
end

-- 3D 메시(Shared/CreatureRigs/<id>.meshId 의 모델 에셋: 시안 조각 몸 + 뼈 B1..Bn). 한 번 불러와 복제해 쓴다
local meshCache: { [string]: Instance | false } = {}
function Baked.rig(id: string): any
	local folder = ReplicatedStorage.Shared:FindFirstChild("CreatureRigs")
	local ms = folder and folder:FindFirstChild(id)
	return if ms and ms:IsA("ModuleScript") then require(ms) :: any else nil
end
local function meshTemplate(id: string): Instance?
	if meshCache[id] == nil then
		meshCache[id] = false
		local R = Baked.rig(id)
		if R and R.meshId and R.meshId ~= 0 then
			local ok, asset = pcall(function()
				return InsertService:LoadAsset(R.meshId)
			end)
			if ok and asset then
				meshCache[id] = asset
			else
				warn("[Baked] mesh load failed " .. id .. " " .. tostring(asset))
			end
		 end
	end
	return meshCache[id] or nil
end

function Baked.build(spec: Spec, cf: CFrame): Model
	local sid = spec.sprite or spec.id
	local S = Baked.rig(sid) or Baked.sprite(sid)
	local model, _root = Rig.shell(if S then S.name else spec.id, cf, spec.rootSize or Vector3.new(2, 2, 2))
	model:SetAttribute("Rig", 4)
	model:SetAttribute("Creature", sid)
	model:SetAttribute("CreatureId", spec.id)
	model:SetAttribute("Hip", spec.hip)
	if spec.gimmick then
		model:SetAttribute("Gimmick", spec.gimmick)
	end
	-- 3D 몸: 메시 바닥 가운데를 루트 아래 바닥(hip + 1)에 맞춰 붙인다. 음파에 드러날 때만 보인다(클라이언트 Reveal)
	local tpl = meshTemplate(sid)
	local R = Baked.rig(sid)
	if tpl and R then
		local holder = Instance.new("Folder")
		holder.Name = "Mesh"
		local bb = R.bounds
		local center = Vector3.new((bb[1] + bb[4]) / 2, (bb[2] + bb[5]) / 2 - (spec.hip + 1), (bb[3] + bb[6]) / 2)
		for _, d in tpl:Clone():GetDescendants() do
			if d:IsA("MeshPart") then
				d.Parent = holder
				d.Anchored = false
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.Massless = true
				d.CastShadow = false
				d.Transparency = 1
				d.CFrame = _root.CFrame * CFrame.new(center)
				local w = Instance.new("WeldConstraint")
				w.Part0 = _root
				w.Part1 = d
				w.Parent = d
			end
		end
		holder.Parent = model
	end
	Rig.humanoid(model, spec.hip, spec.cfg.WanderSpeed or 6)
	return model
end

-- 괴물 모듈(Creatures/<id>.luau)을 만드는 도우미
function Baked.creature(spec: Spec): any
	local M: any = {}
	M.cfg = spec.cfg
	M.voice = spec.voice
	M.spawnLift = spec.hip + 1
	M.gimmick = spec.gimmick
	-- 게임에 내보내도 되는가: 3D 뼈 메시가 계정에 올라가 있어야 한다(meshId). 없으면 Round 가 예전 괴물을 대신 띄운다(보이지 않는 괴물 금지)
	function M.ready(): boolean
		local R = Baked.rig(spec.sprite or spec.id)
		-- 메시 에셋을 실제로 불러올 수 있어야 한다(못 불러오면 Round 가 예전 괴물로 대신: 보이지 않는 괴물 금지)
		return R ~= nil and type(R.meshId) == "number" and R.meshId ~= 0 and meshTemplate(spec.sprite or spec.id) ~= nil
	end
	function M.build(cf: CFrame): Model
		return Baked.build(spec, cf)
	end
	if spec.gimmick then
		local Sub = require(script.Parent.Sub) :: any
		Sub.attach(M, spec.gimmick)
	end
	return M
end

return Baked
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="149">
          <Properties>
            <string name="Name">Rig</string>
            <string name="Source"><![CDATA[--!strict
-- 챕터 괴물 전용 뼈대(괴물마다 다른 뼈 구조). 공용 두 팔·두 다리 skeleton() 을 쓰지 않는다.
-- 정의(def)는 괴물 모듈(Creatures/C*.luau)이 만든다:
--   bones = { { name, parent?, joint: Vector3, tip: Vector3 } ... }   (루트 기준 좌표, 부모가 앞에 와야 함)
--   lines = { { bone, a: Vector3, b: Vector3, r: number, red: boolean?, disc: boolean? } ... }  선(음파에 보이는 모서리)
--   balls = { { bone, c: Vector3, r: number } ... }
-- 각 선은 지정한 뼈에 정확히 붙는다(가까운 뼈 찾기 없음). 뼈는 Motor6D "B_<name>", 클라이언트가 Transform 으로 움직인다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Kit = require(script.Parent.Parent.MapKit)
local Faces = require(ReplicatedStorage.Shared.MonsterFaces)
local Config = require(ReplicatedStorage.Shared.Config)
local CollectionService = game:GetService("CollectionService")

local Rig = {}

export type Bone = { name: string, parent: string?, joint: Vector3, tip: Vector3 }
export type Line = { bone: string, a: Vector3, b: Vector3, r: number, red: boolean?, disc: boolean? }
export type Ball = { bone: string, c: Vector3, r: number, red: boolean? }
export type Def = {
	id: string,
	bones: { Bone },
	lines: { Line },
	balls: { Ball }?,
	floorY: number, -- 루트 가운데 기준 바닥 높이
	mass: number?,
}

local function setup(p: BasePart)
	p.Transparency = 1
	p.CastShadow = false
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
end

function Rig.build(model: Model, root: BasePart, cf: CFrame, def: Def): { [string]: BasePart }
	local holder = Instance.new("Folder")
	holder.Name = "Body"
	holder.Parent = model
	local parts: { [string]: BasePart } = {}
	local joints: { [string]: Vector3 } = {}
	for _, b in def.bones do
		local pv = Instance.new("Part")
		pv.Name = "Bone_" .. b.name
		pv.Size = Vector3.new(0.2, 0.2, 0.2)
		setup(pv)
		pv:SetAttribute("SonarShape", "None")
		pv:SetAttribute("Tip", b.tip - b.joint)
		pv.CFrame = cf * CFrame.new(b.joint)
		pv.Parent = holder
		local parentPart: BasePart = if b.parent then parts[b.parent] else root
		assert(parentPart, "bone parent must come first: " .. b.name)
		local m = Instance.new("Motor6D")
		m.Name = "B_" .. b.name
		m.Part0 = parentPart
		m.Part1 = pv
		m.C0 = CFrame.new(b.joint - (if b.parent then joints[b.parent] else Vector3.zero))
		m.C1 = CFrame.identity
		m.Parent = pv
		parts[b.name] = pv
		joints[b.name] = b.joint
	end
	local function attach(p: BasePart, bone: string, red: boolean?)
		setup(p)
		if red then
			p:SetAttribute("SonarColor", Faces.TEETH)
		end
		local bp = parts[bone]
		assert(bp, "unknown bone " .. bone)
		local w = Instance.new("WeldConstraint")
		w.Part0 = bp
		w.Part1 = p
		w.Parent = p
	end
	for _, l in def.lines do
		local shape = if l.disc then "Disc" elseif (l.b - l.a).Magnitude > l.r * 4 then "Line" else "Disc"
		local p = Kit.cylinder(holder, cf:PointToWorldSpace(l.a), cf:PointToWorldSpace(l.b), l.r, { shape = shape })
		p.Name = "Line"
		attach(p, l.bone, l.red)
	end
	for _, b in def.balls or {} do
		local p = Kit.ball(holder, cf:PointToWorldSpace(b.c), b.r)
		p.Name = "Ball"
		attach(p, b.bone, b.red)
	end
	model:SetAttribute("Rig", 3)
	model:SetAttribute("Creature", def.id)
	model:SetAttribute("FloorY", def.floorY)
	model:SetAttribute("Mass", def.mass or 1)
	return parts
end

-- 괴물 모델의 기본 틀: 루트 파트 + Humanoid(점프·기어오르기 끔). build() 에서 Rig.build 전에 부른다
function Rig.shell(name: string, cf: CFrame, rootSize: Vector3?): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute(Config.Tags.Dynamic, true)
	model:SetAttribute("State", "Wander")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = rootSize or Vector3.new(2, 2, 1.2)
	root.Transparency = 1
	root.CanCollide = true
	root.CanTouch = false
	root.CFrame = cf
	root.Parent = model
	model.PrimaryPart = root
	return model, root
end
function Rig.humanoid(model: Model, hip: number, speed: number): Humanoid
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = hip
	hum.WalkSpeed = speed
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	hum.AutoJumpEnabled = false
	hum.UseJumpPower = true
	hum.JumpPower = 0
	hum.Parent = model
	for _, st in { Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.Dead } do
		hum:SetStateEnabled(st, false)
	end
	CollectionService:AddTag(model, Config.Tags.Monster)
	return hum
end

-- 2D 시안 좌표(px)를 3D 로: 정면 그림(x 가운데 cx, 바닥 y fy, px 당 스터드 k), z 는 직접
function Rig.fromSheet(cx: number, fy: number, k: number, floorY: number): (number, number, number) -> Vector3
	return function(x: number, y: number, z: number): Vector3
		return Vector3.new((x - cx) * k, floorY + (fy - y) * k, z)
	end
end

return Rig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="150">
          <Properties>
            <string name="Name">Sub</string>
            <string name="Source"><![CDATA[--!strict
-- 서브 괴물: 역할에 맞는 자기 자리(영역)에 있다가, 그 영역 안에서 음파·플레이어 소리·사람을 알아채면 쫓는다.
-- 쫓는 동안은 영역 밖까지 따라가고, 놓치면 수색한 뒤 자기 영역으로 돌아간다. 거기에 괴물마다 기믹 하나(Config.Creatures.Gimmicks 수치):
--  scare  : 잡혀도 죽지 않는다 — 점프스케어만 뜨고 괴물은 어둠 속으로 사라졌다가 자기 영역 다른 곳에 나타난다
--  near   : 영역 안에서도 가까이(Near) 다가온 소리·사람만 알아챈다(잡히면 목숨 하나)
--  freeze : 음파를 맞으면 그 자리에 굳었다가(Freeze 초) 풀리면 음파 쏜 곳으로 온다(잡히면 목숨 하나)
--  blind  : 앞을 못 본다. 뛰는 발소리·착지 소리만 듣고 쫓는다. 걷거나 웅크리면 지나칠 수 있다(잡히면 목숨 하나)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local SoundBus = require(script.Parent.Parent.SoundBus)

local Sub = {}
local G = (Config.Creatures :: any).Gimmicks

local function roundEvent(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	return remotes and remotes:FindFirstChild("RoundEvent") :: RemoteEvent?
end

-- 괴물을 자기 구역의 먼 곳으로 옮긴다(플레이어들에게서 떨어진 곳)
local function vanish(self: any)
	local far, best = nil, -1
	for _ = 1, 24 do
		local n = self:randomNode()
		local dmin = math.huge
		for _, p in game:GetService("Players"):GetPlayers() do
			local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then
				dmin = math.min(dmin, (r.Position - n).Magnitude)
			end
		end
		if dmin > best then
			far, best = n, dmin
		end
	end
	if far then
		self.model:PivotTo(CFrame.new(far + Vector3.new(0, (self.cmod.spawnLift or 2), 0)))
	end
	self.target = nil
	self.goal = nil
	self.waypoints = {}
	self:setState("Wander")
end

function Sub.attach(M: any, kind: string)
	if kind == "scare" then
		-- 잡히면 점프스케어만
		M.catch = function(self: any, p: Player): boolean
			local until_ = (self.cdata.scared or {})[p] or 0
			if os.clock() < until_ then
				return true
			end
			self.cdata.scared = self.cdata.scared or {}
			self.cdata.scared[p] = os.clock() + G.ScareCooldown
			self:note("scared " .. p.Name)
			local ev = roundEvent()
			if ev then
				ev:FireClient(p, "Scare", { creature = self.creature, voice = self.model:GetAttribute("Voice") })
			end
			task.delay(0.3, function()
				if self.alive then
					vanish(self)
				end
			end)
			return true
		end
	elseif kind == "near" then
		-- 자기 영역 안에서도 가까운(Near) 소리·사람만
		M.hear = function(self: any, pos: Vector3, _radius: number, _source: Player?, _kind: string): boolean
			return (pos - self.root.Position).Magnitude > G.Near
		end
		M.cfg.SightLimit = G.Near
	elseif kind == "freeze" then
		-- 음파를 맞으면 그 자리에 굳었다가(Freeze 초), 풀리면 음파 쏜 곳으로
		M.hear = function(self: any, pos: Vector3, radius: number, _source: Player?, k: string): boolean
			if k == "Sonar" and SoundBus.canHear(pos, self.root.Position, radius) then
				self.cdata.frozenUntil = os.clock() + G.Freeze
				self.cdata.frozenAt = pos
				self.model:SetAttribute("Frozen", true)
				self.hum:MoveTo(self.root.Position)
				self.waypoints = {}
				self:note("frozen")
				return true
			end
			return false -- (다른 소리는 기본 반응)
		end
		M.tick = function(self: any, now: number): boolean
			local fu = self.cdata.frozenUntil
			if fu and now < fu then
				self.hum.WalkSpeed = 0
				self.hum:MoveTo(self.root.Position)
				return true
			elseif fu then
				self.cdata.frozenUntil = nil
				self.model:SetAttribute("Frozen", false)
				self:setState(self.state) -- (걸음 속도 되돌리기)
				local at = self.cdata.frozenAt
				self.cdata.frozenAt = nil
				if at and self.state ~= "Chase" then
					self:investigate(at)
				end
			end
			return false
		end
		M.cfg.SightLimit = G.FreezeSight
	elseif kind == "blind" then
		-- 앞을 못 본다: 뛰는 발소리·착지 소리만 듣고 쫓는다
		M.hear = function(self: any, pos: Vector3, radius: number, source: Player?, k: string): boolean
			if (k == "StepRun" or k == "StepLand") and SoundBus.canHear(pos, self.root.Position, radius) then
				if self.state == "Chase" then
					if source and source == self.target then
						self.lastKnown = pos
						self.lastSeen = os.clock()
					end
				elseif source then
					self:note("felt " .. k)
					self:startChase(source, pos)
				end
			end
			return true
		end
		M.cfg.SightLimit = G.BlindTouch
	end
	-- 모든 서브 괴물: 자기 영역(방 + 둘레) 안에서 난 소리·영역 안에 들어온 사람만 알아챈다. 쫓는 중에는 영역 밖까지 따라가고,
	-- 놓치면 수색 뒤 자기 영역으로 돌아간다(배회 지점을 영역 안에서만 고른다)
	local own = M.hear
	M.hear = function(self: any, pos: Vector3, radius: number, source: Player?, k: string): boolean
		if self.state ~= "Chase" and not self:inTerritory(pos) then
			return true
		end
		return if own then own(self, pos, radius, source, k) else false
	end
	M.cfg.SenseInTerritory = true
	-- (근처 감지는 기본 sense 가 cfg.SightLimit 로 줄인 거리 안에서만 한다)
end

return Sub
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="151">
          <Properties>
            <string name="Name">c10h</string>
            <string name="Source"><![CDATA[--!strict
-- c10h 안내원 (10장 폐영화관 · 사람형) — 사양서: roster/v5/ch10/c10h_spec.md (+ QA1 수정 지시 반영)
-- 허리를 90° 숙인 인사 자세로 굳은 극장 안내원. 등은 탁자처럼 수평(높이 약 5.6), 높은 깃에서 가는 목이 아래로 늘어져
-- 얼굴 없는 길쭉한 머리가 가슴 밑에 매달린다. 왼손은 예절대로 등 위에 얹고, 오른손은 손가락이 붙은 '손전등 손'.
-- 눈 대신 손전등 끝에서 곧게 뻗은 붉은 선 한 줄이 시선이다(등받이 꼭대기 높이 ~3.4).
-- 뼈(이름 = 사양서처럼 끝 관절): pelvis → spine1 → spine2 → neck → head → headTip,  spine2 → shoulderR → elbowR → wristR → lensR,
--      spine2 → shoulderL → elbowL → wristL → handL,  pelvis → hipR/L → kneeR/L → ankleR/L → toeR/L,  pelvis → tailR/L
-- 공포 장치 「시선 선」: 서버가 손전등 위치에서 시선 방향으로 레이캐스트(30). 처음 맞는 것이 서 있는 플레이어면 들킴 →
--   일어서기(Rise, 0.4초) 후 추격. 등받이(3.4) 뒤에 웅크리면 레이가 등받이에 막혀 안전.
--   멈춰 있을 땐 상체를 ±40° 돌려 훑고(Aim 속성, 클라이언트가 같은 각도로 돌림), 소리가 나면 2초 동안 그쪽으로 빔을 돌린다.
--   배회 땐 1.4초 걷고 0.6초 멈추는 박자. (빔 길이를 맞은 곳까지 늘이는 것은 빠짐 — 보이는 붉은 선은 7 고정)
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 3.5,
	InvestigateSpeed = 6,
	ChaseSpeed = 9,
	AgentRadius = 1.4,
	AgentHeight = 7,
	CatchDistance = 3,
}
M.spawnLift = 3.2
M.voice = "1" -- (소리: 전용 소리 전까지 — 발 끌기 계열)

local HIP = 2
local FLOOR = -(HIP + 1)
local BEAM_RANGE = 30
local SWEEP = math.rad(40)
local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end
local LENS = P(0.55, 3.47, -5.5)

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Usher", cf, Vector3.new(1.4, 2, 1.4))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 })
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1])
		end
	end
	local function limb(bone: string, a: Vector3, b: Vector3, wa: number, wm: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		local m = a:Lerp(b, 0.45)
		for _, k in { -1, 1 } do
			chain(bone, { a + off * (wa * k), m + off * (wm * k), b + off * (wb * k) })
		end
	end
	-- 다리: 몸통보다 확실히 가는 다리 + 바짓단 주름 + 구두
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local hip, knee, ankle = P(0.42 * s, 5.05, 0), P(0.43 * s, 2.6, -0.35), P(0.42 * s, 0.32, 0.05)
		limb("knee" .. n, hip, knee, 0.2, 0.18, 0.11, Vector3.new(0.7 * s, 0, 0.7))
		limb("ankle" .. n, knee, ankle, 0.11, 0.13, 0.09, Vector3.new(0.7 * s, 0, 0.7))
		chain("toe" .. n, { ankle + Vector3.new(0, -0.3, 0.22), ankle + Vector3.new(0, -0.3, -0.85), ankle + Vector3.new(0, -0.12, -0.95) })
		S("toe" .. n, ankle + Vector3.new(0, 0.02, -0.1), ankle + Vector3.new(0, -0.14, -0.9))
		S("ankle" .. n, ankle + Vector3.new(-0.12 * s, 0.35, -0.08), ankle + Vector3.new(0.1 * s, 0.25, -0.12)) -- 바짓단 주름
	end
	S("pelvis", P(-0.55, 5.0, 0.15), P(0.55, 5.0, 0.15))
	-- 연미복 꼬리 2장(판: 두 줄씩)
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		S("tail" .. n, P(0.12 * s, 5.0, 0.35), P(0.2 * s, 3.55, 0.62))
		S("tail" .. n, P(0.42 * s, 5.0, 0.3), P(0.36 * s, 3.65, 0.58))
	end
	-- 수평 등(탁자): 등선 · 배선 · 옆선, 각진 어깨선 · 견장, 높은 깃(고리)
	chain("spine1", { P(0, 5.62, 0.25), P(0, 5.75, -1.1) })
	chain("spine2", { P(0, 5.75, -1.1), P(0, 5.72, -2.95) })
	chain("spine1", { P(0, 4.7, -0.15), P(0, 4.85, -1.2) })
	chain("spine2", { P(0, 4.85, -1.2), P(0, 5.0, -2.75) })
	for _, s in { -1, 1 } do
		chain("spine2", { P(0.62 * s, 5.25, -0.1), P(0.66 * s, 5.35, -1.6), P(0.84 * s, 5.5, -2.85) })
		S("spine2", P(0.84 * s, 5.58, -2.85), P(0.5 * s, 5.62, -3.25)) -- 각진 어깨 → 깃
		S("shoulder" .. (if s < 0 then "L" else "R"), P(0.62 * s, 5.68, -2.65), P(1.0 * s, 5.6, -2.95)) -- 견장
	end
	table.insert(lines, { bone = "spine2", a = P(0, 5.35, -3.12), b = P(0, 5.35, -3.17), r = 0.36, disc = true }) -- 높은 깃
	-- 매달린 가는 목 + 얼굴 없는 길쭉한 머리
	S("neck", P(-0.1, 5.25, -3.2), P(-0.07, 4.62, -3.32))
	S("neck", P(0.1, 5.25, -3.22), P(0.08, 4.62, -3.34))
	local hc = P(0, 3.95, -3.42)
	local sideH = { { 0.7, 0.1 }, { 0.5, -0.24 }, { -0.1, -0.3 }, { -0.68, -0.16 }, { -0.62, 0.2 }, { 0.1, 0.28 } }
	for i = 1, #sideH do
		local a, c = sideH[i], sideH[i % #sideH + 1]
		S("head", hc + Vector3.new(0, a[1], a[2]), hc + Vector3.new(0, c[1], c[2]))
	end
	local frontH = { { 0.7, -0.18 }, { 0.2, -0.3 }, { -0.66, -0.18 }, { -0.62, 0.18 }, { 0.2, 0.3 } }
	for i = 1, #frontH do
		local a, c = frontH[i], frontH[i % #frontH + 1]
		S("headTip", hc + Vector3.new(a[2], a[1], -0.05), hc + Vector3.new(c[2], c[1], -0.05))
	end
	-- 오른팔: 손전등 손(손가락이 붙어 대롱이 됨) + 끝 테 + 붉은 시선 선(손전등 끝에서 앞으로만)
	limb("elbowR", P(0.78, 5.48, -2.94), P(1.38, 4.62, -4.07), 0.13, 0.14, 0.09, Vector3.new(0.6, 0.8, 0))
	limb("wristR", P(1.38, 4.62, -4.07), P(0.55, 3.56, -4.6), 0.09, 0.1, 0.07, Vector3.new(0, 0.6, 0.8))
	S("lensR", P(0.47, 3.6, -4.6), P(0.47, 3.53, -5.45))
	S("lensR", P(0.63, 3.5, -4.6), P(0.63, 3.43, -5.45))
	table.insert(lines, { bone = "lensR", a = P(0.55, 3.47, -5.45), b = P(0.55, 3.47, -5.5), r = 0.13, disc = true })
	S("lensR", LENS, LENS + Vector3.new(0, -0.05, -7), true)
	-- 왼팔: 등 위에 얹은 손(손바닥이 등에 닿음)
	limb("elbowL", P(-0.78, 5.48, -2.94), P(-1.34, 6.2, -1.72), 0.13, 0.14, 0.09, Vector3.new(0, 0.8, 0.6))
	limb("wristL", P(-1.34, 6.2, -1.72), P(-0.15, 5.83, -1.02), 0.09, 0.1, 0.07, Vector3.new(0, 1, 0))
	chain("handL", { P(-0.15, 5.83, -1.12), P(0.45, 5.8, -0.88) })
	chain("handL", { P(-0.12, 5.82, -0.88), P(0.42, 5.8, -0.66) })
	S("handL", P(0.42, 5.8, -0.66), P(0.45, 5.8, -0.88))
	local bones: { Rig.Bone } = {
		{ name = "pelvis", joint = P(0, 5.05, 0), tip = P(0, 5.21, -1.05) },
		{ name = "spine1", parent = "pelvis", joint = P(0, 5.15, 0), tip = P(0, 5.21, -1.05) },
		{ name = "spine2", parent = "spine1", joint = P(0, 5.21, -1.05), tip = P(0, 5.41, -2.34) },
		{ name = "neck", parent = "spine2", joint = P(0, 5.35, -3.15), tip = P(0, 4.62, -3.33) },
		{ name = "head", parent = "neck", joint = P(0, 4.62, -3.33), tip = P(0, 3.3, -3.5) },
		{ name = "headTip", parent = "head", joint = P(0, 3.95, -3.42), tip = P(0, 3.25, -3.5) },
		{ name = "shoulderR", parent = "spine2", joint = P(0.2, 5.45, -2.8), tip = P(0.78, 5.48, -2.94) },
		{ name = "elbowR", parent = "shoulderR", joint = P(0.78, 5.48, -2.94), tip = P(1.38, 4.62, -4.07) },
		{ name = "wristR", parent = "elbowR", joint = P(1.38, 4.62, -4.07), tip = P(0.55, 3.56, -4.6) },
		{ name = "lensR", parent = "wristR", joint = P(0.55, 3.56, -4.6), tip = P(0.55, 3.47, -5.45) },
		{ name = "shoulderL", parent = "spine2", joint = P(-0.2, 5.45, -2.8), tip = P(-0.78, 5.48, -2.94) },
		{ name = "elbowL", parent = "shoulderL", joint = P(-0.78, 5.48, -2.94), tip = P(-1.34, 6.2, -1.72) },
		{ name = "wristL", parent = "elbowL", joint = P(-1.34, 6.2, -1.72), tip = P(-0.15, 5.83, -1.02) },
		{ name = "handL", parent = "wristL", joint = P(-0.15, 5.83, -1.02), tip = P(0.4, 5.82, -0.77) },
		{ name = "tailR", parent = "pelvis", joint = P(0.28, 5.0, 0.32), tip = P(0.28, 3.65, 0.6) },
		{ name = "tailL", parent = "pelvis", joint = P(-0.28, 5.0, 0.32), tip = P(-0.28, 3.65, 0.6) },
	}
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		table.insert(bones, { name = "hip" .. n, parent = "pelvis", joint = P(0, 5.05, 0), tip = P(0.42 * s, 5.05, 0) })
		table.insert(bones, { name = "knee" .. n, parent = "hip" .. n, joint = P(0.42 * s, 5.05, 0), tip = P(0.43 * s, 2.6, -0.35) })
		table.insert(bones, { name = "ankle" .. n, parent = "knee" .. n, joint = P(0.43 * s, 2.6, -0.35), tip = P(0.42 * s, 0.32, 0.05) })
		table.insert(bones, { name = "toe" .. n, parent = "ankle" .. n, joint = P(0.42 * s, 0.32, 0.05), tip = P(0.42 * s, 0.02, -0.95) })
	end
	Rig.build(model, root, cf, {
		id = "c10h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.9,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

function M.init(self: any)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { self.model }
	self.cdata.beamParams = rp
	self.cdata.aim = 0
	self.model:SetAttribute("Aim", 0)
end

local function playerOf(inst: Instance): Player?
	local m = inst:FindFirstAncestorOfClass("Model")
	while m do
		local p = Players:GetPlayerFromCharacter(m)
		if p then
			return p
		end
		m = m:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	-- 일어서기(들킴) 0.4초 → 추격
	if d.riseUntil then
		if now < d.riseUntil then
			self.hum:MoveTo(self.root.Position)
			return true
		end
		local p: Player?, at: Vector3? = d.riseWho, d.riseAt
		d.riseUntil, d.riseWho, d.riseAt = nil, nil, nil
		if p and at and p.Parent and p:GetAttribute("Status") == "Alive" then
			self:startChase(p, at)
		else
			self:setState(self.state)
		end
		return false
	end
	local st = self.state
	-- 배회 박자: 1.4초 걷기 + 0.6초 멈춤(그동안 훑기). 평균 = WanderSpeed
	local still = false
	if st == "Wander" then
		local cyc = now % 2
		still = cyc >= 1.4
		self.hum.WalkSpeed = if still then 0 else M.cfg.WanderSpeed * 2 / 1.4
	end
	-- 빔 방향(상체 yaw): 소리 쪽 > 멈춰 훑기 > 정면
	local aim = 0
	if d.hearUntil and now < d.hearUntil and d.hearYaw then
		aim = d.hearYaw
	elseif st ~= "Chase" then
		local v = self.root.AssemblyLinearVelocity
		if still or Vector3.new(v.X, 0, v.Z).Magnitude < 1 then
			aim = SWEEP * math.sin(now * math.pi / 2) -- 4초에 한 번 왕복(한쪽 2초)
		end
	end
	d.aim = d.aim + (aim - d.aim) * 0.5
	local deg = math.floor(math.deg(d.aim) / 2 + 0.5) * 2
	if self.model:GetAttribute("Aim") ~= deg then
		self.model:SetAttribute("Aim", deg)
	end
	if st == "Chase" then
		return false
	end
	-- 시선 선: 손전등 끝에서 레이캐스트, 처음 맞은 것이 플레이어면 들킴
	local turn = self.root.CFrame * CFrame.Angles(0, math.rad(deg), 0)
	local from = turn:PointToWorldSpace(LENS)
	local dir = turn:VectorToWorldSpace(Vector3.new(0, -0.05 / 7, -1)).Unit
	local hit = workspace:Raycast(from, dir * BEAM_RANGE, d.beamParams)
	if hit then
		local p = playerOf(hit.Instance)
		if p and p:GetAttribute("Status") == "Alive" and not p:GetAttribute("Hidden") then
			d.riseUntil = now + 0.4
			d.riseWho = p
			d.riseAt = hit.Position
			self.model:SetAttribute("Rise", now)
			self.hum:MoveTo(self.root.Position)
			return true
		end
	end
	return false
end

-- 소리가 나면 2초 동안 상체와 빔을 그쪽으로(±70°까지). 기본 반응(조사)은 그대로
function M.hear(self: any, pos: Vector3, radius: number, _source: Player?, kind: string): boolean
	if kind == "Door" then
		return false
	end
	local my = self.root.Position
	if (pos - my).Magnitude > radius then
		return false
	end
	local v = self.root.CFrame:VectorToObjectSpace(pos - my)
	local d = self.cdata
	d.hearYaw = math.clamp(math.atan2(-v.X, -v.Z), -math.rad(70), math.rad(70))
	d.hearUntil = os.clock() + 2
	return false
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="152">
          <Properties>
            <string name="Name">c10n</string>
            <string name="Source"><![CDATA[--!strict
-- c10n 앞줄 손님 (10장 폐영화관 · 비인간형) — 사양서: roster/v5/ch10/c10n_spec.md (+ QA2 수정 지시 반영)
-- 뒤에서 보면 평범한 앞줄 관객 — 1초 뒤 어긋남: 목이 2스터드나 늘어나 작고 길쭉한 머리가 너무 높이 떠 있고, 귀는 뒤통수 쪽,
-- 등에는 좌석 등받이 같은 세로 누빔 솔기. 두 다리는 무릎 90° 의자 꼴로 한 덩어리로 용접돼 걷지 못한다.
-- 몸은 +Z(화면 쪽)를 보고 만들었고 루트의 앞(-Z, 진행 방향)은 늘 등 — 플레이어는 뒷모습만 본다.
-- QA2: 허리에 손(마름모 팔) 금지 → 대기 땐 어깨가 앞으로 말린 채 손목이 무릎 사이로 처짐 · 어깨는 몸에 붙은 둥근 어깨 →
--      위팔로 이어지는 외곽 · 머리는 볼링 핀이 아니라 턱선 각·가마·뒤로 붙은 귀가 있는 사람 뒤통수 · 넘기는 앉은 L 자
--      덩어리째 등받이 축으로 통째 회전(몸을 눕히지 않음) · 팔은 가늘어지는 원뿔 마디.
-- 뼈: Mass(등받이 꼭대기 = 넘기 축) → Lower(엉덩이·무릎·발목·발끝 용접 덩어리), Mass → Spine1 → Spine2 → NeckBase → NeckTop → Head,
--      NeckBase → ShoulderL/R → UpperArmL/R → ForearmL/R
-- 붉은 선: 목덜미 가로 솔기(머리 바로 밑, 뒤에서만 보임).
-- 공포 장치 「한 줄 더」: 누가 음파를 쏘면 쏜 사람 쪽으로 정확히 한 줄(3.2) 넘어온다(잡기 0.3 → 넘기 0.4 → 앉기 0.2, Vault 속성).
--   음파 없이 20초가 지나면 가장 가까운 플레이어 쪽으로 스스로 한 줄. 평지에선 팔로 끌어 2/초(기본 AI).
--   (좌석 줄 맞춤·접힌 좌석 흔적은 빠짐 — 맵 소품을 건드려야 함. 덮치기는 기본 잡기 거리로)
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 2,
	InvestigateSpeed = 2,
	ChaseSpeed = 3,
	AgentRadius = 1.2,
	AgentHeight = 8.6,
	CatchDistance = 2.6,
}
M.spawnLift = 2.6
M.voice = "4" -- (소리: 전용 소리 전까지 — 쿵 계열을 좌석 '탕' 대신)

local HIP = 1.5
local FLOOR = -(HIP + 1)
local ROW = 3.2
local GRIP, FLIP, LAND = 0.3, 0.4, 0.2

local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("FrontRow", cf, Vector3.new(1.6, 2, 1.6))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 }, red: boolean?)
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1], red)
		end
	end
	local function cone(bone: string, a: Vector3, b: Vector3, wa: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		for _, k in { -1, 1 } do
			S(bone, a + off * (wa * k), b + off * (wb * k))
		end
	end
	-- 하체(용접된 의자 꼴): 허벅지 판 · 정강이 · 발
	for _, s in { -1, 1 } do
		S("Lower", P(0.5 * s, 2.25, -0.25), P(0.5 * s, 2.2, 1.55)) -- 허벅지 윗면
		S("Lower", P(0.48 * s, 1.75, -0.1), P(0.46 * s, 1.75, 1.3)) -- 허벅지 아랫면
		S("Lower", P(0.46 * s, 2.15, 1.6), P(0.42 * s, 0.4, 1.7)) -- 정강이 앞
		S("Lower", P(0.44 * s, 1.7, 1.3), P(0.4 * s, 0.45, 1.4)) -- 종아리
		S("Lower", P(0.42 * s, 0.1, 1.35), P(0.42 * s, 0.08, 2.2)) -- 발
	end
	-- 몸통 3마디: 옆 외곽(좌우) + 등의 세로 누빔 솔기 3줄
	for _, s in { -1, 1 } do
		S("Spine1", P(0.62 * s, 2.3, -0.25), P(0.7 * s, 3.25, -0.35))
		S("Spine2", P(0.7 * s, 3.25, -0.35), P(0.82 * s, 4.5, -0.2))
		chain("NeckBase", { P(0.22 * s, 5.1, 0.0), P(0.8 * s, 5.0, 0.12), P(1.02 * s, 4.75, 0.35) }) -- 앞으로 말린 둥근 어깨
	end
	for _, x in { -0.38, 0.0, 0.38 } do
		S("Spine2", P(x, 2.7, -0.58), P(x * 1.05, 4.55, -0.5))
	end
	S("Spine1", P(-0.6, 2.6, -0.57), P(0.6, 2.6, -0.57)) -- 누빔 가로 솔기
	-- 긴 목 2마디(좌우 윤곽)
	for _, s in { -1, 1 } do
		S("NeckBase", P(0.2 * s, 5.05, 0.0), P(0.16 * s, 6.2, 0.1))
		S("NeckTop", P(0.16 * s, 6.2, 0.1), P(0.15 * s, 7.3, 0.22))
	end
	-- 붉은 목덜미 솔기(뒤쪽)
	chain("NeckTop", { P(-0.2, 7.25, 0.06), P(0, 7.28, 0.02), P(0.2, 7.25, 0.06) }, true)
	-- 머리: 길쭉한 사람 뒤통수 — 옆 외곽(턱선 각) + 가운데 윤곽 + 가마 고리 + 뒤로 붙은 귀
	chain("Head", { P(0, 7.35, 0.08), P(0, 8.15, -0.02), P(0, 8.6, 0.25), P(0, 8.45, 0.7), P(0, 7.65, 0.78), P(0, 7.4, 0.5) })
	for _, s in { -1, 1 } do
		chain("Head", { P(0.3 * s, 7.45, 0.12), P(0.36 * s, 8.15, 0.2), P(0.3 * s, 8.4, 0.5), P(0.26 * s, 7.55, 0.62) })
		table.insert(lines, { bone = "Head", a = P(0.36 * s, 7.85, 0.02), b = P(0.39 * s, 7.85, 0.0), r = 0.14, disc = true }) -- 귀(뒤쪽)
	end
	table.insert(lines, { bone = "Head", a = P(0, 8.5, 0.12), b = P(0, 8.53, 0.1), r = 0.09, disc = true }) -- 가마
	-- 팔: 대기 자세 = 손목이 무릎 사이로 처짐. 손가락 갈고리 2
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local sh, el, wr = P(1.02 * s, 4.75, 0.35), P(1.05 * s, 3.35, 0.8), P(0.35 * s, 2.35, 1.45)
		cone("UpperArm" .. n, sh, el, 0.17, 0.11, Vector3.new(0, 0, 1))
		cone("Forearm" .. n, el, wr, 0.11, 0.07, Vector3.new(0, 1, 0))
		S("Forearm" .. n, wr, wr + Vector3.new(-0.1 * s, -0.35, 0.18))
		S("Forearm" .. n, wr, wr + Vector3.new(0.02 * s, -0.4, 0.05))
	end
	local bones: { Rig.Bone } = {
		{ name = "Mass", joint = P(0, 3.45, -0.62), tip = P(0, 1.95, -0.1) },
		{ name = "Lower", parent = "Mass", joint = P(0, 1.95, -0.1), tip = P(0, 1.95, 1.45) },
		{ name = "Spine1", parent = "Mass", joint = P(0, 2.2, -0.3), tip = P(0, 3.2, -0.32) },
		{ name = "Spine2", parent = "Spine1", joint = P(0, 3.2, -0.32), tip = P(0, 4.45, -0.22) },
		{ name = "NeckBase", parent = "Spine2", joint = P(0, 4.45, -0.22), tip = P(0, 5.2, 0) },
		{ name = "NeckTop", parent = "NeckBase", joint = P(0, 6.2, 0.1), tip = P(0, 7.3, 0.22) },
		{ name = "Head", parent = "NeckTop", joint = P(0, 7.3, 0.22), tip = P(0, 8.45, 0.45) },
	}
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		table.insert(bones, { name = "Shoulder" .. n, parent = "NeckBase", joint = P(0.2 * s, 5.05, 0), tip = P(1.02 * s, 4.75, 0.35) })
		table.insert(bones, { name = "UpperArm" .. n, parent = "Shoulder" .. n, joint = P(1.02 * s, 4.75, 0.35), tip = P(1.05 * s, 3.35, 0.8) })
		table.insert(bones, { name = "Forearm" .. n, parent = "UpperArm" .. n, joint = P(1.05 * s, 3.35, 0.8), tip = P(0.35 * s, 2.35, 1.45) })
	end
	Rig.build(model, root, cf, {
		id = "c10n",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.9,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

local function vault(self: any, toward: Vector3, now: number)
	local my = self.root.Position
	local dir = Vector3.new(toward.X - my.X, 0, toward.Z - my.Z)
	if dir.Magnitude < 0.5 then
		return
	end
	local d = self.cdata
	d.vaultAt = now
	d.vaultTo = my + dir.Unit * math.min(ROW, dir.Magnitude)
	d.lastVault = now
	self.waypoints = {}
	self.root.CFrame = CFrame.lookAt(my, my + dir.Unit) -- 등(루트의 앞)을 쏜 사람 쪽으로
	self.model:SetAttribute("Vault", now)
end

function M.init(self: any)
	self.cdata.lastVault = os.clock()
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if d.vaultAt then
		local t = now - d.vaultAt
		if t < GRIP + FLIP + LAND then
			-- 잡기 동안은 그대로, 넘기·앉기 동안 한 줄 뒤로
			self.hum.WalkSpeed = if t < GRIP then 0 else ROW / (FLIP + LAND)
			self.hum:MoveTo(d.vaultTo)
			return true
		end
		d.vaultAt = nil
		self:setState(self.state) -- 원래 속도로
		return false
	end
	if now - d.lastVault > 20 then
		-- 음파 없이 20초: 가장 가까운 플레이어 쪽으로 스스로 한 줄
		local best: Vector3?, bd = nil, 80
		for _, p in Players:GetPlayers() do
			local char = p.Character
			local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r and p:GetAttribute("Status") == "Alive" then
				local dd = (r.Position - self.root.Position).Magnitude
				if dd < bd then
					best, bd = r.Position, dd
				end
			end
		end
		d.lastVault = now
		if best then
			vault(self, best, now)
			return true
		end
	end
	return false
end

function M.hear(self: any, pos: Vector3, _radius: number, source: Player?, kind: string): boolean
	if kind ~= "Sonar" or source == nil then
		return false
	end
	if (pos - self.root.Position).Magnitude > 90 or self.cdata.vaultAt then
		return true -- (넘는 중이거나 너무 멀면 음파는 무시)
	end
	vault(self, pos, os.clock())
	return true
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="153">
          <Properties>
            <string name="Name">c1h</string>
            <string name="Source"><![CDATA[--!strict
-- c1h 발맞춤 (1장 지하 시설 · 사람형) — 사양서: art/creatures/sheets/ch1/c1h_spec.md (+ QA1 수정 지시 반영)
-- 보행 동기화 실험의 피험체. 스스로 서지 못하는 몸을 외골격이 세운다: 골반 띠 → 등 뒤 세로 레일(척추를 클립으로 걺) →
-- 오른 어깨만 받치는 L 자 버팀대, 왼팔은 끈에 매달려 처짐. 두건 씌운 머리는 쐐기 받침·턱 걸쇠에 핀으로 박혀 천장을 본다.
-- 3차(최신): 공 머리 → 젖혀진 옆얼굴 + 턱 밑, 관절 마커 공·골반 고리 제거, 오른팔은 받침에 묶여 앞으로, 멈추면 무릎 높이로 발을 들고 숙인 채 굳음.
-- QA1: T 자 멍에(십자·허수아비) 대신 비대칭 L 버팀대 · 머리 고리(후광) 대신 쐐기 받침 — 정면에선 얼굴 없는 턱 밑과 목 앞면 ·
--      마커 공은 7개(골반·무릎·발목·손목)만 · 무릎은 캡슐이 아니라 슬개골 쐐기 + 버팀대 경첩 · 선 120 이하.
-- 뼈: HipRing → Pelvis → ThighL/R → ShinL/R → FootL/R,  Pelvis → Lumbar → Thorax → Neck,
--      HipRing → Rail → Yoke(L 버팀대) → UpperArmR → ForearmR → HandR,  Rail → UpperArmL(끈) → ForearmL → HandL,
--      Rail → Clamp(쐐기 받침) → Head,  Rail → Cable1 → Cable2 → Cable3(붉은 동기 케이블)
-- 붉은 선: 등 레일에서 바닥으로 끌리는 동기 케이블 한 줄.
-- 공포 장치 「발맞춤」: 가까운(50) 플레이어가 실제로 움직인 속도만큼만 움직인다(멈추면 같이 멈춤 — 한 발 든 채 굳는 건 클라이언트).
--   달리면 같이 빨라진다(상한 18). 멈춘 뒤 0.6초에 한 걸음 더(클라이언트). 3 안에서 머리 받침째 앞으로 꺾여 얼굴이 처음 보임.
--   (플레이어 발소리에 겹쳐 재생하는 0.12초 지연 발소리는 소리 담당 몫 — 빠짐)
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 6,
	InvestigateSpeed = 8,
	ChaseSpeed = 18,
	AgentRadius = 1.4,
	AgentHeight = 9,
	CatchDistance = 3,
}
M.spawnLift = 4.2
M.voice = "2" -- (소리: 전용 소리 전까지 — 맨발 걸음 계열)

local HIP = 3
local FLOOR = -(HIP + 1)
local RANGE = 50

local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("InStep", cf, Vector3.new(1.6, 2, 1.2))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 }, red: boolean?)
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1], red)
		end
	end
	local function cone(bone: string, a: Vector3, b: Vector3, wa: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		for _, k in { -1, 1 } do
			S(bone, a + off * (wa * k), b + off * (wb * k))
		end
	end
	-- 골반 띠(3차): 뒤쪽 반 고리 + 레일 용접 쐐기(정면에 고리가 안 보임) + 살 골반 쐐기
	chain("HipRing", { P(1, 4.1, 0.1), P(0.7, 4.1, 0.66), P(0, 4.1, 0.9), P(-0.7, 4.1, 0.66), P(-1, 4.1, 0.1) })
	chain("HipRing", { P(-0.2, 4.1, 0.9), P(0, 4.5, 0.95), P(0.2, 4.1, 0.9) })
	chain("Pelvis", { P(-0.55, 4.25, -0.2), P(0, 3.7, -0.35), P(0.55, 4.25, -0.2) })
	S("Pelvis", P(-0.55, 4.25, -0.2), P(0.55, 4.25, -0.2))
	-- 다리(안짱 무릎) + 바깥 버팀대(무릎 경첩·발목 고리) + 슬개골 쐐기 + 맨발
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local hip, knee, ankle = P(0.45 * s, 3.95, 0), P(0.38 * s, 2.0, -0.15), P(0.45 * s, 0.3, 0.05)
		cone("Thigh" .. n, hip, knee, 0.24, 0.15, Vector3.new(s, 0, 0))
		cone("Shin" .. n, knee, ankle, 0.15, 0.09, Vector3.new(s, 0, 0))
		if s > 0 then -- 버팀대는 오른다리만(비대칭)
			S("ThighR", P(0.95, 4.05, 0.05), P(0.68, 2.0, -0.1))
			S("ShinR", P(0.68, 2.0, -0.1), P(0.64, 0.4, 0.05))
		end
		S("Shin" .. n, knee + Vector3.new(0, 0.2, -0.2), knee + Vector3.new(0, -0.25, -0.18)) -- 슬개골
		chain("Foot" .. n, { ankle + Vector3.new(0, -0.05, 0.25), ankle + Vector3.new(0, -0.25, 0.1), ankle + Vector3.new(0, -0.25, -0.75) })
	end
	-- 살 척추(앞으로 처짐) + 갈비 우리
	S("Lumbar", P(0, 4.2, 0.25), P(0, 5.55, 0.3))
	S("Thorax", P(0, 5.55, 0.3), P(0, 7.0, 0.2))
	for _, s in { -1, 1 } do
		S("Lumbar", P(0.5 * s, 4.3, 0.0), P(0.55 * s, 5.55, -0.1))
		chain("Thorax", { P(0.55 * s, 5.55, -0.1), P(0.7 * s, 6.4, -0.15), P(0.8 * s, 6.95, 0.05) })
		chain("Thorax", { P(0.15 * s, 6.35, -0.42), P(0.6 * s, 6.0, -0.25) }) -- 갈비
		chain("Thorax", { P(0.15 * s, 5.95, -0.4), P(0.55 * s, 5.6, -0.2) })
	end
	-- 목 앞면(턱 밑이 정면을 봄)
	for _, s in { -1, 1 } do
		S("Neck", P(0.22 * s, 6.95, 0.0), P(0.2 * s, 7.7, -0.15))
	end
	-- 등 뒤 세로 레일 + 척추 클립 2
	S("Rail", P(0, 4.1, 0.95), P(0, 8.9, 0.85))
	S("Rail", P(0, 5.0, 0.92), P(0, 5.0, 0.35))
	S("Rail", P(0, 6.5, 0.88), P(0, 6.5, 0.3))
	-- 오른 어깨만 받치는 L 버팀대, 왼팔을 매단 끈
	chain("Yoke", { P(0, 7.15, 0.85), P(1.05, 7.15, 0.75), P(1.12, 6.6, 0.1), P(1.15, 6.5, -1.2) })
	S("Rail", P(0, 7.35, 0.85), P(-0.9, 6.7, 0.15))
	-- 쐐기 받침(레일 꼭대기 → 이마) + 턱 걸쇠 + 핀 2, 두건 머리(뒤로 72° 젖혀 천장을 봄)
	local hc = P(0, 8.15, 0.35)
	chain("Clamp", { P(0, 8.9, 0.85), P(0, 8.75, 0.25), P(0, 8.5, -0.15) })
	chain("Clamp", { P(-0.32, 7.72, -0.32), P(0, 7.6, -0.45), P(0.32, 7.72, -0.32) })
	S("Clamp", P(-0.32, 7.72, -0.32), P(-0.42, 8.2, 0.3)) -- 걸쇠 옆 끈
	-- 젖혀진 옆얼굴(3차): 턱 → 입 → 코(위) → 이마 → 뒤통수. 정면에선 턱 밑 쐐기가 보인다
	local prof = {}
	for _, q in { { -0.12, -0.55 }, { 0.3, -0.62 }, { 0.36, -0.42 }, { 0.62, -0.1 }, { 0.46, 0.08 }, { 0.5, 0.45 }, { 0.05, 0.62 }, { -0.42, 0.28 }, { -0.12, -0.55 } } do
		table.insert(prof, hc + Vector3.new(0, q[1], q[2]))
	end
	chain("Head", prof)
	chain("Head", { hc + Vector3.new(-0.38, 0.1, 0.1), hc + Vector3.new(-0.22, -0.08, -0.45), hc + Vector3.new(0, -0.14, -0.58), hc + Vector3.new(0.22, -0.08, -0.45), hc + Vector3.new(0.38, 0.1, 0.1) }) -- 턱뼈(말굽)
	chain("Head", { hc + Vector3.new(-0.38, 0.1, 0.1), hc + Vector3.new(0, 0.5, 0.35), hc + Vector3.new(0.38, 0.1, 0.1) }) -- 두개 폭
	-- 팔: 오른팔은 버팀대에 묶여 늘어짐, 왼팔은 끈에 매달려 더 처짐. 손가락 쐐기 2
	local arms = {
		R = { P(1.1, 6.95, 0.05), P(1.15, 6.75, -1.25), P(1.1, 5.25, -1.35) }, -- (받침에 묶여 앞으로 뻗고 아래팔은 늘어짐)
		L = { P(-0.9, 6.6, 0.1), P(-1.0, 5.1, 0.05), P(-0.95, 3.6, -0.1) },
	}
	for n, a in arms do
		local s = if n == "L" then -1 else 1
		cone("UpperArm" .. n, a[1], a[2], 0.17, 0.11, Vector3.new(s, 0, 0))
		cone("Forearm" .. n, a[2], a[3], 0.11, 0.07, Vector3.new(s, 0, 0))
		S("Hand" .. n, a[3], a[3] + Vector3.new(0.05 * s, -0.7, -0.12))
		S("Hand" .. n, a[3], a[3] + Vector3.new(-0.08 * s, -0.55, 0.1))
	end
	-- 붉은 동기 케이블: 레일 뒤 → 바닥으로 끌림
	local cab = { P(0, 7.6, 1.45), P(0.1, 5.8, 1.6), P(0.15, 3.8, 1.75), P(0.1, 1.8, 2.1), P(0, 0.1, 2.8), P(0, 0.05, 3.8) }
	S("Rail", P(0, 7.5, 0.88), cab[1]) -- 케이블 받침대(레일 뒤로 0.6)
	chain("Cable1", { cab[1], cab[2], cab[3] }, true)
	chain("Cable2", { cab[3], cab[4], cab[5] }, true)
	chain("Cable3", { cab[5], cab[6] }, true)
	local bones: { Rig.Bone } = {
		{ name = "HipRing", joint = P(0, 4.1, 0.1), tip = P(0, 4.1, -0.9) },
		{ name = "Pelvis", parent = "HipRing", joint = P(0, 4.05, 0), tip = P(0, 3.75, 0) },
		{ name = "Lumbar", parent = "Pelvis", joint = P(0, 4.2, 0.25), tip = P(0, 5.55, 0.3) },
		{ name = "Thorax", parent = "Lumbar", joint = P(0, 5.55, 0.3), tip = P(0, 7.0, 0.2) },
		{ name = "Neck", parent = "Thorax", joint = P(0, 6.95, 0.1), tip = P(0, 7.7, -0.1) },
		{ name = "Rail", parent = "HipRing", joint = P(0, 4.1, 0.95), tip = P(0, 8.9, 0.85) },
		{ name = "Yoke", parent = "Rail", joint = P(0, 7.15, 0.85), tip = P(1.05, 7.15, 0.75) },
		{ name = "Clamp", parent = "Rail", joint = P(0, 7.95, 0.45), tip = P(0, 8.5, -0.15) },
		{ name = "Head", parent = "Clamp", joint = P(0, 7.95, 0.4), tip = hc },
		{ name = "UpperArmR", parent = "Yoke", joint = arms.R[1], tip = arms.R[2] },
		{ name = "UpperArmL", parent = "Rail", joint = arms.L[1], tip = arms.L[2] },
		{ name = "Cable1", parent = "Rail", joint = cab[1], tip = cab[3] },
		{ name = "Cable2", parent = "Cable1", joint = cab[3], tip = cab[5] },
		{ name = "Cable3", parent = "Cable2", joint = cab[5], tip = cab[6] },
	}
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local a = arms[n]
		table.insert(bones, { name = "Forearm" .. n, parent = "UpperArm" .. n, joint = a[2], tip = a[3] })
		table.insert(bones, { name = "Hand" .. n, parent = "Forearm" .. n, joint = a[3], tip = a[3] + Vector3.new(0, -0.7, -0.1) })
		table.insert(bones, { name = "Thigh" .. n, parent = "Pelvis", joint = P(0.45 * s, 3.95, 0), tip = P(0.38 * s, 2.0, -0.15) })
		table.insert(bones, { name = "Shin" .. n, parent = "Thigh" .. n, joint = P(0.38 * s, 2.0, -0.15), tip = P(0.45 * s, 0.3, 0.05) })
		table.insert(bones, { name = "Foot" .. n, parent = "Shin" .. n, joint = P(0.45 * s, 0.3, 0.05), tip = P(0.45 * s, 0.05, -0.75) })
	end
	Rig.build(model, root, cf, {
		id = "c1h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.8,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 가까운 플레이어(살아 있고 숨지 않음)의 실제 수평 속도
local function nearestSpeed(self: any): number?
	local my = self.root.Position
	local best: number?, bd = nil, RANGE
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Status") == "Alive" and not p:GetAttribute("Hidden") then
			local char = p.Character
			local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then
				local dd = (r.Position - my).Magnitude
				if dd < bd then
					local v = r.AssemblyLinearVelocity
					best, bd = Vector3.new(v.X, 0, v.Z).Magnitude, dd
				end
			end
		end
	end
	return best
end

function M.tick(self: any, _now: number): boolean
	local d = self.cdata
	if self.state == "Alert" then
		d.sync = false
		return false
	end
	local sp = nearestSpeed(self)
	if sp then
		-- 발맞춤: 네가 걸은 만큼만 걷는다(멈추면 0)
		local want = if sp < 0.6 then 0 else math.clamp(sp, 0, M.cfg.ChaseSpeed)
		if self.hum.WalkSpeed ~= want then
			self.hum.WalkSpeed = want
		end
		d.sync = true
		self.model:SetAttribute("Sync", true)
	elseif d.sync then
		d.sync = false
		self.model:SetAttribute("Sync", false)
		self:setState(self.state) -- 원래 상태 속도로
	end
	return false
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="154">
          <Properties>
            <string name="Name">c1n</string>
            <string name="Source"><![CDATA[--!strict
-- c1n 청음체 (1장 지하 시설 · 비인간형) — 사양서: art/creatures/sheets/ch1/c1n_spec.md (+ QA1 수정 지시 반영)
-- "소리를 더 잘 듣는 몸": 낮게 웅크린 등, S자로 앞으로 내민 목 끝에 한쪽이 찢겨 열린 갈비 깔때기(귀), 그 안에 고막.
-- 3차(최신): 장대 위 새장·세 다리 의자 구성 폐기 — c1n3.js 의 목·깔때기 점을 그대로 옮김. 갈비는 뾰족한 갈고리.
-- 다리는 사람 팔 셋(손바닥으로 딛음) — 하나를 들어 바깥으로 크게 돌려 딛으며 몸통이 도는 회전 삼각 보행.
-- QA1: 우산·파라솔 금지 → 갈비 끝이 앞·아래로 말린 깔때기(조개) — 정면에서 벌어진 구멍 · 갈비 14 → 9, 길이·곡률 제각각,
--      비대칭(왼쪽 2개 결손, 오른쪽 R5 크게 부러져 처짐) · 채운 막 대신 막 테두리 한 줄 + 붉은 세로 틈 고막 ·
--      다리는 '팔'로: 팔꿈치가 바깥으로 꺾이고 손목을 젖혀 손바닥 전체로 딛음 · 퇴화한 팔은 하나만(목뼈를 감아쥠).
-- 뼈: Hub → HipA/B/C → ArmA/B/C → ForeA/B/C → HandA/B/C,  Hub → Neck1 → Neck2 → Neck3 → Dish → Ear(고막), Dish → RibL / RibR,
--      Neck1 → Vest → VestFore(목뼈를 쥔 퇴화한 팔)
-- 붉은 선: 고막(세로로 찢어진 틈 모양 고리 하나).
-- 공포 장치 「겨누는 접시」: 발소리는 못 듣는다(걸음 소리 무시). 40 안의 음파 → 0.8초에 접시를 그쪽으로 겨누고 4초 동안 '듣는 중'
--   (제자리, Listening 속성 + AimAt). 이때 접시 정면 ±35° 안에서 또 쏘면 위치 확정 → 추격, 3 안에서 돌진(22).
--   옆·뒤에서 쏜 음파는 안전(무시).
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 6,
	InvestigateSpeed = 8,
	ChaseSpeed = 12,
	AgentRadius = 1.6,
	AgentHeight = 4,
	CatchDistance = 2.8,
}
M.spawnLift = 2.8
M.voice = "3" -- (소리: 전용 소리 전까지 — 손바닥 짚는 톡톡 계열)

local HIP = 1.6
local FLOOR = -(HIP + 1)
local HUB = 2.1
local LISTEN = 4.8 -- 겨눔 0.8 + 듣기 4
local CONE = math.cos(math.rad(35))
M.legs = { A = 60, B = -60, C = 180 } -- 다리 방향(도, 0 = 앞 −Z, + = 오른쪽)

local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end
local function dir(deg: number): Vector3
	local t = math.rad(deg)
	return Vector3.new(math.sin(t), 0, -math.cos(t))
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Listener", cf, Vector3.new(1.6, 2, 1.6))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 }, red: boolean?)
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1], red)
		end
	end
	local function cone(bone: string, a: Vector3, b: Vector3, wa: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		for _, k in { -1, 1 } do
			S(bone, a + off * (wa * k), b + off * (wb * k))
		end
	end
	local hub = P(0, HUB, 0)
	-- 낮게 웅크린 등(3차: 장대·의자 구성 폐기): 등 가시 능선 + 양옆 윤곽 + 엉치 쐐기 + 장골 날개
	chain("Hub", { P(0, 2.2, 1.2), P(0, 2.72, 0.65), P(0, 2.82, 0.1), P(0, 2.5, -0.35) })
	for _, s in { -1, 1 } do
		chain("Hub", { P(0.4 * s, 1.8, 1.15), P(0.5 * s, 2.25, 0.6), P(0.55 * s, 2.3, 0), P(0.4 * s, 2.1, -0.4) })
		chain("Hub", { P(0.25 * s, 2.0, 0.9), P(0.62 * s, 1.95, 1.2), P(0.5 * s, 1.65, 1.5) })
	end
	chain("Hub", { P(0, 2.0, 1.25), P(0, 2.05, 1.65), P(0, 1.65, 1.6) })
	local bones: { Rig.Bone } = {
		{ name = "Hub", joint = hub, tip = hub + Vector3.new(0, 0.8, 0) },
	}
	-- 다리 셋 = 사람 팔: 위팔은 바깥·위로(팔꿈치가 무릎처럼 솟음), 아래팔은 거의 수직, 손목을 젖혀 손바닥 전체로 딛음
	for name, deg in M.legs do
		local u = dir(deg)
		local side = Vector3.yAxis:Cross(u)
		local sh = hub + u * 0.45
		local el = P(0, 2.75, 0) + u * 1.35 + side * 0.2 -- 팔꿈치가 무릎처럼 솟고 옆으로 비틀림
		local wr = P(0, 0.35, 0) + u * 1.95
		cone("Arm" .. name, sh, el, 0.2, 0.14, side)
		cone("Fore" .. name, el, wr, 0.14, 0.09, side)
		-- 손바닥 판(바깥으로 젖힘) + 손가락 3(마디가 솟음)
		local palm = wr + u * 0.45 + Vector3.new(0, -0.3, 0)
		chain("Hand" .. name, { wr + side * 0.2, palm + side * 0.25, palm - side * 0.25, wr - side * 0.2 })
		for i = -1, 1 do
			local f0 = palm + side * (0.2 * i)
			local f1 = f0 + u * 0.3 + side * (0.08 * i) + Vector3.new(0, 0.15, 0)
			chain("Hand" .. name, { f0, f1, f1 + u * 0.3 + side * (0.05 * i) + Vector3.new(0, -0.16, 0) })
		end
		table.insert(bones, { name = "Hip" .. name, parent = "Hub", joint = hub, tip = sh })
		table.insert(bones, { name = "Arm" .. name, parent = "Hip" .. name, joint = sh, tip = el })
		table.insert(bones, { name = "Fore" .. name, parent = "Arm" .. name, joint = el, tip = wr })
		table.insert(bones, { name = "Hand" .. name, parent = "Fore" .. name, joint = wr, tip = palm })
	end
	-- S자 목(앞으로 내밀어 숙임): 마디마다 양옆 윤곽 + 가시돌기
	S("Neck1", P(-0.23, 2.15, -0.3), P(-0.21, 2.62, -0.72))
	S("Neck1", P(0.23, 2.15, -0.3), P(0.21, 2.62, -0.72))
	S("Neck2", P(-0.21, 2.62, -0.72), P(-0.19, 2.62, -1.22))
	S("Neck2", P(0.21, 2.62, -0.72), P(0.19, 2.62, -1.22))
	S("Neck3", P(-0.19, 2.62, -1.22), P(-0.17, 2.22, -1.58))
	S("Neck3", P(0.19, 2.62, -1.22), P(0.17, 2.22, -1.58))
	S("Neck3", P(-0.17, 2.22, -1.58), P(-0.16, 1.72, -1.72))
	S("Neck3", P(0.17, 2.22, -1.58), P(0.16, 1.72, -1.72))
	S("Neck2", P(0, 2.8, -0.72), P(0, 3.04, -0.62))
	S("Neck3", P(0, 2.8, -1.22), P(0, 3.04, -1.12))
	-- 깔때기(귀): 한쪽이 찢겨 열린 C자 테두리 → 찢긴 쪽은 꼭지까지 파임
	chain("Dish", { P(0, 1.72, -1.72), P(-0.61, 0.9, -3.04), P(-0.9, 1.41, -3.15), P(-0.69, 2.23, -3.33), P(0.03, 2.57, -3.41), P(0.93, 2.11, -3.31), P(1.06, 1.36, -3.14), P(0.67, 0.8, -3.02), P(0, 1.72, -1.72) })
	-- 갈비 9: 끝은 뾰족한 갈고리, 안쪽 골은 하나 걸러. 왼·오른 묶음(RibL/RibR)이 벌어지고 오므림
	chain("RibR", { P(0.02, 2.05, -2.26), P(0.24, 2.56, -3.4), P(0.48, 2.59, -3.58), P(0.64, 2.36, -3.62) })
	chain("RibR", { P(0.87, 2.2, -3.32), P(1.07, 2.1, -3.45), P(1.08, 1.86, -3.47) })
	chain("RibR", { P(0.4, 1.74, -2.19), P(1.09, 1.57, -3.19), P(1.19, 1.4, -3.27), P(1.09, 1.24, -3.3) })
	chain("RibR", { P(0.86, 0.97, -3.05), P(0.86, 0.81, -3.12), P(0.73, 0.75, -3.15) })
	chain("RibR", { P(0.12, 1.42, -2.25), P(0.13, 1.25, -2.7) })
	chain("RibL", { P(-0.44, 2.43, -3.38), P(-0.29, 2.57, -3.57), P(-0.05, 2.48, -3.63) })
	chain("RibL", { P(-0.34, 1.75, -2.19), P(-0.88, 1.9, -3.26), P(-0.87, 2.06, -3.43), P(-0.67, 2.12, -3.52) })
	chain("RibL", { P(-0.87, 1.29, -3.13), P(-0.96, 1.39, -3.25), P(-0.87, 1.51, -3.33) })
	chain("RibL", { P(-0.18, 1.41, -2.12), P(-0.59, 0.89, -3.04), P(-0.71, 0.91, -3.13), P(-0.71, 1.03, -3.2) })
	-- 붉은 고막: 세로로 찢긴 틈
	chain("Ear", { P(0, 1.92, -2.19), P(0.05, 1.76, -2.16), P(-0.03, 1.64, -2.13), P(0.04, 1.5, -2.1), P(0, 1.34, -2.07), P(-0.05, 1.56, -2.12), P(0, 1.92, -2.19) }, true)
	-- 퇴화한 팔 하나: 매듭 옆에서 올라와 손가락이 목뼈를 감아쥠
	local ve0, ve1, ve2 = P(-0.35, 2.0, -0.4), P(-0.55, 2.3, -0.75), P(-0.2, 2.62, -0.95)
	S("Vest", ve0, ve1)
	S("VestFore", ve1, ve2)
	for _, k in { -1, 0, 1 } do
		S("VestFore", ve2 + Vector3.new(0, 0.12 * k, 0), ve2 + Vector3.new(0.3, 0.12 * k - 0.05, -0.2))
	end
	for _, bdef in {
		{ name = "Neck1", parent = "Hub", joint = P(0, 2.1, 0), tip = P(0, 2.62, -0.72) }, -- (몸통 회전축에서 되돌려야 목이 늘 앞을 봄)
		{ name = "Neck2", parent = "Neck1", joint = P(0, 2.62, -0.72), tip = P(0, 2.62, -1.22) },
		{ name = "Neck3", parent = "Neck2", joint = P(0, 2.62, -1.22), tip = P(0, 1.72, -1.72) },
		{ name = "Dish", parent = "Neck3", joint = P(0, 1.72, -1.72), tip = P(0, 1.44, -2.99) },
		{ name = "Ear", parent = "Dish", joint = P(-0.03, 1.64, -2.13), tip = P(0, 1.92, -2.19) },
		{ name = "RibL", parent = "Dish", joint = P(0, 1.72, -1.72), tip = P(-0.93, 1.56, -3.18) },
		{ name = "RibR", parent = "Dish", joint = P(0, 1.72, -1.72), tip = P(0.93, 1.56, -3.18) },
		{ name = "Vest", parent = "Neck1", joint = ve0, tip = ve1 },
		{ name = "VestFore", parent = "Vest", joint = ve1, tip = ve2 },
	} :: { Rig.Bone } do
		table.insert(bones, bdef)
	end
	Rig.build(model, root, cf, {
		id = "c1n",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.8,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

function M.init(self: any)
	self.cdata.listenUntil = 0
	self.model:SetAttribute("Listening", false)
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if d.listenUntil > 0 then
		if now < d.listenUntil and self.state ~= "Chase" then
			self.hum:MoveTo(self.root.Position) -- 듣는 동안 제자리
			return true
		end
		d.listenUntil = 0
		self.model:SetAttribute("Listening", false)
	end
	if self.state == "Chase" then
		local t: Player? = self.target
		local char = t and t.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local close = r ~= nil and (r.Position - self.root.Position).Magnitude < 4
		local want = if close then 22 else M.cfg.ChaseSpeed -- 마지막 3 스터드 돌진
		if self.hum.WalkSpeed ~= want then
			self.hum.WalkSpeed = want
		end
	end
	return false
end

function M.hear(self: any, pos: Vector3, _radius: number, source: Player?, kind: string): boolean
	if string.sub(kind, 1, 4) == "Step" then
		return true -- 걸음 소리는 못 듣는다
	end
	if kind ~= "Sonar" then
		return false
	end
	local my = self.root.Position
	local to = Vector3.new(pos.X - my.X, 0, pos.Z - my.Z)
	if to.Magnitude > 40 then
		return false
	end
	local d = self.cdata
	local now = os.clock()
	if d.listenUntil > 0 and now < d.listenUntil then
		-- 듣는 중: 접시 정면 ±35° 안에서 다시 쏘면 들킴
		if source and to.Magnitude > 0.5 and d.aimDir and to.Unit:Dot(d.aimDir) >= CONE then
			d.listenUntil = 0
			self.model:SetAttribute("Listening", false)
			self:startChase(source, pos)
		end
		return true
	end
	if self.state == "Chase" then
		return false
	end
	d.aimDir = if to.Magnitude > 0.5 then to.Unit else self.root.CFrame.LookVector
	d.listenUntil = now + LISTEN
	self.model:SetAttribute("AimAt", pos)
	self.model:SetAttribute("Listening", true)
	return true
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="155">
          <Properties>
            <string name="Name">c2h</string>
            <string name="Source"><![CDATA[--!strict
-- c2h 틈사람 (2장 물류 창고 · 사람형) — 사양서: roster/v5/ch2/c2h_spec.md (+ QA1 수정 지시 반영)
-- 선반 틈에 오래 끼어 옆으로 눌린 창고 직원. 몸·머리가 두께 0.5 의 판(X 로 얇고 Z 로 깊다).
-- 정면(진행 방향)에서는 세로 줄 몇 개 + 붉은 찢김 한 줄, 옆에서만 사람 옆모습과 옆면에 눌린 얼굴(+X)이 보인다.
-- 뼈: Pelvis → Spine → Chest(Band1·Band2 → Badge, BoundArmL/R → ForearmL/R → HandL/R, Neck → HeadPlate → FaceSplit)
--      Pelvis → ThighL/R → ShinL/R → FootL/R.  위팔은 띠에 묶여 고정, 머리는 돌지 않는다.
-- 공포 장치 「옆 통로의 걸음」(간단판):
--   ① 가까운(30 안) 플레이어의 속도를 거울처럼 따라 걷는다(멈추면 같이 멈춤).
--   ② 그 플레이어의 발소리 0.15초 뒤에 똑같은 발소리(클라이언트가 Echo 속성으로 b.step).
--   ③ 플레이어가 22 안에서 3초 넘게 멈춰 있으면 몸을 칼날로 세워(Slide) 넘어와 추격한다.
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 6,
	InvestigateSpeed = 10,
	ChaseSpeed = 16.2, -- 플레이어 달리기 18 × 0.9
	AgentRadius = 1.2,
	AgentHeight = 9,
	CatchDistance = 3,
}
M.spawnLift = 3.4
M.voice = "1" -- (소리: 전용 소리 전까지 발 끌기 계열)

local HIP = 2.2
local FLOOR = -(HIP + 1)
local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z) -- y = 바닥에서 높이, 앞 = -Z
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Gapman", cf, Vector3.new(1.2, 2, 1.4))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 })
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1])
		end
	end
	-- 판 몸은 옆(Z)으로만 두께가 있다: 외곽선 두 줄(앞 테·뒤 테), 정면에서는 겹쳐 한 줄처럼
	local function limb(bone: string, a: Vector3, b: Vector3, wa: number, wm: number, wb: number)
		local d = (b - a).Unit
		local s = Vector3.zAxis
		local off = (s - d * s:Dot(d)).Unit
		local m = a:Lerp(b, 0.35)
		for _, k in { -1, 1 } do
			chain(bone, { a + off * (wa * k), m + off * (wm * k), b + off * (wb * k) })
		end
	end
	-- 몸통 판: 앞 테(가슴·배)와 뒤 테(등·평평한 엉덩이). 곧은 외곽 = 눌린 판
	chain("Pelvis", { P(0, 3.85, -0.34), P(0, 4.6, -0.4) })
	chain("Spine", { P(0, 4.6, -0.4), P(0, 5.35, -0.44) })
	chain("Chest", { P(0, 5.35, -0.44), P(0, 6.05, -0.5), P(0, 6.6, -0.36), P(0.02, 6.78, -0.12) })
	chain("Pelvis", { P(0, 3.8, 0.42), P(0, 4.6, 0.4) })
	chain("Spine", { P(0, 4.6, 0.4), P(0, 5.35, 0.42) })
	chain("Chest", { P(0, 5.35, 0.42), P(0, 6.1, 0.46), P(0, 6.62, 0.3), P(0.02, 6.78, 0.08) })
	S("Pelvis", P(0, 3.85, -0.34), P(0, 3.72, 0.06)) -- 사타구니 밑선
	S("Pelvis", P(0, 3.72, 0.06), P(0, 3.8, 0.42))
	-- 눌린 갈비 자국(얼굴 쪽 옆면 +X)
	for i, y in { 5.85, 6.1, 6.35 } do
		S("Chest", P(0.24, y, -0.4), P(0.24, y - 0.08, 0.02 + i * 0.06))
	end
	-- 랩 띠 2줄(몸통과 묶인 위팔을 함께 조인다) + 출입증
	for _, band in { { "Band1", 5.72 }, { "Band2", 6.28 } } do
		local bn, y = band[1] :: string, band[2] :: number
		S(bn, P(-0.36, y, -0.5), P(-0.36, y - 0.05, 0.47))
		S(bn, P(0.36, y + 0.04, -0.5), P(0.36, y - 0.02, 0.47))
	end
	S("Badge", P(0.4, 6.22, -0.26), P(0.42, 5.82, -0.28))
	S("Badge", P(0.42, 5.82, -0.28), P(0.42, 5.82, -0.02))
	-- 팔: 위팔(묶여 고정) → 아래팔 → 손(엉덩이 옆에 납작하게 펼쳐짐). 전부 몸 판 평면 안(x ±0.3)
	for _, sd in { { "L", -1 }, { "R", 1 } } do
		local n, s = sd[1] :: string, sd[2] :: number
		local x = 0.3 * s
		chain("BoundArm" .. n, { P(x, 6.6, 0.08), P(x, 6.0, 0.16), P(x, 5.3, 0.14) })
		chain("Forearm" .. n, { P(x, 5.3, 0.14), P(x * 1.04, 4.7, 0.05), P(x, 4.05, -0.06) })
		S("Hand" .. n, P(x, 4.05, -0.06), P(x * 1.05, 3.55, -0.12)) -- 손바닥
		S("Hand" .. n, P(x * 1.05, 3.55, -0.2), P(x * 1.08, 2.95, -0.28)) -- 손가락 묶음(검지·중지)
		S("Hand" .. n, P(x * 1.05, 3.55, -0.02), P(x * 1.08, 3.0, 0.04)) -- 손가락 묶음(약지·새끼)
		S("Hand" .. n, P(x, 3.88, -0.18), P(x * 1.05, 3.6, -0.36)) -- 엄지
	end
	-- 목(1마디) → 판 머리: 외곽 7변 + 옆면 얼굴(늘어난 눈구멍 2, 비뚤어진 입 1)
	chain("Neck", { P(0.02, 6.78, -0.05), P(0.05, 7.05, -0.08), P(0.07, 7.32, -0.12) })
	chain("Neck", { P(0.02, 6.78, 0.12), P(0.06, 7.3, 0.1) })
	chain("HeadPlate", {
		P(0.07, 7.32, -0.12),
		P(0.08, 7.42, -0.5),
		P(0.1, 7.95, -0.6),
		P(0.11, 8.5, -0.46),
		P(0.1, 8.75, -0.1),
		P(0.09, 8.55, 0.32),
		P(0.08, 7.95, 0.42),
		P(0.06, 7.3, 0.1),
	})
	S("HeadPlate", P(0.25, 8.2, -0.5), P(0.25, 8.17, -0.12)) -- 앞 눈구멍(옆으로 늘어남)
	S("HeadPlate", P(0.25, 8.08, 0.0), P(0.25, 8.05, 0.28)) -- 뒤 눈구멍(높이가 어긋남)
	chain("HeadPlate", { P(0.25, 7.68, -0.48), P(0.25, 7.62, -0.2), P(0.25, 7.7, 0.06) }) -- 비뚤어진 입
	-- 붉은 세로 찢김(머리판 앞 테) — 정면·옆 모두에서 보이는 한 곳
	S("FaceSplit", P(0.12, 7.75, -0.64), P(0.13, 8.45, -0.52), true)
	-- 다리: 허벅지·정강이는 앞뒤 외곽 두 줄(무릎에서 좁아짐), 발은 납작한 판(발바닥·발등)
	for _, sd in { { "L", -1 }, { "R", 1 } } do
		local n, s = sd[1] :: string, sd[2] :: number
		local x = 0.16 * s
		limb("Thigh" .. n, P(x, 4.1, 0.02), P(x, 2.2, -0.55), 0.3, 0.27, 0.13)
		limb("Shin" .. n, P(x, 2.2, -0.55), P(x, 0.32, 0.0), 0.14, 0.17, 0.08)
		S("Shin" .. n, P(x, 2.32, -0.72), P(x, 2.05, -0.72)) -- 무릎뼈 모서리
		chain("Foot" .. n, { P(x, 0.05, 0.22), P(x, 0.03, -0.45), P(x, 0.05, -0.95) }) -- 발바닥
		chain("Foot" .. n, { P(x, 0.4, -0.02), P(x, 0.2, -0.55), P(x, 0.08, -0.95) }) -- 발등
		S("Foot" .. n, P(x, 0.05, 0.22), P(x, 0.36, 0.12)) -- 뒤꿈치
	end
	local bones: { Rig.Bone } = {
		{ name = "Pelvis", joint = P(0, 4.1, 0), tip = P(0, 4.6, 0) },
		{ name = "Spine", parent = "Pelvis", joint = P(0, 4.6, 0), tip = P(0, 5.35, 0) },
		{ name = "Chest", parent = "Spine", joint = P(0, 5.35, 0), tip = P(0, 6.78, 0) },
		{ name = "Band1", parent = "Chest", joint = P(0, 5.72, 0), tip = P(0, 5.72, 0.5) },
		{ name = "Band2", parent = "Chest", joint = P(0, 6.28, 0), tip = P(0, 6.28, 0.5) },
		{ name = "Badge", parent = "Band2", joint = P(0.41, 6.22, -0.2), tip = P(0.42, 5.82, -0.2) },
		{ name = "BoundArmL", parent = "Chest", joint = P(-0.3, 6.6, 0.08), tip = P(-0.3, 5.3, 0.14) },
		{ name = "ForearmL", parent = "BoundArmL", joint = P(-0.3, 5.3, 0.14), tip = P(-0.3, 4.05, -0.06) },
		{ name = "HandL", parent = "ForearmL", joint = P(-0.3, 4.05, -0.06), tip = P(-0.32, 3.0, -0.2) },
		{ name = "BoundArmR", parent = "Chest", joint = P(0.3, 6.6, 0.08), tip = P(0.3, 5.3, 0.14) },
		{ name = "ForearmR", parent = "BoundArmR", joint = P(0.3, 5.3, 0.14), tip = P(0.3, 4.05, -0.06) },
		{ name = "HandR", parent = "ForearmR", joint = P(0.3, 4.05, -0.06), tip = P(0.32, 3.0, -0.2) },
		{ name = "Neck", parent = "Chest", joint = P(0.03, 6.78, 0.02), tip = P(0.07, 7.32, -0.02) },
		{ name = "HeadPlate", parent = "Neck", joint = P(0.07, 7.32, -0.02), tip = P(0.1, 8.75, -0.1) },
		{ name = "FaceSplit", parent = "HeadPlate", joint = P(0.12, 7.75, -0.64), tip = P(0.13, 8.45, -0.52) },
		{ name = "ThighL", parent = "Pelvis", joint = P(-0.16, 4.1, 0.02), tip = P(-0.16, 2.2, -0.55) },
		{ name = "ShinL", parent = "ThighL", joint = P(-0.16, 2.2, -0.55), tip = P(-0.16, 0.32, 0) },
		{ name = "FootL", parent = "ShinL", joint = P(-0.16, 0.32, 0), tip = P(-0.16, 0.05, -0.95) },
		{ name = "ThighR", parent = "Pelvis", joint = P(0.16, 4.1, 0.02), tip = P(0.16, 2.2, -0.55) },
		{ name = "ShinR", parent = "ThighR", joint = P(0.16, 2.2, -0.55), tip = P(0.16, 0.32, 0) },
		{ name = "FootR", parent = "ShinR", joint = P(0.16, 0.32, 0), tip = P(0.16, 0.05, -0.95) },
	}
	Rig.build(model, root, cf, {
		id = "c2h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.8,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 가장 가까운 살아 있는 플레이어(같은 층)
local function nearest(self: any, range: number): (Player?, BasePart?, number)
	local my = self.root.Position
	local bestP, bestR, bestD = nil, nil, range
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Status") == "Alive" and not p:GetAttribute("Hidden") then
			local char = p.Character
			local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r and math.abs(r.Position.Y - my.Y) < 9 then
				local d = (r.Position - my).Magnitude
				if d < bestD then
					bestP, bestR, bestD = p, r, d
				end
			end
		end
	end
	return bestP, bestR, bestD
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	local st = self.state
	if st == "Chase" or st == "Alert" then
		d.mirror = false
		d.stillSince = nil
		return false
	end
	local p, r = nearest(self, 30)
	if p and r then
		local v = r.AssemblyLinearVelocity
		local sp = Vector3.new(v.X, 0, v.Z).Magnitude
		-- ① 거울 걸음: 같은 속도(달리기 × 0.9 까지), 멈추면 같이 멈춘다
		self.hum.WalkSpeed = math.clamp(sp, 0, M.cfg.ChaseSpeed)
		d.mirror = true
		-- ③ 3초 넘게 멈춰 있으면 칼날로 서서 틈을 넘어온다
		if sp < 1 and (r.Position - self.root.Position).Magnitude < 22 then
			d.stillSince = d.stillSince or now
			if now - d.stillSince >= 3 then
				d.stillSince = nil
				self.model:SetAttribute("Slide", now)
				self:startChase(p, r.Position)
			end
		else
			d.stillSince = nil
		end
	elseif d.mirror then
		d.mirror = false
		d.stillSince = nil
		self:setState(st) -- 원래 상태 속도로 되돌림
	end
	return false
end

-- ② 메아리 발소리: 가까운 플레이어의 발소리를 들으면 클라이언트가 0.15초 뒤 같은 발소리를 낸다
function M.hear(self: any, pos: Vector3, _radius: number, source: Player?, kind: string): boolean
	if source and self.state ~= "Chase" and (kind == "StepWalk" or kind == "StepRun" or kind == "StepCrouch") then
		if (pos - self.root.Position).Magnitude < 30 then
			local n = self.model:GetAttribute("Echo")
			self.model:SetAttribute("Echo", (if typeof(n) == "number" then n else 0) + 1)
		end
	end
	return false
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="156">
          <Properties>
            <string name="Name">c2n</string>
            <string name="Source"><![CDATA[--!strict
-- c2n 짐걸이 (2장 물류 창고 · 비인간형) — 사양서: roster/v5/ch2/c2n_spec.md
-- 머리 없는 몸이 배를 위로 하고 높이 12의 (보이지 않는) 빔 밑에 네 J 갈고리로 매달려 간다. 아래에서 보이는 건 등:
-- 골반 쪽이 크고 목 쪽으로 작아지는 등뼈 돌기 7, 견갑 판·골반 날개(팔다리가 여기서 나옴), 랩으로 봉한 목 그루터기.
-- 뼈: Hang(빔 위 매달림 점, 진자) → Pelvis → Spine1 → Spine2 → NeckStump / 팔·다리 3마디(위·아래·갈고리) / Strand 2마디(붉은 랩 가닥)
-- 공포 장치 「매달린 짐」: 음파에 맞으면 즉시 몸을 말아 짐처럼 멈춘다(Wrap 속성). 마지막 음파 뒤 4초가 지나야 풀린다.
-- 멈춘 동안에도 잡기 판정은 그대로라 그 바로 밑(2.5)을 지나가면 떨어져 낚아챈다. 쫓을 땐 1.2초마다 몸을 던진다(속도 출렁임).
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 3.5, -- 나무늘보처럼 느리게(플레이어 걷기의 1/3)
	InvestigateSpeed = 6,
	ChaseSpeed = 11, -- 평균값. 실제로는 던지기(20) ↔ 다시 걸기(5)를 오간다
	AgentRadius = 1.2,
	AgentHeight = 5,
	CatchDistance = 2.5, -- 위장한 그것 바로 밑 반경
}
M.spawnLift = 2
M.voice = "2" -- (소리: 전용 소리 전까지 나무 딱딱·삐걱 계열 — 갈고리 딸깍 + 랙 삐걱)

local HIP = 1
local FLOOR = -(HIP + 1)
local BEAM = 12.2 -- 빔 윗면 높이(바닥 기준)
local THROW_FAST, THROW_SLOW, THROW_CYCLE = 20, 5, 1.2

-- 시안 좌표(x 옆, y 바닥에서 높이, z 앞 = +) → 루트 기준(앞 = -Z). 몸이 빔(x 0)에서 0.6 옆으로 처져 있어 가운데로 0.3 옮긴다
local function W(x: number, y: number, z: number): Vector3
	return Vector3.new(x - 0.3, FLOOR + y, -z)
end

-- 두 마디 IK: 뿌리 a 에서 끝 c 까지, 길이 l1·l2, 무릎이 pole 쪽으로
local function ik(a: Vector3, c: Vector3, l1: number, l2: number, pole: Vector3): Vector3
	local d = c - a
	local dist = math.clamp(d.Magnitude, 0.05, l1 + l2 - 0.01)
	local dir = d.Unit
	local x = (l1 * l1 - l2 * l2 + dist * dist) / (2 * dist)
	local h = math.sqrt(math.max(0, l1 * l1 - x * x))
	local side = pole - a
	side = side - dir * side:Dot(dir)
	if side.Magnitude < 1e-3 then
		side = Vector3.new(1, 0, 0)
	end
	return a + dir * x + side.Unit * h
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Hanger", cf, Vector3.new(1, 2, 1))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local bones: { Rig.Bone } = {}
	local function L(bone: string, a: Vector3, b: Vector3, r: number, red: boolean?)
		-- 음파에서 원통은 한 획(Line)이고, 아주 짧은 것만 원 하나(Disc)다: 획이 원으로 바뀌지 않게 반지름을 길이에 맞춘다
		local len = (b - a).Magnitude
		local disc = len < 0.12
		table.insert(lines, { bone = bone, a = a, b = b, r = if disc then r else math.min(r, len / 4.2), red = red, disc = if disc then true else nil })
	end
	-- 가늘어지는 관(점 사이마다 원통, 반지름은 점마다)
	local function tube(bone: string, pts: { Vector3 }, rs: { number })
		for i = 1, #pts - 1 do
			L(bone, pts[i], pts[i + 1], rs[i])
		end
	end
	local function bone(name: string, parent: string?, joint: Vector3, tip: Vector3)
		table.insert(bones, { name = name, parent = parent, joint = joint, tip = tip })
	end

	-- 몸 축: 골반 P(뒤) → 허리(처짐) → 가슴 C(앞). 배가 위(up = +Y), 등이 아래
	local P = W(0.6, 9.6, -1.4)
	local C = W(0.6, 9.45, 1.1)
	local mid = (P + C) / 2 - Vector3.new(0, 0.5, 0)
	local ax = (C - P).Unit
	local up = Vector3.new(0, 1, 0)
	local lat = ax:Cross(up).Unit
	local hangAt = Vector3.new(0, FLOOR + BEAM, mid.Z)

	bone("Hang", nil, hangAt, mid)
	bone("Pelvis", "Hang", P, P - ax * 0.4)
	bone("Spine1", "Pelvis", P, mid)
	bone("Band1", "Spine1", P:Lerp(mid, 0.55), P:Lerp(mid, 0.55) + up * 0.5)
	bone("Spine2", "Spine1", mid, C)
	bone("Band2", "Spine2", mid:Lerp(C, 0.5), mid:Lerp(C, 0.5) + up * 0.5)
	local nb = C + ax * 0.3
	local hc = C + Vector3.new(0.03, -0.59, 0) + ax * 0.47
	bone("NeckStump", "Spine2", nb, hc)

	-- 몸통: 음파에는 선 하나가 한 획이라, 몸의 양옆 외곽선 두 줄로 그린다(골반 덩어리 → 잘록한 허리 → 넓은 가슴).
	-- 외곽은 등 쪽(아래)으로 살짝 내려 몸의 두께가 보이게. 끝(골반 뒤·가슴 앞)은 짧은 가로선으로 닫는다
	local P0, C1 = P - ax * 0.35, C + ax * 0.3
	local spine = { P0, P, P:Lerp(mid, 0.6), mid, mid:Lerp(C, 0.5), C, C1 }
	local half = { 0.3, 0.46, 0.38, 0.33, 0.44, 0.52, 0.36 }
	local owner = { "Pelvis", "Spine1", "Spine1", "Spine2", "Spine2", "Spine2" }
	for _, sg in { 1, -1 } do
		for i = 1, #spine - 1 do
			local a = spine[i] + lat * (sg * half[i]) - up * 0.12
			local b = spine[i + 1] + lat * (sg * half[i + 1]) - up * 0.12
			L(owner[i], a, b, 0.1)
		end
	end
	L("Pelvis", P0 + lat * 0.3 - up * 0.12, P0 - lat * 0.3 - up * 0.12, 0.08)
	L("Spine2", C1 + lat * 0.36 - up * 0.12, C1 - lat * 0.36 - up * 0.12, 0.08)
	-- 등 가운데 고랑(척추선): 골반에서 가슴까지
	tube("Spine1", { P - up * 0.3, P:Lerp(mid, 0.5) - up * 0.34, mid - up * 0.32 }, { 0.07, 0.07 })
	tube("Spine2", { mid - up * 0.32, C - up * 0.3 }, { 0.07 })
	-- 등뼈 돌기 7: 등선(아래)에서 솟은 가시 마디, 골반 쪽이 크고 목 쪽으로 작아진다
	for i = 0, 6 do
		local t = 0.12 + i * 0.12
		local q = if t < 0.5 then P:Lerp(mid, t * 2) else mid:Lerp(C, (t - 0.5) * 2)
		local sz = 0.3 - i * 0.03
		local b0 = q - up * 0.32
		L(if t < 0.5 then "Spine1" else "Spine2", b0, b0 - up * sz - ax * 0.08, 0.09 - i * 0.008)
	end
	-- 견갑 판·골반 날개: 팔다리가 여기서 나온다
	for _, sg in { 1, -1 } do
		L("Spine2", C + lat * (sg * 0.15) - ax * 0.35, C + lat * (sg * 0.55) + up * 0.15, 0.2)
		L("Pelvis", P + lat * (sg * 0.1) + ax * 0.3, P + lat * (sg * 0.5) + up * 0.08, 0.22)
		-- 옆구리 갈비 2줄
		for _, t in { 0.66, 0.8 } do
			local q = P:Lerp(C, t) - up * 0.2
			L("Spine2", q + lat * (sg * 0.28) - up * 0.15, q + lat * (sg * 0.45) + up * 0.12, 0.05)
		end
	end
	-- 끊어진 랩 띠 두 줄(허리·가슴을 감은 고리)
	L("Band1", P:Lerp(mid, 0.55) - ax * 0.03, P:Lerp(mid, 0.55) + ax * 0.03, 0.44)
	L("Band2", mid:Lerp(C, 0.5) - ax * 0.03, mid:Lerp(C, 0.5) + ax * 0.03, 0.42)

	-- 팔다리: 뿌리(견갑/골반 날개) → IK 팔꿈치·무릎 → 손목(빔 바로 밑) → J 갈고리가 빔 위를 감아 넘어 뒤로 손톱
	local limbs = {
		{ key = "FL", root = C + lat * 0.48 + up * 0.12, w = W(0.28, 11.55, 1.9), l1 = 1.35, l2 = 1.3, arm = true, s = 1 },
		{ key = "FR", root = C - lat * 0.48 + up * 0.12, w = W(0.28, 11.55, 0.9), l1 = 1.35, l2 = 1.3, arm = true, s = -1 },
		{ key = "BL", root = P + lat * 0.42 + up * 0.05, w = W(0.28, 11.55, -1.55), l1 = 1.45, l2 = 1.35, arm = false, s = 1 },
		{ key = "BR", root = P - lat * 0.42 + up * 0.05, w = W(0.28, 11.55, -2.35), l1 = 1.45, l2 = 1.35, arm = false, s = -1 },
	}
	for _, lb in limbs do
		local upper = if lb.arm then "UpperArm" .. lb.key else "Thigh" .. lb.key
		local lower = if lb.arm then "Forearm" .. lb.key else "Shin" .. lb.key
		local hook = "Hook" .. lb.key
		local pole = lb.root + lat * (lb.s * 1.2) - up * 0.6 + ax * (if lb.arm then -0.6 else 0.9)
		local knee = ik(lb.root, lb.w, lb.l1, lb.l2, pole)
		local w = lb.w
		bone(upper, if lb.arm then "Spine2" else "Pelvis", lb.root, knee)
		bone(lower, upper, knee, w)
		bone(hook, lower, w, w + up * 0.6)
		local k = if lb.arm then 1 else 1.12
		tube(upper, { lb.root, lb.root:Lerp(knee, 0.5), knee }, { 0.23 * k, 0.19 * k })
		table.insert(balls, { bone = upper, c = knee, r = 0.17 * k })
		tube(lower, { knee, knee:Lerp(w, 0.55), w }, { 0.15 * k, 0.12 * k })
		-- 붙은 손가락 J: 앞쪽으로 빔 윗면을 감아 넘고 → 빔 뒤로 내려가 가늘어지는 손톱
		local x0 = w.X
		local function hp(dx: number, y: number, dz: number): Vector3
			return Vector3.new(x0 + dx, FLOOR + y, w.Z + dz)
		end
		tube(hook, { w, hp(0.02, 11.95, -0.03), hp(-0.04, BEAM + 0.12, -0.05), hp(-0.22, BEAM + 0.2, -0.06), hp(-0.4, BEAM + 0.1, -0.06), hp(-0.48, BEAM - 0.15, -0.05), hp(-0.44, BEAM - 0.4, -0.04) }, { 0.13 * k, 0.11 * k, 0.09 * k, 0.075 * k, 0.055 * k, 0.03 * k })
		-- 엄지 가시(뒷발톱)
		local back = w + Vector3.new(0.1, -0.12, 0.18) * k
		L(hook, w + Vector3.new(0, 0.02, 0.04), back, 0.05)
		L(hook, back, back + Vector3.new(0.02, -0.12, 0.05) * k, 0.03)
	end

	-- 목: 머리 없음. 가슴에서 이어진 목 → 랩·테이프를 여러 번 감아 봉한 그루터기(고리 두 줄)
	local hdir = (hc - nb).Unit
	tube("NeckStump", { nb - ax * 0.3, nb, nb:Lerp(hc, 0.5), hc, hc + hdir * 0.25 }, { 0.32, 0.25, 0.22, 0.2 })
	table.insert(balls, { bone = "NeckStump", c = hc + hdir * 0.22, r = 0.19 })
	L("NeckStump", nb:Lerp(hc, 0.55) - hdir * 0.02, nb:Lerp(hc, 0.55) + hdir * 0.02, 0.27)
	L("NeckStump", nb:Lerp(hc, 0.85) - hdir * 0.02, nb:Lerp(hc, 0.85) + hdir * 0.02, 0.27)

	-- 붉은 랩 가닥(유일한 붉은 선): 골반에서 3.2 늘어진 2마디 진자. 위장 중에도 남는 단 하나의 단서
	local s0 = P - up * 0.3
	local s1 = s0 + Vector3.new(0.07, -1.55, 0.25)
	local s2 = s0 + Vector3.new(0.25, -3.3, 0.6)
	bone("Strand1", "Pelvis", s0, s1)
	bone("Strand2", "Strand1", s1, s2)
	L("Strand1", s0, s1, 0.05, true)
	L("Strand2", s1, s1:Lerp(s2, 0.5) + Vector3.new(0.04, 0, -0.05), 0.045, true)
	L("Strand2", s1:Lerp(s2, 0.5) + Vector3.new(0.04, 0, -0.05), s2, 0.04, true)

	Rig.build(model, root, cf, {
		id = "c2n",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.5,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 위장 중: 그 자리에 멈춘다(기본 AI 건너뜀). 잡기 판정은 Monster 쪽에서 계속 돈다 = 밑을 지나가면 떨어진다
function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if d.wrapUntil then
		if now < d.wrapUntil then
			self.hum:MoveTo(self.root.Position)
			return true
		end
		d.wrapUntil = nil
		self.model:SetAttribute("Wrap", false)
		self:setState(self.state) -- (상태에 맞는 속도로 되돌림)
	end
	if self.state == "Chase" then
		-- 던지기: 앞 갈고리 둘만 걸고 몸을 앞으로 던진다(1.2초마다), 그다음 다시 거는 동안 느림
		local cyc = (now % THROW_CYCLE) / THROW_CYCLE
		self.hum.WalkSpeed = if cyc < 0.4 then THROW_FAST else THROW_SLOW
	end
	return false
end

-- 음파에 맞는 순간 몸을 말아 짐으로 위장(0.4초, 클라이언트). 음파를 다시 맞을 때마다 4초 연장
-- 음파에 "맞았는가": 파동이 퍼지는 거리(Config.Sonar.Radius 35) 안이고, 가깝거나(12) 사이가 트여 있음
local SONAR_REACH = 35
local function sonarHit(self: any, pos: Vector3, radius: number): boolean
	local d = (pos - self.root.Position).Magnitude
	if d > math.min(radius, SONAR_REACH) then
		return false
	end
	return d < 12 or self:lineOfSight(pos + Vector3.new(0, 1, 0))
end

function M.hear(self: any, pos: Vector3, radius: number, _source: any, kind: string): boolean
	if kind ~= "Sonar" then
		return false
	end
	if not sonarHit(self, pos, radius) then
		return false
	end
	local d = self.cdata
	if not d.wrapUntil then
		self.model:SetAttribute("Wrap", true)
	end
	d.wrapUntil = os.clock() + 4
	self.hum:MoveTo(self.root.Position)
	return true
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="157">
          <Properties>
            <string name="Name">c3h</string>
            <string name="Source"><![CDATA[--!strict
-- c3h 마개 (3장 하수도 · 사람형) — 사양서: roster/v5/ch3/c3h_spec.md (+ QA1 수정 지시 반영)
-- 배수관 원형 해치(지름 4.3 주철판)를 갈비 버팀으로 가슴에 붙인 채 짐꾼처럼 무릎을 굽혀 걷는 사람.
-- 정면: 원판(무늬 없이 격자 2줄 + 금 한 줄) + 테 아래쪽을 움켜쥔 손가락 + 테 밖으로 파고든 갈비 끝 + 테 아래로 처진 턱 + 맨발.
-- 뼈: Pelvis → Spine → NeckRod → Hatch → HatchRim / EyeSlit,  Spine → ClavicleL/R → UpperArm → Forearm → RimGrip,
--      Pelvis → Thigh → Shin → Foot → Toe.  머리 뼈 없음(머리는 해치 뒤에 눌려 NeckRod 에 붙음).
-- 공포 장치 「막음」(간단판): 음파에 맞으면 0.4초 멈칫(Brace) → 그 방향으로 해치를 세우고 3칸(24) 직진 돌진(9).
--   (해치 뒤로 음파가 통과하지 않는 규칙은 음파 렌더러 쪽 일이라 여기서는 빠짐)
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 4,
	InvestigateSpeed = 7,
	ChaseSpeed = 10,
	AgentRadius = 1.8,
	AgentHeight = 7,
	CatchDistance = 3.2,
}
M.spawnLift = 3.2
M.voice = "2" -- (소리: 전용 소리 전까지 나무 삐걱 계열)

local HIP = 2
local FLOOR = -(HIP + 1)
local CHARGE_SPEED = 9
local CHARGE_DIST = 24
local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end
local HC = P(0, 4.5, -1.0) -- 해치 중심(앞면 z -1.18)
local HR = 2.15
local function rim(deg: number, r: number?, z: number?): Vector3
	-- 시계 위치처럼: 0° = 12시, 90° = 3시(+X)
	local t = math.rad(deg)
	local rr = r or HR
	return Vector3.new(HC.X + rr * math.sin(t), HC.Y + rr * math.cos(t), z or -1.18)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Plug", cf, Vector3.new(2, 2, 1.6))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05 })
	end
	local function chain(bone: string, pts: { Vector3 })
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1])
		end
	end
	-- 팔다리: 대각선 방향 외곽 두 줄(정면·옆 모두 폭이 보임), 관절에서 좁아짐
	local function limb(bone: string, a: Vector3, b: Vector3, wa: number, wm: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		local m = a:Lerp(b, 0.4)
		for _, k in { -1, 1 } do
			chain(bone, { a + off * (wa * k), m + off * (wm * k), b + off * (wb * k) })
		end
	end
	-- 해치: 앞·뒤 테(원 두 개), 주철 격자 2줄, 리벳 3, 금 한 줄(지그재그), 금 틈 속 붉은 눈 하나
	table.insert(lines, { bone = "HatchRim", a = P(0, 4.5, -1.2), b = P(0, 4.5, -1.16), r = HR, disc = true })
	table.insert(lines, { bone = "HatchRim", a = P(0, 4.5, -0.84), b = P(0, 4.5, -0.8), r = HR - 0.1, disc = true })
	table.insert(lines, { bone = "Hatch", a = P(0, 4.5, -1.21), b = P(0, 4.5, -1.19), r = HR - 0.32, disc = true })
	S("Hatch", rim(-62, HR - 0.32, -1.2), rim(62, HR - 0.32, -1.2))
	S("Hatch", rim(-118, HR - 0.32, -1.2), rim(118, HR - 0.32, -1.2))
	for _, deg in { 20, 140, 260 } do
		local c = rim(deg, HR - 0.16, -1.22)
		table.insert(lines, { bone = "HatchRim", a = c, b = c - Vector3.new(0, 0, 0.03), r = 0.07, disc = true })
	end
	chain("Hatch", { rim(185, HR - 0.32, -1.21), P(0.18, 3.25, -1.21), P(-0.12, 3.75, -1.21), P(0.1, 4.25, -1.21), P(-0.05, 4.7, -1.21) })
	table.insert(balls, { bone = "EyeSlit", c = P(0.04, 3.52, -1.12), r = 0.09, red = true })
	-- 몸통: 등선·배선·옆선(짐꾼처럼 앞으로 숙임), 쇄골
	chain("Spine", { P(0, 3.0, 0.62), P(0, 3.9, 0.66), P(0, 4.75, 0.38), P(0, 5.05, 0.05) })
	chain("Spine", { P(0, 3.0, 0.02), P(0, 3.85, -0.22), P(0, 4.55, -0.42) })
	for _, s in { -1, 1 } do
		chain("Spine", { P(0.5 * s, 3.05, 0.35), P(0.55 * s, 3.9, 0.3), P(0.78 * s, 4.75, 0.15) })
		S("Clavicle" .. (if s < 0 then "L" else "R"), P(0.12 * s, 4.85, 0.05), P(0.82 * s, 4.75, 0.12))
	end
	S("Pelvis", P(-0.52, 3.0, 0.3), P(0.52, 3.0, 0.3)) -- 골반 띠
	-- 갈비 버팀 6개(가슴 → 해치 뒷면), 그중 3개는 끝이 테 밖으로 파고든다
	for i, s in { -1, 1, -1, 1, -1, 1 } do
		local y = 3.7 + math.floor((i - 1) / 2) * 0.42
		local reach = if i <= 3 then 1.0 else 0.75
		S("Spine", P(0.32 * s, y, -0.2), P(reach * s * 1.2, y + 0.25, -0.82))
	end
	S("Hatch", rim(112, HR - 0.05, -0.9), rim(108, HR + 0.32, -0.95)) -- 테 밖으로 나온 갈비 끝
	S("Hatch", rim(-104, HR - 0.05, -0.9), rim(-100, HR + 0.28, -0.95))
	S("Hatch", rim(236, HR - 0.05, -0.9), rim(232, HR + 0.25, -0.95))
	-- 목 막대 → 해치 뒤에 눌린 머리: 턱만 테 아래로 처져 나온다 + 젖은 머리카락 2가닥
	chain("NeckRod", { P(0, 5.0, 0.0), P(0, 4.3, -0.45), P(0, 3.0, -0.62) })
	chain("NeckRod", { P(-0.34, 2.75, -0.78), P(-0.22, 2.12, -0.86), P(0.02, 1.98, -0.9), P(0.24, 2.14, -0.86), P(0.34, 2.72, -0.78) })
	S("NeckRod", P(-0.12, 2.22, -0.92), P(0.12, 2.25, -0.92)) -- 다문 입
	S("NeckRod", P(-0.4, 2.6, -0.7), P(-0.5, 1.55, -0.72))
	S("NeckRod", P(0.38, 2.55, -0.7), P(0.44, 1.75, -0.7))
	-- 팔: 쇄골 → 팔꿈치(테 옆, 3·9시보다 낮게) → 손목(4~5시, 7~8시 테 앞) → 손가락 4개(길이·각도 다르게, 한 마디 꺾임)
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local sh, el, wr = P(0.82 * s, 4.75, 0.12), P(2.5 * s, 4.05, -0.3), P(1.72 * s, 2.86, -1.12)
		limb("UpperArm" .. n, sh, el, 0.16, 0.2, 0.1, Vector3.new(0, 0.7, 0.7))
		limb("Forearm" .. n, el, wr, 0.11, 0.15, 0.08, Vector3.new(0, 0.6, -0.8))
		for f = 0, 3 do
			local base = rim(180 - s * (118 + f * 9), HR + 0.06, -1.24)
			local len = ({ 0.42, 0.52, 0.48, 0.36 })[f + 1]
			local inward = (HC - base) * Vector3.new(1, 1, 0)
			local mid = base + inward.Unit * (len * 0.62) + Vector3.new(0, 0, -0.02)
			S("RimGrip" .. n, wr + (base - wr) * 0.2, base)
			S("RimGrip" .. n, base, mid + inward.Unit:Cross(Vector3.zAxis) * (0.05 * s))
		end
	end
	-- 다리: 길고 마른 다리, 깊게 굽은 무릎(짐꾼 하중), 맨발 + 발가락
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local hip, knee, ankle = P(0.36 * s, 3.0, 0.32), P(0.4 * s, 1.55, -0.58), P(0.34 * s, 0.3, 0.18)
		limb("Thigh" .. n, hip, knee, 0.2, 0.22, 0.1, Vector3.new(0.6 * s, 0, 0.8))
		limb("Shin" .. n, knee, ankle, 0.1, 0.13, 0.06, Vector3.new(0.6 * s, 0, 0.8))
		S("Shin" .. n, knee + Vector3.new(0, 0.12, -0.12), knee + Vector3.new(0, -0.2, -0.12)) -- 무릎뼈
		chain("Foot" .. n, { ankle + Vector3.new(0, -0.05, 0.22), ankle + Vector3.new(0, -0.26, 0.05), ankle + Vector3.new(0, -0.26, -0.52) })
		S("Foot" .. n, ankle + Vector3.new(0, 0.05, 0), ankle + Vector3.new(0, -0.12, -0.52))
		S("Toe" .. n, ankle + Vector3.new(0, -0.24, -0.52), ankle + Vector3.new(0.02 * s, -0.28, -0.82))
	end
	local bones: { Rig.Bone } = {
		{ name = "Pelvis", joint = P(0, 3.0, 0.32), tip = P(0, 3.3, 0.32) },
		{ name = "Spine", parent = "Pelvis", joint = P(0, 3.1, 0.32), tip = P(0, 4.8, 0.05) },
		{ name = "NeckRod", parent = "Spine", joint = P(0, 4.9, 0.0), tip = P(0, 3.0, -0.62) },
		{ name = "Hatch", parent = "NeckRod", joint = P(0, 4.5, -0.82), tip = P(0, 4.5, -1.18) },
		{ name = "HatchRim", parent = "Hatch", joint = P(0, 4.5, -1.0), tip = P(0, 6.65, -1.0) },
		{ name = "EyeSlit", parent = "Hatch", joint = P(0.04, 3.52, -1.0), tip = P(0.04, 3.52, -1.2) },
		{ name = "ClavicleL", parent = "Spine", joint = P(-0.12, 4.85, 0.05), tip = P(-0.82, 4.75, 0.12) },
		{ name = "UpperArmL", parent = "ClavicleL", joint = P(-0.82, 4.75, 0.12), tip = P(-2.5, 4.05, -0.3) },
		{ name = "ForearmL", parent = "UpperArmL", joint = P(-2.5, 4.05, -0.3), tip = P(-1.72, 2.86, -1.12) },
		{ name = "RimGripL", parent = "ForearmL", joint = P(-1.72, 2.86, -1.12), tip = P(-1.5, 3.0, -1.24) },
		{ name = "ClavicleR", parent = "Spine", joint = P(0.12, 4.85, 0.05), tip = P(0.82, 4.75, 0.12) },
		{ name = "UpperArmR", parent = "ClavicleR", joint = P(0.82, 4.75, 0.12), tip = P(2.5, 4.05, -0.3) },
		{ name = "ForearmR", parent = "UpperArmR", joint = P(2.5, 4.05, -0.3), tip = P(1.72, 2.86, -1.12) },
		{ name = "RimGripR", parent = "ForearmR", joint = P(1.72, 2.86, -1.12), tip = P(1.5, 3.0, -1.24) },
	}
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		table.insert(bones, { name = "Thigh" .. n, parent = "Pelvis", joint = P(0.36 * s, 3.0, 0.32), tip = P(0.4 * s, 1.55, -0.58) })
		table.insert(bones, { name = "Shin" .. n, parent = "Thigh" .. n, joint = P(0.4 * s, 1.55, -0.58), tip = P(0.34 * s, 0.3, 0.18) })
		table.insert(bones, { name = "Foot" .. n, parent = "Shin" .. n, joint = P(0.34 * s, 0.3, 0.18), tip = P(0.34 * s, 0.04, -0.52) })
		table.insert(bones, { name = "Toe" .. n, parent = "Foot" .. n, joint = P(0.34 * s, 0.06, -0.52), tip = P(0.36 * s, 0.02, -0.82) })
	end
	Rig.build(model, root, cf, {
		id = "c3h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 1.3,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 돌진 중: 멈칫(0.4초) → 직진. 끝나면 원래 AI 로 돌려준다(소리 난 곳 조사)
function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if not d.chargeAt then
		return false
	end
	if now < d.chargeAt then
		self.hum.WalkSpeed = 0
		self.hum:MoveTo(self.root.Position)
		return true
	end
	local pos = self.root.Position
	local flat = Vector3.new(d.chargeGoal.X - pos.X, 0, d.chargeGoal.Z - pos.Z)
	if now < d.chargeEnd and flat.Magnitude > 2 then
		self.hum.WalkSpeed = CHARGE_SPEED
		self.hum:MoveTo(d.chargeGoal)
		return true
	end
	local heard = d.chargeFrom
	d.chargeAt, d.chargeGoal, d.chargeFrom = nil, nil, nil
	self:setState(self.state)
	self.waypoints = {}
	if heard and self.state ~= "Chase" then
		self:investigate(heard)
	end
	return false
end

function M.hear(self: any, pos: Vector3, radius: number, source: Player?, kind: string): boolean
	if kind ~= "Sonar" or not source or self.state == "Chase" then
		return false
	end
	local d = self.cdata
	local now = os.clock()
	local my = self.root.Position
	local to = Vector3.new(pos.X - my.X, 0, pos.Z - my.Z)
	if d.chargeAt or (d.nextCharge and now < d.nextCharge) or to.Magnitude > radius or to.Magnitude < 1 then
		return false
	end
	local dist = math.min(CHARGE_DIST, to.Magnitude + 4)
	d.chargeAt = now + 0.4
	d.chargeEnd = now + 0.4 + dist / CHARGE_SPEED + 0.8
	d.chargeGoal = my + to.Unit * dist
	d.chargeFrom = pos
	d.nextCharge = now + 7
	self.model:SetAttribute("Brace", now)
	return true
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="158">
          <Properties>
            <string name="Name">c3n</string>
            <string name="Source"><![CDATA[--!strict
-- c3n 홍예 (3장 하수도 · 비인간형) — 사양서: roster/v5/ch3/c3n_spec.md
-- 척추뼈 열한 개가 홍예(무지개다리)로 굳은 몸. 양 끝은 손이라 통로 두 벽을 짚고 걸쳐 있고(손목 사이 7),
-- 꼭대기 쐐기돌 자리에는 머리 대신 손 하나가 목뼈 세 마디에 매달려 있다. 바닥을 딛지 않는다.
-- 뼈: Root(아치 전체: 벽-벽 버팀 걸음의 회전·기울기) → Vert01..Vert11 사슬, HandA_Wrist(Vert01)·HandB_Wrist(Vert11),
--     Neck1..3(Vert06) → CrownHand. 다리·골반·머리 없음.
-- 공포 장치 「테 하나 더」: 한동안 배회하면 그 자리에서 아치 테처럼 굳는다(Mimic 속성, 기본 AI 멈춤).
--   굳은 동안 음파 1회는 무시(12 안이면 매달린 손이 움찔 — Reveal 속성), 2회째에 깨어나 10초 쫓는다.
--   그 밑(4.5 안)으로 지나가면 매달린 손이 내려와 붙잡는다(Grab 속성 → 쫓기 + 잡기 거리 3).
-- 라운드 처음 15초와 쫓은 직후에는 배회(기본 AI)라서 게임 흐름·테스트를 막지 않는다.
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 3.3, -- 버팀 걸음 한 주기(0.9초)에 3스터드
	InvestigateSpeed = 6,
	ChaseSpeed = 12, -- 몸 던지기가 섞인 버팀 걸음
	AgentRadius = 1.6,
	AgentHeight = 6,
	CatchDistance = 3, -- 아치 밑(매달린 손이 닿는 곳)
}
M.spawnLift = 2
M.voice = "1" -- (소리: 전용 소리 전까지 '머리 돌 때 뼈 소리' 계열 — 손 짚기 철썩 + 뼈 딱)

local HIP = 1
local FLOOR = -(HIP + 1)
local RC = 3.5 -- 아치 반지름(손목 사이 7)
local CY = 6.9 -- 아치 중심 높이(바닥 기준) → 꼭대기 10.4
local MIMIC_AFTER = 15 -- 배회가 이만큼 이어지면 굳는다
local AWAKE_TIME = 10
local UNDER = 4.5

-- 아치 위의 점: θ(도, 180 = 왼손, 0 = 오른손), 반지름 r, 앞뒤 z
local function A(deg: number, r: number, z: number?): Vector3
	local t = math.rad(deg)
	return Vector3.new(r * math.cos(t), FLOOR + CY + r * math.sin(t), z or 0)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Arch", cf, Vector3.new(1, 2, 1))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local bones: { Rig.Bone } = {}
	local function L(bone: string, a: Vector3, b: Vector3, r: number, red: boolean?)
		-- 음파에서 원통은 한 획(Line)이고, 아주 짧은 것만 원 하나(Disc)다: 획이 원으로 바뀌지 않게 반지름을 길이에 맞춘다
		local len = (b - a).Magnitude
		local disc = len < 0.12
		table.insert(lines, { bone = bone, a = a, b = b, r = if disc then r else math.min(r, len / 4.2), red = red, disc = if disc then true else nil })
	end
	local function bone(name: string, parent: string?, joint: Vector3, tip: Vector3)
		table.insert(bones, { name = name, parent = parent, joint = joint, tip = tip })
	end
	local up = Vector3.new(0, 1, 0)
	bone("Root", nil, Vector3.new(0, FLOOR + CY, 0), A(90, RC))
	-- 척추 11마디: 끝 쪽이 가늘고 가운데가 굵다. 마디마다 둥근 추체(짧고 굵은 원통) + 원판 틈 + 바깥으로 뒤로 휜 가시돌기 + 앞뒤 가로돌기
	local N = 11
	local d0, d1 = 174, 6
	local step = (d0 - d1) / N
	local prev: string = "Root"
	for i = 1, N do
		local name = string.format("Vert%02d", i)
		local a0, a1 = d0 - (i - 1) * step, d0 - i * step
		local am = (a0 + a1) / 2
		local mid = math.abs(i - 6) / 5 -- 0 가운데 → 1 끝
		bone(name, prev, A(a0, RC), A(a1, RC))
		prev = name
		local cr = 0.36 - 0.07 * mid
		-- 인대 한 줄(마디끼리 끊김 없이 잇는 아치 중심선 — 정면에서 보면 테 하나) + 추체 둥근 테(원 하나)
		L(name, A(a0, RC), A(a1, RC), 0.12)
		L(name, A(am + 0.3, RC), A(am - 0.3, RC), cr)
		-- 가시돌기: 아치 바깥(등)으로 솟아 앞으로 휜 뿔, 가운데 마디가 가장 길다
		local spineLen = 0.75 - 0.3 * mid
		local base = A(am, RC + cr * 0.8)
		local tipP = A(am - 5, RC + cr * 0.8 + spineLen, -0.12)
		L(name, base, tipP, 0.08)
		-- 가로돌기: 앞뒤(±z)로 짧게, 끝이 살짝 위로
		for _, s in { -1, 1 } do
			L(name, A(am, RC + 0.05, s * cr * 0.7), A(am + 2, RC + 0.22, s * (cr + 0.38)), 0.06)
		end
	end
	-- 붉은 척수줄: 아치 안쪽(배)에서만, 마디 사이로 세 번 처지는 가는 줄 — 아래에서 올려다볼 때만 보인다
	do
		local idx = { 2, 4, 6, 8, 10 }
		local pts = {}
		for k, i in idx do
			local am = d0 - (i - 0.5) * step
			table.insert(pts, { at = A(am, RC - 0.42), bone = string.format("Vert%02d", i) })
			if k < #idx then
				local am2 = d0 - (i + 1.5) * step
				local sag = A((am + am2) / 2, RC - 0.62)
				table.insert(pts, { at = sag, bone = string.format("Vert%02d", i + 1) })
			end
		end
		for k = 1, #pts - 1 do
			L(pts[k].bone, pts[k].at, pts[k + 1].at, 0.045, true)
		end
	end
	-- 두 끝 손: 손목에서 바깥 아래로 꺾여 손바닥이 벽(x ±4.1)에 붙는다. 손가락 넷이 벽을 따라 부채꼴로 벌어짐
	local function wallHand(boneName: string, parent: string, side: number)
		local wrist = A(if side < 0 then d0 else d1, RC) -- (첫·끝 마디에 바로 이어짐)
		local palm = Vector3.new(side * 4.05, wrist.Y - 0.55, 0)
		bone(boneName, parent, wrist, palm)
		L(boneName, wrist, wrist:Lerp(palm, 0.5) + Vector3.new(side * 0.05, 0, 0), 0.19)
		L(boneName, wrist:Lerp(palm, 0.5) + Vector3.new(side * 0.05, 0, 0), palm, 0.16)
		for f = 1, 4 do
			local ang = math.rad(-40 + (f - 1) * 26) -- 벽면 위에서 손가락 방향(아래 → 앞뒤로 벌림)
			local dir = Vector3.new(0, -math.cos(ang), math.sin(ang))
			local len = if f == 2 or f == 3 then 0.62 else 0.52
			local k1 = palm + dir * len * 0.55 + Vector3.new(side * 0.06, 0, 0)
			local k2 = k1 + dir * len * 0.45 + Vector3.new(side * 0.02, 0, 0)
			L(boneName, palm, k1, 0.065)
			L(boneName, k1, k2, 0.045)
		end
		local th = palm + Vector3.new(-side * 0.1, 0.25, -0.32)
		L(boneName, wrist:Lerp(palm, 0.6), th, 0.06)
		L(boneName, th, th + Vector3.new(side * 0.05, 0.25, -0.18), 0.045)
	end
	wallHand("HandA_Wrist", "Vert01", -1)
	wallHand("HandB_Wrist", "Vert11", 1)
	-- 목뼈 세 마디: 쐐기돌 자리(Vert06 아래)에서 늘어진다
	local top = A(90, RC - 0.4)
	local nPrev = "Vert06"
	local y = top.Y
	for k = 1, 3 do
		local name = "Neck" .. k
		local j = Vector3.new(0, y, 0)
		bone(name, nPrev, j, j - up * 0.36)
		L(name, j - up * 0.05, j - up * 0.27, 0.2 - k * 0.02)
		L(name, j - up * 0.3, j - up * 0.34, 0.16) -- 원판
		nPrev = name
		y -= 0.36
	end
	-- 머리 대신 손: 목뼈에 비틀려 붙은 손목, 손바닥은 아래, 손가락 중 둘은 거꾸로(손등 쪽으로) 꺾였다
	local wj = Vector3.new(0, y, 0)
	local palm = wj + Vector3.new(0.12, -0.5, -0.1)
	bone("CrownHand", "Neck3", wj, palm - up * 0.5)
	L("CrownHand", wj, wj:Lerp(palm, 0.5) + Vector3.new(0.06, 0, 0), 0.17)
	L("CrownHand", wj:Lerp(palm, 0.5) + Vector3.new(0.06, 0, 0), palm, 0.2)
	local fingers = {
		{ d = Vector3.new(-0.26, -0.55, -0.18), bend = Vector3.new(-0.05, -0.32, -0.12) }, -- 엄지
		{ d = Vector3.new(-0.12, -0.6, 0.02), bend = Vector3.new(0, -0.38, 0.12) },
		{ d = Vector3.new(0.02, -0.62, 0.06), bend = Vector3.new(0.02, 0.1, 0.4) }, -- 거꾸로 꺾임
		{ d = Vector3.new(0.16, -0.58, 0.02), bend = Vector3.new(0.05, -0.36, 0.14) },
		{ d = Vector3.new(0.28, -0.48, -0.04), bend = Vector3.new(0.12, 0.12, 0.34) }, -- 거꾸로 꺾임
	}
	for _, f in fingers do
		local k1 = palm + f.d * 0.6
		L("CrownHand", palm, k1, 0.065)
		L("CrownHand", k1, k1 + f.bend * 0.8, 0.045)
	end
	table.insert(balls, { bone = "CrownHand", c = palm, r = 0.22 })
	table.insert(balls, { bone = "Vert06", c = A(90, RC - 0.32), r = 0.3 }) -- 목뼈가 붙는 쐐기돌 마디의 혹
	Rig.build(model, root, cf, {
		id = "c3n",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.7,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

function M.init(self: any)
	local d = self.cdata
	d.mode = "roam"
	d.roamSince = os.clock()
	d.hits = 0
	d.awakeUntil = 0
end

local function wake(self: any, p: Player?, pos: Vector3?)
	local d = self.cdata
	d.mode = "awake"
	d.awakeUntil = os.clock() + AWAKE_TIME
	d.hits = 0
	self.model:SetAttribute("Mimic", false)
	if p and pos then
		self:startChase(p, pos)
	else
		self:setState("Wander")
	end
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if d.mode == "mimic" then
		self.hum:MoveTo(self.root.Position)
		-- 그 밑을 지나가는 사람: 매달린 손이 내려와 붙잡는다
		local my = self.root.Position
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("Status") == "Alive" and not p:GetAttribute("Hidden") then
				local char = p.Character
				local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if r then
					local q = r.Position
					local flat = Vector3.new(q.X - my.X, 0, q.Z - my.Z).Magnitude
					if flat < UNDER and math.abs(q.Y - my.Y) < 8 then
						self.model:SetAttribute("Grab", now)
						wake(self, p, q)
						return false
					end
				end
			end
		end
		return true
	end
	if d.mode == "awake" then
		if now >= d.awakeUntil and self.state ~= "Chase" then
			d.mode = "roam"
			d.roamSince = now
		end
		return false
	end
	-- 배회: 쫓거나 조사하는 동안은 시계를 되돌리고, 배회만 15초 이어지면 그 자리에서 테처럼 굳는다
	if self.state ~= "Wander" then
		d.roamSince = now
	elseif now - d.roamSince > MIMIC_AFTER then
		d.mode = "mimic"
		d.hits = 0
		self.model:SetAttribute("Mimic", true)
		self.hum:MoveTo(self.root.Position)
		return true
	end
	return false
end

-- 음파에 "맞았는가": 파동이 퍼지는 거리(Config.Sonar.Radius 35) 안이고, 가깝거나(12) 사이가 트여 있음
local SONAR_REACH = 35
local function sonarHit(self: any, pos: Vector3, radius: number): boolean
	local d = (pos - self.root.Position).Magnitude
	if d > math.min(radius, SONAR_REACH) then
		return false
	end
	return d < 12 or self:lineOfSight(pos + Vector3.new(0, 1, 0))
end

function M.hear(self: any, pos: Vector3, radius: number, source: Player?, kind: string): boolean
	local d = self.cdata
	if d.mode ~= "mimic" then
		return false
	end
	if kind == "Sonar" and sonarHit(self, pos, radius) then
		d.hits += 1
		if (pos - self.root.Position).Magnitude < 12 then
			self.model:SetAttribute("Reveal", os.clock())
		end
		if d.hits >= 2 then
			wake(self, source, pos)
		end
	end
	return true -- 굳은 동안은 다른 소리에 끌려가지 않는다
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="159">
          <Properties>
            <string name="Name">c4h</string>
            <string name="Source"><![CDATA[--!strict
-- c4h 견인 환자 (4장 폐병원 · 사람형) — 사양서: roster/v5/ch4/c4h_spec.md (+ QA1 수정 지시 반영)
-- 경추 견인을 몇 년 받아 목이 세 마디로 늘어난 채 일어선 환자. 정수리 고리에 묶인 붉은 견인줄이 뒤로 늘어진다.
-- 발끝으로 들린 걸음, 고정틀(일리자로프)을 찬 왼다리는 바깥으로 휘돌려 끈다. 왼손은 앞 기둥을 쥐고, 오른손은 늘어짐.
-- 뼈: pelvis → lumbar → chest → neck1 → neck2 → neck3 → head → crown → cord0 → cord1 → cord2,  head → haloRing,
--      chest → vest, chest → shoulderL/R → elbow → wrist,  pelvis → hipL/R → knee → ankle,  kneeL → fixatorL
-- 공포 장치 「견인줄」(간단판): 지나온 길(최근 약 130 스터드)에 보이지 않는 줄이 남는다.
--   플레이어가 그 줄(발목~가슴 높이)에 닿으면 헤일로가 울리고(Ring, 1.2초 멈춤) 돌아서서 16 으로 감아 당기며 돌진한다.
--   (맵 걸이점·침대 도르래까지 이어지는 실제 줄 표시는 빠짐 — 몸에 붙은 붉은 줄 3마디만 보인다)
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 4.5,
	InvestigateSpeed = 7,
	ChaseSpeed = 7,
	AgentRadius = 1.2,
	AgentHeight = 9,
	CatchDistance = 3,
}
M.spawnLift = 3.2
M.voice = "5" -- (소리: 전용 소리 전까지 — 금속성 걸음 계열)

local HIP = 2
local FLOOR = -(HIP + 1)
local DASH_SPEED = 16
local TRAIL_STEP = 5
local TRAIL_MAX = 26
local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Traction", cf, Vector3.new(1.6, 2, 1.2))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 }, red: boolean?)
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1], red)
		end
	end
	local function limb(bone: string, a: Vector3, b: Vector3, wa: number, wm: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		local m = a:Lerp(b, 0.4)
		for _, k in { -1, 1 } do
			chain(bone, { a + off * (wa * k), m + off * (wm * k), b + off * (wb * k) })
		end
	end
	local function ring(bone: string, c: Vector3, r: number, n: number, phase: number)
		for i = 0, n - 1 do
			local a0, a1 = phase + i * math.pi * 2 / n, phase + (i + 1) * math.pi * 2 / n
			S(bone, c + Vector3.new(math.cos(a0) * r, 0, math.sin(a0) * r), c + Vector3.new(math.cos(a1) * r, 0, math.sin(a1) * r))
		end
	end
	-- 다리: 앙상한 정강이·튀어나온 무릎뼈, 발끝으로 선 발
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local hip, knee, ankle = P(0.32 * s, 4.42, 0), P(0.36 * s, 2.42, -0.2), P(0.36 * s, 0.6, 0.05)
		limb("hip" .. n, hip, knee, 0.2, 0.18, 0.09, Vector3.new(0.7 * s, 0, 0.7))
		limb("knee" .. n, knee, ankle, 0.08, 0.1, 0.05, Vector3.new(0.7 * s, 0, 0.7))
		S("knee" .. n, knee + Vector3.new(0, 0.14, -0.13), knee + Vector3.new(0, -0.18, -0.12)) -- 무릎뼈
		chain("ankle" .. n, { ankle + Vector3.new(0, 0, 0.08), ankle + Vector3.new(0, -0.52, -0.42), ankle + Vector3.new(0, -0.58, -0.7) }) -- 발등 → 발끝
		S("ankle" .. n, ankle + Vector3.new(0, -0.12, 0.12), ankle + Vector3.new(0, -0.56, -0.44)) -- 발바닥(뒤꿈치 들림)
	end
	-- 고정틀(왼 정강이): 고리 2개 + 막대 3개
	local kl = P(-0.36, 2.42, -0.2)
	local fixC = { kl:Lerp(P(-0.36, 0.6, 0.05), 0.25), kl:Lerp(P(-0.36, 0.6, 0.05), 0.75) }
	for _, c in fixC do
		table.insert(lines, { bone = "fixatorL", a = c, b = c + Vector3.new(0, 0.03, 0), r = 0.42, disc = true })
	end
	for i = 0, 2 do
		local t = math.rad(90 + i * 120)
		local o = Vector3.new(math.cos(t) * 0.42, 0, math.sin(t) * 0.42)
		S("fixatorL", fixC[1] + o + Vector3.new(0, 0.25, 0), fixC[2] + o - Vector3.new(0, 0.2, 0))
	end
	-- 환자복: 위가 좁은 사다리꼴(옆선 2 · 끝단 3 · 목둘레 2) + 등 뒤로 처진 끈 2
	for _, s in { -1, 1 } do
		chain("lumbar", { P(0.62 * s, 6.75, 0.02), P(0.75 * s, 5.0, 0.05), P(0.98 * s, 3.0, 0.1) })
		S("chest", P(0.2 * s, 7.05, -0.12), P(0.62 * s, 6.92, 0.0)) -- 목둘레 → 어깨
	end
	chain("pelvis", { P(-0.98, 3.0, 0.1), P(-0.35, 3.15, -0.42), P(0.3, 2.95, -0.4), P(0.98, 3.0, 0.1) })
	S("lumbar", P(-0.15, 5.4, 0.5), P(-0.22, 4.3, 0.62))
	S("lumbar", P(0.12, 5.4, 0.5), P(0.25, 4.6, 0.66))
	-- 쇄골·견갑 나사판(vest) + 헤일로 기둥 4(앞 두 기둥은 얼굴 양옆 바깥으로 벌어짐)
	S("vest", P(-0.62, 7.05, -0.32), P(0.62, 7.05, -0.32))
	S("vest", P(-0.62, 7.05, 0.32), P(0.62, 7.05, 0.32))
	local postTop = {
		P(-0.92, 9.95, -0.55),
		P(0.92, 9.95, -0.55),
		P(-0.7, 9.95, 0.68),
		P(0.7, 9.95, 0.68),
	}
	local postBot = { P(-0.6, 7.05, -0.32), P(0.6, 7.05, -0.32), P(-0.6, 7.05, 0.32), P(0.6, 7.05, 0.32) }
	for i = 1, 4 do
		S("vest", postBot[i], postTop[i])
	end
	-- 목 3마디(가늘고 길게, 마디마다 살짝 앞으로 꺾임)
	local nk = { P(0, 7.05, 0.0), P(0, 8.2, -0.12), P(0, 9.0, -0.05), P(0, 9.62, 0.0) }
	local nw = { 0.17, 0.12, 0.11, 0.12 }
	for i = 1, 3 do
		local bn = "neck" .. i
		for _, k in { -1, 1 } do
			S(bn, nk[i] + Vector3.new(nw[i] * k, 0, 0), nk[i + 1] + Vector3.new(nw[i + 1] * k, 0, 0))
		end
	end
	-- 머리: 길쭉한 머리(옆 외곽 + 앞 외곽), 거즈가 입 자리로 빨려 든 홈
	local hc = P(0, 10.05, -0.05)
	local side = { { 0.0, -0.5 }, { 0.32, -0.42 }, { 0.55, -0.05 }, { 0.4, 0.32 }, { -0.1, 0.42 }, { -0.42, 0.22 }, { -0.5, -0.3 } }
	for i = 1, #side do
		local a, c = side[i], side[i % #side + 1]
		S("head", hc + Vector3.new(0, a[1], a[2]), hc + Vector3.new(0, c[1], c[2]))
	end
	local front = { { 0.0, 0.32 }, { 0.38, 0.28 }, { 0.55, 0.0 }, { 0.3, -0.27 }, { -0.45, -0.18 }, { -0.5, 0.18 } }
	for i = 1, #front do
		local a, c = front[i], front[i % #front + 1]
		S("head", hc + Vector3.new(a[2], a[1], -0.1), hc + Vector3.new(c[2], c[1], -0.1))
	end
	chain("head", { hc + Vector3.new(-0.16, -0.22, -0.46), hc + Vector3.new(0, -0.3, -0.36), hc + Vector3.new(0.15, -0.21, -0.46) }) -- 입 홈
	S("head", hc + Vector3.new(-0.3, -0.05, -0.43), hc + Vector3.new(0.3, -0.08, -0.43)) -- 거즈 띠
	-- 헤일로 고리(8각) + 두개골 핀 4
	local haloC = P(0, 9.95, 0.06)
	ring("haloRing", haloC, 0.98, 8, math.pi / 8)
	for _, t in { 45, 135, 225, 315 } do
		local a = math.rad(t)
		local o = Vector3.new(math.cos(a), 0, math.sin(a))
		S("haloRing", haloC + o * 0.98, haloC + o * 0.5 + Vector3.new(0, 0.12, 0))
	end
	-- 팔: 왼손은 앞 기둥을 쥐고(어깨 → 팔꿈치 아래 → 손이 위로), 오른손은 늘어짐
	limb("shoulderL", P(-0.68, 6.88, 0.0), P(-1.12, 5.55, -0.45), 0.13, 0.14, 0.08, Vector3.new(0, 0.6, 0.8))
	limb("elbowL", P(-1.12, 5.55, -0.45), P(-0.72, 7.6, -0.48), 0.08, 0.1, 0.06, Vector3.new(0.8, 0, 0.6))
	S("wristL", P(-0.72, 7.6, -0.48), P(-0.64, 7.82, -0.58))
	chain("wristL", { P(-0.86, 7.7, -0.58), P(-0.66, 7.85, -0.68), P(-0.5, 7.7, -0.55) }) -- 기둥을 감은 손가락
	limb("shoulderR", P(0.68, 6.88, 0.0), P(0.9, 5.28, 0.12), 0.13, 0.14, 0.08, Vector3.new(0, 0, 1))
	limb("elbowR", P(0.9, 5.28, 0.12), P(0.94, 3.8, -0.06), 0.08, 0.1, 0.06, Vector3.new(0, 0, 1))
	S("wristR", P(0.94, 3.8, -0.06), P(0.97, 3.3, -0.14))
	S("wristR", P(0.92, 3.5, -0.16), P(0.96, 2.95, -0.24))
	S("wristR", P(0.98, 3.5, 0.0), P(1.0, 3.0, 0.02))
	-- 붉은 견인줄: 정수리 → 위 → 뒤로 늘어짐(3마디)
	S("cord0", P(0, 10.6, 0.0), P(0, 11.25, 0.35), true)
	S("cord1", P(0, 11.25, 0.35), P(0, 11.35, 2.4), true)
	S("cord2", P(0, 11.35, 2.4), P(0, 10.2, 4.6), true)
	local bones: { Rig.Bone } = {
		{ name = "pelvis", joint = P(0, 4.42, 0), tip = P(0, 5.0, 0) },
		{ name = "lumbar", parent = "pelvis", joint = P(0, 4.6, 0), tip = P(0, 5.85, 0) },
		{ name = "chest", parent = "lumbar", joint = P(0, 5.85, 0), tip = P(0, 7.05, 0) },
		{ name = "vest", parent = "chest", joint = P(0, 7.05, 0), tip = P(0, 7.33, 0) },
		{ name = "neck1", parent = "chest", joint = P(0, 7.05, 0), tip = P(0, 8.2, -0.12) },
		{ name = "neck2", parent = "neck1", joint = P(0, 8.2, -0.12), tip = P(0, 9.0, -0.05) },
		{ name = "neck3", parent = "neck2", joint = P(0, 9.0, -0.05), tip = P(0, 9.62, 0) },
		{ name = "head", parent = "neck3", joint = P(0, 9.62, 0), tip = P(0, 10.05, 0) },
		{ name = "crown", parent = "head", joint = P(0, 10.55, 0), tip = P(0, 10.6, 0) },
		{ name = "haloRing", parent = "head", joint = P(0, 9.95, 0.06), tip = P(0, 10.07, 0.06) },
		{ name = "cord0", parent = "crown", joint = P(0, 10.6, 0), tip = P(0, 11.25, 0.35) },
		{ name = "cord1", parent = "cord0", joint = P(0, 11.25, 0.35), tip = P(0, 11.35, 2.4) },
		{ name = "cord2", parent = "cord1", joint = P(0, 11.35, 2.4), tip = P(0, 10.2, 4.6) },
		{ name = "shoulderL", parent = "chest", joint = P(-0.68, 6.88, 0), tip = P(-1.12, 5.55, -0.45) },
		{ name = "elbowL", parent = "shoulderL", joint = P(-1.12, 5.55, -0.45), tip = P(-0.72, 7.6, -0.48) },
		{ name = "wristL", parent = "elbowL", joint = P(-0.72, 7.6, -0.48), tip = P(-0.64, 7.82, -0.58) },
		{ name = "shoulderR", parent = "chest", joint = P(0.68, 6.88, 0), tip = P(0.9, 5.28, 0.12) },
		{ name = "elbowR", parent = "shoulderR", joint = P(0.9, 5.28, 0.12), tip = P(0.94, 3.8, -0.06) },
		{ name = "wristR", parent = "elbowR", joint = P(0.94, 3.8, -0.06), tip = P(0.97, 3.0, -0.14) },
	}
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		table.insert(bones, { name = "hip" .. n, parent = "pelvis", joint = P(0.32 * s, 4.42, 0), tip = P(0.36 * s, 2.42, -0.2) })
		table.insert(bones, { name = "knee" .. n, parent = "hip" .. n, joint = P(0.36 * s, 2.42, -0.2), tip = P(0.36 * s, 0.6, 0.05) })
		table.insert(bones, { name = "ankle" .. n, parent = "knee" .. n, joint = P(0.36 * s, 0.6, 0.05), tip = P(0.36 * s, 0.02, -0.7) })
	end
	table.insert(bones, { name = "fixatorL", parent = "kneeL", joint = P(-0.36, 1.97, -0.14), tip = P(-0.36, 1.05, -0.01) })
	Rig.build(model, root, cf, {
		id = "c4h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.9,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 점 p 에서 선분 ab 까지 수평 거리
local function flatDist(p: Vector3, a: Vector3, b: Vector3): number
	local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local ap = Vector3.new(p.X - a.X, 0, p.Z - a.Z)
	local l2 = ab:Dot(ab)
	local t = if l2 > 1e-4 then math.clamp(ap:Dot(ab) / l2, 0, 1) else 0
	return (ap - ab * t).Magnitude
end

function M.init(self: any)
	self.cdata.trail = { self.root.Position }
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	-- 헤일로 울림: 1.2초 멈춤 → 접촉한 사람에게 감아 당기며 돌진
	if d.ringUntil then
		if now < d.ringUntil then
			self.hum.WalkSpeed = 0
			self.hum:MoveTo(self.root.Position)
			return true
		end
		local p, at = d.ringWho, d.ringAt
		d.ringUntil, d.ringWho, d.ringAt = nil, nil, nil
		if p and p.Parent and p:GetAttribute("Status") == "Alive" then
			self.cfg.ChaseSpeed = DASH_SPEED -- (이 괴물만: cfg 는 괴물마다 따로인 표)
			d.dashUntil = now + 3
			self:startChase(p, at)
		else
			self:setState(self.state)
		end
		return false
	end
	if d.dashUntil and now > d.dashUntil then
		d.dashUntil = nil
		self.cfg.ChaseSpeed = nil
		if self.state == "Chase" then
			self:setState("Chase")
		end
	end
	-- 지나온 길에 줄을 남긴다
	local trail: { Vector3 } = d.trail
	local my = self.root.Position
	if (my - trail[#trail]).Magnitude > TRAIL_STEP then
		table.insert(trail, my)
		if #trail > TRAIL_MAX then
			table.remove(trail, 1)
		end
	end
	if self.state == "Chase" or (d.nextRing and now < d.nextRing) or #trail < 4 then
		return false
	end
	-- 줄에 닿았나(몸 가까운 마지막 두 마디는 빼고): 수평 1.1 안, 줄 높이(발목~가슴) 안
	for _, pl in Players:GetPlayers() do
		if pl:GetAttribute("Status") == "Alive" and not pl:GetAttribute("Hidden") then
			local char = pl.Character
			local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then
				local pp = r.Position
				for i = 1, #trail - 3 do
					local a, b = trail[i], trail[i + 1]
					if math.abs(pp.Y - (a.Y + b.Y) / 2) < 4 and flatDist(pp, a, b) < 1.1 then
						d.ringUntil = now + 1.2
						d.ringWho = pl
						d.ringAt = pp
						d.nextRing = now + 8
						self.model:SetAttribute("Ring", now)
						return true
					end
				end
			end
		end
	end
	return false
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="160">
          <Properties>
            <string name="Name">c4n</string>
            <string name="Source"><![CDATA[--!strict
-- c4n 운구대 (4장 폐병원 · 비인간형) — 사양서: roster/v5/ch4/c4n_spec.md
-- 영안실 운반 카트(바퀴 4) 위에 엎드린 채 등 솔기로 하나로 꿰매진 세 구의 몸. 머리는 맨 앞 하나만 남아 카트 앞끝 밖으로
-- 늘어져 바닥을 본다(정수리에 톱 자국 한 줄). 여섯 팔이 카트 양옆으로 늘어져 바닥을 노 젓듯 밀어 카트째 굴러간다.
-- 뒤로는 종아리째 들린 두 발, 왼 엄지발가락에 붉은 영안실 이름표(유일한 붉은 선).
-- 뼈: tray → caster×4 / spine0(뒤 골반) → spine1(뒤 몸) → spine2(가운데 몸) → spine3(앞 몸) → neck → head,
--     sh/el/wr{1..3}{L,R}(spine1..3 마다 팔 한 쌍), shinL/R → footL/R(spine0), tag(footL)
-- 공포 장치 「직선 돌진」: 쫓는 대상이 시야 직선(6~40) 안에 있거나, 직선 안에서 음파·달리기 소리가 나면
--   0.6초 "철썩" 예고(Slap 속성) 뒤 그 방향으로 잠근 채 22로 돌진한다(방향 못 바꿈, 최대 2.6초).
--   막히면(벽) 2초 멈춤(Crash 속성) 뒤 다시 기본 AI. 돌진 사이 3초 쉼.
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 3, -- 물결 젓기(앞 → 가운데 → 뒤)
	InvestigateSpeed = 7,
	ChaseSpeed = 9, -- 직선이 아닐 땐 느리다(조향이 어렵다). 직선에선 돌진 22
	AgentRadius = 1.6,
	AgentHeight = 5,
	CatchDistance = 3.2,
}
M.spawnLift = 2
M.voice = "4" -- (소리: 전용 소리 전까지 '쿵 걸음' 계열 — 손바닥 철썩·카트 덜컹)

local HIP = 1
local FLOOR = -(HIP + 1)
local CHARGE_SPEED = 22
local WINDUP = 0.6
local CRASH_STOP = 2
local REST = 3

-- 시안 좌표(x 옆, y 바닥에서, z 앞 = +) → 루트 기준(앞 = -Z)
local function W(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, -z)
end

local function ik(a: Vector3, c: Vector3, l1: number, l2: number, pole: Vector3): Vector3
	local d = c - a
	local dist = math.clamp(d.Magnitude, 0.05, l1 + l2 - 0.01)
	local dir = d.Unit
	local x = (l1 * l1 - l2 * l2 + dist * dist) / (2 * dist)
	local h = math.sqrt(math.max(0, l1 * l1 - x * x))
	local side = pole - a
	side = side - dir * side:Dot(dir)
	if side.Magnitude < 1e-3 then
		side = Vector3.new(0, 1, 0)
	end
	return a + dir * x + side.Unit * h
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Gurney", cf, Vector3.new(2, 2, 3))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local bones: { Rig.Bone } = {}
	local function L(bone: string, a: Vector3, b: Vector3, r: number, red: boolean?)
		local len = (b - a).Magnitude
		local disc = len < 0.12
		table.insert(lines, { bone = bone, a = a, b = b, r = if disc then r else math.min(r, len / 4.2), red = red, disc = if disc then true else nil })
	end
	local function bone(name: string, parent: string?, joint: Vector3, tip: Vector3)
		table.insert(bones, { name = name, parent = parent, joint = joint, tip = tip })
	end
	local TY, HW, HL, WR = 2.0, 1.15, 3.2, 0.36
	local BY = TY + 0.55 -- 몸 바닥(엎드린 가슴) 높이
	-- ── 카트: 쟁반 테두리 + 다리 4 + 아래 선반 + 바퀴(6각 원 + 바퀴살, 다리 끝 포크에 붙음) ──
	bone("tray", nil, W(0, TY, 0), W(0, TY, 1))
	local c = { W(HW, TY, HL), W(-HW, TY, HL), W(-HW, TY, -HL), W(HW, TY, -HL) }
	for i = 1, 4 do
		L("tray", c[i], c[i % 4 + 1], 0.06)
	end
	local sh = { W(HW - 0.15, 1.0, HL - 0.35), W(-(HW - 0.15), 1.0, HL - 0.35), W(-(HW - 0.15), 1.0, -(HL - 0.35)), W(HW - 0.15, 1.0, -(HL - 0.35)) }
	for i = 1, 4 do
		L("tray", sh[i], sh[i % 4 + 1], 0.05)
	end
	for _, w in { { "casterFL", 1, 1 }, { "casterFR", -1, 1 }, { "casterRL", 1, -1 }, { "casterRR", -1, -1 } } do
		local name, x, z = w[1] :: string, w[2] :: number, w[3] :: number
		local top = W(x * (HW - 0.15), TY - 0.12, z * (HL - 0.35))
		local hub = W(x * (HW - 0.15), WR, z * (HL - 0.35) - 0.18)
		L("tray", top, W(x * (HW - 0.15), 0.62, z * (HL - 0.35)), 0.06) -- 다리
		bone(name, "tray", hub, hub + Vector3.new(0, WR, 0))
		L(name, W(x * (HW - 0.15), 0.62, z * (HL - 0.35)), hub, 0.05) -- 포크
		L(name, hub - Vector3.new(0.05, 0, 0), hub + Vector3.new(0.05, 0, 0), WR) -- 바퀴(원)
		L(name, hub + Vector3.new(0, WR * 0.9, 0), hub - Vector3.new(0, WR * 0.9, 0), 0.03) -- 바퀴살(구름이 보이게)
	end
	-- ── 세 몸: 뒤(spine1, z -1.75) · 가운데(spine2, 0) · 앞(spine3, 1.75). 몸마다 어깨 → 잘록한 허리 → 골반 외곽(양옆),
	--    등줄기 고랑, 솟은 견갑, 몸 사이엔 뒤 몸 골반에 맞닿은 앞 몸의 잘린 목 자리(원) + 가로 솔기 두 줄 ──
	bone("spine0", "tray", W(0, BY + 0.3, -2.95), W(0, BY + 0.3, -1.75))
	local Z3 = { -1.75, 0, 1.75 }
	for k = 1, 3 do
		local zc = Z3[k]
		local name = "spine" .. k
		bone(name, if k == 1 then "spine0" else "spine" .. (k - 1), W(0, BY + 0.4, zc - 1.0), W(0, BY + 0.4, zc + 0.6))
		local prof = { { zc + 0.62, 0.78 }, { zc + 0.2, 1.0 }, { zc - 0.45, 0.66 }, { zc - 1.05, 0.84 }, { zc - 1.38, 0.62 } }
		for _, s in { 1, -1 } do
			for i = 1, #prof - 1 do
				L(name, W(s * prof[i][2], BY + 0.38, prof[i][1]), W(s * prof[i + 1][2], BY + 0.38, prof[i + 1][1]), 0.1)
			end
			-- 솟은 견갑뼈
			L(name, W(s * 0.16, BY + 0.92, zc + 0.42), W(s * 0.6, BY + 0.8, zc - 0.1), 0.08)
		end
		-- 등줄기 고랑: 어깨에서 골반까지
		L(name, W(0, BY + 0.95, zc + 0.55), W(0, BY + 0.72, zc - 1.2), 0.07)
		if k < 3 then
			-- 다음(앞) 몸의 잘린 목 자리 + 가로 솔기 두 줄
			local sz = Z3[k + 1] + 0.72
			L("spine" .. (k + 1), W(0, BY + 0.62, sz + 0.1), W(0, BY + 0.62, sz + 0.16), 0.4)
			for _, dz in { -0.12, 0.08 } do
				L("spine" .. (k + 1), W(0.78, BY + 0.5, sz + dz), W(-0.78, BY + 0.5, sz + dz), 0.05)
			end
		end
	end
	-- ── 목 + 머리: 카트 앞끝 밖으로 꺾여 바닥을 향해 늘어짐. 정수리를 두른 톱 자국 한 줄 ──
	local neckA, neckJ = W(0, BY + 0.55, 2.45), W(0, BY + 0.15, 3.15)
	local headC = W(0.04, BY - 0.85, 3.55)
	bone("neck", "spine3", neckA, neckJ)
	bone("head", "neck", neckJ, headC)
	L("neck", neckA, neckJ, 0.28)
	L("head", neckJ, headC + Vector3.new(0, 0.42, 0), 0.24)
	table.insert(balls, { bone = "head", c = headC, r = 0.44 })
	L("head", headC + Vector3.new(-0.42, 0.1, 0.12), headC + Vector3.new(0.42, 0.1, 0.12), 0.03) -- 톱 자국(옆으로 둘러)
	-- ── 여섯 팔: 어깨(견갑 옆) → 팔꿈치(위로 꺾임) → 손목 → 평평한 손바닥 + 벌린 손가락. 손은 바닥 ──
	for k = 1, 3 do
		local zc = Z3[k]
		for _, s in { 1, -1 } do
			local side = if s > 0 then "L" else "R"
			local shp = W(s * 0.92, BY + 0.02, zc + 0.1)
			local hand = W(s * 2.05, 0.1, zc + 0.15)
			local el = ik(shp, hand, 1.42, 1.36, shp + Vector3.new(s * 0.6, 1, 0.5)) -- (마른 팔: 팔꿈치가 위로 꺾임)
			local hEnd = hand + Vector3.new(s * 0.2, -0.04, -0.4)
			local shN, elN, wrN = "sh" .. k .. side, "el" .. k .. side, "wr" .. k .. side
			bone(shN, "spine" .. k, shp, el)
			bone(elN, shN, el, hand)
			bone(wrN, elN, hand, hEnd)
			L(shN, shp, el, 0.14)
			L(elN, el, hand, 0.11)
			table.insert(balls, { bone = elN, c = el, r = 0.1 })
			-- 손바닥(평평) + 벌린 손가락 둘(바깥·앞)
			L(wrN, hand, hEnd, 0.08)
			L(wrN, hEnd, hEnd + Vector3.new(s * 0.32, -0.02, -0.12), 0.04)
			L(wrN, hEnd, hEnd + Vector3.new(-s * 0.05, -0.02, -0.36), 0.04)
		end
	end
	-- ── 들린 두 발(종아리째) + 왼 엄지발가락의 붉은 이름표(끈 + 종이표 네 변) ──
	for _, f in { { "L", 1 }, { "R", -1 } } do
		local s = f[2] :: number
		local shinJ = W(s * 0.31, BY + 0.15, -3.02)
		local foot = W(s * 1.05, BY + 1.05, -3.85) -- (뒤·바깥으로 벌어져 정면에서 귀처럼 서 보이지 않게)
		local shinN, footN = "shin" .. f[1], "foot" .. f[1]
		bone(shinN, "spine0", shinJ, foot)
		L(shinN, shinJ, foot, 0.16)
		local toe = foot + Vector3.new(s * 0.15, 0.25, 0.85) -- 발가락이 뒤(+Z)·위로: 발바닥이 하늘을 본다
		bone(footN, shinN, foot, toe)
		L(footN, foot, toe, 0.12)
		-- 하늘을 보는 발바닥(뒤꿈치 가로 + 발가락 쪽 가로)
		L(footN, foot + Vector3.new(-0.2, 0.02, 0.05), foot + Vector3.new(0.2, 0.02, 0.05), 0.05)
		L(footN, toe + Vector3.new(-0.24, -0.05, -0.1), toe + Vector3.new(0.24, -0.05, -0.1), 0.05)
	end
	local toe = W(1.05, BY + 1.05, -3.85) + Vector3.new(0.15, 0.25, 0.85)
	local tg = toe + Vector3.new(0.05, -0.85, 0.25)
	bone("tag", "footL", toe, tg)
	L("tag", toe, toe + Vector3.new(0.03, -0.35, 0.12), 0.03, true)
	L("tag", toe + Vector3.new(0.03, -0.35, 0.12), tg, 0.03, true)
	local tp = { tg + Vector3.new(-0.3, 0, 0), tg + Vector3.new(0.3, 0, 0), tg + Vector3.new(0.32, -0.75, 0.08), tg + Vector3.new(-0.28, -0.75, 0.08) }
	for i = 1, 4 do
		L("tag", tp[i], tp[i % 4 + 1], 0.03, true)
	end
	Rig.build(model, root, cf, {
		id = "c4n",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 1.2,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- 예고(철썩 두 번) 시작: 방향은 지금 대상 쪽으로 잠근다
local function windup(self: any, at: Vector3, now: number)
	local d = self.cdata
	local dir = flat(at - self.root.Position)
	if dir.Magnitude < 1 then
		return
	end
	d.mode = "windup"
	d.dir = dir.Unit
	d.modeEnd = now + WINDUP
	self.model:SetAttribute("Slap", now)
	self.hum:MoveTo(self.root.Position + d.dir * 0.3) -- (그쪽을 바라봄)
end

local function finish(self: any, now: number)
	local d = self.cdata
	d.mode = nil
	d.restUntil = now + REST
	self.model:SetAttribute("Charging", false)
	self.waypoints = {}
	self:setState(self.state) -- (상태에 맞는 속도로 되돌림)
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if d.mode == "windup" then
		if now < d.modeEnd then
			self.hum.WalkSpeed = 2
			self.hum:MoveTo(self.root.Position + d.dir * 0.3)
			return true
		end
		d.mode = "charge"
		d.chargeStart = now
		d.modeEnd = now + 2.6
		d.from = self.root.Position
		self.model:SetAttribute("Charging", true)
	end
	if d.mode == "charge" then
		local pos = self.root.Position
		local ahead = pos + d.dir * 3
		local isSafe = self.isSafe
		local vel = flat(self.root.AssemblyLinearVelocity).Magnitude
		if (now - d.chargeStart > 0.4 and vel < 4) or (isSafe and isSafe(ahead)) then
			-- 벽에 박혔다(또는 안전 구역 앞): 2초 멈춤
			d.mode = "crash"
			d.modeEnd = now + CRASH_STOP
			self.model:SetAttribute("Charging", false)
			self.model:SetAttribute("Crash", now)
			self.hum:MoveTo(pos)
			return true
		end
		if now >= d.modeEnd then
			finish(self, now)
			return false
		end
		self.hum.WalkSpeed = CHARGE_SPEED
		self.hum:MoveTo(pos + d.dir * 30)
		return true
	end
	if d.mode == "crash" then
		if now < d.modeEnd then
			self.hum:MoveTo(self.root.Position)
			return true
		end
		finish(self, now)
		return false
	end
	-- 평소: 쫓는 대상이 시야 직선 안이면 돌진
	if self.state == "Chase" and now >= (d.restUntil or 0) then
		local t = self.target
		local char = t and t.Character
		local troot = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if troot and t:GetAttribute("Hidden") ~= true then
			local tp = troot.Position
			local dist = flat(tp - self.root.Position).Magnitude
			if dist > 6 and dist < 40 and math.abs(tp.Y - self.root.Position.Y) < 4 and self:lineOfSight(tp) then
				windup(self, tp, now)
				return true
			end
		end
	end
	return false
end

-- 직선 안에서 음파·달리기 소리: 그쪽을 쫓기 시작하며 곧장 돌진 예고
function M.hear(self: any, pos: Vector3, radius: number, source: Player?, kind: string): boolean
	local d = self.cdata
	if d.mode ~= nil then
		return true -- 돌진·충돌 중엔 다른 소리에 안 끌림
	end
	if not source or (kind ~= "Sonar" and kind ~= "StepRun") then
		return false
	end
	local now = os.clock()
	local dist = flat(pos - self.root.Position).Magnitude
	if dist > radius or dist < 6 or dist > 40 or now < (d.restUntil or 0) then
		return false
	end
	if math.abs(pos.Y - self.root.Position.Y) > 4 or not self:lineOfSight(pos + Vector3.new(0, 1, 0)) then
		return false
	end
	self:startChase(source, pos)
	windup(self, pos, now)
	return true
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="161">
          <Properties>
            <string name="Name">c5h</string>
            <string name="Source"><![CDATA[--!strict
-- c5h 모서리 (5장 심층 미로 · 사람형) — 사양서: roster/v5/ch5/c5h_spec.md (+ QA1 수정 지시 반영)
-- 옆으로 눌려 두께 0.34 의 한 평면(시상면)이 된 키 11 의 사람. 진행 방향(정면)에서 보면 세로선 두 줄 = 미로의 벽 모서리.
-- 옆에서만 얼굴이 썰려 나간 머리(붉은 잘린 가장자리), 갈비 틈 3, 부채처럼 눌린 손이 보인다.
-- 정면 두 줄: 앞 외곽은 x = −0.17, 뒤 외곽은 x = +0.17 에 그려 판 두께만큼 떨어진 세로선 두 줄이 된다.
-- 뼈(사람 리그와 공유 없음, 모든 관절은 X 축 하나): pelvis → spine1 → spine2 → neck → head → crown,
--      spine2 → shoulder → elbowN/F → wristN/F → palmN/F,  pelvis → kneeN/F → ankleN/F → toeN/F  (N = 가까운 쪽, F = 먼 쪽 사슬)
--      (뼈 이름은 사양서처럼 '끝 관절' 이름: kneeN = 허벅지, ankleN = 정강이, toeN = 발)
-- 공포 장치 「선 한 줄」(간단판): 음파에 맞으면 0.25초 만에 쏜 사람 쪽으로 몸을 돌려 칼날(정면 = 선)을 맞춘다(Align).
--   그 뒤 10초 동안(보이는 동안) 그 사람 쪽 직선으로만 다가온다 → 선이 제자리에서 길어지고 출렁일 뿐.
--   (두 사람 사이각 협동 반격·열주실 선호는 빠짐)
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 7,
	InvestigateSpeed = 9,
	ChaseSpeed = 11,
	AgentRadius = 1.2,
	AgentHeight = 10,
	CatchDistance = 2.8,
}
M.spawnLift = 3.2
M.voice = "5" -- (소리: 전용 소리 전까지 — 가벼운 마찰 걸음 계열)

local HIP = 2
local FLOOR = -(HIP + 1)
local T = 0.17 -- 판 두께의 반
local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Edge", cf, Vector3.new(0.8, 2, 1.6))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 })
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1])
		end
	end
	-- 눌린 뼈 판: 관절에서 좁고 사이에서 넓은 외곽 두 줄(앞 = −X 면, 뒤 = +X 면), 직선 위주
	local function slab(bone: string, a: Vector3, b: Vector3, wa: number, wm: number, wb: number)
		local d = (b - a).Unit
		local off = (Vector3.zAxis - d * Vector3.zAxis:Dot(d)).Unit
		local m = a:Lerp(b, 0.45)
		for _, k in { -1, 1 } do
			local x = Vector3.new(k * T, 0, 0)
			chain(bone, { a + off * (wa * k) + x, m + off * (wm * k) + x, b + off * (wb * k) + x })
		end
	end
	-- 몸통 판: 앞 외곽(배·가슴)과 뒤 외곽(굽은 등)
	chain("spine1", { P(-T, 5.85, -0.42), P(-T, 6.9, -0.5) })
	chain("spine2", { P(-T, 6.9, -0.5), P(-T, 7.9, -0.72), P(-T, 8.75, -0.62) })
	chain("pelvis", { P(T, 5.75, 0.45), P(T, 6.9, 0.55) })
	chain("spine2", { P(T, 6.9, 0.55), P(T, 8.0, 0.62), P(T, 8.95, 0.3) })
	S("pelvis", P(-T, 5.85, -0.42), P(T, 5.75, 0.45)) -- 판 밑단
	-- 갈비 틈 3(같은 간격·같은 각도)
	for i = 0, 2 do
		local y = 7.55 + i * 0.32
		S("spine2", P(0, y, -0.55), P(0, y + 0.1, -0.05))
	end
	-- 목: 앞으로 숙여 머리가 늘 아래를 본다
	slab("neck", P(0, 8.85, 0.05), P(0, 9.95, -0.85), 0.2, 0.16, 0.14)
	-- 머리: 옆에서 본 두개골 윤곽, 이마–코 자리가 평평하게 썰려 나간 면(붉은 잘린 가장자리)
	local hd = {
		P(T, 10.05, -0.75),
		P(T, 10.75, -0.55),
		P(T, 11.15, -0.95),
		P(T, 11.2, -1.6),
		P(-T, 10.85, -2.2),
		P(-T, 10.25, -2.35),
	}
	chain("head", hd)
	S("crown", P(-T, 10.25, -2.35), P(-T, 9.75, -1.4), true) -- 썰린 얼굴 가장자리(붉은 선 하나)
	chain("crown", { P(-T, 9.75, -1.4), P(-T, 9.82, -0.95), P(T, 10.05, -0.75) })
	-- 팔(N·F 같은 평면, 서로 0.03 어긋남): 위팔 → 아래팔 판, 부채 손(손바닥 + 손가락 3갈래, 끝이 모임)
	for _, arm in { { "N", -0.03, P(0, 7.75, -0.85), P(0, 6.1, -1.55), P(0, 5.55, -1.85) }, { "F", 0.03, P(0, 7.75, -0.3), P(0, 5.95, -0.42), P(0, 5.36, -0.5) } } do
		local n, dx = arm[1] :: string, arm[2] :: number
		local el, wr, pm = arm[3] :: Vector3, arm[4] :: Vector3, arm[5] :: Vector3
		local sx = Vector3.new(dx, 0, 0)
		slab("elbow" .. n, P(dx, 9.35, -0.5), el + sx, 0.16, 0.2, 0.1)
		slab("wrist" .. n, el + sx, wr + sx, 0.1, 0.15, 0.08)
		chain("palm" .. n, { wr + sx + Vector3.new(0, 0, -0.12), pm + sx + Vector3.new(0, 0, -0.18) })
		chain("palm" .. n, { wr + sx + Vector3.new(0, 0, 0.1), pm + sx + Vector3.new(0, 0, 0.08) })
		for f = -1, 1 do
			S("palm" .. n, pm + sx + Vector3.new(0, 0, f * 0.12), pm + sx + Vector3.new(0, -0.62 + math.abs(f) * 0.1, f * 0.22 - 0.12))
		end
	end
	-- 다리(N·F 같은 평면): 허벅지·정강이 판, 발은 바닥에 눌린 얇은 쐐기(발끝 뾰족)
	for _, lg in { { "N", -0.03 }, { "F", 0.03 } } do
		local n, dx = lg[1] :: string, lg[2] :: number
		local hip, knee, ankle = P(dx, 5.9, 0.05), P(dx, 3.2, -0.3), P(dx, 0.5, 0.05)
		slab("knee" .. n, hip, knee, 0.34, 0.36, 0.14)
		slab("ankle" .. n, knee, ankle, 0.14, 0.2, 0.08)
		chain("toe" .. n, { ankle + Vector3.new(0, 0, 0.3), ankle + Vector3.new(0, -0.45, 0.12), ankle + Vector3.new(0, -0.47, -1.25) }) -- 뒤꿈치 → 발바닥 → 발끝
		S("toe" .. n, ankle + Vector3.new(0, 0.05, -0.08), ankle + Vector3.new(0, -0.45, -1.25)) -- 발등 쐐기
	end
	local bones: { Rig.Bone } = {
		{ name = "pelvis", joint = P(0, 5.9, 0.05), tip = P(0, 6.9, 0.05) },
		{ name = "spine1", parent = "pelvis", joint = P(0, 6.0, 0.05), tip = P(0, 6.9, 0.0) },
		{ name = "spine2", parent = "spine1", joint = P(0, 6.9, 0.0), tip = P(0, 8.75, 0.0) },
		{ name = "neck", parent = "spine2", joint = P(0, 8.85, 0.05), tip = P(0, 9.95, -0.85) },
		{ name = "head", parent = "neck", joint = P(0, 9.95, -0.85), tip = P(0, 10.6, -1.4) },
		{ name = "crown", parent = "head", joint = P(0, 10.4, -1.6), tip = P(0, 10.25, -2.35) },
		{ name = "shoulder", parent = "spine2", joint = P(0, 8.6, -0.2), tip = P(0, 9.35, -0.5) },
		{ name = "elbowN", parent = "shoulder", joint = P(-0.03, 9.35, -0.5), tip = P(-0.03, 7.75, -0.85) },
		{ name = "wristN", parent = "elbowN", joint = P(-0.03, 7.75, -0.85), tip = P(-0.03, 6.1, -1.55) },
		{ name = "palmN", parent = "wristN", joint = P(-0.03, 6.1, -1.55), tip = P(-0.03, 5.55, -1.85) },
		{ name = "elbowF", parent = "shoulder", joint = P(0.03, 9.35, -0.5), tip = P(0.03, 7.75, -0.3) },
		{ name = "wristF", parent = "elbowF", joint = P(0.03, 7.75, -0.3), tip = P(0.03, 5.95, -0.42) },
		{ name = "palmF", parent = "wristF", joint = P(0.03, 5.95, -0.42), tip = P(0.03, 5.36, -0.5) },
	}
	for _, lg in { { "N", -0.03 }, { "F", 0.03 } } do
		local n, dx = lg[1] :: string, lg[2] :: number
		table.insert(bones, { name = "knee" .. n, parent = "pelvis", joint = P(dx, 5.9, 0.05), tip = P(dx, 3.2, -0.3) })
		table.insert(bones, { name = "ankle" .. n, parent = "knee" .. n, joint = P(dx, 3.2, -0.3), tip = P(dx, 0.5, 0.05) })
		table.insert(bones, { name = "toe" .. n, parent = "ankle" .. n, joint = P(dx, 0.5, 0.05), tip = P(dx, 0.03, -1.25) })
	end
	Rig.build(model, root, cf, {
		id = "c5h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.7,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 칼날 맞추기(0.25초 멈춤·회전) → 노출 10초 동안 보이면 직선으로만 다가옴
function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if not d.edgeUntil then
		return false
	end
	local who: Player? = d.edgeWho
	local char = who and who.Character
	local tr = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if now < d.alignUntil then
		self.hum:MoveTo(self.root.Position)
		return true
	end
	if now < d.edgeUntil and tr and who and who:GetAttribute("Status") == "Alive" and not who:GetAttribute("Hidden") then
		local tp = tr.Position
		if self:lineOfSight(tp) then
			if self.state ~= "Chase" then
				self.hum.WalkSpeed = self.cfg.InvestigateSpeed
			end
			self.hum:MoveTo(tp)
			return true
		end
	end
	-- 끝: 보통 AI 로(마지막으로 본 곳 조사)
	local last = if tr then tr.Position else d.edgeFrom
	d.edgeUntil, d.edgeWho, d.edgeFrom = nil, nil, nil
	self.waypoints = {}
	if self.state ~= "Chase" and last then
		self:setState(self.state)
		self:investigate(last)
	end
	return false
end

function M.hear(self: any, pos: Vector3, radius: number, source: Player?, kind: string): boolean
	if kind ~= "Sonar" or not source then
		return false
	end
	local my = self.root.Position
	local to = Vector3.new(pos.X - my.X, 0, pos.Z - my.Z)
	if to.Magnitude > radius or to.Magnitude < 0.5 then
		return false
	end
	local d = self.cdata
	local now = os.clock()
	-- 몸 평면을 쏜 사람의 시선과 나란하게(앞 = −Z 가 그 사람 쪽): 정면에서 선 두 줄만 보인다
	self.root.CFrame = CFrame.lookAt(my, my + to.Unit)
	self.model:SetAttribute("Align", now)
	if self.state == "Chase" then
		return false
	end
	d.alignUntil = now + 0.25
	d.edgeUntil = now + 10
	d.edgeWho = source
	d.edgeFrom = pos
	return true
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="162">
          <Properties>
            <string name="Name">c5n</string>
            <string name="Source"><![CDATA[--!strict
-- c5n 지움 (5장 심층 미로 · 비인간형) — 사양서: roster/v5/ch5/c5n_spec.md (+ QA2 수정 지시 반영)
-- 머리 없는 사람 몸이 가슴을 열어젖힌 채 네 손발로 통로 양벽·바닥을 버티고(굴뚝 오르기) 복도 한가운데 떠서 온다.
-- QA2: 만세(X) 자세 금지 → 팔은 어깨에서 거의 수평으로 양벽을 짚고 팔꿈치는 진행 방향으로 튀어나옴, 다리는 무릎이 벽 쪽으로
--      꺾인 낮은 버팀(가로로 넓고 납작한 H). 갈비 4쌍은 척추에서 바깥·앞으로 휘어 벌어진 갈고리(끝 뾰족), 가운데는 텅 빈 창.
--      비대칭: 왼쪽 갈비가 더 벌어지고 오른쪽 맨 아래 갈비는 꺾여 처짐. 손 = 납작 판 + 갈고리 3, 골반 = 쐐기 판 2.
-- 뼈: Sacrum → Lumbar → Thorax → NeckStump,  Thorax → RibL / RibR(갈비 벌림),  Thorax → UpperArmL/R → ForearmL/R → HandL/R,
--      Sacrum → ThighL/R → ShinL/R → FootL/R   (루트가 골반이 아니라 복도 가운데에 떠 있음)
-- 붉은 선: 열린 가슴 창의 테(닫힌 곡선 하나).
-- 공포 장치 「두 번째 음파」: 첫 음파에 맞으면 선이 하나도 안 생긴다(SonarVeil = true 동안 클라이언트가 몸을 지운다).
--   3.5초 안에 다시 맞아야 10초 동안 드러난다(SonarVeil = false, Exposed 속성). 첫 음파를 맞으면 소리 쪽으로 4초간 ×1.85.
--   (넓은 방 입구에서 멈추기·닫기 연타 탈출은 빠짐 — 기본 AI·기본 잡기 유지)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local SoundBus = require(script.Parent.Parent.SoundBus)
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 2.7,
	InvestigateSpeed = 4,
	ChaseSpeed = 5,
	AgentRadius = 1.6,
	AgentHeight = 7,
	CatchDistance = 2.5,
}
M.spawnLift = 4.2
M.voice = "3" -- (소리: 전용 소리 전까지 — 손톱 톡톡 계열을 짚는 소리로 임시)

local HIP = 3
local FLOOR = -(HIP + 1)
local BOOST = 1.85
local WINDOW = 3.5
local SHOW = 10

local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Erasure", cf, Vector3.new(1.6, 2, 1.4))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 }, red: boolean?)
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1], red)
		end
	end
	-- 가늘어지는 원뿔 마디: 윤곽선 두 줄(밑동 wa → 끝 wb, 가운데 살짝 불룩)
	local function cone(bone: string, a: Vector3, b: Vector3, wa: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		local m = a:Lerp(b, 0.4)
		local wm = wa * 0.6 + wb * 0.4 + 0.03
		for _, k in { -1, 1 } do
			chain(bone, { a + off * (wa * k), m + off * (wm * k), b + off * (wb * k * 0.6) })
		end
	end
	-- 손발: 벽(또는 바닥)에 붙은 납작 판(삼각) + 갈고리 3
	local function paw(bone: string, c: Vector3, n: Vector3, up: Vector3)
		local t = (up - n * up:Dot(n)).Unit
		local s = n:Cross(t)
		local a, b2, c2 = c - t * 0.25 + s * 0.3, c - t * 0.25 - s * 0.3, c + t * 0.5
		chain(bone, { a, b2, c2, a })
		for i = -1, 1 do
			local base = c + t * 0.45 + s * (0.2 * i)
			chain(bone, { base, base + t * 0.45 + s * (0.12 * i) + n * 0.12, base + t * 0.55 + s * (0.14 * i) - n * 0.05 })
		end
	end
	local sacrum, lumbar, thorax = P(0, 4.8, 0.3), P(0, 6.3, 0.62), P(0, 8.2, 0.66)
	local neck, stump = P(0, 9.75, 0.35), P(0, 10.35, 0.05)
	-- 몸통 윤곽(등이 살짝 굽은 통): 좌우 두 줄
	for _, s in { -1, 1 } do
		chain("Lumbar", { P(0.55 * s, 5.0, 0.3), P(0.62 * s, 6.3, 0.5) })
		chain("Thorax", { P(0.62 * s, 6.3, 0.5), P(0.75 * s, 8.2, 0.55), P(1.3 * s, 9.45, 0.35) })
		S("Thorax", P(0.18 * s, 9.6, 0.25), P(1.45 * s, 9.5, 0.35)) -- 쇄골
	end
	-- 척추 가운데 선(창 너머로 보이는 등 안쪽) + 잘린 목
	S("Lumbar", sacrum, lumbar)
	S("Thorax", lumbar, thorax)
	S("Thorax", thorax, neck)
	chain("NeckStump", { P(-0.3, 9.7, 0.4), P(-0.28, 10.35, 0.1) })
	chain("NeckStump", { P(0.3, 9.7, 0.4), P(0.28, 10.35, 0.1) })
	table.insert(lines, { bone = "NeckStump", a = P(0, 10.33, 0.08), b = P(0, 10.4, 0.06), r = 0.32, disc = true }) -- 잘린 단면
	-- 골반: 쐐기 판 2
	for _, s in { -1, 1 } do
		chain("Sacrum", { P(0.15 * s, 5.25, 0.35), P(1.05 * s, 5.0, 0.1), P(0.55 * s, 4.3, -0.15), P(0.15 * s, 5.25, 0.35) })
	end
	-- 붉은 창 테: 갈비 끝 안쪽을 잇는 닫힌 곡선(가운데는 비어 있음)
	local rim: { Vector3 } = {}
	for i = 0, 6 do
		local t = i / 6 * math.pi * 2
		table.insert(rim, P(math.sin(t) * 0.7, 7.75 + math.cos(t) * 1.25, -0.55 - 0.12 * math.cos(t)))
	end
	chain("Thorax", rim, true)
	-- 갈비 4쌍: 척추에서 바깥·앞으로 휘어 벌어진 갈고리(끝 뾰족). 왼쪽이 더 벌어짐, 오른쪽 맨 아래는 꺾여 처짐
	for i, y in { 8.85, 8.3, 7.75, 7.2 } do
		for _, s in { -1, 1 } do
			local bone = if s < 0 then "RibL" else "RibR"
			local open = if s < 0 then 1.3 else 1.0
			local a = P(0.25 * s, y, 0.5)
			local m = P((0.95 + 0.35 * open) * s, y - 0.12, -0.05)
			local tip = P((0.95 + 0.15 * open) * s, y - 0.45, -0.95)
			if s > 0 and i == 4 then
				m = P(1.15, y - 0.2, 0.0)
				tip = P(1.25, y - 0.95, -0.35) -- 부러져 아래로 처짐
			end
			chain(bone, { a, m, tip })
		end
	end
	-- 양옆으로 젖혀진 살가죽(갈비 바깥)
	for _, s in { -1, 1 } do
		local bone = if s < 0 then "RibL" else "RibR"
		local o = if s < 0 then 0.25 else 0
		chain(bone, { P(0.7 * s, 9.15, -0.35), P((1.9 + o) * s, 8.7, -0.15), P((2.0 + o) * s, 7.3, -0.1), P(0.8 * s, 6.75, -0.4) })
	end
	-- 팔: 어깨에서 거의 수평으로 양벽, 팔꿈치는 앞으로. 다리: 무릎이 벽 쪽으로 꺾인 낮은 버팀
	local sh = { L = P(-1.5, 9.5, 0.35), R = P(1.45, 9.45, 0.35) }
	local el = { L = P(-2.75, 9.85, -1.5), R = P(2.8, 9.55, -1.4) }
	local wr = { L = P(-3.95, 9.45, -0.55), R = P(3.95, 9.0, -0.4) }
	local hp = { L = P(-0.85, 4.75, 0.05), R = P(0.85, 4.75, 0.05) }
	local kn = { L = P(-2.7, 3.9, -1.2), R = P(2.15, 2.7, -1.0) }
	local an = { L = P(-3.95, 1.5, -0.5), R = P(2.45, 0.2, -0.6) }
	for _, n in { "L", "R" } do
		local s = if n == "L" then -1 else 1
		cone("UpperArm" .. n, sh[n], el[n], 0.24, 0.16, Vector3.new(0, 1, 0))
		cone("Forearm" .. n, el[n], wr[n], 0.17, 0.12, Vector3.new(0, 1, 0))
		paw("Hand" .. n, wr[n], Vector3.new(-s, 0, 0), Vector3.new(0, 0.5, -1))
		cone("Thigh" .. n, hp[n], kn[n], 0.3, 0.2, Vector3.new(0, 0, 1))
		cone("Shin" .. n, kn[n], an[n], 0.2, 0.13, Vector3.new(0, 0, 1))
	end
	paw("FootL", an.L, Vector3.new(1, 0, 0), Vector3.new(0, -0.3, -1)) -- 왼발 = 벽
	paw("FootR", an.R + Vector3.new(0, -0.15, 0), Vector3.new(0, 1, 0), Vector3.new(0.4, 0, -1)) -- 오른발 = 바닥 모서리
	local bones: { Rig.Bone } = {
		{ name = "Sacrum", joint = sacrum, tip = lumbar },
		{ name = "Lumbar", parent = "Sacrum", joint = sacrum + Vector3.new(0, 0.2, 0), tip = lumbar },
		{ name = "Thorax", parent = "Lumbar", joint = lumbar, tip = thorax },
		{ name = "NeckStump", parent = "Thorax", joint = neck, tip = stump },
		{ name = "RibL", parent = "Thorax", joint = P(-0.25, 8.0, 0.55), tip = P(-1.5, 8.0, -0.6) },
		{ name = "RibR", parent = "Thorax", joint = P(0.25, 8.0, 0.55), tip = P(1.3, 8.0, -0.6) },
	}
	for _, n in { "L", "R" } do
		table.insert(bones, { name = "UpperArm" .. n, parent = "Thorax", joint = sh[n], tip = el[n] })
		table.insert(bones, { name = "Forearm" .. n, parent = "UpperArm" .. n, joint = el[n], tip = wr[n] })
		table.insert(bones, { name = "Hand" .. n, parent = "Forearm" .. n, joint = wr[n], tip = wr[n] + Vector3.new(0, 0.5, -0.6) })
		table.insert(bones, { name = "Thigh" .. n, parent = "Sacrum", joint = hp[n], tip = kn[n] })
		table.insert(bones, { name = "Shin" .. n, parent = "Thigh" .. n, joint = kn[n], tip = an[n] })
		table.insert(bones, { name = "Foot" .. n, parent = "Shin" .. n, joint = an[n], tip = an[n] + Vector3.new(0, -0.1, -0.6) })
	end
	Rig.build(model, root, cf, {
		id = "c5n",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.7,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	model:SetAttribute("SonarVeil", true) -- (클라이언트: true 면 음파에 드러나도 몸을 지운다)
	return model
end

function M.init(self: any)
	self.cdata.lastHit = nil
	self.cdata.boostUntil = 0
	self.cdata.exposedUntil = 0
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if d.exposedUntil > 0 and now > d.exposedUntil then
		d.exposedUntil = 0
		self.model:SetAttribute("SonarVeil", true)
	end
	if now < d.boostUntil then
		local base = if self.state == "Chase" then M.cfg.ChaseSpeed elseif self.state == "Wander" then M.cfg.WanderSpeed else M.cfg.InvestigateSpeed
		self.hum.WalkSpeed = base * BOOST
		d.boosted = true
	elseif d.boosted then
		d.boosted = false
		self:setState(self.state) -- 원래 상태 속도로
	end
	return false
end

-- 음파에 맞았는가(클라이언트 Reveal 과 같은 기준: 반경 + 3 안, 벽 1장 이하)
function M.hear(self: any, pos: Vector3, _radius: number, _source: Player?, kind: string): boolean
	if kind ~= "Sonar" then
		return false
	end
	local my = self.root.Position
	if (pos - my).Magnitude > Config.Sonar.Radius + 3 or SoundBus.wallsBetween(pos, my) > 1 then
		return false
	end
	local d = self.cdata
	local now = os.clock()
	if d.lastHit and now - d.lastHit <= WINDOW then
		-- 두 번째 음파: 10초 동안 드러남
		d.exposedUntil = now + SHOW
		self.model:SetAttribute("SonarVeil", false)
		self.model:SetAttribute("Exposed", now)
	elseif d.exposedUntil == 0 then
		-- 첫 음파: 보이지 않은 채 소리 쪽으로 몸을 틀고 4초간 빨라짐
		self.model:SetAttribute("Veil", now)
		d.boostUntil = now + 4
	end
	d.lastHit = now
	return false -- (소리 쪽 조사는 기본 AI 가)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="163">
          <Properties>
            <string name="Name">c6h</string>
            <string name="Source"><![CDATA[--!strict
-- c6h 등맞댄 손님 (6장 호텔 · 사람형) — 사양서: art/creatures/sheets/ch6/c6h_spec.md (QA1 반영 절이 최신)
-- 등이 붙은 두 투숙객이 골반 하나와 다리 둘을 나눠 쓴다. A 다리는 무릎이 앞(−Z), B 다리는 무릎이 뒤(+Z).
-- 두 척추는 골반에서 갈라져 V(A 는 앞으로, B 는 뒤로 기욺) + 서로 반대로 11° 비틀려 정면에서도 어깨선 4개가 엇갈린다.
-- QA1: 치마 금지 — 가운은 B 몸통·소매만 덮고 골반 위에서 찢긴 단으로 끝남(허벅지·골반이 드러남) · 허리띠 위 두 척추 사이를
--      살 막(꿰맨 세로선 + 가로 땀)이 메움 · 달걀 머리 대신 두개골 공 + 턱 · A 는 젖은 머리카락, B 는 수건 터번 · 무릎은 슬개골.
-- 뼈: Pelvis → ThighA → ShinA → FootA,  Pelvis → ThighB → ShinB → FootB,  Pelvis → Belt(붉은 허리띠),  Pelvis → Web(등 사이 살 막),
--      Pelvis → SpineA → ChestA → NeckA → HeadA,  ChestA → UpperArmAL/AR → ForearmAL/AR,
--      Pelvis → SpineB → ChestB → NeckB → HeadB,  ChestB → UpperArmBL/BR → ForearmBL/BR
-- 붉은 선: 가운 허리띠 고리 + 늘어진 끈(한 덩어리).
-- 공포 장치 「뒤가 없다」: 절대 돌아서지 않는다(AutoRotate 끔). 서버가 몸을 진행 '축'에만 맞추고, 반대로 갈 땐 돌지 않고
--   그대로 반대로 걷는다 — 앞장서는 얼굴이 A ↔ B 로 바뀐다(클라이언트가 진행 방향으로 판단). 감지는 양 끝 모두(기본 AI 감지가
--   전 방향이라 '등 뒤로 몰래 지나가기'가 통하지 않음). (옆 사각·문 알코브 안전·들여다보기는 빠짐 — 기본 AI 안정 우선)
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 5.5,
	InvestigateSpeed = 8,
	ChaseSpeed = 13,
	AgentRadius = 1.2,
	AgentHeight = 7.8,
	CatchDistance = 3,
}
M.spawnLift = 3.6
M.voice = "4" -- (소리: 전용 소리 전까지 — 쿵 걸음 계열)

local HIP = 2.5
local FLOOR = -(HIP + 1)
local TURN = math.rad(25) -- 한 틱(0.1초)에 축을 맞추는 최대 각

local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("BackToBack", cf, Vector3.new(1.4, 2, 1.4))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local bones: { Rig.Bone } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 }, red: boolean?)
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1], red)
		end
	end
	local function cone(bone: string, a: Vector3, b: Vector3, wa: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		for _, k in { -1, 1 } do
			S(bone, a + off * (wa * k), b + off * (wb * k))
		end
	end
	local pelvis = P(0, 3.5, 0)
	table.insert(bones, { name = "Pelvis", joint = pelvis, tip = P(0, 3.95, 0) })
	-- 공유 골반(3차): 앞뒤로 튀어나온 엉덩뼈 쐐기 둘 + 가운데 꿰맨 판(둥근 덩어리 아님)
	for _, k in { -1, 1 } do
		chain("Pelvis", { P(-0.42, 3.78, 0.62 * k), P(0.42, 3.78, 0.62 * k), P(0, 3.18, 0.12 * k), P(-0.42, 3.78, 0.62 * k) })
	end
	S("Pelvis", P(0, 3.7, 0), P(0, 3.16, 0))
	-- 다리 둘: A(왼쪽, 무릎 −Z) · B(오른쪽, 무릎 +Z). A 발 = 슬리퍼, B 발 = 맨발
	for _, L in { { "A", -0.32, -1 }, { "B", 0.32, 1 } } do
		local n, x, kz = L[1] :: string, L[2] :: number, L[3] :: number
		local hip, knee, ankle = P(x, 3.4, 0), P(x * 1.05, 1.75, 0.22 * kz), P(x, 0.2, 0)
		cone("Thigh" .. n, hip, knee, 0.24, 0.16, Vector3.new(1, 0, 0))
		cone("Shin" .. n, knee, ankle, 0.16, 0.09, Vector3.new(1, 0, 0))
		S("Shin" .. n, knee + Vector3.new(0, 0.2, 0.14 * kz), knee + Vector3.new(0, -0.25, 0.12 * kz)) -- 슬개골
		local toe = ankle + Vector3.new(0, -0.18, 0.8 * kz)
		chain("Foot" .. n, { ankle + Vector3.new(0, -0.18, -0.2 * kz), toe, ankle + Vector3.new(0, 0.02, 0.15 * kz) })
		table.insert(bones, { name = "Thigh" .. n, parent = "Pelvis", joint = hip, tip = knee })
		table.insert(bones, { name = "Shin" .. n, parent = "Thigh" .. n, joint = knee, tip = ankle })
		table.insert(bones, { name = "Foot" .. n, parent = "Shin" .. n, joint = ankle, tip = toe })
	end
	-- 상체 둘: 골반에서 갈라져 V. f = 얼굴 쪽(A −1, B +1), tw = 비틀림
	for _, T in { { "A", -1, math.rad(11) }, { "B", 1, -math.rad(11) } } do
		local n, f, tw = T[1] :: string, T[2] :: number, T[3] :: number
		local rot = CFrame.new(pelvis) * CFrame.fromEulerAnglesYXZ(0, tw, math.rad(4)) * CFrame.new(-pelvis)
		local function Q(x: number, y: number, z: number): Vector3
			return rot:PointToWorldSpace(P(x, y, z * f))
		end
		local s0, s1, s2, nk, hd = Q(0, 3.75, 0.15), Q(0, 4.95, 0.42), Q(0, 6.1, 0.72), Q(0, 6.55, 0.85), Q(0, 7.1, 0.95)
		table.insert(bones, { name = "Spine" .. n, parent = "Pelvis", joint = s0, tip = s1 })
		table.insert(bones, { name = "Chest" .. n, parent = "Spine" .. n, joint = s1, tip = s2 })
		table.insert(bones, { name = "Neck" .. n, parent = "Chest" .. n, joint = s2 + (nk - s2) * 0.2, tip = nk })
		table.insert(bones, { name = "Head" .. n, parent = "Neck" .. n, joint = nk, tip = hd })
		-- 배·가슴 옆 외곽(좌우) + 쇄골
		for _, s in { -1, 1 } do
			chain("Spine" .. n, { Q(0.5 * s, 3.85, 0.15), Q(0.5 * s, 4.95, 0.4) })
			S("Chest" .. n, Q(0.5 * s, 4.95, 0.4), Q(0.68 * s, 6.05, 0.7))
		end
		S("Chest" .. n, Q(-0.7, 6.1, 0.75), Q(0.7, 6.1, 0.75))
		-- 목 + 두개골 + 턱(옆얼굴 윤곽)
		S("Neck" .. n, Q(-0.16, 6.15, 0.82), Q(-0.14, 6.65, 0.88))
		S("Neck" .. n, Q(0.16, 6.15, 0.82), Q(0.14, 6.65, 0.88))
		local side, front = {}, {}
		for _, q in { { 0.34, -0.42 }, { 0.56, -0.04 }, { 0.4, 0.32 }, { 0.02, 0.54 }, { -0.24, 0.36 }, { -0.52, 0.34 }, { -0.34, -0.02 }, { -0.12, -0.32 }, { 0.34, -0.42 } } do
			table.insert(side, Q(0, 7.22 + q[1], 0.95 + q[2]))
		end
		for _, q in { { 0, 0.56 }, { 0.33, 0.26 }, { 0.27, -0.12 }, { 0, -0.54 }, { -0.27, -0.12 }, { -0.33, 0.26 }, { 0, 0.56 } } do
			table.insert(front, Q(q[1], 7.22 + q[2], 1.07))
		end
		chain("Head" .. n, side)
		chain("Head" .. n, front)
		if n == "A" then
			-- 젖어 두피에 들러붙은 머리카락(이마·뺨으로)
			for _, x in { -0.25, 0.22 } do
				S("HeadA", Q(x, 7.65, 1.15), Q(x * 1.2, 6.95, 1.36))
			end
		else
			-- 수건 터번 자락
			chain("HeadB", { Q(-0.34, 7.52, 1.25), Q(0, 7.34, 1.45), Q(0.34, 7.2, 1.29) }) -- 흘러내려 눈을 덮음
		end
		-- 팔: A 는 허리 높이로 더듬는 맨팔, B 는 가운 소매에 덮여 늘어짐(해진 지그재그 단)
		for _, s in { -1, 1 } do
			local side = if s < 0 then "L" else "R"
			local ua, fa = "UpperArm" .. n .. side, "Forearm" .. n .. side
			local sh = Q(0.72 * s, 6.0, 0.72)
			local el = if n == "A" then Q(0.85 * s, 4.95, 1.15) else Q(0.82 * s, 4.85, 0.75)
			local wr = if n == "A" then Q(0.55 * s, 4.25, 1.9) else Q(0.78 * s, 3.75, 0.95)
			cone(ua, sh, el, 0.17, 0.12, Q(s, 6, 0.7) - Q(0, 6, 0.7))
			if n == "A" then
				cone(fa, el, wr, 0.12, 0.08, Q(s, 5, 0) - Q(0, 5, 0))
				S(fa, wr, wr + (Q(0.1 * s, 3.85, 2.4) - Q(0, 4.25, 1.9)))
				S(fa, wr, wr + (Q(-0.12 * s, 3.9, 2.35) - Q(0, 4.25, 1.9)))
			else
				cone(fa, el, wr, 0.2, 0.24, Q(s, 5, 0) - Q(0, 5, 0))
				chain(fa, { wr + (Q(0.22 * s, 3.7, 0) - Q(0, 3.75, 0)), wr + (Q(0, 3.55, 0.12) - Q(0, 3.75, 0)), wr + (Q(-0.22 * s, 3.7, 0) - Q(0, 3.75, 0)) })
			end
			table.insert(bones, { name = ua, parent = "Chest" .. n, joint = sh, tip = el })
			table.insert(bones, { name = fa, parent = ua, joint = el, tip = wr })
		end
		if n == "B" then
			-- 가운: 깃 + 골반 위에서 찢긴 단(허벅지는 드러남)
			chain("ChestB", { Q(-0.45, 6.15, 0.95), Q(0, 5.5, 1.05), Q(0.45, 6.15, 0.95) })
			chain("SpineB", { Q(-0.6, 4.0, 0.3), Q(-0.1, 3.8, 0.45), Q(0.2, 4.05, 0.4), Q(0.6, 3.85, 0.3) })
		end
	end
	-- 등 사이 살 막(허리띠 위 V 공간): 윗단 꺾은선 + 꿰맨 세로선 + 가로 땀
	chain("Web", { P(-0.3, 5.6, -0.55), P(0, 5.2, 0), P(0.3, 5.6, 0.55) })
	S("Web", P(0, 3.95, 0), P(0, 5.2, 0))
	S("Web", P(-0.2, 4.4, -0.12), P(0.2, 4.4, 0.12))
	S("Web", P(-0.2, 4.85, -0.15), P(0.2, 4.85, 0.15))
	table.insert(bones, { name = "Web", parent = "Pelvis", joint = P(0, 3.95, 0), tip = P(0, 5.2, 0) })
	-- 붉은 허리띠: 고리 + 늘어진 끈
	table.insert(lines, { bone = "Belt", a = P(0, 3.88, 0), b = P(0, 3.95, 0), r = 0.72, disc = true, red = true })
	chain("Belt", { P(0.68, 3.9, -0.2), P(0.8, 3.3, -0.3), P(0.75, 2.75, -0.25) }, true)
	table.insert(bones, { name = "Belt", parent = "Pelvis", joint = P(0, 3.9, 0), tip = P(0.75, 2.75, -0.25) })
	Rig.build(model, root, cf, {
		id = "c6h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.9,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

function M.init(self: any)
	self.hum.AutoRotate = false -- 돌아서지 않는다
end

-- 몸을 진행 '축'에만 맞춘다: 앞·뒤 중 지금 보는 쪽에 가까운 방향으로(반대로 갈 땐 돌지 않고 그대로 뒷걸음 = B 가 앞장)
function M.tick(self: any, _now: number): boolean
	local v = self.root.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z)
	if flat.Magnitude > 1 then
		local cfr = self.root.CFrame
		local lv = cfr.LookVector
		local look = Vector3.new(lv.X, 0, lv.Z)
		if look.Magnitude > 0.1 then
			look = look.Unit
			local want = flat.Unit
			if want:Dot(look) < 0 then
				want = -want
			end
			local ang = math.acos(math.clamp(want:Dot(look), -1, 1))
			if ang > 0.05 then
				local sgn = if look:Cross(want).Y >= 0 then 1 else -1
				local nl = CFrame.Angles(0, sgn * math.min(ang, TURN), 0):VectorToWorldSpace(look)
				local pos = cfr.Position
				self.root.CFrame = CFrame.lookAt(pos, pos + nl)
			end
		end
	end
	return false
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="164">
          <Properties>
            <string name="Name">c6n</string>
            <string name="Source"><![CDATA[--!strict
-- c6n 도배된 것 (6장 호텔 · 비인간형) — 사양서: art/creatures/sheets/ch6/c6n_spec.md (QA1 반영 절이 최신)
-- 벽지 아래에 납작하게 눌린 앙상한 몸이 머리를 아래로 벽을 기어 내려온다(3차 디자인: c6n_r3.js 의 점을 그대로 옮김, 깊이 ×0.4).
-- 종이는 뼈가 솟은 곳(어깨·팔꿈치·갈비·골반·무릎)에서만 능선이 되고, 벽지 줄 10개는 몸에 닿는 구간에서 끊긴다.
-- 얼굴 = 종이가 입 안으로 빨려 든 구멍 + 콧대 + 꺼진 오른눈 + 왼눈 위 찢긴 틈(붉은 선) 속 눈동자, 손가락은 마디 3 갈고리 4개.
-- 몸은 '오른쪽 벽'(루트 기준 x = +4, 깊이 = −X 쪽으로 튀어나옴)에 만들어 두고, 클라이언트가 레이캐스트로 가까운 벽을 찾아
--   Sheet 뼈를 그 벽 면으로 옮긴다(왼쪽 벽이면 Y 축 180° 뒤집기). 루트(길찾기)는 복도 가운데를 간다.
-- 뼈: Sheet(벽 면 전체·줄무늬) → Spine → Neck → Head → Eye(붉은 틈 + 눈동자), Spine → UpperArmA/B → ForearmA/B → HandA/B(A = 찢고 나온 손),
--      Spine → ThighA/B → KneeA/B(무릎 밀기점)
-- 붉은 선: 왼눈 위의 찢어진 종이 틈.
-- 공포 장치 「벽에 기대지 마라」: 플레이어가 이 괴물이 붙은 벽에서 2.5 안(벽을 따라 ±5 안)에 3초 머물면 Emerge(얼굴·손이 밀려
--   나옴, 클라이언트), 6초면 Burst — 팔이 벽 밖으로 튀어나와 붙잡음(아직 2.8 안이면 잡힘). 복도 가운데(벽에서 3 이상)는 안 닿음 —
--   그래서 기본 잡기 거리는 아주 짧게(1.6). 음파를 맞으면 줄무늬가 움찔(Ripple).
--   (문틀에서 멈추기·모서리 0.6초 정지·맵 전체 벽지 줄은 빠짐 — 길찾기·맵을 건드려야 함)
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 4,
	InvestigateSpeed = 6,
	ChaseSpeed = 8,
	AgentRadius = 1.0,
	AgentHeight = 6,
	CatchDistance = 1.6,
}
M.spawnLift = 3
M.voice = "5" -- (소리: 전용 소리 전까지 — 낮은 숨 계열을 종이 쓸림 대신)

local HIP = 2
local FLOOR = -(HIP + 1)
local W0 = 4 -- 벽 면(루트 기준 x)
local EMERGE, BURST = 3, 6

local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end
-- 벽 면 위의 점: 벽 따라 z, 높이 y, 복도 쪽으로 튀어나온 깊이 dep
local function W(z: number, y: number, dep: number): Vector3
	return P(W0 - dep, y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Papered", cf, Vector3.new(1.2, 2, 1.2))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.04, red = red })
	end
	local function chain(bone: string, pts: { Vector3 }, red: boolean?)
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1], red)
		end
	end
	-- 빌린 벽지 줄 10(간격 1): 몸에 닿는 구간은 끊긴다 — 줄이 빈 자리가 곧 몸
	S("Sheet", W(-4.5, 3, 0.02), W(-4.5, 12, 0.02))
	S("Sheet", W(-3.5, 3, 0.02), W(-3.5, 12, 0.02))
	S("Sheet", W(-2.5, 3, 0.02), W(-2.56, 5.13, 0.02))
	S("Sheet", W(-2.5, 8.88, 0.02), W(-2.5, 12, 0.02))
	S("Sheet", W(-1.51, 3, 0.02), W(-1.58, 6.75, 0.02))
	S("Sheet", W(-1.45, 8.25, 0.02), W(-1.58, 9.5, 0.02))
	S("Sheet", W(-0.57, 10.25, 0.02), W(-0.47, 12, 0.02))
	S("Sheet", W(0.4, 10.88, 0.02), W(0.39, 12, 0.02))
	S("Sheet", W(1.51, 3, 0.02), W(1.52, 6.5, 0.02))
	S("Sheet", W(1.48, 7.75, 0.02), W(1.61, 10.25, 0.02))
	S("Sheet", W(2.5, 3, 0.02), W(2.51, 4.13, 0.02))
	S("Sheet", W(2.49, 7.88, 0.02), W(2.5, 12, 0.02))
	S("Sheet", W(3.5, 3, 0.02), W(3.5, 12, 0.02))
	S("Sheet", W(4.5, 3, 0.02), W(4.5, 12, 0.02))
	-- 머리(거꾸로, 턱이 좁은 해골형): 두개 · 입 · 눈썹뼈 · 콧대 · 꺼진 눈
	chain("Head", { W(0.03, 6.2, 0.28), W(-0.49, 5.46, 0.4), W(-0.9, 5.14, 0.48), W(-0.95, 4.03, 0.34), W(-0.57, 3.63, 0.3), W(-0.03, 3.63, 0.32), W(0.4, 4, 0.4), W(0.68, 4.76, 0.48), W(0.32, 6.13, 0.28) })
	chain("Head", { W(-0.09, 5.86, 0.38), W(-0.25, 5.63, 0.36), W(-0.22, 5.4, 0.4), W(0.21, 5.3, 0.4), W(0.33, 5.49, 0.36), W(0.3, 5.79, 0.38), W(0.13, 5.93, 0.4), W(-0.09, 5.86, 0.38) })
	chain("Head", { W(-0.83, 4.55, 0.48), W(-0.21, 4.45, 0.55), W(0.35, 4.24, 0.48) })
	chain("Head", { W(-0.19, 4.45, 0.54), W(-0.1, 5.12, 0.58) })
	chain("Head", { W(0, 4.67, 0.48), W(0.28, 4.36, 0.4), W(0.47, 4.5, 0.42), W(0.43, 4.73, 0.42), W(0, 4.67, 0.48) })
	-- 붉은 틈(왼눈 위) + 눈동자
	chain("Eye", { W(-0.79, 4.81, 0.46), W(-0.65, 4.61, 0.5), W(-0.29, 4.76, 0.52), W(-0.64, 4.9, 0.49), W(-0.79, 4.81, 0.46) }, true)
	table.insert(balls, { bone = "Eye", c = W(-0.52, 4.75, 0.54), r = 0.07 })
	-- 목 · 몸통 옆 능선 · 갈비 · 골반 V
	chain("Neck", { W(-0.3, 6.4, 0.24), W(-0.4, 5.85, 0.32) })
	chain("Neck", { W(0.3, 6.4, 0.24), W(0.06, 5.85, 0.32) })
	chain("Spine", { W(-0.5, 6.72, 0.24), W(-1.12, 6.82, 0.29), W(-0.86, 8.35, 0.24), W(-0.5, 8.85, 0.16), W(-0.92, 9.4, 0.24) })
	chain("Spine", { W(0.55, 6.7, 0.24), W(1.16, 6.76, 0.29), W(0.9, 8.4, 0.24), W(0.52, 8.85, 0.16), W(0.95, 9.42, 0.24) })
	chain("Spine", { W(-0.88, 7.47, 0.24), W(-0.08, 7.56, 0.25) })
	chain("Spine", { W(0.88, 7.47, 0.24), W(0.12, 7.56, 0.25) })
	chain("Spine", { W(-0.86, 7.99, 0.24), W(-0.08, 8.1, 0.25) })
	chain("Spine", { W(0.86, 7.99, 0.24), W(0.12, 8.1, 0.25) })
	chain("Spine", { W(-0.92, 9.4, 0.24), W(0, 9.95, 0.16), W(0.95, 9.42, 0.24) })
	-- 팔(팔꿈치가 위로 꺾임) · 다리(천장 쪽으로 사라짐)
	chain("UpperArmA", { W(-1.18, 6.8, 0.19), W(-2.45, 8.08, 0.3) })
	chain("ForearmA", { W(-2.45, 8.08, 0.3), W(-2.07, 5.48, 0.27) })
	chain("UpperArmA", { W(-0.72, 7.3, 0.19), W(-2.65, 8.42, 0.3) })
	chain("ForearmA", { W(-2.65, 8.42, 0.3), W(-2.33, 5.42, 0.27) })
	chain("UpperArmB", { W(0.92, 7.33, 0.19), W(2.87, 7.51, 0.3) })
	chain("ForearmB", { W(2.87, 7.51, 0.3), W(2.57, 4.47, 0.24) })
	chain("UpperArmB", { W(1.08, 6.67, 0.19), W(2.63, 7.19, 0.3) })
	chain("ForearmB", { W(2.63, 7.19, 0.3), W(2.33, 4.53, 0.24) })
	chain("ThighA", { W(-0.81, 9.07, 0.16), W(-1.98, 10.67, 0.26) })
	chain("KneeA", { W(-1.98, 10.67, 0.26), W(-1.38, 12.04, 0.06) })
	chain("ThighA", { W(-0.19, 9.63, 0.16), W(-1.52, 10.83, 0.26) })
	chain("KneeA", { W(-1.52, 10.83, 0.26), W(-1.02, 11.86, 0.06) })
	chain("ThighB", { W(0.13, 9.56, 0.16), W(1.01, 11.14, 0.24) })
	chain("KneeB", { W(1.01, 11.14, 0.24), W(0.76, 11.88, 0.06) })
	chain("ThighB", { W(0.91, 9.24, 0.16), W(1.49, 11.06, 0.24) })
	chain("KneeB", { W(1.49, 11.06, 0.24), W(1.14, 12.02, 0.06) })
	-- 손 A(마디 3 갈고리, 종이를 찢고 나옴) · 손 B(종이 아래 능선)
	chain("HandA", { W(-2.42, 5.03, 0.22), W(-2.49, 4.84, 0.54), W(-2.59, 4.5, 0.52), W(-2.67, 4.25, 0.32) })
	chain("HandA", { W(-2.25, 4.98, 0.22), W(-2.27, 4.74, 0.54), W(-2.29, 4.31, 0.52), W(-2.35, 4, 0.32) })
	chain("HandA", { W(-2.08, 4.98, 0.22), W(-2.04, 4.74, 0.54), W(-1.99, 4.3, 0.52), W(-2.04, 3.98, 0.32) })
	chain("HandA", { W(-1.91, 5.03, 0.22), W(-1.82, 4.85, 0.54), W(-1.69, 4.52, 0.52), W(-1.73, 4.28, 0.32) })
	chain("HandB", { W(2.45, 4.5, 0.3), W(2.15, 4.08, 0.32), W(1.87, 3.36, 0.22) })
	chain("HandB", { W(2.32, 4.03, 0.32), W(2.18, 3.13, 0.22) })
	chain("HandB", { W(2.49, 4.03, 0.32), W(2.49, 3.11, 0.22) })
	chain("HandB", { W(2.45, 4.5, 0.3), W(2.66, 4.08, 0.32), W(2.8, 3.39, 0.22) })
	local bones: { Rig.Bone } = {
		{ name = "Sheet", joint = P(0, 7.4, 0), tip = P(W0, 7.4, 0) },
		{ name = "Spine", parent = "Sheet", joint = W(0, 8.6, 0.1), tip = W(0, 6.5, 0.1) },
		{ name = "Neck", parent = "Spine", joint = W(0, 6.5, 0.1), tip = W(-0.1, 5.9, 0.1) },
		{ name = "Head", parent = "Neck", joint = W(-0.1, 5.9, 0.1), tip = W(-0.3, 3.7, 0.1) },
		{ name = "Eye", parent = "Head", joint = W(-0.45, 4.6, 0.1), tip = W(-0.45, 4.5, 0.1) },
		{ name = "UpperArmA", parent = "Spine", joint = W(-0.95, 7.05, 0.1), tip = W(-2.55, 8.25, 0.1) },
		{ name = "ForearmA", parent = "UpperArmA", joint = W(-2.55, 8.25, 0.1), tip = W(-2.2, 5.45, 0.1) },
		{ name = "HandA", parent = "ForearmA", joint = W(-2.2, 5.45, 0.1), tip = W(-2.2, 4.25, 0.1) },
		{ name = "ThighA", parent = "Spine", joint = W(-0.5, 9.35, 0.1), tip = W(-1.75, 10.75, 0.1) },
		{ name = "KneeA", parent = "ThighA", joint = W(-1.75, 10.75, 0.1), tip = W(-1.2, 11.95, 0.1) },
		{ name = "UpperArmB", parent = "Spine", joint = W(1, 7, 0.1), tip = W(2.75, 7.35, 0.1) },
		{ name = "ForearmB", parent = "UpperArmB", joint = W(2.75, 7.35, 0.1), tip = W(2.45, 4.5, 0.1) },
		{ name = "HandB", parent = "ForearmB", joint = W(2.45, 4.5, 0.1), tip = W(2.45, 3.3, 0.1) },
		{ name = "ThighB", parent = "Spine", joint = W(0.52, 9.4, 0.1), tip = W(1.25, 11.1, 0.1) },
		{ name = "KneeB", parent = "ThighB", joint = W(1.25, 11.1, 0.1), tip = W(0.95, 11.95, 0.1) },
	}
	Rig.build(model, root, cf, {
		id = "c6n",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.5,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	model:SetAttribute("Emerge", false)
	return model
end

-- 가까운 벽(좌우 6 안): 면 위의 점과 법선
local function findWall(self: any): (Vector3?, Vector3?)
	local cf = self.root.CFrame
	local from = cf.Position + Vector3.new(0, 1, 0)
	local best: RaycastResult? = nil
	for _, s in { -1, 1 } do
		local hit = workspace:Raycast(from, cf.RightVector * (6 * s), self.rayParams)
		if hit and (not best or hit.Distance < best.Distance) then
			best = hit
		end
	end
	if best then
		return best.Position, best.Normal
	end
	return nil, nil
end

function M.init(self: any)
	self.cdata.near = {}
	self.cdata.nextWall = 0
	self.cdata.last = os.clock()
	self.cdata.emergeOff = 0
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	local dt = math.min(now - d.last, 0.5)
	d.last = now
	if now >= d.nextWall then
		d.nextWall = now + 0.5
		d.wallPos, d.wallN = findWall(self)
	end
	local wp: Vector3?, wn: Vector3? = d.wallPos, d.wallN
	local top, topP, topR = 0, nil :: Player?, nil :: BasePart?
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local t = 0
		if wp and wn and r and p:GetAttribute("Status") == "Alive" and not p:GetAttribute("Hidden") then
			local rel = r.Position - wp
			local along = Vector3.new(wn.Z, 0, -wn.X) -- 벽을 따라
			local lat = (r.Position - self.root.Position):Dot(along)
			if math.abs(rel:Dot(wn)) < 2.5 and math.abs(lat) < 5 and math.abs(rel.Y) < 7 then
				t = (d.near[p] or 0) + dt
			end
		end
		d.near[p] = if t > 0 then t else nil
		if t > top then
			top, topP, topR = t, p, r
		end
	end
	if top >= EMERGE then
		d.emergeOff = 0
		if self.model:GetAttribute("Emerge") ~= true then
			self.model:SetAttribute("Emerge", true)
		end
	elseif self.model:GetAttribute("Emerge") == true then
		d.emergeOff += dt
		if d.emergeOff > 1 then
			self.model:SetAttribute("Emerge", false)
		end
	end
	if top >= BURST and topP and topR and wp and wn then
		-- 팔이 벽 밖으로 2.6 튀어나와 붙잡는다
		d.near[topP] = nil
		self.model:SetAttribute("Burst", now)
		if math.abs((topR.Position - wp):Dot(wn)) < 2.8 then
			self.onCatch(topP, self)
		end
	end
	return false
end

function M.hear(self: any, pos: Vector3, _radius: number, _source: Player?, kind: string): boolean
	if kind == "Sonar" and (pos - self.root.Position).Magnitude < 40 then
		self.model:SetAttribute("Ripple", os.clock())
	end
	return false
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="165">
          <Properties>
            <string name="Name">c7h</string>
            <string name="Source"><![CDATA[--!strict
-- c7h 손든 아이 (7장 학교 · 사람형) — 사양서: roster/v5/ch7/c7h_spec.md (+ QA1 수정 지시 반영)
-- 복도에서 뛰다 걸려 두 손을 머리 위로 든 채 굳은 아이. 팔과 허리만 늘어났고(손끝 11.9), 다리·발·손은 아이 크기.
-- 어깨가 귀 위까지 솟아 머리를 덮어 정면에서는 '머리 없는 몸' — 어깨 골짜기에 머리카락 끝만 보인다.
-- 재킷은 갈비까지 말려 올라가 늘어난 허리(갈비 자국)가 드러나고, 왼팔에 붉은 선도부 완장.
-- 뼈: Pelvis → Spine → Chest → ShoulderShrugL/R → UpperArmL/R(→ ArmbandL) → ForearmL/R,  ForearmL → Clasp(맞댄 두 손 한 뼈),
--      Chest → Jacket,  Chest → NeckDrop → Head,  Pelvis → ThighL/R → ShinL/R → FootL/R → SlipperL/R
-- 공포 장치 「복도에서 뛰지 마라」: 걷기·웅크리기 발소리는 무시한다. 40 안에서 보이는 자리의 누가 달리면(StepRun)
--   0.35초 만에 돌아서서(Turn) 행진 추격. 6 안에서 쏜 음파에도 돌아선다(더 먼 음파는 무시).
--   (교실 문 높이로 못 들어오는 규칙은 길찾기 높이를 바꿔야 해서 빠짐 — 기본 AI 안정 우선)
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 7, -- 플레이어 걷기 10 × 0.7
	InvestigateSpeed = 8,
	ChaseSpeed = 17.1, -- 플레이어 달리기 18 × 0.95
	AgentRadius = 1.2,
	AgentHeight = 8,
	CatchDistance = 3.6,
}
M.spawnLift = 3.2
M.voice = "4" -- (소리: 전용 소리 전까지 — 찰싹 걸음 대신 쿵 걸음 계열)

local HIP = 2
local FLOOR = -(HIP + 1)
local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("RaisedHands", cf, Vector3.new(1.4, 2, 1.0))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 })
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1])
		end
	end
	local function limb(bone: string, a: Vector3, b: Vector3, wa: number, wm: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		local m = a:Lerp(b, 0.45)
		for _, k in { -1, 1 } do
			chain(bone, { a + off * (wa * k), m + off * (wm * k), b + off * (wb * k) })
		end
	end
	-- 다리(짧은 아이 다리, 무릎 거의 폄) + 작은 실내화(밑창·발등·뒤축)
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local hip, knee, ankle = P(0.3 * s, 3.7, 0), P(0.31 * s, 2.0, -0.08), P(0.3 * s, 0.35, 0.02)
		limb("Thigh" .. n, hip, knee, 0.26, 0.25, 0.17, Vector3.new(0.75 * s, 0, 0.65))
		limb("Shin" .. n, knee, ankle, 0.17, 0.18, 0.13, Vector3.new(0.75 * s, 0, 0.65))
		chain("Slipper" .. n, { ankle + Vector3.new(0, -0.32, 0.22), ankle + Vector3.new(0, -0.33, -0.55), ankle + Vector3.new(0, -0.16, -0.75) })
		S("Foot" .. n, ankle + Vector3.new(0, 0.0, -0.05), ankle + Vector3.new(0, -0.15, -0.72))
		S("Slipper" .. n, ankle + Vector3.new(0, -0.3, 0.22), ankle + Vector3.new(0, -0.08, 0.2)) -- 들리는 뒤축
	end
	-- 바지 윗단 + 늘어난 허리(옆선이 끊기지 않게 바지 → 허리 → 재킷 밑단) + 갈비 자국
	S("Pelvis", P(-0.55, 3.95, -0.2), P(0.55, 3.95, -0.2))
	S("Pelvis", P(-0.55, 3.95, -0.2), P(-0.5, 3.4, 0.0))
	for _, s in { -1, 1 } do
		chain("Spine", { P(0.55 * s, 3.95, -0.05), P(0.42 * s, 4.9, -0.02), P(0.5 * s, 5.75, 0.0) })
	end
	for i = 0, 2 do
		local y = 5.0 + i * 0.25
		S("Spine", P(-0.36 + i * 0.02, y, -0.3), P(-0.08, y + 0.12, -0.33))
	end
	-- 재킷(말려 올라감): 밑단 · 옆선 · 지퍼 · 이름표
	S("Jacket", P(-0.62, 5.8, -0.32), P(0.62, 5.75, -0.32))
	S("Jacket", P(-0.62, 5.8, 0.32), P(0.62, 5.78, 0.32))
	for _, s in { -1, 1 } do
		chain("Chest", { P(0.62 * s, 5.78, 0.0), P(0.6 * s, 6.55, 0.0), P(0.7 * s, 7.1, 0.0) })
	end
	S("Chest", P(0.02, 5.8, -0.34), P(0.0, 6.95, -0.32))
	S("Chest", P(0.2, 6.55, -0.33), P(0.46, 6.55, -0.32))
	-- 솟은 어깨: 귀 위까지 올라가 머리를 덮는 덩어리(앞·옆 외곽)
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		chain("ShoulderShrug" .. n, { P(0.12 * s, 7.0, -0.3), P(0.32 * s, 7.75, -0.2), P(0.68 * s, 7.85, 0.0), P(0.74 * s, 7.2, 0.05) })
		S("ShoulderShrug" .. n, P(0.12 * s, 7.0, 0.3), P(0.32 * s, 7.75, 0.2))
	end
	-- 어깨 골짜기 속 머리: 정수리 호 + 머리카락 끝 4가닥만
	chain("Head", { P(-0.2, 7.35, -0.12), P(0, 7.45, -0.16), P(0.2, 7.35, -0.12) })
	for i, x in { -0.15, -0.05, 0.06, 0.16 } do
		S("Head", P(x, 7.42, -0.16), P(x * 1.3, 7.05 - (i % 2) * 0.12, -0.3))
	end
	-- 팔: 들린 어깨에서 곧게 위로, 팔꿈치는 살짝 뒤로 꺾임(과신전)
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local sh, el, wr = P(0.55 * s, 7.6, 0.0), P(0.44 * s, 9.6, 0.16), P(0.14 * s, 11.15, 0.02)
		limb("UpperArm" .. n, sh, el, 0.2, 0.19, 0.13, Vector3.new(0.7 * s, 0, 0.7))
		limb("Forearm" .. n, el, wr, 0.13, 0.15, 0.09, Vector3.new(0.7 * s, 0, 0.7))
	end
	-- 붉은 완장(왼 위팔을 두른 고리 하나)
	table.insert(lines, { bone = "ArmbandL", a = P(-0.51, 8.25, 0.06), b = P(-0.51, 8.28, 0.06), r = 0.23, red = true, disc = true })
	-- 맞댄 두 손(한 덩어리): 손바닥 외곽 + 맞댄 선
	chain("Clasp", { P(-0.16, 11.1, 0.0), P(-0.1, 11.7, 0.0), P(0.0, 11.95, 0.0), P(0.1, 11.7, 0.0), P(0.16, 11.1, 0.0) })
	S("Clasp", P(0, 11.15, -0.02), P(0, 11.85, -0.02))
	local bones: { Rig.Bone } = {
		{ name = "Pelvis", joint = P(0, 3.7, 0), tip = P(0, 4.0, 0) },
		{ name = "Spine", parent = "Pelvis", joint = P(0, 3.9, 0), tip = P(0, 5.75, 0) },
		{ name = "Chest", parent = "Spine", joint = P(0, 5.75, 0), tip = P(0, 7.1, 0) },
		{ name = "Jacket", parent = "Chest", joint = P(0, 6.4, 0), tip = P(0, 5.78, 0) },
		{ name = "NeckDrop", parent = "Chest", joint = P(0, 7.0, 0.05), tip = P(0, 7.2, -0.1) },
		{ name = "Head", parent = "NeckDrop", joint = P(0, 7.2, -0.1), tip = P(0, 7.45, -0.16) },
		{ name = "ShoulderShrugL", parent = "Chest", joint = P(-0.12, 7.0, 0), tip = P(-0.55, 7.6, 0) },
		{ name = "UpperArmL", parent = "ShoulderShrugL", joint = P(-0.55, 7.6, 0), tip = P(-0.44, 9.6, 0.16) },
		{ name = "ArmbandL", parent = "UpperArmL", joint = P(-0.51, 8.25, 0.06), tip = P(-0.5, 8.5, 0.08) },
		{ name = "ForearmL", parent = "UpperArmL", joint = P(-0.44, 9.6, 0.16), tip = P(-0.14, 11.15, 0.02) },
		{ name = "Clasp", parent = "ForearmL", joint = P(0, 11.12, 0.02), tip = P(0, 11.95, 0) },
		{ name = "ShoulderShrugR", parent = "Chest", joint = P(0.12, 7.0, 0), tip = P(0.55, 7.6, 0) },
		{ name = "UpperArmR", parent = "ShoulderShrugR", joint = P(0.55, 7.6, 0), tip = P(0.44, 9.6, 0.16) },
		{ name = "ForearmR", parent = "UpperArmR", joint = P(0.44, 9.6, 0.16), tip = P(0.14, 11.15, 0.02) },
	}
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		table.insert(bones, { name = "Thigh" .. n, parent = "Pelvis", joint = P(0.3 * s, 3.7, 0), tip = P(0.31 * s, 2.0, -0.08) })
		table.insert(bones, { name = "Shin" .. n, parent = "Thigh" .. n, joint = P(0.31 * s, 2.0, -0.08), tip = P(0.3 * s, 0.35, 0.02) })
		table.insert(bones, { name = "Foot" .. n, parent = "Shin" .. n, joint = P(0.3 * s, 0.35, 0.02), tip = P(0.3 * s, 0.05, -0.72) })
		table.insert(bones, { name = "Slipper" .. n, parent = "Foot" .. n, joint = P(0.3 * s, 0.05, 0.2), tip = P(0.3 * s, 0.03, -0.75) })
	end
	Rig.build(model, root, cf, {
		id = "c7h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.8,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 돌아서기(0.35초 멈춤) → 행진 추격
function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if not d.turnUntil then
		return false
	end
	if now < d.turnUntil then
		self.hum:MoveTo(self.root.Position)
		return true
	end
	local p: Player?, at: Vector3? = d.turnWho, d.turnAt
	d.turnUntil, d.turnWho, d.turnAt = nil, nil, nil
	if p and at and p.Parent and p:GetAttribute("Status") == "Alive" then
		self:startChase(p, at)
	end
	return false
end

function M.hear(self: any, pos: Vector3, _radius: number, source: Player?, kind: string): boolean
	if self.state == "Chase" or self.cdata.turnUntil then
		return false
	end
	local dist = (pos - self.root.Position).Magnitude
	local trigger = false
	if kind == "StepWalk" or kind == "StepCrouch" or kind == "StepLand" then
		return true -- 걷기·웅크리기는 무시
	elseif kind == "StepRun" then
		trigger = source ~= nil and dist <= 40 and self:lineOfSight(pos + Vector3.new(0, 2.5, 0))
	elseif kind == "Sonar" then
		if dist > 6 then
			return true -- 먼 음파는 무시
		end
		trigger = source ~= nil
	end
	if not trigger then
		return false
	end
	local now = os.clock()
	self.cdata.turnUntil = now + 0.35
	self.cdata.turnWho = source
	self.cdata.turnAt = pos
	self.model:SetAttribute("Turn", now)
	-- 소리 쪽으로 몸 전체를 홱(판처럼)
	local my = self.root.Position
	local to = Vector3.new(pos.X - my.X, 0, pos.Z - my.Z)
	if to.Magnitude > 0.5 then
		self.root.CFrame = CFrame.lookAt(my, my + to.Unit)
	end
	return true
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="166">
          <Properties>
            <string name="Name">c7n</string>
            <string name="Source"><![CDATA[--!strict
-- c7n 굴렁쇠 (7장 학교 · 비인간형) — 사양서: art/creatures/sheets/ch7/c7n_spec.md
-- 뒤로 접혀 제 발목을 쥔 아이의 몸이 닫힌 고리가 되어 구른다. 걷지 않는다.
-- 뼈: HoopCenter(구름·기울기·회전) 하나가 몸 전체를 움직인다. 선은 고리를 따라 이어진 몸통·다리·팔·머리.
-- 공포 장치 「곧은 복도」: 직선에서 빠르게 굴러오지만, 방향을 바꾸려면 1.8초 동안 쓰러져 돌아야 한다(그동안 멈춤).
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 5,
	InvestigateSpeed = 12,
	ChaseSpeed = 22, -- 플레이어 달리기 18 × 1.2 (직선에서 따라잡힌다)
	AgentRadius = 1.4,
	AgentHeight = 4.5,
	CatchDistance = 2.4,
}
M.spawnLift = 1.2
M.voice = "3" -- (소리: 아직 전용 소리 없음 — 손톱 톡톡 계열을 임시로)

local HIP = 0.98 -- 루트 가운데 높이 = HIP + 1
local FLOOR = -(HIP + 1)
local R = 1.55 -- 몸 중심선 반지름
local CY = FLOOR + 1.98 -- 고리 중심 높이(루트 기준)

-- 고리 위의 점: θ(도, 0 = 바닥 접점, 앞쪽(-Z)으로 증가), 반지름 r, 옆(x)
local function P(deg: number, r: number, x: number): Vector3
	local t = math.rad(deg)
	return Vector3.new(x, CY - r * math.cos(t), -r * math.sin(t))
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Hoop", cf, Vector3.new(1.6, 2, 1.6))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function arc(d0: number, d1: number, n: number, r: number, x: number, w: number, red: boolean?)
		for i = 0, n - 1 do
			local a, b = d0 + (d1 - d0) * i / n, d0 + (d1 - d0) * (i + 1) / n
			table.insert(lines, { bone = "Hoop", a = P(a, r, x), b = P(b, r, x), r = w, red = red })
		end
	end
	-- 몸통(가슴 → 배 → 골반): 바깥이 배, 안쪽이 등. 두께는 어깨 폭 1.2 → 옆 두 선
	arc(30, 200, 8, R, -0.38, 0.2)
	arc(30, 200, 8, R, 0.38, 0.2)
	-- 갈비뼈: 가슴 쪽 몸을 가로지르는 짧은 선
	for _, d in { 48, 62, 76, 90 } do
		table.insert(lines, { bone = "Hoop", a = P(d, R + 0.12, -0.42), b = P(d, R + 0.12, 0.42), r = 0.06 })
	end
	-- 골반
	table.insert(lines, { bone = "Hoop", a = P(196, R + 0.1, -0.48), b = P(196, R + 0.1, 0.48), r = 0.09 })
	-- 다리(허벅지 → 무릎 → 부러진 두 번째 무릎 → 발목): 고리 나머지를 감싼다, 무릎마다 살짝 밖으로 꺾임
	for _, s in { -1, 1 } do
		local x = 0.3 * s
		table.insert(lines, { bone = "Hoop", a = P(200, R, x), b = P(248, R + 0.1, x), r = 0.16 })
		table.insert(lines, { bone = "Hoop", a = P(248, R + 0.1, x), b = P(286, R + 0.22, x * 1.1), r = 0.13 })
		table.insert(lines, { bone = "Hoop", a = P(286, R + 0.22, x * 1.1), b = P(322, R + 0.05, x), r = 0.11 })
		table.insert(lines, { bone = "Hoop", a = P(322, R + 0.05, x), b = P(344, R - 0.05, x * 0.8), r = 0.09 }) -- 발
		table.insert(balls, { bone = "Hoop", c = P(248, R + 0.1, x), r = 0.16 })
		table.insert(balls, { bone = "Hoop", c = P(286, R + 0.22, x * 1.1), r = 0.15 })
		-- 팔: 어깨(가슴 끝)에서 몸 바깥을 돌아 발목을 쥠
		local ax = 0.56 * s
		table.insert(lines, { bone = "Hoop", a = P(34, R + 0.05, ax), b = P(352, R + 0.3, ax * 1.15), r = 0.1 })
		table.insert(lines, { bone = "Hoop", a = P(352, R + 0.3, ax * 1.15), b = P(326, R + 0.12, ax * 0.75), r = 0.09 })
		table.insert(balls, { bone = "Hoop", c = P(352, R + 0.3, ax * 1.15), r = 0.11 })
	end
	-- 거꾸로 된 머리: 고리 아래쪽(두 발 사이), 정수리가 바닥을 스침
	local hc = P(10, R - 0.05, 0)
	table.insert(balls, { bone = "Hoop", c = hc, r = 0.5 })
	table.insert(lines, { bone = "Hoop", a = hc + Vector3.new(-0.18, 0.05, -0.46), b = hc + Vector3.new(-0.08, 0.06, -0.48), r = 0.05 }) -- 눈(거꾸로)
	table.insert(lines, { bone = "Hoop", a = hc + Vector3.new(0.08, 0.06, -0.48), b = hc + Vector3.new(0.18, 0.05, -0.46), r = 0.05 })
	table.insert(lines, { bone = "Hoop", a = hc + Vector3.new(-0.12, 0.25, -0.44), b = hc + Vector3.new(0.12, 0.25, -0.44), r = 0.05 }) -- 벌린 입(거꾸로라 위)
	-- 안쪽 등뼈 7마디: 고리 안쪽으로 박힌 바퀴살
	for i = 0, 6 do
		local d = 40 + i * 24
		table.insert(lines, { bone = "Hoop", a = P(d, R - 0.3, 0), b = P(d, R - 0.85, 0), r = 0.07 })
	end
	-- 붉은 쓸린 줄(가슴·배 앞면, 회전이 보이게)
	arc(60, 170, 4, R + 0.36, 0, 0.05, true)
	Rig.build(model, root, cf, {
		id = "c7n",
		bones = { { name = "Hoop", parent = nil, joint = Vector3.new(0, CY, 0), tip = Vector3.new(0, 0, -1) } },
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.6,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 방향 전환: 진행 방향이 50° 넘게 바뀌면 1.8초 동안 쓰러져 돌기(멈춤). 클라이언트는 Spin 속성으로 동작을 맞춘다
function M.tick(self: any, now: number): boolean
	local d = self.cdata
	if d.spinUntil and now < d.spinUntil then
		self.hum:MoveTo(self.root.Position)
		return true
	end
	local v = self.root.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z)
	if flat.Magnitude > 4 then
		local dir = flat.Unit
		if d.lastDir and d.lastDir:Dot(dir) < math.cos(math.rad(50)) then
			d.spinUntil = now + 1.8
			d.lastDir = nil
			self.model:SetAttribute("Spin", now)
			self.hum:MoveTo(self.root.Position)
			return true
		end
		d.lastDir = dir
	end
	return false
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="167">
          <Properties>
            <string name="Name">c8h</string>
            <string name="Source"><![CDATA[--!strict
-- c8h 눈높이 (8장 폐유치원 · 사람형) — 사양서: roster/v5/ch8/c8h_spec.md (+ QA1 수정 지시 반영)
-- 아이와 눈높이를 맞추려 무릎 꿇은 자세로 굳은 어른 선생님. 무릎으로 걷고, 정강이는 바닥에 끌리고, 발바닥은 위를 본다.
-- 목 2마디가 어깨 앞으로 꺾여 길쭉한 어른 머리가 가슴 앞(어깨보다 낮게)에 매달리고, 얼굴만 들어 올려다본다(무표정).
-- 오른손은 아이 손 높이로 내밀어 손바닥이 위(붉은 크레용 문지른 자국 한 줄), 왼손은 손등으로 바닥을 끈다.
-- 뼈: Pelvis → Spine → NeckBend1 → NeckBend2 → Head → FaceAim,  Spine → UpperArmR/L → ForearmR/L → HandR/L,
--      Pelvis → ThighL/R → KneeContactL/R(접지점) · ShinSkidL/R(끌리는 정강이) → FootUpL/R
-- 공포 장치 「눈높이」: 바닥에서 4 아래에 있는 것만 본다. 서서 걷는 플레이어(머리 4.4~5)는 시선(lineOfSight) 밖이라
--   옆을 지나가도 시야로는 못 알아챈다. 웅크리면(또는 머리가 4 아래면) 보인다. 쫓는 중에는 놓치지 않는다.
--   (기본 감각의 '아주 가까우면(7) 알아챔'은 그대로 — 몸에 닿을 만큼 가까우면 들킨다)
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 2.5,
	InvestigateSpeed = 4,
	ChaseSpeed = 6.5, -- 사양 5 → 웅크려 도망치는 사람(5)을 따라잡게 조금 올림
	AgentRadius = 1.3,
	AgentHeight = 3.5,
	CatchDistance = 2.8,
}
M.spawnLift = 1.6
M.voice = "3" -- (소리: 전용 소리 전까지 — 손톱 톡톡 계열)

local HIP = 0.4
local FLOOR = -(HIP + 1)
local EYE_LIMIT = 4
local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("EyeLevel", cf, Vector3.new(1.6, 2, 1.6))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3, red: boolean?)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05, red = red })
	end
	local function chain(bone: string, pts: { Vector3 })
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1])
		end
	end
	local function limb(bone: string, a: Vector3, b: Vector3, wa: number, wm: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		local m = a:Lerp(b, 0.45)
		for _, k in { -1, 1 } do
			chain(bone, { a + off * (wa * k), m + off * (wm * k), b + off * (wb * k) })
		end
	end
	-- 다리: 허벅지(골반 → 무릎 접지), 바닥에 끌리는 정강이, 위를 향한 발바닥
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local hip, knee, ankle = P(0.34 * s, 1.55, 0.1), P(0.4 * s, 0.16, -0.36), P(0.38 * s, 0.13, 1.0)
		limb("Thigh" .. n, hip, knee, 0.3, 0.3, 0.17, Vector3.new(0.7 * s, 0, 0.7))
		S("KneeContact" .. n, knee + Vector3.new(0, 0.12, -0.16), knee + Vector3.new(0, -0.12, -0.06)) -- 무릎 앞 모서리
		chain("ShinSkid" .. n, { knee + Vector3.new(0, 0.16, 0.05), ankle + Vector3.new(0, 0.12, -0.1) }) -- 정강이 윗선
		chain("ShinSkid" .. n, { knee + Vector3.new(0, -0.13, 0.08), ankle + Vector3.new(0, -0.11, 0) }) -- 바닥에 끌리는 아랫선
		chain("FootUp" .. n, { ankle + Vector3.new(0, 0.12, 0), ankle + Vector3.new(0.02 * s, 0.3, 0.25), ankle + Vector3.new(0.04 * s, 0.14, 0.72) }) -- 위를 향한 발바닥
		S("FootUp" .. n, ankle + Vector3.new(0, -0.1, 0.05), ankle + Vector3.new(0.04 * s, -0.08, 0.72)) -- 바닥에 닿은 발등
	end
	-- 몸통: 둥글게 솟은 등, 배선, 옆선 + 앞치마 앞판 · 허리끈 2
	chain("Spine", { P(0, 1.6, 0.52), P(0, 2.55, 0.42), P(0, 3.25, 0.02), P(0, 3.32, -0.38) })
	chain("Spine", { P(0, 1.55, -0.22), P(0, 2.3, -0.42), P(0, 2.85, -0.62) })
	for _, s in { -1, 1 } do
		chain("Spine", { P(0.48 * s, 1.6, 0.15), P(0.55 * s, 2.5, 0.05), P(0.72 * s, 3.12, -0.35) })
	end
	S("Pelvis", P(-0.5, 1.58, 0.15), P(0.5, 1.58, 0.15))
	chain("Spine", { P(-0.4, 2.7, -0.56), P(-0.45, 1.05, -0.72), P(0.45, 1.05, -0.72), P(0.4, 2.7, -0.56) }) -- 앞치마
	S("Pelvis", P(-0.2, 1.75, 0.5), P(-0.28, 1.15, 0.72))
	S("Pelvis", P(0.15, 1.75, 0.5), P(0.25, 1.25, 0.76))
	-- 목 2마디: 어깨 앞으로 꺾여 내려감(100°)
	chain("NeckBend1", { P(0, 3.15, -0.42), P(0, 3.0, -0.78) })
	chain("NeckBend1", { P(0, 2.9, -0.36), P(0, 2.78, -0.62) })
	chain("NeckBend2", { P(0, 3.0, -0.78), P(0, 2.72, -0.98) })
	-- 머리: 길쭉한 성인 두개골(턱선·광대, 살짝 비대칭) — 옆 외곽 + 앞 외곽
	local hc = P(0.02, 2.42, -1.1)
	local side = { { 0.42, 0.05 }, { 0.3, -0.25 }, { 0.0, -0.36 }, { -0.32, -0.28 }, { -0.5, -0.05 }, { -0.25, 0.3 }, { 0.2, 0.32 } }
	for i = 1, #side do
		local a, c = side[i], side[i % #side + 1]
		S("Head", hc + Vector3.new(0, a[1], a[2]), hc + Vector3.new(0, c[1], c[2]))
	end
	local front = { { 0.42, 0 }, { 0.2, 0.3 }, { -0.15, 0.28 }, { -0.48, 0.1 }, { -0.5, -0.12 }, { -0.12, -0.31 }, { 0.22, -0.28 } }
	for i = 1, #front do
		local a, c = front[i], front[i % #front + 1]
		S("Head", hc + Vector3.new(a[2], a[1], -0.2), hc + Vector3.new(c[2], c[1], -0.2))
	end
	-- 얼굴(무표정): 위 눈꺼풀 2(눈동자는 눈꺼풀에 붙은 작은 점) + 다문 입 1
	S("FaceAim", hc + Vector3.new(-0.26, 0.06, -0.35), hc + Vector3.new(-0.04, 0.08, -0.37))
	S("FaceAim", hc + Vector3.new(0.05, 0.07, -0.37), hc + Vector3.new(0.28, 0.05, -0.35))
	table.insert(balls, { bone = "FaceAim", c = hc + Vector3.new(-0.14, 0.03, -0.37), r = 0.03 })
	table.insert(balls, { bone = "FaceAim", c = hc + Vector3.new(0.15, 0.02, -0.37), r = 0.03 })
	S("FaceAim", hc + Vector3.new(-0.13, -0.3, -0.33), hc + Vector3.new(0.14, -0.31, -0.33))
	-- 오른팔: 앞으로 내밀어 손바닥이 위(마른 성인 팔, 팔꿈치 하나) + 붉은 크레용 자국
	limb("UpperArmR", P(0.68, 3.1, -0.42), P(0.58, 2.25, -1.02), 0.14, 0.15, 0.09, Vector3.new(0.7, 0, 0.7))
	limb("ForearmR", P(0.58, 2.25, -1.02), P(0.38, 1.82, -1.78), 0.09, 0.11, 0.07, Vector3.new(0.6, 0.8, 0))
	chain("HandR", { P(0.24, 1.8, -1.8), P(0.2, 1.78, -2.2), P(0.26, 1.86, -2.48) })
	chain("HandR", { P(0.52, 1.8, -1.8), P(0.5, 1.8, -2.25), P(0.44, 1.88, -2.46) })
	S("HandR", P(0.32, 1.87, -2.0), P(0.36, 1.87, -2.22), true)
	-- 왼팔: 손등으로 바닥을 끈다
	limb("UpperArmL", P(-0.68, 3.1, -0.42), P(-0.88, 1.95, -0.75), 0.14, 0.15, 0.09, Vector3.new(-0.7, 0, 0.7))
	limb("ForearmL", P(-0.88, 1.95, -0.75), P(-0.72, 0.4, -1.05), 0.09, 0.11, 0.07, Vector3.new(-0.7, 0, 0.7))
	chain("HandL", { P(-0.72, 0.4, -1.05), P(-0.7, 0.06, -1.3), P(-0.66, 0.05, -1.75) })
	S("HandL", P(-0.85, 0.08, -1.4), P(-0.84, 0.05, -1.7))
	local bones: { Rig.Bone } = {
		{ name = "Pelvis", joint = P(0, 1.55, 0.1), tip = P(0, 1.85, 0.1) },
		{ name = "Spine", parent = "Pelvis", joint = P(0, 1.6, 0.1), tip = P(0, 3.15, -0.42) },
		{ name = "NeckBend1", parent = "Spine", joint = P(0, 3.15, -0.42), tip = P(0, 3.0, -0.78) },
		{ name = "NeckBend2", parent = "NeckBend1", joint = P(0, 3.0, -0.78), tip = P(0, 2.72, -0.98) },
		{ name = "Head", parent = "NeckBend2", joint = P(0, 2.72, -0.98), tip = P(0.02, 2.42, -1.1) },
		{ name = "FaceAim", parent = "Head", joint = P(0.02, 2.42, -1.1), tip = P(0.02, 2.42, -1.7) },
		{ name = "UpperArmR", parent = "Spine", joint = P(0.68, 3.1, -0.42), tip = P(0.58, 2.25, -1.02) },
		{ name = "ForearmR", parent = "UpperArmR", joint = P(0.58, 2.25, -1.02), tip = P(0.38, 1.82, -1.78) },
		{ name = "HandR", parent = "ForearmR", joint = P(0.38, 1.82, -1.78), tip = P(0.35, 1.85, -2.45) },
		{ name = "UpperArmL", parent = "Spine", joint = P(-0.68, 3.1, -0.42), tip = P(-0.88, 1.95, -0.75) },
		{ name = "ForearmL", parent = "UpperArmL", joint = P(-0.88, 1.95, -0.75), tip = P(-0.72, 0.4, -1.05) },
		{ name = "HandL", parent = "ForearmL", joint = P(-0.72, 0.4, -1.05), tip = P(-0.68, 0.05, -1.72) },
	}
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		table.insert(bones, { name = "Thigh" .. n, parent = "Pelvis", joint = P(0.34 * s, 1.55, 0.1), tip = P(0.4 * s, 0.16, -0.36) })
		table.insert(bones, { name = "KneeContact" .. n, parent = "Thigh" .. n, joint = P(0.4 * s, 0.16, -0.36), tip = P(0.4 * s, -0.06, -0.36) })
		table.insert(bones, { name = "ShinSkid" .. n, parent = "Thigh" .. n, joint = P(0.4 * s, 0.16, -0.36), tip = P(0.38 * s, 0.13, 1.0) })
		table.insert(bones, { name = "FootUp" .. n, parent = "ShinSkid" .. n, joint = P(0.38 * s, 0.13, 1.0), tip = P(0.42 * s, 0.14, 1.72) })
	end
	Rig.build(model, root, cf, {
		id = "c8h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.9,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 이 점(감각이 묻는 플레이어 위치)의 주인이 눈높이(바닥 + 4) 아래에 있나
local function lowEnough(self: any, p: Vector3): boolean
	local floorY = self.root.Position.Y - (HIP + 1)
	for _, pl in Players:GetPlayers() do
		local char = pl.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if char and r and (r.Position - p).Magnitude < 2.5 then
			if char:GetAttribute("MoveMode") == "Crouch" then
				return true
			end
			local head = char:FindFirstChild("Head") :: BasePart?
			local top = if head then head.Position.Y else r.Position.Y + 1.5
			return top - floorY < EYE_LIMIT
		end
	end
	return true
end

function M.init(self: any)
	-- 이 괴물만 시선 판정을 바꾼다(쫓는 중엔 원래대로)
	local orig = self.lineOfSight
	self.lineOfSight = function(me: any, p: Vector3): boolean
		if me.state ~= "Chase" and not lowEnough(me, p) then
			return false
		end
		return orig(me, p)
	end
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="168">
          <Properties>
            <string name="Name">c8n</string>
            <string name="Source"><![CDATA[--!strict
-- c8n 둥글게 (8장 폐유치원 · 비인간형) — 사양서: roster/v5/ch8/c8n_spec.md
-- 머리 없는 성인 어깨 여섯(잘린 목 그루터기 + 빗장뼈 + 윗가슴 조각)이 팔 열두 개로 손을 맞잡아 지름 8의 고리를 만든다.
-- 맞잡은 손 다섯 쌍이 바닥을 딛는 발이다. 한 자리만 손이 비어 있고(빈자리 = 너), 그 두 손은 바깥으로 열려 있다 — 왼쪽 손가락이 붉다.
-- 뼈: RingRoot(고리 회전) → Yoke1..6(방사형) → Yoke*_ClavP/M → Arm*{P,M}_Up → Arm*{P,M}_Fore, Clasp1..5(RingRoot 직속 디딤),
--     빈 손 둘만 쥐었다 펴는 손 뼈 Arm6P_Hand·Arm1M_Hand. 머리·척추·다리 없음.
-- 고리는 서버 시계로 초당 25° 돈다(클라이언트와 같은 각도 → 서버가 빈자리 방향을 안다).
-- 공포 장치 「빈 손」: 쫓다가 대상이 고리 안(3.5)에 들어오면 둘러싼 채 대상을 따라 천천히(4) 미끄러지며 반지름을 초당 0.3씩 좁힌다(RingR 속성).
--   2.5 에 닿으면 잡힌다. 고리 밖으로 나가는 길은 빈자리(붉은 손 쪽 틈) 하나 — 거기로 빠지면 1.5초 멈칫, 다른 곳으로 넘으면 팔에 잡힌다.
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 4,
	InvestigateSpeed = 7,
	ChaseSpeed = 11,
	AgentRadius = 1.8, -- 폭 8 고리: 기는 통로(3)는 못 들어간다
	AgentHeight = 4,
	CatchDistance = 0.9, -- (기본 잡기는 거의 안 쓰임 — 실제 잡기는 고리 규칙)
}
M.spawnLift = 2
M.voice = "5" -- (소리: 전용 소리 전까지 '곤충 걸음' 계열 — 매듭 디딤 톡톡)

local HIP = 1
local FLOOR = -(HIP + 1)
local R0 = 4 -- 고리 반지름
local R_MIN = 2.5
local SHRINK = 0.3
local SPIN = math.rad(25) -- 초당 회전(서버 시계)
local SH_Y = 2.35 -- 어깨 높이
local GAP = math.rad(-90) -- 빈자리 가운데(고리 로컬 각)
local GAP_HALF = math.rad(32) -- 빈자리로 빠졌다고 보는 각도 폭

local function dir(a: number): Vector3
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

local function ik(a: Vector3, c: Vector3, l1: number, l2: number, pole: Vector3): Vector3
	local d = c - a
	local dist = math.clamp(d.Magnitude, 0.05, l1 + l2 - 0.01)
	local dd = d.Unit
	local x = (l1 * l1 - l2 * l2 + dist * dist) / (2 * dist)
	local h = math.sqrt(math.max(0, l1 * l1 - x * x))
	local side = pole - a
	side = side - dd * side:Dot(dd)
	if side.Magnitude < 1e-3 then
		side = Vector3.new(0, 1, 0)
	end
	return a + dd * x + side.Unit * h
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Ring", cf, Vector3.new(1.4, 2, 1.4))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local bones: { Rig.Bone } = {}
	local function L(bone: string, a: Vector3, b: Vector3, r: number, red: boolean?)
		local len = (b - a).Magnitude
		local disc = len < 0.12
		table.insert(lines, { bone = bone, a = a, b = b, r = if disc then r else math.min(r, len / 4.2), red = red, disc = if disc then true else nil })
	end
	local function bone(name: string, parent: string?, joint: Vector3, tip: Vector3)
		table.insert(bones, { name = name, parent = parent, joint = joint, tip = tip })
	end
	local up = Vector3.new(0, 1, 0)
	local y0 = FLOOR + SH_Y
	bone("RingRoot", nil, Vector3.new(0, y0, 0), Vector3.new(0, y0, -1))
	-- 맞잡은 손(디딤) 다섯: 두 요크 사이, 바닥
	local claspAt: { Vector3 } = {}
	for k = 1, 5 do
		local a = GAP + math.rad(60 * k)
		local c = dir(a) * R0 + Vector3.new(0, FLOOR + 0.18, 0)
		claspAt[k] = c
		bone("Clasp" .. k, "RingRoot", c, c + up * 0.4)
		-- 겹친 손 하나의 단순 외곽: 손등 덩어리(원) + 손가락 마디가 엇갈린 짧은 선
		table.insert(balls, { bone = "Clasp" .. k, c = c + Vector3.new(0, 0.05, 0), r = 0.22 })
		local t = Vector3.new(-math.sin(a), 0, math.cos(a))
		L("Clasp" .. k, c - t * 0.3 + dir(a) * 0.12, c + t * 0.3 - dir(a) * 0.12, 0.05)
	end
	-- 요크 여섯
	for i = 1, 6 do
		local a = GAP + math.rad(30 + 60 * (i - 1))
		local u, t = dir(a), Vector3.new(-math.sin(a), 0, math.cos(a))
		local yc = u * R0 + Vector3.new(0, y0, 0)
		local yn = "Yoke" .. i
		bone(yn, "RingRoot", yc, yc + up * 0.5)
		-- 잘린 목 그루터기: 짧은 목 + 단면(원)
		local nb = yc + up * 0.08
		L(yn, nb, nb + up * 0.42 + u * 0.05, 0.2)
		L(yn, nb + up * 0.42 + u * 0.05 - up * 0.02, nb + up * 0.44 + u * 0.05, 0.22)
		-- 잘려 나간 윗가슴: 닫힌 상자(인형 몸통)가 아니라 어깨 끝에서 겨드랑이로 떨어지는 삼각근 두 획 + 등의 견갑 두 획(가운데가 낮은 V)
		local sp, sm = yc + t * 0.78 - up * 0.08, yc - t * 0.78 - up * 0.08
		L(yn, sp, sp - up * 0.5 - t * 0.12 + u * 0.05, 0.1)
		L(yn, sm, sm - up * 0.5 + t * 0.12 + u * 0.05, 0.1)
		local back = yc + u * 0.3 - up * 0.55
		L(yn, yc + t * 0.6 + u * 0.22 - up * 0.12, back, 0.06)
		L(yn, yc - t * 0.6 + u * 0.22 - up * 0.12, back, 0.06)
		-- 빗장뼈 둘(목 밑에서 양 어깨 끝으로) = 뼈 ClavP(+t, 다음 요크 쪽)·ClavM(-t)
		for _, s in { { "P", 1, sp }, { "M", -1, sm } } do
			local tag, sg, tipP = s[1] :: string, s[2] :: number, s[3] :: Vector3
			local cn = yn .. "_Clav" .. tag
			bone(cn, yn, nb, tipP)
			L(cn, nb - u * 0.08, tipP, 0.09)
			-- 팔: 어깨 끝 → 팔꿈치(바깥 위로 꺾임) → 손. 빈자리 양옆 팔(6P·1M)은 바깥으로 손을 연다
			local empty = (i == 6 and tag == "P") or (i == 1 and tag == "M")
			local upN, foreN = "Arm" .. i .. tag .. "_Up", "Arm" .. i .. tag .. "_Fore"
			local l1, l2 = 1.31, 1.78
			local hand: Vector3
			if empty then
				l1, l2 = 1.3, 1.12
				hand = dir(GAP - sg * math.rad(13)) * (R0 + 0.9) + Vector3.new(0, FLOOR + 1.35, 0)
			else
				hand = claspAt[if tag == "P" then i else i - 1] + up * 0.05
			end
			local el = ik(tipP, hand, l1, l2, tipP + u * 0.5 + up * 1.2)
			bone(upN, cn, tipP, el)
			bone(foreN, upN, el, hand)
			-- 마른 사람 팔: 위팔·아래팔 한 획씩, 팔꿈치는 꺾임으로만(공 없음)
			L(upN, tipP, el, 0.12)
			L(foreN, el, hand, 0.1)
			if empty then
				-- 빈 손: 손바닥이 바깥을 향해 열리고 손가락 넷 + 엄지가 벌어진다. 왼쪽(6P) 손이 붉다
				local hn = "Arm" .. i .. tag .. "_Hand"
				local out = dir(GAP - sg * math.rad(13))
				local side = Vector3.new(-out.Z, 0, out.X) * sg
				local palm = hand + out * 0.4
				bone(hn, foreN, hand, palm)
				local red = i == 6
				L(hn, hand, palm, 0.09, red)
				for f = 1, 4 do
					local spread = (f - 2.5) * 0.17
					local fd = (out + side * spread + up * (0.12 - math.abs(spread) * 0.2)).Unit
					L(hn, palm + side * spread * 0.4, palm + side * spread * 0.4 + fd * (if f == 2 or f == 3 then 0.55 else 0.45), 0.04, red)
				end
				L(hn, hand + out * 0.12 - side * 0.12, hand + out * 0.3 - side * 0.42 + up * 0.08, 0.04, red) -- 엄지
			end
		end
	end
	Rig.build(model, root, cf, {
		id = "c8n",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.8,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 고리 회전(서버 시계 — 클라이언트와 같은 값)
local function spinNow(): number
	return (workspace:GetServerTimeNow() * SPIN) % (math.pi * 2)
end

local function endRing(self: any)
	local d = self.cdata
	d.ring = false
	self.model:SetAttribute("RingR", R0)
	self:setState(self.state)
end

local function caught(self: any, p: Player, at: Vector3)
	endRing(self)
	self:note("ring closed on " .. p.Name)
	self.onCatch(p, self)
	self.target = nil
	self.searchCenter = at
	self.searchUntil = os.clock() + 9
	self:setState("Search")
	self.waypoints = {}
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	local dt = math.clamp(now - (d.last or now), 0, 0.5)
	d.last = now
	if d.stunUntil then
		if now < d.stunUntil then
			self.hum:MoveTo(self.root.Position)
			return true
		end
		d.stunUntil = nil
		self:setState(self.state)
	end
	local t = self.target
	local char = t and t.Character
	local troot = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local valid = self.state == "Chase" and troot ~= nil and t:GetAttribute("Status") == "Alive" and t:GetAttribute("Hidden") ~= true
	if valid and self.isSafe and self.isSafe(troot.Position) then
		valid = false
	end
	if not d.ring then
		if valid then
			local my = self.root.Position
			local tp = troot.Position
			local flat = Vector3.new(tp.X - my.X, 0, tp.Z - my.Z).Magnitude
			if flat < R0 - 0.5 and math.abs(tp.Y - my.Y) < 5 then
				-- 둘러쌌다
				d.ring = true
				d.r = R0
				self.model:SetAttribute("RingR", R0)
				self:note("ring around " .. t.Name)
			end
		end
		if not d.ring then
			return false
		end
	end
	if not valid then
		endRing(self)
		return false
	end
	local my = self.root.Position
	local tp = troot.Position
	local off = Vector3.new(tp.X - my.X, 0, tp.Z - my.Z)
	local flat = off.Magnitude
	d.r = math.max(R_MIN, d.r - SHRINK * dt)
	if math.abs((self.model:GetAttribute("RingR") or R0) - d.r) > 0.04 then
		self.model:SetAttribute("RingR", d.r)
	end
	self.lastSeen = now
	self.lastKnown = tp
	if flat > d.r + 0.6 then
		-- 고리를 넘어 나갔다: 빈자리(지금 회전한 각도)로 빠졌는가
		local gl = GAP - spinNow()
		local gapW = self.root.CFrame:VectorToWorldSpace(dir(gl))
		local ang = math.acos(math.clamp(off.Unit:Dot(Vector3.new(gapW.X, 0, gapW.Z).Unit), -1, 1))
		if ang < GAP_HALF then
			self:note("slipped out through the gap")
			endRing(self)
			d.stunUntil = now + 1.5
			self.model:SetAttribute("Stun", now)
			self.hum:MoveTo(my)
			return true
		end
		caught(self, t, tp)
		return true
	end
	if d.r <= R_MIN + 0.01 and flat < d.r then
		caught(self, t, tp)
		return true
	end
	-- 둘러싼 채 대상을 따라 천천히 돌며 미끄러진다(가운데에 가까우면 그 자리에서 돌며 좁히기만)
	self.hum.WalkSpeed = 4
	self.hum:MoveTo(if flat > 1.2 then tp else my)
	return true
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="169">
          <Properties>
            <string name="Name">c9h</string>
            <string name="Source"><![CDATA[--!strict
-- c9h 후방감지 (9장 지하 주차장 · 사람형) — 사양서: roster/v5/ch9/c9h_spec.md (+ QA2 수정 지시 반영)
-- 언제나 뒤로 걷는 앙상한 주차요원. 몸은 +Z(얼굴 쪽)를 보고 만들었고, 진행 방향(-Z, 루트의 앞)은 늘 등이다.
-- QA2: 진행 쪽 외곽이 볼록한 C(허리 뒤 = 등이 활처럼 진행 방향으로 내밀림), 얼굴 쪽은 오목하게 꺾인 갈비 ·
--      머리는 어깨 위가 아니라 등 뒤 아래에 거꾸로 매달림(벌린 입 + 눈꺼풀을 가로지르는 비뚤어진 테이프 한 장) ·
--      정강이·무릎은 얼굴 쪽으로 꺾임(진행 쪽에서 보면 역관절) · X 반사띠 없음 — 등뼈에 박힌 센서 원 5개.
-- 뼈: Pelvis → Spine1 → Spine2 → Chest → Neck1 → Neck2 → Head → Jaw,  Chest → UpperArmL/R → ForearmL/R → HandL/R,
--      Pelvis → ThighL/R → ShinL/R → FootL/R   (센서 1~5 는 척추 마디에 박힌 공 — 따로 움직이지 않아 뼈 없이 마디에 붙임)
-- 붉은 선: 센서 3번(등 한가운데).
-- 공포 장치 「후방 감지음」: 등 쪽 140° 부채꼴 · 28 안의 보이는 플레이어를 감지 → 거리 단계(Band 4~1, 클라이언트용)·추격,
--   추격 중 8 안이면 돌진(18). 음파를 맞으면 1.8초 동안 그 자리에서 핸들 꺾듯 돌아선 뒤(Turn) 그쪽을 조사 — 회전이 틈.
--   (얼굴 쪽 사각은 빠짐: 기본 AI 의 가까운 감지는 그대로 — 기본 AI 안정 우선. 삐 소리는 소리 담당이 Band 로)
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 5,
	InvestigateSpeed = 7,
	ChaseSpeed = 9,
	AgentRadius = 1.0,
	AgentHeight = 6.8,
	CatchDistance = 2.8,
}
M.spawnLift = 2.8
M.voice = "2" -- (소리: 전용 소리 전까지 — 끌리는 걸음 계열)

local HIP = 2.6
local FLOOR = -(HIP + 1)
local CHARGE = 18
local FAN = math.cos(math.rad(70))

local function P(x: number, y: number, z: number): Vector3
	return Vector3.new(x, FLOOR + y, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Reverser", cf, Vector3.new(1.4, 2, 1.0))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local function S(bone: string, a: Vector3, b: Vector3)
		table.insert(lines, { bone = bone, a = a, b = b, r = 0.05 })
	end
	local function chain(bone: string, pts: { Vector3 })
		for i = 1, #pts - 1 do
			S(bone, pts[i], pts[i + 1])
		end
	end
	local function cone(bone: string, a: Vector3, b: Vector3, wa: number, wb: number, side: Vector3)
		local d = (b - a).Unit
		local off = (side - d * side:Dot(d)).Unit
		for _, k in { -1, 1 } do
			S(bone, a + off * (wa * k), b + off * (wb * k))
		end
	end
	-- 등: 진행 쪽(-Z)으로 볼록한 C — 척추 돌기 마디 + 쐐기 세 마디
	local back = { P(0, 3.95, -0.35), P(0, 4.9, -0.85), P(0, 5.8, -0.95), P(0, 6.6, -0.5) }
	S("Spine1", back[1], back[2])
	S("Spine2", back[2], back[3])
	S("Chest", back[3], back[4])
	for i, bone in { "Spine1", "Spine2", "Chest" } do
		local m = back[i]:Lerp(back[i + 1], 0.5)
		S(bone, m, m + Vector3.new(0, -0.05, -0.28)) -- 돌기
	end
	-- 얼굴 쪽(+Z): 오목하게 꺾인 갈비(좌우)
	for _, s in { -1, 1 } do
		S("Spine1", P(0.5 * s, 3.95, 0.3), P(0.45 * s, 4.85, 0.0))
		S("Spine2", P(0.45 * s, 4.85, 0.0), P(0.55 * s, 5.75, 0.1))
		S("Chest", P(0.55 * s, 5.75, 0.1), P(0.75 * s, 6.5, 0.2))
	end
	S("Chest", P(-0.85, 6.55, -0.25), P(0.85, 6.55, -0.25)) -- 어깨(머리 없는 꼭대기)
	-- 골반 쐐기 + 엉덩 가로대
	chain("Pelvis", { P(-0.55, 4.0, -0.3), P(0, 3.45, 0.05), P(0.55, 4.0, -0.3) })
	S("Pelvis", P(-0.55, 3.85, 0.0), P(0.55, 3.85, 0.0))
	-- 센서 5개: 척추에 박힌 원(붉은 것은 3번 하나)
	local sens = { { "Spine1", 4.35, -0.66 }, { "Spine1", 4.85, -0.95 }, { "Spine2", 5.35, -1.02 }, { "Spine2", 5.85, -1.05 }, { "Chest", 6.3, -0.85 } }
	for i, s in sens do
		table.insert(balls, { bone = s[1] :: string, c = P(0, s[2] :: number, s[3] :: number), r = 0.17, red = i == 3 })
	end
	-- 목: 어깨 뒤로 접혀 등 뒤 아래로(주름 고리 2) → 거꾸로 매달린 머리
	local n0, n1, n2 = P(0, 6.55, -0.45), P(0, 6.85, -1.0), P(0, 6.25, -1.35)
	S("Neck1", n0, n1)
	S("Neck2", n1, n2)
	table.insert(lines, { bone = "Neck1", a = P(0, 6.78, -0.82), b = P(0, 6.84, -0.88), r = 0.2, disc = true })
	table.insert(lines, { bone = "Neck2", a = P(0, 6.55, -1.2), b = P(0, 6.5, -1.25), r = 0.2, disc = true })
	local hc = P(0, 5.65, -1.45)
	table.insert(balls, { bone = "Head", c = hc, r = 0.42 })
	S("Head", hc + Vector3.new(-0.3, -0.02, -0.33), hc + Vector3.new(0.32, -0.2, -0.3)) -- 테이프 한 장(사선)
	S("Head", hc + Vector3.new(0.32, -0.2, -0.3), hc + Vector3.new(0.42, -0.08, -0.22)) -- 들린 끝
	chain("Jaw", { hc + Vector3.new(-0.2, 0.36, -0.3), hc + Vector3.new(0, 0.62, -0.42), hc + Vector3.new(0.2, 0.36, -0.3) }) -- 벌린 입(거꾸로라 위)
	-- 팔: 뒤(진행 쪽)로 더듬는 손
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local sh, el, wr = P(0.8 * s, 6.45, -0.3), P(1.1 * s, 5.35, -1.2), P(0.95 * s, 4.85, -2.3)
		cone("UpperArm" .. n, sh, el, 0.15, 0.1, Vector3.new(s, 0, 0))
		cone("Forearm" .. n, el, wr, 0.1, 0.07, Vector3.new(s, 0, 0))
		for i = -1, 1 do
			S("Hand" .. n, wr, wr + Vector3.new(0.12 * i, -0.15 + 0.05 * i, -0.45))
		end
	end
	-- 다리: 무릎은 얼굴 쪽(+Z)으로, 발끝도 얼굴 쪽 — 진행 쪽에서 보면 역관절
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		local hip, knee, ankle = P(0.4 * s, 3.85, 0), P(0.45 * s, 2.0, 0.55), P(0.42 * s, 0.25, -0.1)
		cone("Thigh" .. n, hip, knee, 0.2, 0.13, Vector3.new(s, 0, 0))
		cone("Shin" .. n, knee, ankle, 0.13, 0.08, Vector3.new(s, 0, 0))
		S("Shin" .. n, knee + Vector3.new(0, 0.15, 0.12), knee + Vector3.new(0, -0.25, 0.14)) -- 슬개골 쐐기
		chain("Foot" .. n, { ankle + Vector3.new(0, 0, -0.18), ankle + Vector3.new(0, -0.2, -0.05), ankle + Vector3.new(0, -0.22, 0.75) })
	end
	local bones: { Rig.Bone } = {
		{ name = "Pelvis", joint = P(0, 3.85, 0), tip = P(0, 4.2, -0.4) },
		{ name = "Spine1", parent = "Pelvis", joint = P(0, 3.95, -0.1), tip = P(0, 4.9, -0.5) },
		{ name = "Spine2", parent = "Spine1", joint = P(0, 4.9, -0.5), tip = P(0, 5.8, -0.55) },
		{ name = "Chest", parent = "Spine2", joint = P(0, 5.8, -0.55), tip = P(0, 6.55, -0.4) },
		{ name = "Neck1", parent = "Chest", joint = n0, tip = n1 },
		{ name = "Neck2", parent = "Neck1", joint = n1, tip = n2 },
		{ name = "Head", parent = "Neck2", joint = n2, tip = hc },
		{ name = "Jaw", parent = "Head", joint = hc + Vector3.new(0, 0.3, -0.2), tip = hc + Vector3.new(0, 0.62, -0.42) },
	}
	for _, s in { -1, 1 } do
		local n = if s < 0 then "L" else "R"
		table.insert(bones, { name = "UpperArm" .. n, parent = "Chest", joint = P(0.8 * s, 6.45, -0.3), tip = P(1.1 * s, 5.35, -1.2) })
		table.insert(bones, { name = "Forearm" .. n, parent = "UpperArm" .. n, joint = P(1.1 * s, 5.35, -1.2), tip = P(0.95 * s, 4.85, -2.3) })
		table.insert(bones, { name = "Hand" .. n, parent = "Forearm" .. n, joint = P(0.95 * s, 4.85, -2.3), tip = P(0.95 * s, 4.7, -2.75) })
		table.insert(bones, { name = "Thigh" .. n, parent = "Pelvis", joint = P(0.4 * s, 3.85, 0), tip = P(0.45 * s, 2.0, 0.55) })
		table.insert(bones, { name = "Shin" .. n, parent = "Thigh" .. n, joint = P(0.45 * s, 2.0, 0.55), tip = P(0.42 * s, 0.25, -0.1) })
		table.insert(bones, { name = "Foot" .. n, parent = "Shin" .. n, joint = P(0.42 * s, 0.25, -0.1), tip = P(0.42 * s, 0.03, 0.75) })
	end
	Rig.build(model, root, cf, {
		id = "c9h",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.7,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

-- 등 쪽 부채꼴(진행 방향 = 루트 LookVector) 안, 28 안, 보이는 가장 가까운 플레이어
local function sensed(self: any): (Player?, Vector3?, number)
	local my = self.root.Position
	local look = self.root.CFrame.LookVector
	local bestP: Player?, bestPos: Vector3?, bestD = nil, nil, math.huge
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Status") == "Alive" and not p:GetAttribute("Hidden") then
			local char = p.Character
			local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then
				local to = r.Position - my
				local flat = Vector3.new(to.X, 0, to.Z)
				local dist = flat.Magnitude
				if dist < 28 and dist < bestD and math.abs(to.Y) < 8 and (dist < 0.5 or flat.Unit:Dot(look) >= FAN) and self:lineOfSight(r.Position) then
					bestP, bestPos, bestD = p, r.Position, dist
				end
			end
		end
	end
	return bestP, bestPos, bestD
end

function M.init(self: any)
	self.model:SetAttribute("Band", 0)
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	-- 음파 뒤 돌아서기(1.8초 멈춤) → 그쪽 조사
	if d.turnUntil then
		if now < d.turnUntil then
			self.hum:MoveTo(self.root.Position)
			return true
		end
		local at: Vector3 = d.turnAt
		d.turnUntil, d.turnAt = nil, nil
		self:investigate(at)
	end
	-- 센서: 거리 단계(28~16 → 1, 16~8 → 2, 8~3 → 3, 3 미만 → 4)
	local p, pos, dist = sensed(self)
	local band = if not p then 0 elseif dist < 3 then 4 elseif dist < 8 then 3 elseif dist < 16 then 2 else 1
	if self.model:GetAttribute("Band") ~= band then
		self.model:SetAttribute("Band", band)
	end
	if p and pos and self.state ~= "Chase" then
		self:startChase(p, pos)
	end
	-- 추격 중 마지막 두 칸(8)에서는 돌진
	if self.state == "Chase" then
		local want = if band >= 3 then CHARGE else M.cfg.ChaseSpeed
		if self.hum.WalkSpeed ~= want then
			self.hum.WalkSpeed = want
		end
	end
	return false
end

function M.hear(self: any, pos: Vector3, _radius: number, source: Player?, kind: string): boolean
	if kind ~= "Sonar" or source == nil or self.state == "Chase" or self.cdata.turnUntil then
		return false
	end
	if (pos - self.root.Position).Magnitude > 60 then
		return false
	end
	local now = os.clock()
	self.cdata.turnUntil = now + 1.8
	self.cdata.turnAt = pos
	self.model:SetAttribute("Turn", now)
	return true
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="170">
          <Properties>
            <string name="Name">c9n</string>
            <string name="Source"><![CDATA[--!strict
-- c9n 깔린 것 (9장 지하 주차장 · 비인간형) — 사양서: roster/v5/ch9/c9n_spec.md
-- 바닥에 오래 깔려 납작해진 몸(두께 0.6): 갈비가 부채처럼 펴져 뼈 끝이 비치는 들쭉날쭉한 판이 되었고,
-- 등을 비스듬히 타이어 자국(트레드 두 줄 + 마디)이 가로지른다. 앞으로 두 팔(다섯 손가락 손), 뒤로 두 다리가 납작하게 끌린다.
-- 옆으로 퍼진 두개골의 앞 가장자리 외곽선 자체가 붉은 입술(유일한 붉은 선) — 들리면 입이 벌어진다.
-- 뼈: spine0(골반) → spine1 → spine2 → spine3 → skull → lip / finL1..3·finR1..3(spine2, 옆 가장자리 물결 사슬)
--     armL→handL·armR→handR(spine3), legL→footL·legR→footR(spine0)
-- 공포 장치 「차 그늘」(차 밑 노드가 없어 '아무 데서나 매복'으로 단순화):
--   배회가 20초 이어지면 그 자리에 10초 엎드려 기다린다(Lurk 속성, 기본 AI 멈춤 — 지나가는 사람은 못 본 척).
--   기다리는 동안 누가 6 안에서 1초 넘게 (거의) 멈춰 서 있으면 입술을 들고 발목을 낚아챈다(Grab 속성 → 1초 튀어나옴 16 + 쫓기).
--   음파에 맞으면 3초 동안 납작해져 멈춘다(Flat 속성) — 타이어 자국과 붉은 호만 남는다. 매복도 풀린다.
local Players = game:GetService("Players")
local Rig = require(script.Parent.Rig)

local M = {}
M.cfg = {
	WanderSpeed = 6, -- 차 밑 미끄러짐
	InvestigateSpeed = 9, -- 통로 가로지르기
	ChaseSpeed = 13,
	AgentRadius = 1.6,
	AgentHeight = 2,
	CatchDistance = 3.2, -- (몸 앞으로 팔이 뻗어 있어 발목까지 닿는다)
}
M.spawnLift = 1.4
M.voice = "3" -- (소리: 전용 소리 전까지 '손톱 톡톡' 계열)

local HIP = 0.3
local FLOOR = -(HIP + 1)
local LURK_AFTER = 20
local LURK_TIME = 10
local FLAT_TIME = 3
local GRAB_R = 6
local LUNGE_SPEED, LUNGE_TIME = 16, 1

-- 판 위의 점(x 옆, z 앞 = -, h 바닥에서 높이)
local function V(x: number, z: number, h: number): Vector3
	return Vector3.new(x, FLOOR + h, z)
end

function M.build(cf: CFrame): Model
	local model, root = Rig.shell("Flat", cf, Vector3.new(1.2, 2, 1.2))
	local lines: { Rig.Line } = {}
	local balls: { Rig.Ball } = {}
	local bones: { Rig.Bone } = {}
	local function L(bone: string, a: Vector3, b: Vector3, r: number, red: boolean?)
		local len = (b - a).Magnitude
		local disc = len < 0.12
		table.insert(lines, { bone = bone, a = a, b = b, r = if disc then r else math.min(r, len / 4.2), red = red, disc = if disc then true else nil })
	end
	local function bone(name: string, parent: string?, joint: Vector3, tip: Vector3)
		table.insert(bones, { name = name, parent = parent, joint = joint, tip = tip })
	end
	local H = 0.3 -- 판 높이
	bone("spine0", nil, V(0, 2.9, H), V(0, 0.5, H))
	bone("spine1", "spine0", V(0, 0.5, H), V(0, -0.6, H))
	bone("spine2", "spine1", V(0, -0.6, H), V(0, -1.9, H))
	bone("spine3", "spine2", V(0, -1.9, H), V(0, -2.4, H))
	bone("skull", "spine3", V(0, -2.4, H), V(0, -2.85, H))
	bone("lip", "skull", V(0, -2.85, H + 0.05), V(0, -3.4, H + 0.05))
	for _, s in { { "L", -1 }, { "R", 1 } } do
		local n, sg = s[1] :: string, s[2] :: number
		bone("fin" .. n .. "1", "spine2", V(sg * 0.45, -0.3, H), V(sg * 1.3, -0.3, H))
		bone("fin" .. n .. "2", "fin" .. n .. "1", V(sg * 1.3, -0.3, H), V(sg * 1.85, -0.3, H))
		bone("fin" .. n .. "3", "fin" .. n .. "2", V(sg * 1.85, -0.3, H), V(sg * 2.3, -0.3, H))
	end
	-- 외곽: 갈비 끝이 비치는 들쭉날쭉한 판(한쪽 7획). 가장자리 점은 그 자리를 움직이는 뼈(어깨·지느러미·골반)에 붙는다
	local edge = {
		{ 0.9, -2.35, "spine3" },
		{ 1.95, -1.65, "spine3" },
		{ 1.75, -1.05, "fin?2" },
		{ 2.3, -0.45, "fin?3" },
		{ 1.95, 0.2, "fin?3" },
		{ 2.15, 0.95, "fin?2" },
		{ 1.35, 1.95, "spine0" },
		{ 0.55, 3.1, "spine0" },
	}
	for _, s in { { "L", -1 }, { "R", 1 } } do
		local n, sg = s[1] :: string, s[2] :: number
		-- 양옆이 같지 않게(깔린 몸은 대칭이 아니다): 쪽마다 뼈 끝이 다르게 비어져 나옴
		local jit = if sg > 0 then { 0, 0.14, -0.18, 0.12, -0.1, 0.16, 0.05, 0 } else { 0, -0.12, 0.1, -0.16, 0.18, -0.08, 0.12, 0 }
		local function ep(i: number): Vector3
			local e = edge[i]
			return V(sg * ((e[1] :: number) + jit[i]), (e[2] :: number) + jit[i] * 0.7, H)
		end
		for i = 1, #edge - 1 do
			local bn = string.gsub(edge[i][3] :: string, "%?", n)
			L(bn, ep(i), ep(i + 1), 0.08)
		end
		-- 갈비 넷: 등뼈에서 옆으로 펴져 가장자리 쪽으로(안쪽 지느러미 뼈에 붙어 물결과 함께 들림)
		for _, z in { -1.35, -0.65, 0.05, 0.75 } do
			L("fin" .. n .. "1", V(sg * 0.3, z, H + 0.05), V(sg * 1.45, z + 0.22, H + 0.03), 0.05)
		end
		-- 골반 뼈(납작하게 퍼짐)
		L("spine0", V(sg * 0.15, 2.3, H + 0.05), V(sg * 0.95, 2.75, H + 0.02), 0.06)
		-- 어깨(빗장뼈 자리) → 팔 뿌리
		L("spine3", V(sg * 0.15, -2.1, H + 0.05), V(sg * 0.9, -2.35, H + 0.02), 0.06)
	end
	L("spine0", V(0.55, 3.1, H), V(-0.55, 3.1, H), 0.06) -- 뒤 끝
	-- 등줄기(등뼈 고랑)
	L("spine0", V(0, 2.6, H + 0.06), V(0, 0.5, H + 0.06), 0.06)
	L("spine1", V(0, 0.5, H + 0.06), V(0, -0.6, H + 0.06), 0.06)
	L("spine2", V(0, -0.6, H + 0.06), V(0, -1.9, H + 0.06), 0.06)
	-- 타이어 자국: 등을 비스듬히 가로지르는 트레드 두 줄 + 사이의 마디 셋(바닥선과 각이 다르다)
	local t0, t1 = V(-1.9, 1.7, H + 0.04), V(1.7, -1.6, H + 0.04)
	local nrm = Vector3.new(1.7 - -1.9, 0, -1.6 - 1.7).Unit:Cross(Vector3.new(0, 1, 0)) * 0.55
	L("spine1", t0, t1, 0.05)
	L("spine1", t0 + nrm, t1 + nrm, 0.05)
	for _, f in { 0.25, 0.5, 0.75 } do
		L("spine1", t0:Lerp(t1, f), t0:Lerp(t1, f + 0.05) + nrm, 0.04)
	end
	-- 두개골: 옆으로 퍼진 납작한 타원. 뒤쪽 절반은 흰 외곽, 앞쪽 절반(앞 가장자리)이 붉은 입술 — 들리면 입이 벌어진다
	local SC = V(0, -2.85, H + 0.05)
	local function sk(deg: number): Vector3
		local a = math.rad(deg)
		return SC + Vector3.new(0.8 * math.cos(a), 0, 0.55 * math.sin(a))
	end
	for k = 0, 3 do
		L("skull", sk(k * 45), sk((k + 1) * 45), 0.06)
	end
	for k = 4, 7 do
		L("lip", sk(k * 45), sk((k + 1) * 45), 0.05, true)
	end
	-- 팔: 어깨 → 팔꿈치(납작) → 손목, 손바닥 + 다섯 손가락(바닥에 펴짐)
	for _, s in { { "L", -1 }, { "R", 1 } } do
		local n, sg = s[1] :: string, s[2] :: number
		local sh = V(sg * 0.9, -2.35, 0.14)
		local el = sh + Vector3.new(sg * 0.6, 0, -1.15)
		local wr = el + Vector3.new(sg * 0.5, -0.04, -1.25)
		bone("arm" .. n, "spine3", sh, el)
		bone("hand" .. n, "arm" .. n, el, wr + Vector3.new(sg * 0.2, 0, -0.9))
		L("arm" .. n, sh, el, 0.12)
		L("hand" .. n, el, wr, 0.1)
		local palm = wr + Vector3.new(sg * 0.12, 0, -0.38)
		L("hand" .. n, wr, palm, 0.09)
		for f = 1, 5 do
			local a = math.rad(-55 + (f - 1) * 26) -- 엄지(바깥 뒤) → 새끼
			local d = Vector3.new(sg * math.sin(a) * (if f == 1 then 1.3 else 0.6), 0, -math.cos(a))
			L("hand" .. n, palm, palm + d.Unit * (if f == 1 then 0.42 elseif f == 3 then 0.62 else 0.52), 0.035)
		end
	end
	-- 다리: 골반 → 무릎 → 납작하게 끌리는 발
	for _, s in { { "L", -1 }, { "R", 1 } } do
		local n, sg = s[1] :: string, s[2] :: number
		local hip = V(sg * 0.6, 2.85, 0.14)
		local kn = hip + Vector3.new(sg * 0.25, 0, 0.58)
		local ft = kn + Vector3.new(sg * 0.15, -0.04, 1.7)
		bone("leg" .. n, "spine0", hip, kn)
		bone("foot" .. n, "leg" .. n, kn, ft)
		L("leg" .. n, hip, kn, 0.12)
		L("foot" .. n, kn, ft - Vector3.new(0, 0, 0.4), 0.11)
		L("foot" .. n, ft - Vector3.new(0, 0, 0.4), ft + Vector3.new(sg * 0.12, 0, 0), 0.08)
	end
	Rig.build(model, root, cf, {
		id = "c9n",
		bones = bones,
		lines = lines,
		balls = balls,
		floorY = FLOOR,
		mass = 0.6,
	})
	Rig.humanoid(model, HIP, M.cfg.WanderSpeed)
	return model
end

function M.init(self: any)
	self.cdata.roamSince = os.clock()
	self.cdata.still = {}
end

local function restore(self: any)
	self:setState(self.state)
end

function M.tick(self: any, now: number): boolean
	local d = self.cdata
	-- 납작(음파): 멈춤
	if d.flatUntil then
		if now < d.flatUntil then
			self.hum:MoveTo(self.root.Position)
			return true
		end
		d.flatUntil = nil
		self.model:SetAttribute("Flat", false)
		d.roamSince = now
		restore(self)
	end
	-- 튀어나옴(발목 잡기): 1초 동안 빠르게, 그다음 기본 쫓기
	if d.lungeUntil then
		if now < d.lungeUntil and self.state == "Chase" then
			self.hum.WalkSpeed = LUNGE_SPEED
		else
			d.lungeUntil = nil
			restore(self)
		end
		return false
	end
	if d.lurkUntil then
		if now >= d.lurkUntil or self.state ~= "Wander" then
			d.lurkUntil = nil
			d.roamSince = now
			self.model:SetAttribute("Lurk", false)
			return false
		end
		self.hum:MoveTo(self.root.Position)
		-- 가까이(6) 1초 넘게 거의 멈춰 선 사람의 발목을 낚아챈다
		local my = self.root.Position
		for _, p in Players:GetPlayers() do
			local r: BasePart? = nil
			if p:GetAttribute("Status") == "Alive" and not p:GetAttribute("Hidden") and p.Character then
				r = p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			end
			local near = false
			if r then
				local q = r.Position
				local v = r.AssemblyLinearVelocity
				near = Vector3.new(q.X - my.X, 0, q.Z - my.Z).Magnitude < GRAB_R and math.abs(q.Y - my.Y) < 4 and Vector3.new(v.X, 0, v.Z).Magnitude < 4
			end
			if near and r then
				d.still[p] = d.still[p] or now
				if now - d.still[p] >= 1 then
					d.still = {}
					d.lurkUntil = nil
					self.model:SetAttribute("Lurk", false)
					self.model:SetAttribute("Grab", now)
					self:startChase(p, r.Position)
					d.lungeUntil = now + LUNGE_TIME
					self.hum.WalkSpeed = LUNGE_SPEED
					return false
				end
			else
				d.still[p] = nil
			end
		end
		return true
	end
	-- 배회가 이어지면 그 자리에 엎드려 기다린다
	if self.state ~= "Wander" then
		d.roamSince = now
	elseif now - d.roamSince > LURK_AFTER then
		d.lurkUntil = now + LURK_TIME
		d.still = {}
		self.model:SetAttribute("Lurk", true)
		self.hum:MoveTo(self.root.Position)
		return true
	end
	return false
end

-- 음파에 맞으면 납작해져 3초 멈춘다(매복도 풀림)
-- 음파에 "맞았는가": 파동이 퍼지는 거리(Config.Sonar.Radius 35) 안이고, 가깝거나(12) 사이가 트여 있음
local SONAR_REACH = 35
local function sonarHit(self: any, pos: Vector3, radius: number): boolean
	local d = (pos - self.root.Position).Magnitude
	if d > math.min(radius, SONAR_REACH) then
		return false
	end
	return d < 12 or self:lineOfSight(pos + Vector3.new(0, 1, 0))
end

function M.hear(self: any, pos: Vector3, radius: number, _source: any, kind: string): boolean
	if kind ~= "Sonar" or not sonarHit(self, pos, radius) then
		return false
	end
	local d = self.cdata
	if d.lurkUntil then
		d.lurkUntil = nil
		self.model:SetAttribute("Lurk", false)
	end
	d.lungeUntil = nil
	d.flatUntil = os.clock() + FLAT_TIME
	self.model:SetAttribute("Flat", true)
	self.hum:MoveTo(self.root.Position)
	return true
end

return M
]]></string>
          </Properties>
        </Item>
