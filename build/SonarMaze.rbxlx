		"###.....#...#TO.O.O.O.O.O.#...#.#####D###...#",
		"###.L...D...#.............#k..#.#R......#.Tk#",
		"#########D####D##########D###D#.#.......#...#",
		"#...........................A.#.A..........k#",
		"####################D##D#####.D.#psppppp#####",
		"####......#.....#.L...#...###.#.#ppppppp#####",
		"####A####.D..X..#.....#..L###.#.#pppsppp#####",
		"#....L###.#.Z...#..X..D...###...#.......#####",
		"#k.X..###D#######k....###D#####A###D#########",
		"#.....D....R#L..#.....#.#....k#.....#k.k..Z.#",
		"##.####.....#..k###D###.D..T..#####.#...T...#",
		"##....#.......X.###.....#....k#..D..D.......#",
		"#####.#####E#...###D######D#####D#########D##",
		"#.....#######...#...........................#",
