        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Stage4</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 4 — 폐병원 (45x41칸, tools/gen-stages.js 로 생성, 방 안 구성·갈림길은 tools/redecorate.js)
-- 긴 복도 4줄에 문 달린 병실(R 침대), 진료실(T 책상, k 캐비닛), 수술실(X), 기둥 로비, 아래층 병동(계단),
-- 그 사이 뒷복도. 출구까지 최단 약 160칸(걸어서 약 2분).
local Props = require(script.Parent.Parent.Props)
return {
	Seed = 41,
	PipeChance = 0.25,
	HideStyle = "wardrobe", -- 숨는 곳(L): 병실 옷장
	SearchStyle = "nightstand", -- 뒤지는 곳(Z): 협탁, 그중 한 곳에 열쇠
	Props = { R = Props.Bed, T = Props.Desk, X = Props.Surgery, k = Props.Cabinet },
	Walkable = { k = true }, -- (침대 R 은 막힌 칸: 괴물이 침대 위를 배회 목표로 잡지 않게)
	Rows = {
		"#############################################",
		"#SS.k.#########k.k#.D..R..L.#.D.#R.R..#######",
