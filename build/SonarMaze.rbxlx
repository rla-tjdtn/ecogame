      </Item>
      <Item class="Script" referent="38">
        <Properties>
          <string name="Name">TestHarness</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- 자동 플레이 테스트. Studio 가 StudioTestService 로 플레이를 시작했을 때만 동작한다(tools/studio-test.js).
-- 일반 플레이·게시된 게임에서는 아무것도 하지 않는다. 모든 테스트 플레이어는 음소거(TestMute).
--   core  : 1인 — 어둠, 음파 퍼짐·유지·소멸, 벽/닫힌 문 가림, 발사 간격, 이동 속도, 괴물 청각·경로·추격·사망, 출구
--   multi : 여러 클라이언트 — 동시 음파, 서로의 음파 수신, 프레임 시간

local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
if not RunService:IsStudio() then
	return
end
local StudioTestService = game:GetService("StudioTestService")
local okArgs, args = pcall(function()
	return StudioTestService:GetTestArgs()
end)
if not okArgs or type(args) ~= "table" or not args.Test then
	return
end

local Players = game:GetService("Players")
local LogService = game:GetService("LogService")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Round = require(script.Parent.Round)
local Doors = require(script.Parent.Doors)
local SoundBus = require(script.Parent.SoundBus)
local Hiding = require(script.Parent.Hiding)
local Search = require(script.Parent.Search)

local R = { test = args.Test, finished = false, checks = {}, log = {}, errors = {}, info = {} }
local t0 = os.clock()
local function log(s)
	table.insert(R.log, string.format("%6.1f %s", os.clock() - t0, s))
end
local function check(name, ok, info)
	table.insert(R.checks, { name = name, ok = ok == true, info = if info ~= nil then tostring(info) else nil })
	log((if ok then "PASS " else "FAIL ") .. name .. (if info ~= nil then " (" .. tostring(info) .. ")" else ""))
end
LogService.MessageOut:Connect(function(msg, kind)
	if kind == Enum.MessageType.MessageError or (kind == Enum.MessageType.MessageWarning and (msg:find("%[Monster%]") or msg:find("%[SoundBus%]"))) then
		if #R.errors < 30 then
			table.insert(R.errors, msg:sub(1, 300))
		end
	end
end)

-- 테스트 설정: 괴물은 시험할 때만 움직이고, 결과 화면은 짧게
-- 로비 테스트만 로비로, 나머지는 바로 게임으로 시작(Lobby.boot 가 읽는다)
ReplicatedStorage:SetAttribute("ForceMode", if args.Test == "lobby" then "Lobby" else "Game")
Config.Monster.StartDelay = 1e6
Config.Lives.PerStage = 1 -- (예전 테스트는 한 번 잡히면 죽는 것을 전제: lives 테스트에서만 3개)
Config.SafeZone.Enabled = false -- (예전 테스트는 시작 방에서 괴물을 시험한다: lives 테스트에서만 켠다)
Config.Flower.StartDelay = 1e6 -- (꽃괴물도 멈춰 둔다)
Config.Doppel.StartDelay = 1e6 -- (도플갱어도 멈춰 둔다: doppel 테스트에서만 움직인다)
Config.Key.Required = false -- (열쇠 시험은 core 에서 따로 켠다)
Config.Round.ResultSeconds = 2
Config.Round.FirstStartDelay = 1

for _, p in Players:GetPlayers() do
	p:SetAttribute("TestMute", true)
end
Players.PlayerAdded:Connect(function(p)
	p:SetAttribute("TestMute", true)
end)
local probe = Instance.new("RemoteFunction")
probe.Name = "TestProbe"
probe.Parent = ReplicatedStorage

local function ask(p, cmd, arg)
	-- (클라이언트가 응답하지 않아도 10초 뒤 nil)
	local done, ok, res = false, false, nil
	task.spawn(function()
		ok, res = pcall(function()
			return probe:InvokeClient(p, cmd, arg)
		end)
		done = true
	end)
	local t = os.clock()
	while not done and os.clock() - t < 10 do
		task.wait()
	end
	if not done then
		log("probe timeout " .. cmd)
		return nil
	end
	if not ok then
		log("probe error " .. cmd .. ": " .. tostring(res))
		return nil
	end
	return res
end

local function waitFor(fn, timeout)
	local t = os.clock()
	while os.clock() - t < timeout do
		local v = fn()
		if v then
			return v
		end
		task.wait(0.1)
	end
	return nil
end

local function root(p)
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end

local function place(p, pos, look)
	local char = p.Character
	if char then
		char:PivotTo(CFrame.lookAt(pos, look or (pos + Vector3.new(1, 0, 0))))
		local r = root(p)
		if r then
			r.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

local function tile(i, j, y)
	return Vector3.new((i - 1) * 8 + 4, y or 3, (j - 1) * 8 + 4)
end

-- 시작 → 출구를 실제로 걸을 수 있는가. 괴물과 같은 방식: 바로 계산이 안 되면 타일 경로를 LegTiles 칸씩 나눠 계산
local function routeWalkable(agent, monster: boolean): (string, number)
	local path = PathfindingService:CreatePath({ AgentRadius = agent.r, AgentHeight = agent.h, AgentCanJump = false })
	local from = Round.info.spawns[1].Position - Vector3.new(0, 2.5, 0)
	local to = Round.info.exitCFrame.Position - Vector3.new(0, 3.5, 0)
	local function compute(a, b)
		local ok = pcall(function()
			path:ComputeAsync(a, b)
		end)
		return ok and path.Status == Enum.PathStatus.Success
	end
	if compute(from, to) then
		return "Success", 1
	end
	local r = Round.info.route(from, to, monster)
	if not r then
		return "NoRoute", 0
	end
	local pos, idx, legs = from, 1, 0
	while idx < #r do
		local step = Config.Monster.LegTiles
		local moved = false
		for _, n in { math.min(#r, idx + step), math.min(#r, idx + math.ceil(step / 2)), idx + 1 } do
			if compute(pos, r[n]) then
				pos, idx, legs, moved = r[n], n, legs + 1, true
				break
			end
		end
		if not moved then
			return string.format("LegFail@c%d,r%d", math.floor(r[idx].X / 8), math.floor(r[idx].Z / 8)), legs
		end
	end
	return "Success", legs
end

local function readyPlayers(n)
	return waitFor(function()
		local ps = Players:GetPlayers()
		if #ps < n or Round.state ~= "Playing" then
			return nil
		end
		for _, p in ps do
			if p:GetAttribute("Status") ~= "Alive" or not root(p) then
				return nil
			end
			local st = ask(p, "stats")
			local stage = workspace:FindFirstChild("Stage")
			if not st or not st.ready or not stage or st.buildId ~= stage:GetAttribute("BuildId") then
				return nil
			end
		end
		return ps
	end, if n > 1 then 240 else 90)
end

local function stageFolder()
	return workspace:FindFirstChild("Stage")
end

-- ─────────────────────────────── 문 끼임 ───────────────────────────────
-- 문 바로 앞(예전에 문짝이 휘두르던 자리)에 서서 열고 지나간다 — 양쪽에서. 문짝은 여는 사람 반대쪽으로 열려야 한다
local function doorTests(p)
	local door = nil
	for _, d in Doors.all() do
		if (d.panel.Position - tile(5, 3, 4.5)).Magnitude < 4 then
			door = d
		end
	end
	if not door then
		check("door for the stuck test", false)
		return
	end
	local x0 = door.panel.Position.X
	for _, side in { -1, 1 } do
		if door.open then
			Doors.toggle(door)
			task.wait(1)
		end
		local from = Vector3.new(x0 + side * 2.2, 3, tile(5, 3).Z)
		local to = Vector3.new(x0 - side * 9, 3, tile(5, 3).Z)
		place(p, from, to)
		task.wait(0.4)
		Doors.toggle(door, p)
		task.wait(0.8)
		ask(p, "move", to)
		local crossed = waitFor(function()
			local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			return r and (r.Position.X - x0) * -side > 2.5
		end, 4)
		check(string.format("open a door standing right at it and walk through (%s side)", if side < 0 then "west" else "east"), crossed ~= nil)
	end
	if door.open then
		Doors.toggle(door)
	end
end

-- ─────────────────────────────── 괴물 모습·등장 ───────────────────────────────
local function monsterTests(p)
	local m = Round.monsters[1]
	if not m then
		check("monster exists for look tests", false)
		return
	end
	-- 막대는 한 획(Line), 얇은 원판은 원 하나(Disc): 음파에 여러 겹 선으로 보이지 않게
	local cyl, ok = 0, 0
	for _, d in m.model:GetDescendants() do
		if d:IsA("Part") and d.Shape == Enum.PartType.Cylinder then
			cyl += 1
			local sh = d:GetAttribute("SonarShape")
			if sh == "Line" or sh == "Disc" then
				ok += 1
			end
		end
	end
	check("monster strokes draw as single lines (Line/Disc)", cyl > 10 and ok == cyl, ok .. "/" .. cyl)
	local visible = 0
	for _, d in m.model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 then
			visible += 1
		end
	end
	check("monster body is invisible (only sonar reveals it)", visible == 0, visible)
	-- 음파가 닿으면 괴물 모습이 선으로 나타난다
	m.startAt = 1e9
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		place(p, tile(3, 10, 3), tile(7, 10, 3))
		task.wait(0.3)
		local mpos = tile(6, 10, 5.2)
		m.model:PivotTo(CFrame.lookAt(mpos, tile(3, 10, 5.2)))
		m.waypoints = {}
		task.wait(0.3)
		ask(p, "resetCooldown")
		ask(p, "fire")
		task.wait(1.0)
		local n = ask(p, "linesNear", { mpos, 4.5 }) or 0
		-- (음파에 맞은 괴물은 굳은 선 대신 지금 모습 그대로 보인다: Reveal)
		local shown = ask(p, "reveal") or 0
		check("monster appears in the sonar as lines", n >= 15 or shown >= 1, string.format("lines %d, shown %d", n, shown))
	end
	-- 배회하다가 가끔 플레이어 근처로 온다
	m.model:PivotTo(CFrame.new(Round.info.exitCFrame.Position + Vector3.new(0, 1.2, 0)))
	m.waypoints = {}
	m.legGoal = nil
	m.target = nil
	m:setState("Wander")
	m.lastHunt = -1e9
	m.startAt = 0
	m.goal = nil
	waitFor(function()
		return m.lastHunt > 0
	end, 4)
	task.wait(2) -- (먼 길은 경로 계산이 걸린다)
	local goal = m.goal
	local pr = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local gd = if goal and pr then (goal - pr.Position).Magnitude else -1
	check("wandering monster drifts toward a player now and then", goal ~= nil and gd >= 0 and gd <= Config.Monster.HuntRadius + 8, string.format("%.0f studs", gd))
	m.startAt = 1e9
	m.waypoints = {}
end

-- ─────────────────────────────── 숨는 곳 ───────────────────────────────
-- 들어가기(E) → 음파 못 쏨 → 바로 앞 괴물도 못 찾음 → 나오기(E) → 쫓던 괴물이 숨는 걸 보면 끌어냄(사망)
local function hideTests(p)
	local spots = Hiding.all()
	check("hide spots built (cabinets/wardrobes)", #spots >= 5, #spots)
	local spot = spots[1]
	local m = Round.monsters[1]
	if not spot or not m then
		return
	end
	m.startAt = 1e9
	place(p, spot.front + Vector3.new(0, 3, 0), spot.center + Vector3.new(0, 3, 0))
	-- 1인칭 카메라 방향은 클라이언트가 정한다: 사물함을 바라보게(안내는 화면 안에 있을 때만 뜬다)
	local ui0 = nil
	waitFor(function()
		-- (순간이동 직후엔 카메라가 아직 옛 자리라, 자리를 잡을 때까지 다시 바라보게 한다)
		ask(p, "lookTarget", spot.center + Vector3.new(0, 3, 0))
		ui0 = ask(p, "stats")
		return ui0 ~= nil and ui0.ui.prompt == "E   숨기"
	end, 3)
	local nearDoor = math.huge
	for _, d in Doors.all() do
		nearDoor = math.min(nearDoor, ((d.prompt.Parent :: BasePart).Position - spot.front).Magnitude)
	end
	local pinfo = if not (ui0 and ui0.ui.prompt == "E   숨기") then ask(p, "prompts") else ""
	check("hide prompt shown near the cabinet", ui0 and ui0.ui.prompt == "E   숨기", string.format("%s | %s | tile %d,%d door %.1f enabled %s", ui0 and tostring(ui0.ui.prompt) or "no ui", tostring(pinfo), math.floor(spot.center.X / 8), math.floor(spot.center.Z / 8), nearDoor, tostring(spot.prompt.Enabled)))
	local ok = Hiding.enter(p, spot)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local inside = root and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(spot.center.X, 0, spot.center.Z)).Magnitude
	check("E: hide inside (anchored, inside the cabinet)", ok and p:GetAttribute("Hidden") == true and root ~= nil and root.Anchored and inside ~= nil and inside < 1.5, string.format("ok=%s inside=%.2f", tostring(ok), inside or -1))
	local ui1 = nil
	waitFor(function()
		ui1 = ask(p, "stats")
		return ui1 and ui1.ui.prompt == "E   나가기"
	end, 3)
	check("prompt says get out while hidden", ui1 and ui1.ui.prompt == "E   나가기", ui1 and tostring(ui1.ui.prompt))
	local Main = _G.SonarMaze
	local before = Main.Sonar.accepted[p] or 0
	ask(p, "resetCooldown")
	local fired = ask(p, "fire")
	ask(p, "rawFire")
	task.wait(0.6)
	check("no sonar while hidden", not fired and (Main.Sonar.accepted[p] or 0) == before, tostring(fired))
	local mpos = spot.front + spot.facing * 2 + Vector3.new(0, 5.2, 0)
	m.model:PivotTo(CFrame.lookAt(mpos, spot.center + Vector3.new(0, 5.2, 0)))
	m.waypoints = {}
	m.legGoal = nil
	m.target = nil
	m.pullSpot = nil
	m:setState("Wander")
	m.startAt = 0
	task.wait(3)
	check("monster right outside does not find a hidden player", p:GetAttribute("Status") == "Alive" and m.state ~= "Chase", m.state)
	m.startAt = 1e9
	Hiding.exit(p)
	task.wait(0.2)
	check("E: get out in front of the cabinet", p:GetAttribute("Hidden") == false and root ~= nil and not root.Anchored and (root.Position - spot.front).Magnitude < 4.5, root and string.format("%.1f", (root.Position - spot.front).Magnitude))
	-- 쫓기다가 보는 앞에서 숨기
	local cpos = spot.front + spot.facing * 10 + Vector3.new(0, 5.2, 0)
	m.model:PivotTo(CFrame.lookAt(cpos, spot.front + Vector3.new(0, 5.2, 0)))
	m.waypoints = {}
	m.legGoal = nil
	m.startAt = 0
	m:startChase(p, root and root.Position or spot.front)
	task.wait(0.2)
	Hiding.enter(p, spot)
	local dead = waitFor(function()
		return p:GetAttribute("Status") == "Dead"
	end, 10)
	check("monster that saw you hide pulls you out", dead ~= nil, m.state .. " " .. table.concat(m.log, " | "):sub(-160))
end

-- ─────────────────────────────── core ───────────────────────────────
local function core()
	local ps = readyPlayers(1)
	check("player spawned and sonar world built", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local stage = stageFolder()
	local st = ask(p, "stats")
	R.info.world = st and { segs = st.segs, culled = st.culled, unattached = st.unattached, viewParts = st.viewParts, grid = st.grid }
	check("outline segments generated", st and st.segs > 1000, st and st.segs)
	check("almost every segment can receive the wave", st and st.unattached < st.segs * 0.08, st and (st.unattached .. "/" .. st.segs))
	check("seams removed (coplanar/buried edges culled)", st and st.culled > 0, st and st.culled)

	-- 1. 어둠
	local L = game:GetService("Lighting")
	local lights = 0
	for _, d in workspace:GetDescendants() do
		if d:IsA("Light") then
			lights += 1
		end
	end
	local bright = 0
	local neon = 0
	for _, d in stage:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Transparency < 1 and (d.Color.R + d.Color.G + d.Color.B) > 0.001 then
				bright += 1
			end
			if d.Material == Enum.Material.Neon then
				neon += 1
			end
		end
	end
	check("darkness: no ambient/brightness, no lights", L.Brightness == 0 and L.Ambient == Color3.new() and L.OutdoorAmbient == Color3.new() and lights == 0, "lights=" .. lights)
	check("darkness: every structure is black and unlit", bright == 0 and neon == 0, "nonblack=" .. bright .. " neon=" .. neon)
	check("client lighting is dark too", st and st.lighting.brightness == 0, st and st.lighting.brightness)
	task.wait(3)
	local idle = ask(p, "stats")
	check("nothing visible before a pulse", idle and idle.lines.lit == 0, idle and (idle.lines.lit .. " lit, pulses started " .. tostring(idle.pulsesStarted)))

	-- 계단 경사로 방향(쐐기 방향 확인)
	local stairs = stage:FindFirstChild("Props") and stage.Props:FindFirstChild("Stairs")
	if stairs then
		local ramp = stairs:FindFirstChildWhichIsA("WedgePart")
		local f = ramp.CFrame.ZVector
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = { ramp }
		local function h(off)
			local o = ramp.Position + f * off + Vector3.new(0, 10, 0)
			local hit = workspace:Raycast(o, Vector3.new(0, -30, 0), rp)
			return hit and hit.Position.Y
		end
		local hi, lo = h(2.5), h(-2.5)
		check("stairs ramp rises toward the upper floor", hi and lo and hi > lo + 2, tostring(hi) .. " vs " .. tostring(lo))
	end

	-- 걸을 수 있는 미로: 시작 → 출구 경로
	for _, agent in { { name = "player", r = 1.2, h = 5.5 }, { name = "monster", r = Config.Monster.AgentRadius, h = Config.Monster.AgentHeight } } do
		local status, legs = routeWalkable(agent, agent.name == "monster")
		check("path start -> exit exists (" .. agent.name .. " size)", status == "Success", status .. " legs=" .. legs)
	end

	-- 2~4. 음파: 가까운 곳부터, 유지, 소멸
	place(p, tile(3, 3, 3), tile(3, 6, 3))
	task.wait(0.5)
	ask(p, "resetCooldown")
	local fired = ask(p, "fire")
	check("left-click pulse fires", fired == true)
	local samples = {}
	for _, t in { 0.1, 0.35, 0.7, 1.2 } do
		task.wait(t - (samples.t or 0))
		samples.t = t
		local s = ask(p, "stats")
		table.insert(samples, s and s.lines.lit or -1)
	end
	log("lit over time: " .. table.concat(samples, ", "))
	check("outline appears progressively (grows over time)", samples[1] < samples[2] and samples[2] <= samples[3] and samples[3] > 0, table.concat(samples, ","))
	local tr = ask(p, "trace")
	if tr and tr.trace and #tr.trace > 20 then
		local n = #tr.trace
		local early, late = 0, 0
		local k = math.max(1, n // 10)
		for i = 1, k do
			early += tr.trace[i][2]
			late += tr.trace[n - k + i][2]
		end
		early /= k
		late /= k
		local lastT = tr.trace[n][1]
		check("near structures revealed first, far last", early < late - 8, string.format("first10%%=%.1f last10%%=%.1f studs", early, late))
		check("wave reaches the far edge in ~R/speed", lastT > 0.5 and lastT < 1.4, string.format("%.2fs", lastT))
		-- 시간과 거리의 관계: 늦게 나타난 선일수록 멀다
		local monotone = 0
		for i = 2, n do
			if tr.trace[i][2] + 1.5 >= tr.trace[i - 1][2] then
				monotone += 1
			end
		end
		check("reveal order follows distance", monotone / (n - 1) > 0.97, string.format("%.3f", monotone / (n - 1)))
		R.info.pulse = { revealed = n, lastT = lastT }
	else
		check("pulse trace recorded", false, tr and #tr.trace)
	end
	task.wait(0.6) -- t≈1.8
	local mid = ask(p, "stats")
	check("outline still visible ~1.8s after the pulse", mid and mid.lines.lit > 0, mid and mid.lines.lit)
	task.wait(Config.Sonar.Hold - 0.4) -- t≈Hold+1.4 (가장 먼 선은 0.9초에 나타나 Hold초 뒤 사라짐)
	-- (Studio 창이 뒤에 있으면 화면 갱신이 느려져 선이 늦게 꺼질 수 있다: 최대 4초 더 기다린다)
	local after = ask(p, "stats")
	waitFor(function()
		after = ask(p, "stats")
		return after and after.lines.lit == 0 and after.lines.active == 0
	end, 4)
	check("outline gone again (~Hold s after reveal)", after and after.lines.lit == 0 and after.lines.active == 0, after and (after.lines.lit .. "/" .. after.lines.active))
	-- 방 안쪽 모서리까지 바닥 선이 끊기지 않고 닿는다(시작 방 오른쪽 위 모서리: 북쪽 벽과 동쪽 벽이 만나는 곳)
	local corner = Vector3.new(32, 0, 8)
	local ends = ask(p, "floorEndsNear", { corner, 0.3 }) or 0
	check("floor lines reach the inner corner (no gap)", ends >= 2, ends)
	-- 지도(Q): 내 음파가 닿은 곳은 선이 사라진 뒤에도 지도에 남는다
	local mp = ask(p, "map")
	check("map records where my sonar reached", mp and mp.explored > 5 and mp.lines > 5, mp and (mp.explored .. " tiles, " .. mp.lines .. " lines"))
	local opened = ask(p, "toggleMap")
	task.wait(0.3)
	local mp2 = ask(p, "map")
	check("Q opens the map with my position", opened and opened.open and mp2 and mp2.meShown, mp2 and tostring(mp2.meShown))
	local closed = ask(p, "toggleMap")
	check("Q closes the map", closed and not closed.open)

	-- 5. 벽·닫힌 문 너머는 보이지 않는다
	local pillar = tile(8, 3, 0)
	local pillarSegs = ask(p, "segsNear", { pillar + Vector3.new(0, 6, 0), 3.5 }) or {}
	check("pillar behind the door has outline segments", #pillarSegs > 4, #pillarSegs)
	local door
	for _, d in Doors.all() do
		if (d.panel.Position - tile(5, 3, 4.5)).Magnitude < 4 then
			door = d
		end
	end
	check("test door found", door ~= nil)
	local function revealedFrom(pos)
		ask(p, "resetCooldown")
		place(p, pos, pillar + Vector3.new(0, 3, 0))
		task.wait(0.4)
		ask(p, "fire")
		task.wait(1.3)
		local t = ask(p, "trace")
		local set = {}
		for _, e in (t and t.trace) or {} do
			set[e[3]] = true
		end
		local hits = 0
		for _, id in pillarSegs do
			if set[id] then
				hits += 1
			end
		end
		return hits, (t and #t.trace) or 0
	end
	if door then
		if door.open then
			Doors.toggle(door)
			task.wait(0.8)
		end
		local hits, total = revealedFrom(Vector3.new(29, 3, 20))
		check("closed door: structures behind it are NOT revealed", hits == 0 and total > 50, "pillar hits=" .. hits .. " total=" .. total)
		Doors.toggle(door)
		task.wait(0.9)
		local hits2, total2 = revealedFrom(Vector3.new(29, 3, 20))
		check("open door: the wave passes through the doorway", hits2 > 0, "pillar hits=" .. hits2 .. " total=" .. total2)
		Doors.toggle(door)
		task.wait(0.8)
	end
	-- 두꺼운 벽 너머(옆방)도 보이지 않는다: 시작 방 동쪽 8스터드 벽 너머 방의 북쪽 벽면(직선 거리 32, 문을 돌아가면 36 이상)
	do
		local crate = Vector3.new(44, 12.5, 9.5) -- (북쪽 벽-천장 모서리와 경사)
		local segs = ask(p, "segsNear", { crate, 3.5 }) or {}
		ask(p, "resetCooldown")
		place(p, tile(2, 2, 3), crate)
		task.wait(0.4)
		ask(p, "fire")
		task.wait(1.3)
		local t = ask(p, "trace")
		local set = {}
		for _, e in (t and t.trace) or {} do
			set[e[3]] = true
		end
		local hits = 0
		for _, id in segs do
			if set[id] then
				hits += 1
			end
		end
				check("room behind a wall is not revealed", #segs > 0 and hits == 0, "segs=" .. #segs .. " hits=" .. hits)
	end

	-- 6. 서버의 발사 간격 검증
	task.wait(1.6)
	local Main = _G.SonarMaze
	local before = Main.Sonar.accepted[p] or 0
	ask(p, "rawFire")
	task.wait(0.15)
	ask(p, "rawFire")
	task.wait(0.15)
	ask(p, "rawFire")
	task.wait(1.0) -- (서버에 도착할 여유. 첫 발사 후 1.3초: 아직 간격 안)
	local mid1 = Main.Sonar.accepted[p] or 0
	task.wait(0.5)
	ask(p, "rawFire")
	task.wait(1.0)
	local mid2 = Main.Sonar.accepted[p] or 0
	check("server enforces the 1.5s pulse interval", mid1 - before == 1 and mid2 - mid1 == 1, string.format("burst accepted %d, after 1.8s %d", mid1 - before, mid2 - mid1))

	-- 13. 반복 발사해도 쌓이지 않는다
	task.wait(2.5)
	local function burst()
		for _ = 1, 12 do
			ask(p, "pulseAt", root(p).Position + Vector3.new(0, 1.5, 0))
			task.wait(0.25)
		end
	end
	burst()
	local s1 = ask(p, "stats")
	task.wait(Config.Sonar.Hold + 1)
	local s1b = ask(p, "stats")
	waitFor(function() s1b = ask(p, "stats") return s1b and s1b.lines.active == 0 end, 5) -- (Studio 창이 뒤에 있으면 선이 늦게 꺼진다)
	burst()
	local s2 = ask(p, "stats")
	task.wait(Config.Sonar.Hold + 1)
	local s3 = ask(p, "stats")
	waitFor(function() s3 = ask(p, "stats") return s3 and s3.lines.active == 0 end, 5)
	log(string.format("burst lines: active %d created %d / after %d / burst2 active %d created %d / after %d", s1.lines.active, s1.lines.created, s1b.lines.active, s2.lines.active, s2.lines.created, s3.lines.active))
	check("repeated pulses reuse lines (no pile-up)", s2.lines.created <= s1.lines.created * 1.15 + 20 and s2.lines.active < Config.Sonar.PoolSize, string.format("created %d -> %d, active %d", s1.lines.created, s2.lines.created, s2.lines.active))
	check("all lines released after the burst", s1b.lines.active == 0 and s3.lines.active == 0, s3.lines.active)

	-- 7. 걷기·달리기·웅크리기
	local speeds = {}
	for _, m in { "Run", "Crouch", "Walk" } do
		ask(p, "setMode", m)
		task.wait(0.5)
		local s = ask(p, "stats")
		local hum = p.Character:FindFirstChildOfClass("Humanoid")
		speeds[m] = { s and s.walkSpeed, p.Character:GetAttribute("MoveMode"), hum.WalkSpeed }
	end
	ask(p, "setMode", nil)
	check("run speed 18 (client+server)", speeds.Run[1] == 18 and speeds.Run[2] == "Run" and speeds.Run[3] == 18, table.concat({ tostring(speeds.Run[1]), tostring(speeds.Run[2]) }, " "))
	check("crouch speed 5", speeds.Crouch[1] == 5 and speeds.Crouch[2] == "Crouch", tostring(speeds.Crouch[1]))
	check("walk speed 10", speeds.Walk[1] == 10 and speeds.Walk[2] == "Walk", tostring(speeds.Walk[1]))
	-- 실제로 걸어서 발소리 소음이 나는가(서버가 속도로 판정)
	place(p, tile(2, 6, 3), tile(2, 8, 3))
	task.wait(0.3)
	local n0 = #SoundBus.recent
	ask(p, "setMode", "Run")
	ask(p, "move", tile(2, 8, 3))
	task.wait(1.0)
	local kinds = {}
	for i = n0 + 1, #SoundBus.recent do
		kinds[SoundBus.recent[i].kind] = true
	end
	ask(p, "setMode", nil)
	check("running makes loud footstep noise (server-measured)", kinds.StepRun == true, (function()
		local t = {}
		for k in kinds do
			table.insert(t, k)
		end
		return table.concat(t, ",")
	end)())

	-- 발소리는 한 발짝씩: 걷기(10/초)로 16스터드 → 약 3발(파일 하나에 여러 발짝이 들어 있어 잘라서 한 발만)
	place(p, tile(2, 6, 3), tile(2, 8, 3))
	task.wait(0.4)
	local st0 = ask(p, "stats")
	ask(p, "move", tile(2, 8, 3))
	task.wait(2.2)
	local st1 = ask(p, "stats")
	local steps = (st1 and st0) and (st1.steps - st0.steps) or -1
	check("footsteps: about one sound per step while walking (~2 per second)", steps >= 2 and steps <= 5, steps)

	-- 실제 녹음 소리가 이 게임에서 불러와진다(라이선스 효과음)
	local sc = ask(p, "soundCheck")
	local zero = 0
	for _, l in (sc and sc.lengths) or {} do
		if l <= 0 then
			zero += 1
		end
	end
	check("licensed sounds load (screams + monster steps)", sc and #sc.bad == 0 and zero == 0, sc and (table.concat(sc.bad, ", ") .. " lengths " .. table.concat(sc.lengths, "/")))

	-- 점프: 뛰어오르고, 착지 소리를 괴물이 들을 수 있다
	do
		place(p, tile(2, 6, 3), tile(2, 8, 3))
		task.wait(0.6)
		local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local y0 = r and r.Position.Y or 0
		local n0 = #SoundBus.recent
		ask(p, "jump")
		local peak = y0
		local t0 = os.clock()
		while os.clock() - t0 < 1.4 do
			if r then
				peak = math.max(peak, r.Position.Y)
			end
			task.wait()
		end
		local landed = false
		for i = n0 + 1, #SoundBus.recent do
			if SoundBus.recent[i].kind == "StepLand" then
				landed = true
			end
		end
		check("players can jump", peak - y0 > 1.5, string.format("%.1f studs", peak - y0))
		check("landing makes a noise monsters can hear", landed)
	end

	-- 소리 감쇠
	local a, b = tile(2, 3, 3), tile(2, 5, 3) -- 시작 방과 그 아래(벽 사이)
	local walls = SoundBus.wallsBetween(a, b)
	check("sound attenuation counts walls between", walls >= 1, walls)
	check("hearing ranges: crouch 4 < walk 10 < run 25 < sonar 45", Config.Noise.Crouch == 4 and Config.Noise.Walk == 10 and Config.Noise.Run == 25 and Config.Noise.Sonar == 45)

	-- 8~9. 괴물: 소리 감지 → 이동(벽 통과 없음)
	local m = Round.monsters[1]
	check("monster exists", m ~= nil)
	if not m then
		return
	end
	-- 플레이어는 멀리(출구 쪽 반대 구석)
	place(p, tile(2, 3, 3))
	local geo = stage:FindFirstChild("Geometry")
	local wallParams = RaycastParams.new()
	wallParams.FilterType = Enum.RaycastFilterType.Include
	wallParams.FilterDescendantsInstances = { geo }
	wallParams.RespectCanCollide = true
	local startNode = tile(10, 16, 5.2)
	local soundAt = tile(15, 16, 4.5)
	m.model:PivotTo(CFrame.new(startNode))
	m.waypoints = {}
	m:setState("Wander")
	m.startAt = 0
	task.wait(0.5)
	-- (큰 맵에서는 경로 계산이 길어 순간이동 전에 시작한 계산이 끝나며 움직일 수 있다: 한 번 더 제자리에 세운다)
	m.model:PivotTo(CFrame.new(startNode))
	m.waypoints = {}
	m.legGoal = nil
	m.hum:MoveTo(startNode)
	SoundBus.emit(soundAt, Config.Noise.Sonar, nil, "Sonar")
	local heard = waitFor(function()
		return m.state == "Alert" or m.state == "Investigate"
	end, 2)
	check("monster reacts to a sonar pulse 40 studs away", heard ~= nil, m.state)
	local prev = m.root.Position
	local through = 0
	local maxStep = 0
	local reached = waitFor(function()
		local cur = m.root.Position
		local d = cur - prev
		if d.Magnitude > 0.05 then
			maxStep = math.max(maxStep, d.Magnitude)
			local hit = workspace:Raycast(prev, d, wallParams)
			if hit then
				through += 1
			end
		end
		prev = cur
		return (cur - soundAt).Magnitude < 7 or m.state == "Search"
	end, 25)
	check("monster walks to the sound position", reached ~= nil, string.format("dist=%.1f state=%s", (m.root.Position - soundAt).Magnitude, m.state))
	check("monster never passes through walls", through == 0, "crossings=" .. through .. " maxStep=" .. string.format("%.2f", maxStep))
	-- 수색 → 배회 복귀
	local searching = waitFor(function()
		return m.state == "Search"
	end, 5)
	check("monster searches around the sound", searching ~= nil, m.state)
	R.info.monsterLog = m.log

	-- 걷는 소리는 가까이에서만 들린다
	m:setState("Wander")
	m.waypoints = {}
	local mp = m.root.Position
	local far = mp + Vector3.new(30, 0, 0)
	check("monster does not hear walking 30 studs away", not SoundBus.canHear(far, mp, Config.Noise.Walk))

	-- 큰 맵: 멀리 돌아가야 하는 곳도 타일 경로를 구간으로 나눠 실제로 찾아간다
	do
		local goal = Round.info.exitCFrame.Position - Vector3.new(0, 3.5, 0)
		local startN, startLen = nil, 0
		for _, n in Round.info.nodes do
			local r = Round.info.route(n - Vector3.new(0, 3, 0), goal, true)
			if r and #r >= 30 and #r <= 60 and (n - goal).Magnitude < #r * 8 * 0.6 then
				startN, startLen = n, #r
				break
			end
		end
		if startN then
			m.model:PivotTo(CFrame.new(startN + Vector3.new(0, 2.2, 0)))
			m.waypoints = {}
			m.legGoal = nil
			m:setState("Investigate")
			m.goal = goal
			m.searchCenter = goal
			task.wait(20) -- (조사 속도 5.5: 20초면 약 13칸)
			local r = Round.info.route(m.root.Position - Vector3.new(0, 4.5, 0), goal, true)
			local left = if r then #r else startLen
			check("monster follows a long winding route (route legs)", left <= startLen - 8, string.format("route %d -> %d tiles, state %s", startLen, left, m.state))
		else
			check("monster follows a long winding route (route legs)", false, "no suitable start node")
		end
		m.waypoints = {}
		m.legGoal = nil
		m:setState("Wander")
	end

	-- 12. 열쇠: 상자·서랍 중 한 곳에 있고, 없으면 출구가 잠겨 있다
	m.startAt = 1e9
	m:setState("Wander")
	Config.Key.Required = true
	local spotsZ = Search.all()
	check("searchable boxes/drawers built", #spotsZ >= 5, #spotsZ)
	local ks, ki = Search.keySpot()
	check("exactly one of them holds the key", ks ~= nil and ki ~= nil)
	place(p, Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
	task.wait(1.2)
	check("exit is locked without the key", p:GetAttribute("Status") == "Alive" and ReplicatedStorage:GetAttribute("HasKey") ~= true, p:GetAttribute("Status"))
	local kh0 = ask(p, "keyHud")
	check("key indicator shows no key", kh0 and kh0.visible and kh0.text:find("없음", 1, true) ~= nil, kh0 and kh0.text)
	local empty = nil
	for _, sp in spotsZ do
		if not sp.hasKey then
			empty = sp
			break
		end
	end
	if empty then
		place(p, empty.front + Vector3.new(0, 3, 0), empty.center + Vector3.new(0, 3, 0))
		task.wait(0.3)
		-- 서랍(뚜껑)마다 따로 열고 닫는다: 처음 열면 뒤짐(비어 있음), 닫고 다시 열 수 있다
		local r1 = Search.toggle(p, empty, 1)
		local r2 = Search.toggle(p, empty, 1)
		local r3 = Search.toggle(p, empty, 1)
		check("a drawer opens (empty), closes, and opens again", r1 == "empty" and r2 == "closed" and r3 == "opened", r1 .. "/" .. r2 .. "/" .. r3)
		local allOpen = true
		for i = 2, #empty.comps do
			Search.toggle(p, empty, i)
		end
		for _, c in empty.comps do
			allOpen = allOpen and c.open
		end
		check("every drawer of a cabinet can be opened", allOpen, #empty.comps)
		local fwd = (empty.front - empty.center).Unit
		local c1 = empty.comps[1]
		local moved = c1.model:GetPivot().Position - c1.closedPivot.Position
		check("an opened drawer/lid moves toward the player, not sideways", (moved:Dot(fwd) > 0.4 or moved.Y > 0.4) and math.abs(moved:Dot(Vector3.new(fwd.Z, 0, -fwd.X))) < 0.2, string.format("fwd %.2f side %.2f up %.2f", moved:Dot(fwd), moved:Dot(Vector3.new(fwd.Z, 0, -fwd.X)), moved.Y))
		for i = 1, #empty.comps do
			Search.toggle(p, empty, i)
		end
		local allClosed = true
		for _, c in empty.comps do
			allClosed = allClosed and not c.open
		end
		check("every drawer closes again", allClosed)
		-- 조준점으로 보고 E(클라이언트 경로)
		local c1pos = c1.model:GetPivot().Position
		place(p, c1pos + fwd * 3.2 + Vector3.new(0, 1.2, 0), c1pos)
		task.wait(0.6)
		local tgt = ask(p, "lookTarget", c1pos)
		check("crosshair on a drawer targets it", tgt ~= nil and tgt.spot == empty.id, tgt and (tgt.spot .. ":" .. tgt.comp))
		local wasOpen = tgt and empty.comps[tgt.comp].open
		ask(p, "useLook", c1pos)
		local toggled = waitFor(function()
			return tgt and empty.comps[tgt.comp].open ~= wasOpen
		end, 3)
		check("E while looking opens/closes that drawer", toggled ~= nil)
	end
	if ks and ki then
		place(p, ks.front + Vector3.new(0, 3, 0))
		task.wait(0.3)
		local r3 = Search.toggle(p, ks, ki)
		check("searching the right one finds the key (whole team)", r3 == "key" and ReplicatedStorage:GetAttribute("HasKey") == true, r3)
		task.wait(0.4)
		local kh1 = ask(p, "keyHud")
		check("key indicator shows the key", kh1 and kh1.text:find("있음", 1, true) ~= nil, kh1 and kh1.text)
	end

	-- 13. 출구 → 탈출 → STAGE CLEAR
	place(p, Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
	local esc = waitFor(function()
		return p:GetAttribute("Status") == "Escaped"
	end, 3)
	check("reaching the exit escapes", esc ~= nil, p:GetAttribute("Status"))
	Config.Key.Required = false
	local cleared = waitFor(function()
		return Round.lastOutcome == "Clear"
	end, 4)
	check("stage clear when all survivors escaped", cleared ~= nil, Round.lastOutcome)
	check("clear advances to the next stage", Round.stageIndex == 2 or (Round.stageIndex == 1 and #Config.Stages >= 1), Round.stageIndex)
	Round.stageIndex = 1 -- (사망 시험은 스테이지 1 좌표로)
	task.wait(0.8)
	local ui = ask(p, "stats")
	check("STAGE CLEAR screen shown", ui and ui.ui.overlayTitle == "STAGE CLEAR", ui and ui.ui.overlayTitle)

	-- 10. 다음 라운드에서 잡히기 → 사망 → (혼자) 재시작
	Round.lastOutcome = ""
	local again = readyPlayers(1)
	check("next round starts and player respawns", again ~= nil, ReplicatedStorage:GetAttribute("StageName"))
	if not again then
		return
	end
	local m2 = Round.monsters[1]
	-- 직선 통로에서 12스터드 떨어져 마주 본다
	place(p, tile(3, 10, 3), tile(6, 10, 3))
	m2.model:PivotTo(CFrame.lookAt(tile(5, 10, 5.2) - Vector3.new(4, 0, 0), tile(3, 10, 5.2)))
	m2.waypoints = {}
	m2.startAt = 0
	local chased = waitFor(function()
		return m2.state == "Chase"
	end, 3)
	check("monster spots a nearby player and chases", chased ~= nil, m2.state)
	local died = waitFor(function()
		return p:GetAttribute("Status") == "Dead"
	end, 8)
	check("caught by the monster -> death", died ~= nil, p:GetAttribute("Status"))
	local js = waitFor(function()
		local x = ask(p, "jumpscare")
		return x and x.count > 0 and x
	end, 2)
	check("jump scare: the monster face pops up when caught", js ~= nil, js and js.count)
	task.wait(1.8)
	local dui = ask(p, "stats")
	check("YOU DIED screen shown", dui and dui.ui.overlayTitle == "YOU DIED", dui and dui.ui.overlayTitle)
	local failed = waitFor(function()
		return Round.lastOutcome == "Failed"
	end, 4)
	check("solo death restarts the stage", failed ~= nil, Round.lastOutcome)
	local back = readyPlayers(1)
	check("respawned after restart", back ~= nil)
	local fs = ask(p, "stats")
	R.info.frame = fs and { avg = fs.avgFrame, worst = fs.worstFrame }
	if back then
		doorTests(p)
		monsterTests(p)
		hideTests(p)
	end
end

-- ─────────────────────────────── multi ───────────────────────────────
local function multi()
	local want = tonumber(args.Players) or 2
	local ps = readyPlayers(want)
	check("all " .. want .. " players spawned with sonar ready", ps ~= nil, #Players:GetPlayers())
	if not ps then
		return
	end
	-- 모두 시작 방 근처에 모은다
	for k, p in ps do
		place(p, tile(2 + (k - 1) % 3, 2 + (k - 1) // 3 * 2, 3))
	end
	task.wait(1)
	local base = {}
	for _, p in ps do
		base[p] = ask(p, "stats").pulsesStarted
		ask(p, "resetPerf")
	end
	local rounds = 6
	for _ = 1, rounds do
		for _, p in ps do
			task.spawn(ask, p, "fire")
		end
		task.wait(1.7)
	end
	task.wait(Config.Sonar.Hold + 1)
	local worst, sumAvg = 0, 0
	local luaAvg, luaWorst = 0, 0
	local at60 = 0
	for _, p in ps do
		local s = ask(p, "stats")
		local got = s.pulsesStarted - base[p]
		check(p.Name .. " saw own + others' pulses", got >= rounds * #ps * 0.9, got .. "/" .. rounds * #ps)
		check(p.Name .. " lines released afterwards", s.lines.active == 0, s.lines.active)
		worst = math.max(worst, s.worstFrame)
		sumAvg += s.avgFrame
		luaAvg += s.lua.avg
		luaWorst = math.max(luaWorst, s.lua.worst)
		-- 60fps 기준 추정: 파동 전파는 경과 시간만큼 일하므로 프레임 시간 비율로 줄이고, 선 갱신은 프레임마다 그대로
		at60 += s.prof.pulsesMs * math.min(1, (1 / 60) / math.max(s.avgFrame, 1e-3)) + s.prof.linesMs
		R.info[p.Name] = { avgFrame = s.avgFrame, worstFrame = s.worstFrame, created = s.lines.created }
	end
	-- (Studio 테스트 창은 모두 비활성 창이라 15fps 로 묶인다: 화면 프레임 대신 음파 스크립트 비용을 본다)
	-- (Studio 비활성 창은 약 15fps: 한 프레임에 60fps 네 프레임 분량의 파동을 처리하므로 60fps 기준으로 환산해 본다)
	check("sonar script cost with " .. #ps .. " players pulsing together < 4ms/frame at 60fps", at60 / #ps < 4, string.format("~%.2fms at 60fps (measured %.2fms avg, worst %.2fms, at %.1fms frames)", at60 / #ps, luaAvg / #ps * 1000, luaWorst * 1000, sumAvg / #ps * 1000))
	-- 한 명이 죽으면 관전, 나머지는 계속
	local victim = ps[1]
	Round.kill(victim, "test")
	task.wait(3)
	local s = ask(victim, "stats")
	check("dead player spectates a teammate", s and s.ui.spectate ~= nil and s.ui.spectate:find("관전 중") ~= nil, s and s.ui.spectate)
	check("round continues while others live", Round.state == "Playing")
	-- 남은 사람 탈출 → 클리어
	for k = 2, #ps do
		place(ps[k], Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
		task.wait(0.4)
	end
	local cleared = waitFor(function()
		return Round.lastOutcome == "Clear"
	end, 5)
	check("survivors escape -> stage clear (with one dead)", cleared ~= nil, Round.lastOutcome)
end

-- ─────────────────────────────── perf ───────────────────────────────
local function perf()
	local ps = readyPlayers(tonumber(args.Players) or 1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	place(p, tile(3, 3, 3), tile(3, 6, 3))
	task.wait(2)
	ask(p, "resetPerf")
	task.wait(3)
	local idle = ask(p, "stats")
	ask(p, "resetPerf")
	for _ = 1, 4 do
		for _, q in ps do
			ask(q, "resetCooldown")
			task.spawn(ask, q, "fire")
		end
		task.wait(1.55)
	end
	local busy = ask(p, "stats")
	R.info.perf = {
		idleFrameMs = idle.avgFrame * 1000, idleWorstMs = idle.worstFrame * 1000, idleLuaMs = idle.lua.avg * 1000,
		busyFrameMs = busy.avgFrame * 1000, busyWorstMs = busy.worstFrame * 1000, busyLuaMs = busy.lua.avg * 1000, busyLuaWorstMs = busy.lua.worst * 1000,
		lines = busy.lines,
	}
	check("sonar script cost per frame (avg) < 4ms", busy.lua.avg < 0.004, string.format("%.2fms avg, %.2fms worst", busy.lua.avg * 1000, busy.lua.worst * 1000))
end

-- ─────────────────────────────── load ───────────────────────────────
-- 스테이지마다: 서버 빌드 시간, 클라이언트 음파 월드 빌드 시간, 괴물이 움직이는 20초 동안 서버 프레임·경로 계산·클라이언트 음파 비용
local Monster = require(script.Parent.Monster)
local function load()
	local ps = readyPlayers(1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	local all = {}
	for i = 1, #Config.Stages do
		Round.startStage(i)
		local t0 = os.clock()
		readyPlayers(1)
		local built = waitFor(function()
			local st = ask(p, "stats")
			return st and st.buildId == stageFolder():GetAttribute("BuildId") and st.build.seconds > 0 and st
		end, 30)
		local readyIn = os.clock() - t0
		-- 몬스터가 움직이는 동안(플레이어는 시작 방, 음파를 주기적으로)
		local hb = {}
		local conn = RunService.Heartbeat:Connect(function(dt)
			table.insert(hb, dt)
		end)
		local s0 = { calls = Monster.stats.pathCalls, wall = Monster.stats.pathWall, ticks = Monster.stats.ticks }
		ask(p, "resetPerf")
		local mpos0 = {}
		for k, m in Round.monsters do
			mpos0[k] = m.root.Position
			m.startAt = 0 -- (테스트는 괴물을 멈춰 두므로 여기서는 실제처럼 움직이게)
			m.lastHunt = os.clock() - Config.Monster.HuntEvery + 5
		end
		for _, d in Round.doppels do
			d.startAt = 0 -- (도플갱어도 사람 모습으로 돌아다니게)
		end
		for _ = 1, 10 do
			ask(p, "resetCooldown")
			ask(p, "fire")
			task.wait(2)
		end
		conn:Disconnect()
		local st = ask(p, "stats")
		local sum, worst = 0, 0
		for _, d in hb do
			sum += d
			worst = math.max(worst, d)
		end
		local calls = Monster.stats.pathCalls - s0.calls
		local moved, states = {}, {}
		for k, m in Round.monsters do
			table.insert(moved, math.floor((m.root.Position - (mpos0[k] or m.root.Position)).Magnitude))
			table.insert(states, m.state .. (if m.startAt > os.clock() then "(waiting)" else ""))
		end
		local r = {
			stage = i,
			serverBuildMs = math.floor(Round.lastBuildMs),
			readySec = math.floor(readyIn * 10) / 10,
			clientBuildSec = built and math.floor(built.build.seconds * 100) / 100,
			clientBuildCpuSec = built and math.floor(built.build.cpu * 100) / 100,
			segs = built and built.build.segs,
			serverFrameMs = math.floor(sum / math.max(1, #hb) * 10000) / 10,
			serverWorstMs = math.floor(worst * 10000) / 10,
			pathCallsPerSec = math.floor(calls / 20 * 10) / 10,
			pathAvgMs = if calls > 0 then math.floor((Monster.stats.pathWall - s0.wall) / calls * 10000) / 10 else 0,
			clientLuaMs = st and math.floor(st.lua.avg * 100000) / 100,
			clientLuaWorstMs = st and math.floor(st.lua.worst * 100000) / 100,
			pulsesMs = st and math.floor(st.prof.pulsesMs * 100) / 100,
			linesMs = st and math.floor(st.prof.linesMs * 100) / 100,
			alive = p:GetAttribute("Status"),
			ticksPerSec = math.floor((Monster.stats.ticks - s0.ticks) / 20),
			monsterMoved = table.concat(moved, ","),
			monsterStates = table.concat(states, ","),
			monsterLog = Round.monsters[1] and table.concat(Round.monsters[1].log, " | "):sub(-300) or "",
		}
		table.insert(all, r)
		log(HttpService:JSONEncode(r))
		check(string.format("stage %d: client sonar world ready", i), built ~= nil, r.clientBuildSec)
	end
	R.info.load = all
end

-- ─────────────────────────────── lobby (2인) ───────────────────────────────
-- 로비에서 시작 → 음파로 로비가 보인다 → P1 방 만들기(버튼) → P2 참가(버튼)·나가기·재참가 → 방장만 시작 →
-- 두 사람 모두 1스테이지 → 함께 탈출해 2스테이지 → 마지막 스테이지를 깨면 로비로 돌아온다
local function lobbyTest()
	local LobbyMod = require(script.Parent.Lobby)
	local want = tonumber(args.Players) or 2
	local ps = waitFor(function()
		local all = Players:GetPlayers()
		if #all < want or Round.state ~= "Lobby" then
			return nil
		end
		for _, q in all do
			if q:GetAttribute("Status") ~= "Alive" or not (q.Character and q.Character:FindFirstChild("HumanoidRootPart")) then
				return nil
			end
		end
		return all
	end, 60)
	check("server starts in the lobby with everyone inside", ps ~= nil, Round.state .. " " .. #Players:GetPlayers())
	if not ps then
		return
	end
	local p1, p2 = ps[1], ps[2]
	local function built(p)
		return waitFor(function()
			local st = ask(p, "stats")
			return st and st.buildId == stageFolder():GetAttribute("BuildId") and st.build.segs > 0 and st
		end, 25)
	end
	local b1, b2 = built(p1), built(p2)
	check("both clients see the lobby through sonar (outlines built)", b1 ~= nil and b2 ~= nil and b1.build.segs > 100, b1 and b1.build.segs)
	check("no monsters in the lobby", #Round.monsters == 0, #Round.monsters)
	task.wait(0.5)
	ask(p1, "resetCooldown")
	ask(p1, "fire")
	task.wait(1.2)
	local lit = ask(p1, "stats")
	check("sonar lights up the lobby", lit and lit.lines.lit > 50, lit and lit.lines.lit)
	-- 작은 로비: 음파 한 번으로 방 거의 전부(벽 아닌 칸의 90% 이상)가 닿아야 한다(지도에 기록된 칸으로 잰다)
	do
		local rows = string.split(stageFolder():GetAttribute("Rows"), "/")
		local open = 0
		for _, row in rows do
			for k = 1, #row do
				if string.sub(row, k, k) ~= "#" then
					open += 1
				end
			end
		end
		local mp = nil
		waitFor(function()
			mp = ask(p1, "map")
			return mp ~= nil and mp.explored >= open * 0.9
		end, 6)
		check("one sonar pulse shows almost the whole lobby (>= 90% of tiles)", mp ~= nil and mp.explored >= open * 0.9, string.format("%s/%d tiles", tostring(mp and mp.explored), open))
	end
	local u = ask(p1, "lobby")
	check("room panel shown in the lobby", u and u.visible and table.find(u.buttons, "방 만들기") ~= nil, u and table.concat(u.buttons, ","))
	local c0 = ask(p1, "cursor")
	check("cursor hidden while looking around", c0 == false, tostring(c0))
	local m = ask(p1, "lobbyMenu", true)
	check("Tab menu frees the mouse", m and m.mouseFree == true)
	task.wait(0.2)
	local c1 = ask(p1, "cursor")
	check("cursor shown only while the menu is open", c1 == true, tostring(c1))
	ask(p1, "lobbyClick", "방 만들기")
	local id = waitFor(function()
		return p1:GetAttribute("RoomId")
	end, 5)
	check("P1 creates a room (button)", id ~= nil, tostring(id))
	local joinText = "참가 " .. tostring(id)
	-- 친구만: 방장이 켜면 친구가 아닌 P2 는 못 들어오고, 끄면 들어온다
	ask(p1, "lobbyClick", "친구만 켜기")
	waitFor(function()
		local x = ask(p1, "lobby")
		return x and table.find(x.buttons, "친구만 끄기") ~= nil
	end, 5)
	waitFor(function()
		local x = ask(p2, "lobby")
		return x and table.find(x.buttons, joinText) ~= nil
	end, 5)
	ask(p2, "lobbyClick", joinText)
	task.wait(1)
	local fm = ask(p2, "lobby")
	check("friends-only room keeps non-friends out", p2:GetAttribute("RoomId") == nil and fm and fm.message:find("친구", 1, true) ~= nil, fm and fm.message)
	ask(p1, "lobbyClick", "친구만 끄기")
	waitFor(function()
		local x = ask(p1, "lobby")
		return x and table.find(x.buttons, "친구만 켜기") ~= nil
	end, 5)
	local inv = ask(p1, "lobby")
	check("invite-friends button in the lobby", inv and table.find(inv.buttons, "친구 초대") ~= nil, inv and table.concat(inv.buttons, ","))
	local seen = waitFor(function()
		local x = ask(p2, "lobby")
		return x and x.rooms == 1 and table.find(x.buttons, joinText) ~= nil and x
	end, 5)
	check("P2 sees the room with a join button", seen ~= nil, seen and table.concat(seen.buttons, ","))
	ask(p2, "lobbyClick", joinText)
	check("P2 joins the room (button)", waitFor(function()
		return p2:GetAttribute("RoomId") == id
	end, 5) ~= nil)
	local u1 = waitFor(function()
		local x = ask(p1, "lobby")
		return x and x.title:find(p2.DisplayName, 1, true) and x
	end, 5)
	check("P1 sees P2 in the room", u1 ~= nil, u1 and u1.title)
	local u2 = ask(p2, "lobby")
	check("only the host has a start button", u1 and table.find(u1.buttons, "시작") ~= nil and u2 and table.find(u2.buttons, "시작") == nil, u2 and table.concat(u2.buttons, ","))
	ask(p2, "lobbyClick", "나가기")
	check("P2 can leave the room", waitFor(function()
		return p2:GetAttribute("RoomId") == nil
	end, 5) ~= nil)
	waitFor(function()
		local x = ask(p2, "lobby")
		return x and table.find(x.buttons, joinText) ~= nil
	end, 5)
	ask(p2, "lobbyClick", joinText)
	check("P2 joins again", waitFor(function()
		return p2:GetAttribute("RoomId") == id
	end, 5) ~= nil)
	LobbyMod.act(p2, "start")
	task.wait(0.8)
	check("a non-host cannot start", Round.state == "Lobby", Round.state)
	-- 방장이 시작
	task.wait(0.5)
	ask(p1, "lobbyClick", "시작")
	local started = waitFor(function()
		return Round.state == "Playing" and Round.stageIndex == 1
	end, 20)
	check("host presses start: stage 1 begins", started ~= nil, Round.state)
	local both = waitFor(function()
		for _, q in { p1, p2 } do
			if q:GetAttribute("Status") ~= "Alive" or not (q.Character and q.Character:FindFirstChild("HumanoidRootPart")) then
				return nil
			end
		end
		return true
	end, 15)
	check("both players are in stage 1", both ~= nil, tostring(p1:GetAttribute("Status")) .. "/" .. tostring(p2:GetAttribute("Status")))
	check("stage 1 has its monsters", #Round.monsters == Config.Stages[1].Monsters, #Round.monsters)
	local g1, g2 = built(p1), built(p2)
	check("both clients rebuilt sonar for stage 1", g1 ~= nil and g2 ~= nil and g1.build.segs > 20000, g1 and g1.build.segs)
	local lu = ask(p1, "lobby")
	check("room panel hidden during the game", lu and not lu.visible)
	task.wait(0.5)
	ask(p2, "resetCooldown")
	ask(p2, "fire")
	task.wait(1.2)
	local lit2 = ask(p2, "stats")
	check("P2's sonar works in the game", lit2 and lit2.lines.lit > 50, lit2 and lit2.lines.lit)
	-- 팀원은 음파 없이도 실제 아바타 윤곽선으로 보인다
	local mt1 = waitFor(function()
		local n = ask(p1, "mates")
		return n == 1 and n
	end, 5)
	local mt2 = ask(p2, "mates")
	check("teammates always shown as an outline of their avatar", mt1 == 1 and mt2 == 1, tostring(mt1) .. "/" .. tostring(mt2))
	-- 시야 공유: P2 의 음파가 P1 의 지도에도 남고, 지도에 팀원이 보인다
	local mp1 = nil
	waitFor(function()
		mp1 = ask(p1, "map")
		return mp1 ~= nil and mp1.explored > 5
	end, 8)
	check("teammate's echo is recorded on my map", mp1 and mp1.explored > 5, mp1 and mp1.explored)
	ask(p1, "toggleMap")
	task.wait(0.4)
	local mp1b = ask(p1, "map")
	check("teammate shown on my map", mp1b and mp1b.matesShown == 1, mp1b and mp1b.matesShown)
	ask(p1, "toggleMap")
	-- 함께 탈출 → 2스테이지
	for _, q in { p1, p2 } do
		place(q, Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
	end
	local next2 = waitFor(function()
		return Round.state == "Playing" and Round.stageIndex == 2 and p1:GetAttribute("Status") == "Alive" and p2:GetAttribute("Status") == "Alive"
	end, 20)
	check("both escape stage 1 together and play stage 2", next2 ~= nil, Round.state .. " " .. Round.stageIndex)
	-- 마지막 스테이지를 깬 것으로 하고 탈출 → 로비로(시작 지점에 세워지기를 기다린 뒤)
	task.wait(2)
	Round.stageIndex = #Config.Stages
	for _, q in { p1, p2 } do
		place(q, Round.info.exitCFrame.Position + Vector3.new(0, -0.5, 0))
	end
	local back = waitFor(function()
		return Round.state == "Lobby" and p1:GetAttribute("Status") == "Alive" and p2:GetAttribute("Status") == "Alive"
	end, 20)
	check("after the last stage both return to the lobby", back ~= nil, Round.state)
	check("rooms are cleared after the game", next(LobbyMod.rooms) == nil and p1:GetAttribute("RoomId") == nil)
	local lu2 = waitFor(function()
		local x = ask(p1, "lobby")
		return x and x.visible and x
	end, 5)
	check("room panel is back in the lobby", lu2 ~= nil)
end

-- ─────────────────────────────── dense ───────────────────────────────
-- 음파로 보여 줄 게 가장 많은 곳(스테이지마다 반경 안 파트가 가장 많은 바닥 칸)에서 음파를 계속 쏴 최악의 프레임을 잰다
local function dense()
	local ps = readyPlayers(1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	local out = {}
	local only = tonumber(args.Stage) or 0
	for i = 1, #Config.Stages do
		if only == 0 or only == i then
			Round.startStage(i)
			readyPlayers(1)
			waitFor(function()
				local st = ask(p, "stats")
				return st and st.buildId == stageFolder():GetAttribute("BuildId") and st.build.segs > 0
			end, 30)
			-- 가장 빽빽한 곳
			local best, bn = nil, -1
			local params = OverlapParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { stageFolder() }
			for k, n in Round.info.nodes do
				if k % 3 == 0 then
					local c = #workspace:GetPartBoundsInRadius(n, 30, params)
					if c > bn then
						best, bn = n, c
					end
				end
			end
			place(p, best + Vector3.new(0, 0, 0), best + Vector3.new(1, 0, 0))
			task.wait(1)
			ask(p, "resetPerf")
			for _ = 1, 8 do
				ask(p, "resetCooldown")
				ask(p, "fire")
				task.wait(Config.Sonar.Cooldown + 0.05)
			end
			task.wait(1)
			local st = ask(p, "stats")
			local r = { stage = i, parts = bn, luaAvg = math.floor(st.lua.avg * 100000) / 100, luaWorst = math.floor(st.lua.worst * 100000) / 100, frameWorst = math.floor(st.worstFrame * 10000) / 10, created = st.lines.created, stolen = st.lines.stolen, active = st.lines.active, pulsesMs = st.prof.pulsesMs, linesMs = st.prof.linesMs, segs = st.build.segs, maxColor = st.lines.maxColor, maxPlace = st.lines.maxPlace, dropped = st.lines.dropped }
			table.insert(out, r)
			log(HttpService:JSONEncode(r))
			check(string.format("stage %d dense spot: sonar worst frame cost < 8ms", i), r.luaWorst < 8, string.format("avg %.2f worst %.2f ms, created %d stolen %d dropped %d", r.luaAvg, r.luaWorst, r.created, r.stolen, st.lines.dropped or 0))
		end
	end
	R.info.dense = out
end

-- ─────────────────────────────── chase ───────────────────────────────
-- 스테이지마다: 메인 괴물이 쫓아올 때 그 스테이지 동작(팔 자세·튀어나가기)으로 실제로 다가오는가
local function chaseMotion()
	local ps = readyPlayers(1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	-- 쫓아올 때 팔 각도가 이만큼은 돼야 그 동작이다(1 머리 위로 휘젓기, 2 원으로 휘두르기, 3·5 앞으로 짚기, 4 팔 늘어짐 + 무릎 높이)
	local armMin = { 1.8, 1.5, 0.6, 0, 0.5 }
	for i = 1, 5 do
		-- (앞 스테이지에서 잡혔으면 되살아날 때까지 기다린 뒤 다음 스테이지)
		waitFor(function()
			return Round.state == "Playing" and p:GetAttribute("Status") == "Alive"
		end, 20)
		Round.startStage(i)
		readyPlayers(1)
		waitFor(function()
			return p:GetAttribute("Status") == "Alive"
		end, 15)
		task.wait(1)
		ask(p, "anim", "all")
		waitFor(function()
			local s = ask(p, "anim")
			return s and (s.bodies or 0) >= #Round.monsters
		end, 8)
		local m = Round.monsters[1]
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not m or not root then
			check(string.format("stage %d: monster and player ready", i), false)
			continue
		end
		-- 안전 구역 밖에서 20~35스터드 떨어진 두 지점
		local pPos, mPos
		for _, a in m.nodes do
			if not Monster.isSafe(a) then
				for _, b in m.nodes do
					local d = (a - b).Magnitude
					if d > 20 and d < 35 and not Monster.isSafe(b) then
						pPos, mPos = a, b
						break
					end
				end
			end
			if pPos then
				break
			end
		end
		if not pPos or not mPos then
			check(string.format("stage %d: found a spot to test the chase", i), false)
			continue
		end
		place(p, pPos + Vector3.new(0, 3, 0), mPos)
		m.model:PivotTo(CFrame.lookAt(mPos + Vector3.new(0, 5, 0), pPos + Vector3.new(0, 5, 0)))
		m.waypoints = {}
		m.startAt = 0
		task.wait(0.3)
		ask(p, "anim", "all")
		m:startChase(p, root.Position)
		local d0 = (m.root.Position - root.Position).Magnitude
		local armMax, legMax, sMin, sMax = 0, 0, math.huge, 0
		local caught = false
		for _ = 1, 35 do
			task.wait(0.1)
			for _, j in m.joints do
				local _, ang = (j.base:Inverse() * j.motor.C0):ToAxisAngle()
				if j.amp > 0.4 then
					legMax = math.max(legMax, math.abs(ang))
				else
					armMax = math.max(armMax, math.abs(ang))
				end
			end
			sMin, sMax = math.min(sMin, m.hum.WalkSpeed), math.max(sMax, m.hum.WalkSpeed)
			if p:GetAttribute("Status") ~= "Alive" then
				caught = true
				break
			end
		end
		local r2 = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local d1 = if r2 then (m.root.Position - r2.Position).Magnitude else 0
		check(string.format("stage %d: chasing monster closes in (%s)", i, m.state), caught or d1 < d0 - 6, string.format("%.0f -> %.0f studs%s", d0, d1, if caught then ", caught" else ""))
		-- 전신 동작(클라이언트 측정): 1 팔을 머리 위로, 2 줄에 당겨지듯 몸이 크게 오르내림, 3·5 상체를 숙이고 손으로 땅을 짚음, 4 무릎을 높이 듦
		local a = ask(p, "anim") or {}
		local own = if i == 1 then (a.arm or 0) > 1.6
			elseif i == 2 then (a.pelvisRange or 0) > 0.12
			elseif i == 4 then (a.lift or 0) > 0.3
			else (a.lean or 0) > 0.7 and (a.handSteps or 0) > 0
		check(string.format("stage %d: chase uses its own full-body motion", i), own and (a.steps or 0) >= 2, string.format("arm %.2f lean %.2f lift %.2f pelvis %.2f handSteps %s steps %s", a.arm or 0, a.lean or 0, a.lift or 0, a.pelvisRange or 0, tostring(a.handSteps), tostring(a.steps)))
		check(string.format("stage %d: feet stay planted while chasing", i), (a.slip or 99) < 0.25, string.format("max %.3f studs", a.slip or -1))
		local _ = armMin[i] + armMax + legMax
		local lunge = i == 1 or i == 3 or i == 4
		check(string.format("stage %d: chase speed %s", i, if lunge then "lunges and pauses" else "steady"), if lunge then (sMax > Config.Monster.ChaseSpeed * 1.2 and sMin < Config.Monster.ChaseSpeed * 0.7) else math.abs(sMax - Config.Monster.ChaseSpeed) < 0.01, string.format("%.1f ~ %.1f", sMin, sMax))
	end
end

-- ─────────────────────────────── walk ───────────────────────────────
-- 괴물이 실제로 돌아다니는가: 60초 동안 1초마다 위치를 재서 이동 거리·멈춰 있던 시간을 본다(플레이어는 숨겨 둔다)
local function walk()
	local ps = readyPlayers(1)
	if not ps then
		check("ready", false)
		return
	end
	local p = ps[1]
	local si = tonumber(args.Stage) or 1
	if si ~= Round.stageIndex then
		Round.startStage(si)
		readyPlayers(1)
	end
	local spot = Hiding.all()[1]
	if spot then
		Hiding.enter(p, spot)
	end
	local seconds = tonumber(args.Seconds) or 60
	for _, m in Round.monsters do
		m.startAt = 0
	end
	local track = {}
	for k, m in Round.monsters do
		track[k] = { last = m.root.Position, dist = 0, still = 0, states = {}, swing = 0 }
	end
	ask(p, "anim", "all")
	for _ = 1, seconds do
		task.wait(1)
		for k, m in Round.monsters do
			local t = track[k]
			local pos = m.root.Position
			local d = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(t.last.X, 0, t.last.Z)).Magnitude
			t.dist += d
			if d < 0.5 and m.state ~= "Alert" then
				t.still += 1
			end
			t.last = pos
			t.states[m.state] = (t.states[m.state] or 0) + 1
			local j = m.joints[1]
			if j then
				local _, ang = (j.base:Inverse() * j.motor.C0):ToAxisAngle()
				t.swing = math.max(t.swing, math.abs(ang))
			end
		end
	end
	local out = {}
	for k, m in Round.monsters do
		local t = track[k]
		local st = {}
		for name, n in t.states do
			table.insert(st, name .. "=" .. n)
		end
		table.insert(out, { dist = math.floor(t.dist), still = t.still, states = table.concat(st, " "), log = table.concat(m.log, " | "):sub(-400) })
		check(string.format("monster %d keeps moving (%ds)", k, seconds), t.dist > seconds * Config.Monster.WanderSpeed * 0.4 and t.still < seconds * 0.35, string.format("%d studs, still %ds", math.floor(t.dist), t.still))
	end
	-- 전신 움직임(클라이언트): 발을 디디고 걷는다(디딘 발은 미끄러지지 않는다), 골반이 오르내리고 척추가 비틀린다, 발소리는 발이 닿을 때
	local a = ask(p, "anim") or {}
	local n = #Round.monsters
	check("monsters are animated with the full-body rig", (a.bodies or 0) >= n, tostring(a.bodies))
	check("monsters take real steps (feet lift and land)", (a.steps or 0) >= n * seconds * 0.6, string.format("%s steps", tostring(a.steps)))
	check("planted feet do not slide", (a.slip or 99) < 0.2, string.format("max %.3f studs", a.slip or -1))
	check("pelvis rises and falls with each step (weight)", (a.pelvisRange or 0) > 0.08, string.format("%.2f studs", a.pelvisRange or 0))
	check("spine twists against the pelvis while walking", (a.chestYaw or 0) > 0.02, string.format("%.3f rad", a.chestYaw or 0))
	check("monster footstep sounds play when a foot lands", (a.footSounds or 0) > 0, tostring(a.footSounds))
	R.info.anim = a
	R.info.walk = out
end

-- ─────────────────────────────── stages ───────────────────────────────
-- 스테이지 1~5 를 차례로 지어: 오류 없이 지어지는가, 시작→출구 경로, 괴물 수, 음파 선이 나오는가
local function stages()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	for i = 1, #Config.Stages do
		local errBefore = #R.errors
		Round.startStage(i)
		local ok = readyPlayers(1)
		check(string.format("stage %d built and player spawned", i), ok ~= nil and #R.errors == errBefore, Config.Stages[i].Name)
		if ok then
			local st = ask(p, "stats")
			local paths = {}
			for _, agent in { { r = 1.2, h = 5.5, monster = false }, { r = Config.Monster.AgentRadius, h = Config.Monster.AgentHeight, monster = true } } do
				local status = routeWalkable(agent, agent.monster)
				table.insert(paths, status)
			end
			check(string.format("stage %d: start -> exit walkable (player, monster)", i), paths[1] == "Success" and paths[2] == "Success", table.concat(paths, ","))
			check(string.format("stage %d: %d monster(s)", i, Config.Stages[i].Monsters), #Round.monsters == Config.Stages[i].Monsters, #Round.monsters)
			ask(p, "resetCooldown")
			ask(p, "fire")
			task.wait(1.2)
			local s2 = ask(p, "stats")
			check(string.format("stage %d: sonar reveals outlines", i), s2 and s2.lines.lit > 100, s2 and string.format("segs=%d lit=%d unattached=%d", st.segs, s2.lines.lit, st.unattached))
			R.info["stage" .. i] = st and { segs = st.segs, culled = st.culled, unattached = st.unattached, parts = workspace.Stage:GetAttribute("PartCount") }
			task.wait(2.2)
		end
	end
end

-- ─────────────────────────────── doppel ───────────────────────────────
-- 도플갱어: 스테이지마다 한 마리(사람 모습) → 음파·가까이서 보면 들킴 → 5~10초 뒤 터지며 괴물 → 추격·잡기(도플갱어 점프스케어)
local function doppelTest()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local D = Config.Doppel
	-- 스테이지마다 한 마리, 사람 모습, 메인 괴물 수는 그대로
	for i = 1, #Config.Stages do
		Round.startStage(i)
		readyPlayers(1)
		local d = Round.doppels[1]
		local boxes = 0
		if d then
			for _, c in d.model:GetDescendants() do
				if c:IsA("BasePart") and CollectionService:HasTag(c, Config.Tags.Renderable) and (c:FindFirstAncestor("Disguise") or c:GetAttribute("DisguisePart") or (c.Parent and c.Parent:GetAttribute("DisguisePart"))) then
					boxes += 1
				end
			end
		end
		local dist = d and (d.root.Position - Round.info.spawns[1].Position).Magnitude or -1
		check(string.format("stage %d: one doppelganger in player form (main monsters still %d)", i, Config.Stages[i].Monsters), #Round.doppels == D.PerStage and d ~= nil and d.form == "Disguise" and boxes >= 6 and #Round.monsters == Config.Stages[i].Monsters and CollectionService:HasTag(d.model, Config.Tags.Doppel), string.format("doppels=%d form=%s boxes=%d monsters=%d", #Round.doppels, d and d.form or "-", boxes, #Round.monsters))
		check(string.format("stage %d: doppelganger spawns %d~%d studs from the start", i, D.SpawnDistance[1], D.SpawnDistance[2]), dist >= D.SpawnDistance[1] - 6 and dist <= D.SpawnDistance[2] + 6, string.format("%.0f", dist))
	end
	-- 진짜 사람(친구 또는 플레이어)의 아바타로 갈아입는다
	do
		local dd = Round.doppels[1]
		local dressed = dd and waitFor(function()
			return dd.model:GetAttribute("AvatarOf") ~= nil
		end, 12)
		check("doppelganger wears a real avatar (a friend, or a player)", dressed ~= nil and dd.tracks ~= nil, dd and tostring(dd.model:GetAttribute("AvatarOf")))
	end
	-- 1스테이지 시작 방에서: 플레이어 tile(2,2), 도플갱어 tile(4,4) (약 23스터드: 보이는 거리 밖, 음파 거리 안)
	Round.startStage(1)
	readyPlayers(1)
	local d = Round.doppels[1]
	if not d then
		return
	end
	d.startAt = 0
	local pPos = tile(2, 2, 3)
	place(p, pPos, tile(4, 4, 3))
	local function putDoppel(pos: Vector3)
		d.model:PivotTo(CFrame.lookAt(pos, Vector3.new(pPos.X, pos.Y, pPos.Z)))
		d.waypoints = {}
		d.pauseUntil = os.clock() + 30 -- (제자리에 서 있게)
	end
	putDoppel(tile(4, 4, 3))
	task.wait(1.5)
	check("doppelganger far away (out of sight range) is not discovered yet", d.discoveredBy == nil and d.form == "Disguise", tostring(d.discoveredBy))
	-- 사람 모습도 음파에 윤곽선으로 보인다 + 음파를 쏘면 들킨다
	ask(p, "resetCooldown")
	ask(p, "fire")
	local found = waitFor(function()
		return d.discoveredBy ~= nil
	end, 3)
	local wait0 = d.transformAt - os.clock()
	check("sonar reveals the doppelganger: discovered", found ~= nil and d.discoveredBy == p, tostring(d.discoveredBy))
	check(string.format("transforms %d~%d s after being discovered", D.TransformDelay[1], D.TransformDelay[2]), wait0 > D.TransformDelay[1] - 1.5 and wait0 <= D.TransformDelay[2] + 0.1, string.format("%.1f s", wait0))
	task.wait(1.2)
	local shownNow = ask(p, "reveal")
	check("sonar hit: the player-shaped doppelganger stays visible as it is (no frozen afterimage)", shownNow and shownNow >= 1, shownNow)
	local fx0 = ask(p, "doppelFx")
	-- 변신: 사람 모습이 터지고(조각) 괴물 몸으로
	local turned = waitFor(function()
		return d.form == "Beast"
	end, D.TransformDelay[2] + 3)
	task.wait(0.4)
	local fx1 = ask(p, "doppelFx")
	local beast = d.model:FindFirstChild("Beast")
	local eyes, lineParts = 0, 0
	if beast then
		for _, c in beast:GetChildren() do
			if c:IsA("BasePart") then
				if c.Name == "Eye" then
					eyes += 1
				end
				if CollectionService:HasTag(c, Config.Tags.Renderable) then
					lineParts += 1
				end
			end
		end
	end
	check("transforms into the monster (player body gone, beast body with 2 eyes)", turned ~= nil and d.model:FindFirstChild("Disguise") == nil and beast ~= nil and eyes == 2, string.format("form=%s eyes=%d lines=%d", d.form, eyes, lineParts))
	check("the player body bursts into flying pieces on screen", fx1 and fx0 and fx1.bursts == fx0.bursts + 1 and fx1.shards >= 50, fx1 and string.format("bursts %d->%d shards=%d", fx0 and fx0.bursts or -1, fx1.bursts, fx1.shards))
	check("bursting plays the doppelganger's own burst sound (flesh rip + bone crack)", fx1 and fx0 and fx1.sounds == fx0.sounds + 1, fx1 and string.format("sounds %s->%s", tostring(fx0 and fx0.sounds), tostring(fx1.sounds)))
	do
		local near = false
		for _, e in Players:GetPlayers() do
			local r = e.Character and e.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r and (r.Position - d.root.Position).Magnitude <= D.TransformNear + 3 then
				near = true
			end
		end
		check(string.format("transforms only with a player within %d studs", D.TransformNear), turned ~= nil and near, tostring(near))
	end
	check("monster body is drawn with single strokes (lines and discs)", lineParts > 60 and lineParts < 160, lineParts)
	local chasing = waitFor(function()
		return d.state == "Chase" and d.target == p
	end, D.BurstPause + 2)
	check("after bursting it chases the player who found it", chasing ~= nil, d.state)
	check("doppelganger monster is smaller than the main monster", d.hum.HipHeight < 4 and d.cfg.ChaseSpeed == Config.Doppel.ChaseSpeed, string.format("hip %.1f speed %.1f", d.hum.HipHeight, d.cfg.ChaseSpeed))
	-- 음파에 맞으면 눈이 빛난다(선보다 조금 더 오래)
	putDoppel(tile(4, 4, 3))
	d.startAt = os.clock() + 4 -- (잠깐 세워 둔다)
	ask(p, "resetCooldown")
	ask(p, "fire")
	local lit = waitFor(function()
		local f = ask(p, "doppelFx")
		return f and f.eyes >= 2 and f
	end, 3)
	check("sonar makes its eyes glow", lit ~= nil, lit and lit.eyes)
	-- 덮칠 때 세로 입이 벌어지고, 잡히면 도플갱어 점프스케어
	d.startAt = 0
	d:startChase(p, pPos)
	local opened = waitFor(function()
		return d.model:GetAttribute("MawOpen") == true
	end, 8)
	check("its head-to-belly split opens into a mouth when it lunges", opened ~= nil, tostring(d.model:GetAttribute("MawOpen")))
	local dead = waitFor(function()
		return p:GetAttribute("Status") == "Dead"
	end, 8)
	local js = ask(p, "jumpscare")
	check("caught by the doppelganger -> death with its own jump scare", dead ~= nil and js and js.kind == "doppel", js and tostring(js.kind))
	-- 가까이서 보면(음파 없이) 들킨다
	waitFor(function()
		return Round.state == "Playing" and p:GetAttribute("Status") == "Alive" and Round.doppels[1] ~= nil and Round.doppels[1] ~= d
	end, 20)
	readyPlayers(1)
	local d2 = Round.doppels[1]
	if d2 then
		d2.startAt = 0
		place(p, pPos, tile(3, 3, 3))
		d2.model:PivotTo(CFrame.lookAt(tile(3, 3, 3), pPos))
		d2.waypoints = {}
		d2.pauseUntil = os.clock() + 30
		local seen = waitFor(function()
			return d2.discoveredBy == p
		end, 3)
		check("seeing it up close (no sonar) also gives it away", seen ~= nil, tostring(d2.discoveredBy))
	end
	-- 사람 모습일 때는 플레이어를 잡지 않는다
	Round.startStage(1)
	readyPlayers(1)
	local d3 = Round.doppels[1]
	if d3 then
		d3.startAt = 0
		place(p, pPos, tile(3, 3, 3))
		d3.model:PivotTo(CFrame.lookAt(pPos + Vector3.new(2, 0, 0), pPos))
		task.wait(1.5)
		check("in player form it never kills", p:GetAttribute("Status") == "Alive" and d3.form == "Disguise", p:GetAttribute("Status") .. " " .. d3.form)
	end
end

-- ─────────────────────────────── lives ───────────────────────────────
-- 목숨 3개(스테이지마다) + 시작 방 안전 구역
local function livesTest()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	Config.Lives.PerStage = 3
	Config.SafeZone.Enabled = true
	Round.startStage(1)
	readyPlayers(1)
	local stage = stageFolder()
	local safeCount = #string.split((stage:GetAttribute("SafeTiles") :: string?) or "", ";")
	check("start room is a safe zone (stage 1: 3x3 room)", safeCount == 9 and stage:FindFirstChild("SafeZone") ~= nil, safeCount)
	check("3 lives at the start of a stage", p:GetAttribute("Lives") == 3, p:GetAttribute("Lives"))
	local hud = ask(p, "keyHud")
	check("lives shown on screen (3 hearts)", hud and hud.lives and select(2, string.gsub(hud.lives, "♥", "")) == 3, hud and hud.lives)
	-- 안전 구역 안: 화면에 표시, 괴물이 바로 옆에 와도 잡지 않고 밖으로 나간다
	local inside = tile(2, 2, 3)
	place(p, inside, tile(4, 4, 3))
	local safeShown = waitFor(function()
		local h = ask(p, "keyHud")
		return h and h.safe
	end, 3)
	check("'safe zone' shown while in the start room", safeShown ~= nil)
	local m = Round.monsters[1]
	m.model:PivotTo(CFrame.new(tile(3, 3, 5.2)))
	m.waypoints = {}
	m.startAt = 0
	task.wait(2.5)
	check("monster in the safe zone does not catch or chase the player", p:GetAttribute("Status") == "Alive" and not (m.state == "Chase" and m.target == p), p:GetAttribute("Status") .. " " .. m.state)
	local left = waitFor(function()
		return not Round.inSafe(m.root.Position)
	end, 8)
	check("monster leaves the safe zone on its own", left ~= nil, tostring(m.root.Position))
	-- 쫓기다 안전 구역으로 들어가면 추격을 멈춘다
	local outside = tile(7, 3, 3)
	place(p, outside, tile(9, 3, 3))
	m.model:PivotTo(CFrame.new(tile(10, 3, 5.2)))
	m.waypoints = {}
	m:startChase(p, outside)
	task.wait(0.3)
	place(p, inside, tile(4, 4, 3))
	local dropped = waitFor(function()
		return m.target ~= p and m.state ~= "Chase"
	end, 3)
	check("chase stops when the player reaches the safe zone", dropped ~= nil, m.state)
	m.startAt = 1e9
	-- 잡히면 목숨 하나 잃고 시작 방에서 다시(점프스케어)
	local js0 = ask(p, "jumpscare")
	place(p, outside, tile(9, 3, 3))
	m.model:PivotTo(CFrame.new(outside + Vector3.new(1.5, 2.2, 0)))
	m.startAt = 0
	m:startChase(p, outside)
	local lost = waitFor(function()
		return p:GetAttribute("Status") == "Respawning"
	end, 6)
	m.startAt = 1e9
	m.model:PivotTo(CFrame.new(tile(20, 20, 5.2)))
	check("caught with lives left -> lose one life (not dead)", lost ~= nil and p:GetAttribute("Lives") == 2, tostring(p:GetAttribute("Status")) .. " lives=" .. tostring(p:GetAttribute("Lives")))
	local js1 = ask(p, "jumpscare")
	check("jump scare still plays when a life is lost", js1 and js0 and js1.count == js0.count + 1, js1 and js1.count)
	local back = waitFor(function()
		local r = root(p)
		return p:GetAttribute("Status") == "Alive" and r and Round.inSafe(r.Position)
	end, Config.Lives.RespawnDelay + 6)
	check("respawns in the start room after a moment", back ~= nil, tostring(p:GetAttribute("Status")))
	check("the stage keeps going (not restarted)", Round.state == "Playing" and Round.stageIndex == 1, Round.state)
	local hud2 = ask(p, "keyHud")
	check("hearts drop to 2", hud2 and hud2.lives and select(2, string.gsub(hud2.lives, "♥", "")) == 2, hud2 and hud2.lives)
	-- 두 번 더 잡히면 아웃(마지막 목숨)
	Round.kill(p, "monster")
	waitFor(function()
		return p:GetAttribute("Status") == "Alive"
	end, Config.Lives.RespawnDelay + 6)
	check("second catch: 1 life left", p:GetAttribute("Lives") == 1, p:GetAttribute("Lives"))
	Round.kill(p, "monster")
	check("last life lost -> dead", p:GetAttribute("Status") == "Dead" and p:GetAttribute("Lives") == 0, tostring(p:GetAttribute("Status")))
	-- (혼자면 스테이지 다시 시작) 다시 시작하면 목숨이 다시 3개
	local again = waitFor(function()
		return Round.state == "Playing" and p:GetAttribute("Status") == "Alive"
	end, 25)
	check("new attempt / stage refills lives to 3", again ~= nil and p:GetAttribute("Lives") == 3, p:GetAttribute("Lives"))
	Config.Lives.PerStage = 1
	Config.SafeZone.Enabled = false
end

-- ─────────────────────────────── reveal ───────────────────────────────
-- 음파에 맞은 괴물은 어그로가 풀릴 때까지(다시 배회할 때까지) 계속 보인다
local function revealTest()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	Round.startStage(1)
	readyPlayers(1)
	local catch0 = Config.Monster.CatchDistance
	Config.Monster.CatchDistance = -1 -- (이 테스트에서는 잡지 않게)
	local m = Round.monsters[1]
	local pPos = tile(2, 2, 3)
	place(p, pPos, tile(4, 4, 3))
	m.model:PivotTo(CFrame.new(tile(4, 4, 5.2)))
	m.waypoints = {}
	m.startAt = 0
	task.wait(0.5)
	check("monster not shown before any sonar", ask(p, "reveal") == 0, ask(p, "reveal"))
	ask(p, "resetCooldown")
	ask(p, "fire")
	m:startChase(p, pPos)
	local shown = waitFor(function()
		return (ask(p, "reveal") or 0) >= 1
	end, 3)
	check("sonar hit: the monster becomes visible", shown ~= nil, ask(p, "reveal"))
	-- 음파 선이 사라진 뒤에도(배회해도) 10초 동안은 지금 모습 그대로 보인다
	m.startAt = 1e9
	m.target = nil
	m:setState("Wander")
	task.wait(Config.Sonar.Hold + 2.5)
	check("still visible (live) after the sonar lines fade, within 10 s", (ask(p, "reveal") or 0) >= 1, ask(p, "reveal"))
	local hidden = waitFor(function()
		return ask(p, "reveal") == 0
	end, Config.Sonar.MonsterRevealSeconds)
	check("invisible again about 10 s after the hit", hidden ~= nil, ask(p, "reveal"))
	-- 음파 범위 밖의 괴물은 드러나지 않는다
	m.model:PivotTo(CFrame.new(tile(30, 30, 5.2)))
	m.startAt = 0
	m:startChase(p, pPos)
	ask(p, "resetCooldown")
	ask(p, "fire")
	task.wait(1.5)
	check("a monster out of sonar range is not revealed", ask(p, "reveal") == 0, ask(p, "reveal"))
	m.startAt = 1e9
	m:setState("Wander")
	-- 도플갱어: 음파에 들키면(사람 모습) 계속 보인다
	local d = Round.doppels[1]
	if d then
		d.startAt = 0
		d.model:PivotTo(CFrame.lookAt(tile(4, 4, 3), pPos))
		d.waypoints = {}
		d.pauseUntil = os.clock() + 30
		task.wait(0.3)
		ask(p, "resetCooldown")
		ask(p, "fire")
		local dshown = waitFor(function()
			return d.discoveredBy ~= nil and (ask(p, "reveal") or 0) >= 1
		end, 3)
		task.wait(Config.Sonar.Hold + 0.5)
		check("discovered doppelganger stays visible (player form)", dshown ~= nil and (ask(p, "reveal") or 0) >= 1 and d.form == "Disguise", string.format("%s %s", tostring(ask(p, "reveal")), d.form))
		d.startAt = 1e9
	end
	Config.Monster.CatchDistance = catch0
end

-- ─────────────────────────────── mobile ───────────────────────────────
-- 휴대폰 화면 버튼: 휴대폰 모드에서 로비·스테이지에 맞는 버튼이 보이는가
local function mobileTest()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local p = ps[1]
	local pc = ask(p, "mobile")
	check("PC: no phone buttons", pc and pc.enabled == false, pc and tostring(pc.enabled))
	local st = ask(p, "mobile", true)
	local b = st and table.concat(st.buttons, ",") or ""
	check("phone in a stage: sonar, run, crouch, map buttons", st and st.enabled and b:find("Sonar") and b:find("Run") and b:find("Crouch") and b:find("Map") ~= nil, b)
	Round.enterLobby()
	readyPlayers(1)
	task.wait(1)
	local lb = ask(p, "mobile", true)
	local lbs = lb and table.concat(lb.buttons, ",") or ""
	check("phone in the lobby: sonar and room menu buttons", lb and lbs:find("Sonar") and lbs:find("Menu") ~= nil, lbs)
	ask(p, "mobile", false)
end

-- ─────────────────────────────── seal ───────────────────────────────
-- 스테이지 1~5 를 지어, 실제로 만들어진 벽·바닥에 구멍이 없는지 광선으로 확인한다:
--   바닥 칸마다 아래로(바닥이 있나), 벽 칸 쪽으로(그 벽이 실제로 막고 있나),
--   두 벽이 만나는 모서리 너머가 바닥이면 대각선으로(모서리 틈으로 빠져나갈 수 없나)
local function seal()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local FLOOR = { ["."] = true, S = true, E = true, D = true, A = true, p = true, w = true, b = true, n = true, s = true }
	for i = 1, #Config.Stages do
		Round.startStage(i)
		readyPlayers(1)
		task.wait(1)
		local s = workspace.Stage:GetAttribute("Rows")
		local rows = string.split(s, "/")
		local H, W = #rows, #rows[1]
		local function at(x, y)
			if y < 1 or y > H or x < 1 or x > W then
				return "#"
			end
			return string.sub(rows[y], x, x)
		end
		local params = RaycastParams.new()
		local chars = {}
		for _, pl in Players:GetPlayers() do
			if pl.Character then
				table.insert(chars, pl.Character)
			end
		end
		for _, m in Round.monsters do
			if m.model then
				table.insert(chars, m.model)
			end
		end
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = chars
		params.RespectCanCollide = true
		local noFloor, gaps, corner, tiles = {}, {}, {}, 0
		for y = 1, H do
			for x = 1, W do
				local c = at(x, y)
				if FLOOR[c] then
					tiles += 1
					local o = Vector3.new((x - 1) * 8 + 4, 3, (y - 1) * 8 + 4)
					if not workspace:Raycast(o, Vector3.new(0, -40, 0), params) then
						table.insert(noFloor, string.format("r%dc%d%s", y - 1, x - 1, c))
					end
					for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
						if at(x + d[1], y + d[2]) == "#" then
							for _, h in { 1, 3, 6 } do
								local o2 = Vector3.new(o.X, h, o.Z)
								if not workspace:Raycast(o2, Vector3.new(d[1], 0, d[2]) * 6, params) then
									table.insert(gaps, string.format("r%dc%d->(%d,%d)@%d", y - 1, x - 1, d[1], d[2], h))
									break
								end
							end
						end
					end
					for _, d in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
						if at(x + d[1], y) == "#" and at(x, y + d[2]) == "#" and at(x + d[1], y + d[2]) ~= "#" then
							-- (선 하나는 두 벽 블록이 맞닿은 모서리 선을 정확히 지나갈 수 있어, 몸 크기쯤 되는 공으로 굴려 본다)
							if not workspace:Spherecast(o, 0.6, Vector3.new(d[1], 0, d[2]) * 8, params) then
								table.insert(corner, string.format("r%dc%d->(%d,%d)", y - 1, x - 1, d[1], d[2]))
							end
						end
					end
				end
			end
		end
		local function first(t)
			return table.concat(t, " ", 1, math.min(#t, 8))
		end
		check(string.format("stage %d: every floor tile has a floor under it (%d tiles)", i, tiles), #noFloor == 0, first(noFloor))
		check(string.format("stage %d: walls really block (no gaps beside floor)", i), #gaps == 0, first(gaps))
		check(string.format("stage %d: no leaks through wall corners", i), #corner == 0, first(corner))
	end
end

-- ─────────────────────────────── probe ───────────────────────────────
-- 한 스테이지(args.Stage)에서 시작 → 모든 바닥 칸으로 경로를 계산해, 길이 끊기는 경계(갈 수 있는 칸 ↔ 못 가는 칸)를 보고한다.
local function probe()
	local ps = readyPlayers(1)
	check("player ready", ps ~= nil)
	if not ps then
		return
	end
	local si = tonumber(args.Stage) or 1
	Round.startStage(si)
	readyPlayers(1)
	for _, m in Round.monsters do
		m.alive = false
	end
	local from = Round.info.spawns[1].Position - Vector3.new(0, 2.5, 0)
	do
		local ex = Round.info.exitCFrame
		local parts = {}
		for _, part in workspace:GetPartBoundsInBox(CFrame.new(ex.Position - ex.LookVector * 4.8), Vector3.new(7.8, 9, 3.6)) do
			if part.CanCollide then
				table.insert(parts, string.format("%s %s @%s", part.Name, tostring(part.Size), tostring(part.Position - ex.Position)))
			end
		end
		local down = workspace:Raycast(ex.Position, Vector3.new(0, -10, 0))
		R.info.exitTile = { pos = tostring(ex.Position), look = tostring(ex.LookVector), floor = down and (down.Instance.Name .. " y=" .. down.Position.Y) or "none", parts = parts }
	end
	local function key(pos)
		return math.floor(pos.X / 8) + 1, math.floor(pos.Z / 8) + 1
	end
	for _, agent in { { name = "player", r = 1.2, h = 5.5 }, { name = "monster", r = Config.Monster.AgentRadius, h = Config.Monster.AgentHeight } } do
		local path = PathfindingService:CreatePath({ AgentRadius = agent.r, AgentHeight = agent.h, AgentCanJump = false })
		local okSet, bad = {}, {}
		for _, n in (if args.Quick then {} else Round.info.nodes) do
			local i, j = key(n)
			pcall(function()
				path:ComputeAsync(from, n - Vector3.new(0, 3, 0))
			end)
			if path.Status == Enum.PathStatus.Success then
				okSet[i .. "," .. j] = true
			else
				table.insert(bad, { i, j })
			end
		end
		local edge = {}
		for _, b in bad do
			for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
				if okSet[(b[1] + d[1]) .. "," .. (b[2] + d[2])] then
					-- 원인 찾기: 바로 옆 칸에서 가까이 다시 계산(먼 거리 탐색 한계인지), 그 칸 안의 부딪히는 파트
					local c0 = Vector3.new((b[1] - 1) * 8 + 4, 0, (b[2] - 1) * 8 + 4)
					local c1 = Vector3.new((b[1] + d[1] - 1) * 8 + 4, 0, (b[2] + d[2] - 1) * 8 + 4)
					pcall(function()
						path:ComputeAsync(c1 + Vector3.new(0, 0.5, 0), c0 + Vector3.new(0, 0.5, 0))
					end)
					local near = path.Status.Name
					local parts = {}
					for _, part in workspace:GetPartBoundsInBox(CFrame.new(c0 + Vector3.new(0, 3, 0)), Vector3.new(7.6, 5, 7.6)) do
						if part.CanCollide and not part:IsDescendantOf(Players) and #parts < 4 then
							table.insert(parts, part.Name)
						end
					end
					table.insert(edge, string.format("c%d r%d <- c%d r%d near:%s [%s]", b[1] - 1, b[2] - 1, b[1] + d[1] - 1, b[2] + d[2] - 1, near, table.concat(parts, ",")))
					break
				end
			end
		end
		-- 출구 칸 안쪽 몇 곳
		local ex = Round.info.exitCFrame
		local exitTries = {}
		for _, off in { 0, 1.5, 3, 4.5 } do
			local goal = ex.Position - Vector3.new(0, 3.5, 0) - ex.LookVector * off
			pcall(function()
				path:ComputeAsync(from, goal)
			end)
			table.insert(exitTries, string.format("%.1f:%s", off, path.Status.Name))
		end
		-- 바로 앞 칸에서 출구 안으로 / 시작에서 바로 앞 칸까지
		local front = ex.Position - Vector3.new(0, 3.5, 0) - ex.LookVector * 8.8
		pcall(function()
			path:ComputeAsync(front, ex.Position - Vector3.new(0, 3.5, 0))
		end)
		table.insert(exitTries, "front->in:" .. path.Status.Name)
		pcall(function()
			path:ComputeAsync(from, front)
		end)
		table.insert(exitTries, "start->front:" .. path.Status.Name)
		local t0 = os.clock()
		local okc, errc = pcall(function()
			path:ComputeAsync(from, ex.Position - Vector3.new(0, 3.5, 0))
		end)
		table.insert(exitTries, string.format("t%.0f:%s err=%s", os.clock() - t0, path.Status.Name, tostring(okc and "" or errc)))
		R.info[agent.name] = { bad = #bad, total = #Round.info.nodes, edge = edge, exit = table.concat(exitTries, " ") }
		check(agent.name .. " reaches every floor tile", #bad == 0, #bad .. "/" .. #Round.info.nodes)
	end
end

task.spawn(function()
	local ok, err = pcall(function()
		if args.Test == "dense" then
			dense()
		elseif args.Test == "lobby" then
			lobbyTest()
		elseif args.Test == "walk" then
			walk()
		elseif args.Test == "load" then
			load()
		elseif args.Test == "probe" then
			probe()
		elseif args.Test == "multi" then
			multi()
		elseif args.Test == "perf" then
			perf()
		elseif args.Test == "stages" then
			stages()
		elseif args.Test == "seal" then
			seal()
		elseif args.Test == "doppel" then
			doppelTest()
		elseif args.Test == "chase" then
			chaseMotion()
		elseif args.Test == "lives" then
			livesTest()
		elseif args.Test == "reveal" then
			revealTest()
		elseif args.Test == "mobile" then
			mobileTest()
		else
			core()
		end
	end)
	if not ok then
		check("test script ran", false, err)
	end
	R.finished = true
	R.events = Round.events
	log("done")
	StudioTestService:EndTest(R)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="39">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">11</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="40">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">0.5</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpPower">40</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">10</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="41">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Audio</string>
          <string name="Source"><![CDATA[--!strict
-- 클라이언트 사운드: 발소리(모든 캐릭터, 3D), 음파, 문, 괴물 발소리·반응음, 환경음.
-- 네트워크를 쓰지 않는다: 각 클라이언트가 복제된 위치·속성(MoveMode, State, Open)을 보고 스스로 재생한다.
-- 소리는 Config.Sounds 에서 교체한다. Id 가 "" 이면 재생하지 않는다.
-- 플레이어 속성 TestMute 가 켜지면(자동 테스트) 전체 음소거.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Config = require(ReplicatedStorage.Shared.Config)

local Audio = {}
local SND = Config.Sounds :: { [string]: { Id: string, Volume: number, Pitch: number, Range: number, Cut: number?, Fx: { { any } }?, Steps: { { number } }?, Thump: number?, Claw: string? } }
local player = Players.LocalPlayer

local master = Instance.new("SoundGroup")
master.Name = "SonarMaster"
master.Volume = 1
master.Parent = SoundService

local function applyMute()
	master.Volume = if player:GetAttribute("TestMute") then 0 else 1
end
applyMute()
player:GetAttributeChangedSignal("TestMute"):Connect(applyMute)

local function makeSound(name: string, parent: Instance, looped: boolean?): Sound?
	local def = SND[name]
	if not def or def.Id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = def.Id
	s.Volume = def.Volume
	s.PlaybackSpeed = def.Pitch
	s.Looped = looped == true
	s.SoundGroup = master
	if def.Range > 0 then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = (def :: any).Near or 5 -- (이 거리 안에서는 소리가 줄지 않는다)
		s.RollOffMaxDistance = def.Range
	end
	-- Fx = { { "SoundEffect 클래스", { 속성 = 값 } }, ... }: 소리 효과(왜곡·울림·떨림·에코·플랜저 등).
	-- 클래스·속성 이름이 틀려도 소리 전체가 죽지 않게 pcall 로 하나씩 적용한다.
	if def.Fx then
		for _, fx in def.Fx do
			local ok, eff = pcall(function()
				return Instance.new(fx[1] :: string)
			end)
			if ok and eff then
				for k, v in fx[2] :: { [string]: any } do
					pcall(function()
						(eff :: any)[k] = v
					end)
				end
				eff.Parent = s
			end
		end
	end
	s.Parent = parent
	return s
end

-- 한 번 재생하고 지운다. at 이 Vector3 이면 그 위치에서(3D), Instance 면 거기 붙여서, nil 이면 2D.
Audio.steps = 0 -- (테스트) 지금까지 재생한 플레이어 발소리 수

-- opts.gate = { 켜짐초, 꺼짐초 }: 그 박자로 소리를 끊어 켰다 껐다 한다(끊기는 괴성). opts.sweep = { { 정규화 시간 0~1, 피치 배율 }, ... }, opts.dur = 전체 길이(초): 소리를 반복 재생하면서 피치를 시간에 따라 바꾼다(사이렌·오르내리는 괴성)
function Audio.play(name: string, at: (Vector3 | Instance)?, pitchJitter: number?, volumeScale: number?, pitchScale: number?, startAt: number?, cutOverride: number?, opts: { sweep: { { number } }?, dur: number?, gate: { number }? }?)
	local parent: Instance
	local holder: Attachment? = nil
	if typeof(at) == "Vector3" then
		local a = Instance.new("Attachment")
		a.WorldPosition = at :: Vector3
		a.Parent = workspace.Terrain
		holder = a
		parent = a
	elseif typeof(at) == "Instance" then
		parent = at :: Instance
	else
		parent = SoundService
	end
	local s = makeSound(name, parent)
	if not s then
		if holder then
			holder:Destroy()
		end
		return
	end
	if pitchJitter then
		s.PlaybackSpeed *= 1 + (math.random() * 2 - 1) * pitchJitter
	end
	if pitchScale then
		s.PlaybackSpeed *= pitchScale
	end
	if volumeScale then
		s.Volume *= volumeScale
	end
	if startAt then
		s.TimePosition = startAt
	end
	local sweep = opts and opts.sweep
	local gate = opts and opts.gate
	if gate and not sweep then
		sweep = { { 0, 1 }, { 1, 1 } } -- 음 높이 일정
	end
	if sweep then
		local pts = sweep :: { { number } } -- (reassigned 변수라 클로저 안에서 nil 검사가 풀리므로 복사해 둔다)
		local base, v0, dur = s.PlaybackSpeed, s.Volume, (opts and opts.dur) or 1
		s.Looped = true
		s.Volume = 0
		task.spawn(function()
			local t0 = os.clock()
			while s.Parent do
				local x = (os.clock() - t0) / dur
				if x >= 1 then
					break
				end
				local m = pts[#pts][2]
				for i = 2, #pts do
					if x <= pts[i][1] then
						local a, b = pts[i - 1], pts[i]
						m = a[2] + (b[2] - a[2]) * (x - a[1]) / math.max(b[1] - a[1], 1e-4)
						break
					end
				end
				s.PlaybackSpeed = base * m
				-- 시작 0.05초 페이드인, 끝 0.15초 페이드아웃
				local g = 1
				if gate then
					local ph = (x * dur) % (gate[1] + gate[2])
					g = if ph < gate[1] then math.min(1, ph / 0.015, (gate[1] - ph) / 0.015) else 0
				end
				s.Volume = v0 * g * math.min(1, x * dur / 0.05, (1 - x) * dur / 0.15)
				task.wait()
			end
			if s.Parent then
				s:Stop()
			end
		end)
	end
	s:Play()
	-- Cut: 그 시간(초)만 재생하고 짧게 줄여 끈다(여러 발짝이 든 발소리 파일에서 한 발짝만)
	local cut = cutOverride or (SND[name] and SND[name].Cut)
	if cut then
		local v0 = s.Volume
		task.delay(cut, function()
			for k = 1, 4 do
				if not s.Parent then
					return
				end
				s.Volume = v0 * (1 - k / 4)
				task.wait(0.015)
			end
			s:Stop()
		end)
	end
	task.delay(6, function()
		s:Destroy()
		if holder then
			holder:Destroy()
		end
	end)
end

-- 괴성: Config.Screams[kind] 의 목소리들을 시간차로 겹쳐 길게 지른다
function Audio.scream(kind: string, at: Instance)
	local seq = (Config :: any).Screams[kind]
	if not seq then
		return
	end
	for _, layer in seq do
		task.delay(layer.t, function()
			if at.Parent then
				Audio.play(layer.s, at, 0.05, layer.v, layer.p, layer.start, nil, if layer.sweep or layer.gate then { sweep = layer.sweep, dur = layer.dur, gate = layer.gate } else nil)
			end
		end)
	end
end

function Audio.sonar(localShot: boolean, origin: Vector3)
	if localShot then
		Audio.play("Sonar", nil, 0.03)
		task.delay(0.35, Audio.play, "SonarEcho", nil, 0.03)
	else
		Audio.play("Sonar", origin, 0.03)
		task.delay(0.35, Audio.play, "SonarEcho", origin, 0.03)
	end
end

-- 한 걸음: Steps 가 있으면 녹음된 여러 걸음 중 하나를(직전과 다른 것으로) 골라 재생 + Thump(낮은 툭) / Claw(괴물 발톱) 겹침
local lastStep: { [string]: number } = {}
function Audio.footstep(name: string, at: Instance, jitter: number, pitchScale: number?)
	local def = SND[name]
	if not def then
		return
	end
	local steps = def.Steps
	if steps then
		local k = math.random(1, #steps)
		if k == lastStep[name] then
			k = k % #steps + 1
		end
		lastStep[name] = k
		Audio.play(name, at, jitter, nil, pitchScale, steps[k][1], steps[k][2])
	else
		Audio.play(name, at, jitter, nil, pitchScale)
	end
	if def.Thump then
		Audio.play("FootThump", at, 0.06, def.Thump, pitchScale)
	end
	if def.Claw then
		local claw = def.Claw
		task.delay(0.07, function()
			if at.Parent then
				Audio.footstep(claw, at, 0.06)
			end
		end)
	end
end

-- ── 발소리(캐릭터마다 이동 거리 누적) ──
type Tracker = { last: Vector3, acc: number, root: BasePart, foot: number }
-- ── 괴물마다 자기 소리(Config.MonsterVoices) ──
-- voice: "1"~"5"(메인 괴물 머리 모양) / "Doppel". kind: Scream / Steps / Special / Burst. 없으면 nil
local lastVoicePick: { [string]: number } = {}
function Audio.voiceName(voice: string?, kind: string): string?
	if not voice then
		return nil
	end
	local def = (Config :: any).MonsterVoices and (Config :: any).MonsterVoices[voice]
	local ids = def and def[kind]
	if not ids or #ids == 0 then
		return nil
	end
	local key = voice .. kind
	local k = math.random(1, #ids)
	if #ids > 1 and k == lastVoicePick[key] then
		k = k % #ids + 1
	end
	lastVoicePick[key] = k
	return "Voice_" .. voice .. "_" .. kind .. "_" .. k
end
local function voiceOf(m: Model, kind: string): string?
	return Audio.voiceName(m:GetAttribute("Voice") :: string?, kind)
end
-- 괴물 발이 땅에 닿는 순간(MonsterAnim): 그 괴물 자기 걸음 소리. hit = 착지 세기(무게·속도, 약 0.3~1.6)
Audio.monsterSteps = 0 -- (테스트)
-- 괴물 발소리는 음파에 걸린 동안만 들린다(Main 이 Reveal.active 로 채운다). 그 전에는 조용히 다가온다
Audio.stepAudible = function(_m: Model): boolean
	return true
end
function Audio.monsterFoot(model: Model, at: Vector3, hit: number)
	Audio.monsterSteps += 1
	if not Audio.stepAudible(model) then
		return
	end
	local chase = model:GetAttribute("State") == "Chase"
	local vol = (if chase then 1 else Config.Monster.StepWanderVolume) * math.clamp(0.6 + hit * 0.35, 0.6, 1.3)
	local own = Audio.voiceName(model:GetAttribute("Voice") :: string?, "Steps")
	if own then
		Audio.play(own, at, 0.06, vol, if model:GetAttribute("Voice") == "Flower" then 0.75 else nil)
	else
		Audio.play("MonsterStep", at, 0.08, vol)
	end
end

-- 도플갱어의 사람 모습이 터질 때(서버 RoundEvent "DoppelBurst"): 살 찢어짐 + 뼈 우두둑(없으면 낮게 꺾이는 소리)
Audio.bursts = 0 -- (테스트) 터지는 소리를 낸 횟수
function Audio.doppelBurst(at: Vector3)
	Audio.bursts += 1
	local def = (Config :: any).MonsterVoices and (Config :: any).MonsterVoices.Doppel
	if def and def.Burst then
		for k = 1, #def.Burst do
			Audio.play("Voice_Doppel_Burst_" .. k, at, 0.03)
		end
	else
		Audio.play("Door", at, 0.04, 1.4, 0.45)
		Audio.play("FootRun", at, 0.1, 1.2, 0.5)
	end
end

-- 쫓아올 때 괴성: 그 괴물 자기 괴성(없으면 공통 괴성)
local function chaseScream(m: Model, root: BasePart)
	local n = voiceOf(m, "Scream")
	if n then
		Audio.play(n, root, 0.03)
	else
		Audio.scream("Chase", root)
	end
end

local trackers: { [Model]: Tracker } = {}
-- 한 발짝 거리(스터드): 걷기 10/초면 초당 약 2발, 달리기 18/초면 약 2.8발, 웅크리기 5/초면 약 1.7발
local STRIDE = { Walk = 4.8, Run = 6.5, Crouch = 3.0 }

local function stepFor(model: Model, root: BasePart, isMonster: boolean)
	local tr = trackers[model]
	if not tr or tr.root ~= root then
		tr = { last = root.Position, acc = 0, root = root, foot = 1 }
		trackers[model] = tr
	end
	local p = root.Position
	local d = Vector3.new(p.X - tr.last.X, 0, p.Z - tr.last.Z).Magnitude
	tr.last = p
	if d > 6 then
		return -- 순간 이동
	end
	tr.acc += d
	local form = model:GetAttribute("Form")
	if isMonster and not Audio.stepAudible(model) then
		-- (음파에 걸리기 전: 괴물 발소리 없음)
		if tr.acc >= 4.6 then
			tr.acc = 0
		end
		return
	end
	if isMonster and form == "Disguise" then
		-- 도플갱어(사람 모습): 플레이어와 똑같은 발소리
		if tr.acc >= STRIDE.Walk then
			tr.acc = 0
			Audio.footstep("FootWalk", root, 0)
		end
	elseif isMonster and model:GetAttribute("Rig") == 2 then
		-- 전신 뼈대 괴물: 발이 실제로 땅에 닿는 순간 MonsterAnim 이 Audio.monsterFoot 을 부른다
		tr.acc = 0
	elseif isMonster then
		if tr.acc >= 4.6 then -- 사람(4.8)과 비슷한 거리지만 괴물은 느려서 쿵… 쿵… 간격이 더 길다
			tr.acc = 0
			-- 배회할 때는 조금 작게, 쫓아올 때는 크게. 도플갱어(작은 괴물)는 조금 높고 가벼운 발소리
			local chase = model:GetAttribute("State") == "Chase"
			local vol = if chase then 1 else Config.Monster.StepWanderVolume
			local own = voiceOf(model, "Steps")
			if own then
				-- 그 괴물 자기 걸음 소리(발 끌기·나무 딱딱·손톱 톡톡·쿵·곤충 걸음)
				Audio.play(own, root, 0.06, vol, if model:GetAttribute("Voice") == "Flower" then 0.75 else nil)
			else
				local small = model:GetAttribute("Form") ~= nil
				Audio.play("MonsterStep", root, 0.08, vol * (if small then 0.85 else 1), if small then 1.25 else nil)
			end
		end
	else
		local mode = (model:GetAttribute("MoveMode") :: string?) or "Walk"
		local stride = STRIDE[mode] or 3.6
		if tr.acc >= stride then
			tr.acc = 0
			tr.foot = -tr.foot
			local name = if mode == "Run" then "FootRun" elseif mode == "Crouch" then "FootCrouch" else "FootWalk"
			-- 매 걸음 똑같은 깔끔한 한 번의 소리(피치 흔들림·왼발/오른발 차이 없음)
			Audio.footstep(name, root, 0)
			Audio.steps += 1
		end
	end
end

-- ── 괴물 상태 반응음 ──
local monsterConns: { [Model]: { RBXScriptConnection } } = {}
local screamAt: { [Model]: number } = {} -- 추격 중 다음 괴성 시각
local CHASE_SCREAM_GAP = { 10, 15 } -- 추격 중 괴성 사이 간격(초, 범위). 쫓기 시작할 때 한 번 지르고, 그 뒤로는 10~15초에 한 번(너무 자주 지르지 않게)
local function watchMonster(m: Instance)
	if not m:IsA("Model") or monsterConns[m] then
		return
	end
	local model = m :: Model
	local conns = {}
	table.insert(conns, model:GetAttributeChangedSignal("State"):Connect(function()
		local st = model:GetAttribute("State")
		local root = model.PrimaryPart
		if not root then
			return
		end
		-- 괴성은 플레이어를 발견해 쫓기 시작할 때만(배회·조사·수색·경계에는 지르지 않는다). 발소리는 평소에도 난다
			if st == "Chase" then
				chaseScream(model, root)
				screamAt[model] = os.clock() + CHASE_SCREAM_GAP[1] + math.random() * (CHASE_SCREAM_GAP[2] - CHASE_SCREAM_GAP[1])
			elseif st == "Alert" then
				-- 소리를 듣고 멈칫: 그 괴물의 특수 소리(머리 돌리는 뼈 소리, 상체 꺾이는 와르르, 씹는 소리)
				local sp = voiceOf(model, "Special")
				if sp then
					Audio.play(sp, root, 0.04)
				end
			end
	end))
	-- 도플갱어: 가짜 음파 소리, 사람 모습이 터질 때 소리
	table.insert(conns, model:GetAttributeChangedSignal("FakePing"):Connect(function()
		local root = model.PrimaryPart
		if root then
			Audio.play("Sonar", root, 0.02, 0.9)
		end
	end))
	table.insert(conns, model:GetAttributeChangedSignal("Form"):Connect(function()
		local root = model.PrimaryPart
		local form = model:GetAttribute("Form")
		if root and model:GetAttribute("Voice") == "Flower" then
			-- 꽃괴물: 꽃잎이 펼쳐질 때 뼈·살 소리 → 다 펼치면 질척, 닫을 때는 낮은 질척
			if form == "Open" then
				local n = Audio.voiceName("Flower", "Unfold")
				if n then
					Audio.play(n, root, 0.03)
				end
				task.delay((Config :: any).Flower.WakeTime, function()
					local q = Audio.voiceName("Flower", "Squelch")
					if q and root.Parent then
						Audio.play(q, root, 0.03)
					end
				end)
			elseif form == "Bud" then
				local q = Audio.voiceName("Flower", "Squelch")
				if q then
					Audio.play(q, root, 0.03, 0.7, 0.75)
				end
			end
		end
		-- (도플갱어가 터지는 소리는 Form 속성이 아니라 DoppelBurst 이벤트에서 낸다: 서버가 Bursting → Beast 를
		-- 같은 프레임에 바꿔서 클라이언트에는 Bursting 이 도착하지 않는다. Audio.doppelBurst 참고)
	end))
	monsterConns[model] = conns
	
	model.Destroying:Connect(function()
		for _, c in conns do
			c:Disconnect()
		end
		monsterConns[model] = nil
		screamAt[model] = nil
		trackers[model] = nil
	end)
end
CollectionService:GetInstanceAddedSignal(Config.Tags.Monster):Connect(watchMonster)
for _, m in CollectionService:GetTagged(Config.Tags.Monster) do
	watchMonster(m)
end

-- ── 문 ──
local function watchDoor(m: Instance)
	if not m:IsA("Model") then
		return
	end
	m:GetAttributeChangedSignal("Open"):Connect(function()
		local panel = m:FindFirstChild("Panel")
		if panel then
			Audio.play("Door", (panel :: BasePart).Position, 0.08)
		end
	end)
end
CollectionService:GetInstanceAddedSignal(Config.Tags.Door):Connect(watchDoor)
for _, m in CollectionService:GetTagged(Config.Tags.Door) do
	watchDoor(m)
end

-- ── 환경음 ──
local hum: Sound? = makeSound("AmbientHum", SoundService, true)
if hum then
	hum:Play()
end
local emitters: { [Instance]: Sound } = {}
local function addEmitter(e: Instance)
	if emitters[e] or not e:IsA("BasePart") then
		return
	end
	local name = (e:GetAttribute("Sound") :: string?) or "AmbientFan"
	local s = makeSound(name, e, true)
	if s then
		s.TimePosition = math.random() * 2
		s:Play()
		emitters[e] = s
	end
	e.Destroying:Connect(function()
		emitters[e] = nil
	end)
end
CollectionService:GetInstanceAddedSignal(Config.Tags.AmbientEmitter):Connect(addEmitter)
for _, e in CollectionService:GetTagged(Config.Tags.AmbientEmitter) do
	addEmitter(e)
end

local nextAmbient = os.clock() + 4
local ONE_SHOTS = { "AmbientCreak" } -- 물방울·폭발음 같은 금속음은 뺐다

function Audio.update()
	-- 발소리
	for _, plr in Players:GetPlayers() do
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if char and root and plr:GetAttribute("Status") == "Alive" then
			stepFor(char, root, false)
		end
	end
	local now = os.clock()
	for _, m in CollectionService:GetTagged(Config.Tags.Monster) do
		if m:IsA("Model") and m.PrimaryPart then
			-- 발소리는 늘 난다(움직일 때). 괴성은 쫓아올 때만
			stepFor(m, m.PrimaryPart, true)
			if m:GetAttribute("State") == "Chase" then
				local at = screamAt[m]
				if at and now > at then
					screamAt[m] = now + CHASE_SCREAM_GAP[1] + math.random() * (CHASE_SCREAM_GAP[2] - CHASE_SCREAM_GAP[1])
					chaseScream(m, m.PrimaryPart)
				end
			end
		end
	end
	-- 먼 곳의 물방울·금속음·구조물 삐걱임(무작위 위치)
	if now > nextAmbient then
		nextAmbient = now + 4 + math.random() * 8
		local cam = workspace.CurrentCamera
		if cam then
			local ang = math.random() * math.pi * 2
			local r = 15 + math.random() * 35
			local p = cam.CFrame.Position + Vector3.new(math.cos(ang) * r, math.random() * 6 - 2, math.sin(ang) * r)
			Audio.play(ONE_SHOTS[math.random(1, #ONE_SHOTS)], p, 0.15)
		end
	end
	for model, _ in trackers do
		if not model.Parent then
			trackers[model] = nil
		end
	end
end

-- ── (Studio 전용) 괴물 소리 미리 듣기: Play 중 숫자키 1~4 = 목록 9~12번(4번 웅웅 + 비명) ──
-- 게시된 게임에서는 동작하지 않는다.
local function playClip(id: number, start: number, dur: number, vol: number)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Volume = vol
	s.SoundGroup = master
	s.Parent = SoundService
	s.TimePosition = start
	s:Play()
	task.delay(dur, function()
		for k = 1, 5 do
			s.Volume = vol * (1 - k / 5)
			task.wait(0.03)
		end
		s:Destroy()
	end)
end
function Audio.previewScream(index: number)
	local r = (Config :: any).RealScreams[index]
	if not r then
		return
	end
	local k = (Config :: any).MonsterLoudness or 1 -- (게임 속 가까이에서 듣는 크기와 같게)
	playClip(r.Id, r.Start, r.Dur, r.Volume * k)
	if r.Layer then
		task.delay(r.Layer.Delay, playClip, r.Layer.Id, r.Layer.Start, r.Layer.Dur, r.Layer.Volume * k)
	end
end
if game:GetService("RunService"):IsStudio() then
	local keys = { [Enum.KeyCode.One] = 9, [Enum.KeyCode.Two] = 10, [Enum.KeyCode.Three] = 11, [Enum.KeyCode.Four] = 12 }
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		local idx = keys[input.KeyCode]
		if idx and not processed then
			Audio.previewScream(idx)
		end
	end)
end

return Audio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">DoppelFx</string>
          <string name="Source"><![CDATA[--!strict
-- 도플갱어 연출(클라이언트):
--  1) 변신: 사람 모습(상자 6개)의 윤곽선이 조각나 사방으로 터져 흩날리다 사라진다(음파와 상관없이 보인다).
--  2) 눈: 음파가 괴물 모습의 도플갱어에 닿으면, 두 눈(이름 Eye)이 음파 선보다 조금 더 오래 하얗게 빛나다 꺼진다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)

local DoppelFx = {}
DoppelFx.bursts = 0 -- (테스트) 터진 횟수
DoppelFx.lastShards = 0 -- (테스트) 마지막으로 터질 때 만든 조각 수

local WHITE = Color3.new(1, 1, 1)
local folder: Folder? = nil
local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "DoppelFx"
	f.Parent = workspace
	folder = f
	return f
end

type Shard = { part: Part, pos: Vector3, vel: Vector3, rot: CFrame, spin: Vector3, born: number, life: number }
local shards: { Shard } = {}

local function newShard(cf: CFrame, len: number, vel: Vector3, life: number, now: number)
	local p = Instance.new("Part")
	p.Name = "Shard"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = WHITE
	p.Size = Vector3.new(0.07, 0.07, math.max(0.1, len))
	p.CFrame = cf
	p.Parent = getFolder()
	local spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 14
	table.insert(shards, { part = p, pos = cf.Position, vel = vel, rot = cf.Rotation, spin = spin, born = now, life = life })
end

-- 상자 하나의 12 모서리를 조각으로
local EDGES = {
	{ Vector3.new(-1, -1, -1), Vector3.new(1, -1, -1) },
	{ Vector3.new(-1, 1, -1), Vector3.new(1, 1, -1) },
	{ Vector3.new(-1, -1, 1), Vector3.new(1, -1, 1) },
	{ Vector3.new(-1, 1, 1), Vector3.new(1, 1, 1) },
	{ Vector3.new(-1, -1, -1), Vector3.new(-1, 1, -1) },
	{ Vector3.new(1, -1, -1), Vector3.new(1, 1, -1) },
	{ Vector3.new(-1, -1, 1), Vector3.new(-1, 1, 1) },
	{ Vector3.new(1, -1, 1), Vector3.new(1, 1, 1) },
	{ Vector3.new(-1, -1, -1), Vector3.new(-1, -1, 1) },
	{ Vector3.new(1, -1, -1), Vector3.new(1, -1, 1) },
	{ Vector3.new(-1, 1, -1), Vector3.new(-1, 1, 1) },
	{ Vector3.new(1, 1, -1), Vector3.new(1, 1, 1) },
}

function DoppelFx.burst(data: { at: Vector3, boxes: { { cf: CFrame, size: Vector3 } } })
	local cam = workspace.CurrentCamera
	if not data or not data.at or (cam and (cam.CFrame.Position - data.at).Magnitude > 160) then
		return
	end
	local now = os.clock()
	local made = 0
	local center = data.at
	for _, b in data.boxes or {} do
		local half = b.size / 2
		for _, e in EDGES do
			-- 모서리를 두 토막으로 나눠 더 잘게 부서지게
			local a = b.cf:PointToWorldSpace(e[1] * half)
			local c = b.cf:PointToWorldSpace(e[2] * half)
			for k = 0, 1 do
				local p0 = a:Lerp(c, k * 0.5)
				local p1 = a:Lerp(c, k * 0.5 + 0.5)
				local mid = (p0 + p1) / 2
				local out = mid - center
				out = if out.Magnitude > 0.01 then out.Unit else Vector3.yAxis
				local vel = out * (10 + math.random() * 18) + Vector3.new(0, 6 + math.random() * 10, 0)
				newShard(CFrame.lookAt(mid, p1), (p1 - p0).Magnitude, vel, 1.1 + math.random() * 0.7, now)
				made += 1
			end
		end
	end
	-- 몸 안쪽에서 튀어나오는 잔조각
	for _ = 1, 24 do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5)
		dir = if dir.Magnitude > 0.01 then dir.Unit else Vector3.yAxis
		local p = center + Vector3.new(0, math.random() * 2 - 0.5, 0)
		newShard(CFrame.lookAt(p, p + dir), 0.2 + math.random() * 0.5, dir * (14 + math.random() * 16), 0.8 + math.random() * 0.6, now)
		made += 1
	end
	DoppelFx.bursts += 1
	DoppelFx.lastShards = made
end

-- ── 눈 ──
local eyeUntil: { [Model]: { from: number, to: number } } = setmetatable({}, { __mode = "k" }) :: any
local litEyes: { [BasePart]: boolean } = {}

function DoppelFx.onPulse(origin: Vector3)
	local S = Config.Sonar
	local now = os.clock()
	for _, m in CollectionService:GetTagged(Config.Tags.Doppel) do
		if m:IsA("Model") and m.PrimaryPart and m:GetAttribute("Form") == "Beast" then
			local d = (m.PrimaryPart.Position - origin).Magnitude
			if d <= S.Radius + 2 then
				local from = now + math.min(1, d / 60)
				-- (몸이 보이는 10초 동안 눈도 빛난다)
				eyeUntil[m] = { from = from, to = from + ((S :: any).MonsterRevealSeconds or (S.Hold + Config.Doppel.EyeLinger)) }
			end
		end
	end
end

local function setEye(p: BasePart, on: boolean)
	if on then
		p.Transparency = 0
		p.Material = Enum.Material.Neon
		p.Color = WHITE
		litEyes[p] = true
	else
		p.Transparency = 1
		litEyes[p] = nil
	end
end

-- (테스트) 지금 빛나는 눈 수
function DoppelFx.litEyeCount(): number
	local n = 0
	for p in litEyes do
		if p.Parent then
			n += 1
		end
	end
	return n
end

local moveParts: { BasePart } = {}
local moveCFs: { CFrame } = {}
RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	-- 조각: 날아가며 돌고 떨어지다 검게(보이지 않게) 사라진다
	local i = 1
	while i <= #shards do
		local s = shards[i]
		local age = now - s.born
		if age >= s.life or not s.part.Parent then
			s.part:Destroy()
			shards[i] = shards[#shards]
			shards[#shards] = nil
		else
			s.vel += Vector3.new(0, -45 * dt, 0)
			s.vel *= (1 - math.min(0.9, dt * 1.2))
			s.pos += s.vel * dt
			s.rot = s.rot * CFrame.Angles(s.spin.X * dt, s.spin.Y * dt, s.spin.Z * dt)
			table.insert(moveParts, s.part)
			table.insert(moveCFs, CFrame.new(s.pos) * s.rot)
			local fade = math.clamp((age - s.life * 0.35) / (s.life * 0.65), 0, 1)
			local v = 1 - fade
			s.part.Color = Color3.new(v, v, v)
			i += 1
		end
	end
	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveCFs, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(moveParts)
		table.clear(moveCFs)
	end
	-- 눈
	for m, w in eyeUntil do
		local on = now >= w.from and now <= w.to and m.Parent ~= nil and m:GetAttribute("Form") == "Beast"
		local beast = m:FindFirstChild("Beast")
		if beast then
			for _, p in beast:GetChildren() do
				if p:IsA("BasePart") and p.Name == "Eye" then
					if on ~= (litEyes[p] == true) then
						setEye(p, on)
					end
				end
			end
		end
		if now > w.to then
			eyeUntil[m] = nil
		end
	end
end)

function DoppelFx.clear()
	for _, s in shards do
		s.part:Destroy()
	end
	table.clear(shards)
	table.clear(litEyes)
end

return DoppelFx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">JumpScare</string>
          <string name="Source"><![CDATA[--!strict
-- 괴물에게 잡혔을 때: 그 스테이지 괴물의 얼굴(흰 선)이 화면 가득 확 튀어나오며 흔들린다(점프스케어). 약 0.9초 뒤 YOU DIED.
-- 메인 괴물 얼굴은 괴물 머리와 같은 공용 모양(Shared/MonsterFaces, 3차 시안): 1 삼각 · 2 사각 · 3 원 · 4 별 · 5 육각.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Faces = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MonsterFaces"))

local JumpScare = {}
JumpScare.count = 0
JumpScare.Duration = 0.9
JumpScare.lastKind = "monster"

local player = Players.LocalPlayer


local gui = Instance.new("ScreenGui")
gui.Name = "JumpScare"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 50
gui.Enabled = false

local back = Instance.new("Frame")
back.Size = UDim2.fromScale(1, 1)
back.BackgroundColor3 = Color3.new(0, 0, 0)
back.BorderSizePixel = 0
back.Parent = gui

local face = Instance.new("Frame")
face.Name = "Face"
face.AnchorPoint = Vector2.new(0.5, 0.5)
face.Position = UDim2.fromScale(0.5, 0.5)
face.Size = UDim2.fromScale(0.95, 0.95)
face.BackgroundTransparency = 1
face.Parent = back
local aspect = Instance.new("UIAspectRatioConstraint")
aspect.AspectRatio = 1
aspect.Parent = face
local scale = Instance.new("UIScale")
scale.Parent = face

gui.Parent = player:WaitForChild("PlayerGui")

local WHITE = Color3.new(1, 1, 1)

-- 메인 괴물: 괴물 머리와 똑같은 얼굴(공용 MonsterFaces). 기울어진 그대로 화면을 거의 채운다
local function draw(shape: number)
	for _, c in face:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local size = face.AbsoluteSize.X
	if size < 10 then
		size = math.min(back.AbsoluteSize.X, back.AbsoluteSize.Y) * 0.95
	end
	local f = Faces.build(shape)
	local c, s = math.cos(math.rad(f.deg)), math.sin(math.rad(f.deg))
	local function rot(u: number, v: number): (number, number)
		u, v = u * f.scale, v * f.scale
		return u * c - v * s, u * s + v * c
	end
	-- 얼굴 전체가 들어가는 크기(혀·침까지)
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, l in f.lines do
		for _, q in l.pts do
			local x, y = rot(q[1], q[2])
			minX, minY, maxX, maxY = math.min(minX, x), math.min(minY, y), math.max(maxX, x), math.max(maxY, y)
		end
	end
	local cx, cy = (minX + maxX) / 2, (minY + maxY) / 2
	local k = 0.9 / math.max(maxX - minX, maxY - minY)
	local thick = math.max(4, size * 0.012)
	local function px(x: number, y: number): Vector2
		return Vector2.new((0.5 + (x - cx) * k) * size, (0.5 + (y - cy) * k) * size)
	end
	local function line(a: Vector2, b: Vector2, w: number)
		local d = b - a
		local fr = Instance.new("Frame")
		fr.BackgroundColor3 = WHITE
		fr.BorderSizePixel = 0
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		fr.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
		fr.Size = UDim2.fromOffset(d.Magnitude + w, w)
		fr.Rotation = math.deg(math.atan2(d.Y, d.X))
		fr.Parent = face
	end
	for _, l in f.lines do
		local w = thick * math.clamp(l.r / 0.03, 0.4, 1)
		local n = #l.pts
		for i = 1, (if l.closed then n else n - 1) do
			local a, b = l.pts[i], l.pts[i % n + 1]
			local ax, ay = rot(a[1], a[2])
			local bx, by = rot(b[1], b[2])
			line(px(ax, ay), px(bx, by), w)
		end
	end
	for _, e in f.circles do
		local x, y = rot(e.u, e.v)
		local p = px(x, y)
		local d = math.max(e.rad * f.scale * k * size * 2, thick * 1.5)
		local fr = Instance.new("Frame")
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		fr.Position = UDim2.fromOffset(p.X, p.Y)
		fr.Size = UDim2.fromOffset(d, d)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = fr
		if e.pupil then
			-- 눈동자: 꽉 찬 점
			fr.BackgroundColor3 = WHITE
			fr.BorderSizePixel = 0
		else
			fr.BackgroundTransparency = 1
			local st = Instance.new("UIStroke")
			st.Color = WHITE
			st.Thickness = thick * 0.8
			st.Parent = fr
		end
		fr.Parent = face
	end
end

-- 도플갱어: 둥근 머리의 빛나는 두 눈 + 머리에서 배까지 세로로 벌어진 입(양쪽 이빨), 솟은 어깨
-- (좌표는 Monster.luau 도플갱어 시안과 같은 그림에서 가져와, 머리~가슴이 화면을 채우게 맞춘다)
local function drawDoppel()
	for _, c in face:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local size = face.AbsoluteSize.X
	if size < 10 then
		size = math.min(back.AbsoluteSize.X, back.AbsoluteSize.Y) * 0.95
	end
	local thick = math.max(4, size * 0.011)
	local function px(x: number, y: number): Vector2
		-- 시안 픽셀(가운데 x=130, 화면 가운데 y=234) → 화면
		return Vector2.new((0.5 + (x - 130) / 190) * size, (0.5 + (y - 234) / 190) * size)
	end
	local function line(ax: number, ay: number, bx: number, by: number, w: number?)
		local a, b = px(ax, ay), px(bx, by)
		local d = b - a
		local f = Instance.new("Frame")
		f.BackgroundColor3 = WHITE
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
		f.Size = UDim2.fromOffset(d.Magnitude + (w or thick), w or thick)
		f.Rotation = math.deg(math.atan2(d.Y, d.X))
		f.Parent = face
	end
	local function bez(x0: number, y0: number, x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, n: number, w: number?)
		local px0, py0 = x0, y0
		for i = 1, n do
			local t = i / n
			local u = 1 - t
			local x = u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3
			local y = u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3
			line(px0, py0, x, y, w)
			px0, py0 = x, y
		end
	end
	local function dot(x: number, y: number, r: number)
		local c = px(x, y)
		local f = Instance.new("Frame")
		f.BackgroundColor3 = WHITE
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset(c.X, c.Y)
		f.Size = UDim2.fromOffset(r * 2 * size / 190, r * 2 * size / 190)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = f
		f.Parent = face
	end
	-- 머리
	bez(112, 186, 108, 160, 116, 146, 130, 146, 8)
	bez(130, 146, 144, 146, 152, 160, 148, 186, 8)
	bez(148, 186, 146, 198, 140, 206, 135, 207, 4)
	bez(112, 186, 114, 198, 120, 206, 125, 207, 4)
	-- 빛나는 두 눈(벌어진 입 양옆으로 밀려남)
	dot(118, 166, 4.2)
	dot(142, 166, 4.2)
	-- 어깨·목
	line(118, 204, 112, 218)
	line(142, 204, 148, 218)
	bez(112, 218, 98, 220, 86, 226, 78, 240, 4)
	bez(148, 218, 162, 220, 174, 226, 182, 240, 4)
	-- 세로로 벌어진 입(머리~배)
	bez(130, 160, 112, 192, 106, 236, 108, 270, 10)
	bez(108, 270, 110, 300, 118, 318, 130, 334, 6)
	bez(130, 334, 142, 318, 150, 300, 152, 270, 6)
	bez(152, 270, 154, 236, 148, 192, 130, 160, 10)
	-- 이빨(양쪽 가장자리에서 안쪽으로)
	local rows = { { 120, 176 }, { 116, 190 }, { 113, 204 }, { 110, 218 }, { 109, 232 }, { 108, 246 }, { 108, 260 }, { 109, 274 }, { 111, 288 }, { 115, 302 }, { 120, 316 } }
	for k, t in rows do
		local len = 7 + (k % 2) * 3
		line(t[1], t[2], t[1] + len, t[2] + 2, thick * 0.7)
		line(260 - t[1], t[2], 260 - t[1] - len, t[2] + 2, thick * 0.7)
	end
end

-- 꽃괴물: 뾰족한 꽃잎 6장(바깥 가시)이 화면 가득 펼쳐지고 가운데 작은 눈 7개
local function drawFlower()
	for _, c in face:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local size = face.AbsoluteSize.X
	if size < 10 then
		size = math.min(back.AbsoluteSize.X, back.AbsoluteSize.Y) * 0.95
	end
	local thick = math.max(4, size * 0.011)
	local function px(x: number, y: number): Vector2
		-- 꽃 가운데가 화면 가운데, 꽃잎 길이 62 가 화면 반쯤
		return Vector2.new((0.5 + x / 140) * size, (0.5 + y / 140) * size)
	end
	local function line(ax: number, ay: number, bx: number, by: number, w: number?)
		local a, b = px(ax, ay), px(bx, by)
		local d = b - a
		local fr = Instance.new("Frame")
		fr.BackgroundColor3 = WHITE
		fr.BorderSizePixel = 0
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		fr.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
		fr.Size = UDim2.fromOffset(d.Magnitude + (w or thick), w or thick)
		fr.Rotation = math.deg(math.atan2(d.Y, d.X))
		fr.Parent = face
	end
	local function bez(p0: { number }, p1: { number }, p2: { number }, p3: { number }, n: number, w: number?)
		local ax, ay = p0[1], p0[2]
		for i = 1, n do
			local t = i / n
			local u = 1 - t
			local x = u * u * u * p0[1] + 3 * u * u * t * p1[1] + 3 * u * t * t * p2[1] + t * t * t * p3[1]
			local y = u * u * u * p0[2] + 3 * u * u * t * p1[2] + 3 * u * t * t * p2[2] + t * t * t * p3[2]
			line(ax, ay, x, y, w)
			ax, ay = x, y
		end
	end
	local function dot(x: number, y: number, r: number)
		local c = px(x, y)
		local fr = Instance.new("Frame")
		fr.BackgroundColor3 = WHITE
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		fr.Position = UDim2.fromOffset(c.X, c.Y)
		fr.Size = UDim2.fromOffset(r * 2 * size / 140, r * 2 * size / 140)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = fr
		fr.Parent = face
	end
	for k = 0, 5 do
		local a = math.rad(k * 60 + 30)
		local function R(x: number, y: number): { number }
			return { x * math.cos(a) - y * math.sin(a), x * math.sin(a) + y * math.cos(a) }
		end
		bez(R(-4, -6), R(-10, -24), R(-8, -46), R(0, -62), 8)
		bez(R(0, -62), R(8, -46), R(10, -24), R(4, -6), 8)
		local m0, m1 = R(0, -14), R(0, -52)
		line(m0[1], m0[2], m1[1], m1[2], thick * 0.6)
		for _, t in { { 6, -30, 11, -32 }, { 6, -40, 11, -43 }, { -6, -30, -11, -32 }, { -6, -40, -11, -43 } } do
			local q0, q1 = R(t[1], t[2]), R(t[3], t[4])
			line(q0[1], q0[2], q1[1], q1[2], thick * 0.7)
		end
	end
	for _, e in { { 0, 0, 3.4 }, { -8, -6, 2.3 }, { 8, -6, 2.3 }, { -10, 4, 2.1 }, { 10, 4, 2.1 }, { -3, 10, 1.8 }, { 3, 10, 1.8 } } do
		dot(e[1], e[2], e[3])
	end
end

-- 얼굴을 띄운다(이미 떠 있으면 무시). kind = "doppel" 이면 도플갱어 얼굴, "flower" 면 꽃괴물
local busy = false
function JumpScare.play(scream: (() -> ())?, kind: string?)
	if busy then
		return
	end
	busy = true
	JumpScare.count += 1
	local si = (ReplicatedStorage:GetAttribute("StageIndex") :: number?) or 1
	gui.Enabled = true
	if kind == "doppel" then
		drawDoppel()
	elseif kind == "flower" then
		drawFlower()
	else
		draw(((math.max(1, si) - 1) % 5) + 1)
	end
	JumpScare.lastKind = kind or "monster"
	if scream then
		task.spawn(scream)
	end
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		-- 확 다가온다(0.12초) → 세게 흔들림 → 살짝 커지며 사라진다
		local s = if t < 0.12 then 0.35 + (t / 0.12) * 0.9 else 1.25 + t * 0.15
		scale.Scale = s
		local shake = if t < JumpScare.Duration * 0.8 then 0.025 else 0.008
		face.Position = UDim2.fromScale(0.5 + (math.random() - 0.5) * shake, 0.5 + (math.random() - 0.5) * shake)
		back.BackgroundColor3 = if t < 0.05 or (t > 0.25 and t < 0.29) then Color3.fromRGB(60, 60, 60) else Color3.new(0, 0, 0)
		if t >= JumpScare.Duration then
			conn:Disconnect()
			gui.Enabled = false
			face.Position = UDim2.fromScale(0.5, 0.5)
			busy = false
		end
	end)
end

function JumpScare.state()
	return { count = JumpScare.count, showing = gui.Enabled, kind = JumpScare.lastKind }
end

return JumpScare
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">KeyHUD</string>
          <string name="Source"><![CDATA[--!strict
-- 오른쪽 위 표시(게임 중에만): 열쇠(팀이 찾았는가, ReplicatedStorage 속성 HasKey), 목숨(내 Lives, 스테이지마다 3개).
-- 위쪽 가운데: 안전 구역(시작 방) 안에 있으면 "안전 구역" 표시.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)

local KeyHUD = {}
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KeyHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 5

local function makeLabel(y: number, size: number): TextLabel
	local l = Instance.new("TextLabel")
	l.AnchorPoint = Vector2.new(1, 0)
	l.Position = UDim2.new(1, -24, 0, y)
	l.Size = UDim2.fromOffset(240, size + 10)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamMedium
	l.TextSize = size
	l.TextXAlignment = Enum.TextXAlignment.Right
	l.Parent = gui
	return l
end
local label = makeLabel(18, 18)
local livesLabel = makeLabel(46, 18)

local safeLabel = Instance.new("TextLabel")
safeLabel.AnchorPoint = Vector2.new(0.5, 0)
safeLabel.Position = UDim2.new(0.5, 0, 0, 18)
safeLabel.Size = UDim2.fromOffset(420, 26)
safeLabel.BackgroundTransparency = 1
safeLabel.Font = Enum.Font.GothamMedium
safeLabel.TextSize = 16
safeLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
safeLabel.TextTransparency = 0.15
safeLabel.Text = "안전 구역  —  괴물이 들어오지 못한다"
safeLabel.Visible = false
safeLabel.Parent = gui
gui.Parent = player:WaitForChild("PlayerGui")

local function playing(): boolean
	return ReplicatedStorage:GetAttribute("Mode") == "Game" and ReplicatedStorage:GetAttribute("RoundState") == "Playing"
end

local function refresh()
	gui.Enabled = playing()
	label.Visible = Config.Key.Required
	local has = ReplicatedStorage:GetAttribute("HasKey") == true
	label.Text = if has then "열쇠  있음 — 출구로" else "열쇠  없음"
	label.TextColor3 = if has then Color3.fromRGB(235, 235, 235) else Color3.fromRGB(140, 140, 140)
	-- 목숨: 남은 것은 ♥, 잃은 것은 ♡
	local lives = (player:GetAttribute("Lives") :: number?) or Config.Lives.PerStage
	local hearts = {}
	for i = 1, Config.Lives.PerStage do
		table.insert(hearts, if i <= lives then "♥" else "♡")
	end
	livesLabel.Text = "목숨  " .. table.concat(hearts, " ")
	livesLabel.TextColor3 = if lives <= 1 then Color3.fromRGB(230, 120, 120) else Color3.fromRGB(220, 220, 220)
end

-- 안전 구역 칸(스테이지 폴더 속성 SafeTiles: "x,y;x,y;…")
local safeSet: { [string]: boolean } = {}
local safeSrc: string? = nil
local function inSafe(pos: Vector3): boolean
	local stage = workspace:FindFirstChild("Stage")
	local s = stage and stage:GetAttribute("SafeTiles")
	if type(s) ~= "string" then
		return false
	end
	if s ~= safeSrc then
		safeSrc = s
		table.clear(safeSet)
		for _, k in string.split(s, ";") do
			safeSet[k] = true
		end
	end
	return safeSet[math.floor(pos.X / 8) .. "," .. math.floor(pos.Z / 8)] == true
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.2 then
		return
	end
	acc = 0
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	safeLabel.Visible = Config.SafeZone.Enabled and playing() and root ~= nil and player:GetAttribute("Status") == "Alive" and inSafe(root.Position)
end)

function KeyHUD.state()
	return { visible = gui.Enabled, text = label.Text, lives = livesLabel.Text, safe = safeLabel.Visible }
end

for _, a in { "HasKey", "Mode", "RoundState" } do
	ReplicatedStorage:GetAttributeChangedSignal(a):Connect(refresh)
end
player:GetAttributeChangedSignal("Lives"):Connect(refresh)
refresh()

return KeyHUD
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">LobbyUI</string>
          <string name="Source"><![CDATA[--!strict
-- 로비 화면: 방 목록, 방 만들기 / 참가 / 나가기 / 시작(방장).
-- 1인칭이라 마우스가 가운데 묶여 있으므로 Tab 으로 메뉴를 열면 마우스가 풀린다(다시 Tab 이면 둘러보기).
-- 방 목록은 서버가 ReplicatedStorage 속성 "Rooms"(JSON)로, 내 방은 Player 속성 "RoomId" 로 알려 준다.

local HttpService = game:GetService("HttpService")
local SocialService = game:GetService("SocialService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local LobbyUI = {}

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RoomAction = Remotes:WaitForChild("RoomAction") :: RemoteEvent

local WHITE = Color3.fromRGB(235, 235, 235)
local GREY = Color3.fromRGB(140, 140, 140)

local gui = Instance.new("ScreenGui")
gui.Name = "Lobby"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 10
gui.Enabled = false

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(1, 0.5)
panel.Position = UDim2.new(1, -24, 0.5, 0)
panel.Size = UDim2.fromOffset(460, 420)
panel.BackgroundColor3 = Color3.new(0, 0, 0)
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
panel.Parent = gui
local stroke = Instance.new("UIStroke")
stroke.Color = GREY
stroke.Thickness = 1
stroke.Parent = panel

local function label(text: string, y: number, size: number, color: Color3, h: number?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Position = UDim2.fromOffset(16, y)
	l.Size = UDim2.new(1, -32, 0, h or (size + 6))
	l.Font = Enum.Font.GothamMedium
	l.TextSize = size
	l.TextColor3 = color
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Text = text
	l.Parent = panel
	return l
end

local title = label("로비 — 방", 14, 20, WHITE)
-- (방 사람이 많으면(최대 6명) 이름이 다 들어가게 글자를 줄인다)
title.TextScaled = true
do
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = 20
	c.MinTextSize = 11
	c.Parent = title
end
local hint = label("Tab: 메뉴 열기 (마우스)", 42, 14, GREY)
local msg = label("", 380, 14, Color3.fromRGB(226, 75, 74), 30)

local list = Instance.new("Frame")
list.BackgroundTransparency = 1
list.Position = UDim2.fromOffset(16, 70)
list.Size = UDim2.new(1, -32, 0, 230)
list.Parent = panel
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list

local bar = Instance.new("Frame")
bar.BackgroundTransparency = 1
bar.Position = UDim2.fromOffset(16, 316)
bar.Size = UDim2.new(1, -32, 0, 44)
bar.Parent = panel
local barLayout = Instance.new("UIListLayout")
barLayout.FillDirection = Enum.FillDirection.Horizontal
barLayout.Padding = UDim.new(0, 8)
barLayout.Parent = bar

-- 메뉴가 열려 있을 때 마우스를 풀어 주는 버튼(Modal)
local modal = Instance.new("TextButton")
modal.Name = "MouseFree"
modal.Modal = true
modal.BackgroundTransparency = 1
modal.Text = ""
modal.Size = UDim2.fromOffset(0, 0)
modal.Visible = false
modal.Parent = gui

gui.Parent = player:WaitForChild("PlayerGui")

type Btn = { button: TextButton, run: () -> () }
local buttons: { [string]: Btn } = {}

local function button(parent: Instance, text: string, width: number, run: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(width, 36)
	b.BackgroundColor3 = Color3.new(0, 0, 0)
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 15
	b.TextColor3 = WHITE
	b.Text = text
	b.AutoButtonColor = true
	local s = Instance.new("UIStroke")
	s.Color = WHITE
	s.Thickness = 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = b
	b.Activated:Connect(run)
	b.Parent = parent
	buttons[text] = { button = b, run = run }
	return b
end

local menuOpen = false
local message = ""
local msgUntil = 0

function LobbyUI.act(action: string, arg: any?)
	RoomAction:FireServer(action, arg)
end

local function rooms(): { any }
	local s = ReplicatedStorage:GetAttribute("Rooms")
	if type(s) ~= "string" then
		return {}
	end
	local ok, v = pcall(HttpService.JSONDecode, HttpService, s)
	return if ok and type(v) == "table" then v else {}
end

local function render()
	table.clear(buttons)
	for _, c in list:GetChildren() do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	for _, c in bar:GetChildren() do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	local myId = player:GetAttribute("RoomId")
	local mine = nil
	local all = rooms()
	for i, r in all do
		if r.id == myId then
			mine = r
		end
		local row = Instance.new("Frame")
		row.LayoutOrder = i
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 36)
		row.Parent = list
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, -86, 1, 0)
		t.Font = Enum.Font.Gotham
		t.TextSize = 14
		t.TextColor3 = if r.id == myId then WHITE else GREY
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.TextTruncate = Enum.TextTruncate.AtEnd
		t.Text = string.format("방 %d · %s · %d/%d%s%s", r.id, r.host, #r.names, r.max, if r.friendsOnly then " · 친구만" else "", if r.started then " · 시작 중" else "")
		t.Parent = row
		if r.id ~= myId and not r.started and #r.names < r.max then
			local b = button(row, "참가 " .. r.id, 78, function()
				LobbyUI.act("join", r.id)
			end)
			b.Position = UDim2.new(1, -78, 0, 0)
			b.Size = UDim2.fromOffset(78, 34)
		end
	end
	if #all == 0 then
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, 30)
		t.Font = Enum.Font.Gotham
		t.TextSize = 14
		t.TextColor3 = GREY
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.Text = "열린 방이 없습니다. 방을 만들어 보세요."
		t.Parent = list
	end
	if mine then
		title.Text = string.format("방 %d — %s", mine.id, table.concat(mine.names, ", "))
		button(bar, "나가기", 100, function()
			LobbyUI.act("leave")
		end)
		if mine.hostId == player.UserId then
			button(bar, "시작", 70, function()
				LobbyUI.act("start")
			end)
			local fo = mine.friendsOnly == true
			button(bar, if fo then "친구만 끄기" else "친구만 켜기", 110, function()
				LobbyUI.act("friendsOnly", not fo)
			end)
		else
			local w = Instance.new("TextLabel")
			w.BackgroundTransparency = 1
			w.Size = UDim2.fromOffset(160, 36)
			w.Font = Enum.Font.Gotham
			w.TextSize = 14
			w.TextColor3 = GREY
			w.Text = "방장이 시작하기를 기다리는 중"
			w.Parent = bar
		end
	else
		title.Text = "로비 — 방"
		button(bar, "방 만들기", 140, function()
			LobbyUI.act("create")
		end)
	end
	-- 친구 초대(Roblox 초대 창): 초대받은 친구는 이 로비 서버로 들어온다
	button(bar, "친구 초대", 100, function()
		task.spawn(function()
			local ok, can = pcall(SocialService.CanSendGameInviteAsync, SocialService, player)
			if ok and can then
				pcall(SocialService.PromptGameInvite, SocialService, player)
			else
				LobbyUI.message("지금은 초대 창을 열 수 없습니다(Studio 에서는 열리지 않습니다)")
			end
		end)
	end)
	msg.Text = if os.clock() < msgUntil then message else ""
	hint.Text = if menuOpen then "Tab: 메뉴 닫기 (둘러보기)" else "Tab: 메뉴 열기 (마우스)"
end

local function inLobby(): boolean
	return ReplicatedStorage:GetAttribute("RoundState") == "Lobby"
end

local function refresh()
	local show = inLobby()
	gui.Enabled = show
	if not show then
		menuOpen = false
	end
	modal.Visible = show and menuOpen
	if show then
		render()
	end
end

function LobbyUI.setMenu(open: boolean)
	menuOpen = open and inLobby()
	refresh()
end

function LobbyUI.message(text: string, seconds: number?)
	message = text
	msgUntil = os.clock() + (seconds or 4)
	refresh()
	task.delay((seconds or 4) + 0.05, refresh)
end

-- (테스트) 지금 보이는 버튼을 누른 것과 같게
function LobbyUI.click(text: string): boolean
	local b = buttons[text]
	if b and b.button.Visible and gui.Enabled then
		b.run()
		return true
	end
	return false
end

-- 메뉴가 열려 마우스가 풀려 있는가(커서 표시 여부)
function LobbyUI.mouseFree(): boolean
	return modal.Visible
end

function LobbyUI.state()
	local names = {}
	for t in buttons do
		table.insert(names, t)
	end
	table.sort(names)
	return { visible = gui.Enabled, menuOpen = menuOpen, mouseFree = modal.Visible, rooms = #rooms(), myRoom = player:GetAttribute("RoomId"), buttons = names, title = title.Text, message = msg.Text }
end

UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.Tab and inLobby() then
		LobbyUI.setMenu(not menuOpen)
	end
end)
ReplicatedStorage:GetAttributeChangedSignal("Rooms"):Connect(refresh)
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(refresh)
player:GetAttributeChangedSignal("RoomId"):Connect(refresh)
refresh()

return LobbyUI
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="47">
        <Properties>
          <string name="Name">Main</string>
          <string name="Source"><![CDATA[--!strict
-- 클라이언트 진입점(StarterPlayerScripts.Main)
--   좌클릭 → 음파(즉시 로컬 표시 + 서버에 알림), 다른 플레이어 음파 표시, 스테이지 로드 대기 → 음파 월드 빌드,
--   사망·탈출 후 관전, 결과 화면, 상호작용 안내.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage.Shared.Config)
-- 휴대폰·태블릿 가벼운 모드: 메모리·처리량이 작아 부하가 크면 연결이 먼저 끊긴다(오류 277).
-- 음파 선 파트 수와 한 프레임에 새로 보이는 선 수를 줄인다(보이는 범위·시간은 같고, 아주 빽빽한 곳에서 먼 선이 조금 덜 그려진다)
if UserInputService.TouchEnabled and (not UserInputService.MouseEnabled or not UserInputService.KeyboardEnabled) then
	local S = Config.Sonar :: any
	S.PoolSize = math.min(S.PoolSize, 2000)
	S.RevealPerFrame = math.min(S.RevealPerFrame, 220)
end
local World = require(script.Parent:WaitForChild("SonarWorld"))
local Lines = require(script.Parent:WaitForChild("SonarLines"))
local Pulses = require(script.Parent:WaitForChild("SonarPulses"))
local Movement = require(script.Parent:WaitForChild("Movement"))
local Audio = require(script.Parent:WaitForChild("Audio"))
local UI = require(script.Parent:WaitForChild("UI"))
local MapView = require(script.Parent:WaitForChild("MapView"))
local LobbyUI = require(script.Parent:WaitForChild("LobbyUI"))
local Mates = require(script.Parent:WaitForChild("Mates"))
local KeyHUD = require(script.Parent:WaitForChild("KeyHUD"))
local JumpScare = require(script.Parent:WaitForChild("JumpScare"))
local SearchLook = require(script.Parent:WaitForChild("SearchLook"))
local DoppelFx = require(script.Parent:WaitForChild("DoppelFx"))
-- 괴물 전신 움직임(발 고정 IK·무게중심·관성). 발이 땅에 닿는 순간 발소리
local MonsterAnim = require(script.Parent:WaitForChild("MonsterAnim"))
MonsterAnim.onStep = function(model: Model, at: Vector3, hit: number)
	Audio.monsterFoot(model, at, hit)
end
local Reveal = require(script.Parent:WaitForChild("Reveal"))
local MobileUI = require(script.Parent:WaitForChild("MobileUI"))
Pulses.onReach = MapView.onReach
-- 음파가 시작될 때(내 것·팀원 것): 도플갱어 눈 빛 + 맞은 괴물은 10초 동안 지금 모습 그대로 보이게(굳은 잔상 선은 그리지 않는다)
World.skipMonster = Reveal.has
Audio.stepAudible = Reveal.active -- (괴물 발소리는 음파에 걸린 동안만)
Pulses.onStart = function(origin: Vector3)
	DoppelFx.onPulse(origin)
	Reveal.onPulse(origin)
end

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SonarFire = Remotes:WaitForChild("SonarFire") :: RemoteEvent
local SonarPulse = Remotes:WaitForChild("SonarPulse") :: RemoteEvent
local RoundEvent = Remotes:WaitForChild("RoundEvent") :: RemoteEvent

local lastFire = -math.huge
local spectateIndex = 1
local building = false
local frameTimes: { number } = {}
local luaTimes: { number } = {}
local prof = { pulses = 0, lines = 0, frames = 0 } -- (테스트용) 프레임당 음파 연산 시간 나눠 보기

-- ── 스테이지 로드 → 음파 월드 ──
local function tryBuild()
	local stage = workspace:FindFirstChild("Stage") :: Folder?
	if not stage or building then
		return
	end
	local id = stage:GetAttribute("BuildId")
	if not id or (World.ready and World.buildId == id and World.stage == stage) then
		return
	end
	building = true
	task.spawn(function()
		-- 모든 파트가 복제될 때까지
		local want = (stage:GetAttribute("PartCount") :: number?) or 0
		local t0 = os.clock()
		while os.clock() - t0 < 20 do
			local n = 0
			for _, d in stage:GetDescendants() do
				if d:IsA("BasePart") then
					n += 1
				end
			end
			if n >= want then
				break
			end
			task.wait(0.2)
		end
		Pulses.clear()
		Lines.clear()
		DoppelFx.clear()
		Reveal.clear()
		World.build(stage)
		MapView.load(stage)
		task.spawn(Lines.prewarm, 2500) -- 선 파트 미리 만들기(음파 도중 끊김 방지)
		building = false
		if stage:GetAttribute("BuildId") ~= World.buildId then
			tryBuild()
		end
	end)
end
workspace.ChildAdded:Connect(function(c)
	if c.Name == "Stage" then
		c:GetAttributeChangedSignal("BuildId"):Connect(tryBuild)
		task.defer(tryBuild)
	end
end)
local existing = workspace:FindFirstChild("Stage")
if existing then
	existing:GetAttributeChangedSignal("BuildId"):Connect(tryBuild)
	tryBuild()
end

-- ── 음파 발사 ──
local function alive(): boolean
	return player:GetAttribute("Status") == "Alive"
end

local function fire(): boolean
	if not alive() or not World.ready or player:GetAttribute("Hidden") then
		return false
	end
	local now = os.clock()
	if now - lastFire < Config.Sonar.Cooldown then
		return false
	end
	local char = player.Character
	local head = char and char:FindFirstChild("Head") :: BasePart?
	if not head then
		return false
	end
	lastFire = now
	Pulses.start(head.Position, char, true)
	SonarFire:FireServer()
	Audio.sonar(true, head.Position)
	return true
end

local function charOf(userId: number): Model?
	local p = Players:GetPlayerByUserId(userId)
	return p and p.Character
end

SonarPulse.OnClientEvent:Connect(function(userId: number, origin: Vector3)
	if typeof(origin) ~= "Vector3" then
		return
	end
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - origin).Magnitude > Config.Sonar.RemoteViewDistance then
		return
	end
	Pulses.start(origin, charOf(userId), false)
	Audio.sonar(false, origin)
end)

-- ── 관전 ──
local function spectateTargets(): { Player }
	local out = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("Status") == "Alive" and p.Character and p.Character:FindFirstChild("Head") then
			table.insert(out, p)
		end
	end
	return out
end

local function spectating(): boolean
	local st = player:GetAttribute("Status")
	return (st == "Dead" or st == "Escaped") and ReplicatedStorage:GetAttribute("RoundState") == "Playing"
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if spectating() then
			spectateIndex += 1
		else
			fire()
		end
	end
end)

-- ── 상호작용 안내(문, 숨는 곳) ──
local function promptText(prompt: ProximityPrompt): string
	if prompt:GetAttribute("HideSpot") and player:GetAttribute("Hidden") then
		return "E   나가기"
	end
	return "E   " .. prompt.ActionText
end
-- 지금 안내 중인 것: 다른 안내가 사라지는 신호가 늦게 와도(문 → 사물함으로 바로 옮길 때) 지금 것을 지우지 않는다
local shownPrompt: ProximityPrompt? = nil
ProximityPromptService.PromptShown:Connect(function(prompt)
	if prompt.Style == Enum.ProximityPromptStyle.Custom then
		shownPrompt = prompt
		UI.setPrompt(promptText(prompt))
		local function refresh()
			if shownPrompt == prompt then
				UI.setPrompt(promptText(prompt))
			end
		end
		local conn = prompt:GetPropertyChangedSignal("ActionText"):Connect(refresh)
		local conn2 = player:GetAttributeChangedSignal("Hidden"):Connect(refresh)
		prompt.PromptHidden:Once(function()
			conn:Disconnect()
			conn2:Disconnect()
			if shownPrompt == prompt then
				shownPrompt = nil
				UI.setPrompt(nil)
			end
		end)
	end
end)

-- ── 휴대폰 화면 버튼(MobileUI) 연결: 키보드·마우스와 같은 동작 ──
MobileUI.spectating = spectating
MobileUI.onSonar = function()
	if spectating() then
		spectateIndex += 1
	else
		fire()
	end
end
MobileUI.canInteract = function(): boolean
	return SearchLook.target() ~= nil or shownPrompt ~= nil
end
MobileUI.onInteract = function()
	-- 조준한 서랍·뚜껑이 먼저(E 와 같다), 아니면 지금 안내 중인 문·숨는 곳
	if SearchLook.target() then
		SearchLook.use()
		return
	end
	local pr = shownPrompt
	if pr then
		pr:InputHoldBegin()
		task.delay(0.1, function()
			pr:InputHoldEnd()
		end)
	end
end
MobileUI.onMap = function()
	MapView.toggle()
end
MobileUI.onMenu = function()
	LobbyUI.setMenu(not LobbyUI.state().menuOpen)
end

-- ── 라운드 이벤트 ──
local function resetCamera()
	local cam = workspace.CurrentCamera
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		if hum then
			cam.CameraSubject = hum
		end
	end
	UI.setSpectate(nil)
end

player.CharacterAdded:Connect(function()
	Movement.reset()
	task.defer(resetCamera)
	UI.hideOverlay(true)
end)

RoundEvent.OnClientEvent:Connect(function(kind: string, data: any)
	if kind == "Start" then
		UI.hideOverlay(false)
		UI.setStage(data.name)
		if data.stage == 1 then
			task.delay(2.5, UI.hint, if MobileUI.state().enabled then "음파 버튼 — 음파      달리기 · 웅크리기 버튼은 눌러서 켜고 끄기" else "좌클릭 — 음파      Shift — 달리기      Ctrl — 웅크리기", 7)
		end
		task.delay(if data.stage == 1 then 10 else 2.5, UI.hint, if MobileUI.state().enabled then "상자와 서랍(상호작용 버튼)을 뒤져 열쇠를 찾아야 출구가 열린다" else "상자와 서랍(E)을 뒤져 열쇠를 찾아야 출구가 열린다", 6)
	elseif kind == "DoppelBurst" then
		-- 도플갱어의 사람 모습이 터진다(조각이 흩날림)
		DoppelFx.burst(data)
		Audio.doppelBurst(data.at)
	elseif kind == "LifeLost" then
		-- 잡혔지만 목숨이 남았다: 점프스케어 → 잠깐 검은 화면 → 시작 방에서 다시(캐릭터가 생기면 화면이 걷힌다)
		if data.userId == player.UserId then
			if data.why == "monster" or data.why == "doppel" or data.why == "flower" then
				JumpScare.play(function()
					-- 잡은 괴물의 자기 괴성(도플갱어 / 그 스테이지 메인 괴물)
					local si = (ReplicatedStorage:GetAttribute("StageIndex") :: number?) or 1
					local voice = if data.why == "doppel" then "Doppel" elseif data.why == "flower" then "Flower" else tostring((math.max(1, si) - 1) % 5 + 1)
					Audio.play(Audio.voiceName(voice, "Scream") or "MonsterAlert", nil, 0.03, 0.8)
				end, data.why)
				task.wait(JumpScare.Duration)
			end
			if player:GetAttribute("Status") == "Respawning" then
				UI.overlay("잡혔다", string.format("남은 목숨 %d — 시작 방에서 다시 시작합니다", data.lives), true)
			end
		else
			local who = Players:GetPlayerByUserId(data.userId)
			UI.hint(string.format("%s 님이 잡혔다 — 남은 목숨 %d", if who then who.DisplayName else "팀원", data.lives), 4)
		end
	elseif kind == "Died" then
		if data.userId == player.UserId and (data.why == "monster" or data.why == "doppel" or data.why == "flower") then
			-- 점프스케어: 괴물 얼굴이 확 뜬 뒤 YOU DIED (도플갱어는 머리~배가 세로로 벌어진 입)
			JumpScare.play(function()
				-- 잡은 괴물의 자기 괴성(도플갱어 / 그 스테이지 메인 괴물)
				local si = (ReplicatedStorage:GetAttribute("StageIndex") :: number?) or 1
				local voice = if data.why == "doppel" then "Doppel" elseif data.why == "flower" then "Flower" else tostring((math.max(1, si) - 1) % 5 + 1)
				Audio.play(Audio.voiceName(voice, "Scream") or "MonsterAlert", nil, 0.03, 0.8)
			end, data.why)
			task.wait(JumpScare.Duration)
		end
		if data.userId == player.UserId then
			if data.othersAlive > 0 then
				UI.overlay("YOU DIED", "목숨을 모두 잃었다 — 관전으로 전환합니다", true)
				task.delay(2.5, function()
					if spectating() then
						UI.liftOverlay()
					end
				end)
			else
				UI.overlay("YOU DIED", "스테이지를 다시 시작합니다", true)
			end
		end
	elseif kind == "Escaped" then
		if data.userId == player.UserId then
			UI.overlay("ESCAPED", if data.othersAlive > 0 then "다른 생존자를 기다립니다" else "", true)
			task.delay(2.5, function()
				if spectating() then
					UI.liftOverlay()
				end
			end)
		end
	elseif kind == "Lobby" then
		UI.hideOverlay(false)
		UI.setSpectate(nil)
		UI.setStage("로비")
		task.delay(1.5, UI.hint, if MobileUI.state().enabled then "방 메뉴 버튼 — 방 만들기·참가      음파 버튼 — 음파" else "Tab — 방 메뉴      좌클릭 — 음파      Q — 지도", 7)
	elseif kind == "KeyFound" then
		UI.hint((if data.userId == player.UserId then "열쇠를 찾았다" else (data.by .. " 님이 열쇠를 찾았다")) .. " — 이제 출구가 열린다", 5)
	elseif kind == "SearchResult" then
		local t = if data.result == "searching" then "뒤지는 중…" elseif data.result == "empty" then "비어 있다" else "이미 뒤진 곳이다"
		UI.hint(t, if data.result == "searching" then 1 else 2)
	elseif kind == "ExitLocked" then
		UI.hint("출구가 잠겨 있다 — 상자나 서랍에서 열쇠를 찾아야 한다", 3)
	elseif kind == "RoomMsg" then
		LobbyUI.message(data.text)
	elseif kind == "RoomStarting" then
		LobbyUI.message("게임을 시작합니다…", 6)
	elseif kind == "Clear" then
		local sub = if data.allClear then (if data.toLobby then "모든 스테이지를 탈출했습니다 — 로비로 돌아갑니다" else "모든 스테이지를 탈출했습니다 — 처음부터 다시 시작합니다") else ("다음: " .. data.nextName)
		UI.overlay("STAGE CLEAR", sub, true)
		UI.setSpectate(nil)
	elseif kind == "Failed" then
		local solo = #Players:GetPlayers() == 1
		UI.overlay("YOU DIED", if solo then "스테이지를 다시 시작합니다" else "모두 사망했습니다 — 스테이지를 다시 시작합니다", true)
		UI.setSpectate(nil)
	end
end)

-- ── 매 프레임 ──
-- 관전 카메라 보간 상태
local specCF: CFrame? = nil
local specTarget: Player? = nil
RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	-- 마우스 커서: 1인칭에서는 숨긴다(조준점만). 로비 메뉴(Tab)를 열었을 때만 보인다
	UserInputService.MouseIconEnabled = LobbyUI.mouseFree()
	table.insert(frameTimes, dt)
	if #frameTimes > 240 then
		table.remove(frameTimes, 1)
	end
	Movement.update(dt)
	Pulses.update(now)
	local tl = os.clock()
	Lines.update(now)
	prof.pulses += tl - now
	prof.lines += os.clock() - tl
	prof.frames += 1
	table.insert(luaTimes, os.clock() - now)
	if #luaTimes > 240 then
		table.remove(luaTimes, 1)
	end
	UI.setCooldown((now - lastFire) / Config.Sonar.Cooldown)
	-- 관전 카메라: 살아 있는 동료의 1인칭 시점
	local cam = workspace.CurrentCamera
	if spectating() and cam then
		local targets = spectateTargets()
		if #targets > 0 then
			local t = targets[((spectateIndex - 1) % #targets) + 1]
			-- (머리는 걷는 애니메이션으로 흔들리고 네트워크로 계단처럼 움직여 떨렸다:
			--  몸 가운데(루트)의 눈높이를 따라가며 부드럽게 보간한다. 대상이 바뀌면 바로 그 자리로)
			local troot = t.Character and t.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local head = troot
			if head then
				cam.CameraType = Enum.CameraType.Scriptable
				local want = head.CFrame * CFrame.new(0, 1.6, 0)
				if specTarget ~= t or not specCF or (specCF.Position - want.Position).Magnitude > 12 then
					specCF = want
					specTarget = t
				else
					specCF = (specCF :: CFrame):Lerp(want, 1 - math.exp(-dt * 10))
				end
				cam.CFrame = specCF :: CFrame
				UI.setSpectate("관전 중: " .. t.DisplayName .. "   (좌클릭: 대상 변경)")
			end
		else
			UI.setSpectate("관전할 생존자가 없습니다")
		end
	end
end)
RunService.Heartbeat:Connect(function()
	Audio.update()
end)

-- ── 자동 테스트 응답(Studio 테스트 하네스가 만든 TestProbe 가 있을 때만) ──
task.spawn(function()
	local probe = ReplicatedStorage:WaitForChild("TestProbe", 30) :: RemoteFunction?
	if not probe then
		return
	end
	probe.OnClientInvoke = function(cmd: string, arg: any)
		if cmd == "stats" then
			local sum, worst = 0, 0
			for _, t in frameTimes do
				sum += t
				worst = math.max(worst, t)
			end
			local ls = Lines.stats()
			return {
				ready = World.ready,
				buildId = World.buildId,
				steps = Audio.steps,
				build = { seconds = World.buildSeconds, cpu = World.buildCpu, segs = World.segCount },
				prof = { pulsesMs = if prof.frames > 0 then prof.pulses / prof.frames * 1000 else 0, linesMs = if prof.frames > 0 then prof.lines / prof.frames * 1000 else 0 },
				segs = World.segCount,
				culled = World.culled,
				unattached = World.unattached,
				viewParts = #World.viewParts,
				grid = { World.nx, World.ny, World.nz },
				lines = ls,
				pulses = Pulses.active(),
				pulsesStarted = Pulses.started,
				avgFrame = if #frameTimes > 0 then sum / #frameTimes else 0,
				lua = (function()
					local s2, w2 = 0, 0
					for _, t in luaTimes do
						s2 += t
						w2 = math.max(w2, t)
					end
					return { avg = if #luaTimes > 0 then s2 / #luaTimes else 0, worst = w2 }
				end)(),
				worstFrame = worst,
				ui = UI.state(),
				mode = Movement.mode,
				walkSpeed = (function()
					local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					return h and h.WalkSpeed or 0
				end)(),
				lighting = {
					brightness = game:GetService("Lighting").Brightness,
					ambient = game:GetService("Lighting").Ambient,
					outdoor = game:GetService("Lighting").OutdoorAmbient,
				},
			}
		elseif cmd == "fire" then
			return fire()
		elseif cmd == "rawFire" then
			-- 로컬 대기시간을 무시하고 서버에 바로 요청(서버 검증 시험)
			SonarFire:FireServer()
			return true
		elseif cmd == "move" then
			local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if h then
				h:MoveTo(arg :: Vector3)
			end
			return h ~= nil
		elseif cmd == "resetPerf" then
			table.clear(frameTimes)
			table.clear(luaTimes)
			prof.pulses, prof.lines, prof.frames = 0, 0, 0
			Lines.maxColor, Lines.maxPlace = 0, 0
			return true
		elseif cmd == "resetCooldown" then
			lastFire = -math.huge
			return true
		elseif cmd == "pulseAt" then
			-- 시각 효과만(서버에 알리지 않음): 지정 지점에서 음파
			return Pulses.start(arg :: Vector3, player.Character, true)
		elseif cmd == "floorEndsNear" then
			-- 바닥 높이 수평 선분 중 끝점이 p 에서 r 안에 있는 것의 수(모서리까지 선이 닿는가)
			local t = arg :: { any }
			local p, r = t[1] :: Vector3, t[2] :: number
			local n = 0
			for i = 1, World.segCount do
				local sa, sb = World.SA[i], World.SB[i]
				if math.abs(sa.Y - sb.Y) < 0.05 and math.abs(sa.Y - p.Y) < 0.3 and ((sa - p).Magnitude < r or (sb - p).Magnitude < r) then
					n += 1
				end
			end
			return n
		elseif cmd == "linesNear" then
			local t = arg :: { any }
			return Lines.countNear(t[1], t[2])
		elseif cmd == "lookTarget" or cmd == "useLook" then
			-- (테스트) arg 위치를 바라보게 한 뒤
			if typeof(arg) == "Vector3" then
				local cam = workspace.CurrentCamera
				cam.CFrame = CFrame.lookAt(cam.CFrame.Position, arg :: Vector3)
			end
			return if cmd == "lookTarget" then SearchLook.target() else SearchLook.use()
		elseif cmd == "soundCheck" then
			-- 실제 녹음 소리(괴성 후보 전부 + 괴물 발소리)가 이 게임에서 불러와지는가
			local ids = {}
			for _, r in (Config :: any).RealScreams do
				table.insert(ids, "rbxassetid://" .. r.Id)
				if r.Layer then
					table.insert(ids, "rbxassetid://" .. r.Layer.Id)
				end
			end
			table.insert(ids, (Config.Sounds :: any).MonsterStep.Id)
			local sounds = {}
			for _, id in ids do
				local snd = Instance.new("Sound")
				snd.SoundId = id
				snd.Volume = 0
				snd.Parent = workspace
				table.insert(sounds, snd)
			end
			local bad = {}
			pcall(function()
				game:GetService("ContentProvider"):PreloadAsync(sounds, function(contentId, status)
					if status ~= Enum.AssetFetchStatus.Success then
						table.insert(bad, contentId .. "=" .. status.Name)
					end
				end)
			end)
			local lengths = {}
			for _, snd in sounds do
				table.insert(lengths, math.floor(snd.TimeLength * 10) / 10)
				snd:Destroy()
			end
			return { total = #ids, bad = bad, lengths = lengths }
		elseif cmd == "prompts" then
			-- 주변 ProximityPrompt(거리·켜짐·이름) — 안내가 안 뜰 때 원인 찾기
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local out = {}
			for _, d in workspace:GetDescendants() do
				if d:IsA("ProximityPrompt") and d.Parent and d.Parent:IsA("BasePart") and root then
					local dist = ((d.Parent :: BasePart).Position - root.Position).Magnitude
					if dist < 12 then
						table.insert(out, string.format("%s %.1f/%d en=%s %s", d.ActionText, dist, d.MaxActivationDistance, tostring(d.Enabled), d.Parent:GetFullName()))
					end
				end
			end
			table.insert(out, "svc=" .. tostring(game:GetService("ProximityPromptService").Enabled))
			return table.concat(out, " ; ")
		elseif cmd == "mobile" then
			if arg ~= nil then
				player:SetAttribute("ForceMobileUI", arg == true)
			end
			task.wait(0.4)
			return MobileUI.state()
		elseif cmd == "reveal" then
			return Reveal.count()
		elseif cmd == "anim" then
			-- (테스트) 괴물 몸 움직임 측정: 디딘 발 미끄러짐, 걸음 수, 골반 오르내림, 척추 비틀림, 머리 지연, 실제 발소리 수
			local s = MonsterAnim.summary()
			s.footSounds = Audio.monsterSteps
			if arg == "reset" or arg == "all" then
				if arg == "all" then
					MonsterAnim.range = 1e9 -- (테스트) 멀리 있는 괴물도 계산
				end
				MonsterAnim.reset()
				Audio.monsterSteps = 0
			end
			return s
		elseif cmd == "doppelFx" then
			return { bursts = DoppelFx.bursts, shards = DoppelFx.lastShards, eyes = DoppelFx.litEyeCount(), sounds = Audio.bursts }
		elseif cmd == "jump" then
			local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if h then
				h.Jump = true
			end
			return h ~= nil
		elseif cmd == "cursor" then
			return UserInputService.MouseIconEnabled
		elseif cmd == "jumpscare" then
			return JumpScare.state()
		elseif cmd == "keyHud" then
			return KeyHUD.state()
		elseif cmd == "mates" then
			return Mates.count()
		elseif cmd == "lobby" then
			return LobbyUI.state()
		elseif cmd == "lobbyClick" then
			return LobbyUI.click(arg :: string)
		elseif cmd == "lobbyMenu" then
			LobbyUI.setMenu(arg == true)
			return LobbyUI.state()
		elseif cmd == "map" then
			return MapView.state()
		elseif cmd == "toggleMap" then
			MapView.toggle()
			return MapView.state()
		elseif cmd == "trace" then
			local p = Pulses.last
			if not p or not p.trace then
				return nil
			end
			return { trace = p.trace, revealed = p.revealed, origin = p.origin }
		elseif cmd == "lit" then
			return Lines.litMidpoints()
		elseif cmd == "segInfo" then
			-- 지정 선분 id 의 가운데 점
			return World.SM[arg :: number]
		elseif cmd == "segsNear" then
			-- arg = {pos, radius}: 그 근처 정적 선분 id
			local out = {}
			for i = 1, World.segCount do
				if (World.SM[i] - arg[1]).Magnitude <= arg[2] then
					table.insert(out, i)
				end
			end
			return out
		elseif cmd == "setMode" then
			Movement.forced = arg
			return true
		elseif cmd == "cell" then
			local x, y, z = World.cellOf(arg :: Vector3)
			if not x then
				return "out"
			end
			return if World.free(World.index(x :: number, y :: number, z :: number)) then "free" else "blocked"
		end
		return nil
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">MapView</string>
          <string name="Source"><![CDATA[--!strict
-- 지도(Q): 나와 팀원의 음파가 닿은 곳이 그려지고, 그 스테이지가 끝날 때까지 남는다(게임 화면의 선은 그대로 사라진다).
-- 검은 바탕에 벽 윤곽을 흰 선으로, 내 위치는 빨간 칸, 팀원은 흰 테두리 칸. 출구는 음파가 닿았을 때만 표시.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local World = require(script.Parent:WaitForChild("SonarWorld"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
-- 팀 지도 공유: 내가 새로 밝힌 칸을 서버에 보내고, 서버가 모은 팀 전체 기록을 받는다(멀리 있는 팀원·다시 살아남·재접속도 같은 지도)
local MapShare = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("MapShare") :: RemoteEvent
local currentBuild: number? = nil

local Map = {}

local player = Players.LocalPlayer
local T = 8 -- 맵 한 칸(스터드), StageBuilder 와 같다
local LINE = 2 -- 선 굵기(픽셀)

local rows: { string } = {}
local W, H = 0, 0
local explored: { [number]: boolean } = {}
local drawn: { [number]: boolean } = {}
local lineCount = 0
local exploredCount = 0
local isOpen = false

-- ── 화면 ──
local gui = Instance.new("ScreenGui")
gui.Name = "SonarMap"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 20
gui.Enabled = false

local back = Instance.new("Frame")
back.Name = "Back"
back.Size = UDim2.fromScale(1, 1)
back.BackgroundColor3 = Color3.new(0, 0, 0)
back.BackgroundTransparency = 0.04
back.BorderSizePixel = 0
back.Parent = gui

local canvas = Instance.new("Frame")
canvas.Name = "Canvas"
canvas.AnchorPoint = Vector2.new(0.5, 0.5)
canvas.Position = UDim2.fromScale(0.5, 0.52)
canvas.Size = UDim2.fromScale(0.9, 0.86)
canvas.BackgroundTransparency = 1
canvas.Parent = back
local aspect = Instance.new("UIAspectRatioConstraint")
aspect.AspectRatio = 1
aspect.Parent = canvas

local lines = Instance.new("Folder")
lines.Name = "Lines"
lines.Parent = canvas

local function square(color: Color3, px: number, z: number): Frame
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = UDim2.fromOffset(px, px)
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.Visible = false
	f.Parent = canvas
	return f
end
local me = square(Color3.fromRGB(226, 75, 74), 10, 3)
-- 내가 바라보는 방향: 내 칸 가운데에서 앞쪽으로 퍼지는 반투명 원뿔(시야, 약 70°). 멀어질수록 흐려진다.
-- 가운데를 축으로 도는 투명 틀(look) 안에, 가운데에서 뻗는 가는 빛줄기를 부채꼴로 겹쳐 그린다
local look = Instance.new("Frame")
look.Name = "Look"
look.AnchorPoint = Vector2.new(0.5, 0.5)
look.Size = UDim2.fromOffset(110, 110)
look.BackgroundTransparency = 1
look.ZIndex = 2
look.Visible = false
look.Parent = canvas
do
	local CONE = Color3.fromRGB(226, 75, 74)
	local HALF = 35 -- 원뿔 반각(도)
	local RAYS = 15
	for k = 0, RAYS - 1 do
		local ang = -HALF + (2 * HALF) * k / (RAYS - 1)
		local holder = Instance.new("Frame")
		holder.AnchorPoint = Vector2.new(0.5, 0.5)
		holder.Position = UDim2.fromScale(0.5, 0.5)
		holder.Size = UDim2.fromScale(1, 1)
		holder.BackgroundTransparency = 1
		holder.Rotation = ang
		holder.ZIndex = 2
		holder.Parent = look
		local ray = Instance.new("Frame")
		ray.AnchorPoint = Vector2.new(0, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = UDim2.new(0.5, 0, 0, 5)
		ray.BackgroundColor3 = CONE
		ray.BorderSizePixel = 0
		ray.ZIndex = 2
		ray.Parent = holder
		-- 가까울수록 진하고 멀수록 사라진다(빛줄기가 겹쳐 가운데가 더 진해 보이게 한 줄은 꽤 투명하게)
		local g = Instance.new("UIGradient")
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.72), NumberSequenceKeypoint.new(0.6, 0.85), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = ray
	end
end
-- 팀원 표시(흰 테두리 칸), 필요한 만큼 만든다
local mates: { Frame } = {}
local function mateMark(i: number): Frame
	local f = mates[i]
	if not f then
		f = square(Color3.new(0, 0, 0), 10, 3)
		local st = Instance.new("UIStroke")
		st.Color = Color3.new(1, 1, 1)
		st.Thickness = 2
		st.Parent = f
		mates[i] = f
	end
	return f
end
local exitMark = square(Color3.new(1, 1, 1), 8, 2)

local title = Instance.new("TextLabel")
title.BackgroundTransparency = 1
title.Position = UDim2.new(0, 24, 0, 16)
title.Size = UDim2.new(0.6, 0, 0, 24)
title.Font = Enum.Font.GothamMedium
title.TextSize = 16
title.TextXAlignment = Enum.TextXAlignment.Left
title.TextColor3 = Color3.fromRGB(150, 150, 150)
title.Text = "지도  ·  나와 팀원의 음파가 닿은 곳이 기록됩니다  ·  Q 닫기"
title.Parent = back

gui.Parent = player:WaitForChild("PlayerGui")

-- ── 격자 ──
local function at(i: number, j: number): string
	if j < 1 or j > H or i < 1 or i > W then
		return "#"
	end
	return rows[j]:sub(i, i)
end
local function isWall(i: number, j: number): boolean
	return at(i, j) == "#"
end

-- 격자 꼭짓점 (x1,y1)-(x2,y2) 사이 선(가로 또는 세로 한 칸)
local function line(x1: number, y1: number, x2: number, y2: number)
	local key = ((y1 * 1024 + x1) * 2) + (if y1 == y2 then 0 else 1)
	if drawn[key] then
		return
	end
	drawn[key] = true
	lineCount += 1
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BorderSizePixel = 0
	if y1 == y2 then
		f.Position = UDim2.new(x1 / W, -LINE / 2, y1 / H, -LINE / 2)
		f.Size = UDim2.new((x2 - x1) / W, LINE, 0, LINE)
	else
		f.Position = UDim2.new(x1 / W, -LINE / 2, y1 / H, -LINE / 2)
		f.Size = UDim2.new(0, LINE, (y2 - y1) / H, LINE)
	end
	f.Parent = lines
end

local function markTile(i: number, j: number): boolean
	local k = j * 1024 + i
	if explored[k] or isWall(i, j) or i < 1 or j < 1 or i > W or j > H then
		return false
	end
	explored[k] = true
	exploredCount += 1
	if isWall(i, j - 1) then
		line(i - 1, j - 1, i, j - 1)
	end
	if isWall(i, j + 1) then
		line(i - 1, j, i, j)
	end
	if isWall(i - 1, j) then
		line(i - 1, j - 1, i - 1, j)
	end
	if isWall(i + 1, j) then
		line(i, j - 1, i, j)
	end
	if at(i, j) == "E" then
		exitMark.Position = UDim2.fromScale((i - 0.5) / W, (j - 0.5) / H)
		exitMark.Visible = true
	end
	return true
end

-- 새 스테이지: 기록을 지운다
function Map.load(stage: Instance)
	local s = stage:GetAttribute("Rows")
	rows = if type(s) == "string" then string.split(s, "/") else {}
	H = #rows
	W = if H > 0 then #rows[1] else 0
	table.clear(explored)
	table.clear(drawn)
	lines:ClearAllChildren()
	lineCount = 0
	exploredCount = 0
	exitMark.Visible = false
	aspect.AspectRatio = if H > 0 then W / H else 1
	-- 팀이 이미 밝힌 칸을 서버에서 받아 온다(다시 살아나거나 다시 들어와도 지도가 이어진다)
	currentBuild = stage:GetAttribute("BuildId") :: number?
	MapShare:FireServer("sync")
end

-- 서버가 보낸 팀원 기록(같은 스테이지일 때만)
MapShare.OnClientEvent:Connect(function(data: any)
	if type(data) ~= "table" or data.build ~= currentBuild or type(data.tiles) ~= "table" or W == 0 then
		return
	end
	for _, k in data.tiles do
		if type(k) == "number" then
			markTile(k % 1024, k // 1024)
		end
	end
end)

-- 내 음파가 끝났다: 닿은 복셀의 칸을 기록
function Map.onReach(dist: { [number]: number }, radius: number)
	if W == 0 then
		return
	end
	local fresh = {}
	for idx, d in dist do
		if d <= radius then
			local c = World.cellCenter(idx)
			local i, j = math.floor(c.X / T) + 1, math.floor(c.Z / T) + 1
			if markTile(i, j) then
				table.insert(fresh, j * 1024 + i)
			end
		end
	end
	-- 새로 밝힌 칸을 팀에 알린다
	if #fresh > 0 and currentBuild then
		MapShare:FireServer({ build = currentBuild, tiles = fresh })
	end
end

function Map.setOpen(v: boolean)
	isOpen = v
	gui.Enabled = v
end

function Map.toggle()
	Map.setOpen(not isOpen)
end

function Map.state()
	local shown = 0
	for _, f in mates do
		if f.Visible then
			shown += 1
		end
	end
	return { open = isOpen, explored = exploredCount, lines = lineCount, exitShown = exitMark.Visible, meShown = me.Visible, matesShown = shown }
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q then
		Map.toggle()
	end
end)

RunService.RenderStepped:Connect(function()
	if not isOpen or W == 0 then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		me.Position = UDim2.fromScale(root.Position.X / (W * T), root.Position.Z / (H * T))
		me.Visible = true
		-- 바라보는 방향(카메라가 보는 쪽, 지도는 X → 오른쪽, Z → 아래)
		local cam = workspace.CurrentCamera
		local lv = if cam then cam.CFrame.LookVector else root.CFrame.LookVector
		local flat = Vector2.new(lv.X, lv.Z)
		if flat.Magnitude > 0.05 then
			look.Position = me.Position
			look.Rotation = math.deg(math.atan2(flat.Y, flat.X))
			look.Visible = true
		end
	else
		me.Visible = false
		look.Visible = false
	end
	-- 살아 있는 팀원(같은 게임의 다른 플레이어)
	local n = 0
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("Status") == "Alive" then
			local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then
				n += 1
				local f = mateMark(n)
				f.Position = UDim2.fromScale(r.Position.X / (W * T), r.Position.Z / (H * T))
				f.Visible = true
			end
		end
	end
	for i = n + 1, #mates do
		mates[i].Visible = false
	end
end)

return Map
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Mates</string>
          <string name="Source"><![CDATA[--!strict
-- 함께 하는 플레이어(팀원)는 음파와 상관없이 늘 흰 윤곽선으로 보인다(실제 아바타 모양, Highlight).
-- 벽 너머는 가려진다(DepthMode Occluded). 살아 있는(Status "Alive") 다른 플레이어만, 내 캐릭터는 제외.
-- Highlight 는 이 클라이언트에만 만들어진다(복제되지 않음).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Mates = {}
local player = Players.LocalPlayer
local NAME = "MateOutline"

local function wanted(p: Player): Model?
	if p == player or p:GetAttribute("Status") ~= "Alive" then
		return nil
	end
	return p.Character
end

local function sync()
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local want = wanted(p)
		local h = char and char:FindFirstChild(NAME) :: Highlight?
		if want and not h then
			local hl = Instance.new("Highlight")
			hl.Name = NAME
			hl.Adornee = want
			hl.FillTransparency = 1
			hl.OutlineColor = Color3.new(1, 1, 1)
			hl.OutlineTransparency = 0.3
			hl.DepthMode = Enum.HighlightDepthMode.Occluded
			hl.Parent = want
		elseif h and not want then
			h:Destroy()
		end
	end
end

-- (테스트) 윤곽선이 켜진 팀원 수
function Mates.count(): number
	local n = 0
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local h = char and char:FindFirstChild(NAME) :: Highlight?
		if h and h.Enabled and p ~= player then
			n += 1
		end
	end
	return n
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc >= 0.25 then
		acc = 0
		sync()
	end
end)

return Mates
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">MobileUI</string>
          <string name="Source"><![CDATA[--!strict
-- 휴대폰·태블릿용 화면 버튼(터치 기기에서만 보인다. PC 조작은 그대로).
-- 이동·점프·시점은 로블록스 기본 터치 조작(왼쪽 조이스틱·점프 버튼·화면 끌기)을 그대로 쓴다.
--   음파(좌클릭)        → 크게 "음파" (관전 중이면 "다음 사람")
--   달리기(Shift)·웅크리기(Ctrl) → 눌러서 켜고 끄기(둘 중 하나만)
--   상호작용(E)        → 서랍·상자·문·숨는 곳을 볼 때만 나타난다
--   지도(Q)            → 지도 열기/닫기
--   방 메뉴(Tab)       → 로비에서만
-- 실제 동작은 Main 이 콜백(onSonar 등)으로 연결한다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local MobileUI = {}
MobileUI.run = false
MobileUI.crouch = false
MobileUI.onSonar = nil :: (() -> ())?
MobileUI.onInteract = nil :: (() -> ())?
MobileUI.canInteract = nil :: (() -> boolean)?
MobileUI.onMap = nil :: (() -> ())?
MobileUI.onMenu = nil :: (() -> ())?
MobileUI.spectating = nil :: (() -> boolean)?

local player = Players.LocalPlayer

-- 터치 기기인가. 휴대폰·태블릿은 기기마다 키보드·마우스가 있다고 보고되기도 해서 넉넉하게 본다:
--   터치가 되고 (마우스가 없거나, 키보드가 없거나, 마지막 입력이 터치) 이거나, 화면을 한 번이라도 터치했으면 켠다.
--   속성 ForceMobileUI 로 PC 에서도 켜 볼 수 있다(테스트)
local sawTouch = false
UserInputService.TouchStarted:Connect(function()
	sawTouch = true
end)
UserInputService.LastInputTypeChanged:Connect(function(t)
	if t == Enum.UserInputType.Touch then
		sawTouch = true
	end
end)
local function isTouch(): boolean
	if player:GetAttribute("ForceMobileUI") or sawTouch then
		return true
	end
	if not UserInputService.TouchEnabled then
		return false
	end
	return not UserInputService.MouseEnabled or not UserInputService.KeyboardEnabled or UserInputService:GetLastInputType() == Enum.UserInputType.Touch
end

local gui = Instance.new("ScreenGui")
gui.Name = "MobileUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 25 -- (지도(20)·방 메뉴(10) 위: 지도를 연 채로도 닫을 수 있게. 점프스케어(50) 아래)
gui.Enabled = false

local WHITE = Color3.fromRGB(235, 235, 235)
local DIM = Color3.fromRGB(20, 20, 20)

local function button(name: string, text: string, size: number, pos: UDim2, textSize: number): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = text
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Position = pos
	b.Size = UDim2.fromOffset(size, size)
	b.BackgroundColor3 = DIM
	b.BackgroundTransparency = 0.35
	b.TextColor3 = WHITE
	b.Font = Enum.Font.GothamMedium
	b.TextSize = textSize
	b.AutoButtonColor = true
	b.Active = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Color = WHITE
	stroke.Transparency = 0.4
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	b.Parent = gui
	return b
end

local sonarBtn = button("Sonar", "음파", 100, UDim2.new(), 22)
local runBtn = button("Run", "달리기", 64, UDim2.new(), 15)
local crouchBtn = button("Crouch", "웅크리기", 64, UDim2.new(), 14)
local useBtn = button("Use", "E\n상호작용", 70, UDim2.new(), 14)
local mapBtn = button("Map", "지도", 56, UDim2.new(), 15)
local menuBtn = button("Menu", "방 메뉴", 62, UDim2.new(), 13)

-- ── 배치: 오른손 엄지가 닿는 부채꼴(음파 가운데, 달리기·웅크리기·상호작용이 둘레), 버튼 사이 간격 약 25px ──
-- 좌표는 작은 휴대폰(짧은 변 약 390) 기준 "버튼 가운데" 위치(화면 오른쪽 아래 / 오른쪽 위 모서리에서의 거리), 지름.
-- 휴대폰에서는 로블록스 점프 버튼을 없앴으므로(이 게임에서는 점프가 거의 필요 없다) 음파를 엄지가 쉬는 오른쪽 아래에 둔다.
type Slot = { b: TextButton, x: number, y: number, d: number, text: number, top: boolean? }
local LAYOUT: { Slot } = {
	{ b = sonarBtn, x = -110, y = -95, d = 100, text = 22 }, -- 음파: 오른쪽 아래 엄지 자리, 가장 크게
	{ b = runBtn, x = -215, y = -55, d = 64, text = 15 }, -- 달리기: 음파 왼쪽 아래(엄지를 왼쪽으로)
	{ b = crouchBtn, x = -210, y = -150, d = 64, text = 14 }, -- 웅크리기: 달리기 위
	{ b = useBtn, x = -105, y = -200, d = 70, text = 14 }, -- 상호작용: 음파 바로 위
	{ b = mapBtn, x = -52, y = 118, d = 56, text = 15, top = true }, -- 지도(게임 중): 오른쪽 위, 목숨 표시 아래
	{ b = menuBtn, x = -56, y = 122, d = 62, text = 13, top = true }, -- 방 메뉴(로비): 지도와 같은 자리
}
local hookedJump: Instance? = nil -- (로블록스 점프 버튼: 다시 켜지는 순간 바로 숨긴다)
local lastVP = Vector2.zero
local function layout()
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(812, 375)
	if vp == lastVP then
		return
	end
	lastVP = vp
	local short = math.min(vp.X, vp.Y)
	-- 작은 휴대폰은 조금 작게, 태블릿은 크게
	local s = math.clamp(short / 390, 0.85, 1.3)
	local shift = 0
	for _, slot in LAYOUT do
		local d = math.floor(slot.d * s)
		slot.b.Size = UDim2.fromOffset(d, d)
		slot.b.TextSize = math.floor(slot.text * s)
		if slot.top then
			slot.b.Position = UDim2.new(1, slot.x * s, 0, slot.y * s)
		else
			slot.b.Position = UDim2.new(1, slot.x * s + shift, 1, slot.y * s)
		end
	end
end
layout()

local function paintToggle(b: TextButton, on: boolean)
	b.BackgroundColor3 = if on then Color3.fromRGB(230, 230, 230) else DIM
	b.TextColor3 = if on then Color3.fromRGB(10, 10, 10) else WHITE
end

sonarBtn.Activated:Connect(function()
	if MobileUI.onSonar then
		MobileUI.onSonar()
	end
end)
runBtn.Activated:Connect(function()
	MobileUI.run = not MobileUI.run
	if MobileUI.run then
		MobileUI.crouch = false
	end
	paintToggle(runBtn, MobileUI.run)
	paintToggle(crouchBtn, MobileUI.crouch)
end)
crouchBtn.Activated:Connect(function()
	MobileUI.crouch = not MobileUI.crouch
	if MobileUI.crouch then
		MobileUI.run = false
	end
	paintToggle(runBtn, MobileUI.run)
	paintToggle(crouchBtn, MobileUI.crouch)
end)
useBtn.Activated:Connect(function()
	if MobileUI.onInteract then
		MobileUI.onInteract()
	end
end)
mapBtn.Activated:Connect(function()
	if MobileUI.onMap then
		MobileUI.onMap()
	end
end)
menuBtn.Activated:Connect(function()
	if MobileUI.onMenu then
		MobileUI.onMenu()
	end
end)

gui.Parent = player:WaitForChild("PlayerGui")

-- 상황에 맞게 보이기(0.15초마다)
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.15 then
		return
	end
	acc = 0
	local on = isTouch()
	gui.Enabled = on
	if not on then
		return
	end
	layout() -- (화면을 돌리거나 크기가 바뀌면 다시 배치)
	-- 로블록스 기본 점프 버튼 숨기기(휴대폰에서만. 로블록스가 상태에 따라 다시 켜므로 계속 확인)
	local pg = player:FindFirstChildOfClass("PlayerGui")
	local touchGui = pg and pg:FindFirstChild("TouchGui")
	local frame = touchGui and touchGui:FindFirstChild("TouchControlFrame")
	local jump = frame and frame:FindFirstChild("JumpButton")
	if jump and jump:IsA("GuiObject") then
		if jump.Visible then
			jump.Visible = false
		end
		if hookedJump ~= jump then
			hookedJump = jump
			local j = jump :: GuiObject
			j:GetPropertyChangedSignal("Visible"):Connect(function()
				if j.Visible and gui.Enabled then
					j.Visible = false
				end
			end)
		end
	end
	local mode = ReplicatedStorage:GetAttribute("Mode")
	local lobby = mode == "Lobby"
	local playing = mode == "Game" and ReplicatedStorage:GetAttribute("RoundState") == "Playing"
	local alive = player:GetAttribute("Status") == "Alive"
	local spect = MobileUI.spectating ~= nil and MobileUI.spectating()
	sonarBtn.Visible = lobby or playing
	sonarBtn.Text = if spect then "다음\n사람" else "음파"
	runBtn.Visible = alive and (lobby or playing)
	crouchBtn.Visible = alive and (lobby or playing)
	useBtn.Visible = alive and MobileUI.canInteract ~= nil and MobileUI.canInteract()
	mapBtn.Visible = playing
	menuBtn.Visible = lobby
	-- 죽거나 스테이지가 바뀌면 달리기·웅크리기 해제
	if not alive and (MobileUI.run or MobileUI.crouch) then
		MobileUI.run = false
		MobileUI.crouch = false
		paintToggle(runBtn, false)
		paintToggle(crouchBtn, false)
	end
end)

-- (테스트) 보이는 버튼 이름
function MobileUI.state()
	local shown = {}
	for _, c in gui:GetChildren() do
		if c:IsA("TextButton") and c.Visible then
			table.insert(shown, c.Name)
		end
	end
	table.sort(shown)
	return { enabled = gui.Enabled, buttons = shown, run = MobileUI.run, crouch = MobileUI.crouch }
end

return MobileUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">MonsterAnim</string>
          <string name="Source"><![CDATA[--!strict
-- 괴물 전신 움직임(클라이언트). 서버는 위치·상태만 정하고, 몸은 여기서 매 프레임 만든다(Rig 2 뼈대의 Motor6D.Transform).
--
-- 원리(관절을 그냥 흔들지 않는다):
--  · 발 고정(Foot Planting): 디딘 발은 월드 위치에 못 박힌다. 몸이 앞으로 가서 발이 "제자리(엉덩이 아래 + 진행 방향)"에서
--    보폭 절반 이상 벗어나면 그 발을 들어 다음 착지점으로 옮긴다(한 번에 한 발, 기어갈 때는 대각선 두 발).
--    다리는 2관절 IK 로 그 발 위치에 맞춘다 → 미끄러짐 없음, 보폭·속도가 저절로 맞는다.
--  · 무게중심: 골반 높이는 디딘 다리가 닿을 수 있는 높이로 정해져(다리를 벌리면 내려간다) 걸음마다 오르내리고,
--    체중을 받는 발 쪽으로 좌우 이동한다. 착지하는 순간 질량만큼 아래로 충격(스프링)을 받는다.
--  · 관성: 몸통·머리·팔은 모두 스프링-감쇠로 목표를 따라가 시간차가 생긴다. 가속하면 상체가 먼저 앞으로 쏠리고,
--    멈추면 뒤로 젖혀졌다가 돌아온다. 회전하면 머리 → 가슴 → 골반 순으로 먼저 돌고 안쪽으로 기운다.
--  · 팔: 진자(길이에 맞는 고유 진동수)로 다리 반대 박자에 흔들리고, 몸의 가속에 늦게 따라온다. 아래 마디는 한 박자 더 늦다.
--  · 머리: 몸통 흔들림을 상쇄하며 바라볼 곳(소리 난 곳, 쫓는 대상, 두리번)을 지연을 두고 본다.
--  · 상태별 자세: 대기(호흡·체중 재분배·미세한 떨림·두리번), 경계(낮은 자세, 움찔), 추격(괴물마다 다른 체형별 동작),
--    덮치기 직전(몸을 낮추고 팔을 뒤로 모았다가 앞으로 뻗음).
--
-- 서버 Monster.luau 의 skeleton() 이 만든 뼈 이름을 쓴다: B_Pelvis, B_Chest, B_Neck, B_Head, B_Thigh±1, B_Shin±1, B_Foot±1,
-- B_Upper±1, (B_Mid±1), B_Fore±1, B_Hand±1. 모델 속성 Rig = 2, FloorY, Mass, Voice(머리 모양 번호), State, Form.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Anim = {}
-- 발이 땅에 닿는 순간(발소리): (모델, 발 위치, 세기 0~1.5)
Anim.onStep = nil :: ((Model, Vector3, number) -> ())?
-- (테스트) 모델별 측정값
Anim.stats = {} :: { [Model]: { [string]: number } }

local TWO_PI = math.pi * 2
local GRAVITY = workspace.Gravity

type Spring = { x: number, v: number }
type VSpring = { x: Vector3, v: Vector3 }
local function sp(x: number?): Spring
	return { x = x or 0, v = 0 }
end
-- 스프링-감쇠(freq: 초당 진동수, damp: 1 = 임계 감쇠)
local function step(s: Spring, target: number, freq: number, damp: number, dt: number)
	local w = TWO_PI * freq
	local a = w * w * (target - s.x) - 2 * damp * w * s.v
	s.v += a * dt
	s.x += s.v * dt
end
local function vstep(s: VSpring, target: Vector3, freq: number, damp: number, dt: number)
	local w = TWO_PI * freq
	local a = (target - s.x) * (w * w) - s.v * (2 * damp * w)
	s.v += a * dt
	s.x += s.v * dt
end
-- 벡터 a 를 b 로 돌리는 회전
local function fromTo(a: Vector3, b: Vector3): CFrame
	local axis = a:Cross(b)
	local s = axis.Magnitude
	local c = a:Dot(b)
	if s < 1e-6 then
		if c > 0 then
			return CFrame.identity
		end
		local perp = if math.abs(a.X) < 0.9 then Vector3.xAxis else Vector3.yAxis
		return CFrame.fromAxisAngle(a:Cross(perp).Unit, math.pi)
	end
	return CFrame.fromAxisAngle(axis / s, math.atan2(s, c))
end
local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end
local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- ── 몸 스타일(상태·괴물마다). 숫자는 매 프레임 부드럽게 섞여 전환된다 ──
-- crouch: 골반을 낮추는 정도(다리 길이 비율), lean: 상체 앞 숙임(rad), stride: 보폭 기준(다리 길이 비율),
-- lift: 발 드는 높이(다리 길이 비율), armBase/armSwing: 팔 기본 각도·흔들림, quad: 손도 땅을 짚는다(0~1),
-- wave: 척추 꿈틀(rad), jerk: 꼭두각시처럼 몸 목표를 끊어서 갱신(0~1), limp: 오른 다리 절뚝(0~1),
-- tension: 몸 스프링 진동수 배율(긴장할수록 빠르고 날카롭다), flail: 팔이 몸 반동에 휘둘리는 정도
type Style = { crouch: number, lean: number, stride: number, lift: number, armBase: number, armSwing: number, armSpread: number, quad: number, wave: number, jerk: number, limp: number, tension: number, flail: number, headDrop: number }
local KEYS = { "crouch", "lean", "stride", "lift", "armBase", "armSwing", "armSpread", "quad", "wave", "jerk", "limp", "tension", "flail", "headDrop" }
local function style(t: { [string]: number }): Style
	local base: { [string]: number } = { crouch = 0.08, lean = 0.12, stride = 0.34, lift = 0.16, armBase = 0.12, armSwing = 0.3, armSpread = 0.12, quad = 0, wave = 0, jerk = 0, limp = 0, tension = 1, flail = 0, headDrop = 0 }
	for k, v in t do
		base[k] = v
	end
	return (base :: any) :: Style
end
local WALK = style({})
local ALERT = style({ crouch = 0.2, lean = 0.3, stride = 0.3, armBase = 0.45, armSwing = 0.15, armSpread = 0.25, tension = 1.5 })
-- 쫓아올 때(메인 괴물 머리 모양 번호별): 체형·성격에 맞춘 변형
local CHASE: { [number]: Style } = {
	-- 1 삼각: 무겁게 절뚝이며 앞으로 쏠리고, 긴 팔을 머리 위로 치켜든 채 몸 반동에 휘둘린다
	[1] = style({ crouch = 0.16, lean = 0.5, stride = 0.48, lift = 0.24, armBase = 2.3, armSwing = 0.35, armSpread = 0.35, limp = 0.7, tension = 1.2, flail = 1 }),
	-- 2 사각: 줄 끊긴 꼭두각시. 무릎을 거의 안 굽히고 키를 세운 채, 몸이 줄에 당겨지듯 끊겨 움직이고 팔이 크게 휘둘린다
	[2] = style({ crouch = 0.0, lean = 0.05, stride = 0.42, lift = 0.12, armBase = 0.2, armSwing = 1.1, armSpread = 0.45, jerk = 1, tension = 1.6, flail = 0.6 }),
	-- 3 원: 상체를 땅으로 숙이고 긴 팔로 앞을 짚으며 네 발로 기어온다. 척추가 꿈틀거리며 상체가 끌고 하체가 따라온다
	[3] = style({ crouch = 0.42, lean = 1.25, stride = 0.36, lift = 0.14, armBase = 1.2, armSwing = 0.2, armSpread = 0.2, quad = 1, wave = 0.3, tension = 1.3 }),
	-- 4 별: 키를 세우고 무릎을 높이 들어 크게 성큼 내딛는다. 착지마다 무거운 충격, 팔은 늘어져 출렁인다
	[4] = style({ crouch = -0.02, lean = 0.18, stride = 0.62, lift = 0.6, armBase = 0.05, armSwing = 0.12, armSpread = 0.08, tension = 0.9, flail = 0.5 }),
	-- 5 육각: 몸을 낮추고 팔과 다리로 곤충처럼 잰걸음. 짧고 빠른 보폭
	[5] = style({ crouch = 0.34, lean = 1.0, stride = 0.26, lift = 0.12, armBase = 1.0, armSwing = 0.2, armSpread = 0.35, quad = 1, wave = 0.12, tension = 1.7 }),
}
local DOPPEL_CHASE = style({ crouch = 0.2, lean = 0.55, stride = 0.46, lift = 0.2, armBase = 0.9, armSwing = 0.45, armSpread = 0.3, tension = 1.5, flail = 0.4 })
local FLOWER_RUSH = style({ crouch = 0.12, lean = 0.6, stride = 0.55, lift = 0.22, armBase = -0.35, armSwing = 0.35, armSpread = 0.1, tension = 1.2, flail = 0.8 })
local FLOWER_STILL = style({ crouch = 0.04, lean = 0.06, armBase = 0.02, armSwing = 0.05, headDrop = 0.55, tension = 0.6 })

-- ── 괴물 하나의 몸 ──
type LimbRest = { m1: Motor6D, m2: Motor6D, m3: Motor6D?, mEnd: Motor6D, v1: Vector3, v2: Vector3?, v3: Vector3, tip: Vector3, pole: Vector3 }
type Foot = { pos: Vector3, lifted: boolean, from: Vector3, to: Vector3, t: number, dur: number, planted: boolean }
type Arm = { pitch: Spring, roll: Spring, c1: Spring, c2: Spring, c3: Spring }
type Body = {
	model: Model,
	root: BasePart,
	pelvisM: Motor6D,
	chestM: Motor6D,
	neckM: Motor6D,
	headM: Motor6D,
	pelvisRest: Vector3,
	legs: { [number]: LimbRest },
	arms: { [number]: LimbRest },
	floorY: number,
	mass: number,
	legLen: number,
	armLen: number,
	feet: { [number]: Foot },
	hands: { [number]: Foot },
	st: Style,
	pel: VSpring,
	pelRot: VSpring, -- (pitch, yaw, roll)
	chest: VSpring,
	head: VSpring, -- 머리 월드 방향(yaw, pitch) 기준 몸 회전과 별개
	armS: { [number]: Arm },
	vel: VSpring,
	lastPos: Vector3,
	lastYaw: number,
	yawRate: Spring,
	accel: Vector3, -- 로컬 가속(부드럽게)
	t: number,
	gait: number, -- 걸은 거리 누적(척추 꿈틀 박자)
	idleShift: number,
	nextShift: number,
	look: Vector2, -- 두리번 목표(yaw, pitch)
	nextLook: number,
	lookFreq: number,
	held: { [string]: number }, -- 꼭두각시: 끊어서 갱신한 목표
	nextHold: number,
	freezeUntil: number,
	seed: number,
	lastHeard: any,
	lastState: string,
	stats: { [string]: number },
}

local bodies: { [Model]: Body } = {}

local function motor(model: Model, name: string): Motor6D?
	local m = model:FindFirstChild("B_" .. name, true)
	return if m and m:IsA("Motor6D") then m else nil
end
local function tipOf(m: Motor6D): Vector3
	local p = m.Part1
	local t = p and p:GetAttribute("Tip")
	return if typeof(t) == "Vector3" then t else Vector3.new(0, -0.5, 0)
end
-- 극(무릎·팔꿈치가 굽는 쪽): 뼈 두 마디의 꺾인 방향(없으면 기본)
local function poleOf(v1: Vector3, v2: Vector3, default: Vector3): Vector3
	local u = (v1 + v2).Unit
	local p = v1 - u * v1:Dot(u)
	if p.Magnitude < 0.05 then
		return default
	end
	return p.Unit
end

local function build(model: Model): Body?
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local pelvisM, chestM, neckM, headM = motor(model, "Pelvis"), motor(model, "Chest"), motor(model, "Neck"), motor(model, "Head")
	if not (root and pelvisM and chestM and neckM and headM) then
		return nil
	end
	local legs: { [number]: LimbRest } = {}
	local arms: { [number]: LimbRest } = {}
	for _, s in { -1, 1 } do
		local th, sh, ft = motor(model, "Thigh" .. s), motor(model, "Shin" .. s), motor(model, "Foot" .. s)
		local up, mid, fo, ha = motor(model, "Upper" .. s), motor(model, "Mid" .. s), motor(model, "Fore" .. s), motor(model, "Hand" .. s)
		if not (th and sh and ft and up and fo and ha) then
			return nil
		end
		local v1, v2 = sh.C0.Position, ft.C0.Position
		-- (무릎은 앞쪽으로 굽는 경향: 그림의 꺾인 방향 + 앞)
		local kp = poleOf(v1, v2, -Vector3.zAxis)
		legs[s] = { m1 = th, m2 = sh, mEnd = ft, v1 = v1, v3 = v2, tip = tipOf(ft), pole = (kp + Vector3.new(0, 0, -0.8)).Unit }
		if mid then
			local a1, a2, a3 = mid.C0.Position, fo.C0.Position, ha.C0.Position
			arms[s] = { m1 = up, m2 = mid, m3 = fo, mEnd = ha, v1 = a1, v2 = a2, v3 = a3, tip = tipOf(ha), pole = poleOf(a1 + a2, a3, Vector3.zAxis) }
		else
			local a1, a3 = fo.C0.Position, ha.C0.Position
			arms[s] = { m1 = up, m2 = fo, mEnd = ha, v1 = a1, v3 = a3, tip = tipOf(ha), pole = poleOf(a1, a3, Vector3.zAxis) }
		end
	end
	local legLen = (legs[-1].v1.Magnitude + legs[-1].v3.Magnitude + legs[1].v1.Magnitude + legs[1].v3.Magnitude) / 2
	local a = arms[-1]
	local armLen = a.v1.Magnitude + (if a.v2 then a.v2.Magnitude else 0) + a.v3.Magnitude
	local rcf = root.CFrame
	local function footAt(s: number): Foot
		local L = legs[s]
		local ankleLocal = pelvisM.C0.Position + L.m1.C0.Position + L.v1 + L.v3
		local p = rcf:PointToWorldSpace(ankleLocal)
		return { pos = p, lifted = false, from = p, to = p, t = 0, dur = 0.3, planted = true }
	end
	local function handAt(s: number): Foot
		local A = arms[s]
		local p = rcf:PointToWorldSpace(pelvisM.C0.Position + chestM.C0.Position + A.m1.C0.Position + Vector3.new(0, -armLen * 0.8, -0.5))
		return { pos = p, lifted = false, from = p, to = p, t = 0, dur = 0.3, planted = false }
	end
	local function arm(): Arm
		return { pitch = sp(), roll = sp(), c1 = sp(), c2 = sp(), c3 = sp() }
	end
	local _, yaw = rcf:ToEulerAnglesYXZ()
	local b: Body = {
		model = model,
		root = root,
		pelvisM = pelvisM,
		chestM = chestM,
		neckM = neckM,
		headM = headM,
		pelvisRest = pelvisM.C0.Position,
		legs = legs,
		arms = arms,
		floorY = (model:GetAttribute("FloorY") :: number?) or -5,
		mass = (model:GetAttribute("Mass") :: number?) or 1,
		legLen = legLen,
		armLen = armLen,
		feet = { [-1] = footAt(-1), [1] = footAt(1) },
		hands = { [-1] = handAt(-1), [1] = handAt(1) },
		st = style({}),
		pel = { x = Vector3.zero, v = Vector3.zero },
		pelRot = { x = Vector3.zero, v = Vector3.zero },
		chest = { x = Vector3.zero, v = Vector3.zero },
		head = { x = Vector3.zero, v = Vector3.zero },
		armS = { [-1] = arm(), [1] = arm() },
		vel = { x = Vector3.zero, v = Vector3.zero },
		lastPos = rcf.Position,
		lastYaw = yaw,
		yawRate = sp(),
		accel = Vector3.zero,
		t = math.random() * 10,
		gait = 0,
		idleShift = 0,
		nextShift = 0,
		look = Vector2.zero,
		nextLook = 0,
		lookFreq = 2,
		held = {},
		nextHold = 0,
		freezeUntil = 0,
		seed = math.random() * 1000,
		lastHeard = model:GetAttribute("Heard"),
		lastState = (model:GetAttribute("State") :: string?) or "Wander",
		stats = { steps = 0, slip = 0, pelvisMin = math.huge, pelvisMax = -math.huge, chestYawMax = 0, headLag = 0, frames = 0, leanMax = 0, armMax = 0, liftMax = 0, freezes = 0, handSteps = 0 },
	}
	Anim.stats[model] = b.stats
	return b
end

-- 지금 상태에 맞는 목표 스타일
local function targetStyle(b: Body, speed: number): Style
	local m = b.model
	local state = (m:GetAttribute("State") :: string?) or "Wander"
	local voice = m:GetAttribute("Voice")
	if voice == "Flower" then
		return if speed > 3 then FLOWER_RUSH else FLOWER_STILL
	end
	if state == "Chase" then
		if voice == "Doppel" then
			return DOPPEL_CHASE
		end
		return CHASE[tonumber(voice) or 1] or WALK
	elseif state == "Alert" or state == "Investigate" or state == "Search" or state == "Look" then
		return ALERT
	end
	return WALK
end

-- 가장 가까운 살아 있는 플레이어(덮치기 자세)
local function nearestPlayer(pos: Vector3): (Vector3?, number)
	local best: Vector3?, bestD = nil, math.huge
	for _, p in Players:GetPlayers() do
		local c = p.Character
		local r = c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r and p:GetAttribute("Status") ~= "Dead" then
			local d = (r.Position - pos).Magnitude
			if d < bestD then
				best, bestD = r.Position, d
			end
		end
	end
	return best, bestD
end

-- 2관절 IK: 시작점 H 에서 길이 l1, l2 두 마디로 목표 A 에 닿는 무릎(팔꿈치) 위치
local function solve2(H: Vector3, A: Vector3, l1: number, l2: number, pole: Vector3): (Vector3, Vector3)
	local d = A - H
	local dist = math.clamp(d.Magnitude, math.abs(l1 - l2) + 0.02, (l1 + l2) * 0.999)
	local u = if d.Magnitude > 1e-4 then d.Unit else Vector3.new(0, -1, 0)
	local a = (l1 * l1 - l2 * l2 + dist * dist) / (2 * dist)
	local h = math.sqrt(math.max(l1 * l1 - a * a, 0))
	local p = pole - u * pole:Dot(u)
	p = if p.Magnitude > 1e-4 then p.Unit else Vector3.new(0, 0, -1)
	return H + u * a + p * h, H + u * dist
end

local function update(b: Body, dt: number)
	local root = b.root
	local rcf = root.CFrame
	local rrot = rcf.Rotation
	b.t += dt
	local now = b.t
	local m = b.model

	-- ── 이동량: 속도·가속·회전 속도(부드럽게) ──
	local pos = rcf.Position
	local rawVel = (pos - b.lastPos) / math.max(dt, 1e-3)
	local teleported = (pos - b.lastPos).Magnitude > 6
	b.lastPos = pos
	if teleported then
		-- 순간 이동(되살아남·테스트 배치): 몸 상태를 놓고 발을 새 자리 밑에 다시 딛는다
		rawVel = Vector3.zero
		b.vel.x, b.vel.v = Vector3.zero, Vector3.zero
		b.pel.x, b.pel.v = Vector3.zero, Vector3.zero
		b.chest.v = Vector3.zero
	end
	local prevVel = b.vel.x
	vstep(b.vel, flat(rawVel), 4, 1, dt)
	local vel = b.vel.x
	local speed = vel.Magnitude
	local accW = (vel - prevVel) / math.max(dt, 1e-3)
	local accL = rrot:VectorToObjectSpace(accW)
	b.accel = b.accel:Lerp(accL, math.min(1, dt * 6))
	local _, yaw = rcf:ToEulerAnglesYXZ()
	local dyaw = (yaw - b.lastYaw + math.pi) % TWO_PI - math.pi
	b.lastYaw = yaw
	step(b.yawRate, dyaw / math.max(dt, 1e-3), 1.5, 1, dt)
	local yawRate = math.clamp(b.yawRate.x, -3, 3)

	-- ── 스타일 섞기 ──
	local tgt = targetStyle(b, speed)
	local k = math.min(1, dt * 3)
	local st = b.st :: any
	for _, key in KEYS do
		st[key] = lerp(st[key], (tgt :: any)[key], k)
	end
	local S = b.st
	local legLen = b.legLen
	local tension = S.tension * (if b.mass < 0.8 then 1.25 else 1)

	-- 상태 변화·소리: 움찔(골반이 내려앉고 상체가 뒤로 젖혀졌다 돌아온다)
	local state = (m:GetAttribute("State") :: string?) or "Wander"
	local heard = m:GetAttribute("Heard")
	if heard ~= b.lastHeard or (state ~= b.lastState and (state == "Alert" or state == "Chase")) then
		b.pel.v += Vector3.new(0, -2.2 * legLen / 4, 0.6)
		b.chest.v += Vector3.new(-2.5, 0, 0)
		b.lookFreq = 7
		b.nextLook = now + 1.5
	end
	b.lastHeard = heard
	b.lastState = state

	-- 꼭두각시: 몸 목표를 끊어서 갱신(가끔 완전히 굳는다)
	local jerk = S.jerk > 0.5
	if jerk and now >= b.nextHold then
		b.nextHold = now + 1 / 6
		if math.noise(now * 0.7, b.seed) > 0.42 and now > b.freezeUntil + 1 then
			b.freezeUntil = now + 0.45
			b.stats.freezes += 1
		end
	end

	-- ── 발 고정·걸음 ──
	local quad = S.quad > 0.5
	local stride = legLen * S.stride
	local threshold = stride * 0.5
	local stepDur = math.clamp(0.85 * threshold / math.max(speed, 0.6), 0.14, 0.5) * (if S.lift > 0.4 then 1.35 else 1)
	local dir = if speed > 0.2 then vel.Unit else Vector3.zero
	local groundY = rcf:PointToWorldSpace(Vector3.new(0, b.floorY, 0)).Y
	local function home(s: number): Vector3
		local L = b.legs[s]
		local hipL = b.pelvisRest + L.m1.C0.Position
		local p = rcf:PointToWorldSpace(Vector3.new(hipL.X * 1.1, 0, hipL.Z + (if quad then legLen * 0.15 else 0)))
		local ankleH = L.v1.Y + L.v3.Y + b.pelvisRest.Y + L.m1.C0.Position.Y - b.floorY
		return Vector3.new(p.X, groundY + ankleH, p.Z)
	end
	local idle = speed < 0.4
	if idle and now > b.nextShift then
		b.nextShift = now + 2.5 + math.noise(now, b.seed + 3) * 2 + 1.5
		b.idleShift = if b.idleShift >= 0 then -1 else 1
	end
	type LimbStep = { f: Foot, home: Vector3, side: number, isHand: boolean }
	local limbs: { LimbStep } = {}
	for _, s in { -1, 1 } do
		table.insert(limbs, { f = b.feet[s], home = home(s), side = s, isHand = false })
	end
	if quad then
		for _, s in { -1, 1 } do
			local A = b.arms[s]
			local sh = rcf:PointToWorldSpace(b.pelvisRest + b.chestM.C0.Position + A.m1.C0.Position)
			local fw = rcf.LookVector * (b.armLen * 0.45 + legLen * 0.2)
			local hh = Vector3.new(sh.X + fw.X, groundY + 0.1, sh.Z + fw.Z)
			local hand = b.hands[s]
			if not hand.planted then
				hand.planted, hand.pos, hand.lifted = true, hh, false
			end
			table.insert(limbs, { f = hand, home = hh, side = s, isHand = true })
		end
	else
		for _, s in { -1, 1 } do
			b.hands[s].planted = false
			b.hands[s].lifted = false
		end
	end
	-- 순간 이동했거나 발이 몸에서 너무 멀어졌으면(끊김·지연) 그 발을 제자리에 다시 딛는다
	for _, l in limbs do
		if teleported or flat(l.f.pos - l.home).Magnitude > legLen * 1.6 then
			l.f.pos, l.f.from, l.f.to, l.f.lifted, l.f.t = l.home, l.home, l.home, false, 0
		end
	end
	local function liftedCount(): number
		local n = 0
		for _, l in limbs do
			if l.f.lifted then
				n += 1
			end
		end
		return n
	end
	-- 떠 있는 발 옮기기(포물선 궤적, 착지하면 충격)
	for _, l in limbs do
		local f = l.f
		if f.lifted then
			f.t += dt / f.dur
			if f.t >= 1 then
				f.lifted = false
				f.pos = f.to
				-- 착지: 질량만큼 골반이 내려앉고(무게), 발소리
				local hit = b.mass * math.clamp(speed / 6, 0.35, 1.6) * (if S.lift > 0.4 then 1.6 else 1)
				if not l.isHand then
					b.pel.v += Vector3.new(0, -1.4 * hit, 0)
					b.chest.v += Vector3.new(0.6 * hit, 0, 0)
					if Anim.onStep then
						Anim.onStep(m, f.pos, hit)
					end
					b.stats.steps += 1
				else
					b.stats.handSteps += 1
				end
			else
				local e = f.t * f.t * (3 - 2 * f.t)
				local p = f.from:Lerp(f.to, e)
				local h = (if l.isHand then legLen * 0.12 else legLen * S.lift) * math.sin(math.pi * f.t)
				f.pos = p + Vector3.new(0, h, 0)
				if not l.isHand then
					b.stats.liftMax = math.max(b.stats.liftMax, h / legLen)
				end
			end
		end
	end
	-- 새로 들 발 고르기: 제자리에서 가장 많이 벗어난 발(두 발을 한꺼번에 들지 않는다. 기어갈 때는 대각선 둘까지)
	if not (jerk and now < b.freezeUntil) then
		local maxLift = if quad then 2 else 1
		local best: LimbStep?, bestErr = nil, 0
		for _, l in limbs do
			if not l.f.lifted then
				local want = l.home + dir * threshold * 0.9
				local err = flat(l.f.pos - want).Magnitude
				local need = if idle then 0.18 * legLen else threshold
				if err > need and err > bestErr then
					-- 같은 쪽(기어갈 때: 같은 쪽 손발)이나 반대 다리가 떠 있으면 기다린다 → 대각선 박자
					local ok = true
					for _, o in limbs do
						if o ~= l and o.f.lifted then
							if quad then
								if (o.isHand == l.isHand) or (o.side == l.side) then
									ok = false
								end
							elseif not o.isHand then
								ok = false
							end
						end
					end
					if ok then
						best, bestErr = l, err
					end
				end
			end
		end
		if best and liftedCount() < maxLift then
			local f = best.f
			local predicted = best.home + vel * stepDur
			local to = if idle then best.home else predicted + dir * threshold * 0.85
			-- 절뚝: 오른 다리는 보폭이 짧다
			if not best.isHand and best.side == 1 and S.limp > 0 then
				to = to:Lerp(best.home + vel * stepDur, S.limp * 0.5)
			end
			f.from, f.to, f.t, f.dur, f.lifted = f.pos, to, 0, stepDur * (if best.isHand then 0.85 else 1), true
		end
	end
	b.gait += speed * dt

	-- ── 골반: 높이(디딘 다리가 닿는 만큼) · 체중 이동 · 회전 ──
	local restH = b.pelvisRest.Y - b.floorY
	local wantH = restH - legLen * S.crouch
	local hipW = b.legs[1].m1.C0.Position.X
	local reachLimit = math.huge
	local planted = 0
	local lateral = 0
	local fwdDiff = 0
	for _, s in { -1, 1 } do
		local f = b.feet[s]
		local fl = rcf:PointToObjectSpace(f.pos)
		fwdDiff += -fl.Z * s
		if not f.lifted then
			planted += 1
			local L = b.legs[s]
			local reach = (L.v1.Magnitude + L.v3.Magnitude) * 0.95
			local hip = b.pelvisRest + L.m1.C0.Position
			local horiz = Vector2.new(fl.X - hip.X, fl.Z - hip.Z).Magnitude
			local maxDrop = math.sqrt(math.max(reach * reach - horiz * horiz, 0.01))
			-- 엉덩이 높이 = 발목 높이 + 닿을 수 있는 수직 거리 → 골반 높이로
			local pelvisH = (f.pos.Y - groundY) + maxDrop + (b.pelvisRest.Y - hip.Y)
			reachLimit = math.min(reachLimit, pelvisH)
			lateral += fl.X
		end
	end
	if planted > 0 then
		lateral /= planted
	end
	if idle then
		lateral = b.idleShift * math.abs(hipW) * 0.6
	end
	local height = math.min(wantH, reachLimit) - restH
	-- 꼭두각시: 줄에 매달린 듯 걸음마다 위로 당겨진다
	if jerk then
		height += legLen * 0.06 * math.abs(math.sin(b.gait / math.max(stride, 0.1) * math.pi))
	end
	local pelTarget = Vector3.new(lateral * 0.55, height, if quad then -legLen * 0.1 else 0)
	if jerk then
		local hk = "pel"
		if now >= (b.held[hk .. "t"] or 0) then
			b.held[hk .. "x"], b.held[hk .. "y"] = pelTarget.X, pelTarget.Y
			b.held[hk .. "t"] = now + 1 / 6
		end
		pelTarget = Vector3.new(b.held[hk .. "x"], b.held[hk .. "y"], pelTarget.Z)
	end
	if jerk and now < b.freezeUntil then
		pelTarget = b.pel.x
	end
	local bodyFreq = 2.2 * tension / math.sqrt(b.mass)
	vstep(b.pel, pelTarget, bodyFreq, 0.45, dt)
	-- 골반 회전: 앞으로 나간 다리 쪽으로 비틀고(yaw), 떠 있는 다리 쪽이 처지고(roll), 숙인 만큼 앞으로(pitch)
	local swingSide = 0
	for _, s in { -1, 1 } do
		if b.feet[s].lifted then
			swingSide = s
		end
	end
	local pelRotT = Vector3.new(S.lean * 0.3 + (if quad then 0.25 else 0), math.clamp(fwdDiff * 0.12, -0.35, 0.35) + yawRate * 0.05, -swingSide * 0.06 * math.clamp(speed / 4, 0, 1))
	vstep(b.pelRot, pelRotT, 2.5 * tension, 0.6, dt)

	-- ── 가슴(척추): 숙임 + 가속에 쏠림 + 골반 반대로 비틂 + 회전 방향으로 먼저 돌고 안쪽으로 기움 + 호흡 + 꿈틀 ──
	local breathe = math.sin(now * TWO_PI * 0.27) * (if idle then 0.035 else 0.012)
	local wave = S.wave * math.sin(b.gait / math.max(stride, 0.1) * math.pi)
	local chestT = Vector3.new(
		S.lean - b.pelRot.x.X + math.clamp(b.accel.Z * -0.025, -0.35, 0.35) + breathe + speed * 0.012,
		math.clamp(-b.pelRot.x.Y * 0.75 + yawRate * 0.05 + wave, -0.35, 0.35),
		-yawRate * math.clamp(speed, 0, 10) * 0.012 + wave * 0.4
	)
	if jerk and now < b.freezeUntil then
		chestT = b.chest.x
	end
	vstep(b.chest, chestT, 1.8 * tension / math.sqrt(b.mass), 0.5, dt)

	-- ── 머리: 바라볼 곳을 늦게 따라가며 몸 흔들림을 상쇄 ──
	local focusP: Vector3? = nil
	local near, nearD = nearestPlayer(pos)
	if state == "Chase" and near then
		focusP = near
	else
		local f = m:GetAttribute("Focus")
		if typeof(f) == "Vector3" and now < b.nextLook then
			focusP = f
		end
	end
	if not focusP and now >= b.nextLook then
		-- 두리번: 가끔 홱 돌리고, 가끔 천천히
		b.nextLook = now + 1.5 + (math.noise(now * 0.3, b.seed) + 0.5) * 3
		b.look = Vector2.new((math.noise(now, b.seed + 9) * 2) * 0.9, math.noise(now, b.seed + 17) * 0.4)
		b.lookFreq = if math.noise(now * 2, b.seed) > 0.2 then 6 else 1.6
	end
	local lookYaw, lookPitch = b.look.X, b.look.Y
	if focusP then
		local d = rrot:VectorToObjectSpace(focusP - (pos + Vector3.new(0, restH * 0.8, 0)))
		lookYaw = math.clamp(math.atan2(-d.X, -d.Z), -1.3, 1.3)
		lookPitch = math.clamp(math.atan2(d.Y, Vector2.new(d.X, d.Z).Magnitude), -0.8, 0.6)
	end
	if not idle and not focusP then
		lookYaw *= 0.3
		lookPitch *= 0.3
	end
	-- 머리 떨림(연속 노이즈: 무작위로 튀지 않는다)
	local tremor = (if state == "Alert" or state == "Chase" then 0.04 else 0.015)
	lookYaw += math.noise(now * 2.3, b.seed + 41) * tremor + yawRate * 0.06
	lookPitch += math.noise(now * 2.1, b.seed + 53) * tremor - S.headDrop
	vstep(b.head, Vector3.new(lookPitch, lookYaw, 0), b.lookFreq * (if jerk then 1.4 else 1), 0.7, dt)
	b.lookFreq = lerp(b.lookFreq, 2.5, math.min(1, dt * 0.5))

	-- ── 덮치기: 쫓다가 가까우면 몸을 낮추고 팔을 뒤로 모았다가(선동작) 붙으면 앞으로 뻗으며 상체를 던진다 ──
	local pounce = 0
	local wind = 0
	if state == "Chase" and near then
		wind = math.clamp((8 - nearD) / 3, 0, 1)
		pounce = math.clamp((5 - nearD) / 1.6, 0, 1)
	end

	-- ── 뼈에 적용 ──
	local pelvisCF = CFrame.new(b.pel.x + Vector3.new(0, -wind * legLen * 0.12 * (1 - pounce), 0)) * CFrame.fromEulerAnglesYXZ(b.pelRot.x.X + pounce * 0.3, b.pelRot.x.Y, b.pelRot.x.Z)
	-- 디딘 다리가 발에 닿지 않으면(돌진·숙임으로 골반이 높을 때) 골반을 그만큼 바로 내린다 → 발은 끝까지 그 자리
	do
		local wp = rcf * CFrame.new(b.pelvisRest) * pelvisCF
		local drop = 0
		for _, s in { -1, 1 } do
			local f = b.feet[s]
			if not f.lifted then
				local L = b.legs[s]
				local H = (wp * CFrame.new(L.m1.C0.Position)).Position
				local R = (L.v1.Magnitude + L.v3.Magnitude) * 0.995
				local horiz = flat(H - f.pos).Magnitude
				if horiz < R then
					drop = math.max(drop, (H.Y - f.pos.Y) - math.sqrt(R * R - horiz * horiz))
				end
			end
		end
		if drop > 0 then
			pelvisCF = CFrame.new(0, -drop, 0) * pelvisCF
			b.pel.x -= Vector3.new(0, drop, 0)
		end
	end
	b.pelvisM.Transform = pelvisCF
	local chestRot = CFrame.fromEulerAnglesYXZ(b.chest.x.X + pounce * 0.5 - wind * 0.2 * (1 - pounce), b.chest.x.Y, b.chest.x.Z)
	b.chestM.Transform = chestRot
	local wPelvis = rcf * CFrame.new(b.pelvisRest) * pelvisCF
	local wChest = wPelvis * CFrame.new(b.chestM.C0.Position) * chestRot
	-- 목·머리: 원하는 머리 월드 방향 = 몸 방향 + 바라봄. 가슴 회전을 빼서 목과 머리가 반씩 나눈다
	local headWorld = rrot * CFrame.fromEulerAnglesYXZ(b.head.x.X + pounce * -0.3, b.head.x.Y, 0)
	local rel = wChest.Rotation:Inverse() * headWorld
	local rx, ry, rz = rel:ToEulerAnglesYXZ()
	rx, ry, rz = math.clamp(rx, -1.1, 0.9), math.clamp(ry, -1.4, 1.4), math.clamp(rz, -0.5, 0.5)
	local half = CFrame.fromEulerAnglesYXZ(rx * 0.5, ry * 0.5, rz * 0.5)
	b.neckM.Transform = half
	b.headM.Transform = half
	b.stats.headLag = math.max(b.stats.headLag, math.abs(b.head.v.Y))

	-- 다리 IK(발은 월드에 고정)
	local function solveLeg(s: number)
		local L = b.legs[s]
		local f = b.feet[s]
		local H = (wPelvis * CFrame.new(L.m1.C0.Position)).Position
		local l1, l2 = L.v1.Magnitude, L.v3.Magnitude
		local pole = wPelvis.Rotation * L.pole
		local K, A = solve2(H, f.pos, l1, l2, pole)
		local pr = wPelvis.Rotation
		local t1 = fromTo(L.v1.Unit, pr:VectorToObjectSpace((K - H).Unit))
		L.m1.Transform = t1
		local r1 = pr * t1
		local t2 = fromTo(L.v3.Unit, r1:VectorToObjectSpace((A - K).Unit))
		L.m2.Transform = t2
		local r2 = r1 * t2
		-- 발: 땅에 평평하게(들 때는 발끝이 아래로)
		local footPitch = if f.lifted then -0.5 * math.sin(math.pi * f.t) else 0
		L.mEnd.Transform = r2:Inverse() * rrot * CFrame.Angles(footPitch, 0, 0)
		-- (테스트) 디딘 발이 목표에서 얼마나 떨어졌나(미끄러짐)
		if not f.lifted then
			b.stats.slip = math.max(b.stats.slip, (A - f.pos).Magnitude)
		end
	end
	solveLeg(-1)
	solveLeg(1)

	-- 팔
	for _, s in { -1, 1 } do
		local A = b.arms[s]
		local st2 = b.armS[s]
		local shoulderW = wChest * CFrame.new(A.m1.C0.Position)
		local hand = b.hands[s]
		if quad and hand.planted then
			-- 기어갈 때: 손을 땅에 짚는다(위팔+가운데 마디를 한 마디로, 아래팔을 한 마디로 IK)
			local v12 = A.v1 + (A.v2 or Vector3.zero)
			local l1, l2 = v12.Magnitude, A.v3.Magnitude
			local H = shoulderW.Position
			local K, P = solve2(H, hand.pos, l1, l2, wChest.Rotation * (Vector3.zAxis * 0.6 + Vector3.xAxis * s * 0.4))
			local cr = wChest.Rotation
			local t1 = fromTo(v12.Unit, cr:VectorToObjectSpace((K - H).Unit))
			A.m1.Transform = t1
			local r = cr * t1
			if A.m3 then
				A.m2.Transform = CFrame.identity
				local t3 = fromTo(A.v3.Unit, r:VectorToObjectSpace((P - K).Unit))
				A.m3.Transform = t3
				r = r * t3
			else
				local t3 = fromTo(A.v3.Unit, r:VectorToObjectSpace((P - K).Unit))
				A.m2.Transform = t3
				r = r * t3
			end
			A.mEnd.Transform = r:Inverse() * rrot * CFrame.Angles(-0.3, 0, 0)
			-- 진자 상태를 지금 자세에 맞춰 둔다(손을 뗄 때 튀지 않게)
			st2.pitch.x, st2.pitch.v = lerp(st2.pitch.x, S.armBase, 0.1), 0
		else
			-- 진자: 다리 반대 박자로 흔들리고(반대쪽 발이 앞이면 앞으로), 몸 가속에 늦게 따라오고, 길수록 느리다
			local f1 = rcf:PointToObjectSpace(b.feet[-s].pos)
			local f2 = rcf:PointToObjectSpace(b.feet[s].pos)
			local legSwing = math.clamp((f2.Z - f1.Z) / math.max(stride, 0.5), -1, 1)
			local target = S.armBase + S.armSwing * legSwing * math.clamp(speed / 3, 0, 1)
			target += wind * -0.9 * (1 - pounce) + pounce * 1.6
			local freq = math.sqrt(GRAVITY / math.max(b.armLen, 0.5)) / TWO_PI * 0.55 * tension
			local pd = st2.pitch
			step(pd, target, freq, 0.32, dt)
			-- 관성: 몸이 앞으로 가속하면 팔은 뒤로 처진다. 골반이 오르내리면 휘둘린다
			pd.v += (b.accel.Z * 0.04 - b.pel.v.Y * 0.25 * S.flail) * dt * 6 / math.max(b.armLen / 3, 0.5)
			local rd = st2.roll
			step(rd, S.armSpread + wind * 0.25 + math.abs(yawRate) * 0.05 * s * (if yawRate * s > 0 then 1 else -0.5), freq * 1.1, 0.4, dt)
			rd.v += b.accel.X * 0.03 * s * dt * 6
			local up = CFrame.fromEulerAnglesYXZ(pd.x, 0, rd.x * s)
			A.m1.Transform = up
			-- 아래 마디: 위 마디가 움직이는 속도의 반대로 한 박자 늦게(채찍처럼) + 들어 올린 팔의 아래 마디는 중력으로 처짐
			local droop = -math.max(pd.x - 1.2, 0) * 0.35
			step(st2.c1, -pd.v * 0.06 + droop + pounce * -0.3, freq * 1.6, 0.35, dt)
			step(st2.c2, -st2.c1.v * 0.05 + droop * 0.6 + 0.08, freq * 2.2, 0.35, dt)
			step(st2.c3, -st2.c2.v * 0.04 + 0.1 + math.noise(now * 3, b.seed + s) * 0.06, freq * 3, 0.4, dt)
			if A.m3 then
				A.m2.Transform = CFrame.Angles(st2.c1.x, 0, 0)
				A.m3.Transform = CFrame.Angles(st2.c2.x, 0, 0)
			else
				A.m2.Transform = CFrame.Angles(st2.c1.x + st2.c2.x, 0, 0)
			end
			A.mEnd.Transform = CFrame.Angles(st2.c3.x, 0, 0)
		end
	end

	-- (테스트) 측정
	local st3 = b.stats
	st3.frames += 1
	st3.pelvisMin = math.min(st3.pelvisMin, b.pel.x.Y)
	st3.pelvisMax = math.max(st3.pelvisMax, b.pel.x.Y)
	st3.chestYawMax = math.max(st3.chestYawMax, math.abs(b.chest.x.Y))
	st3.leanMax = math.max(st3.leanMax, b.chest.x.X + b.pelRot.x.X)
	st3.armMax = math.max(st3.armMax, b.armS[-1].pitch.x, b.armS[1].pitch.x)
end

Anim.range = 170 -- 이 거리 안의 괴물만 움직임을 계산한다(테스트는 전부)
local function animated(m: Model): boolean
	if m:GetAttribute("Rig") ~= 2 then
		return false
	end
	local f = m:GetAttribute("Form")
	return f ~= "Disguise" and f ~= "Bursting"
end

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 1 / 20)
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	for _, inst in CollectionService:GetTagged(Config.Tags.Monster) do
		local m = inst :: Model
		if m:IsA("Model") and m.Parent and animated(m) then
			local b = bodies[m]
			local root = m.PrimaryPart
			if root and (root.Position - camPos).Magnitude < Anim.range then
				if not b or b.root ~= root or not b.pelvisM.Parent then
					b = build(m)
					bodies[m] = b
				end
				if b then
					update(b, dt)
				end
			end
		end
	end
	for m in bodies do
		if not m.Parent then
			bodies[m] = nil
			Anim.stats[m] = nil
		end
	end
end)

-- (테스트) 측정값 요약: 움직인 괴물들 중 최대 미끄러짐, 걸음 수, 골반 오르내림 폭 등
function Anim.summary(): { [string]: number }
	local out = { bodies = 0, steps = 0, slip = 0, pelvisRange = 0, chestYaw = 0, headLag = 0, lean = 0, arm = 0, lift = 0, freezes = 0, handSteps = 0 }
	for _, st in Anim.stats do
		out.bodies += 1
		out.steps += st.steps
		out.slip = math.max(out.slip, st.slip)
		if st.pelvisMax > st.pelvisMin then
			out.pelvisRange = math.max(out.pelvisRange, st.pelvisMax - st.pelvisMin)
		end
		out.chestYaw = math.max(out.chestYaw, st.chestYawMax)
		out.headLag = math.max(out.headLag, st.headLag)
		out.lean = math.max(out.lean, st.leanMax)
		out.arm = math.max(out.arm, st.armMax)
		out.lift = math.max(out.lift, st.liftMax)
		out.freezes += st.freezes
		out.handSteps += st.handSteps
	end
	return out
end
function Anim.reset()
	for _, st in Anim.stats do
		st.steps, st.slip, st.pelvisMin, st.pelvisMax, st.chestYawMax, st.headLag, st.frames = 0, 0, math.huge, -math.huge, 0, 0, 0
		st.leanMax, st.armMax, st.liftMax, st.freezes, st.handSteps = 0, -math.huge, 0, 0, 0
	end
end

return Anim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">Movement</string>
          <string name="Source"><![CDATA[--!strict
-- 이동(걷기/달리기/웅크리기)과 1인칭 카메라 효과(아주 약한 헤드밥, 웅크릴 때 시점 낮춤, 추격 중 미세한 긴장감).
-- Shift = 달리기, Ctrl = 웅크리기(누르고 있는 동안). 둘을 동시에 누르면 웅크리기.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage.Shared.Config)
local MobileUI = require(script.Parent:WaitForChild("MobileUI")) -- (휴대폰 화면 버튼: 달리기·웅크리기)

local MV = Config.Move
local SetMoveMode = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SetMoveMode") :: RemoteEvent

local Movement = {}
Movement.mode = "Walk"
Movement.forced = nil :: string?
local sentMode = ""
local bobPhase = 0
local crouchDrop = 0
local tension = 0

local SPEED = { Walk = MV.Walk, Run = MV.Run, Crouch = MV.Crouch }

local function wantedMode(): string
	if Movement.forced then
		return Movement.forced
	end
	if UserInputService:GetFocusedTextBox() then
		return "Walk"
	end
	local crouch = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) or MobileUI.crouch
	if crouch then
		return "Crouch"
	end
	local run = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) or MobileUI.run
	if run then
		return "Run"
	end
	return "Walk"
end

function Movement.update(dt: number)
	local player = Players.LocalPlayer
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local cam = workspace.CurrentCamera
	if not hum or not root or player:GetAttribute("Status") ~= "Alive" then
		if cam and cam.FieldOfView ~= 70 then
			cam.FieldOfView = 70
		end
		return
	end
	local mode = wantedMode()
	Movement.mode = mode
	hum.WalkSpeed = SPEED[mode]
	if mode ~= sentMode then
		sentMode = mode
		SetMoveMode:FireServer(mode)
	end

	-- 시점: 웅크리기 높이 + 헤드밥
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local targetDrop = if mode == "Crouch" then MV.CrouchCameraDrop else 0
	crouchDrop += (targetDrop - crouchDrop) * math.min(1, dt * 10)
	local amp = if mode == "Run" then MV.BobRun elseif mode == "Crouch" then MV.BobCrouch else MV.BobWalk
	local moving = math.clamp(speed / math.max(1, SPEED[mode]), 0, 1)
	bobPhase += dt * (speed * 0.75 + 0.01)
	local bobY = math.sin(bobPhase * 2) * amp * moving
	local bobX = math.cos(bobPhase) * amp * 0.5 * moving
	hum.CameraOffset = Vector3.new(bobX, bobY - crouchDrop, 0)

	-- 추격 긴장감: 가까운 괴물이 추격 상태면 시야각이 아주 조금 좁아졌다 넓어졌다 한다(위치는 알려 주지 않음)
	local chased = false
	for _, m in CollectionService:GetTagged(Config.Tags.Monster) do
		if m:IsA("Model") and m:GetAttribute("State") == "Chase" and m.PrimaryPart then
			if (m.PrimaryPart.Position - root.Position).Magnitude < 40 then
				chased = true
			end
		end
	end
	tension += ((if chased then 1 else 0) - tension) * math.min(1, dt * 2)
	if cam then
		cam.FieldOfView = 70 - tension * (2 + math.sin(os.clock() * 7) * 0.6)
	end
end

function Movement.reset()
	sentMode = ""
	crouchDrop = 0
	tension = 0
end

return Movement
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="53">
        <Properties>
          <string name="Name">RbxCharacterSounds</string>
          <string name="Source"><![CDATA[-- 기본 캐릭터 소리(RbxCharacterSounds)를 대체한다: 같은 이름의 빈 스크립트를 두면 Roblox 기본 발소리가 꺼진다.
-- 발소리는 Audio 모듈이 이동 모드(걷기/달리기/웅크리기)에 맞춰 직접 재생한다.
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">Reveal</string>
          <string name="Source"><![CDATA[--!strict
-- 음파에 맞은 괴물은 10초 동안(Config.Sonar.MonsterRevealSeconds) 지금 모습 그대로(움직이는 그대로) 보인다.
-- 잔상(그 순간 모습으로 굳은 음파 선)이 아니라 실제 몸을 켜 둔다. 이 클라이언트에서만, 팀원 음파도 포함. 다시 맞으면 10초가 다시 시작.
--  · 음파 반경 안, 벽 1장 이하면 맞은 것(괴물 소리 판정과 같은 기준)
--  · 메인 괴물·도플갱어 괴물: 몸의 선(원통)을 흰 네온으로
--  · 도플갱어 사람 모습: 진짜 아바타면 팀원처럼 윤곽선(Highlight), 상자 몸이면 상자 윤곽선(SelectionBox)
--  · 보이는 동안 음파는 그 괴물의 굳은 선(잔상)을 따로 그리지 않는다(SonarWorld.skipMonster)

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)

local Reveal = {}
local S = Config.Sonar
local TAGS = Config.Tags
local SECONDS = (S :: any).MonsterRevealSeconds or 10

type Entry = { from: number, to: number, parts: { BasePart }, boxes: { SelectionBox }, hl: Highlight?, ver: number, on: boolean }
local revealed: { [Model]: Entry } = {}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
local function wallsBetween(a: Vector3, b: Vector3): number
	local stage = workspace:FindFirstChild("Stage")
	if not stage then
		return 0
	end
	rayParams.FilterDescendantsInstances = { stage }
	local n = 0
	local from = a
	for _ = 1, 3 do
		local dir = b - from
		if dir.Magnitude < 0.5 then
			break
		end
		local hit = workspace:Raycast(from, dir, rayParams)
		if not hit then
			break
		end
		n += 1
		from = hit.Position + dir.Unit * 0.6
		if (b - from):Dot(b - a) <= 0 then
			break
		end
	end
	return n
end

function Reveal.onPulse(origin: Vector3)
	local now = os.clock()
	for _, inst in CollectionService:GetTagged(TAGS.Monster) do
		local m = inst :: Model
		if m:IsA("Model") and m.PrimaryPart then
			local p = m.PrimaryPart.Position
			local d = (p - origin).Magnitude
			if d <= S.Radius + 3 and wallsBetween(origin, p) <= 1 then
				local from = now + math.min(1, d / 60) -- 파동이 닿을 즈음부터
				local e = revealed[m]
				if e then
					e.from = math.min(e.from, from)
					e.to = math.max(e.to, from + SECONDS)
				else
					revealed[m] = { from = from, to = from + SECONDS, parts = {}, boxes = {}, hl = nil, ver = -1, on = false }
				end
			end
		end
	end
end

-- 음파가 이 괴물의 굳은 선(잔상)을 그리지 않아도 되는가(지금 보이는 중이거나 곧 보일 것)
-- 지금 음파에 걸려 있는가(파동이 닿은 뒤 ~ 10초): 이 동안만 그 괴물 발소리가 들린다
function Reveal.active(m: Model): boolean
	local e = revealed[m]
	if not e then
		return false
	end
	local now = os.clock()
	return now >= e.from and now <= e.to
end

function Reveal.has(m: Model): boolean
	return revealed[m] ~= nil
end

local LINE = Color3.new(S.LineColor.R * S.BaseLevel, S.LineColor.G * S.BaseLevel, S.LineColor.B * S.BaseLevel)

local function show(e: Entry, on: boolean)
	if e.on == on then
		return
	end
	e.on = on
	for _, p in e.parts do
		if p.Parent and p.Name ~= "Eye" then -- (도플갱어 눈은 DoppelFx 가 따로 빛나게 한다)
			if on then
				p.Material = Enum.Material.Neon
				p.Color = LINE
				p.Transparency = 0
			else
				p.Transparency = 1
			end
		end
	end
	for _, b in e.boxes do
		b.Visible = on
	end
	if e.hl then
		e.hl.Enabled = on
	end
end

local function release(e: Entry)
	show(e, false)
	for _, b in e.boxes do
		b:Destroy()
	end
	if e.hl then
		e.hl:Destroy()
	end
	table.clear(e.parts)
	table.clear(e.boxes)
	e.hl = nil
end

local function collect(m: Model, e: Entry)
	local wasOn = e.on
	release(e)
	local avatar = m:GetAttribute("Form") == "Disguise" and m:GetAttribute("AvatarOf") ~= nil
	if avatar then
		-- 진짜 아바타 모습: 몸을 보이게 하고 팀원과 같은 흰 윤곽선
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
				local top: Instance? = d
				while top and top.Parent ~= m do
					top = top.Parent
				end
				if top and top:GetAttribute("DisguisePart") then
					table.insert(e.parts, d)
				end
			end
		end
		local hl = Instance.new("Highlight")
		hl.Name = "RevealOutline"
		hl.Adornee = m
		hl.FillTransparency = 1
		hl.OutlineColor = Color3.new(1, 1, 1)
		hl.OutlineTransparency = 0.3
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Enabled = false
		hl.Parent = m
		e.hl = hl
	else
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") and CollectionService:HasTag(d, TAGS.Renderable) then
				if d.Shape == Enum.PartType.Cylinder then
					table.insert(e.parts, d)
				else
					local sb = Instance.new("SelectionBox")
					sb.Name = "RevealBox"
					sb.Adornee = d
					sb.Color3 = Color3.new(1, 1, 1)
					sb.LineThickness = 0.04
					sb.SurfaceTransparency = 1
					sb.Transparency = 1 - S.BaseLevel
					sb.Visible = false
					sb.Parent = d
					table.insert(e.boxes, sb)
				end
			end
		end
	end
	e.ver = (m:GetAttribute("BodyVersion") :: number?) or 0
	e.on = false
	if wasOn then
		show(e, true)
	end
end

-- (테스트) 지금 보이는 괴물 수
function Reveal.count(): number
	local n = 0
	for m, e in revealed do
		if e.on and m.Parent then
			n += 1
		end
	end
	return n
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.05 then
		return
	end
	acc = 0
	local now = os.clock()
	for m, e in revealed do
		if not m.Parent or now > e.to then
			release(e)
			revealed[m] = nil
			continue
		end
		local ver = (m:GetAttribute("BodyVersion") :: number?) or 0
		if ver ~= e.ver then
			collect(m, e) -- (도플갱어가 옷을 갈아입거나 변신하거나 입을 벌리면 다시 모은다)
		end
		if now >= e.from then
			show(e, true)
		end
	end
end)

function Reveal.clear()
	for m, e in revealed do
		release(e)
		revealed[m] = nil
	end
end

return Reveal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">SearchLook</string>
          <string name="Source"><![CDATA[--!strict
-- 상자·서랍 조작: 조준점(화면 가운데)으로 서랍이나 뚜껑을 보고 E → 열기/닫기(서버 Search 가 판정).
-- 서랍마다 따로 열고 닫을 수 있다. 안내 문구는 UI.setLookPrompt 로 보여 준다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local UI = require(script.Parent:WaitForChild("UI"))

local SearchLook = {}

local player = Players.LocalPlayer
local SearchAction = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SearchAction") :: RemoteEvent
local RANGE = 8

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

type Target = { spot: number, comp: number, model: Model, label: string }
local current: Target? = nil
local shown = false

local function find(): Target?
	if player:GetAttribute("Status") ~= "Alive" or player:GetAttribute("Hidden") then
		return nil
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	params.FilterDescendantsInstances = if player.Character then { player.Character } else {}
	local hit = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * RANGE, params)
	local inst: Instance? = hit and hit.Instance
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("Comp") then
			local spotModel = inst.Parent
			local label = (spotModel and spotModel:GetAttribute("Label") :: string?) or "상자"
			return { spot = inst:GetAttribute("SpotId") :: number, comp = inst:GetAttribute("Comp") :: number, model = inst, label = label }
		end
		inst = inst.Parent
	end
	return nil
end

function SearchLook.target(): { spot: number, comp: number }?
	local t = find()
	return if t then { spot = t.spot, comp = t.comp } else nil
end

-- 보고 있는 서랍/뚜껑을 연다/닫는다(E)
function SearchLook.use(): boolean
	local t = find()
	if not t then
		return false
	end
	SearchAction:FireServer(t.spot, t.comp)
	return true
end

UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.E and current then
		SearchLook.use()
	end
end)

local acc = 0
RunService.RenderStepped:Connect(function(dt)
	acc += dt
	if acc < 0.08 then
		return
	end
	acc = 0
	current = find()
	if current then
		local open = current.model:GetAttribute("Open") == true
		local what = if current.label == "서랍장" or current.label == "협탁" then "서랍" else current.label
		UI.setLookPrompt(if open then ("E   " .. what .. " 닫기") else ("E   " .. what .. " 열기"))
		shown = true
	elseif shown then
		UI.setLookPrompt(nil)
		shown = false
	end
end)

return SearchLook
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">SonarLines</string>
          <string name="Source"><![CDATA[--!strict
-- 윤곽선 파트 풀. 얇은 Neon 파트를 미리 만들어 두고 재사용한다(이펙트를 매번 새로 만들지 않음).
-- 선은 투명도 대신 색으로 사라진다: 흰색 → 검정. 화면이 전부 검정이라 검정 Neon 은 보이지 않고,
-- 불투명 파트라서 투명 파트보다 렌더링이 훨씬 가볍다(인스턴싱).
-- 같은 선분(키)이 다시 음파를 받으면 새로 만들지 않고 타이머만 갱신 → 반복 발사해도 쌓이지 않는다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local S = Config.Sonar
local Lines = {}

local HIDDEN = CFrame.new(0, -10000, 0)
local LR, LG, LB = S.LineColor.R, S.LineColor.G, S.LineColor.B
local QUANT = 16 -- 밝기 단계 수(색을 바꾸는 횟수를 줄인다: 검은 바탕에서는 16단계로도 부드럽다)

type Rec = {
	part: Part,
	t0: number,
	peak: number,
	key: number?,
	q: number,
	slot: number,
	wake: number?, -- 밝기가 일정한 구간에서는 이 시각까지 계산을 건너뛴다
}

local folder: Folder? = nil
local free: { Part } = {}
local created = 0
local active: { Rec } = {}
local byKey: { [number]: Rec } = {}
-- 켜진 순서(가장 오래된 것부터). 풀이 가득 찼을 때 가장 오래된 선을 O(1)로 찾는다
-- (예전에는 선 하나마다 켜진 선 전부를 훑어서, 빽빽한 곳에서 한 프레임이 1초 가까이 걸렸다)
local order: { { rec: Rec, t0: number } } = {}
local head = 1
local moveParts: { BasePart } = {}
local moveCFs: { CFrame } = {}
Lines.stolen = 0
Lines.shownTotal = 0

local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "SonarLines"
	f.Parent = workspace
	folder = f
	return f
end

local function newPart(): Part
	local p = Instance.new("Part")
	p.Name = "L"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.new(0, 0, 0)
	p.Size = Vector3.new(0.05, 0.05, 1)
	p.CFrame = HIDDEN
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = getFolder()
	created += 1
	return p
end

local function release(i: number)
	local rec = active[i]
	local last = active[#active]
	active[i] = last
	last.slot = i
	active[#active] = nil
	if rec.key then
		byKey[rec.key] = nil
	end
	-- (색은 그대로 두고 화면 밖으로만 옮긴다: 다시 쓸 때 첫 갱신에서 색을 정한다)
	table.insert(moveParts, rec.part)
	table.insert(moveCFs, HIDDEN)
	table.insert(free, rec.part)
end

Lines.dropped = 0
-- (테스트) 한 프레임에 한 일의 양: 색 바꾸기, 위치·크기 바꾸기 — 가장 많았던 프레임
local frameColor, framePlace = 0, 0
Lines.maxColor, Lines.maxPlace = 0, 0
local function take(now: number): Part?
	local p = table.remove(free)
	if p then
		return p
	end
	if created < S.PoolSize then
		return newPart()
	end
	-- 풀이 가득: 이미 사라지는 중인 가장 오래된 선만 가져온다(켜진 순서 큐의 앞, 그사이 다시 켜졌거나 꺼진 것은 건너뛴다).
	-- 아직 또렷한 선뿐이면 새(더 먼) 선을 그리지 않는다 — 가까운 선이 지워졌다 다시 그려지는 일(깜빡임·렉)을 막는다
	local fadeAt = S.Hold - S.FadeTime
	while head <= #order do
		local e = order[head]
		local r = e.rec
		if not (active[r.slot] == r and r.t0 == e.t0) then
			order[head] = nil :: any
			head += 1
		elseif now - r.t0 >= fadeAt then
			order[head] = nil :: any
			head += 1
			Lines.stolen += 1
			release(r.slot)
			return table.remove(free)
		else
			break
		end
	end
	Lines.dropped += 1
	return nil
end

local function place(part: Part, a: Vector3, b: Vector3, cam: Vector3)
	framePlace += 1
	local d = b - a
	local len = d.Magnitude
	local mid = (a + b) / 2
	local w = math.clamp(S.LineMinWidth + (mid - cam).Magnitude * S.LineWidthPerStud, S.LineMinWidth, S.LineMaxWidth)
	part.Size = Vector3.new(w, w, len + w * 0.6)
	local dir = d / len
	local up = if math.abs(dir.Y) > 0.98 then Vector3.xAxis else Vector3.yAxis
	table.insert(moveParts, part)
	table.insert(moveCFs, CFrame.lookAt(mid, mid + dir, up))
end

-- 선 하나를 보여 준다. key 가 같은 선이 이미 있으면 그 선을 갱신한다.
function Lines.show(a: Vector3, b: Vector3, now: number, peak: number, key: number?, cam: Vector3, replace: boolean?)
	if (b - a).Magnitude < 0.03 then
		return
	end
	Lines.shownTotal += 1
	if key then
		local rec = byKey[key]
		if rec then
			rec.t0 = now
			table.insert(order, { rec = rec, t0 = now })
			rec.peak = math.max(peak, rec.peak * 0.5)
			rec.q = -1
			rec.wake = nil
			if replace then
				place(rec.part, a, b, cam)
			end
			return
		end
	end
	local part = take(now)
	if not part then
		return
	end
	place(part, a, b, cam)
	local rec: Rec = { part = part, t0 = now, peak = peak, key = key, q = -1, slot = #active + 1 }
	active[rec.slot] = rec
	table.insert(order, { rec = rec, t0 = now })
	-- 큐 앞쪽 빈자리 정리
	if head > 4096 then
		local n = #order - head + 1
		table.move(order, head, #order, 1)
		for i = n + 1, #order do
			order[i] = nil :: any
		end
		head = 1
	end
	if key then
		byKey[key] = rec
	end
end

-- 밝기 곡선: 도달 순간 플래시 → 유지 → 서서히 사라짐
local function level(age: number): number
	if age < 0 then
		return 0
	end
	if age < S.FlashTime then
		return 1 - (1 - S.BaseLevel) * (age / S.FlashTime)
	end
	local fadeStart = S.Hold - S.FadeTime
	if age < fadeStart then
		return S.BaseLevel
	end
	local t = math.clamp((age - fadeStart) / S.FadeTime, 0, 1)
	return S.BaseLevel * (1 - t) * (1 - t * 0.35)
end

function Lines.update(now: number)
	local i = 1
	while i <= #active do
		local rec = active[i]
		local age = now - rec.t0
		if age >= S.Hold then
			release(i)
		elseif rec.wake and now < rec.wake then
			i += 1
		else
			-- 플래시가 끝난 뒤 사라지기 시작할 때까지는 밝기가 같다: 그동안은 계산하지 않는다
			local fadeStart = S.Hold - S.FadeTime
			-- 다음에 밝기가 바뀔 때까지 쉰다(매 프레임 색을 바꾸지 않게):
			--   플래시 동안: 플래시가 끝날 때(밝게 → 보통, 두 번만 바뀜)
			--   유지 동안: 사라지기 시작할 때
			--   사라지는 동안: 다음 단계쯤 — 같은 프레임에 켜진 선들이 한꺼번에 바뀌지 않게 조금씩 어긋나게
			local step = S.FadeTime / QUANT
			rec.wake = if age < S.FlashTime then rec.t0 + S.FlashTime elseif age < fadeStart then rec.t0 + fadeStart else now + step * (0.6 + math.random() * 0.8)
			local l = level(age) * rec.peak
			local q = math.floor(l * QUANT + 0.5)
			if q ~= rec.q then
				rec.q = q
				local v = q / QUANT
				rec.part.Color = Color3.new(LR * v, LG * v, LB * v)
				frameColor += 1
			end
			i += 1
		end
	end
	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveCFs, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(moveParts)
		table.clear(moveCFs)
	end
	Lines.maxColor = math.max(Lines.maxColor, frameColor)
	Lines.maxPlace = math.max(Lines.maxPlace, framePlace)
	frameColor, framePlace = 0, 0
end

-- 테스트: p 에서 r 안에 켜져 있는 선 수
function Lines.countNear(p: Vector3, r: number): number
	local n = 0
	for _, rec in active do
		if rec.q > 0 and (rec.part.Position - p).Magnitude < r then
			n += 1
		end
	end
	return n
end

-- 선 파트를 미리 만들어 둔다(음파 도중에 새로 만들면 그 프레임이 끊긴다). 스테이지를 불러올 때 조금씩 만든다
function Lines.prewarm(n: number)
	local want = math.min(n, S.PoolSize)
	while created < want do
		for _ = 1, 150 do
			if created >= want then
				break
			end
			table.insert(free, newPart())
		end
		task.wait()
	end
end

function Lines.clear()
	while #active > 0 do
		release(#active)
	end
	table.clear(order)
	head = 1
	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveCFs, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(moveParts)
		table.clear(moveCFs)
	end
end

function Lines.stats()
	local lit = 0
	for _, r in active do
		if r.q > 0 then
			lit += 1
		end
	end
	return { active = #active, lit = lit, created = created, free = #free, stolen = Lines.stolen, dropped = Lines.dropped, shown = Lines.shownTotal, maxColor = Lines.maxColor, maxPlace = Lines.maxPlace }
end

-- 테스트용: 현재 켜진 선의 가운데 점들
function Lines.litMidpoints(): { Vector3 }
	local out = {}
	for _, r in active do
		if r.q > 0 then
			table.insert(out, r.part.Position)
		end
	end
	return out
end

return Lines
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">SonarPulses</string>
          <string name="Source"><![CDATA[--!strict
-- 음파 전파: 발사 지점에서 복셀 격자를 따라 Dijkstra 로 퍼진다(벽은 통과 못 하고, 열린 통로·문으로만 돌아 들어간다).
-- 파면 반경 = 경과 시간 × WaveSpeed. 파면이 지나간 복셀에 연결된 선분이 그 순간 나타난다 → 가까운 곳부터 먼 곳으로.
-- 연산은 여러 프레임에 나눠 한다(프레임당 ExpandBudget).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Geo = require(ReplicatedStorage.Shared.SonarGeometry)
local World = require(script.Parent:WaitForChild("SonarWorld"))
local Lines = require(script.Parent:WaitForChild("SonarLines"))

local S = Config.Sonar
local Pulses = {}

type Pulse = {
	id: number,
	origin: Vector3,
	t0: number,
	dist: { [number]: number },
	hk: { number },
	hv: { number },
	hn: number,
	seen: { [number]: boolean },
	buckets: { [number]: { number } },
	nextBucket: number,
	bucketPos: number, -- 지금 버킷에서 다음에 보여 줄 위치(한 프레임 상한에 걸려 버킷 중간에서 멈췄을 때)
	dynA: { Vector3 },
	dynB: { Vector3 },
	dynM: { Vector3 },
	dynKey: { number | false },
	dynCell: { [number]: { number } },
	dseen: { [number]: boolean },
	cam: Vector3,
	revealed: number,
	trace: { { number } }?,
	own: boolean,
}

local pulses: { Pulse } = {}
local nextId = 0
Pulses.last = nil :: Pulse?
Pulses.started = 0
Pulses.camera = function(): Vector3
	local cam = workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

-- 18방향(면 6 + 모서리 12). 모서리 방향은 두 성분 칸이 모두 비어야 지나갈 수 있다(벽 모서리 새는 것 방지).
type Nb = { dx: number, dy: number, dz: number, w: number, a: { number }?, b: { number }? }
local NB: { Nb } = {}
do
	for dz = -1, 1 do
		for dy = -1, 1 do
			for dx = -1, 1 do
				local n = math.abs(dx) + math.abs(dy) + math.abs(dz)
				if n == 1 then
					table.insert(NB, { dx = dx, dy = dy, dz = dz, w = 1 })
				elseif n == 2 then
					local comps = {}
					if dx ~= 0 then
						table.insert(comps, { dx, 0, 0 })
					end
					if dy ~= 0 then
						table.insert(comps, { 0, dy, 0 })
					end
					if dz ~= 0 then
						table.insert(comps, { 0, 0, dz })
					end
					table.insert(NB, { dx = dx, dy = dy, dz = dz, w = math.sqrt(2), a = comps[1], b = comps[2] })
				end
			end
		end
	end
end

-- ── 최소 힙 ──
local function push(p: Pulse, key: number, val: number)
	local n = p.hn + 1
	p.hn = n
	local hk, hv = p.hk, p.hv
	local i = n
	while i > 1 do
		local parent = i // 2
		if hk[parent] <= key then
			break
		end
		hk[i] = hk[parent]
		hv[i] = hv[parent]
		i = parent
	end
	hk[i] = key
	hv[i] = val
end

local function pop(p: Pulse): (number, number)
	local hk, hv = p.hk, p.hv
	local topK, topV = hk[1], hv[1]
	local n = p.hn
	local lastK, lastV = hk[n], hv[n]
	hk[n] = nil
	hv[n] = nil
	n -= 1
	p.hn = n
	if n > 0 then
		local i = 1
		while true do
			local l = i * 2
			if l > n then
				break
			end
			local r = l + 1
			local c = l
			if r <= n and hk[r] < hk[l] then
				c = r
			end
			if hk[c] >= lastK then
				break
			end
			hk[i] = hk[c]
			hv[i] = hv[c]
			i = c
		end
		hk[i] = lastK
		hv[i] = lastV
	end
	return topK, topV
end

local function bucketAdd(p: Pulse, arrival: number, id: number)
	-- (이미 지나간 구간이면 다음에 보여 줄 구간에 넣는다: 늦게 확정된 칸의 선분이 빠지지 않게)
	local b = math.max(math.floor(arrival), p.nextBucket)
	local l = p.buckets[b]
	if not l then
		l = {}
		p.buckets[b] = l
	end
	table.insert(l, id)
end

-- 움직이는 파트마다 고정 번호(같은 선을 다음 음파 때 새로 만들지 않고 옮겨 쓴다 → 겹쳐서 두 줄·더 밝게 보이지 않는다)
local dynIds: { [BasePart]: number } = setmetatable({}, { __mode = "k" }) :: any
local nextDynId = 0
local function dynId(part: BasePart): number
	local id = dynIds[part]
	if not id then
		nextDynId += 1
		id = nextDynId
		dynIds[part] = id
	end
	return id
end

-- 움직이는 대상과 원통·구 실루엣을 이번 음파용 선분으로 만든다
local function gatherDynamic(p: Pulse, exclude: Model?)
	local list = Geo.newList()
	local R = S.Radius
	-- 정적 원통·구의 실루엣(키를 붙여 다음 음파 때 같은 선을 옮겨 쓴다)
	for _, part in World.viewPartsNear(p.origin, R) do
		local before = list.n
		Geo.viewEdges(part, p.cam, list)
		local vid = dynId(part)
		for i = before + 1, list.n do
			p.dynKey[i] = -(1e8 + vid * 64 + (i - before))
		end
	end
	-- 문, 괴물, 다른 플레이어(그 순간의 모습)
	for _, e in World.dynamicParts(p.origin, R, exclude) do
		local part = e.part
		local before = list.n
		if e.char then
			local nm = part.Name
			if nm == "Head" then
				Geo.ballSilhouette(part.CFrame, part.Size * 0.85, p.cam, list)
			elseif nm:find("Arm") or nm:find("Leg") or nm:find("Hand") or nm:find("Foot") then
				local s = part.Size
				local axis = if s.Y >= s.X and s.Y >= s.Z then "Y" elseif s.X >= s.Z then "X" else "Z"
				Geo.boxEdges(part.CFrame, s, list, axis, true)
			else
				Geo.boxEdges(part.CFrame, part.Size, list, nil, true)
			end
		else
			Geo.staticEdges(part, list, true)
			Geo.viewEdges(part, p.cam, list)
		end
		local pid = dynId(part)
		for i = before + 1, list.n do
			p.dynKey[i] = -(2e8 + pid * 256 + (i - before))
		end
	end
	-- 분할 + 복셀 연결
	local segLen = S.SegmentLength
	local n = 0
	for i = 1, list.n do
		local a, b = list.A[i], list.B[i]
		local d = b - a
		local len = d.Magnitude
		if len > 0.02 then
			local k = math.max(1, math.ceil(len / segLen))
			local key = p.dynKey[i]
			for s = 0, k - 1 do
				local pa = a + d * (s / k)
				local pb = a + d * ((s + 1) / k)
				n += 1
				p.dynA[n] = pa
				p.dynB[n] = pb
				local m = (pa + pb) / 2
				p.dynM[n] = m
				p.dynKey[-n] = if key then (key :: number) * 32 - s else false
				for _, idx in World.attachCells(m) do
					local l = p.dynCell[idx]
					if not l then
						l = {}
						p.dynCell[idx] = l
					end
					table.insert(l, n)
				end
			end
		end
	end
end

function Pulses.start(origin: Vector3, exclude: Model?, traced: boolean?): boolean
	if not World.ready then
		return false
	end
	if Pulses.onStart then
		Pulses.onStart(origin)
	end
	local x, y, z = World.cellOf(origin)
	if not x then
		return false
	end
	-- 시작 복셀(막혀 있으면 가까운 빈 칸)
	local start, startD = nil, math.huge
	for dz = -1, 1 do
		for dy = -1, 1 do
			for dx = -1, 1 do
				local xx, yy, zz = (x :: number) + dx, (y :: number) + dy, (z :: number) + dz
				if xx >= 0 and yy >= 0 and zz >= 0 and xx < World.nx and yy < World.ny and zz < World.nz then
					local idx = World.index(xx, yy, zz)
					if World.free(idx) then
						local d = (World.cellCenter(idx) - origin).Magnitude
						if d < startD then
							start, startD = idx, d
						end
					end
				end
			end
		end
	end
	if not start then
		return false
	end
	nextId += 1
	local p: Pulse = {
		id = nextId,
		origin = origin,
		t0 = os.clock(),
		dist = {},
		hk = {},
		hv = {},
		hn = 0,
		seen = {},
		buckets = {},
		nextBucket = 0,
		bucketPos = 1,
		dynA = {},
		dynB = {},
		dynM = {},
		dynKey = {},
		dynCell = {},
		dseen = {},
		cam = Pulses.camera(),
		revealed = 0,
		trace = if traced then {} else nil,
		own = traced == true,
	}
	gatherDynamic(p, exclude)
	p.dist[start] = startD
	push(p, startD, start)
	table.insert(pulses, p)
	Pulses.last = p
	Pulses.started += 1
	return true
end

local function settle(p: Pulse, c: number, d: number)
	local center = World.cellCenter(c)
	local R = S.Radius
	local segs = World.cellSegs[c]
	if segs then
		local SM = World.SM
		local seen = p.seen
		for _, s in segs do
			if not seen[s] then
				seen[s] = true
				local arr = d + (SM[s] - center).Magnitude
				if arr <= R then
					bucketAdd(p, arr, s)
				end
			end
		end
	end
	local dyn = p.dynCell[c]
	if dyn then
		local dseen = p.dseen
		for _, s in dyn do
			if not dseen[s] then
				dseen[s] = true
				local arr = d + (p.dynM[s] - center).Magnitude
				if arr <= R then
					bucketAdd(p, arr, -s)
				end
			end
		end
	end
end

-- 파면을 limitD 까지 확장. 남은 예산을 돌려준다
local function expand(p: Pulse, limitD: number, budget: number): number
	local nx, ny, nz = World.nx, World.ny, World.nz
	local occ = World.occ
	local cs = World.cs
	local R = S.Radius
	local dist = p.dist
	while p.hn > 0 and budget > 0 do
		if p.hk[1] > limitD then
			break
		end
		local d, c = pop(p)
		if d <= (dist[c] or math.huge) + 1e-6 then
			budget -= 1
			settle(p, c, d)
			local c0 = c - 1
			local x = c0 % nx
			local t = c0 // nx
			local y = t % ny
			local z = t // ny
			for _, nb in NB do
				local xx, yy, zz = x + nb.dx, y + nb.dy, z + nb.dz
				if xx >= 0 and yy >= 0 and zz >= 0 and xx < nx and yy < ny and zz < nz then
					local ni = xx + nx * (yy + ny * zz)
					if buffer.readu8(occ, ni) == 0 then
						local ok = true
						local a, b = nb.a, nb.b
						if a and b then
							local ia = (x + a[1]) + nx * ((y + a[2]) + ny * (z + a[3]))
							local ib = (x + b[1]) + nx * ((y + b[2]) + ny * (z + b[3]))
							ok = buffer.readu8(occ, ia) == 0 and buffer.readu8(occ, ib) == 0
						end
						if ok then
							local nd = d + nb.w * cs
							if nd <= R and nd < (dist[ni + 1] or math.huge) then
								dist[ni + 1] = nd
								push(p, nd, ni + 1)
							end
						end
					end
				end
			end
		end
	end
	return budget
end

local function reveal(p: Pulse, id: number, arrival: number, now: number)
	local peak = 1 - (1 - S.FarLevel) * math.clamp(arrival / S.Radius, 0, 1)
	if id > 0 then
		Lines.show(World.SA[id], World.SB[id], now, peak, id, p.cam, false)
	else
		local s = -id
		local key = p.dynKey[-s]
		Lines.show(p.dynA[s], p.dynB[s], now, peak, if key then (key :: number) - 1e7 else nil, p.cam, true)
	end
	p.revealed += 1
	if p.trace and #p.trace < 6000 then
		table.insert(p.trace, { now - p.t0, arrival, if id > 0 then id else 0 })
	end
end

function Pulses.update(now: number)
	if #pulses == 0 then
		return
	end
	local budget = S.ExpandBudget
	local R = S.Radius
	local showLeft = S.RevealPerFrame -- 이 프레임에 새로 보여 줄 선 수(모든 음파 합계)
	local i = 1
	while i <= #pulses do
		local p = pulses[i]
		local front = (now - p.t0) * S.WaveSpeed
		local per = math.max(400, budget // (#pulses - i + 1))
		local left = expand(p, math.min(front + 3, R + 3), per)
		budget -= (per - left)
		-- 확정된 거리(힙의 최소값)까지, 그리고 파면까지만 보여 준다
		local settled = if p.hn > 0 then p.hk[1] else math.huge
		local limit = math.min(front, settled)
		-- 한 프레임에 새로 보여 줄 선 수를 제한한다(모든 음파 합계, 버킷 중간에서도 멈춘다 — 빽빽한 곳에서 한 프레임이 길어지지 않게)
		while p.nextBucket <= limit and p.nextBucket <= R + 1 and showLeft > 0 do
			local l = p.buckets[p.nextBucket]
			if l then
				local k = p.bucketPos
				while k <= #l and showLeft > 0 do
					reveal(p, l[k], p.nextBucket, now)
					k += 1
					showLeft -= 1
				end
				if k <= #l then
					p.bucketPos = k
					break
				end
				p.buckets[p.nextBucket] = nil
			end
			p.bucketPos = 1
			p.nextBucket += 1
		end
		if p.nextBucket > R + 1 and (p.hn == 0 or p.hk[1] > R) then
			table.remove(pulses, i)
			-- 음파가 닿은 곳(내 것과 팀원 것 모두 지도에 남긴다 — 시야 공유)
			if Pulses.onReach then
				Pulses.onReach(p.dist, R)
			end
		else
			i += 1
		end
	end
end

-- 음파(내 것·팀원 것)가 끝났을 때 (복셀 → 거리, 반경)을 받는다(MapView)
Pulses.onStart = nil :: ((origin: Vector3) -> ())? -- 음파가 시작될 때(내 것·팀원 것): 도플갱어 눈 빛
Pulses.onReach = nil :: ((dist: { [number]: number }, radius: number) -> ())?

function Pulses.active(): number
	return #pulses
end

function Pulses.clear()
	table.clear(pulses)
end

return Pulses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">SonarWorld</string>
          <string name="Source"><![CDATA[--!strict
-- 음파 렌더링용 월드 데이터(클라이언트). 스테이지가 로드되면 한 번만 만든다(매 프레임 다시 스캔하지 않음).
--   1) 윤곽선 선분: SonarRenderable 태그 파트의 모서리 → 같은 평면 이음매·묻힌 모서리 제거 → 짧게 분할
--   2) 전파 격자: 소리를 막는 구조물을 복셀(CellSize)로 칠한 점유 격자. 닫힌 문은 열고 닫을 때 갱신.
--   3) 선분 ↔ 복셀 연결: 각 선분은 가까운 빈 복셀을 통해 음파를 받는다(벽 너머 복셀은 거리 제한으로 제외).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Geo = require(ReplicatedStorage.Shared.SonarGeometry)

local S = Config.Sonar
local TAGS = Config.Tags

local World = {}
World.ready = false
World.buildId = 0
World.stage = nil :: Folder?

-- 정적 선분
World.SA = {} :: { Vector3 }
World.SB = {} :: { Vector3 }
World.SM = {} :: { Vector3 }
World.segCount = 0
World.buildSeconds = 0
World.buildCpu = 0
World.culled = 0
World.unattached = 0
World.cellSegs = {} :: { [number]: { number } }
-- 보는 위치에 따라 선이 바뀌는 정적 파트(원통·구) — 16스터드 버킷
World.viewParts = {} :: { BasePart }
local viewBuckets: { [number]: { number } } = {}
-- 격자
World.cs = S.CellSize
World.origin = Vector3.zero
World.nx, World.ny, World.nz = 0, 0, 0
World.occ = buffer.create(1)
World.doors = {} :: { { model: Model, cells: { number }, blocked: boolean, conn: RBXScriptConnection? } }

local VB = 16
local function vkey(x: number, y: number, z: number): number
	return (x + 512) + (y + 64) * 1024 + (z + 512) * 1024 * 128
end

-- ── 판정 도우미 ──
local function isDynamic(inst: Instance, stage: Instance?): boolean
	local cur: Instance? = inst
	while cur and cur ~= stage and cur ~= workspace do
		if cur:GetAttribute(TAGS.Dynamic) == true then
			return true
		end
		cur = cur.Parent
	end
	return false
end

-- 태그가 붙은 인스턴스(파트 또는 모델)의 파트들
local function taggedParts(tag: string, within: Instance): { BasePart }
	local out = {}
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsDescendantOf(within) then
			if inst:IsA("BasePart") then
				table.insert(out, inst)
			else
				for _, d in inst:GetDescendants() do
					if d:IsA("BasePart") then
						table.insert(out, d)
					end
				end
			end
		end
	end
	return out
end

local function blocksSound(p: BasePart): boolean
	local b = p:GetAttribute("SonarBlocks")
	if type(b) == "boolean" then
		return b
	end
	if not p.CanCollide or p.Transparency >= 1 then
		return false
	end
	local s = p.Size
	local dims = { s.X, s.Y, s.Z }
	table.sort(dims)
	return dims[1] >= 0.9 and dims[2] >= 0.9
end

-- ── 격자 ──
function World.index(x: number, y: number, z: number): number
	return x + World.nx * (y + World.ny * z) + 1
end

function World.coords(idx: number): (number, number, number)
	local c = idx - 1
	local nx, ny = World.nx, World.ny
	local x = c % nx
	local t = c // nx
	return x, t % ny, t // ny
end

function World.cellCenter(idx: number): Vector3
	local x, y, z = World.coords(idx)
	local cs = World.cs
	return World.origin + Vector3.new((x + 0.5) * cs, (y + 0.5) * cs, (z + 0.5) * cs)
end

function World.cellOf(p: Vector3): (number?, number?, number?)
	local r = (p - World.origin) / World.cs
	local x, y, z = math.floor(r.X), math.floor(r.Y), math.floor(r.Z)
	if x < 0 or y < 0 or z < 0 or x >= World.nx or y >= World.ny or z >= World.nz then
		return nil, nil, nil
	end
	return x, y, z
end

function World.free(idx: number): boolean
	return buffer.readu8(World.occ, idx - 1) == 0
end

local function addOcc(idx: number, delta: number)
	local v = buffer.readu8(World.occ, idx - 1) + delta
	buffer.writeu8(World.occ, idx - 1, math.clamp(v, 0, 255))
end

-- 파트가 겹치는 복셀 목록(분리축: 파트 축 기준, 보수적)
local function rasterCells(cf: CFrame, size: Vector3): { number }
	local out = {}
	local cs = World.cs
	local h = cs / 2
	local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
	local ex = h * (math.abs(X.X) + math.abs(X.Y) + math.abs(X.Z))
	local ey = h * (math.abs(Y.X) + math.abs(Y.Y) + math.abs(Y.Z))
	local ez = h * (math.abs(Z.X) + math.abs(Z.Y) + math.abs(Z.Z))
	local hx, hy, hz = size.X / 2 + ex - 0.01, size.Y / 2 + ey - 0.01, size.Z / 2 + ez - 0.01
	-- 월드 AABB
	local ax = math.abs(X.X) * size.X / 2 + math.abs(Y.X) * size.Y / 2 + math.abs(Z.X) * size.Z / 2
	local ay = math.abs(X.Y) * size.X / 2 + math.abs(Y.Y) * size.Y / 2 + math.abs(Z.Y) * size.Z / 2
	local az = math.abs(X.Z) * size.X / 2 + math.abs(Y.Z) * size.Y / 2 + math.abs(Z.Z) * size.Z / 2
	local p = cf.Position
	local o = World.origin
	local x0 = math.max(0, math.floor((p.X - ax - o.X) / cs))
	local x1 = math.min(World.nx - 1, math.floor((p.X + ax - o.X) / cs))
	local y0 = math.max(0, math.floor((p.Y - ay - o.Y) / cs))
	local y1 = math.min(World.ny - 1, math.floor((p.Y + ay - o.Y) / cs))
	local z0 = math.max(0, math.floor((p.Z - az - o.Z) / cs))
	local z1 = math.min(World.nz - 1, math.floor((p.Z + az - o.Z) / cs))
	local Xx, Xy, Xz, Yx, Yy, Yz, Zx, Zy, Zz = X.X, X.Y, X.Z, Y.X, Y.Y, Y.Z, Z.X, Z.Y, Z.Z
	local px, py, pz, ox, oy, oz = p.X, p.Y, p.Z, o.X, o.Y, o.Z
	local nx, ny = World.nx, World.ny
	for z = z0, z1 do
		local dz = oz + (z + 0.5) * cs - pz
		for y = y0, y1 do
			local dy = oy + (y + 0.5) * cs - py
			for x = x0, x1 do
				local dx = ox + (x + 0.5) * cs - px
				if math.abs(dx * Xx + dy * Xy + dz * Xz) < hx and math.abs(dx * Yx + dy * Yy + dz * Yz) < hy and math.abs(dx * Zx + dy * Zy + dz * Zz) < hz then
					table.insert(out, x + nx * (y + ny * z) + 1)
				end
			end
		end
	end
	return out
end

-- mid 근처에서 음파를 받을 수 있는 빈 복셀들
function World.attachCells(mid: Vector3): { number }
	local out = {}
	-- (매우 자주 불린다: Vector3 를 만들지 않고 숫자로만 계산)
	local o, cs = World.origin, World.cs
	local ox, oy, oz = o.X, o.Y, o.Z
	local mx, my, mz = mid.X, mid.Y, mid.Z
	local nx, ny, nz = World.nx, World.ny, World.nz
	local x, y, z = math.floor((mx - ox) / cs), math.floor((my - oy) / cs), math.floor((mz - oz) / cs)
	if x < 0 or y < 0 or z < 0 or x >= nx or y >= ny or z >= nz then
		return out
	end
	local occ = World.occ
	local lim = S.AttachDistance * S.AttachDistance
	for zz = math.max(0, z - 1), math.min(nz - 1, z + 1) do
		local cz = oz + (zz + 0.5) * cs - mz
		for yy = math.max(0, y - 1), math.min(ny - 1, y + 1) do
			local cy = oy + (yy + 0.5) * cs - my
			local base = nx * (yy + ny * zz)
			for xx = math.max(0, x - 1), math.min(nx - 1, x + 1) do
				local cx = ox + (xx + 0.5) * cs - mx
				if cx * cx + cy * cy + cz * cz <= lim and buffer.readu8(occ, xx + base) == 0 then
					table.insert(out, xx + base + 1)
				end
			end
		end
	end
	return out
end

-- ── 문(닫히면 막고 열리면 통과) ──
local function refreshDoor(d)
	local open = d.model:GetAttribute("Open") == true
	local want = not open
	if want ~= d.blocked then
		for _, idx in d.cells do
			addOcc(idx, if want then 1 else -1)
		end
		d.blocked = want
	end
end

-- ── 보는 위치 의존 파트 조회 ──
function World.viewPartsNear(p: Vector3, radius: number): { BasePart }
	local out = {}
	local r = math.ceil(radius / VB)
	local cx, cy, cz = math.floor(p.X / VB), math.floor(p.Y / VB), math.floor(p.Z / VB)
	local seen = {}
	for dz = -r, r do
		for dy = -2, 2 do
			for dx = -r, r do
				local list = viewBuckets[vkey(cx + dx, cy + dy, cz + dz)]
				if list then
					for _, i in list do
						if not seen[i] then
							seen[i] = true
							local part = World.viewParts[i]
							if (part.Position - p).Magnitude <= radius + part.Size.Magnitude / 2 then
								table.insert(out, part)
							end
						end
					end
				end
			end
		end
	end
	return out
end

-- 움직이는 대상(문, 괴물, 다른 플레이어 캐릭터)
-- 움직이는 파트: 스테이지 안(문·서랍·뚜껑)은 빌드할 때 모아 두고, 괴물은 모델마다 한 번만 모은다
-- (예전처럼 음파마다 태그된 파트 전부를 훑으면 큰 맵에서 한 번에 수십~수백 ms 가 걸린다)
World.stageDynamics = {} :: { BasePart }
-- (도플갱어는 몸이 바뀐다: 사람 → 괴물, 틈 ↔ 벌어진 입. 바뀔 때마다 BodyVersion 이 올라가면 다시 모은다)
local monsterParts: { [Model]: { BasePart } } = setmetatable({}, { __mode = "k" }) :: any
local monsterVer: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any
local function partsOfMonster(m: Model): { BasePart }
	local l = monsterParts[m]
	local ver = (m:GetAttribute("BodyVersion") :: number?) or 0
	if not l or monsterVer[m] ~= ver then
		l = {}
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") and CollectionService:HasTag(d, TAGS.Renderable) then
				table.insert(l, d)
			end
		end
		monsterParts[m] = l
		monsterVer[m] = ver
	end
	return l
end

-- 굳은 선을 그리지 않을 괴물(Main 이 Reveal.has 로 채운다)
World.skipMonster = function(_m: Model): boolean
	return false
end

function World.dynamicParts(near: Vector3, radius: number, exclude: Model?): { { part: BasePart, char: boolean } }
	local out = {}
	local function consider(p: BasePart, isChar: boolean)
		if (p.Position - near).Magnitude <= radius + 4 then
			table.insert(out, { part = p, char = isChar })
		end
	end
	for _, p in World.stageDynamics do
		if p.Parent then
			consider(p, false)
		end
	end
	for _, m in CollectionService:GetTagged(TAGS.Monster) do
		-- (음파에 맞아 지금 모습 그대로 보이는 괴물은 굳은 선(잔상)을 따로 그리지 않는다)
		if m:IsA("Model") and World.skipMonster(m :: Model) then
			continue
		end
		if m:IsA("Model") and m.Parent and m ~= exclude and m.PrimaryPart and (m.PrimaryPart.Position - near).Magnitude <= radius + 12 then
			for _, p in partsOfMonster(m) do
				consider(p, false)
			end
		end
	end
	-- (다른 플레이어는 Mates 의 윤곽선으로 늘 보이므로 음파 선은 만들지 않는다)
	return out
end

-- ── 빌드(양보하며 진행) ──
function World.build(stage: Folder)
	World.ready = false
	World.stage = stage
	local t0 = os.clock()
	local wall0 = t0
	local cpu = 0
	local function yieldSometimes()
		if os.clock() - t0 > 0.012 then
			cpu += os.clock() - t0
			task.wait()
			t0 = os.clock()
		end
	end
	for _, d in World.doors do
		if d.conn then
			d.conn:Disconnect()
		end
	end
	World.doors = {}
	World.SA, World.SB, World.SM = {}, {}, {}
	World.segCount = 0
	World.culled = 0
	World.unattached = 0
	World.cellSegs = {}
	World.viewParts = {}
	viewBuckets = {}

	-- 정적 파트
	local statics: { BasePart } = {}
	World.stageDynamics = {}
	for _, p in taggedParts(TAGS.Renderable, stage) do
		if not isDynamic(p, stage) then
			table.insert(statics, p)
		else
			table.insert(World.stageDynamics, p)
		end
	end

	-- 격자 범위
	local bmin = stage:GetAttribute("BoundsMin") :: Vector3?
	local bmax = stage:GetAttribute("BoundsMax") :: Vector3?
	if not bmin or not bmax then
		local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
		for _, p in statics do
			lo = lo:Min(p.Position - p.Size)
			hi = hi:Max(p.Position + p.Size)
		end
		bmin, bmax = lo, hi
	end
	local cs = World.cs
	local lo = ((bmin :: Vector3) - Vector3.one * 4) / cs
	local hi = ((bmax :: Vector3) + Vector3.one * 4) / cs
	World.origin = Vector3.new(math.floor(lo.X), math.floor(lo.Y), math.floor(lo.Z)) * cs
	World.nx = math.ceil(hi.X) - math.floor(lo.X)
	World.ny = math.ceil(hi.Y) - math.floor(lo.Y)
	World.nz = math.ceil(hi.Z) - math.floor(lo.Z)
	World.occ = buffer.create(World.nx * World.ny * World.nz)

	-- 공간 해시(점 포함 판정용, 8스터드 버킷)
	local HB = 8
	-- 파트마다 위치·축·크기·모양을 숫자로 한 번만 읽어 둔다(속성 읽기는 느리다)
	type Info = { px: number, py: number, pz: number, xx: number, xy: number, xz: number, yx: number, yy: number, yz: number, zx: number, zy: number, zz: number, hx: number, hy: number, hz: number, shape: string }
	local hbuckets: { [number]: { Info } } = {}
	for _, p in statics do
		local cf, sz = p.CFrame, p.Size / 2
		local info: Info = {
			px = cf.Position.X, py = cf.Position.Y, pz = cf.Position.Z,
			xx = cf.XVector.X, xy = cf.XVector.Y, xz = cf.XVector.Z,
			yx = cf.YVector.X, yy = cf.YVector.Y, yz = cf.YVector.Z,
			zx = cf.ZVector.X, zy = cf.ZVector.Y, zz = cf.ZVector.Z,
			hx = sz.X, hy = sz.Y, hz = sz.Z,
			shape = Geo.shapeOf(p),
		}
		local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
		local half = Vector3.new(
			math.abs(X.X) * sz.X + math.abs(Y.X) * sz.Y + math.abs(Z.X) * sz.Z,
			math.abs(X.Y) * sz.X + math.abs(Y.Y) * sz.Y + math.abs(Z.Y) * sz.Z,
			math.abs(X.Z) * sz.X + math.abs(Y.Z) * sz.Y + math.abs(Z.Z) * sz.Z
		) + Vector3.one * 0.2
		local a = (p.Position - half) / HB
		local b = (p.Position + half) / HB
		for z = math.floor(a.Z), math.floor(b.Z) do
			for y = math.floor(a.Y), math.floor(b.Y) do
				for x = math.floor(a.X), math.floor(b.X) do
					local k = vkey(x, y, z)
					local l = hbuckets[k]
					if not l then
						l = {}
						hbuckets[k] = l
					end
					table.insert(l, info)
				end
			end
		end
		yieldSometimes()
	end
	-- 점이 어떤 정적 파트 안에 있는가(Geo.pointInside 와 같은 판정, 숫자만 사용)
	local function inside(pt: Vector3): boolean
		local x, y, z = pt.X, pt.Y, pt.Z
		local l = hbuckets[vkey(math.floor(x / HB), math.floor(y / HB), math.floor(z / HB))]
		if not l then
			return false
		end
		for _, i in l do
			local dx, dy, dz = x - i.px, y - i.py, z - i.pz
			local lx = dx * i.xx + dy * i.xy + dz * i.xz
			local ly = dx * i.yx + dy * i.yy + dz * i.yz
			local lz = dx * i.zx + dy * i.zy + dz * i.zz
			local sh = i.shape
			if sh == "Cylinder" then
				local r = math.min(i.hy, i.hz)
				if math.abs(lx) <= i.hx and ly * ly + lz * lz <= r * r then
					return true
				end
			elseif sh == "Ball" then
				local r = math.min(i.hx, i.hy, i.hz)
				if lx * lx + ly * ly + lz * lz <= r * r then
					return true
				end
			elseif math.abs(lx) <= i.hx and math.abs(ly) <= i.hy and math.abs(lz) <= i.hz then
				if sh ~= "Wedge" or (ly + i.hy) * i.hz <= (lz + i.hz) * i.hy then
					return true
				end
			end
		end
		return false
	end

	-- 점유 격자
	for _, p in statics do
		if blocksSound(p) then
			for _, idx in rasterCells(p.CFrame, p.Size) do
				addOcc(idx, 1)
			end
		end
		yieldSometimes()
	end
	-- 문
	for _, m in CollectionService:GetTagged(TAGS.Door) do
		if m:IsA("Model") and m:IsDescendantOf(stage) then
			local panel = m:FindFirstChild("Panel") :: BasePart?
			local closed = panel and panel:GetAttribute("ClosedCFrame") :: CFrame?
			if panel and closed then
				local d = { model = m, cells = rasterCells(closed, panel.Size), blocked = false, conn = nil :: RBXScriptConnection? }
				refreshDoor(d)
				d.conn = m:GetAttributeChangedSignal("Open"):Connect(function()
					refreshDoor(d)
				end)
				table.insert(World.doors, d)
			end
		end
	end

	-- 선분
	local EPS = 0.08
	local list = Geo.newList()
	local SA, SB, SM = World.SA, World.SB, World.SM
	local segLen = S.SegmentLength
	local n = 0
	for _, p in statics do
		if Geo.shapeOf(p) ~= "None" then
			list.n = 0
			Geo.staticEdges(p, list)
			for i = 1, list.n do
				local a, b = list.A[i], list.B[i]
				local n1, n2 = list.N1[i], list.N2[i]
				local d = b - a
				local len = d.Magnitude
				if len > 0.03 then
					-- 모서리 위 한 점이 보이는가(이음매·묻힌 모서리가 아닌가)
					local function keepAt(t: number): boolean
						if not (n1 and n2) then
							return true
						end
						local m = a + d * t
						local u1 = (n1 :: Vector3) * EPS
						local u2 = (n2 :: Vector3) * EPS
						if not inside(m + u1 + u2) then
							-- 한쪽 면이 모서리 너머로 같은 평면으로 이어지면 이음매
							return not (inside(m + u2 - u1) or inside(m + u1 - u2))
						end
						return not (inside(m + u1 - u2) and inside(m - u1 + u2)) -- 묻힌 모서리
					end
					-- 조각(SegmentLength) 가운데마다 판정하고, 이웃 조각과 결과가 다르면 그 사이 경계를 이분 탐색으로 정확히 잡는다
					-- (가운데 한 점으로만 자르면 벽 모서리에 걸친 조각이 통째로 빠져 선이 모서리 앞에서 끊긴다)
					local samples = math.max(1, math.ceil(len / segLen))
					local runs: { { number } } = {}
					local prevT = 0.5 / samples
					local prevKeep = keepAt(prevT)
					local runStart: number? = if prevKeep then 0 else nil
					for s = 1, samples - 1 do
						local t = (s + 0.5) / samples
						local k = keepAt(t)
						if k ~= prevKeep then
							local lo, hi = prevT, t
							for _ = 1, 7 do
								local mid = (lo + hi) / 2
								if keepAt(mid) == prevKeep then
									lo = mid
								else
									hi = mid
								end
							end
							local cut = (lo + hi) / 2
							if prevKeep then
								table.insert(runs, { runStart :: number, cut })
								runStart = nil
							else
								runStart = cut
							end
							prevKeep = k
						end
						prevT = t
					end
					if prevKeep and runStart then
						table.insert(runs, { runStart, 1 })
					end
					for _, run in runs do
						local t0, t1 = run[1], run[2]
						local rl = (t1 - t0) * len
						if rl > 0.05 then
							local k = math.max(1, math.ceil(rl / segLen))
							for s = 0, k - 1 do
								local pa = a + d * (t0 + (t1 - t0) * s / k)
								local pb = a + d * (t0 + (t1 - t0) * (s + 1) / k)
								n += 1
								SA[n] = pa
								SB[n] = pb
								SM[n] = (pa + pb) / 2
							end
						end
					end
					if #runs == 0 then
						World.culled += 1
					end
				end
			end
		end
		if Geo.hasViewEdges(p) then
			table.insert(World.viewParts, p)
			local i = #World.viewParts
			local k = vkey(math.floor(p.Position.X / VB), math.floor(p.Position.Y / VB), math.floor(p.Position.Z / VB))
			local l = viewBuckets[k]
			if not l then
				l = {}
				viewBuckets[k] = l
			end
			table.insert(l, i)
		end
		yieldSometimes()
	end
	World.segCount = n

	-- 선분 ↔ 복셀
	local cellSegs = World.cellSegs
	for s = 1, n do
		local cells = World.attachCells(SM[s])
		if #cells == 0 then
			World.unattached += 1
		end
		for _, idx in cells do
			local l = cellSegs[idx]
			if not l then
				l = {}
				cellSegs[idx] = l
			end
			table.insert(l, s)
		end
		if s % 400 == 0 then
			yieldSometimes()
		end
	end

	World.buildId = (stage:GetAttribute("BuildId") :: number?) or 0
	cpu += os.clock() - t0
	World.buildSeconds = os.clock() - wall0
	World.buildCpu = cpu
	World.ready = true
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">UI</string>
          <string name="Source"><![CDATA[--!strict
-- 최소 UI: 작은 조준점, 음파 재사용 대기 막대, 스테이지 이름, 상호작용 안내, 사망/탈출/클리어 화면.
-- 흰색·회색만. 미니맵이나 괴물 위치 표시는 없다.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local UI = {}
local player = Players.LocalPlayer

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "SonarUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 5
gui.Parent = player:WaitForChild("PlayerGui")

local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium)
local FONT_BOLD = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)

local function label(parent: Instance, text: string, size: number, pos: UDim2, anchor: Vector2, bold: boolean?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextSize = size
	l.FontFace = if bold then FONT_BOLD else FONT
	l.TextColor3 = Color3.fromRGB(220, 220, 220)
	l.Size = UDim2.fromOffset(600, size + 8)
	l.Position = pos
	l.AnchorPoint = anchor
	l.Parent = parent
	return l
end

-- 조준점
local dot = Instance.new("Frame")
dot.Size = UDim2.fromOffset(3, 3)
dot.AnchorPoint = Vector2.new(0.5, 0.5)
dot.Position = UDim2.fromScale(0.5, 0.5)
dot.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
dot.BackgroundTransparency = 0.35
dot.BorderSizePixel = 0
dot.Parent = gui

-- 음파 대기 막대(조준점 아래, 아주 얇게)
local barBack = Instance.new("Frame")
barBack.Size = UDim2.fromOffset(36, 2)
barBack.AnchorPoint = Vector2.new(0.5, 0)
barBack.Position = UDim2.new(0.5, 0, 0.5, 14)
barBack.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
barBack.BackgroundTransparency = 0.75
barBack.BorderSizePixel = 0
barBack.Parent = gui
local barFill = Instance.new("Frame")
barFill.Size = UDim2.fromScale(1, 1)
barFill.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
barFill.BackgroundTransparency = 0.5
barFill.BorderSizePixel = 0
barFill.Parent = barBack

-- 스테이지 이름(왼쪽 위, 흐리게)
local stageLabel = label(gui, "", 14, UDim2.fromOffset(18, 14), Vector2.zero)
stageLabel.TextXAlignment = Enum.TextXAlignment.Left
stageLabel.TextTransparency = 0.45

-- 가운데 큰 제목(스테이지 시작 시 잠깐)
local title = label(gui, "", 26, UDim2.fromScale(0.5, 0.36), Vector2.new(0.5, 0.5), true)
title.TextTransparency = 1
title.Size = UDim2.fromOffset(900, 40)

-- 짧은 안내(가운데 아래)
local hint = label(gui, "", 15, UDim2.new(0.5, 0, 0.5, 46), Vector2.new(0.5, 0))
hint.TextTransparency = 1

-- 상호작용 안내
local prompt = label(gui, "", 15, UDim2.new(0.5, 0, 0.5, 26), Vector2.new(0.5, 0))
prompt.TextTransparency = 0.2
prompt.Visible = false

-- 결과 화면
local overlay = Instance.new("Frame")
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundColor3 = Color3.new(0, 0, 0)
overlay.BackgroundTransparency = 1
overlay.BorderSizePixel = 0
overlay.ZIndex = 10
overlay.Parent = gui
local ovTitle = label(overlay, "", 40, UDim2.fromScale(0.5, 0.44), Vector2.new(0.5, 0.5), true)
ovTitle.Size = UDim2.fromOffset(900, 56)
ovTitle.ZIndex = 11
ovTitle.TextTransparency = 1
local ovSub = label(overlay, "", 16, UDim2.fromScale(0.5, 0.53), Vector2.new(0.5, 0.5))
ovSub.Size = UDim2.fromOffset(900, 24)
ovSub.ZIndex = 11
ovSub.TextColor3 = Color3.fromRGB(160, 160, 160)
ovSub.TextTransparency = 1

-- 관전 안내(아래쪽)
local spectate = label(gui, "", 14, UDim2.new(0.5, 0, 1, -40), Vector2.new(0.5, 0.5))
spectate.TextColor3 = Color3.fromRGB(170, 170, 170)
spectate.Visible = false

local function tween(obj: Instance, t: number, props: { [string]: any })
	TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Sine), props):Play()
end

function UI.setCooldown(frac: number)
	barFill.Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1)
	barFill.BackgroundTransparency = if frac >= 1 then 0.6 else 0.35
end

function UI.setStage(name: string)
	stageLabel.Text = name
	title.Text = name
	tween(title, 1.2, { TextTransparency = 0.1 })
	task.delay(3.5, function()
		if title.Text == name then
			tween(title, 1.5, { TextTransparency = 1 })
		end
	end)
end

function UI.hint(text: string, seconds: number)
	hint.Text = text
	tween(hint, 0.6, { TextTransparency = 0.25 })
	task.delay(seconds, function()
		if hint.Text == text then
			tween(hint, 1.2, { TextTransparency = 1 })
		end
	end)
end

-- 안내 문구는 두 곳에서 온다: 문·숨는 곳(가까이 가면) / 서랍·상자(조준하면). 조준한 것이 먼저 보이고,
-- 한쪽이 지워도 다른 쪽 문구는 남는다(서랍에서 눈을 떼도 옆 사물함의 '숨기'가 사라지지 않게)
local nearText: string? = nil
local lookText: string? = nil
local function showPrompt()
	local text = lookText or nearText
	prompt.Visible = text ~= nil
	prompt.Text = text or ""
end

function UI.setPrompt(text: string?)
	nearText = text
	showPrompt()
end

function UI.setLookPrompt(text: string?)
	lookText = text
	showPrompt()
end

-- 결과 화면. black: 화면을 검게 덮는다(아니면 글자만)
function UI.overlay(t: string, sub: string, black: boolean)
	ovTitle.Text = t
	ovSub.Text = sub
	tween(overlay, 0.9, { BackgroundTransparency = if black then 0 else 1 })
	tween(ovTitle, 0.9, { TextTransparency = 0 })
	tween(ovSub, 1.2, { TextTransparency = 0 })
	dot.Visible = false
	barBack.Visible = false
end

function UI.hideOverlay(fast: boolean?)
	local t = if fast then 0.2 else 0.8
	tween(overlay, t, { BackgroundTransparency = 1 })
	tween(ovTitle, t, { TextTransparency = 1 })
	tween(ovSub, t, { TextTransparency = 1 })
	dot.Visible = true
	barBack.Visible = true
end

-- 오버레이 글자만 남기고 배경을 걷는다(관전으로 넘어갈 때)
function UI.liftOverlay()
	tween(overlay, 1.2, { BackgroundTransparency = 1 })
	tween(ovTitle, 1.2, { TextTransparency = 1 })
	tween(ovSub, 1.2, { TextTransparency = 1 })
end

function UI.setSpectate(text: string?)
	spectate.Visible = text ~= nil
	spectate.Text = text or ""
	if text then
		dot.Visible = false
		barBack.Visible = false
	end
end

function UI.state()
	return {
		overlayTitle = ovTitle.Text,
		overlayShown = ovTitle.TextTransparency < 0.5,
		stage = stageLabel.Text,
		spectate = if spectate.Visible then spectate.Text else nil,
		prompt = if prompt.Visible then prompt.Text else nil,
	}
end

return UI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="60">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>