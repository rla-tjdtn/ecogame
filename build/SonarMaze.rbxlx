        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Stage4</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 4 — 폐병원 (45x41칸, tools/gen-themed.js 설계도)
-- 로비(접수 데스크·기둥) → 긴 병원 복도 3줄(양옆에 병실 R·진료실 T·수술실 X·간호사실·창고 k·화장실)
-- 복도 끝 엘리베이터 홀(오른쪽)·계단(왼쪽)으로 다음 복도, 마지막 복도 끝 비상구. 갈림길·고리가 많아(백룸식) 괴물을 피해 다른 길로 돌아갈 수 있다. 출구까지 최단 약 137칸(헤매면서 약 2분).
local Props = require(script.Parent.Parent.Props)
return {
	Seed = 41,
	PipeChance = 0.25,
	HideStyle = "wardrobe", -- 숨는 곳(L): 병실 옷장
	SearchStyle = "nightstand", -- 뒤지는 곳(Z): 협탁, 그중 한 곳에 열쇠
	Props = { R = Props.Bed, T = Props.Desk, X = Props.Surgery, k = Props.Cabinet },
	Walkable = { R = true, k = true },
	Rows = {
		"#############################################",
		"#SS.....TT.#k..Z#k.Z#k.k.k#kkk.kk#kkkkk.kkkk#",
		"#..........A....#...#.....A......D..........#",
		"#SS...O..O.#..T.D.T.#..X..#......#..........#",
		"#..........#....#...#.....#L.....#L.........#",
		"##........###D####D###D#######D######D#####A#",
		"#...........................................#",
		"#...........................................#",
		"##D######D###D#####D####D######D######D##...#",
		"#...#......#....L#....#......#...#......#...#",
		"#...#......#.....#....A......#...#......#...#",
		"#...D......A.....A..T.#......A...A...X..#...#",
		"#...#RZR.R.#RZR.R#k..Z#kkk.kk#k.k#k.k...D...#",
		"###################################A#####...#",
		"#kk.k#k.k#...#RZR.R#kk.kk#kk.k#kkkk.kkkk#...#",
		"#....A...A...D.....A.....D....D.........D...#",
		"#....#...#...#.....#.....#....#.........#...#",
		"#....#...#...#.....#.....#....#L........#...#",
		"##D####D###D#####D###D#####D#######D#####...#",
		"#...........................................#",
		"#...........................................#",
		"#...####D####D######D###D####D#####D######D##",
		"#...#L.....#...#......#....#....L#....L#....#",
		"#...#......#...#......#....#.....#.....#....#",
		"#...A......D.T.#.TTTT.#....D.....D.....A..T.#",
		"#...#kkk.kk#k..A.....Z#kk.k#RZR.R#RZR.R#k..Z#",
		"#...#########################################",
		"#...A...#kkk.kkk#......Z#k.Z#RZR.R.R#RZR.R.R#",
		"#...#...D.......A.......#...#.......A.......#",
		"#...#...#.......#.TTTTT.A.T.A.......#.......#",
		"#...#...#.......#.......#...#......L#......L#",
		"#...##D###D##########D####D######D####D######",
		"#..........................................E#",
		"#..........................................##",
		"#####D######D######D#####D####D####D######D##",
		"#......#......#L......#....L#....#....L#L...#",
		"#......#......#.......#.....#....A.....#....#",
		"#......A......A.......A.....A..T.#.....A....#",
		"#RZR.R.#RZR.R.#kkk.kkk#RZR.R#k..Z#RZR.R#kk.k#",
