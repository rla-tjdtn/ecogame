        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">k9s4</string>
            <string name="Source"><![CDATA[--!strict
-- 자동 생성(art/creatures/source/game/sprite.js): 보닛 시안 그림 시트. 손으로 고치지 말 것
-- 칸 i = 방향 * 9 + 자세(0~3 걷기, 4~7 추격, 8 덮침), 방향 0 = 정면부터 45°씩. 시트 = i // 12 + 1, 칸 안 = i % 12
return {
	id = "k9s4", name = "보닛",
	sheets = { 0, 0, 0, 0, 0, 0 }, -- 로블록스 이미지 에셋 번호(올린 뒤 채운다)
	cols = 4, rows = 3, cellPx = { 256, 341 }, yaws = 8, poses = 9,
	size = { 8.103, 10.794 }, -- 칸 하나의 크기(스터드)
	centerY = 4.905, -- 바닥에서 칸 가운데까지(스터드)
	centerZ = 0.247, -- 몸 기준(디자인 앞 +Z) 칸 가운데의 앞뒤 위치
