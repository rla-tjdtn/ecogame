-- 칸 i = 방향 * 9 + 자세(0~3 걷기, 4~7 추격, 8 덮침), 방향 0 = 정면부터 45°씩. 시트 = i // 12 + 1, 칸 안 = i % 12
return {
	id = "k9s1", name = "차밑",
	sheets = { 0, 0, 0, 0, 0, 0 }, -- 로블록스 이미지 에셋 번호(올린 뒤 채운다)
	cols = 2, rows = 6, cellPx = { 512, 170 }, yaws = 8, poses = 9,
	size = { 13.326, 4.425 }, -- 칸 하나의 크기(스터드)
	centerY = 1.584, -- 바닥에서 칸 가운데까지(스터드)
	centerZ = 0.787, -- 몸 기준(디자인 앞 +Z) 칸 가운데의 앞뒤 위치
	stride = 2.6,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">k9s2</string>
            <string name="Source"><![CDATA[--!strict
-- 자동 생성(art/creatures/source/game/sprite.js): 덮개 시안 그림 시트. 손으로 고치지 말 것
-- 칸 i = 방향 * 9 + 자세(0~3 걷기, 4~7 추격, 8 덮침), 방향 0 = 정면부터 45°씩. 시트 = i // 12 + 1, 칸 안 = i % 12
return {
	id = "k9s2", name = "덮개",
	sheets = { 0, 0, 0, 0, 0, 0 }, -- 로블록스 이미지 에셋 번호(올린 뒤 채운다)
	cols = 3, rows = 4, cellPx = { 341, 256 }, yaws = 8, poses = 9,
	size = { 19.127, 14.360 }, -- 칸 하나의 크기(스터드)
	centerY = 6.175, -- 바닥에서 칸 가운데까지(스터드)
	centerZ = 0.303, -- 몸 기준(디자인 앞 +Z) 칸 가운데의 앞뒤 위치
	stride = 3,
}
]]></string>
          </Properties>
