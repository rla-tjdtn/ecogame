		"###############################################",
	},
	Rows2 = { -- 2층(1층 위에 같은 크기로 겹쳐 쌓는다. o = 계단 구멍)
		"###############################################",
		"#......v#..LLL.L.#.......#......Z#RR..RR#Lc...#",
		"#.m..m..#........#.T.T.T.#..T.T..#......#.....#",
