-- END SCREAM RECIPES

-- 고른 시안의 소리·겹침 표를 적용한다(직접 만든 것 > 카탈로그 번호 > 시안 번호 순)
do
	local styles: any = Config.ScreamStyles
	local style: any = styles[Config.ScreamStyle] or styles[1]
	if Config.ScreamCustom then
		style = recipeStyle(Config.ScreamCustom)
	elseif ScreamRecipes[Config.ScreamRecipe] then
		style = recipeStyle(ScreamRecipes[Config.ScreamRecipe])
	end
	-- 실제 녹음 괴성(Config.RealScream): 있으면 위 합성 시안보다 우선
	local real = Config.RealScreams[Config.RealScream]
	if real then
		local id = "rbxassetid://" .. real.Id
		style = {
			Sounds = {
				MonsterChase = { Id = id, Volume = real.Volume, Pitch = 1, Range = 110, Cut = real.Dur, Fx = { { "ReverbSoundEffect", { DecayTime = 2.5, WetLevel = -8 } } } },
				MonsterAlert = if real.Layer
					then { Id = "rbxassetid://" .. real.Layer.Id, Volume = real.Layer.Volume, Pitch = 1, Range = 110, Cut = real.Layer.Dur }
					else { Id = id, Volume = real.Volume, Pitch = 1, Range = 110, Cut = real.Dur }, -- (잡힐 때 점프스케어가 2D 로 튼다: 겹친 비명이 있으면 그 비명)
				MonsterChaseLayer = if real.Layer then { Id = "rbxassetid://" .. real.Layer.Id, Volume = real.Layer.Volume, Pitch = 1, Range = 110, Cut = real.Layer.Dur } else { Id = "", Volume = 0, Pitch = 1, Range = 0 },
				MonsterIdle = { Id = "", Volume = 0, Pitch = 1, Range = 0 }, -- 평소에는 소리를 내지 않는다
				MonsterScream2 = { Id = "", Volume = 0, Pitch = 1, Range = 0 },
			},
			-- 추격 괴성: 끊었다 켰다 하며(Config.ScreamGate) 같은 음 높이로
			Screams = { Chase = { { s = "MonsterChase", t = 0, p = 1, v = 1, dur = real.Dur, gate = Config.ScreamGate, start = real.Start } } },
		}
		if real.Layer then
			table.insert(style.Screams.Chase, { s = "MonsterChaseLayer", t = real.Layer.Delay, p = 1, v = 1, start = real.Layer.Start })
		end
	end
	for name, def in style.Sounds do
		(Config.Sounds :: any)[name] = def
	end
	;(Config :: any).Screams = style.Screams
end

-- 태그 이름
Config.Tags = {
	Renderable = "SonarRenderable", -- 이 태그가 붙은 파트(또는 모델 안 파트)는 음파 윤곽선 대상
	Dynamic = "SonarDynamic", -- 움직이는 대상(문, 괴물): 음파가 닿는 순간의 모습으로 선을 만든다
	Door = "SonarDoor",
	Monster = "Monster",
	AmbientEmitter = "AmbientEmitter",
	HideSpot = "HideSpot",
	SearchSpot = "SearchSpot",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">SonarGeometry</string>
          <string name="Source"><![CDATA[--!strict
-- 구조물 모양별 윤곽선(모서리) 데이터 생성.
--   Box      : 상자의 12개 모서리 (속성 SonarEdgeAxis = "X"/"Y"/"Z" 이면 그 축 방향 4개만 — 아치 조각, 이어진 난간 등)
--   Wedge    : 쐐기의 9개 모서리
--   Cylinder : 양 끝 원 + (속성 SonarRings 개수만큼) 중간 원 / 보는 위치 기준 실루엣 2줄은 viewEdges 에서
--   Ball     : 보는 위치 기준 실루엣 원(viewEdges)
--   Line     : 가장 긴 축을 따라 선 하나(속성 SonarShape = "Line"). 괴물처럼 가는 막대를 한 획으로 그릴 때
--   Disc     : 원통 가운데 원 하나(속성 SonarShape = "Disc"). 얇은 원판(눈, 둥근 머리)을 한 줄 원으로
--   None     : 선 없음(속성 SonarShape = "None")
-- MeshPart / Union 처럼 정확한 모서리를 얻기 어려운 것은 상자 프록시를 쓴다(SonarShape 속성으로 바꿀 수 있다).
--
-- 결과는 EdgeList 에 쌓는다: A[i]→B[i] 선분, N1[i]/N2[i] 는 그 모서리에 붙은 두 면의 바깥 법선
-- (이음매 제거 판정에 쓰며, 원통의 원처럼 판정이 필요 없는 선은 nil).

local Geo = {}

export type EdgeList = {
	A: { Vector3 },
	B: { Vector3 },
	N1: { Vector3 | false },
	N2: { Vector3 | false },
	n: number,
}

function Geo.newList(): EdgeList
	return { A = {}, B = {}, N1 = {}, N2 = {}, n = 0 }
end

local function push(out: EdgeList, a: Vector3, b: Vector3, n1: Vector3?, n2: Vector3?)
	local i = out.n + 1
	out.n = i
	out.A[i] = a
	out.B[i] = b
	out.N1[i] = n1 or false
	out.N2[i] = n2 or false
end

function Geo.shapeOf(part: BasePart): string
	local forced = part:GetAttribute("SonarShape")
	if type(forced) == "string" then
		return forced
	end
	if part:IsA("WedgePart") then
		return "Wedge"
	end
	if part:IsA("Part") then
		local s = (part :: Part).Shape
		if s == Enum.PartType.Cylinder then
			return "Cylinder"
		elseif s == Enum.PartType.Ball then
			return "Ball"
		elseif s == Enum.PartType.Wedge then
			return "Wedge"
		end
	end
	return "Box"
end

local function ringSegments(r: number): number
	return math.clamp(math.floor(r * 5) + 6, 8, 24)
end

-- 상자 모서리. axisOnly: "X"/"Y"/"Z" 이면 그 축과 평행한 모서리만.
function Geo.boxEdges(cf: CFrame, size: Vector3, out: EdgeList, axisOnly: string?, noNormals: boolean?)
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
	local p = cf.Position
	for _, s1 in { -1, 1 } do
		for _, s2 in { -1, 1 } do
			-- X 방향 모서리 (y = s1, z = s2)
			if axisOnly == nil or axisOnly == "X" then
				local o = p + Y * (s1 * hy) + Z * (s2 * hz)
				if noNormals then
					push(out, o - X * hx, o + X * hx)
				else
					push(out, o - X * hx, o + X * hx, Y * s1, Z * s2)
				end
			end
			-- Y 방향 모서리 (x = s1, z = s2)
			if axisOnly == nil or axisOnly == "Y" then
				local o = p + X * (s1 * hx) + Z * (s2 * hz)
				if noNormals then
					push(out, o - Y * hy, o + Y * hy)
				else
					push(out, o - Y * hy, o + Y * hy, X * s1, Z * s2)
				end
			end
			-- Z 방향 모서리 (x = s1, y = s2)
			if axisOnly == nil or axisOnly == "Z" then
				local o = p + X * (s1 * hx) + Y * (s2 * hy)
				if noNormals then
					push(out, o - Z * hz, o + Z * hz)
				else
					push(out, o - Z * hz, o + Z * hz, X * s1, Y * s2)
				end
			end
		end
	end
end

-- 쐐기: 바닥(-Y) 전체, 뒷면(+Z) 전체 높이, 경사면은 앞(-Z) 아래쪽에서 뒤(+Z) 위쪽으로 올라간다.
function Geo.wedgeEdges(cf: CFrame, size: Vector3, out: EdgeList, noNormals: boolean?)
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
	local p = cf.Position
	local slopeN = (Y * hz - Z * hy).Unit
	local function v(x: number, y: number, z: number): Vector3
		return p + X * x + Y * y + Z * z
	end
	local function e(a: Vector3, b: Vector3, n1: Vector3, n2: Vector3)
		if noNormals then
			push(out, a, b)
		else
			push(out, a, b, n1, n2)
		end
	end
	e(v(-hx, -hy, -hz), v(hx, -hy, -hz), -Y, slopeN) -- 앞 아래
	e(v(-hx, -hy, hz), v(hx, -hy, hz), -Y, Z) -- 뒤 아래
	e(v(-hx, hy, hz), v(hx, hy, hz), Z, slopeN) -- 꼭대기
	for _, s in { -1, 1 } do
		local x = s * hx
		e(v(x, -hy, hz), v(x, hy, hz), X * s, Z) -- 뒤 세로
		e(v(x, -hy, -hz), v(x, -hy, hz), X * s, -Y) -- 옆 아래
		e(v(x, -hy, -hz), v(x, hy, hz), X * s, slopeN) -- 옆 경사
	end
end

local function circle(center: Vector3, u: Vector3, w: Vector3, r: number, segs: number, out: EdgeList)
	local prev = center + u * r
	for i = 1, segs do
		local t = (i / segs) * math.pi * 2
		local cur = center + u * (math.cos(t) * r) + w * (math.sin(t) * r)
		push(out, prev, cur)
		prev = cur
	end
end

-- 원통(축 = 로컬 X): 양 끝 원과 중간 원
function Geo.cylinderRings(cf: CFrame, size: Vector3, out: EdgeList, rings: number?)
	local r = math.min(size.Y, size.Z) / 2
	local hx = size.X / 2
	local thin = r < 0.3
	if thin then
		return -- 가는 원통(난간, 기둥 살)은 실루엣만
	end
	local segs = ringSegments(r)
	local count = (rings or 0)
	for i = 0, count + 1 do
		local x = -hx + (2 * hx) * (i / (count + 1))
		circle(cf.Position + cf.XVector * x, cf.YVector, cf.ZVector, r, segs, out)
	end
end

-- 원통의 실루엣 2줄(보는 위치 기준)
function Geo.cylinderSilhouette(cf: CFrame, size: Vector3, view: Vector3, out: EdgeList)
	local r = math.min(size.Y, size.Z) / 2
	local hx = size.X / 2
	local lv = cf:PointToObjectSpace(view)
	local d = math.sqrt(lv.Y * lv.Y + lv.Z * lv.Z)
	if d <= r * 1.02 then
		return
	end
	local phi0 = math.atan2(lv.Z, lv.Y)
	local theta = math.acos(r / d)
	for _, s in { -1, 1 } do
		local phi = phi0 + s * theta
		local y, z = math.cos(phi) * r, math.sin(phi) * r
		push(out, cf:PointToWorldSpace(Vector3.new(-hx, y, z)), cf:PointToWorldSpace(Vector3.new(hx, y, z)))
	end
	-- 가는 원통은 끝을 짧은 가로선으로 닫는다(난간 끝, 기둥 살 끝)
	if r < 0.3 then
		local a = Vector3.new(0, math.cos(phi0 + theta) * r, math.sin(phi0 + theta) * r)
		local b = Vector3.new(0, math.cos(phi0 - theta) * r, math.sin(phi0 - theta) * r)
		for _, x in { -hx, hx } do
			local o = Vector3.new(x, 0, 0)
			push(out, cf:PointToWorldSpace(o + a), cf:PointToWorldSpace(o + b))
		end
	end
end

-- 구의 실루엣 원(보는 위치 기준)
function Geo.ballSilhouette(cf: CFrame, size: Vector3, view: Vector3, out: EdgeList)
	local r = math.min(size.X, size.Y, size.Z) / 2
	local c = cf.Position
	local toC = c - view
	local D = toC.Magnitude
	if D <= r * 1.05 then
		return
	end
	local dir = toC / D
	local cc = c - dir * (r * r / D)
	local rr = r * math.sqrt(1 - (r * r) / (D * D))
	local u = dir:Cross(Vector3.yAxis)
	if u.Magnitude < 0.01 then
		u = dir:Cross(Vector3.xAxis)
	end
	u = u.Unit
	local w = dir:Cross(u).Unit
	circle(cc, u, w, rr, ringSegments(r), out)
end

-- 보는 위치와 상관없는 모서리(정적 데이터로 미리 만들어 둔다)
function Geo.staticEdges(part: BasePart, out: EdgeList, noNormals: boolean?)
	local shape = Geo.shapeOf(part)
	local cf, size = part.CFrame, part.Size
	if shape == "Box" then
		local axis = part:GetAttribute("SonarEdgeAxis")
		Geo.boxEdges(cf, size, out, if type(axis) == "string" then axis else nil, noNormals)
	elseif shape == "Wedge" then
		Geo.wedgeEdges(cf, size, out, noNormals)
	elseif shape == "Line" then
		local s = size
		local axis = if s.X >= s.Y and s.X >= s.Z then cf.XVector * (s.X / 2) elseif s.Y >= s.Z then cf.YVector * (s.Y / 2) else cf.ZVector * (s.Z / 2)
		push(out, cf.Position - axis, cf.Position + axis)
	elseif shape == "Disc" then
		local r = math.min(size.Y, size.Z) / 2
		circle(cf.Position, cf.YVector, cf.ZVector, r, ringSegments(r), out)
	elseif shape == "Cylinder" then
		local rings = part:GetAttribute("SonarRings")
		Geo.cylinderRings(cf, size, out, if type(rings) == "number" then rings else nil)
	end
end

-- 보는 위치에 따라 달라지는 선(원통·구의 실루엣)
function Geo.viewEdges(part: BasePart, view: Vector3, out: EdgeList)
	local shape = Geo.shapeOf(part)
	if shape == "Cylinder" then
		Geo.cylinderSilhouette(part.CFrame, part.Size, view, out)
	elseif shape == "Ball" then
		Geo.ballSilhouette(part.CFrame, part.Size, view, out)
	end
end

function Geo.hasViewEdges(part: BasePart): boolean
	local shape = Geo.shapeOf(part)
	return shape == "Cylinder" or shape == "Ball"
end

-- 점이 파트 안에 있는가(이음매 제거, 복셀화에 사용)
function Geo.pointInside(part: BasePart, p: Vector3, pad: number?): boolean
	local lp = part.CFrame:PointToObjectSpace(p)
	local s = part.Size
	local m = pad or 0
	local shape = Geo.shapeOf(part)
	if shape == "Cylinder" then
		local r = math.min(s.Y, s.Z) / 2 + m
		return math.abs(lp.X) <= s.X / 2 + m and (lp.Y * lp.Y + lp.Z * lp.Z) <= r * r
	elseif shape == "Ball" then
		local r = math.min(s.X, s.Y, s.Z) / 2 + m
		return lp.Magnitude <= r
	end
	if math.abs(lp.X) > s.X / 2 + m or math.abs(lp.Y) > s.Y / 2 + m or math.abs(lp.Z) > s.Z / 2 + m then
		return false
	end
	if shape == "Wedge" then
		-- 경사면 아래(뒤)쪽만 속이 차 있다
		local hy, hz = s.Y / 2, s.Z / 2
		-- 경사면: (y + hy) * (2hz) <= (z + hz) * (2hy)
		return (lp.Y + hy) * hz <= (lp.Z + hz) * hy + m * math.max(hy, hz) * 1.5
	end
	return true
end

return Geo
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="16">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Doors</string>
          <string name="Source"><![CDATA[--!strict
-- 문: E(ProximityPrompt)로 열고 닫는다. 경첩을 축으로 90도 회전.
-- 문짝은 움직이므로 SonarDynamic(음파가 닿는 순간의 위치로 윤곽선), 닫혀 있으면 음파·소리를 막는다.
-- 괴물은 문을 지나갈 수 있도록 경로 계산에서 문짝을 무시(PathfindingModifier.PassThrough)하고, 가까이 가면 연다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local SoundBus = require(script.Parent.SoundBus)

local Doors = {}

type Door = {
	model: Model,
	panel: Part,
	prompt: ProximityPrompt,
	hinge: CFrame,
	closedRel: CFrame,
	swing: number,
	open: boolean,
	busy: boolean,
}

local doors: { Door } = {}

local function setPose(d: Door, t: number)
	local rot = CFrame.Angles(0, d.swing * (math.pi / 2) * t, 0)
	d.panel.CFrame = d.hinge * rot * d.closedRel
end

-- 문짝이나 그 근처에 캐릭터(플레이어·괴물)가 겹쳐 있는가
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude
local function someoneInside(panel: BasePart): boolean
	overlap.FilterDescendantsInstances = { panel.Parent :: Instance }
	for _, p in workspace:GetPartBoundsInBox(panel.CFrame, panel.Size + Vector3.new(0.4, 0, 0.6), overlap) do
		local m = p:FindFirstAncestorOfClass("Model")
		if m and m:FindFirstChildOfClass("Humanoid") then
			return true
		end
	end
	return false
end

-- from: 여는 사람(또는 괴물) 위치. 열 때 그 반대쪽으로 열려서 문짝이 사람을 치거나 가두지 않는다
function Doors.toggle(d: Door, source: Player?, from: Vector3?)
	if d.busy then
		return
	end
	d.busy = true
	local opening = not d.open
	if opening then
		local pos = from
		if not pos and source and source.Character then
			local r = source.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			pos = r and r.Position
		end
		if pos then
			-- 문짝은 경첩 기준 -Z*swing 쪽으로 열린다: 여는 사람이 있는 쪽의 반대
			d.swing = if (pos - d.hinge.Position):Dot(d.hinge.ZVector) >= 0 then 1 else -1
		end
	end
	-- 움직이는 동안은 부딪히지 않는다(끼임 방지)
	d.panel.CanCollide = false
	d.open = opening
	d.model:SetAttribute("Open", opening)
	d.prompt.ActionText = if opening then "문 닫기" else "문 열기"
	SoundBus.emit(d.panel.Position, Config.Noise.Door, source, "Door")
	task.spawn(function()
		local dur = 0.55
		local t0 = os.clock()
		while true do
			local a = math.clamp((os.clock() - t0) / dur, 0, 1)
			local e = 1 - (1 - a) * (1 - a)
			setPose(d, if opening then e else 1 - e)
			if a >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		d.busy = false
		-- 멈춘 뒤: 아무도 겹쳐 있지 않을 때 다시 단단해진다
		local waited = 0
		while d.panel.Parent and someoneInside(d.panel) and waited < 10 do
			task.wait(0.2)
			waited += 0.2
		end
		if d.panel.Parent and not d.busy then
			d.panel.CanCollide = true
		end
	end)
end

-- hingeBottom: 경첩 아래 끝, along: 닫힌 문짝이 경첩에서 뻗는 방향(수평), swing: +1/-1 (여는 방향)
function Doors.create(parent: Instance, hingeBottom: Vector3, along: Vector3, width: number, height: number, swing: number): Model
	local model = Instance.new("Model")
	model.Name = "Door"
	model:SetAttribute("Open", false)
	model:SetAttribute(Config.Tags.Dynamic, true)
	model.Parent = parent
	local dir = Vector3.new(along.X, 0, along.Z).Unit
	local hinge = CFrame.fromMatrix(hingeBottom, dir, Vector3.yAxis)
	local closedRel = CFrame.new(width / 2, height / 2, 0)
	local panel = Kit.box(model, hinge * closedRel, Vector3.new(width - 0.1, height - 0.05, 0.3), { name = "Panel" })
	panel:SetAttribute("ClosedCFrame", panel.CFrame)
	-- 손잡이(가로 막대) + 판 무늬: 문으로 알아볼 수 있게
	local handleY = height * 0.45
	for _, side in { -1, 1 } do
		local a = panel.CFrame * Vector3.new(width * 0.05, handleY - height / 2, side * 0.3)
		local b = panel.CFrame * Vector3.new(width * 0.38, handleY - height / 2, side * 0.3)
		local h = Kit.cylinder(model, a, b, 0.08, { collide = false, blocks = false })
		h.Anchored = false
		h.Massless = true
		local w = Instance.new("WeldConstraint")
		w.Part0 = panel
		w.Part1 = h
		w.Parent = h
	end
	local inset = Kit.box(model, panel.CFrame * CFrame.new(0, height * 0.18, 0), Vector3.new(width * 0.62, height * 0.3, 0.42), { collide = false, blocks = false })
	inset.Anchored = false
	inset.Massless = true
	local w2 = Instance.new("WeldConstraint")
	w2.Part0 = panel
	w2.Part1 = inset
	w2.Parent = inset
	local mod = Instance.new("PathfindingModifier")
	mod.PassThrough = true
	mod.Parent = panel
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "문 열기"
	prompt.ObjectText = ""
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Parent = panel
	CollectionService:AddTag(model, Config.Tags.Door)
	local d: Door = {
		model = model,
		panel = panel,
		prompt = prompt,
		hinge = hinge,
		closedRel = closedRel,
		swing = swing,
		open = false,
		busy = false,
	}
	table.insert(doors, d)
	prompt.Triggered:Connect(function(player)
		if player:GetAttribute("Status") ~= "Alive" then
			return
		end
		Doors.toggle(d, player)
	end)
	model.Destroying:Connect(function()
		local i = table.find(doors, d)
		if i then
			table.remove(doors, i)
		end
	end)
	return model
end

function Doors.all(): { Door }
	return doors
end

-- 괴물용: pos 근처 닫힌 문을 연다
function Doors.openNear(pos: Vector3, radius: number, from: Vector3?): boolean
	local any = false
	for _, d in doors do
		if not d.open and not d.busy and (d.panel.Position - pos).Magnitude <= radius then
			Doors.toggle(d, nil, from or pos)
			any = true
		end
	end
	return any
end

function Doors.clear()
	table.clear(doors)
end

return Doors
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Hiding</string>
          <string name="Source"><![CDATA[--!strict
-- 숨는 곳(맵 문자 L): 챕터마다 모양이 다른 캐비닛·옷장. E(ProximityPrompt)로 들어가고 E 로 나온다.
-- 숨어 있는 동안: 움직일 수 없고 음파를 쏠 수 없으며, 괴물은 보지도 잡지도 못한다.
-- 단, 쫓아오던 괴물이 숨는 모습을 봤다면(Config.Hide.SeenWindow 안에 시야에 있었다면) 그 앞으로 와서 끌어낸다(Monster).
-- 문을 여닫는 소리(Config.Hide.Noise)는 가까운 괴물이 듣는다.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local SoundBus = require(script.Parent.SoundBus)

local Hiding = {}

export type Spot = {
	model: Model,
	center: Vector3, -- 바닥 높이의 안쪽 가운데
	facing: Vector3, -- 문이 향하는 방향(방 안쪽)
	front: Vector3, -- 문 앞(바닥 높이)
	prompt: ProximityPrompt,
	occupant: Player?,
}

local spots: { Spot } = {}
local occupied: { [Player]: Spot } = {}
local hideListeners: { (Player, Spot) -> () } = {}

-- 챕터별 모양
type Style = { w: number, d: number, h: number, doors: number, louvers: boolean, legs: boolean, crown: boolean, tilt: number }
local STYLES: { [string]: Style } = {
	locker = { w = 3.6, d = 3.0, h = 7.6, doors = 1, louvers = true, legs = false, crown = false, tilt = 0 }, -- 지하 시설: 철제 사물함
	tool = { w = 4.6, d = 3.2, h = 7.2, doors = 2, louvers = true, legs = false, crown = false, tilt = 0 }, -- 창고: 공구 캐비닛
	rusty = { w = 3.6, d = 3.0, h = 7.4, doors = 1, louvers = true, legs = false, crown = false, tilt = 0.035 }, -- 하수도: 찌그러진 정비 사물함
	wardrobe = { w = 5.6, d = 3.4, h = 8.0, doors = 2, louvers = true, legs = true, crown = true, tilt = 0 }, -- 병원: 병실 옷장
	closet = { w = 4.8, d = 3.4, h = 8.6, doors = 1, louvers = false, legs = false, crown = true, tilt = 0 }, -- 심층 미로: 낡은 벽장
}
Hiding.Styles = STYLES

-- cf: 바닥 높이, 문이 향하는 쪽이 LookVector
local function buildModel(parent: Instance, cf: CFrame, s: Style): (Model, BasePart)
	local m = Instance.new("Model")
	m.Name = "HideSpot"
	local t = 0.25
	local y0 = if s.legs then 0.5 else 0
	local function box(local_: CFrame, size: Vector3, opts: Kit.Opts?): Part
		return Kit.box(m, cf * CFrame.Angles(0, 0, s.tilt) * local_, size, opts)
	end
	local h, w, d = s.h, s.w, s.d
	-- 몸통: 뒤판, 옆판, 지붕, 바닥판(속은 비어 있다)
	box(CFrame.new(0, y0 + h / 2, d / 2 - t / 2), Vector3.new(w, h, t))
	for _, sx in { -1, 1 } do
		box(CFrame.new(sx * (w / 2 - t / 2), y0 + h / 2, 0), Vector3.new(t, h, d))
	end
	box(CFrame.new(0, y0 + h - t / 2, 0), Vector3.new(w, t, d))
	box(CFrame.new(0, y0 + t / 2, 0), Vector3.new(w, t, d), { collide = false })
	if s.legs then
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				box(CFrame.new(sx * (w / 2 - 0.3), y0 / 2, sz * (d / 2 - 0.3)), Vector3.new(0.3, y0, 0.3), { blocks = false })
			end
		end
	end
	if s.crown then
		box(CFrame.new(0, y0 + h + 0.2, -0.1), Vector3.new(w + 0.4, 0.4, d + 0.2), { blocks = false })
	end
	-- 문(앞쪽, -Z): 틀 + 문짝 + 환기 살(숨은 사람이 틈으로 밖을 본다)
	local front = -d / 2 + t / 2
	local doorW = (w - t * 2) / s.doors
	local doorPart: BasePart? = nil
	for k = 1, s.doors do
		local cx = -w / 2 + t + doorW * (k - 0.5)
		local top = y0 + h - t
		if s.louvers then
			-- 아래쪽 판 + 위쪽 살(사이가 비어 있다)
			local solidH = (top - y0) * 0.55
			local p = box(CFrame.new(cx, y0 + solidH / 2, front), Vector3.new(doorW - 0.06, solidH, t), { name = "HideDoor" })
			doorPart = doorPart or p
			local slats = 7
			local span = top - (y0 + solidH)
			for q = 1, slats do
				local sy = y0 + solidH + span * (q - 0.5) / slats
				box(CFrame.new(cx, sy, front) * CFrame.Angles(math.rad(-25), 0, 0), Vector3.new(doorW - 0.06, span / slats * 0.55, 0.12), { blocks = false })
			end
			-- 문 가장자리 세로 틀
			for _, sx in { -1, 1 } do
				box(CFrame.new(cx + sx * (doorW / 2 - 0.1), y0 + solidH + span / 2, front), Vector3.new(0.2, span, t), { blocks = false })
			end
		else
			-- 판자 문 + 눈높이 틈 하나
			local gapY = y0 + 5.6
			local p = box(CFrame.new(cx, (y0 + gapY - 0.25) / 2, front), Vector3.new(doorW - 0.06, gapY - 0.25 - y0, t), { name = "HideDoor" })
			doorPart = doorPart or p
			box(CFrame.new(cx, (gapY + 0.25 + top) / 2, front), Vector3.new(doorW - 0.06, top - gapY - 0.25, t))
			for q = 1, 3 do
				box(CFrame.new(cx - doorW / 2 + doorW * q / 4, (y0 + top) / 2, front - 0.15), Vector3.new(0.08, top - y0 - 0.4, 0.08), { blocks = false, collide = false })
			end
		end
		-- 손잡이
		local hx = if s.doors == 2 then (if k == 1 then cx + doorW / 2 - 0.35 else cx - doorW / 2 + 0.35) else cx + doorW / 2 - 0.4
		box(CFrame.new(hx, y0 + 3.6, front - 0.25), Vector3.new(0.12, 0.9, 0.18), { blocks = false, collide = false })
	end
	m.Parent = parent
	return m, doorPart :: BasePart
end

local function rootHeight(char: Model): number
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hum and root then
		return hum.HipHeight + root.Size.Y / 2
	end
	return 3
end

local function clear(player: Player)
	local spot = occupied[player]
	if spot then
		spot.occupant = nil
		occupied[player] = nil
	end
	if player:GetAttribute("Hidden") then
		player:SetAttribute("Hidden", false)
	end
end

function Hiding.enter(player: Player, spot: Spot): boolean
	if player:GetAttribute("Status") ~= "Alive" or spot.occupant or occupied[player] then
		return false
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not char or not root then
		return false
	end
	spot.occupant = player
	occupied[player] = spot
	root.AssemblyLinearVelocity = Vector3.zero
	root.Anchored = true
	local p = spot.center + Vector3.new(0, rootHeight(char), 0) - spot.facing * 0.15
	char:PivotTo(CFrame.lookAt(p, p + spot.facing))
	player:SetAttribute("Hidden", true)
	SoundBus.emit(spot.front + Vector3.new(0, 3, 0), Config.Hide.Noise, player, "Hide")
	for _, fn in table.clone(hideListeners) do
		task.spawn(fn, player, spot)
	end
	return true
end

function Hiding.exit(player: Player): boolean
	local spot = occupied[player]
	if not spot then
		return false
	end
	clear(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if char and root then
		local p = spot.front + Vector3.new(0, rootHeight(char), 0)
		char:PivotTo(CFrame.lookAt(p, p + spot.facing))
		root.Anchored = false
	end
	SoundBus.emit(spot.front + Vector3.new(0, 3, 0), Config.Hide.Noise, player, "Hide")
	return true
end

function Hiding.spotOf(player: Player): Spot?
	return occupied[player]
end

function Hiding.all(): { Spot }
	return spots
end

-- 누가 숨었을 때(괴물이 그 모습을 봤는지 판단)
function Hiding.onHide(fn: (Player, Spot) -> ())
	table.insert(hideListeners, fn)
end

-- pos: 타일 가운데 바닥, back: 벽 쪽 방향(단위 벡터)
function Hiding.create(parent: Instance, pos: Vector3, back: Vector3, styleName: string?): Spot
	local s = STYLES[styleName or "locker"] or STYLES.locker
	local facing = -back
	local center = pos + back * (Config.Hide.Tile / 2 - s.d / 2 - 0.1)
	local cf = CFrame.lookAt(center, center + facing) -- (LookVector = -Z = 문 쪽, +Z = 벽 쪽 뒤판)
	local model, door = buildModel(parent, cf, s)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "숨기"
	prompt.ObjectText = ""
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Config.Hide.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("HideSpot", true)
	prompt.Parent = door
	CollectionService:AddTag(model, Config.Tags.HideSpot)
	local spot: Spot = {
		model = model,
		center = center,
		facing = facing,
		front = center + facing * (s.d / 2 + 2.4),
		prompt = prompt,
		occupant = nil,
	}
	table.insert(spots, spot)
	prompt.Triggered:Connect(function(player)
		if occupied[player] == spot then
			Hiding.exit(player)
		elseif not occupied[player] then
			Hiding.enter(player, spot)
		end
	end)
	model.Destroying:Connect(function()
		local i = table.find(spots, spot)
		if i then
			table.remove(spots, i)
		end
		if spot.occupant then
			clear(spot.occupant)
		end
	end)
	return spot
end

-- 죽거나 탈출하거나 새 캐릭터가 생기면 숨은 상태를 푼다
local function watch(p: Player)
	p:GetAttributeChangedSignal("Status"):Connect(function()
		if p:GetAttribute("Status") ~= "Alive" then
			clear(p)
		end
	end)
	p.CharacterAdded:Connect(function()
		clear(p)
	end)
end
for _, p in Players:GetPlayers() do
	watch(p)
end
Players.PlayerAdded:Connect(watch)
Players.PlayerRemoving:Connect(clear)

return Hiding
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[--!strict
-- 로비와 방.
--   · 서버가 시작되면: 예약 서버(방에서 텔레포트로 온 게임 서버)면 바로 게임, 아니면 로비.
--   · 로비: 방 만들기 / 참가 / 나가기 / 시작(방장만) / 친구만(방장만, 켜면 방장의 친구만 참가). 방 목록은 ReplicatedStorage 속성 "Rooms"(JSON), 내 방은 Player 속성 "RoomId".
--   · 시작: 게임에서는 방 사람들을 새 예약 서버로 텔레포트(방마다 따로 플레이).
--           Studio(텔레포트 불가)에서는 이 서버에서 그 방 사람들로 바로 시작하고, 다 깨면 로비로 돌아온다.
-- 클라이언트 요청: Remotes.RoomAction:FireServer(action, arg)  action = "create" | "join"(arg = 방 번호) | "leave" | "start" | "friendsOnly"(arg = true/false)
-- 친구 초대는 클라이언트가 SocialService 초대 창으로 한다(초대받은 친구는 이 로비 서버로 들어온다).

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local Config = require(ReplicatedStorage.Shared.Config)
local Round = require(script.Parent.Round)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RoomAction = Remotes:WaitForChild("RoomAction") :: RemoteEvent
local RoundEvent = Remotes:WaitForChild("RoundEvent") :: RemoteEvent

local Lobby = {}

type Room = { id: number, host: Player, members: { Player }, started: boolean, friendsOnly: boolean }
local rooms: { [number]: Room } = {}
local nextId = 0
Lobby.rooms = rooms

local function publish()
	local list = {}
	for _, r in rooms do
		local names, ids = {}, {}
		for _, m in r.members do
			table.insert(names, m.DisplayName)
			table.insert(ids, m.UserId)
		end
		table.insert(list, { id = r.id, host = r.host.DisplayName, hostId = r.host.UserId, names = names, ids = ids, started = r.started, friendsOnly = r.friendsOnly, max = Config.Lobby.MaxPlayers })
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	ReplicatedStorage:SetAttribute("Rooms", HttpService:JSONEncode(list))
end

local function message(p: Player, text: string)
	RoundEvent:FireClient(p, "RoomMsg", { text = text })
end

local function roomOf(p: Player): Room?
	local id = p:GetAttribute("RoomId")
	return if type(id) == "number" then rooms[id] else nil
end

local function leave(p: Player)
	local r = roomOf(p)
	p:SetAttribute("RoomId", nil)
	if not r then
		return
	end
	local i = table.find(r.members, p)
	if i then
		table.remove(r.members, i)
	end
	if #r.members == 0 then
		rooms[r.id] = nil
	elseif r.host == p then
		r.host = r.members[1] -- 방장이 나가면 다음 사람이 방장
		message(r.host, "방장이 되었습니다")
	end
	publish()
end

local function join(p: Player, r: Room): boolean
	if r.started then
		message(p, "이미 시작한 방입니다")
		return false
	end
	if #r.members >= Config.Lobby.MaxPlayers then
		message(p, "방이 가득 찼습니다")
		return false
	end
	if r.friendsOnly and p ~= r.host then
		local ok, friend = pcall(p.IsFriendsWith, p, r.host.UserId)
		if not (ok and friend) then
			message(p, "방장의 친구만 들어올 수 있는 방입니다")
			return false
		end
	end
	leave(p)
	table.insert(r.members, p)
	p:SetAttribute("RoomId", r.id)
	publish()
	return true
end

-- 이 서버에서 그 방 사람들로 게임을 시작한다(Studio, 또는 텔레포트를 쓸 수 없을 때)
function Lobby.startLocal(r: Room)
	local members = {}
	for _, m in r.members do
		members[m] = true
	end
	-- 로비 맵이 사라지므로 다른 방은 모두 닫는다(그 사람들은 게임이 끝날 때까지 기다린다)
	for id, other in rooms do
		for _, m in other.members do
			m:SetAttribute("RoomId", nil)
			if not members[m] then
				message(m, "다른 방이 이 서버에서 게임 중입니다. 끝나면 로비로 돌아옵니다")
			end
		end
		rooms[id] = nil
	end
	publish()
	Round.members = members
	Round.returnToLobby = true
	Round.stageIndex = 1
	task.spawn(Round.loop)
end

local function startTeleport(r: Room)
	local ok, err = pcall(function()
		local code = TeleportService:ReserveServer(game.PlaceId)
		local options = Instance.new("TeleportOptions")
		options.ReservedServerAccessCode = code
		options:SetTeleportData({ room = r.id })
		TeleportService:TeleportAsync(game.PlaceId, r.members, options)
	end)
	if not ok then
		r.started = false
		publish()
		for _, m in r.members do
			message(m, "시작하지 못했습니다(텔레포트 실패). 다시 눌러 주세요")
		end
		warn("[Lobby] teleport failed: " .. tostring(err))
	end
end

local function start(p: Player)
	local r = roomOf(p)
	if not r then
		return
	end
	if r.host ~= p then
		message(p, "방장만 시작할 수 있습니다")
		return
	end
	if r.started then
		return
	end
	if #r.members < Config.Lobby.MinPlayers then
		message(p, string.format("%d명 이상이어야 시작합니다", Config.Lobby.MinPlayers))
		return
	end
	r.started = true
	publish()
	for _, m in r.members do
		RoundEvent:FireClient(m, "RoomStarting", { id = r.id })
	end
	if Lobby.localStart() then
		Lobby.startLocal(r)
	else
		startTeleport(r)
	end
end

-- 텔레포트 대신 이 서버에서 시작하는가(Studio 에서는 텔레포트가 안 된다)
function Lobby.localStart(): boolean
	return RunService:IsStudio() or Config.Lobby.LocalStart == true
end

-- 방에서 텔레포트로 온 게임 서버인가(예약 서버)
function Lobby.isGameServer(): boolean
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
end

function Lobby.act(p: Player, action: any, arg: any)
	if Round.state ~= "Lobby" or type(action) ~= "string" then
		return
	end
	if action == "create" then
		if roomOf(p) then
			return
		end
		nextId += 1
		local r: Room = { id = nextId, host = p, members = {}, started = false, friendsOnly = false }
		rooms[r.id] = r
		join(p, r)
	elseif action == "join" then
		local r = if type(arg) == "number" then rooms[arg] else nil
		if r and roomOf(p) ~= r then
			join(p, r)
		end
	elseif action == "leave" then
		leave(p)
	elseif action == "start" then
		start(p)
	elseif action == "friendsOnly" then
		local r = roomOf(p)
		if r and r.host == p then
			r.friendsOnly = arg == true
			publish()
		end
	end
end

RoomAction.OnServerEvent:Connect(Lobby.act)
Players.PlayerRemoving:Connect(leave)

-- 서버 시작: 첫 플레이어가 들어오면 모드를 정한다(테스트는 ReplicatedStorage 속성 ForceMode 로 고른다)
function Lobby.boot()
	while #Players:GetPlayers() == 0 do
		task.wait(0.2)
	end
	local force = ReplicatedStorage:GetAttribute("ForceMode")
	local mode = if force == "Game" or force == "Lobby" then force elseif Lobby.isGameServer() then "Game" else "Lobby"
	if mode == "Game" then
		ReplicatedStorage:SetAttribute("Mode", "Game")
		Round.loop()
	else
		publish()
		Round.enterLobby()
	end
end

publish()
return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="20">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- 서버 진입점(ServerScriptService.Server.Main)
--   · 완전한 어둠 조명 강제
--   · 음파 발사 검증(발사 간격·생존 여부, 위치는 서버가 캐릭터 머리에서 정한다) → 다른 클라이언트에 전달 + 괴물에게 소리
--   · 이동 모드(걷기/달리기/웅크리기) 요청 처리
--   · 로비(방) 또는 게임 시작(Lobby.boot)

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local SoundBus = require(script.Parent.SoundBus)
local Round = require(script.Parent.Round)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SonarFire = Remotes:WaitForChild("SonarFire") :: RemoteEvent
local SonarPulse = Remotes:WaitForChild("SonarPulse") :: RemoteEvent
local SetMoveMode = Remotes:WaitForChild("SetMoveMode") :: RemoteEvent

-- ── 어둠: 환경광·하늘빛·반사 없음 ──
Lighting.Brightness = 0
Lighting.Ambient = Color3.new(0, 0, 0)
Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
Lighting.EnvironmentDiffuseScale = 0
Lighting.EnvironmentSpecularScale = 0
Lighting.ClockTime = 0
Lighting.GlobalShadows = false
Lighting.FogEnd = 100000
for _, d in Lighting:GetChildren() do
	if d:IsA("Atmosphere") or d:IsA("Clouds") then
		d:Destroy()
	end
end

-- ── 음파 ──
local lastPulse: { [Player]: number } = {}
local accepted: { [Player]: number } = {}
local Sonar = {}
Sonar.accepted = accepted

SonarFire.OnServerEvent:Connect(function(player: Player)
	if player:GetAttribute("Status") ~= "Alive" or player:GetAttribute("Hidden") then
		return
	end
	local char = player.Character
	local head = char and (char:FindFirstChild("Head") :: BasePart?)
	if not head then
		return
	end
	local now = os.clock()
	local last = lastPulse[player] or -math.huge
	if now - last < Config.Sonar.Cooldown - Config.Sonar.ServerTolerance then
		return -- 간격 위반: 무시(시각 효과는 그 클라이언트에만 있고 괴물·다른 플레이어에게는 없음)
	end
	lastPulse[player] = now
	accepted[player] = (accepted[player] or 0) + 1
	local origin = head.Position
	for _, other in Players:GetPlayers() do
		if other ~= player then
			SonarPulse:FireClient(other, player.UserId, origin)
		end
	end
	SoundBus.emit(origin, Config.Noise.Sonar, player, "Sonar")
end)

-- ── 이동 모드(소리·시점 표시용 속성. 실제 소음 크기는 서버가 속도로 판정) ──
local MODES = { Walk = Config.Move.Walk, Run = Config.Move.Run, Crouch = Config.Move.Crouch }
SetMoveMode.OnServerEvent:Connect(function(player: Player, mode: any)
	if type(mode) ~= "string" or not MODES[mode] then
		return
	end
	local char = player.Character
	if not char or player:GetAttribute("Status") ~= "Alive" then
		return
	end
	char:SetAttribute("MoveMode", mode)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = MODES[mode]
	end
end)

Players.PlayerRemoving:Connect(function(p)
	lastPulse[p] = nil
	accepted[p] = nil
end)

-- 테스트 하네스가 읽는 값
_G.SonarMaze = { Round = Round, Sonar = Sonar, SoundBus = SoundBus }

-- 로비(방 만들기) 또는 게임 서버로 시작
local Lobby = require(script.Parent.Lobby)
task.spawn(Lobby.boot)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">MapKit</string>
          <string name="Source"><![CDATA[--!strict
-- 모듈형 구조물 키트: 모든 스테이지가 같은 부품으로 맵을 짓는다.
-- 모든 구조물은 검은색 무광, 조명 없음. SonarRenderable 태그가 붙어 음파 윤곽선 대상이 된다.
-- 원통(파이프·난간)은 Shape = Cylinder 그대로라서 음파 렌더러가 원통 모양(끝 원 + 실루엣)으로 그린다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Kit = {}
local TAG = Config.Tags.Renderable
local BLACK = Color3.new(0, 0, 0)

export type Opts = {
	collide: boolean?,
	tag: boolean?, -- false 면 음파 대상 아님(보이지 않는 충돌 경사로 등)
	invisible: boolean?,
	shape: string?, -- SonarShape 속성
	axis: string?, -- SonarEdgeAxis 속성
	rings: number?,
	blocks: boolean?, -- SonarBlocks: 음파·소리 전파를 막는가(nil 이면 크기로 판단)
	name: string?,
}

local function base(p: BasePart, parent: Instance, opts: Opts?)
	local o = opts or {}
	p.Anchored = true
	p.Color = BLACK
	p.Material = Enum.Material.SmoothPlastic
	p.Reflectance = 0
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = if o.collide == nil then true else o.collide
	p.CanTouch = false
	if o.invisible then
		p.Transparency = 1
	end
	if o.shape then
		p:SetAttribute("SonarShape", o.shape)
	end
	if o.axis then
		p:SetAttribute("SonarEdgeAxis", o.axis)
	end
	if o.rings then
		p:SetAttribute("SonarRings", o.rings)
	end
	if o.blocks ~= nil then
		p:SetAttribute("SonarBlocks", o.blocks)
	end
	if o.name then
		p.Name = o.name
	end
	if o.tag ~= false and not o.invisible then
		CollectionService:AddTag(p, TAG)
	end
	p.Parent = parent
end

function Kit.box(parent: Instance, cf: CFrame, size: Vector3, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	base(p, parent, opts)
	return p
end

-- 두 모서리 좌표(최소·최대)로 축 정렬 상자
function Kit.span(parent: Instance, lo: Vector3, hi: Vector3, opts: Opts?): Part
	local a = Vector3.new(math.min(lo.X, hi.X), math.min(lo.Y, hi.Y), math.min(lo.Z, hi.Z))
	local b = Vector3.new(math.max(lo.X, hi.X), math.max(lo.Y, hi.Y), math.max(lo.Z, hi.Z))
	return Kit.box(parent, CFrame.new((a + b) / 2), b - a, opts)
end

function Kit.wedge(parent: Instance, cf: CFrame, size: Vector3, opts: Opts?): WedgePart
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = cf
	base(p, parent, opts)
	return p
end

-- a 에서 b 까지 원통(반지름 r)
function Kit.cylinder(parent: Instance, a: Vector3, b: Vector3, r: number, opts: Opts?): Part
	local d = b - a
	local len = d.Magnitude
	local dir = d / len
	local up = if math.abs(dir.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(len, r * 2, r * 2)
	p.CFrame = CFrame.fromMatrix((a + b) / 2, dir, dir:Cross(up).Unit:Cross(dir))
	base(p, parent, opts)
	return p
end

function Kit.ball(parent: Instance, c: Vector3, r: number, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(r * 2, r * 2, r * 2)
	p.CFrame = CFrame.new(c)
	base(p, parent, opts)
	return p
end

-- 배관: 본체 + 양 끝 플랜지(+ 볼트). flangeEvery 마다 중간 플랜지.
function Kit.pipe(parent: Instance, a: Vector3, b: Vector3, r: number, flangeAt: { number }?, bolts: boolean?)
	local m = Instance.new("Model")
	m.Name = "Pipe"
	m.Parent = parent
	Kit.cylinder(m, a, b, r, { blocks = r >= 0.9 })
	local dir = (b - a).Unit
	local len = (b - a).Magnitude
	for _, t in flangeAt or { 0, 1 } do
		local c = a + dir * (math.clamp(t * len, 0.2, len - 0.2))
		local fr = r * 1.35 + 0.08
		local fl = Kit.cylinder(m, c - dir * 0.18, c + dir * 0.18, fr, { blocks = false })
		if bolts and fr >= 0.6 then
			-- 볼트: 플랜지 둘레의 작은 원통 6개
			local up = if math.abs(dir.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis
			local u = dir:Cross(up).Unit
			local w = dir:Cross(u).Unit
			for i = 0, 5 do
				local ang = i / 6 * math.pi * 2 + 0.3
				local bp = c + (u * math.cos(ang) + w * math.sin(ang)) * (fr - 0.17)
				Kit.cylinder(m, bp - dir * 0.3, bp + dir * 0.3, 0.09, { blocks = false, collide = false })
			end
		end
		local _ = fl
	end
	return m
end

-- 난간: a → b (바닥 높이 기준), 기둥 간격 step
function Kit.railing(parent: Instance, a: Vector3, b: Vector3, height: number?, step: number?)
	local h = height or 3.3
	local st = step or 2.6
	local m = Instance.new("Model")
	m.Name = "Railing"
	m.Parent = parent
	local d = b - a
	local len = d.Magnitude
	local n = math.max(1, math.floor(len / st + 0.5))
	for i = 0, n do
		local p = a + d * (i / n)
		Kit.cylinder(m, p, p + Vector3.new(0, h, 0), 0.11, { blocks = false })
	end
	local up = Vector3.new(0, h, 0)
	Kit.cylinder(m, a + up, b + up, 0.13, { blocks = false })
	Kit.cylinder(m, a + up * 0.5, b + up * 0.5, 0.09, { blocks = false })
	-- 발끝 막이(얇은 판)
	local dir = d.Unit
	local cf = CFrame.lookAt((a + b) / 2 + Vector3.new(0, 0.2, 0), (a + b) / 2 + Vector3.new(0, 0.2, 0) + dir)
	Kit.box(m, cf, Vector3.new(0.1, 0.4, len), { blocks = false, collide = false })
	-- 보이지 않는 충돌 벽(떨어지지 않게)
	Kit.box(m, CFrame.lookAt((a + b) / 2 + up / 2, (a + b) / 2 + up / 2 + dir), Vector3.new(0.3, h, len), { invisible = true, tag = false })
	return m
end

-- 계단: bottomCenter(아래 첫 계단 앞 가운데, 바닥 높이) 에서 forward 방향으로 rise 만큼 올라간다.
-- 보이는 계단 판은 충돌 없음, 걷는 면은 보이지 않는 경사로.
function Kit.stairs(parent: Instance, bottomCenter: Vector3, forward: Vector3, width: number, rise: number, run: number, steps: number)
	local m = Instance.new("Model")
	m.Name = "Stairs"
	m.Parent = parent
	local f = Vector3.new(forward.X, 0, forward.Z).Unit
	local stepH = rise / steps
	local stepD = run / steps
	for i = 0, steps - 1 do
		local top = (i + 1) * stepH
		local c = bottomCenter + f * (stepD * (i + 0.5)) + Vector3.new(0, top / 2, 0)
		Kit.box(m, CFrame.lookAt(c, c + f), Vector3.new(width, top, stepD), { collide = false, blocks = i >= steps / 2 })
	end
	-- 경사로(쐐기): 경사가 forward 방향으로 올라가도록 뒤(+Z)를 forward 쪽으로
	local mid = bottomCenter + f * (run / 2) + Vector3.new(0, rise / 2, 0)
	Kit.wedge(m, CFrame.lookAt(mid, mid - f), Vector3.new(width, rise, run), { invisible = true, tag = false })
	return m
end

-- 아치 리브: center = 바닥 가운데, right = 가로 방향, 개구부 폭 2*inner, 스프링 높이 spring
-- 벽 사이에 걸치는 리브(기둥 + 반원 아치) 와 그 위 막힌 벽(header).
function Kit.archPortal(parent: Instance, center: Vector3, right: Vector3, span: number, spring: number, ceiling: number, ribDepth: number?)
	local m = Instance.new("Model")
	m.Name = "Arch"
	m.Parent = parent
	local depth = ribDepth or 1.4
	local r = right.Unit
	local fwd = r:Cross(Vector3.yAxis).Unit
	local half = span / 2
	local pier = 0.7
	local inner = half - pier
	local ring = 0.7
	local outer = inner + ring
	local basis = CFrame.fromMatrix(center, r, Vector3.yAxis) -- X = 가로, Z = 진행 방향
	-- 기둥(좌우)
	for _, s in { -1, 1 } do
		local x = s * (half - pier / 2)
		Kit.box(m, basis * CFrame.new(x, spring / 2, 0), Vector3.new(pier, spring, depth))
	end
	-- 반원 아치 조각
	local segs = 9
	for i = 0, segs - 1 do
		local a0 = math.pi * (i / segs)
		local a1 = math.pi * ((i + 1) / segs)
		local am = (a0 + a1) / 2
		local rm = (inner + outer) / 2
		local chord = 2 * outer * math.sin((a1 - a0) / 2)
		local px, py = math.cos(am) * rm, spring + math.sin(am) * rm
		local seg = basis * CFrame.new(px, py, 0) * CFrame.Angles(0, 0, am + math.pi / 2)
		Kit.box(m, seg, Vector3.new(chord, ring, depth), { axis = "X" })
	end
	-- 아치 위 막힌 벽(리브보다 얇게 → 리브가 튀어나와 윤곽이 보인다), 선 없는 채움
	local wallD = depth * 0.55
	local topY = spring + outer
	Kit.box(m, basis * CFrame.new(0, (topY + ceiling) / 2, 0), Vector3.new(span, ceiling - topY, wallD))
	-- 아치 옆 삼각 부분(스팬드럴)을 세로 띠로 채움
	local cols = 6
	for i = 0, cols - 1 do
		for _, s in { -1, 1 } do
			local x0 = (i / cols) * outer
			local x1 = ((i + 1) / cols) * outer
			-- (띠 바닥은 띠 구간에서 가장 낮은 아치 바깥 높이: 구멍 없이 아치 조각과 겹친다)
			local xm = math.min(x1, outer)
			local yArc = spring + math.sqrt(math.max(0, outer * outer - xm * xm)) - 0.05
			local h = topY - yArc
			if h > 0.05 then
				local cx = s * (x0 + x1) / 2
				Kit.box(m, basis * CFrame.new(cx, yArc + h / 2, 0), Vector3.new(x1 - x0 + 0.02, h, wallD), { shape = "None" })
			end
		end
		local _ = i
	end
	for _, s in { -1, 1 } do
		-- 바깥 원과 기둥 사이
		local x0, x1 = outer, half
		if x1 - x0 > 0.05 then
			Kit.box(m, basis * CFrame.new(s * (x0 + x1) / 2, (spring + topY) / 2, 0), Vector3.new(x1 - x0, topY - spring, wallD), { shape = "None" })
		end
	end
	return m
end

-- 상자(나무 상자 느낌: 모서리 + 가로 띠)
function Kit.crate(parent: Instance, bottom: Vector3, size: Vector3, yaw: number?)
	local cf = CFrame.new(bottom + Vector3.new(0, size.Y / 2, 0)) * CFrame.Angles(0, yaw or 0, 0)
	local b = Kit.box(parent, cf, size, { name = "Crate" })
	-- 가운데 띠
	Kit.box(parent, cf, Vector3.new(size.X + 0.12, 0.3, size.Z + 0.12), { blocks = false })
	return b
end

-- 글자(EXIT 표지): 막대 조합. origin = 글자 왼쪽 아래, right/up = 벽면 방향, 글자 높이 h
function Kit.letter(parent: Instance, ch: string, origin: Vector3, right: Vector3, out: Vector3, h: number)
	local w = h * 0.62
	local t = h * 0.14
	local depth = 0.35
	local up = Vector3.yAxis
	local function bar(x0: number, y0: number, x1: number, y1: number)
		local a = origin + right * x0 + up * y0 + out * (depth / 2)
		local b = origin + right * x1 + up * y1 + out * (depth / 2)
		local d = b - a
		local len = d.Magnitude
		local cf = CFrame.fromMatrix((a + b) / 2, d.Unit, out:Cross(d.Unit).Unit)
		Kit.box(parent, cf, Vector3.new(len + t, t, depth), { blocks = false, collide = false })
	end
	local ht = t / 2
	if ch == "E" then
		bar(ht, ht, ht, h - ht)
		bar(ht, h - ht, w - ht, h - ht)
		bar(ht, h / 2, w * 0.8 - ht, h / 2)
		bar(ht, ht, w - ht, ht)
	elseif ch == "X" then
		bar(ht, ht, w - ht, h - ht)
		bar(ht, h - ht, w - ht, ht)
	elseif ch == "I" then
		bar(w / 2, ht, w / 2, h - ht)
	elseif ch == "T" then
		bar(ht, h - ht, w - ht, h - ht)
		bar(w / 2, ht, w / 2, h - ht)
	end
	return w
end

function Kit.word(parent: Instance, text: string, center: Vector3, right: Vector3, out: Vector3, h: number)
	local gap = h * 0.3
	local w = h * 0.62
	local total = #text * w + (#text - 1) * gap
	local x = -total / 2
	for i = 1, #text do
		local ch = text:sub(i, i)
		Kit.letter(parent, ch, center + right * x - Vector3.new(0, h / 2, 0), right, out, h)
		x += w + gap
	end
end

return Kit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Monster</string>
          <string name="Source"><![CDATA[--!strict
-- 괴물: 모델 생성 + AI(배회 → 소리 감지 → 수색 → 추격 → 추격 해제).
-- 보이지 않는 검은 몸. 음파가 닿으면 클라이언트가 몸의 윤곽선을 그린다(SonarDynamic).
-- 이동은 PathfindingService 경로만 따라가므로 벽을 통과하지 않는다. 막히면 경로를 다시 계산하고, 그래도 안 되면 목표를 바꾼다.

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local Doors = require(script.Parent.Doors)
local SoundBus = require(script.Parent.SoundBus)
local Hiding = require(script.Parent.Hiding)

local MC = Config.Monster

local Monster = {}
Monster.__index = Monster

export type State = "Wander" | "Alert" | "Investigate" | "Search" | "Chase"

-- ── 챕터별 머리 도형: 1 삼각형 · 2 사각형 · 3 원 · 4 별 · 5 육각형 (그 이후는 처음부터 반복) ──
-- cy: 머리 중심 높이, eye = {x, y, 반지름}, mouth = {반폭, 윗입술 y, 깊이}, 좌표는 머리 중심 기준
local HeadSpec: { { cy: number, eye: { number }, mouth: { number }, verts: { { number } }?, circle: number?, star: { number }?, hex: number? } } = {
	{ cy = 4.5, eye = { 0.2, 0.0, 0.08 }, mouth = { 0.5, -0.25, 0.35 }, verts = { { -0.85, -0.75 }, { 0.85, -0.75 }, { 0, 0.75 } } },
	{ cy = 4.4, eye = { 0.28, 0.2, 0.09 }, mouth = { 0.5, -0.1, 0.4 }, verts = { { -0.8, -0.65 }, { 0.8, -0.65 }, { 0.8, 0.65 }, { -0.8, 0.65 } } },
	{ cy = 4.35, eye = { 0.22, 0.12, 0.09 }, mouth = { 0.45, -0.2, 0.4 }, circle = 0.6 },
	{ cy = 4.55, eye = { 0.16, 0.12, 0.065 }, mouth = { 0.3, -0.12, 0.25 }, star = { 1.0, 0.48 } },
	{ cy = 4.35, eye = { 0.26, 0.15, 0.09 }, mouth = { 0.5, -0.12, 0.38 }, hex = 0.72 },
}

-- ── 모델 ──
local function buildModel(cf: CFrame, stage: number): Model
	local model = Instance.new("Model")
	model.Name = "Monster"
	model:SetAttribute(Config.Tags.Dynamic, true)
	model:SetAttribute("State", "Wander")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1.2)
	root.Transparency = 1
	root.CanCollide = true
	root.CanTouch = false
	root.CFrame = cf
	root.Parent = model
	model.PrimaryPart = root

	local function limb(p: BasePart)
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
	end
	local function at(v: Vector3): Vector3
		return cf:PointToWorldSpace(v)
	end
	-- 몸통(앞으로 숙인 마른 몸), 머리, 긴 팔, 다리. 루트 가운데 기준 바닥은 y = -5
	local parts: { BasePart } = {}
	-- 팔·다리는 어깨·엉덩이 관절(Motor6D)에 붙여 걸을 때 흔든다(Monster.animate)
	local group: string? = nil
	local groupParts: { [string]: { BasePart } } = {}
	local function add(p: BasePart)
		table.insert(parts, p)
		if group then
			local l = groupParts[group] or {}
			groupParts[group] = l
			table.insert(l, p)
		end
	end
	-- 레퍼런스(손그림): 작은 머리 + 짧은 목 + 좁고 긴 몸통 + 바깥으로 벌어진 긴 팔(발톱 5개) + 길고 가는 다리. 바닥 y = -5, 앞 = -Z
	local function seg(a: Vector3, b: Vector3, r: number)
		-- 음파에는 한 획으로: 막대는 가운데 선 하나(Line), 얇은 원판은 원 하나(Disc)
		local shape = if (b - a).Magnitude > r * 4 then "Line" else "Disc"
		add(Kit.cylinder(model, at(a), at(b), r, { shape = shape }))
	end
	-- 손으로 그린 듯 흔들리는 선(결정적 난수라 매번 같은 모양)
	local seed = 0
	local function rnd(): number
		seed += 1
		local x = math.sin(seed * 12.9898) * 43758.5453
		return x - math.floor(x) - 0.5
	end
	local function ink(a: Vector3, b: Vector3, r: number)
		local d = b - a
		local len = d.Magnitude
		local dir = d.Unit
		local k = math.min(1, len / 2) -- 짧은 선일수록 덜 삐져나오게
		a = a - dir * (0.05 + 0.08 * (rnd() + 0.5)) * k
		b = b + dir * (0.05 + 0.08 * (rnd() + 0.5)) * k
		local n = math.max(2, math.floor(len / 1.6))
		local prev = a
		for i = 1, n do
			local p = a:Lerp(b, i / n)
			if i < n then
				p += Vector3.new(rnd() * 0.07, rnd() * 0.04, rnd() * 0.07)
			end
			seg(prev, p, r)
			prev = p
		end
	end
	local V3 = Vector3.new
	-- 몸통: 사다리꼴 네 선 + 어깨에서 가슴으로 겹치는 두 선
	ink(V3(-0.9, 2.6, -0.35), V3(-0.65, 0.5, 0), 0.03)
	ink(V3(0.9, 2.6, -0.35), V3(0.65, 0.5, 0), 0.03)
	ink(V3(-0.9, 2.6, -0.35), V3(0.9, 2.6, -0.35), 0.03)
	ink(V3(-0.65, 0.5, 0), V3(0.65, 0.5, 0), 0.03)
	ink(V3(-0.9, 2.5, -0.35), V3(-0.15, 1.5, -0.1), 0.025)
	ink(V3(0.9, 2.5, -0.35), V3(0.15, 1.5, -0.1), 0.025)
	-- 짧은 목
	ink(V3(-0.2, 3.75, -0.65), V3(-0.3, 2.6, -0.4), 0.03)
	ink(V3(0.2, 3.75, -0.65), V3(0.3, 2.6, -0.4), 0.03)
	-- 머리(챕터별 도형): 눈 = 작은 동그라미 + 점, 입 = 가로로 넓고 세로 이빨선
	local spec = HeadSpec[((stage - 1) % #HeadSpec) + 1]
	local cy, zf = spec.cy, -1.0
	local function P(x: number, y: number, z: number): Vector3
		return Vector3.new(x, cy + y, z)
	end
	local verts: { { number } } = spec.verts or {}
	if spec.star then
		for i = 0, 9 do
			local r = if i % 2 == 0 then spec.star[1] else spec.star[2]
			local ang = math.pi / 2 + i * math.pi / 5
			table.insert(verts, { r * math.cos(ang), r * math.sin(ang) })
		end
	elseif spec.hex then
		for i = 0, 5 do
			local ang = i * math.pi / 3
			table.insert(verts, { spec.hex * math.cos(ang), spec.hex * math.sin(ang) })
		end
	end
	if spec.circle then
		seg(P(0, 0, zf), P(0, 0, zf + 0.06), spec.circle)
	else
		for i, a in verts do
			local b = verts[i % #verts + 1]
			ink(P(a[1], a[2], zf), P(b[1], b[2], zf), 0.03)
		end
	end
	local ex, ey, er = spec.eye[1], spec.eye[2], spec.eye[3]
	for _, s in { -1, 1 } do
		seg(P(s * ex, ey, zf - 0.03), P(s * ex, ey, zf - 0.06), er)
		seg(P(s * ex, ey, zf - 0.06), P(s * ex, ey, zf - 0.09), 0.025)
	end
	local mw, my, mh = spec.mouth[1], spec.mouth[2], spec.mouth[3]
	local function arcY(x: number): number
		return my - mh * (1 - (x / mw) ^ 2) * 0.35 - mh * 0.65
	end
	local zm = zf - 0.04
	seg(P(-mw, my, zm), P(mw, my, zm), 0.025)
	seg(P(-mw, my, zm), P(-mw * 0.9, arcY(-mw * 0.9), zm), 0.025)
	seg(P(mw, my, zm), P(mw * 0.9, arcY(mw * 0.9), zm), 0.025)
	for i = 0, 5 do
		local x0 = -mw * 0.9 + 1.8 * mw * i / 6
		local x1 = -mw * 0.9 + 1.8 * mw * (i + 1) / 6
		seg(P(x0, arcY(x0), zm), P(x1, arcY(x1), zm), 0.025)
	end
	for i = 1, 8 do
		local x = -mw * 0.9 + 1.8 * mw * i / 9
		seg(P(x, my, zm), P(x, arcY(x), zm), 0.018)
	end
	for _, s in { -1, 1 } do
		-- 긴 팔: 한 줄, 어깨 → 팔꿈치 → 손목, V자로 벌어짐
		group = "Arm" .. s
		local sh = V3(0.9 * s, 2.55, -0.35)
		local el = V3(1.55 * s, 0.15, -0.85)
		local wr = V3(2.1 * s, -2.1, -1.0)
		ink(sh, el, 0.03)
		ink(el, wr, 0.03)
		-- 부채꼴로 퍼지는 긴 발톱 5개
		for k = -2, 2 do
			local mid = wr + V3(k * 0.16 + 0.05 * s, -0.8, -0.12)
			local tip = wr + V3(k * 0.3 + 0.12 * s, -1.55, -0.35 + 0.05 * k)
			seg(wr + V3(k * 0.07, 0, 0), mid, 0.018)
			seg(mid, tip, 0.014)
		end
		-- 길고 곧은 다리: 한 줄 + 무릎 꺾임, 작은 발
		group = "Leg" .. s
		for _, e in { 0.4 } do
			local x0, xk, xa = e * s, (e + 0.06) * s, (e + 0.08) * s
			ink(V3(x0, 0.5, 0), V3(xk, -2.3, -0.2), 0.03)
			ink(V3(xk, -2.3, -0.2), V3(xa, -4.75, 0.1), 0.03)
		end
		local xc = 0.48 * s
		ink(V3(xc, -4.75, 0.1), V3(xc, -4.97, -0.8), 0.03)
		ink(V3(xc, -4.97, 0.35), V3(xc, -4.97, -0.8), 0.03)
		ink(V3(xc, -4.75, 0.1), V3(xc, -4.97, 0.35), 0.03)
	end
	group = nil
	local JOINTS: { [string]: Vector3 } = {
		["Arm-1"] = Vector3.new(-0.9, 2.55, -0.35),
		["Arm1"] = Vector3.new(0.9, 2.55, -0.35),
		["Leg-1"] = Vector3.new(-0.4, 0.5, 0),
		["Leg1"] = Vector3.new(0.4, 0.5, 0),
	}
	local grouped: { [BasePart]: boolean } = {}
	for name, list in groupParts do
		local off = JOINTS[name]
		if off then
			local pv = Instance.new("Part")
			pv.Name = "Pivot" .. name
			pv.Size = Vector3.new(0.2, 0.2, 0.2)
			pv.Transparency = 1
			pv.CanCollide = false
			pv.CanQuery = false
			pv.CanTouch = false
			pv.Massless = true
			pv.CFrame = cf * CFrame.new(off)
			pv.Parent = model
			local motor = Instance.new("Motor6D")
			motor.Name = "Joint" .. name
			motor.Part0 = root
			motor.Part1 = pv
			motor.C0 = CFrame.new(off)
			motor.C1 = CFrame.identity
			motor.Parent = root
			for _, p in list do
				p.Anchored = false
				p.CanCollide = false
				p.CanQuery = false
				p.Massless = true
				local w = Instance.new("WeldConstraint")
				w.Part0 = pv
				w.Part1 = p
				w.Parent = p
				grouped[p] = true
			end
		end
	end
	for _, p in parts do
		p.Name = "Body"
		-- 몸은 완전히 투명: 음파를 맞을 때만 선으로 드러난다(검은 몸이 선을 가려 위치가 드러나지 않게)
		p.Transparency = 1
		p.CastShadow = false
		if not grouped[p] then
			limb(p)
		end
	end
	-- 장애물 판정과 무관하게(검은 몸은 SonarRenderable 태그로 음파에만 드러난다)
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 4.0
	hum.WalkSpeed = MC.WanderSpeed
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	hum.AutoJumpEnabled = false
	hum.UseJumpPower = true
	hum.JumpPower = 0
	hum.Parent = model
	for _, st in { Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.Dead } do
		hum:SetStateEnabled(st, false)
	end
	CollectionService:AddTag(model, Config.Tags.Monster)
	return model
end

-- ── AI ──
export type Monster = typeof(setmetatable({} :: {
	model: Model,
	root: BasePart,
	hum: Humanoid,
	state: State,
	nodes: { Vector3 },
	waypoints: { PathWaypoint },
	wp: number,
	goal: Vector3?,
	target: Player?,
	lastSeen: number,
	lastKnown: Vector3?,
	alertUntil: number,
	searchCenter: Vector3?,
	searchUntil: number,
	lastRepath: number,
	progressPos: Vector3,
	progressT: number,
	stuck: number,
	alive: boolean,
	path: Path,
	rayParams: RaycastParams,
	onCatch: (Player, Monster) -> (),
	log: { string },
	geometry: Instance,
	startAt: number,
	stateChanged: number,
	route: ((Vector3, Vector3, boolean?) -> { Vector3 }?)?,
	legGoal: Vector3?,
	pullSpot: Vector3?, -- 쫓던 플레이어가 숨는 것을 봤다: 그 숨는 곳 앞
	lastHunt: number,
	joints: { { motor: Motor6D, base: CFrame, offset: number, amp: number } },
	phase: number,
	animT: number,
}, Monster))

function Monster.new(parent: Instance, spawnPos: Vector3, nodes: { Vector3 }, geometry: Instance, onCatch: (Player, any) -> (), stage: number?): Monster
	local model = buildModel(CFrame.new(spawnPos + Vector3.new(0, 2.2, 0)), stage or 1)
	model.Parent = parent
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = { geometry }
	rp.RespectCanCollide = true
	local self = setmetatable({
		model = model,
		root = root,
		hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid,
		state = "Wander" :: State,
		nodes = nodes,
		waypoints = {},
		wp = 1,
		goal = nil,
		target = nil,
		lastSeen = 0,
		lastKnown = nil,
		alertUntil = 0,
		searchCenter = nil,
		searchUntil = 0,
		lastRepath = 0,
		progressPos = root.Position,
		progressT = os.clock(),
		stuck = 0,
		alive = true,
		path = PathfindingService:CreatePath({
			AgentRadius = MC.AgentRadius,
			AgentHeight = MC.AgentHeight,
			AgentCanJump = false,
			AgentCanClimb = false,
			WaypointSpacing = 4,
		}),
		rayParams = rp,
		onCatch = onCatch,
		log = {},
		geometry = geometry,
		startAt = os.clock() + MC.StartDelay,
		stateChanged = os.clock(),
		route = nil,
		legGoal = nil,
		pullSpot = nil,
		lastHunt = os.clock(),
		joints = {},
		phase = 0,
		animT = 0,
	}, Monster)
	for _, name in { "Leg-1", "Leg1", "Arm-1", "Arm1" } do
		local motor = root:FindFirstChild("Joint" .. name) :: Motor6D?
		if motor then
			local isLeg = name:sub(1, 3) == "Leg"
			local left = name:find("-1") ~= nil
			-- 다리끼리, 팔끼리 반대로, 팔은 같은 쪽 다리와 반대로
			table.insert(self.joints, { motor = motor, base = motor.C0, offset = if (isLeg == left) then 0 else math.pi, amp = if isLeg then 0.5 else 0.38 })
		end
	end
	return self
end

-- 걷는 모습: 속도만큼 팔다리를 흔든다(초당 10번만 바꿔 네트워크 부담을 줄인다. 음파는 순간 모습만 보여 준다)
function Monster.animate(self: Monster, dt: number)
	self.animT += dt
	if self.animT < 0.1 or #self.joints == 0 then
		return
	end
	local step = self.animT
	self.animT = 0
	local v = self.root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	self.phase = (self.phase + step * speed * 0.55) % (math.pi * 2)
	local amt = math.clamp(speed / 3, 0, 1) -- (느리게 걸어도 팔다리가 크게 흔들려야 음파에 걷는 모습이 보인다)
	for _, j in self.joints do
		j.motor.C0 = j.base * CFrame.Angles(math.sin(self.phase + j.offset) * j.amp * amt, 0, 0)
	end
end

function Monster.note(self: Monster, s: string)
	table.insert(self.log, string.format("%.1f %s", os.clock(), s))
	if #self.log > 40 then
		table.remove(self.log, 1)
	end
end

function Monster.setState(self: Monster, s: State)
	if self.state ~= s then
		self:note(self.state .. "->" .. s)
		self.state = s
		self.stateChanged = os.clock()
		self.model:SetAttribute("State", s)
	end
	local speed = MC.WanderSpeed
	if s == "Investigate" or s == "Search" then
		speed = MC.InvestigateSpeed
	elseif s == "Chase" then
		speed = MC.ChaseSpeed
	elseif s == "Alert" then
		speed = 0
	end
	self.hum.WalkSpeed = speed
end

-- (테스트용) 경로 계산 횟수·시간, tick 횟수
Monster.stats = { pathCalls = 0, pathWall = 0, ticks = 0 }

local function feet(p: Vector3): Vector3
	return p - Vector3.new(0, 4.5, 0)
end

-- 경로 계산(양보 있음). 성공하면 true
function Monster.pathTo(self: Monster, rawGoal: Vector3): boolean
	self.lastRepath = os.clock()
	-- 목표를 바닥 높이로 내린다(소리 위치는 머리 높이일 수 있다)
	local goal = rawGoal
	local down = workspace:Raycast(rawGoal + Vector3.new(0, 1, 0), Vector3.new(0, -14, 0), self.rayParams)
	if down then
		goal = down.Position + Vector3.new(0, 0.5, 0)
	end
	self.legGoal = nil
	local from = feet(self.root.Position)
	local function compute(to: Vector3): boolean
		local c0 = os.clock()
		local ok = pcall(function()
			self.path:ComputeAsync(from, to)
		end)
		Monster.stats.pathCalls += 1
		Monster.stats.pathWall += os.clock() - c0
		return ok and self.alive and self.path.Status == Enum.PathStatus.Success
	end
	local function take(final: boolean): boolean
		self.waypoints = self.path:GetWaypoints()
		self.wp = math.min(2, #self.waypoints)
		self.goal = goal
		self.legGoal = if final then nil else goal
		return true
	end
	if compute(goal) then
		return take(true)
	end
	if not self.alive then
		return false
	end
	-- 멀리 돌아가는 길: 타일 경로를 따라 몇 칸 앞까지만 계산하고, 도착하면 다시 계산한다(follow)
	local route = self.route and self.route(from, goal, true)
	if route and #route > 1 then
		for _, ahead in { MC.LegTiles, math.ceil(MC.LegTiles / 2), 2 } do
			local idx = math.min(#route, ahead + 1)
			if compute(route[idx]) then
				return take(idx == #route)
			end
		end
	end
	self.waypoints = {}
	self.wp = 1
	return false
end

-- 구간 끝에 왔다: 최종 목표가 남아 있으면 다음 구간을 계산한다. 최종 목표에 도착했으면 true
function Monster.nextLeg(self: Monster): boolean
	local g = self.legGoal
	if g and (feet(self.root.Position) - g).Magnitude > 4 and self:pathTo(g) then
		return false
	end
	self.legGoal = nil
	return true
end

-- 경로를 따라 한 걸음. 끝에 도착하면 true
function Monster.follow(self: Monster): boolean
	local wps = self.waypoints
	if #wps == 0 or self.wp > #wps then
		return self:nextLeg()
	end
	local wp = wps[self.wp]
	local pos = self.root.Position
	local flat = Vector3.new(wp.Position.X - pos.X, 0, wp.Position.Z - pos.Z)
	if flat.Magnitude < 2.2 and math.abs(feet(pos).Y - wp.Position.Y) < 4 then
		self.wp += 1
		if self.wp > #wps then
			return self:nextLeg()
		end
		wp = wps[self.wp]
	end
	self.hum:MoveTo(wp.Position)
	-- 앞에 닫힌 문이 있으면 연다
	Doors.openNear(pos + self.root.CFrame.LookVector * 2, 6, self.root.Position)
	return false
end

function Monster.randomNode(self: Monster, awayFrom: Vector3?): Vector3
	local best = self.nodes[math.random(1, #self.nodes)]
	if awayFrom then
		for _ = 1, 6 do
			local n = self.nodes[math.random(1, #self.nodes)]
			if (n - awayFrom).Magnitude > (best - awayFrom).Magnitude and (n - awayFrom).Magnitude < 90 then
				best = n
			end
		end
	end
	return best
end

-- 머리에서 대상까지 벽에 막히지 않는가
function Monster.lineOfSight(self: Monster, p: Vector3): boolean
	local from = self.root.Position + Vector3.new(0, 2.5, 0)
	local hit = workspace:Raycast(from, p - from, self.rayParams)
	return hit == nil
end

local function alivePlayers(): { { player: Player, root: BasePart, char: Model } }
	local out = {}
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Status") == "Alive" and not p:GetAttribute("Hidden") then
			local char = p.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if char and root then
				table.insert(out, { player = p, root = root, char = char })
			end
		end
	end
	return out
end

function Monster.startChase(self: Monster, p: Player, pos: Vector3)
	if self.state ~= "Chase" then
		self:note("chase " .. p.Name)
	end
	self.target = p
	self.lastSeen = os.clock()
	self.lastKnown = pos
	self.pullSpot = nil
	self:setState("Chase")
end

-- 누가 숨었다: 쫓던 대상이고 방금까지 보고 있었다면 숨는 곳을 기억한다
function Monster.onHide(self: Monster, p: Player, front: Vector3)
	if self.state == "Chase" and self.target == p and os.clock() - self.lastSeen <= Config.Hide.SeenWindow then
		self:note("saw " .. p.Name .. " hide")
		self.pullSpot = front
		self.lastKnown = front
		self.waypoints = {}
	end
end

function Monster.investigate(self: Monster, pos: Vector3)
	self.searchCenter = pos
	if self.state == "Wander" then
		self:setState("Alert")
		self.alertUntil = os.clock() + MC.AlertTime
		self.goal = pos
		return
	end
	if self.state == "Alert" then
		self.goal = pos
		return
	end
	-- 수색 중이거나 조사 중이면 새 위치로
	self:setState("Investigate")
	if not self.goal or (self.goal - pos).Magnitude > 4 or os.clock() - self.lastRepath > 1.5 then
		self.goal = pos
		self.waypoints = {}
	end
end

-- 소리를 들었다(SoundBus)
function Monster.hear(self: Monster, pos: Vector3, radius: number, source: Player?, kind: string)
	if not self.alive or os.clock() < self.startAt then
		return
	end
	if kind == "Door" and source == nil then
		return -- 괴물이 연 문 소리(괴물끼리 서로 문 소리에 끌려다니지 않게)
	end
	if not SoundBus.canHear(pos, self.root.Position, radius) then
		return
	end
	if self.state == "Chase" then
		if source and source == self.target then
			self.lastKnown = pos
			self.lastSeen = math.max(self.lastSeen, os.clock() - MC.LoseTime * 0.5)
		end
		return
	end
	self:note("heard " .. kind .. " " .. (if source then source.Name else "-"))
	self:investigate(pos)
end

-- 감각: 가까운 플레이어를 발견
function Monster.sense(self: Monster)
	local my = self.root.Position
	local best: { player: Player, root: BasePart, char: Model }? = nil
	local bestD = math.huge
	for _, e in alivePlayers() do
		local p = e.root.Position
		local d = (p - my).Magnitude
		local crouch = e.char:GetAttribute("MoveMode") == "Crouch"
		local range = if crouch then MC.SightRangeCrouch else MC.SightRange
		if d < bestD and math.abs(p.Y - my.Y) < 9 then
			if d <= MC.SenseRange or (d <= range and self:lineOfSight(p + Vector3.new(0, 1, 0))) then
				best = e
				bestD = d
			end
		end
	end
	if best then
		if self.state ~= "Chase" or self.target == best.player then
			self:startChase(best.player, best.root.Position)
		elseif bestD < 6 then
			self:startChase(best.player, best.root.Position)
		end
	end
end

function Monster.checkStuck(self: Monster, moving: boolean)
	local now = os.clock()
	if now - self.progressT < 1.5 then
		return
	end
	local moved = (self.root.Position - self.progressPos).Magnitude
	self.progressPos = self.root.Position
	self.progressT = now
	if not moving or self.hum.WalkSpeed <= 0 then
		self.stuck = 0
		return
	end
	if moved < 1.0 then
		self.stuck += 1
		self:note("stuck " .. self.stuck)
		self.waypoints = {}
		if self.stuck >= 3 then
			-- 목표를 포기하고 다른 곳으로
			self.goal = nil
			if self.state ~= "Chase" then
				self:setState("Wander")
			end
		end
		if self.stuck >= 6 then
			-- 마지막 수단: 가장 가까운 배회 지점으로 옮긴다
			local best, bd = self.nodes[1], math.huge
			for _, n in self.nodes do
				local d = (n - self.root.Position).Magnitude
				if d < bd and d > 2 then
					best, bd = n, d
				end
			end
			self.model:PivotTo(CFrame.new(best + Vector3.new(0, 2.2, 0)))
			self.stuck = 0
		end
	else
		self.stuck = 0
	end
end

function Monster.tick(self: Monster)
	local now = os.clock()
	if now < self.startAt then
		return
	end
	self:sense()
	local st = self.state
	local moving = true
	if st == "Chase" then
		local t = self.target
		local char = t and t.Character
		local troot = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not t or t:GetAttribute("Status") ~= "Alive" or not troot then
			self.pullSpot = nil
			self.target = nil
			self.searchCenter = self.lastKnown or self.root.Position
			self.searchUntil = now + MC.SearchTime
			self:setState("Search")
			self.waypoints = {}
			return
		end
		local tp = troot.Position
		local d = (tp - self.root.Position).Magnitude
		local hidden = t:GetAttribute("Hidden") == true
		if hidden and self.pullSpot then
			-- 숨는 걸 봤다: 그 앞으로 가서 끌어낸다
			local front = self.pullSpot
			local flat = Vector3.new(front.X - self.root.Position.X, 0, front.Z - self.root.Position.Z).Magnitude
			if flat < 4.5 then
				self:note("pulled out " .. t.Name)
				self.pullSpot = nil
				Hiding.exit(t)
				self.onCatch(t, self)
				self.target = nil
				self.searchCenter = front
				self.searchUntil = now + MC.SearchTime
				self:setState("Search")
				self.waypoints = {}
				return
			end
			if #self.waypoints == 0 or self:follow() then
				if not self:pathTo(front) then
					self.hum:MoveTo(front)
				end
			end
			self:checkStuck(true)
			return
		end
		if not hidden then
			self.pullSpot = nil
		end
		local los = not hidden and d < 40 and self:lineOfSight(tp)
		if los then
			self.lastSeen = now
			self.lastKnown = tp
		end
		if now - self.lastSeen > MC.LoseTime then
			-- 놓쳤다: 마지막 위치로 가서 수색
			self:note("lost target")
			self.target = nil
			self:setState("Investigate")
			self.goal = self.lastKnown
			self.searchCenter = self.lastKnown
			self.waypoints = {}
			return
		end
		if los and d < 14 and math.abs(tp.Y - self.root.Position.Y) < 3 then
			self.waypoints = {}
			self.hum:MoveTo(tp)
			Doors.openNear(self.root.Position + self.root.CFrame.LookVector * 2, 6, self.root.Position)
		else
			if #self.waypoints == 0 or now - self.lastRepath > MC.RepathChase then
				local goal = self.lastKnown or tp
				if not self:pathTo(goal) then
					self.lastRepath = now
				end
			end
			self:follow()
		end
	elseif st == "Alert" then
		moving = false
		if self.goal then
			local look = Vector3.new(self.goal.X, self.root.Position.Y, self.goal.Z)
			if (look - self.root.Position).Magnitude > 0.5 then
				self.hum:MoveTo(self.root.Position + (look - self.root.Position).Unit * 0.5)
			end
		end
		if now >= self.alertUntil then
			self:setState("Investigate")
			self.waypoints = {}
		end
	elseif st == "Investigate" then
		local goal = self.goal or self.searchCenter
		if not goal then
			self:setState("Wander")
			return
		end
		if #self.waypoints == 0 then
			if not self:pathTo(goal) then
				-- 그 자리로 갈 수 없다: 근처 배회 지점을 대신 조사
				local best, bd = nil, math.huge
				for _, n in self.nodes do
					local dd = (n - goal).Magnitude
					if dd < bd then
						best, bd = n, dd
					end
				end
				if best and (best - goal).Magnitude > 0.5 and bd < 20 then
					self.goal = best
					if not self:pathTo(best) then
						self:setState("Wander")
						return
					end
				else
					self:setState("Wander")
					return
				end
			end
		end
		local arrived = self:follow()
		if arrived or (self.root.Position - goal).Magnitude < 4 then
			self.searchCenter = goal
			self.searchUntil = now + MC.SearchTime
			self:setState("Search")
			self.waypoints = {}
		end
	elseif st == "Search" then
		if now > self.searchUntil then
			self:setState("Wander")
			self.waypoints = {}
			return
		end
		if #self.waypoints == 0 or self:follow() then
			local c = self.searchCenter or self.root.Position
			local ok = false
			for _ = 1, 4 do
				local ang = math.random() * math.pi * 2
				local r = MC.SearchRadius * (0.4 + math.random() * 0.6)
				local p = c + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
				if self:pathTo(p) then
					ok = true
					break
				end
			end
			if not ok then
				self:setState("Wander")
			end
		end
	else -- Wander
		if #self.waypoints == 0 or self:follow() then
			local n = self:randomNode(self.root.Position)
			-- 넓은 맵에서 영영 마주치지 않는 일이 없게: 가끔 플레이어(숨지 않은) 근처로 배회한다
			if now - self.lastHunt >= MC.HuntEvery then
				self.lastHunt = now
				local ps = alivePlayers()
				if #ps > 0 then
					local pick = ps[math.random(1, #ps)]
					local tp = pick.root.Position
					local near = {}
					for _, c in self.nodes do
						local dd = (c - tp).Magnitude
						if dd > 12 and dd <= MC.HuntRadius then
							table.insert(near, c)
						end
					end
					local best = if #near > 0 then near[math.random(1, #near)] else nil
					if best then
						self:note("hunt near " .. pick.player.Name)
						n = best
					end
				end
			end
			if not self:pathTo(n) then
				self.waypoints = {}
			end
		end
	end
	self:checkStuck(moving)
end

-- 잡기 판정(매 프레임)
function Monster.checkCatch(self: Monster)
	if not self.alive or os.clock() < self.startAt then
		return
	end
	local my = self.root.Position
	for _, e in alivePlayers() do
		local p = e.root.Position
		local flat = Vector3.new(p.X - my.X, 0, p.Z - my.Z).Magnitude
		if flat <= MC.CatchDistance and math.abs(p.Y - (my.Y - 1.5)) < 5 then
			self:note("caught " .. e.player.Name)
			self.onCatch(e.player, self)
			-- 잡은 뒤에는 그 자리를 잠깐 뒤진다
			self.target = nil
			self.searchCenter = p
			self.searchUntil = os.clock() + MC.SearchTime
			self:setState("Search")
			self.waypoints = {}
		end
	end
end

function Monster.run(self: Monster)
	task.spawn(function()
		while self.alive and self.model.Parent do
			local ok, err = pcall(self.tick, self)
			Monster.stats.ticks += 1
			if not ok then
				warn("[Monster] " .. tostring(err))
				self.waypoints = {}
			end
			task.wait(0.1)
		end
	end)
end

function Monster.destroy(self: Monster)
	self.alive = false
	self.model:Destroy()
end

return Monster
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[--!strict
-- 스테이지별 소품 타일(창고 선반·컨테이너, 하수도 수로·대형 배관, 병원 침대·책상·수술대·캐비닛).
-- 각 함수는 StageBuilder 의 ctx 와 타일 좌표(i, j)를 받는다. 모두 MapKit 부품만 쓴다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)

local Props = {}

local function base(ctx, i: number, j: number): Vector3
	return ctx.center(i, j) + Vector3.new(0, ctx.floorY(i, j), 0)
end

-- 타일에서 가장 가까운 벽 방향(없으면 nil)
local function wallSide(ctx, i: number, j: number): Vector3?
	for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		if ctx.isWall(i + d[1], j + d[2]) then
			return Vector3.new(d[1], 0, d[2])
		end
	end
	return nil
end

local function emitter(parent: Instance, pos: Vector3, sound: string)
	local em = Kit.box(parent, CFrame.new(pos), Vector3.new(0.2, 0.2, 0.2), { invisible = true, collide = false, tag = false })
	em.CanQuery = false
	em:SetAttribute("Sound", sound)
	CollectionService:AddTag(em, Config.Tags.AmbientEmitter)
end

-- ── 창고 ──
-- 대형 선반(랙): 기둥 + 3단 가로보 + 선반판 + 상자. axis = 선반이 뻗는 방향
local function rack(ctx, i: number, j: number, axis: Vector3)
	local p = base(ctx, i, j)
	local across = Vector3.new(axis.Z, 0, -axis.X)
	local len, depth, height = ctx.T - 0.4, 2.4, 10
	local m = Instance.new("Model")
	m.Name = "Rack"
	m.Parent = ctx.props
	-- (선반 창고는 음파 선이 아주 많아지는 곳이라 꼭 필요한 모서리만: 기둥은 세로선, 보·판은 긴 선만)
	for _, a in { -1, 1 } do
		for _, b in { -1, 1 } do
			local c = p + axis * (a * (len / 2 - 0.15)) + across * (b * (depth / 2 - 0.15))
			Kit.box(m, CFrame.lookAt(c + Vector3.new(0, height / 2, 0), c + Vector3.new(0, height / 2, 0) + axis), Vector3.new(0.3, height, 0.3), { blocks = false, axis = "Y" })
		end
	end
	for k, y in { 0.4, 3.6, 6.8, 9.8 } do
		for _, b in { -1, 1 } do
			local c = p + across * (b * (depth / 2 - 0.15)) + Vector3.new(0, y, 0)
			Kit.box(m, CFrame.lookAt(c, c + axis), Vector3.new(0.25, 0.4, len), { blocks = false, axis = "Z" })
		end
		local deck = p + Vector3.new(0, y + 0.25, 0)
		-- 선반 판은 선을 그리지 않는다(양옆 보가 이미 선반 모양을 보여 준다)
		Kit.box(m, CFrame.lookAt(deck, deck + axis), Vector3.new(depth - 0.3, 0.12, len - 0.3), { blocks = false, collide = k == 1, shape = "None" })
		-- 상자들(층마다 위치를 바꿔서)
		if k < 3 then
			local h = ctx.hash(i * 3 + k, j, 5)
			local n = 1
			for q = 1, n do
				local off = (q - (n + 1) / 2) * 2.3 + (h - 0.5) * 0.8
				local sz = Vector3.new(1.6 + h * 0.6, 1.4 + ((q * 7 + k) % 3) * 0.4, 1.7)
				local bp = deck + axis * off + Vector3.new(0, 0.06, 0)
				local cf = CFrame.lookAt(bp + Vector3.new(0, sz.Y / 2, 0), bp + Vector3.new(0, sz.Y / 2, 0) + axis) * CFrame.Angles(0, (h - 0.5) * 0.3, 0)
				Kit.box(m, cf, Vector3.new(sz.Z, sz.Y, sz.X), { blocks = false })
			end
		end
	end
	-- 보이지 않는 충돌(선반 사이로 들어가지 않게)
	Kit.box(m, CFrame.lookAt(p + Vector3.new(0, 1.5, 0), p + Vector3.new(0, 1.5, 0) + axis), Vector3.new(depth, 3, len), { invisible = true, tag = false })
end
function Props.RackX(ctx, i, j)
	rack(ctx, i, j, Vector3.new(1, 0, 0))
end
function Props.RackZ(ctx, i, j)
	rack(ctx, i, j, Vector3.new(0, 0, 1))
end

-- 컨테이너: 골판 리브 + 한쪽 끝 문짝과 잠금 막대. stacked 면 두 단
function Props.Container(ctx, i: number, j: number, stacked: boolean?)
	local p = base(ctx, i, j)
	local axis = if ctx.hash(i, j, 9) < 0.5 then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
	local across = Vector3.new(axis.Z, 0, -axis.X)
	local len, w, h = 7.4, 6.2, 6.4
	local levels = if stacked then 2 else 1
	for lv = 0, levels - 1 do
		local y0 = lv * (h + 0.05)
		local c = p + Vector3.new(0, y0 + h / 2, 0)
		local m = Instance.new("Model")
		m.Name = "Container"
		m.Parent = ctx.props
		Kit.box(m, CFrame.lookAt(c, c + axis), Vector3.new(w, h, len))
		-- 옆면 세로 리브
		for k = -3, 3 do
			for _, s in { -1, 1 } do
				local rp = c + axis * (k * 1.0) + across * (s * (w / 2 + 0.06))
				Kit.box(m, CFrame.lookAt(rp, rp + axis), Vector3.new(0.12, h - 0.6, 0.35), { blocks = false, collide = false })
			end
		end
		-- 문 쪽(앞) 잠금 막대
		local front = c + axis * (len / 2 + 0.12)
		for _, s in { -1.6, -0.6, 0.6, 1.6 } do
			local a = front + across * s - Vector3.new(0, h / 2 - 0.3, 0)
			Kit.cylinder(m, a, a + Vector3.new(0, h - 0.6, 0), 0.09, { blocks = false, collide = false })
		end
		Kit.box(m, CFrame.lookAt(front, front + axis), Vector3.new(0.12, h - 0.4, 0.08), { blocks = false, collide = false })
	end
end
function Props.ContainerStack(ctx, i, j)
	Props.Container(ctx, i, j, true)
end

-- ── 하수도 ──
-- 수로: 아래층 바닥 위 얕은 물(선 없음, 걸어서 지나갈 수 있음) + 물소리
function Props.Water(ctx, i: number, j: number)
	local c = ctx.center(i, j)
	local s = Kit.box(ctx.props, CFrame.new(c + Vector3.new(0, ctx.PIT_Y + 0.6, 0)), Vector3.new(ctx.T, 1.2, ctx.T), { collide = false, shape = "None", blocks = false })
	s.CanQuery = false
	if (i + j) % 3 == 0 then
		emitter(ctx.props, c + Vector3.new(0, ctx.PIT_Y + 1, 0), "AmbientWater")
	end
end

-- 대형 배관(머리 위, 타일을 가로지른다)
function Props.BigPipe(ctx, i: number, j: number)
	local c = ctx.center(i, j)
	local axis = Vector3.new(1, 0, 0)
	if ctx.isWall(i - 1, j) and ctx.isWall(i + 1, j) then
		axis = Vector3.new(0, 0, 1)
	end
	local y = ctx.floorY(i, j) + 10
	local a = c - axis * (ctx.T / 2) + Vector3.new(0, y, 0)
	local b = c + axis * (ctx.T / 2) + Vector3.new(0, y, 0)
	Kit.pipe(ctx.props, a, b, 1.7, { 0 }, true)
	-- 받침(바닥까지 내려오는 H 프레임)
	local across = Vector3.new(axis.Z, 0, -axis.X)
	for _, s in { -1, 1 } do
		local leg = c + across * (s * 2.4) + Vector3.new(0, ctx.floorY(i, j) + (y - 1.7) / 2, 0)
		Kit.box(ctx.props, CFrame.new(leg), Vector3.new(0.4, y - 1.7, 0.4), { blocks = false })
	end
	local cross = c + Vector3.new(0, ctx.floorY(i, j) + y - 1.9, 0)
	Kit.box(ctx.props, CFrame.lookAt(cross, cross + axis), Vector3.new(5.2, 0.4, 0.5), { blocks = false })
end

-- ── 병원 ──
-- 침대: 벽에 머리를 붙인 철제 침대(다리, 매트리스, 머리판, 난간)
function Props.Bed(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(0, 0, -1)
	local head = p + side * (ctx.T / 2 - 0.4)
	local foot = head - side * 6.6
	local across = Vector3.new(side.Z, 0, -side.X)
	local mid = (head + foot) / 2
	local m = Instance.new("Model")
	m.Name = "Bed"
	m.Parent = ctx.props
	Kit.box(m, CFrame.lookAt(mid + Vector3.new(0, 2.0, 0), mid + Vector3.new(0, 2.0, 0) + side), Vector3.new(3.0, 0.7, 6.2), { blocks = false })
	Kit.box(m, CFrame.lookAt(mid + Vector3.new(0, 1.5, 0), mid + Vector3.new(0, 1.5, 0) + side), Vector3.new(3.2, 0.25, 6.4), { blocks = false })
	for _, e in { head, foot } do
		for _, s in { -1, 1 } do
			local leg = e + across * (s * 1.5) - side * (if e == head then 0.15 else -0.15)
			Kit.cylinder(m, leg, leg + Vector3.new(0, if e == head then 3.6 else 2.8, 0), 0.1, { blocks = false })
		end
	end
	local hb = head - side * 0.15 + Vector3.new(0, 2.9, 0)
	Kit.box(m, CFrame.lookAt(hb, hb + side), Vector3.new(3.0, 1.2, 0.12), { blocks = false })
	local fb = foot + side * 0.15 + Vector3.new(0, 2.45, 0)
	Kit.box(m, CFrame.lookAt(fb, fb + side), Vector3.new(3.0, 0.7, 0.12), { blocks = false })
	for _, s in { -1, 1 } do
		local a = head - side * 1.2 + across * (s * 1.65) + Vector3.new(0, 2.8, 0)
		Kit.cylinder(m, a, a - side * 3.2, 0.06, { blocks = false, collide = false })
	end
	Kit.box(m, CFrame.lookAt(mid + Vector3.new(0, 1.5, 0), mid + Vector3.new(0, 1.5, 0) + side), Vector3.new(3.2, 3, 6.4), { invisible = true, tag = false })
end

-- 책상 + 의자
function Props.Desk(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local yaw = ctx.hash(i, j, 3) * 0.6 - 0.3
	local cf = CFrame.new(p) * CFrame.Angles(0, yaw, 0)
	local m = Instance.new("Model")
	m.Name = "Desk"
	m.Parent = ctx.props
	Kit.box(m, cf * CFrame.new(0, 3.1, 0), Vector3.new(4.6, 0.2, 2.4), { blocks = false })
	for _, x in { -2.1, 2.1 } do
		for _, z in { -1.0, 1.0 } do
			Kit.box(m, cf * CFrame.new(x, 1.5, z), Vector3.new(0.2, 3.0, 0.2), { blocks = false })
		end
	end
	Kit.box(m, cf * CFrame.new(1.4, 2.2, 0), Vector3.new(1.4, 1.5, 2.0), { blocks = false })
	-- 의자
	local ch = cf * CFrame.new(-0.6, 0, 2.2) * CFrame.Angles(0, 0.4, 0)
	Kit.box(m, ch * CFrame.new(0, 1.8, 0), Vector3.new(1.6, 0.18, 1.6), { blocks = false })
	Kit.box(m, ch * CFrame.new(0, 2.8, 0.75), Vector3.new(1.6, 1.8, 0.15), { blocks = false })
	for _, x in { -0.7, 0.7 } do
		for _, z in { -0.7, 0.7 } do
			Kit.box(m, ch * CFrame.new(x, 0.9, z), Vector3.new(0.12, 1.8, 0.12), { blocks = false })
		end
	end
	Kit.box(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(4.6, 3, 2.4), { invisible = true, tag = false })
end

-- 수술대 + 천장 원형 조명(꺼진) + 기구 카트
function Props.Surgery(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local m = Instance.new("Model")
	m.Name = "Surgery"
	m.Parent = ctx.props
	Kit.box(m, CFrame.new(p + Vector3.new(0, 3.0, 0)), Vector3.new(2.4, 0.4, 6.0), { blocks = false })
	Kit.cylinder(m, p + Vector3.new(0, 0, 0), p + Vector3.new(0, 2.8, 0), 0.45, { blocks = false })
	Kit.box(m, CFrame.new(p + Vector3.new(0, 0.15, 0)), Vector3.new(2.2, 0.3, 2.8), { blocks = false })
	local lamp = p + Vector3.new(0, ctx.H - ctx.floorY(i, j) - 4.2, 0)
	Kit.cylinder(m, lamp + Vector3.new(0, 4.2, 0), lamp + Vector3.new(0, 1.0, 0), 0.12, { blocks = false, collide = false })
	Kit.cylinder(m, lamp, lamp + Vector3.new(0, 1.0, 0), 1.6, { blocks = false, collide = false })
	Kit.cylinder(m, lamp + Vector3.new(2.6, 0.2, 1), lamp + Vector3.new(2.6, 0.9, 1), 0.9, { blocks = false, collide = false })
	Kit.cylinder(m, lamp + Vector3.new(0, 1.0, 0), lamp + Vector3.new(2.6, 0.9, 1), 0.1, { blocks = false, collide = false })
	local cart = p + Vector3.new(3.0, 0, -2.0)
	Kit.box(m, CFrame.new(cart + Vector3.new(0, 2.6, 0)), Vector3.new(1.4, 0.15, 2.0), { blocks = false })
	Kit.box(m, CFrame.new(cart + Vector3.new(0, 1.2, 0)), Vector3.new(1.4, 0.15, 2.0), { blocks = false })
	for _, x in { -0.6, 0.6 } do
		for _, z in { -0.9, 0.9 } do
			Kit.cylinder(m, cart + Vector3.new(x, 0, z), cart + Vector3.new(x, 2.6, z), 0.06, { blocks = false })
		end
	end
	Kit.box(m, CFrame.new(p + Vector3.new(0, 1.5, 0)), Vector3.new(2.4, 3, 6), { invisible = true, tag = false })
end

-- 캐비닛(벽에 붙은 키 큰 수납장)
function Props.Cabinet(ctx, i: number, j: number)
	local p = base(ctx, i, j)
	local side = wallSide(ctx, i, j) or Vector3.new(1, 0, 0)
	local c = p + side * (ctx.T / 2 - 1.0) + Vector3.new(0, 3.5, 0)
	local m = Instance.new("Model")
	m.Name = "Cabinet"
	m.Parent = ctx.props
	Kit.box(m, CFrame.lookAt(c, c - side), Vector3.new(3.6, 7, 1.8))
	local face = c - side * 0.95
	Kit.box(m, CFrame.lookAt(face, face - side), Vector3.new(0.08, 6.4, 0.1), { blocks = false, collide = false })
	Kit.box(m, CFrame.lookAt(face + Vector3.new(0, 0.6, 0), face + Vector3.new(0, 0.6, 0) - side) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(0.08, 3.4, 0.1), { blocks = false, collide = false })
end

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Round</string>
          <string name="Source"><![CDATA[--!strict
-- 라운드(스테이지) 진행: 스테이지 짓기 → 플레이어 배치 → 괴물 → 탈출/사망 판정 → 다음 스테이지 또는 재시작.
-- 플레이어 상태(Player 속성 "Status"): "Waiting" | "Alive" | "Dead" | "Escaped"
-- ReplicatedStorage 속성: StageIndex, StageName, RoundState("Waiting"|"Lobby"|"Loading"|"Playing"|"Result"), RoundId, Mode("Lobby"|"Game")
-- 로비(RoundState "Lobby"): 로비 맵을 스테이지처럼 지어 음파로 본다. 방(Lobby.luau)에서 시작하면 그 방 사람만 참가자(Round.members).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local Builder = require(script.Parent.StageBuilder)
local Doors = require(script.Parent.Doors)
local SoundBus = require(script.Parent.SoundBus)
local Monster = require(script.Parent.Monster)
local Hiding = require(script.Parent.Hiding)
local Search = require(script.Parent.Search)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RoundEvent = Remotes:WaitForChild("RoundEvent") :: RemoteEvent

local Round = {}
Round.stageIndex = 1
Round.state = "Waiting"
Round.roundId = 0
Round.lastBuildMs = 0
Round.info = nil :: Builder.StageInfo?
Round.monsters = {} :: { any }
Round.autoLoop = true -- 테스트가 끌 수 있다
Round.lastOutcome = "" :: string
Round.events = {} :: { string }
Round.members = nil :: { [Player]: boolean }? -- nil 이면 서버의 모든 플레이어가 참가자
Round.returnToLobby = false -- 로비에서 시작한 게임: 마지막 스테이지를 깨거나 참가자가 모두 나가면 로비로
Round.lastAllClear = false

local stageFolder: Folder? = nil
local spawnCursor = 0
local monsterFolder: Folder = Instance.new("Folder")
monsterFolder.Name = "Monsters"
monsterFolder.Parent = workspace

local function note(s: string)
	table.insert(Round.events, string.format("%.1f %s", os.clock(), s))
	if #Round.events > 80 then
		table.remove(Round.events, 1)
	end
end

local function setStatus(p: Player, s: string)
	p:SetAttribute("Status", s)
end

function Round.status(p: Player): string
	return (p:GetAttribute("Status") :: string?) or "Waiting"
end

-- 이번 게임 참가자(로비에서 방으로 시작했으면 그 방 사람만)
function Round.participants(): { Player }
	local out = {}
	for _, p in Players:GetPlayers() do
		if not Round.members or Round.members[p] then
			table.insert(out, p)
		end
	end
	return out
end

function Round.alivePlayers(): { Player }
	local out = {}
	for _, p in Round.participants() do
		if Round.status(p) == "Alive" then
			table.insert(out, p)
		end
	end
	return out
end

local function stageDef(i: number)
	return Config.Stages[i]
end

local function stageModule(i: number): any?
	local def = stageDef(i)
	if not def then
		return nil
	end
	local m = script.Parent.Stages:FindFirstChild(def.Module)
	if not m then
		return nil
	end
	return require(m :: ModuleScript)
end

local function buildLayout(layout: any, label: string)
	if stageFolder then
		stageFolder:Destroy()
		stageFolder = nil
	end
	Doors.clear()
	local b0 = os.clock()
	local info = Builder.build(layout, workspace, "Stage")
	Round.lastBuildMs = (os.clock() - b0) * 1000
	local folder = info.folder
	folder:SetAttribute("Rows", table.concat(layout.Rows, "/")) -- 클라이언트 지도(Q)용 격자(행을 / 로 구분)
	local count = 0
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") then
			count += 1
		end
	end
	Round.roundId += 1
	folder:SetAttribute("PartCount", count)
	folder:SetAttribute("BuildId", Round.roundId)
	folder:SetAttribute("BoundsMin", info.bounds.min)
	folder:SetAttribute("BoundsMax", info.bounds.max)
	folder.Parent = workspace
	stageFolder = folder
	Round.info = info
	SoundBus.setGeometry(folder)
	note("built " .. label .. " parts=" .. count)
end

function Round.buildStage(i: number)
	local layout = stageModule(i)
	assert(layout, "stage module missing: " .. tostring(i))
	buildLayout(layout, "stage " .. i)
end

local function nextSpawn(): CFrame
	local info = Round.info :: Builder.StageInfo
	spawnCursor += 1
	return info.spawns[((spawnCursor - 1) % #info.spawns) + 1]
end

function Round.spawnPlayer(p: Player)
	if not Round.info then
		return
	end
	setStatus(p, "Alive")
	p:LoadCharacter()
	local char = p.Character
	if not char or Round.status(p) ~= "Alive" then
		return
	end
	local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
	local root = char:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	if not hum or not root then
		return
	end
	hum.WalkSpeed = Config.Move.Walk
	hum.UseJumpPower = true
	hum.JumpPower = Config.Move.JumpPower
	-- 착지 소리: 괴물이 듣는다
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed and Round.state == "Playing" and Round.status(p) == "Alive" and p.Character == char then
			SoundBus.emit(root.Position - Vector3.new(0, 2.5, 0), Config.Noise.Land, p, "StepLand")
		end
	end)
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	char:SetAttribute("MoveMode", "Walk")
	char:PivotTo(nextSpawn())
	-- 다른 원인으로 죽어도(맵 밖 등) 사망 처리
	hum.Died:Connect(function()
		if Round.status(p) == "Alive" and p.Character == char then
			Round.kill(p, "fell")
		end
	end)
end

function Round.kill(p: Player, why: string?)
	if Round.status(p) ~= "Alive" then
		return
	end
	if Round.state == "Lobby" then
		-- 로비에서는 죽지 않는다(떨어지면 다시 세운다)
		task.delay(1, function()
			if Round.state == "Lobby" then
				Round.spawnPlayer(p)
			end
		end)
		return
	end
	setStatus(p, "Dead")
	note("dead " .. p.Name .. " " .. (why or ""))
	local others = #Round.alivePlayers()
	RoundEvent:FireAllClients("Died", { userId = p.UserId, solo = #Round.participants() == 1, othersAlive = others, why = why })
	local char = p.Character
	if char then
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.Anchored = true
		end
		task.delay(Config.Round.DeadBodyLinger, function()
			if p.Character == char then
				p.Character = nil
			end
			char:Destroy()
		end)
	end
end

function Round.escape(p: Player)
	if Round.status(p) ~= "Alive" then
		return
	end
	setStatus(p, "Escaped")
	note("escaped " .. p.Name)
	RoundEvent:FireAllClients("Escaped", { userId = p.UserId, othersAlive = #Round.alivePlayers() })
	local char = p.Character
	if char then
		p.Character = nil
		char:Destroy()
	end
end

local function clearMonsters()
	for _, m in Round.monsters do
		m:destroy()
	end
	table.clear(Round.monsters)
	monsterFolder:ClearAllChildren()
end

function Round.spawnMonsters(count: number)
	local info = Round.info :: Builder.StageInfo
	local spawnPos = info.spawns[1].Position
	local candidates = {}
	for _, n in info.nodes do
		if (n - spawnPos).Magnitude >= Config.Monster.MinSpawnDistance then
			table.insert(candidates, n)
		end
	end
	if #candidates == 0 then
		candidates = info.nodes
	end
	table.sort(candidates, function(a, b)
		return (a - spawnPos).Magnitude > (b - spawnPos).Magnitude
	end)
	for k = 1, count do
		-- 멀리 있는 지점들 중 서로 떨어진 곳
		local pick = candidates[math.min(#candidates, 1 + (k - 1) * math.max(1, math.floor(#candidates / (count + 1))))]
		local m = Monster.new(monsterFolder, pick, info.nodes, info.folder, function(player)
			Round.kill(player, "monster")
		end, Round.stageIndex)
		m.route = info.route
		table.insert(Round.monsters, m)
		m:run()
	end
	note("monsters " .. count)
end

function Round.startStage(i: number)
	clearMonsters()
	Round.stageIndex = i
	Round.state = "Loading"
	ReplicatedStorage:SetAttribute("RoundState", "Loading")
	ReplicatedStorage:SetAttribute("Mode", "Game")
	for _, p in Players:GetPlayers() do
		setStatus(p, "Waiting")
		if p.Character then
			p.Character:Destroy()
			p.Character = nil
		end
	end
	Round.buildStage(i)
	local def = stageDef(i)
	ReplicatedStorage:SetAttribute("StageIndex", i)
	ReplicatedStorage:SetAttribute("StageName", def.Name)
	ReplicatedStorage:SetAttribute("RoundId", Round.roundId)
	spawnCursor = 0
	for _, p in Round.participants() do
		task.spawn(Round.spawnPlayer, p)
	end
	Round.state = "Playing"
	ReplicatedStorage:SetAttribute("RoundState", "Playing")
	Search.assignKey((Round.info :: Builder.StageInfo).spawns[1].Position)
	RoundEvent:FireAllClients("Start", { stage = i, name = def.Name })
	Round.spawnMonsters(def.Monsters)
	note("start " .. i)
end

-- 라운드가 끝났는가: 살아 있는 플레이어가 없다
function Round.finished(): boolean
	if Round.state ~= "Playing" then
		return false
	end
	if #Round.participants() == 0 then
		return true
	end
	for _, p in Round.participants() do
		local s = Round.status(p)
		if s == "Alive" or s == "Waiting" then
			return false
		end
	end
	return true
end

function Round.finish(): string
	local anyEscaped = false
	Round.lastAllClear = false
	for _, p in Round.participants() do
		if Round.status(p) == "Escaped" then
			anyEscaped = true
		end
	end
	Round.state = "Result"
	ReplicatedStorage:SetAttribute("RoundState", "Result")
	clearMonsters()
	local i = Round.stageIndex
	local outcome
	if anyEscaped then
		local nextI = i + 1
		local allClear = nextI > #Config.Stages or stageModule(nextI) == nil
		if allClear then
			nextI = 1
		end
		outcome = "Clear"
		RoundEvent:FireAllClients("Clear", { stage = i, nextStage = nextI, nextName = stageDef(nextI).Name, allClear = allClear, toLobby = Round.returnToLobby, seconds = Config.Round.ResultSeconds })
		Round.stageIndex = nextI
		Round.lastAllClear = allClear
	else
		outcome = "Failed"
		RoundEvent:FireAllClients("Failed", { stage = i, nextName = stageDef(i).Name, seconds = Config.Round.ResultSeconds })
	end
	Round.lastOutcome = outcome
	note("finish " .. outcome)
	return outcome
end

-- 출구·잡기 판정
RunService.Heartbeat:Connect(function(dt)
	if Round.state ~= "Playing" then
		return
	end
	for _, m in Round.monsters do
		m:checkCatch()
		m:animate(dt)
	end
	local info = Round.info
	if not info then
		return
	end
	for _, p in Round.participants() do
		if Round.status(p) == "Alive" then
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local lp = info.exitCFrame:PointToObjectSpace(root.Position)
				local s = info.exitSize / 2
				if math.abs(lp.X) <= s.X and math.abs(lp.Y) <= s.Y and math.abs(lp.Z) <= s.Z then
					if Config.Key.Required and ReplicatedStorage:GetAttribute("HasKey") ~= true then
						-- 잠긴 출구: 몇 초에 한 번 알려 준다
						local last = (p:GetAttribute("ExitLockedAt") :: number?) or 0
						if os.clock() - last > 3 then
							p:SetAttribute("ExitLockedAt", os.clock())
							RoundEvent:FireClient(p, "ExitLocked", {})
						end
					else
						Round.escape(p)
					end
				end
			end
		end
	end
end)

-- 발소리 소음: 서버가 실제 이동 속도로 판정(클라이언트 값을 믿지 않는다)
task.spawn(function()
	local N = Config.Noise
	while true do
		task.wait(N.StepInterval)
		if Round.state == "Playing" then
			for _, p in Players:GetPlayers() do
				if Round.status(p) == "Alive" then
					local char = p.Character
					local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					if char and root then
						local v = root.AssemblyLinearVelocity
						local speed = Vector3.new(v.X, 0, v.Z).Magnitude
						if speed > N.MovingAbove then
							local radius, kind = N.Crouch, "StepCrouch"
							if speed > N.RunSpeedAbove then
								radius, kind = N.Run, "StepRun"
							elseif speed > N.WalkSpeedAbove then
								radius, kind = N.Walk, "StepWalk"
							end
							SoundBus.emit(root.Position - Vector3.new(0, 2.5, 0), radius, p, kind)
						end
					end
				end
			end
		end
	end
end)

SoundBus.listen(function(pos, radius, source, kind)
	for _, m in Round.monsters do
		m:hear(pos, radius, source, kind)
	end
end)

-- 숨는 순간: 쫓던 괴물이 그 모습을 봤는지
Hiding.onHide(function(p, spot)
	for _, m in Round.monsters do
		m:onHide(p, spot.front)
	end
end)

Players.PlayerAdded:Connect(function(p)
	setStatus(p, "Waiting")
	if Round.state == "Lobby" then
		task.defer(Round.spawnPlayer, p)
	elseif Round.state == "Playing" and not Round.members then
		-- 늦게 들어온 플레이어도 시작 지점에서 함께 한다(방에서 시작한 게임은 그 방 사람만)
		task.defer(Round.spawnPlayer, p)
	end
end)

Players.PlayerRemoving:Connect(function(p)
	if Round.members then
		Round.members[p] = nil
	end
end)

-- 로비: 로비 맵을 짓고 모두 그 안에 세운다
function Round.enterLobby()
	clearMonsters()
	Round.members = nil
	Round.returnToLobby = false
	Round.state = "Loading"
	ReplicatedStorage:SetAttribute("RoundState", "Loading")
	ReplicatedStorage:SetAttribute("Mode", "Lobby")
	for _, p in Players:GetPlayers() do
		setStatus(p, "Waiting")
		if p.Character then
			p.Character:Destroy()
			p.Character = nil
		end
	end
	buildLayout(require(script.Parent.Stages.Lobby) :: any, "lobby")
	ReplicatedStorage:SetAttribute("HasKey", false)
	ReplicatedStorage:SetAttribute("StageIndex", 0)
	ReplicatedStorage:SetAttribute("StageName", "로비")
	ReplicatedStorage:SetAttribute("RoundId", Round.roundId)
	spawnCursor = 0
	Round.state = "Lobby"
	ReplicatedStorage:SetAttribute("RoundState", "Lobby")
	for _, p in Players:GetPlayers() do
		task.spawn(Round.spawnPlayer, p)
	end
	RoundEvent:FireAllClients("Lobby", {})
	note("lobby")
end

-- 게임 진행(스테이지 → 결과 → 다음/재시작).
-- returnToLobby 면 다섯 스테이지를 모두 깨거나 참가자가 모두 나가면 로비로 돌아가며 끝난다.
function Round.loop()
	while true do
		while #Round.participants() == 0 do
			if Round.returnToLobby then
				Round.enterLobby()
				return
			end
			task.wait(0.5)
		end
		task.wait(Config.Round.FirstStartDelay)
		Round.startStage(Round.stageIndex)
		while not Round.finished() do
			task.wait(0.2)
		end
		Round.finish()
		task.wait(Config.Round.ResultSeconds)
		while not Round.autoLoop do
			task.wait(0.2)
		end
		if Round.returnToLobby and (Round.lastAllClear or #Round.participants() == 0) then
			Round.enterLobby()
			return
		end
	end
end

return Round
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Search</string>
          <string name="Source"><![CDATA[--!strict
-- 뒤질 수 있는 상자·서랍(맵 문자 Z). 챕터별 모양(SearchStyle). 서랍장은 서랍마다, 상자는 뚜껑을 따로 열고 닫는다.
-- 조작: 조준점으로 서랍/뚜껑을 보고 E(클라이언트 SearchLook → Remotes.SearchAction(spotId, index)). 다시 E 면 닫힌다.
-- 스테이지마다 한 칸(서랍 하나 또는 뚜껑 하나)에 열쇠가 있고(라운드마다 서버가 고른다), 누가 찾든 팀 전체가 가진다
-- (ReplicatedStorage 속성 HasKey). 열쇠가 없으면 출구가 열리지 않는다(Round). 처음 열 때 뒤지는 소리를 괴물이 듣는다.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local SoundBus = require(script.Parent.SoundBus)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RoundEvent = Remotes:WaitForChild("RoundEvent") :: RemoteEvent
local SearchAction = Remotes:WaitForChild("SearchAction") :: RemoteEvent

local Search = {}

export type Comp = {
	model: Model, -- 움직이는 서랍/뚜껑(음파는 움직이는 물체로 그린다)
	closedPivot: CFrame,
	openPivot: CFrame,
	open: boolean,
	busy: boolean,
	searched: boolean,
	hasKey: boolean,
}
export type Spot = {
	id: number,
	model: Model,
	center: Vector3,
	front: Vector3,
	comps: { Comp },
	name: string,
}

local spots: { Spot } = {}
local byId: { [number]: Spot } = {}
local nextId = 0

-- 챕터별 모양: w 폭, h 높이, d 깊이, kind = "drawers"(rows 칸) | "lid"
type Style = { w: number, h: number, d: number, kind: string, rows: number, name: string }
local STYLES: { [string]: Style } = {
	drawers = { w = 3.2, h = 3.8, d = 2.2, kind = "drawers", rows = 3, name = "서랍장" }, -- 지하 시설: 철제 서랍장
	crate = { w = 3.6, h = 3.2, d = 3.0, kind = "lid", rows = 0, name = "나무 상자" }, -- 창고
	toolbox = { w = 3.4, h = 1.9, d = 2.0, kind = "lid", rows = 0, name = "공구함" }, -- 하수도
	nightstand = { w = 2.6, h = 2.8, d = 2.2, kind = "drawers", rows = 2, name = "협탁" }, -- 병원
	chest = { w = 3.6, h = 2.3, d = 2.4, kind = "lid", rows = 0, name = "궤짝" }, -- 심층 미로
}
Search.Styles = STYLES

local function newComp(parent: Model, idx: number, spotId: number): Model
	local mv = Instance.new("Model")
	mv.Name = "Comp" .. idx
	mv:SetAttribute(Config.Tags.Dynamic, true)
	mv:SetAttribute("SpotId", spotId)
	mv:SetAttribute("Comp", idx)
	mv.Parent = parent
	return mv
end

-- cf: 바닥 가운데, LookVector(-Z) = 앞(방 안쪽)
local function build(parent: Instance, cf: CFrame, s: Style, spotId: number): (Model, { Comp })
	local m = Instance.new("Model")
	m.Name = "SearchSpot"
	m:SetAttribute("SpotId", spotId)
	m:SetAttribute("Label", s.name)
	local t = 0.2
	local w, h, d = s.w, s.h, s.d
	local function box(par: Instance, local_: CFrame, size: Vector3, opts: Kit.Opts?): Part
		return Kit.box(par, cf * local_, size, opts)
	end
	box(m, CFrame.new(0, h / 2, d / 2 - t / 2), Vector3.new(w, h, t))
	for _, sx in { -1, 1 } do
		box(m, CFrame.new(sx * (w / 2 - t / 2), h / 2, 0), Vector3.new(t, h, d))
	end
	box(m, CFrame.new(0, t / 2, 0), Vector3.new(w, t, d))
	local comps: { Comp } = {}
	local facing = cf.LookVector
	if s.kind == "drawers" then
		box(m, CFrame.new(0, h - t / 2, 0), Vector3.new(w + 0.1, t, d + 0.1))
		local rowH = (h - t * 2) / s.rows
		for k = 1, s.rows do
			local mv = newComp(m, k, spotId)
			local y = h - t - rowH * (k - 0.5) -- 1 = 맨 위
			local inner = d - t * 2
			box(mv, CFrame.new(0, y, -d / 2 + t / 2), Vector3.new(w - t * 2 - 0.08, rowH - 0.1, t), { blocks = false })
			box(mv, CFrame.new(0, y, -d / 2 - 0.1), Vector3.new(0.8, 0.12, 0.12), { blocks = false, collide = false })
			-- 서랍 통(바닥 + 양옆 + 뒤): 빠졌을 때 서랍 모양이 보이게
			box(mv, CFrame.new(0, y - rowH / 2 + 0.12, -d / 2 + t + inner / 2), Vector3.new(w - t * 2 - 0.15, 0.08, inner), { blocks = false, collide = false })
			for _, sx in { -1, 1 } do
				box(mv, CFrame.new(sx * (w / 2 - t - 0.12), y - rowH * 0.15, -d / 2 + t + inner / 2), Vector3.new(0.08, rowH * 0.6, inner), { blocks = false, collide = false })
			end
			box(mv, CFrame.new(0, y - rowH * 0.15, d / 2 - t - 0.06), Vector3.new(w - t * 2 - 0.15, rowH * 0.6, 0.08), { blocks = false, collide = false })
			local closed = mv:GetPivot()
			-- 앞으로 곧게 빠진다(월드 기준 이동)
			table.insert(comps, { model = mv, closedPivot = closed, openPivot = closed + facing * (inner * 0.75), open = false, busy = false, searched = false, hasKey = false })
		end
	else
		box(m, CFrame.new(0, h / 2, -d / 2 + t / 2), Vector3.new(w, h, t))
		local mv = newComp(m, 1, spotId)
		box(mv, CFrame.new(0, h + t / 2, 0), Vector3.new(w + 0.12, t, d + 0.12))
		if s.name ~= "공구함" then
			for _, sx in { -0.3, 0.3 } do
				box(mv, CFrame.new(sx * w, h + t + 0.03, 0), Vector3.new(0.18, 0.06, d + 0.14), { blocks = false, collide = false })
			end
		else
			box(mv, CFrame.new(0, h + t + 0.25, 0), Vector3.new(w * 0.5, 0.12, 0.12), { blocks = false, collide = false })
		end
		local closed = mv:GetPivot()
		-- 뒤쪽 경첩을 축으로 뒤로 젖혀진다(월드 기준 회전)
		local hinge = (cf * CFrame.new(0, h + t, d / 2)).Position
		local turn = CFrame.new(hinge) * CFrame.fromAxisAngle(cf.RightVector, math.rad(100)) * CFrame.new(-hinge)
		table.insert(comps, { model = mv, closedPivot = closed, openPivot = turn * closed, open = false, busy = false, searched = false, hasKey = false })
	end
	m.Parent = parent
	return m, comps
end

-- pos: 타일 가운데 바닥, back: 벽 쪽(단위 벡터)
function Search.create(parent: Instance, pos: Vector3, back: Vector3, styleName: string?): Spot
	local s = STYLES[styleName or "drawers"] or STYLES.drawers
	local facing = -back
	local center = pos + back * (Config.Hide.Tile / 2 - s.d / 2 - 0.15)
	local cf = CFrame.lookAt(center, center + facing)
	nextId += 1
	local model, comps = build(parent, cf, s, nextId)
	CollectionService:AddTag(model, Config.Tags.SearchSpot)
	local spot: Spot = { id = nextId, model = model, center = center, front = center + facing * (s.d / 2 + 2.2), comps = comps, name = s.name }
	table.insert(spots, spot)
	byId[spot.id] = spot
	model.Destroying:Connect(function()
		local i = table.find(spots, spot)
		if i then
			table.remove(spots, i)
		end
		byId[spot.id] = nil
	end)
	return spot
end

local function hasKey(): boolean
	return ReplicatedStorage:GetAttribute("HasKey") == true
end

local function move(c: Comp, toOpen: boolean)
	c.busy = true
	local a, b = if toOpen then c.closedPivot else c.openPivot, if toOpen then c.openPivot else c.closedPivot
	local t0 = os.clock()
	local dur = 0.25
	while true do
		local k = math.clamp((os.clock() - t0) / dur, 0, 1)
		local e = 1 - (1 - k) * (1 - k)
		if not c.model.Parent then
			break
		end
		c.model:PivotTo(a:Lerp(b, e))
		if k >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	c.open = toOpen
	c.model:SetAttribute("Open", toOpen)
	c.busy = false
end

-- 서랍/뚜껑 하나를 열거나 닫는다. 처음 열면 뒤진다(결과: "key" | "empty").
-- 돌려주는 값: "key" | "empty" | "opened" | "closed" | "busy"
function Search.toggle(player: Player, spot: Spot, index: number): string
	local c = spot.comps[index]
	if not c or c.busy or player:GetAttribute("Status") ~= "Alive" or player:GetAttribute("Hidden") then
		return "busy"
	end
	if c.open then
		move(c, false)
		return "closed"
	end
	local first = not c.searched
	if first then
		SoundBus.emit(spot.front + Vector3.new(0, 2, 0), Config.Key.SearchNoise, player, "Search")
		RoundEvent:FireClient(player, "SearchResult", { result = "searching" })
	end
	move(c, true)
	if not first then
		return "opened"
	end
	task.wait(math.max(0, Config.Key.SearchSeconds - 0.25))
	c.searched = true
	if c.hasKey and not hasKey() then
		ReplicatedStorage:SetAttribute("HasKey", true)
		RoundEvent:FireAllClients("KeyFound", { by = player.DisplayName, userId = player.UserId })
		return "key"
	end
	RoundEvent:FireClient(player, "SearchResult", { result = if c.hasKey then "empty" else "empty" })
	return "empty"
end

-- (예전 호출용) 그 상자의 첫 칸을 연다
function Search.search(player: Player, spot: Spot): string
	for i, c in spot.comps do
		if not c.searched then
			return Search.toggle(player, spot, i)
		end
	end
	RoundEvent:FireClient(player, "SearchResult", { result = "already" })
	return "already"
end

SearchAction.OnServerEvent:Connect(function(player: Player, spotId: any, index: any)
	if type(spotId) ~= "number" or type(index) ~= "number" then
		return
	end
	local spot = byId[spotId]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not spot or not root or (root.Position - spot.center).Magnitude > Config.Key.PromptDistance + 2 then
		return
	end
	Search.toggle(player, spot, index)
end)

-- 새 스테이지: 열쇠를 한 칸에 넣는다(시작에서 먼 쪽 절반의 상자 중 무작위, 그 상자의 무작위 칸)
function Search.assignKey(start: Vector3)
	ReplicatedStorage:SetAttribute("HasKey", false)
	for _, s in spots do
		for _, c in s.comps do
			c.hasKey = false
		end
	end
	if #spots == 0 then
		return
	end
	local sorted = table.clone(spots)
	table.sort(sorted, function(a, b)
		return (a.front - start).Magnitude > (b.front - start).Magnitude
	end)
	local pick = sorted[math.random(1, math.max(1, math.ceil(#sorted / 2)))]
	pick.comps[math.random(1, #pick.comps)].hasKey = true
end

function Search.all(): { Spot }
	return spots
end

-- 열쇠가 든 상자와 칸 번호
function Search.keySpot(): (Spot?, number?)
	for _, s in spots do
		for i, c in s.comps do
			if c.hasKey then
				return s, i
			end
		end
	end
	return nil, nil
end

return Search
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">SoundBus</string>
          <string name="Source"><![CDATA[--!strict
-- 서버의 소리 이벤트 통로. 음파·발소리·문 소리가 여기로 들어오고, 괴물들이 듣는다.
-- 들리는 거리 = 소리 크기(반경) × (벽 감쇠 ^ 사이에 낀 벽 수).
-- 지금은 거리 + 벽 개수 감쇠. 나중에 경로 길이 기반 전파 등으로 바꾸려면 heardRange 만 고치면 된다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local SoundBus = {}

export type Listener = (pos: Vector3, radius: number, source: Player?, kind: string) -> ()

local listeners: { Listener } = {}
SoundBus.recent = {} :: { { pos: Vector3, radius: number, kind: string, t: number, source: string } }

local geometry: Instance? = nil
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include
params.RespectCanCollide = true

function SoundBus.setGeometry(folder: Instance?)
	geometry = folder
	if folder then
		params.FilterDescendantsInstances = { folder }
	end
end

function SoundBus.listen(fn: Listener): () -> ()
	table.insert(listeners, fn)
	return function()
		local i = table.find(listeners, fn)
		if i then
			table.remove(listeners, i)
		end
	end
end

-- a 와 b 사이의 벽(충돌 파트) 수, 최대 MaxWallsCounted
function SoundBus.wallsBetween(a: Vector3, b: Vector3): number
	if not geometry then
		return 0
	end
	local count = 0
	local from = a
	for _ = 1, Config.Noise.MaxWallsCounted do
		local d = b - from
		if d.Magnitude < 0.1 then
			break
		end
		local hit = workspace:Raycast(from, d, params)
		if not hit then
			break
		end
		count += 1
		-- (파트 안에서 시작한 레이는 그 파트를 다시 맞히지 않으므로 다음 레이는 벽 너머로 나간다)
		from = hit.Position + d.Unit * 0.05
	end
	return count
end

-- 소리(pos, radius)가 listenerPos 에서 들리는 최대 거리
function SoundBus.heardRange(pos: Vector3, listenerPos: Vector3, radius: number): number
	if (pos - listenerPos).Magnitude > radius then
		return radius -- 이미 범위 밖: 벽 계산 생략
	end
	local walls = SoundBus.wallsBetween(pos + Vector3.new(0, 0.5, 0), listenerPos)
	return radius * (Config.Noise.WallAttenuation ^ walls)
end

function SoundBus.canHear(pos: Vector3, listenerPos: Vector3, radius: number): boolean
	local d = (pos - listenerPos).Magnitude
	if d > radius then
		return false
	end
	return d <= SoundBus.heardRange(pos, listenerPos, radius)
end

function SoundBus.emit(pos: Vector3, radius: number, source: Player?, kind: string)
	table.insert(SoundBus.recent, { pos = pos, radius = radius, kind = kind, t = os.clock(), source = if source then source.Name else "" })
	if #SoundBus.recent > 50 then
		table.remove(SoundBus.recent, 1)
	end
	for _, fn in table.clone(listeners) do
		local ok, err = pcall(fn, pos, radius, source, kind)
		if not ok then
			warn("[SoundBus] listener error: " .. tostring(err))
		end
	end
end

return SoundBus
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">StageBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- 타일 레이아웃(문자 격자)으로 스테이지 지형을 짓는다. 모든 스테이지가 같은 빌더와 MapKit 부품을 쓴다.
-- 타일 1칸 = 8스터드. 위층 바닥 y=0, 구덩이(아래층) 바닥 y=-6, 천장 y=14.
--
-- 공통 타일 문자
--   #  벽            .  바닥          S  시작 지점       E  출구
--   D  문(복도를 가로지르는 벽 + 문)   A  아치 리브       O  기둥
--   c  상자 더미      m  기계 설비     v  수직 배관 묶음  f  천장 환풍기
--   p  구덩이(아래층) b  구덩이 위 철제 다리             s  계단(구덩이 ↔ 위층)
-- 스테이지별 추가 타일은 레이아웃 모듈의 Props 함수로 짓는다(같은 ctx 를 받는다).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.MapKit)
local Doors = require(script.Parent.Doors)
local Hiding = require(script.Parent.Hiding)
local Search = require(script.Parent.Search)

local Builder = {}

local T = 8
local H = 14
local PIT_Y = -6
local BOTTOM = -10
Builder.Tile = T
Builder.Height = H
Builder.PitY = PIT_Y

export type Layout = {
	Rows: { string },
	Props: { [string]: (ctx: any, i: number, j: number) -> () }?,
	Walkable: { [string]: boolean }?, -- Props 타일 중 괴물 배회 지점으로 쓸 수 있는 것
	PitTiles: { [string]: boolean }?, -- Props 타일 중 아래층 높이인 것
	PipeChance: number?,
	HideStyle: string?,
	SearchStyle: string?, -- 상자·서랍(Z) 모양: drawers / crate / toolbox / nightstand / chest (Search.Styles) -- 숨는 곳(L) 모양: locker / tool / rusty / wardrobe / closet (Hiding.Styles)
	Seed: number?,
}

export type StageInfo = {
	folder: Folder,
	spawns: { CFrame },
	exitCFrame: CFrame,
	exitSize: Vector3,
	nodes: { Vector3 },
	bounds: { min: Vector3, max: Vector3 },
	-- 타일 격자 위 최단 경로(타일 가운데 바닥 높이 좌표들). PathfindingService 는 시작·목표 주변만 탐색하므로
	-- 큰 맵에서 멀리 돌아가야 하는 길은 이 경로를 짧은 구간으로 나눠 계산한다. monster = true 면 좁은 다리(n) 제외
	route: (from: Vector3, to: Vector3, monster: boolean?) -> { Vector3 }?,
}

local PIT = { p = true, b = true, s = true, n = true }
local function bridgeChar(c: string): boolean
	return c == "b" or c == "n"
end

local function hash(a: number, b: number, c: number): number
	local h = bit32.bxor(bit32.bxor((a * 73856093) % 4294967296, (b * 19349663) % 4294967296), (c * 83492791) % 4294967296)
	return (h % 1000) / 1000
end

function Builder.build(layout: Layout, parent: Instance, name: string): StageInfo
	local rows = layout.Rows
	local nz = #rows
	local nx = #rows[1]
	local grid: { { string } } = {}
	for j = 1, nz do
		grid[j] = {}
		for i = 1, nx do
			grid[j][i] = rows[j]:sub(i, i)
		end
	end
	local function at(i: number, j: number): string
		if j < 1 or j > nz or i < 1 or i > nx then
			return "#"
		end
		return grid[j][i]
	end
	local pitSet = table.clone(PIT)
	for k, v in layout.PitTiles or {} do
		pitSet[k] = v
	end
	local function isWall(i: number, j: number): boolean
		return at(i, j) == "#"
	end
	local function isPit(i: number, j: number): boolean
		return pitSet[at(i, j)] == true
	end
	local function floorY(i: number, j: number): number
		return if isPit(i, j) then PIT_Y else 0
	end
	-- 타일 (i, j) 의 가운데(바닥 높이 0 기준 x,z). i = 열(x), j = 행(z)
	local function center(i: number, j: number): Vector3
		return Vector3.new((i - 1) * T + T / 2, 0, (j - 1) * T + T / 2)
	end

	local folder = Instance.new("Folder")
	folder.Name = name
	local geo = Instance.new("Folder")
	geo.Name = "Geometry"
	geo.Parent = folder
	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = folder

	-- ── 직사각형 병합(같은 종류 타일을 큰 상자 하나로) ──
	local function merge(pred: (i: number, j: number) -> boolean): { { number } }
		local used: { [number]: boolean } = {}
		local rects = {}
		for j = 1, nz do
			for i = 1, nx do
				if not used[j * 1000 + i] and pred(i, j) then
					local i1 = i
					while i1 + 1 <= nx and pred(i1 + 1, j) and not used[j * 1000 + i1 + 1] do
						i1 += 1
					end
					local j1 = j
					local grow = true
					while grow and j1 + 1 <= nz do
						for x = i, i1 do
							if not pred(x, j1 + 1) or used[(j1 + 1) * 1000 + x] then
								grow = false
								break
							end
						end
						if grow then
							j1 += 1
						end
					end
					for y = j, j1 do
						for x = i, i1 do
							used[y * 1000 + x] = true
						end
					end
					table.insert(rects, { i, j, i1, j1 })
				end
			end
		end
		return rects
	end
	local function rectSpan(r: { number }, y0: number, y1: number, opts: Kit.Opts?)
		local lo = Vector3.new((r[1] - 1) * T, y0, (r[2] - 1) * T)
		local hi = Vector3.new(r[3] * T, y1, r[4] * T)
		return Kit.span(geo, lo, hi, opts)
	end

	-- 벽 덩어리, 위층 바닥(벽 아래 포함), 아래층 바닥, 천장
	for _, r in merge(function(i, j) return isWall(i, j) end) do
		rectSpan(r, 0, H, { name = "Wall" })
	end
	for _, r in merge(function(i, j) return not isPit(i, j) end) do
		rectSpan(r, BOTTOM, 0, { name = "Floor" })
	end
	for _, r in merge(function(i, j) return isPit(i, j) end) do
		rectSpan(r, BOTTOM, PIT_Y, { name = "PitFloor" })
	end
	Kit.span(geo, Vector3.new(0, H, 0), Vector3.new(nx * T, H + 2, nz * T), { name = "Ceiling" })

	local dirs = {
		{ di = 1, dj = 0, v = Vector3.new(1, 0, 0) },
		{ di = -1, dj = 0, v = Vector3.new(-1, 0, 0) },
		{ di = 0, dj = 1, v = Vector3.new(0, 0, 1) },
		{ di = 0, dj = -1, v = Vector3.new(0, 0, -1) },
	}

	local info: StageInfo = {
		folder = folder,
		spawns = {},
		exitCFrame = CFrame.new(),
		exitSize = Vector3.new(6, 8, 6),
		nodes = {},
		bounds = { min = Vector3.new(0, BOTTOM, 0), max = Vector3.new(nx * T, H + 2, nz * T) },
		route = nil,
	}

	-- ── 타일 경로(tools/check-layout.js 와 같은 규칙: 구덩이 = 아래층, 다리 = 위층, 계단 = 둘 다) ──
	local passable: { [string]: boolean } = { ["."] = true, S = true, E = true, D = true, A = true, f = true, P = true, s = true }
	for k in pitSet do
		passable[k] = true
	end
	for k, v in layout.Walkable or {} do
		passable[k] = v
	end
	local function levels(c: string): { number }
		if pitSet[c] then
			if bridgeChar(c) then
				return { 0 }
			elseif c == "s" then
				return { 0, 1 }
			end
			return { 1 }
		end
		return { 0 }
	end
	local function hasLevel(c: string, l: number): boolean
		for _, x in levels(c) do
			if x == l then
				return true
			end
		end
		return false
	end
	info.route = function(from: Vector3, to: Vector3, monster: boolean?): { Vector3 }?
		local function tileOf(p: Vector3): (number, number, number)
			local i, j = math.floor(p.X / T) + 1, math.floor(p.Z / T) + 1
			local c = at(i, j)
			local l = if p.Y < PIT_Y / 2 then 1 else 0
			if not hasLevel(c, l) then
				l = levels(c)[1]
			end
			return i, j, l
		end
		local si, sj, sl = tileOf(from)
		local gi, gj, gl = tileOf(to)
		if not passable[at(si, sj)] or not passable[at(gi, gj)] then
			return nil
		end
		local function k(i: number, j: number, l: number): number
			return (l * nz + (j - 1)) * (nx + 2) + i
		end
		local prev: { [number]: number } = { [k(si, sj, sl)] = -1 }
		local q = { { si, sj, sl } }
		local head = 1
		local found = false
		while head <= #q do
			local cur = q[head]
			head += 1
			local i, j, l = cur[1], cur[2], cur[3]
			if i == gi and j == gj and l == gl then
				found = true
				break
			end
			local here = k(i, j, l)
			if at(i, j) == "s" then
				local other = k(i, j, 1 - l)
				if prev[other] == nil then
					prev[other] = here
					table.insert(q, { i, j, 1 - l })
				end
			end
			for _, d in dirs do
				local ni, nj = i + d.di, j + d.dj
				local c = at(ni, nj)
				if passable[c] and not (monster and c == "n") and hasLevel(c, l) then
					local nk = k(ni, nj, l)
					if prev[nk] == nil then
						prev[nk] = here
						table.insert(q, { ni, nj, l })
					end
				end
			end
		end
		if not found then
			return nil
		end
		local out = {}
		local cur = k(gi, gj, gl)
		while cur ~= -1 do
			local l = cur // ((nx + 2) * nz)
			local rest = cur % ((nx + 2) * nz)
			local j, i = rest // (nx + 2) + 1, rest % (nx + 2)
			local y = if l == 1 then PIT_Y else 0
			if at(i, j) == "s" then
				y = PIT_Y / 2
			end
			table.insert(out, 1, center(i, j) + Vector3.new(0, y + 0.5, 0))
			cur = prev[cur]
		end
		return out
	end

	local ctx = {
		Kit = Kit,
		Doors = Doors,
		props = props,
		geo = geo,
		at = at,
		center = center,
		floorY = floorY,
		isWall = isWall,
		isPit = isPit,
		T = T,
		H = H,
		PIT_Y = PIT_Y,
		info = info,
		hash = hash,
	}

	-- 이 타일에서 벽이 있는 방향 목록
	local function wallSides(i: number, j: number)
		local out = {}
		for _, d in dirs do
			if isWall(i + d.di, j + d.dj) then
				table.insert(out, d)
			end
		end
		return out
	end
	-- 복도 방향: 양옆이 벽이면 진행 방향 벡터
	local function corridorAxis(i: number, j: number): Vector3?
		local wx = isWall(i - 1, j) and isWall(i + 1, j)
		local wz = isWall(i, j - 1) and isWall(i, j + 1)
		if wx and not wz then
			return Vector3.new(0, 0, 1)
		elseif wz and not wx then
			return Vector3.new(1, 0, 0)
		end
		return nil
	end

	-- ── 벽면 장식: 벽기둥(필라스터), 천장 모서리 경사, 벽 배관 ──
	local pipeChance = layout.PipeChance or 0.55
	local seed = layout.Seed or 1
	for j = 1, nz do
		for i = 1, nx do
			local ch = at(i, j)
			if ch ~= "#" then
				local fy = floorY(i, j)
				local c = center(i, j)
				for _, d in wallSides(i, j) do
					local n = -d.v -- 벽면이 방을 향하는 법선
					local along = Vector3.new(d.v.Z, 0, -d.v.X) -- 벽을 따라가는 방향
					local face = c + d.v * (T / 2) -- 벽면 가운데(바닥 높이 0)
					-- 벽기둥: 이 타일의 시작 모서리에, 다음 타일도 같은 쪽에 벽이 있을 때
					local ni, nj = i - math.round(along.X), j - math.round(along.Z)
					if at(ni, nj) ~= "#" and isWall(ni + d.di, nj + d.dj) and floorY(ni, nj) == fy then
						local p = face - along * (T / 2) + n * 0.25
						Kit.box(geo, CFrame.lookAt(p + Vector3.new(0, (fy + H) / 2, 0), p + Vector3.new(0, (fy + H) / 2, 0) + n), Vector3.new(1.1, H - fy, 0.5), { name = "Pilaster" })
					end
					-- 천장 모서리 경사(쐐기): 바닥면이 천장에, 뒷면이 벽에 붙는다
					if ch ~= "D" and ch ~= "A" and ch ~= "E" then
						local s = 1.4
						local pos = face + n * (s / 2) + Vector3.new(0, H - s / 2, 0)
						local vY = Vector3.new(0, -1, 0)
						local vZ = -n
						Kit.wedge(geo, CFrame.fromMatrix(pos, vY:Cross(vZ), vY, vZ), Vector3.new(T, s, s), { name = "Haunch", collide = false, blocks = false })
					end
					-- 벽 배관: 같은 벽 줄(행/열 + 방향)마다 정해진 확률로, 줄 전체에 이어진다
					local lineKey = if math.abs(d.v.X) > 0 then i * 2 + (if d.v.X > 0 then 1 else 0) else j * 2 + (if d.v.Z > 0 then 1 else 0)
					local axisKey = if math.abs(d.v.X) > 0 then 1 else 2
					if hash(lineKey, axisKey, seed) < pipeChance and ch ~= "D" and ch ~= "A" and ch ~= "E" and ch ~= "S" then
						local r = 0.5
						local y = H - 3
						local off = n * (r + 0.9)
						local a = face - along * (T / 2) + off + Vector3.new(0, y, 0)
						local b = face + along * (T / 2) + off + Vector3.new(0, y, 0)
						Kit.pipe(props, a, b, r, { 0 }, true)
						-- 벽 고정 브래킷
						local bc = face + n * 0.6 + Vector3.new(0, y, 0)
						Kit.box(props, CFrame.lookAt(bc, bc + n), Vector3.new(0.3, 0.3, 1.2), { blocks = false, collide = false })
						-- 다음 타일에서 벽이 끊기면 배관을 벽 속으로 꺾어 넣는다
						for _, sgn in { -1, 1 } do
							local ti, tj = i + math.round(along.X) * sgn, j + math.round(along.Z) * sgn
							local continues = at(ti, tj) ~= "#" and isWall(ti + d.di, tj + d.dj) and not (at(ti, tj) == "D" or at(ti, tj) == "A" or at(ti, tj) == "E" or at(ti, tj) == "S")
							if not continues then
								local endP = if sgn > 0 then b else a
								local inner = endP - along * sgn * 0.6
								if isWall(ti, tj) then
									-- 앞이 벽이면 그 벽으로 들어간다(배관이 이미 닿음)
									local _ = inner
								else
									Kit.cylinder(props, inner, inner - n * (r + 1.2), r, { blocks = false })
								end
							end
						end
						-- 가는 전선관(위쪽)
						if hash(lineKey, axisKey, seed + 7) < 0.5 then
							local off2 = n * 0.45
							local a2 = face - along * (T / 2) + off2 + Vector3.new(0, H - 1.9, 0)
							local b2 = face + along * (T / 2) + off2 + Vector3.new(0, H - 1.9, 0)
							Kit.cylinder(props, a2, b2, 0.16, { blocks = false, collide = false })
						end
					end
				end
			end
		end
	end

	-- ── 타일별 구조물 ──
	for j = 1, nz do
		for i = 1, nx do
			local ch = at(i, j)
			local c = center(i, j)
			local fy = floorY(i, j)
			local axis = corridorAxis(i, j)
			if ch == "S" then
				local look = Vector3.new(nx * T / 2, 0, nz * T / 2)
				local p = c + Vector3.new(0, 3.2, 0)
				for k = 0, 1 do
					local off = Vector3.new(if k == 0 then -1.6 else 1.6, 0, 0)
					table.insert(info.spawns, CFrame.lookAt(p + off, Vector3.new(look.X, p.Y, look.Z)))
				end
			elseif ch == "E" then
				-- 들어오는 방향(바닥 이웃)
				local entry = dirs[1]
				for _, d in dirs do
					if not isWall(i + d.di, j + d.dj) then
						entry = d
					end
				end
				local back = -entry.v -- 출구 안쪽 끝 벽 방향
				local right = Vector3.new(back.Z, 0, -back.X)
				-- 입구 문틀(두꺼운 이중 프레임)
				local gate = c + entry.v * (T / 2 - 0.6)
				for _, s in { -1, 1 } do
					for k = 0, 1 do
						local p = gate + right * s * (3.2 + k * 0.6) + Vector3.new(0, 5, 0) - entry.v * k * 0.4
						Kit.box(geo, CFrame.lookAt(p, p + entry.v), Vector3.new(0.5, 10, 1.2), { name = "ExitFrame" })
					end
				end
				Kit.box(geo, CFrame.lookAt(gate + Vector3.new(0, 10.4, 0), gate + Vector3.new(0, 10.4, 0) + entry.v), Vector3.new(8, 0.8, 1.2), { name = "ExitLintel" })
				Kit.box(geo, CFrame.lookAt(gate + Vector3.new(0, 11.6, 0), gate + Vector3.new(0, 11.6, 0) + entry.v), Vector3.new(8, 1.6, 0.6))
				-- EXIT 글자(안쪽 벽)
				local wallFace = c + back * (T / 2 - 0.01)
				Kit.word(props, "EXIT", wallFace + Vector3.new(0, 8.5, 0) - right * 0.7, -right, -back, 1.4)
				-- 사다리와 천장 해치
				local lad = wallFace - back * 0.6 + right * 3.0
				for _, s in { -0.7, 0.7 } do
					Kit.cylinder(props, lad + right * s, lad + right * s + Vector3.new(0, H, 0), 0.1, { blocks = false })
				end
				for y = 1, H - 1, 1.2 do
					Kit.cylinder(props, lad + right * -0.7 + Vector3.new(0, y, 0), lad + right * 0.7 + Vector3.new(0, y, 0), 0.07, { blocks = false, collide = false })
				end
				local hatch = lad + back * 0.4 + Vector3.new(0, H - 0.2, 0)
				for _, s in { -1, 1 } do
					Kit.box(props, CFrame.lookAt(hatch + right * s * 1.4, hatch + right * s * 1.4 + back), Vector3.new(0.3, 0.4, 3.0), { blocks = false, collide = false })
					Kit.box(props, CFrame.lookAt(hatch + back * s * 1.4, hatch + back * s * 1.4 + right), Vector3.new(0.3, 0.4, 3.0), { blocks = false, collide = false })
				end
				info.exitCFrame = CFrame.lookAt(c + Vector3.new(0, 4, 0) + back * 0.8, c + Vector3.new(0, 4, 0) + back * 2)
				info.exitSize = Vector3.new(T - 1, 8, T - 2.5)
			elseif ch == "D" then
				local ax = axis or Vector3.new(1, 0, 0)
				local across = Vector3.new(ax.Z, 0, -ax.X)
				local doorW, doorH, thick = 5, 9, 2
				-- 문 벽: 문 양옆과 문 위
				local sideW = (T - doorW) / 2
				for _, s in { -1, 1 } do
					local p = c + across * s * (doorW / 2 + sideW / 2) + Vector3.new(0, H / 2, 0)
					Kit.box(geo, CFrame.lookAt(p, p + ax), Vector3.new(sideW, H, thick), { name = "DoorWall" })
					-- 문틀(양쪽으로 튀어나온 문설주)
					local jp = c + across * s * (doorW / 2 + 0.25) + Vector3.new(0, doorH / 2, 0)
					Kit.box(geo, CFrame.lookAt(jp, jp + ax), Vector3.new(0.5, doorH, thick + 0.5), { name = "DoorJamb" })
				end
				local top = c + Vector3.new(0, (doorH + H) / 2, 0)
				Kit.box(geo, CFrame.lookAt(top, top + ax), Vector3.new(doorW, H - doorH, thick), { name = "DoorWall" })
				local lint = c + Vector3.new(0, doorH + 0.25, 0)
				Kit.box(geo, CFrame.lookAt(lint, lint + ax), Vector3.new(doorW + 1, 0.5, thick + 0.5), { name = "DoorHead" })
				local hingeBottom = c - across * (doorW / 2) + ax * (thick / 2 - 0.15) + Vector3.new(0, 0.02, 0)
				local swing = if hash(i, j, seed) < 0.5 then 1 else -1
				-- (문짝은 경첩에서 across 방향으로 뻗는다. swing 부호에 따라 ax 쪽이나 반대쪽으로 열린다)
				Doors.create(props, hingeBottom, across, doorW, doorH, swing)
			elseif ch == "A" then
				local ax = axis or Vector3.new(1, 0, 0)
				local across = Vector3.new(ax.Z, 0, -ax.X)
				Kit.archPortal(geo, c + Vector3.new(0, fy, 0), across, T, 6, H - fy)
			elseif ch == "O" then
				local p = c + Vector3.new(0, fy, 0)
				Kit.box(geo, CFrame.new(p + Vector3.new(0, (H - fy) / 2, 0)), Vector3.new(2.4, H - fy, 2.4), { name = "Pillar" })
				Kit.box(geo, CFrame.new(p + Vector3.new(0, 0.4, 0)), Vector3.new(3.4, 0.8, 3.4), { name = "PillarBase" })
				Kit.box(geo, CFrame.new(p + Vector3.new(0, H - fy - 0.6, 0)), Vector3.new(3.2, 1.2, 3.2), { name = "PillarCap" })
			elseif ch == "c" then
				-- 벽 쪽으로 붙인 상자 더미
				local side = Vector3.new(-1, 0, 0)
				for _, d in dirs do
					if isWall(i + d.di, j + d.dj) then
						side = d.v
						break
					end
				end
				local along = Vector3.new(side.Z, 0, -side.X)
				local base = c + side * (T / 2 - 1.8) + Vector3.new(0, fy, 0)
				local yaw = math.atan2(side.X, side.Z)
				Kit.crate(props, base - along * 1.8, Vector3.new(3, 3, 3), yaw)
				Kit.crate(props, base - along * 1.8 + Vector3.new(0, 3, 0), Vector3.new(2.2, 2.2, 2.2), yaw + 0.25)
				Kit.crate(props, base + along * 1.7, Vector3.new(3.2, 2.2, 2.6), yaw - 0.1)
				Kit.box(props, CFrame.new(base + along * 1.7 + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, yaw, 0), Vector3.new(3.6, 0.24, 3.0), { blocks = false })
			elseif ch == "m" then
				local p = c + Vector3.new(0, fy, 0)
				Kit.box(props, CFrame.new(p + Vector3.new(0, 0.4, 0)), Vector3.new(5.4, 0.8, 4.2), { name = "MachineBase" })
				Kit.box(props, CFrame.new(p + Vector3.new(-0.6, 2.4, 0)), Vector3.new(3.6, 3.2, 3.4), { name = "Machine" })
				Kit.box(props, CFrame.new(p + Vector3.new(1.9, 1.9, 0)), Vector3.new(1.0, 2.2, 1.6), { name = "Panel" })
				Kit.pipe(props, p + Vector3.new(-2.4, 5.2, 0), p + Vector3.new(1.6, 5.2, 0), 1.1, { 0, 1 }, true)
				Kit.pipe(props, p + Vector3.new(1.0, 6.3, 0), p + Vector3.new(1.0, H - fy, 0), 0.45, { 0.05, 0.95 }, false)
				for _, s in { -1, 1 } do
					Kit.box(props, CFrame.new(p + Vector3.new(-0.4 + s * 1.4, 4.4, 0)), Vector3.new(0.4, 1.0, 2.2), { blocks = false })
				end
				local em = Kit.box(props, CFrame.new(p + Vector3.new(0, 3, 0)), Vector3.new(0.2, 0.2, 0.2), { invisible = true, collide = false, tag = false })
				em.CanQuery = false
				em:SetAttribute("Sound", "AmbientFan")
				CollectionService:AddTag(em, Config.Tags.AmbientEmitter)
			elseif ch == "Z" then
				local back = nil
				for _, d in dirs do
					if isWall(i + d.di, j + d.dj) and not isWall(i - d.di, j - d.dj) then
						back = d.v
						break
					end
				end
				Search.create(props, c + Vector3.new(0, fy, 0), back or Vector3.new(0, 0, -1), layout.SearchStyle)
			elseif ch == "L" then
				-- 숨는 곳: 등을 댈 벽(맞은편이 열린 쪽)을 찾는다
				local back = nil
				for _, d in dirs do
					if isWall(i + d.di, j + d.dj) and not isWall(i - d.di, j - d.dj) then
						back = d.v
						break
					end
				end
				Hiding.create(props, c + Vector3.new(0, fy, 0), back or Vector3.new(0, 0, -1), layout.HideStyle)
			elseif ch == "v" then
				local p = c + Vector3.new(0, fy, 0)
				local spots = { Vector3.new(-2.2, 0, -2.2), Vector3.new(-2.4, 0, 1.6), Vector3.new(1.8, 0, -2.6) }
				local radii = { 1.0, 0.6, 0.7 }
				for k, o in spots do
					Kit.pipe(props, p + o, p + o + Vector3.new(0, H - fy, 0), radii[k], { 0.07, 0.5, 0.93 }, true)
				end
				Kit.pipe(props, p + spots[1] + Vector3.new(0, 10, 0), p + spots[3] + Vector3.new(0, 10, 0), 0.4, { 0.5 }, false)
			elseif ch == "f" then
				local p = c + Vector3.new(0, H, 0)
				Kit.cylinder(props, p - Vector3.new(0, 1.2, 0), p, 2.4, { blocks = false, collide = false, rings = 1 })
				for k = 0, 3 do
					local a = k * math.pi / 2 + 0.4
					local bp = p - Vector3.new(0, 1.0, 0) + Vector3.new(math.cos(a), 0, math.sin(a)) * 1.05
					Kit.box(props, CFrame.lookAt(bp, bp + Vector3.new(math.cos(a), 0, math.sin(a))) * CFrame.Angles(0, 0, 0.35), Vector3.new(0.7, 0.08, 1.8), { blocks = false, collide = false })
				end
				local em = Kit.box(props, CFrame.new(p - Vector3.new(0, 1.5, 0)), Vector3.new(0.2, 0.2, 0.2), { invisible = true, collide = false, tag = false })
				em.CanQuery = false
				em:SetAttribute("Sound", "AmbientFan")
				CollectionService:AddTag(em, Config.Tags.AmbientEmitter)
			elseif ch == "b" or ch == "n" then
				-- 다리 방향: 다리/위층과 이어진 축
				local bx = (bridgeChar(at(i - 1, j)) or (not isPit(i - 1, j) and not isWall(i - 1, j))) and (bridgeChar(at(i + 1, j)) or (not isPit(i + 1, j) and not isWall(i + 1, j)))
				local ax = if bx then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
				local across = Vector3.new(ax.Z, 0, -ax.X)
				local w = if ch == "n" then 3.2 else 5 -- (좁은 다리 n: 괴물은 지나갈 수 없다)
				local deck = c + Vector3.new(0, -0.25, 0)
				Kit.box(geo, CFrame.lookAt(deck, deck + ax), Vector3.new(w, 0.5, T), { name = "Catwalk" })
				for _, s in { -1, 1 } do
					local beam = c + across * s * (w / 2 - 0.3) + Vector3.new(0, -0.9, 0)
					Kit.box(props, CFrame.lookAt(beam, beam + ax), Vector3.new(0.4, 0.8, T), { blocks = false })
					local ra = c + across * s * (w / 2 - 0.15) - ax * (T / 2)
					Kit.railing(props, ra, ra + ax * T, 3.3, 2.65)
				end
				Kit.box(props, CFrame.lookAt(c + Vector3.new(0, -1.0, 0), c + Vector3.new(0, -1.0, 0) + across), Vector3.new(0.4, 0.6, w), { blocks = false })
				if (i + j) % 2 == 0 then
					for _, s in { -1, 1 } do
						local col = c + across * s * (w / 2 - 0.3)
						Kit.box(props, CFrame.new(col + Vector3.new(0, (PIT_Y - 1.3) / 2, 0)), Vector3.new(0.5, -1.3 - PIT_Y, 0.5), { blocks = false })
					end
				end
			elseif ch == "s" then
				-- 계단: 위층 이웃 쪽으로 올라간다
				local up = dirs[1]
				for _, d in dirs do
					local n = at(i + d.di, j + d.dj)
					if n ~= "#" and not isPit(i + d.di, j + d.dj) then
						up = d
					end
				end
				local across = Vector3.new(up.v.Z, 0, -up.v.X)
				local bottom = c - up.v * (T / 2) + Vector3.new(0, PIT_Y, 0)
				Kit.stairs(props, bottom, up.v, 6, -PIT_Y, T, 8)
				-- 계단 옆이 구덩이면 기울어진 난간
				for _, s in { -1, 1 } do
					local si, sj = i + math.round(across.X * s), j + math.round(across.Z * s)
					if not isWall(si, sj) then
						local a = bottom + across * s * 2.9
						local b = a + up.v * T + Vector3.new(0, -PIT_Y, 0)
						Kit.railing(props, a, b, 3.3, 2.7)
					end
				end
			end
			local pf = layout.Props and layout.Props[ch]
			if pf then
				pf(ctx, i, j)
			end
		end
	end

	-- ── 구덩이 가장자리 난간(위층 쪽) ──
	for j = 1, nz do
		for i = 1, nx do
			if not isWall(i, j) and not isPit(i, j) then
				for _, d in dirs do
					local ni, nj = i + d.di, j + d.dj
					local n = at(ni, nj)
					if isPit(ni, nj) then
						local open = false
						if n == "s" then
							-- 그 계단이 이 타일로 올라오면 난간 없음
							local best = nil
							for _, d2 in dirs do
								local m = at(ni + d2.di, nj + d2.dj)
								if m ~= "#" and not isPit(ni + d2.di, nj + d2.dj) then
									best = d2
								end
							end
							open = best ~= nil and best.di == -d.di and best.dj == -d.dj
						elseif bridgeChar(n) then
							local bx = (bridgeChar(at(ni - 1, nj)) or (not isPit(ni - 1, nj) and not isWall(ni - 1, nj))) and (bridgeChar(at(ni + 1, nj)) or (not isPit(ni + 1, nj) and not isWall(ni + 1, nj)))
							open = (bx and d.dj == 0) or (not bx and d.di == 0)
						end
						if open and bridgeChar(n) then
							-- 다리 입구 양옆은 난간
							local c = center(i, j)
							local edge = c + d.v * (T / 2 - 0.3)
							local across = Vector3.new(d.v.Z, 0, -d.v.X)
							local bw = if n == "n" then 1.75 else 2.6
							for _, s in { -1, 1 } do
								Kit.railing(props, edge + across * s * bw, edge + across * s * (T / 2 - 0.3), 3.3, 2.6)
							end
						elseif not open then
							local c = center(i, j)
							local edge = c + d.v * (T / 2 - 0.3)
							local across = Vector3.new(d.v.Z, 0, -d.v.X)
							Kit.railing(props, edge - across * (T / 2 - 0.3), edge + across * (T / 2 - 0.3), 3.3, 2.6)
						end
					end
				end
			end
		end
	end

	-- ── 괴물 배회 지점 ──
	local walk = layout.Walkable or {}
	for j = 1, nz do
		for i = 1, nx do
			local ch = at(i, j)
			if ch == "." or ch == "p" or ch == "b" or ch == "f" or ch == "D" or ch == "A" or walk[ch] then
				local c = center(i, j)
				local y = if ch == "b" then 0 else floorY(i, j)
				table.insert(info.nodes, c + Vector3.new(0, y + 3, 0))
			end
		end
	end

	-- 바닥 아래 낙하 방지(맵 밖)
	local kill = Kit.span(folder, Vector3.new(-20, BOTTOM - 4, -20), Vector3.new(nx * T + 20, BOTTOM - 2, nz * T + 20), { tag = false, invisible = true })
	kill.Name = "Underfloor"

	return info
end

return Builder
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Stages</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Lobby</string>
            <string name="Source"><![CDATA[--!strict
-- 로비: 방을 만들고 기다리는 어두운 홀. 스테이지처럼 지어서 음파로 본다(괴물 없음, 출구 없음).
-- 가운데 큰 홀(기둥), 위쪽 대기실과 양옆 작은 방(아치·문), 아래쪽 휴게실.
return {
	Seed = 7,
	PipeChance = 0.45,
	Rows = {
		"##########################",
		"#....#..............#....#",
		"#.c..A..O...SS...O..A..m.#",
		"#....#..............#....#",
		"##A###.....SS.......###A##",
		"#.......................v#",
		"#..O.....O......O.....O..#",
		"#........................#",
		"#####.....######.....#####",
		"#...#.....#....#.....#...#",
		"#.f.D.....A....A.....D.f.#",
		"#...#.....#....#.....#...#",
		"#####.....######.....#####",
		"#........................#",
		"#..O.....O......O.....O..#",
		"#c......................c#",
		"##########################",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Stage1</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 1 — 지하 시설 (47x41칸, tools/gen-themed.js 설계도)
-- 시작 구역(왼쪽 위 20x20, 자동 테스트용 그대로) → 연구동 복도 A·B(실험실·기계실·관제실) → 연결 통로 → 남쪽 복도 C(창고동)
-- → 발전실 홀(구덩이 위 철제 통로, 계단으로 내려갈 수 있음) → 비상구. 갈림길·고리가 많아(백룸식) 괴물을 피해 다른 길로 돌아갈 수 있다. 출구까지 최단 약 114칸(헤매면서 약 2분).
local Props = require(script.Parent.Parent.Props)
return {
	Seed = 11,
	PipeChance = 0.55,
	HideStyle = "locker", -- 숨는 곳(L): 철제 사물함
	SearchStyle = "drawers", -- 뒤지는 곳(Z): 철제 서랍장, 그중 한 곳에 열쇠
	Props = { T = Props.Desk },
	Rows = {
		"###############################################",
		"#S..#.......#...f..############################",
		"#S..D..O.O..A..cc..############################",
		"#...#.......#.................................#",
		"##.###A######.####D##.........................#",
		"#...#....#....#....#####D#####D#####D####D##..#",
		"#.c.#.##.#.##.#.m..##.....#......Z#...Z#...#..#",
		"#...A.#..A..#.A....##..T..A.......#....#...#..#",
		"###.###.#####.###.###m.m.v#v.v.m.v#.T..#ccc#..#",
		"#.......#ppppppps..################A########..#",
		"#.#####..bbbbbbbb..##.ccc#m.m.m.m#m.m.m.m.m#..#",
		"#.#...#.#ppppppps..##....#.......#.........#..#",
		"#.#.m.#..spppppp#..##...Z#L......#L........A..#",
		"#.#...D.#########D####D########D####D#######..#",
		"#.##.##.#....#.....##.........................#",
		"#.......A.cc.A..O..##.........................#",
		"#####.###.v..#.....##..##D####D#############D##",
		"#.....#.##D####.#####..#...Z#......Z#L........#",
		"#.c.....#.......A..##..#....#.......#.........#",
		"#####################..#....D.......D.........#",
		"#####################..A.T..#m.v.m.m#m.m.m.m.m#",
		"#####################..####A######D#####D######",
		"#.............................................#",
		"#.............................................#",
		"##D#####D###D#####D##########D###D#####D####..#",
		"#...#L....#...Z#L......#L.Z....#.....#.....#..#",
		"#...#.....#....#.......#.......#.....#.....#..#",
		"#...#.....A....#.......#.......#.....#.....#..#",
		"#...A.....#....A.......D.......A.....A.....A..#",
		"#cc.#m.m.m#c..c#m.m.m.m#mLm.m.m#m.m.m#m.m.m#..#",
		"###########################A#####A#####A####..#",
		"#E.....D........sppppp.........D..............#",
		"########.O..O...pppppp.........#..............#",
		"########........pppppp.........##D######D###D##",
		"########........bbbbbb.........#....Z#L...#...#",
		"########........pppppp.........#.....#....#...#",
		"########........pppppp.........#.....#....#...#",
		"########........pppppp.O..O..O.D.....D....A...#",
		"########........ppppps.........#ccccc#.c.c#.cc#",
		"###############################################",
		"###############################################",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Stage2</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 2 — 물류 창고 (45x41칸, tools/gen-themed.js 설계도)
-- 하역장 컨테이너가 있는 큰 창고 A(선반 줄 사이 통로를 지그재그로) → 사무동 복도(사무실·휴게실·재고실)
-- → 큰 창고 B(선반 줄, 컨테이너·지게차) → 하역장 문(출구). 갈림길·고리가 많아(백룸식) 괴물을 피해 다른 길로 돌아갈 수 있다. 출구까지 최단 약 120칸(헤매면서 약 2분).
local Props = require(script.Parent.Parent.Props)
return {
	Seed = 23,
	PipeChance = 0.3,
	HideStyle = "tool", -- 숨는 곳(L): 공구 캐비닛
	SearchStyle = "crate", -- 뒤지는 곳(Z): 나무 상자, 그중 한 곳에 열쇠
	Props = { H = Props.RackX, h = Props.RackZ, K = Props.Container, T = Props.Desk, Q = Props.ContainerStack },
	Rows = {
		"#############################################",
		"#SSSS..c.Zc..c..c....K.Q.Q.K.K.K.K.K.Q.K.Q..#",
		"#............m..............................#",
		"#...........................................#",
		"#.HHHHH.HHHHHHHHH..HHHHHHHHHH.HHHHH.HHHHH...#",
		"#...........................................#",
		"#...........................................#",
		"#..HHHHHHHHH..HHHHH.HHHHH.HHHHH.HHHHH.HHHHH.#",
		"#...........................................#",
		"#...........................................#",
		"#.HHHHHH.HHHHH.HHHHH.HHHHHHHHHH..HHHHHHHH...#",
		"#...........................................#",
		"#...........................................#",
		"######################A#####A########A####..#",
		"#.....m#L..#L..Z#L..D....Lm#....m#......m#..#",
		"#.T....#.T.#..T.#.T.#.T....#.T...A.T.....A..#",
		"#......#...#....#...#......#.....#.......#..#",
		"#####D###D####D###D######D###D#####D######..#",
		"#...........................................#",
		"#...........................................#",
		"#..###D####D######D###D#####D####D######D####",
		"#..#....#......Z#...#...#.....Z#.....Z#....Z#",
		"#..#..T.#.......#.T.#.T.D......#......#.....#",
		"#..#L..Z#K.KZc.K#L..#L..#K.c.c.#c.K.c.#c.K.c#",
		"#..##########################################",
		"#.........L................................##",
		"#..........................................##",
		"#..........................................##",
		"#.HHHHH.HHHHH.HHHHHHH..HHHHHHHH.HHHHHHHH...##",
		"#..........................................##",
		"#..........................................##",
		"#..........................................##",
		"#...HHHHHHH.HHHHH.HHHHH.HHHHHH..HHHHHHHHHH.##",
		"#..........................................##",
		"#..........................................##",
		"#.HHHHH.HHHHH.HHHHHHHHH..HHHHHHH.HHHHHHHH..##",
		"#..........................................##",
		"#..........................................##",
		"#...m.........m.........m.........m........##",
		"#.K.Q.Q.c.K.Q.c.K.c.K.c.Q.Q.K.c.K.K.K......E#",
		"#############################################",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Stage3</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 3 — 하수도 (43x41칸, tools/gen-themed.js 설계도)
-- 물길 터널 4줄(양옆 좁은 통로 + 가운데 물길 w, 다리 b·좁은 다리 n·물로 내려가는 계단 s) → 아치 있는 관리 통로로 다음 터널
-- 펌프실(머리 위 대형 배관 P)·밸브실·막다른 지선. 마지막 터널 끝 사다리가 출구. 갈림길·고리가 많아(백룸식) 괴물을 피해 다른 길로 돌아갈 수 있다. 출구까지 최단 약 115칸(헤매면서 약 2분).
local Props = require(script.Parent.Parent.Props)
return {
	Seed = 37,
	PipeChance = 0.75,
	HideStyle = "rusty", -- 숨는 곳(L): 찌그러진 정비 사물함
	SearchStyle = "toolbox", -- 뒤지는 곳(Z): 공구함, 그중 한 곳에 열쇠
	Props = { w = Props.Water, P = Props.BigPipe },
	PitTiles = { w = true },
	Walkable = { w = true, P = true },
	Rows = {
		"###########################################",
		"###########################################",
		"#SSSS....................................##",
		"#wwwwwwwwswwwwbwswwwwwwbwswwwwwwwwwwwwwww##",
		"#wwwwwwswwwwwwbwwwwswwwbwwswwwwwwwwwwwwww##",
		"#........................................##",
		"##############A####A######A#A########.#####",
		"###########m...Z###........#.########A#####",
		"###########PPPPP############.########.#####",
		"###########Z..Zm############.########.#####",
		"#######################........######A#####",
		"#######################A######A######.#####",
		"###......................................##",
		"###wwwwwwwwwwwswwwwwwwwwwnwwwwwwswwwwwwww##",
		"###wwwwwwwwwwwwwwswwwwwwwnwwwwwwwwswwwwww##",
		"###......................................##",
		"####.#####A######A########.#######.########",
		"####A#####.####Lv..Z######A#######A########",
		"####.#####.####.....######...L####.########",
		"####.#####A####.....##############.....Z###",
		"####A#####.####L..vL###.......#############",
		"####.#####.############A#####A#############",
		"#.......................................###",
		"#wwwwwwswwwbwwwwwwwwwwwswwwwwwwwnwwwswww###",
		"#wwwwwswwwwbwswwwwwwwwwwwwwwwwwwnwwswwww###",
		"#.......................................###",
		"##A####A####A####A#########A###A#####.#####",
		"##.###m.LZ##......#######m..Z##.#####A#####",
		"##.###....###############....##.#####.#####",
		"##A###PPPP###############PPPP##A#####.#####",
		"##.###L.Lm####........###..Lm##.#####A#####",
		"##.###########A######A###A#####.#####.#####",
		"##.....................................####",
		"##wwwwwwwwwwwwwwswwwwwwwwnwwwwwwwwwwsww####",
