        <Item class="ModuleScript" referent="251">
          <Properties>
            <string name="Name">Stage6</string>
            <string name="Source"><![CDATA[--!strict
-- STAGE 6 — 호텔 (47x43칸, 2층 건물, tools/places/hotel.js 로 생성)
-- 뼈대: 가운데 아트리움 로비를 ㄷ자 객실 날개(서쪽 · 북쪽 · 동쪽, 가운데 복도 양쪽 객실)가 감싸고, 뒤쪽 직원 구역이 붙는다.
-- 1층: 남서쪽 직원 구역(휴게실 = 시작 · 락커실 · 직원 계단) → 서쪽 객실 날개 → 북쪽 서비스 고리(직원 복도 · 주방 · 그랜드 볼룸 · 하역장)
-- → 동쪽 객실 날개 → 레스토랑·라운지 바 → 아트리움 로비(분수 · 샹들리에 · 엘리베이터 뱅크 · 프런트 데스크) → 정문 바람막이(출구).
-- 2층(Rows2): 같은 ㄷ자 객실층(북쪽 객실 줄 · 코너 스위트 둘 · 서비스 줄). 직원 계단(남서)으로 올라 대계단(로비 북동)으로 내려온다.
-- 객실: 문 옆 욕실 · 옷장 · 협탁 달린 침대 · 창가 짐 받침대와 책상·TV, 커넥팅 룸만 서랍장(열쇠 상자). 복도 가운데 방화문.
-- 출구까지 최단 약 131칸.
local Props = require(script.Parent.Parent.Props)
local CP = require(script.Parent.Parent.ChapterProps.Hotel)
return {
	Seed = 61,
	PipeChance = 0.2,
	HideStyle = "hotelcloset", -- 숨는 곳(L): 객실 옷장(청소 카트 옆 벽장)
	SearchStyle = "dresser", -- 뒤지는 곳(Z): 객실 서랍장, 그중 한 곳에 열쇠
	Props = { R = CP.GuestBed, r = CP.TwinBeds, u = CP.Bathroom, T = CP.WritingDesk, y = CP.LuggageRack, a = CP.Wardrobe, Y = CP.Fountain, i = CP.Blank, N = CP.Chandelier, z = CP.BanquetStage, k = Props.Cabinet, F = CP.FrontDesk, G = CP.LuggageCart, w = CP.Sofa, q = CP.BarCounter, U = CP.RoundTable, K = CP.Range, P = CP.PrepTable, W = CP.Washer, j = CP.LinenShelf, l = CP.StaffLockers, h = CP.HousekeepingCart, V = CP.IceMachine, e = CP.Elevator },
	Walkable = { k = true, N = true, P = false }, -- (캐비닛은 벽에 붙어 칸 반이 빈다 · 샹들리에는 머리 위: 지나갈 수 있다. 조리대 P 와 나머지 소품은 막힌 칸)
	Rows = {
