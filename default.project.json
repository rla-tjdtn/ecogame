{
  "name": "SonarMaze",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Remotes": {
        "$className": "Folder",
        "SonarFire": { "$className": "RemoteEvent" },
        "SonarPulse": { "$className": "RemoteEvent" },
        "SetMoveMode": { "$className": "RemoteEvent" },
        "RoundEvent": { "$className": "RemoteEvent" },
        "RoomAction": { "$className": "RemoteEvent" },
        "SearchAction": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CameraMaxZoomDistance": 0.5,
        "CameraMinZoomDistance": 0.5,
        "CharacterWalkSpeed": 10,
        "CharacterUseJumpPower": true,
        "CharacterJumpPower": 40,
        "EnableMouseLockOption": false,
        "AutoJumpEnabled": false
      },
      "StarterPlayerScripts": { "$path": "src/client" }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false, "MaxPlayers": 4 }
    },
    "Workspace": {
      "$properties": { "StreamingEnabled": false }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Brightness": 0,
        "Ambient": [0, 0, 0],
        "OutdoorAmbient": [0, 0, 0],
        "ClockTime": 0,
        "GlobalShadows": false,
        "EnvironmentDiffuseScale": 0,
        "EnvironmentSpecularScale": 0,
        "ExposureCompensation": 0,
        "FogEnd": 100000
      },
      "Sky": {
        "$className": "Sky",
        "$properties": { "StarCount": 0, "CelestialBodiesShown": false }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.2, "Size": 6, "Threshold": 0.9 }
      }
    },
    "SoundService": {
      "$properties": { "AmbientReverb": "Hangar" }
    }
  }
}
